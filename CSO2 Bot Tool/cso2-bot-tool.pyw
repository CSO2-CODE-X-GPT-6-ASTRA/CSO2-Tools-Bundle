an = dict(version=VERSION, topology=fingerprint(cores),\n                allowed_mask=allowed_mask, owner_pid=os.getpid(),\n                pools=dict(aim=aim, aim_wall=aim,\n                           esp_render=chosen[2][\'mask\'],\n                           esp_sample=chosen[3][\'mask\']))\n    validate_plan(plan, cores, system_mask)\n    return plan\n\n\ndef save_status(data_root, status):\n    folder = Path(data_root) / \'cpu_affinity\'\n    folder.mkdir(parents=True, exist_ok=True)\n    dest = folder / (str(os.getpid()) + \'.json\')\n    temp = dest.with_suffix(\'.tmp\')\n    temp.write_text(json.dumps(status, ensure_ascii=False, indent=2) + \'\\n\', encoding=\'utf-8\')\n    os.replace(temp, dest)\n\n\ndef bootstrap(role, data_root, probe_seconds=0):\n    """Apply and read back hard affinity before the worker starts doing work.\n\nErrors remain explicit in per-PID diagnostics; they never suppress the ESP.\nNo priority changes, frame-rate changes, game reads or input events occur here.\n"""\n    global STATUS\n    status = dict(version=VERSION, role=role, pid=os.getpid(), parent_pid=os.getppid(),\n                  time=datetime.datetime.now().astimezone().isoformat(), state=\'initializing\')\n    k, original, applied = None, None, False\n    try:\n        if role not in ROLES:\n            raise ValueError(\'Unknown CPU partition role: \' + str(role))\n        if os.name != \'nt\':\n            raise RuntimeError(\'Windows CPU affinity is required\')\n        config_path = Path(data_root) / \'cpu_affinity.json\'\n        config = json.loads(config_path.read_text(encoding=\'utf-8-sig\')) if config_path.exists() else {}\n        if config.get(\'enabled\', True) is not True:\n            # Disabled child workers still need the original parent allowance.\n            inherited = os.environ.pop(PLAN_ENV, None)\n            if inherited:\n                k = kernel()\n                cores = topology(k)\n                original, system_mask = masks(k)\n                plan = json.loads(inherited)\n                validate_plan(plan, cores, system_mask)\n                restored = plan[\'allowed_mask\']\n                if not k.SetProcessAffinityMask(k.GetCurrentProcess(), restored):\n                    raise C.WinError(C.get_last_error())\n                status[\'effective_mask\'] = hex(masks(k)[0])\n            status[\'state\'] = \'disabled\'\n        else:\n            k = kernel()\n            original, system_mask = masks(k)\n            cores = topology(k)\n            inherited = os.environ.get(PLAN_ENV)\n            plan = json.loads(inherited) if inherited else make_plan(cores, original, system_mask)\n            core_sets = validate_plan(plan, cores, system_mask)\n            target = plan[\'pools\'][role]\n            status.update(original_mask=hex(original), requested_mask=hex(target),\n                          logical_cpus=cpu_ids(target), physical_cores=sorted(core_sets[role]),\n                          plan=plan, physical_core_count=len(cores), inherited_plan=bool(inherited))\n            if not k.SetProcessAffinityMask(k.GetCurrentProcess(), target):\n                raise C.WinError(C.get_last_error())\n            applied = True\n            k.Sleep(0)\n            actual, _ = masks(k)\n            if actual != target:\n                raise RuntimeError(\'Read-back affinity differs from the requested mask\')\n            os.environ[PLAN_ENV] = json.dumps(plan, separators=(\',\', \':\'))\n            status.update(state=\'applied\', effective_mask=hex(actual), verified=True)\n            if probe_seconds:\n                observed, deadline = set(), time.monotonic() + min(2., max(.05, probe_seconds))\n                while time.monotonic() < deadline:\n                    observed.add(k.GetCurrentProcessorNumber())\n                    k.Sleep(1)\n                status[\'observed_logical_cpus\'] = sorted(observed)\n                if any(not target & (1 << cpu) for cpu in observed):\n                    raise RuntimeError(\'Observed execution outside the assigned CPU pool\')\n    except Exception as ex:\n        status.update(state=\'error\', verified=False, error=str(ex))\n        if applied and k is not None and original is not None:\n            status[\'rollback_ok\'] = bool(k.SetProcessAffinityMask(k.GetCurrentProcess(), original))\n            status[\'effective_mask\'] = hex(masks(k)[0])\n    try:\n        save_status(data_root, status)\n    except OSError as ex:\n        status[\'diagnostic_write_error\'] = str(ex)\n    STATUS = status\n    return status\n\n\ndef enter(argv, data_root):\n    """Bundle entrypoint: probes are self-contained and never start game features."""\n    option = argv[1] if len(argv) > 1 else \'\'\n    if option == \'--check\':\n        return False\n    if option == \'--cpu-affinity-probe\':\n        role = argv[2] if len(argv) > 2 else \'aim\'\n        result = bootstrap(role, data_root, probe_seconds=.2)\n        print(json.dumps(result, ensure_ascii=False), flush=True)\n        if result[\'state\'] == \'error\':\n            raise SystemExit(2)\n        return True\n    # A non-admin GUI launcher may be restarted by the existing main().\n    # Do not narrow that launcher\'s inherited mask before this boundary.\n    if option in SWITCHES:bootstrap(SWITCHES[option], data_root)\n    return False\n')

_EMBEDDED['esp_feedback'] = (1, '"""ESP consumes positive wall signals; its own target publication is independent."""\nimport math\n\n\ndef obstacle_scope(context):\n    return tuple(context.get(key) for key in\n        (\'pid\',\'map\',\'local_identity\',\'weapon\',\'source_epoch\'))\n\n\ndef merge_obstacle_signals(previous, revisions, signals, context):\n    """One producer\'s revisions, shared by both independent subscribers."""\n    if context.get(\'clear_wall\'):return {}, {}\n    merged=dict(previous);revisions=dict(revisions)\n    revision=context.get(\'result_started_at\',context.get(\'submitted_at\',0.))\n    if type(revision) not in (int,float) or not math.isfinite(revision):revision=0.\n    assessed=context.get(\'assessed\',())\n    if not isinstance(assessed,(tuple,list)):assessed=()\n    for row in assessed:\n        if not isinstance(row,(list,tuple)) or len(row)!=4:continue\n        index,address,serial,model=row;key=str(index)\n        if (any(type(v) is not int for v in (index,address,serial)) or\n                not 0<index<32768 or not isinstance(model,str)):continue\n        if revision<revisions.get(key,-1.):continue\n        old=merged.get(key)\n        if old and (old.get(\'address\'),old.get(\'serial\'),old.get(\'model\'))==(address,serial,model):\n            merged.pop(key,None)\n        revisions[key]=revision\n    for index,raw in signals.items():\n        key=str(index);signal=normalize_obstacle_signal(raw)\n        if signal is not None and revision>=revisions.get(key,-1.):\n            merged[key]=signal;revisions[key]=revision\n    return merged,revisions\n\ndef normalize_obstacle_signal(packet,*,now=None,default_stamp=None):\n    """Accept the obstacle owner\'s bit; movement is not a revocation."""\n    if packet is True:packet={\'penetrable\':True}\n    if not isinstance(packet,dict) or packet.get(\'penetrable\') is not True:return None\n    stamp=packet.get(\'display_evidence_stamp\',packet.get(\'stamp\',default_stamp))\n    age=packet.get(\'age_ms\',0.)\n    if type(age) not in (int,float) or not math.isfinite(age) or age<0:return None\n    if stamp is not None:\n        if type(stamp) not in (int,float) or not math.isfinite(stamp):return None\n        if now is not None:\n            elapsed=(now-stamp)*1000.\n            if not math.isfinite(elapsed) or elapsed<0:return None\n            age=max(age,elapsed)\n    for key in (\'display_ray_eye\',\'display_ray_head\'):\n        value=packet.get(key)\n        if key in packet and (not isinstance(value,(tuple,list)) or len(value)!=3\n                or any(type(v) not in (int,float) or not math.isfinite(v) for v in value)):\n            return None\n    for key in (\'address\',\'serial\'):\n        if key in packet and type(packet[key]) is not int:return None\n    if \'model\' in packet and not isinstance(packet[\'model\'],str):return None\n    if \'display_point_key\' in packet and not isinstance(packet[\'display_point_key\'],str):return None\n    # ``display_point_part`` is the stable cross-process identity. Point keys\n    # may be prefixed by a model/rig namespace in the producer and CLIENT\n    # reader, while the anatomical part remains stable for this actor.\n    if \'display_point_part\' in packet:\n        part=packet[\'display_point_part\']\n        if part not in (\'head\',\'torso\',\'pelvis\',\'body\',\'arm\',\'leg\',\'eye\'):\n            return None\n    keys=(\'address\',\'serial\',\'model\',\'display_ray_eye\',\'display_ray_head\',\n          \'display_point_key\',\'display_point_part\')\n    result={key:packet[key] for key in keys if key in packet}\n    result.update(penetrable=True,age_ms=age,obstacle_interface=\'one_bit\')\n    if stamp is not None:result[\'display_evidence_stamp\']=stamp\n    return result\n\ndef is_current_penetrable(entity):\n    return normalize_obstacle_signal(getattr(entity,\'display_penetration\',None)) is not None\n\n\n\n\n\n\ndef shared_scope(frame):\n    local=frame.local\n    identity=getattr(frame,\'server_local_identity\',None) or (local.index,local.address,local.serial)\n    return dict(map=frame.map_name,source=getattr(frame,\'source\',\'\'),\n                server_base=getattr(frame,\'server_base\',0),local=list(identity),weapon=frame.weapon)\n\n\ndef native_points(entity):\n    """Return every current measured joint once; validated empty lists stay empty."""\n    from aim_points import AimPoint\n    from geometry import finite\n    points=list(entity.aim_points)\n    if points or entity.aim_points_validated:return points\n    seen=set()\n    if entity.head is not None and len(entity.head)==3 and finite(entity.head):\n        radius=entity.head_radius\n        if type(radius) not in (int,float) or not math.isfinite(radius) or radius<=0:radius=1.\n        points.append(AimPoint(\'head\',\'head\',tuple(entity.head),radius,0));seen.add(tuple(entity.head))\n    for segment in entity.skeleton:\n        for joint in segment:\n            position=tuple(joint)\n            if len(position)==3 and finite(position) and position not in seen:\n                seen.add(position)\n                points.append(AimPoint(f\'esp:joint:{len(seen)}\',\'body\',position,.75,20))\n    return points\n\n\ndef shared_verdict_packet(frame,pid,now):\n    """Publish the renderer\'s finished states and the same measured coordinates."""\n    from aim_points import AimPoint\n    from esp_sources import MAX_AGE\n    from geometry import finite\n    def fresh(stamp):\n        return type(stamp) in (int,float) and math.isfinite(stamp) and 0<=now-stamp<=MAX_AGE\n    def vector(value):\n        return isinstance(value,(list,tuple)) and len(value)==3 and finite(value)\n    acquisition=getattr(frame,\'display_acquisition_stamp\',frame.stamp)\n    if not fresh(acquisition) or not fresh(frame.stamp) or not vector(frame.eye):return {}\n    actors=[]\n    for entity in frame.entities:\n        if (not getattr(entity,\'enemy\',False) or entity.health<=0 or entity.dormant\n                or getattr(entity,\'display_pose_reused\',False)\n                or getattr(entity,\'display_alive_grace\',False)):continue\n        pose=getattr(entity,\'pose_sample_stamp\',None) or acquisition\n        if not fresh(pose):continue\n        verdict=getattr(entity,\'visibility\',\'blocked\')\n        verdict=verdict if verdict in (\'visible\',\'penetrable\',\'blocked\') else \'blocked\'\n        ray_stamp=getattr(entity,\'display_visibility_stamp\',0.)\n        direct=(getattr(entity,\'esp_visible_points\',()) if verdict==\'visible\' and fresh(ray_stamp) else ())\n        native=native_points(entity)\n        points=[];stamps=[pose,acquisition]\n        path=normalize_obstacle_signal(getattr(entity,\'display_penetration\',None),now=now) or {}\n        penetration_point=tuple(path.get(\'display_ray_head\',entity.head or ()))\n        for point in native:\n            if (not vector(point.position) or point.part not in (\'head\',\'torso\',\'pelvis\',\'body\',\'arm\',\'leg\',\'eye\')\n                    or type(point.radius) not in (int,float) or not math.isfinite(point.radius) or point.radius<=0\n                    or type(point.priority) not in (int,float) or not math.isfinite(point.priority)):continue\n            position=tuple(point.position);visibility=\'blocked\'\n            if position in direct:\n                visibility=\'visible\';stamps.append(ray_stamp)\n            elif (path.get(\'penetrable\') is True and position==penetration_point\n                    and tuple(path.get(\'display_ray_eye\',frame.eye))==tuple(frame.eye)):\n                visibility=\'penetrable\'\n            points.append(dict(key=point.key,part=point.part,position=list(position),radius=point.radius,\n                priority=int(round(point.priority*100)),visibility=visibility,\n                head_region=point.head_region,model_local=point.model_local))\n        if points:\n            actors.append(dict(identity=[entity.index,entity.address,entity.serial,entity.model],team=entity.team,\n                health=entity.health,pose_stamp=min(stamps),geometry_stamp=min(pose,acquisition),\n                visibility=verdict,points=points,\n                source=getattr(entity,\'display_source\',\'\') or frame.source,\n                origin=list(entity.origin),classname=entity.classname,\n                head_source=entity.head_source,reported_alive=entity.reported_alive,\n                ragdoll_present=entity.ragdoll_present,pose_confirmed=entity.pose_confirmed))\n    scope=shared_scope(frame)\n    return dict(schema=\'esp.targets.v1\',pid=pid,map=frame.map_name,weapon=frame.weapon,\n        source=scope[\'source\'],server_base=scope[\'server_base\'],local=[scope[\'local\'][0],scope[\'local\'][2]],\n        stamp=acquisition,render_stamp=frame.stamp,published_at=now,eye=list(frame.eye),\n        owner=\'esp_render\',actors=actors)\n\n\ndef shared_geometry_packet(frame,pid,now,owner):\n    """Obstacle input only: no visibility labels and no control permissions."""\n    packet=shared_verdict_packet(frame,pid,now)\n    if not packet:return {}\n    packet[\'schema\']=\'obstacle.geometry.v1\';packet[\'owner\']=owner\n    for actor in packet[\'actors\']:\n        actor.pop(\'visibility\',None)\n        for point in actor[\'points\']:point.pop(\'visibility\',None)\n    return packet\n')
_EMBEDDED['scale_geometry'] = (1, '"""Scale-aware validity envelopes; positions always come from measured matrices."""\nimport math,struct\nNAMES=(\'m_flModelScale\',\'m_flScale\',\'m_flHeadScale\',\'m_flBodyScale\')\nSERVER_FIELDS=((0x9be610,NAMES[0],0x37c),(0x9f4b50,NAMES[1],0x6ec),\n               (0x9f4b84,NAMES[2],0x6f0),(0x9f4bb8,NAMES[3],0x6f4))\n\ndef scale_factor(values):\n    if any(not isinstance(v,(int,float)) or not math.isfinite(v) or v<=0 for v in values.values()):return 1.\n    model=values.get(NAMES[0],1.);body=values.get(NAMES[1],1.)\n    result=model*body*max(1.,values.get(NAMES[2],1.),values.get(NAMES[3],1.))\n    return result if math.isfinite(result) and result>0 else 1.\n\ndef _positive(value,default=1.):\n    return float(value) if isinstance(value,(int,float)) and math.isfinite(value) and value>0 else default\n\ndef scale_components(values):\n    """Return the independent visual factors used by the host tool.\n\n    ``m_flScale`` moves/scales the body rig, while ``m_flHeadScale`` is a\n    relative head factor in the separate head/body mode.  Keeping both values\n    lets the overlay enlarge the rig without turning a large head into a large\n    body (or applying the same factor twice).\n    """\n    model=_positive(values.get(NAMES[0],1.))\n    body=_positive(values.get(NAMES[1],1.))\n    head_relative=_positive(values.get(NAMES[2],1.))\n    body_relative=_positive(values.get(NAMES[3],1.))\n    body_total=model*body*body_relative\n    head_total=body_total*head_relative\n    if not math.isfinite(body_total) or body_total<=0:body_total=1.\n    if not math.isfinite(head_total) or head_total<=0:head_total=body_total\n    return dict(model=model,body=body_total,head=head_total,\n                head_relative=head_relative,body_relative=body_relative,\n                maximum=max(1.,body_total,head_total),\n                detected=any(abs(v-1.)>1e-4 for v in\n                             (model,body,head_relative,body_relative)))\n\ndef _read_client_values(reader,p,data=None):\n    m=reader.mem;vt=m.u32(p+8);key=(vt,\'scale_fields\')\n    cache=reader.table_cache\n    if key not in cache:\n        fn=m.u32(vt+8);code=m.read(fn,6)\n        if code[0]!=0xb8 or code[5]!=0xc3:return {}\n        cc=struct.unpack_from(\'<I\',code,1)[0];found={};visited=set()\n        def walk(table,base=0,depth=0):\n            if not table or table in visited or depth>16:return\n            visited.add(table);ptr,n=struct.unpack(\'<Ii\',m.read(table,8))\n            if not 0<n<=1024:raise ValueError(\'scale RecvTable count\')\n            blob=m.read(ptr,n*60)\n            for i in range(n):\n                row=i*60;name=m.string(struct.unpack_from(\'<I\',blob,row)[0],96)\n                kind=struct.unpack_from(\'<i\',blob,row+4)[0];off=base+struct.unpack_from(\'<i\',blob,row+44)[0]\n                if not 0<=off<0x10000:continue\n                if name in NAMES and kind==1:found[name]=off\n                if kind==6:walk(struct.unpack_from(\'<I\',blob,row+40)[0],off,depth+1)\n        walk(m.u32(cc+12));cache[key]=found\n    values={}\n    for name,off in cache[key].items():\n        values[name]=struct.unpack_from(\'<f\',data,off)[0] if data is not None and off+4<=len(data) else struct.unpack(\'<f\',m.read(p+off,4))[0]\n    return values\n\ndef client_scale_info(reader,p,data=None):\n    """Read the verified client scale fields and expose head/body factors."""\n    try:return scale_components(_read_client_values(reader,p,data))\n    except (RuntimeError,OSError,ValueError,struct.error,AttributeError):return scale_components({})\n\ndef client_scale(reader,p,data=None):\n    """Recover named float RecvProps, not unverified hard-coded client offsets."""\n    try:\n        return client_scale_info(reader,p,data)[\'maximum\']\n    except (RuntimeError,OSError,ValueError,struct.error,AttributeError):return 1.\n\ndef server_scale(data,verified=False):\n    if not verified:return 1.\n    return server_scale_info(data,verified)[\'maximum\']\n\ndef server_scale_info(data,verified=False):\n    if not verified:return scale_components({})\n    return scale_components({name:struct.unpack_from(\'<f\',data,offset)[0]\n                             for _,name,offset in SERVER_FIELDS if offset+4<=len(data)})\n\ndef _axis_norms(matrix):\n    return [math.sqrt(sum(matrix[j*4+k]**2 for k in range(3))) for j in range(3)]\n\ndef visual_scale_factor(matrices,components):\n    """Return the missing scale between the declared rig and cached matrices.\n\n    Bone caches can contain the native model scale already, or can contain a\n    normalized rig while the entity\'s scale fields carry the enlargement.  A\n    ratio keeps both cases correct and also handles a partially updated cache\n    without multiplying the model twice.\n    """\n    desired=_positive(components.get(\'body\',1.))\n    if not math.isfinite(desired) or abs(desired-1.)<=1e-4:return 1.\n    norms=[]\n    for matrix in matrices:\n        if len(matrix)!=12 or not all(math.isfinite(v) for v in matrix):continue\n        norms.extend(v for v in _axis_norms(matrix) if math.isfinite(v) and v>1e-5)\n    if not norms:return desired\n    observed=sorted(norms)[len(norms)//2]\n    tolerance=.20*max(desired,observed,1e-3)\n    if abs(observed-desired)<=tolerance:return 1.\n    missing=desired/observed\n    return missing if math.isfinite(missing) and missing>0 else 1.\n\ndef visual_matrix(matrix,origin,factor):\n    if abs(factor-1.)<=1e-4:return tuple(matrix)\n    result=list(matrix)\n    for axis in range(3):\n        for k in range(3):result[axis*4+k]*=factor\n        result[axis*4+3]=origin[axis]+(result[axis*4+3]-origin[axis])*factor\n    return tuple(result)\n\ndef radius(scale,base):\n    return base*max(1.,scale) if isinstance(scale,(int,float)) and math.isfinite(scale) and scale>0 else base\n\ndef eye_offset_valid(offset,scale=1.):\n    return (len(offset)==3 and all(math.isfinite(v) for v in offset) and\n            0<=offset[2]<=radius(scale,160.) and max(map(abs,offset))<=131072.)\n\ndef point_valid(point,origin,scale=1.):\n    return (len(point)==3 and all(math.isfinite(v) and abs(v)<=131072. for v in point) and\n            math.dist(point,origin)<radius(scale,2000.))\n\ndef matrix_valid(matrix,origin,scale=1.):\n    return (len(matrix)==12 and all(math.isfinite(v) for v in matrix) and\n            all(math.hypot(*(matrix[j*4+k] for j in range(3)))>0 for k in range(3)) and\n            point_valid((matrix[3],matrix[7],matrix[11]),origin,scale))\n')
_EMBEDDED['server_control'] = (1, '"""Authoritative SERVER actors with local-only client camera/input state.\n\nThe controller never enumerates client targets. It observes the existing\nsampler\'s native pose snapshots read-only; it does not install another hook.\n"""\nimport struct,time\nfrom dataclasses import replace\nfrom esp_shared import AdaptiveDisplayReader\nfrom reader import NotReady,MemoryError\nfrom runtime_compat import native_loopback\nfrom server_esp import TABLE\nfrom server_pose_refresh import ServerPoseObserver\n\n\nclass ServerControlReader(AdaptiveDisplayReader):\n    def __init__(self,game):\n        super().__init__(game)\n        self.server_reader.control_geometry=True\n        self.source=\'server\';self.target_source=\'server\'\n        self.pipeline_metrics={}\n\n    def _server_ready(self):\n        self.select_source();server=self.server_reader\n        if server.bound is None:server.bind()\n        if not isinstance(server.pose_refresher,ServerPoseObserver):\n            # This reader is observation-only, including pause/close/rebind.\n            if server.pose_refresher is not None:server.pose_refresher.close()\n            server.pose_refresher=ServerPoseObserver(server)\n        server.pose_refresh_retry=0.\n        try:server.pose_refresher.step(())\n        except (RuntimeError,OSError,ValueError,struct.error) as ex:\n            server.pose_refresh_status=dict(state=\'waiting_for_server_sampler\',error=str(ex))\n        return server\n\n    def target_entry(self,index):\n        if not isinstance(index,int) or not 0<index<65536:\n            raise NotReady(\'服务端目标索引无效\')\n        server=self.server_reader\n        if server.bound is None or not native_loopback(self.client_reader):\n            raise NotReady(\'服务端目标会话已变化\')\n        return server.base+TABLE+index*16\n\n    def read_entity(self,index,address,with_bones=True,with_aimpoints=True,\n                    observe_inactive=False,with_inventory=False,aim_key=None,**unused):\n        """Fresh SERVER identity/pose reread used before aiming and firing."""\n        began=time.monotonic()\n        try:\n            if aim_key is None:return self._read_control_entity(index,address,with_bones)\n            return self._read_control_entity(index,address,with_bones,aim_key=aim_key)\n        finally:\n            metrics=self.pipeline_metrics\n            metrics[\'actor_reread_ms\']=metrics.get(\'actor_reread_ms\',0.)+(time.monotonic()-began)*1000\n            metrics[\'actor_rereads\']=metrics.get(\'actor_rereads\',0)+1\n\n    def read_aim_entity(self,index,address,point_key):\n        # Same fresh snapshot and identity checks as the full actor reread;\n        # retain all native hitboxes, skip the 47 unrelated aim projections.\n        return self.read_entity(index,address,with_inventory=False,aim_key=point_key)\n\n    def _read_control_entity(self,index,address,with_bones,aim_key=None):\n        server=self._server_ready();entry=self.target_entry(index)\n        identity=server.mem.read(entry,8);current,serial=struct.unpack(\'<II\',identity)\n        if not current or current!=address:return None\n        classname=server.classify(current)\n        from target_rules import entity_kind\n        if entity_kind(classname) not in (\'player\',\'npc\'):return None\n        server_time=struct.unpack(\'<f\',server.mem.read(server.mem.u32(server.base+0xa54e60)+12,4))[0]\n        options=dict(with_pose=with_bones)\n        if aim_key is not None:options[\'aim_key\']=aim_key\n        result=server.actor(index,current,serial,classname,server_time,time.monotonic(),**options)\n        if server.mem.read(entry,8)!=identity:return None\n        result.target_source=\'server\'\n        return result\n\n    def frame(self,mode=\'普通竞技\',enemy_team=0,with_hazards=False,\n              with_aimpoints=True,observe_inactive=False,include_allies=False,**unused):\n        began=time.monotonic();self.pipeline_metrics={}\n        server=self._server_ready();ready=time.monotonic()\n        # Read ONLY the local actor, weapon, ammo, input eye and recoil. No\n        # client population, dormant cache, or client target bone data.\n        local_frame=self.client_reader.frame(mode,enemy_team,with_hazards=False,\n            with_aimpoints=False,observe_inactive=True,local_only=True)\n        local_done=time.monotonic()\n        native=server.frame(mode,enemy_team,with_hazards=with_hazards,\n            with_aimpoints=True,observe_inactive=observe_inactive,include_allies=include_allies)\n        server_done=time.monotonic()\n        if (native.map_name!=local_frame.map_name or native.local.index!=local_frame.local.index\n                or (native.local.serial&0x3ff)!=(local_frame.local.serial&0x3ff)):\n            raise NotReady(\'本人输入与服务端角色尚未同步\')\n        result=replace(native,stamp=min(native.stamp,local_frame.stamp),\n            local=local_frame.local,eye=local_frame.eye,angles=local_frame.angles,\n            punch=local_frame.punch,matrix=local_frame.matrix,weapon=local_frame.weapon,\n            ammo=local_frame.ammo,shots=local_frame.shots,weapon_state=dict(local_frame.weapon_state))\n        result.source=\'server\';result.target_source=\'server\'\n        result.local_source=\'client_local_input_only\';result.source_epoch=self.source_epoch\n        result.server_local_identity=(native.local.index,native.local.address,native.local.serial)\n        result.server_base=server.base\n        result.hazard_diagnostics=dict(getattr(native,\'hazard_diagnostics\',{}))\n        self.sample_ms=self.client_reader.sample_ms+server.sample_ms\n        self.entity_stats=dict(server.entity_stats,source=\'server\',client_targets=False,\n            input_source=result.local_source,aim_geometry=\'native_server_hitboxes\')\n        self.pipeline_metrics.update(source_ready_ms=(ready-began)*1000,\n            client_local_ms=(local_done-ready)*1000,server_world_ms=(server_done-local_done)*1000,\n            frame_total_ms=(time.monotonic()-began)*1000)\n        return result\n\n    def control_identity(self,frame):\n        if getattr(frame,\'source\',None)!=\'server\':raise NotReady(\'控制拒绝非服务端目标帧\')\n        self.select_source()\n        if (getattr(frame,\'source_epoch\',None)!=self.source_epoch or\n                getattr(frame,\'server_base\',None)!=self.server_reader.base or\n                self.mem.string(self.global_addr(\'level_name\'),160).replace(\'\\\\\',\'/\')!=frame.map_name):\n            raise NotReady(\'服务端地图或数据会话已变化\')\n        self.client_reader.control_identity(frame)\n        if not native_loopback(self.client_reader):raise NotReady(\'服务端会话已变化\')\n        identity=getattr(frame,\'server_local_identity\',None)\n        if identity is None:raise NotReady(\'服务端本人身份缺失\')\n        index,address,serial=identity\n        if self.mem.read(self.target_entry(index),8)!=struct.pack(\'<II\',address,serial):\n            raise NotReady(\'服务端本人角色已变化\')\n\n    def control_view(self,frame):\n        began=time.monotonic()\n        try:\n            self.control_identity(frame)\n            result=self.client_reader.control_view(frame)\n            self.control_identity(result)\n            return result\n        finally:\n            metrics=self.pipeline_metrics\n            metrics[\'local_view_ms\']=metrics.get(\'local_view_ms\',0.)+(time.monotonic()-began)*1000\n            metrics[\'local_view_reads\']=metrics.get(\'local_view_reads\',0)+1\n\n    def diagnostics(self):\n        # Do not delegate to Reader.diagnostics(): its bound self.frame would\n        # enumerate client targets even though the live worker is server-only.\n        result=dict(time=time.strftime(\'%Y-%m-%d %H:%M:%S\'),status=self.status,\n            live_verified=False,profile=self.profile[\'build_label\'],\n            compatibility=self.compatibility,target_source=\'server\',client_targets=False)\n        if self.mem:\n            result[\'pid\']=self.mem.pid\n            try:\n                frame=self.frame()\n                result.update(map=frame.map_name,team=frame.local.team,\n                    entities=[dict(index=e.index,classname=e.classname,team=e.team,health=e.health,\n                        source=e.target_source,bones=len(e.skeleton),has_head=e.head is not None,\n                        aim_geometry=e.aim_geometry,c4_carrier=e.c4_carrier) for e in frame.entities])\n            except (RuntimeError,OSError,ValueError,struct.error) as ex:result[\'error\']=str(ex)\n        return result\n')
_EMBEDDED['weapon_profiles'] = (1, '"""Installation-specific weapon scripts; no guessed gun profiles or GPU dependency.\n\nEncrypted resource layout reference: lateleite/libuncso2, encryptedfile.cpp,\nkeyhashes.cpp and tests/cso2/nexon/settings.hpp. This reader uses Windows CNG.\nOnly script data is read; packages, game memory and input are not modified.\n"""\nimport hashlib\nimport math\nfrom pathlib import Path\nimport re\nimport struct\nimport threading\nimport time\n\nMAX_SCRIPT = 2 * 1024 * 1024\nSCRIPT_KEYS = tuple(bytes.fromhex(k) for k in (\n    \'9aa6c75918ead04483a33a3eceaf6f68\', \'b6ba15c7779d9c4984622a9a8a6184a6\',\n    \'685524242bcb884ba7a6d2c794ede8d3\', \'3624d68c6cb8e14ab182c0a3dce416c8\'))\nFIREARMS = frozenset((\'rifle\', \'sniperrifle\', \'sniper\', \'pistol\', \'shotgun\',\n                      \'submachinegun\', \'machinegun\', \'smg\'))\nFIELDS = (\'Penetration Damage Range RangeModifier CycleTime CycleTimeAlt WeaponType \'\n          \'FullAuto primary_ammo WeaponArmorRatio Bullets Spread InaccuracyStand \'\n          \'InaccuracyCrouch InaccuracyMove InaccuracyJump InaccuracyFire InaccuracyLand \'\n          \'InaccuracyLadder SpreadAlt InaccuracyStandAlt InaccuracyCrouchAlt \'\n          \'InaccuracyMoveAlt InaccuracyJumpAlt InaccuracyFireAlt RecoveryTimeStand \'\n          \'RecoveryTimeCrouch MaxPlayerSpeed SpreadFunction BaseAccuracy AccuracyDivisor \'\n          \'AccuracyOffset MaxInaccuracy DefaultSpread DefaultSpreadOffset RunSpread \'\n          \'RunSpreadOffset MoveSpread MoveSpreadOffset JumpSpread JumpSpreadOffset \'\n          \'DuckingSpread DuckingSpreadOffset ProjectileGravity ProjectileForce \'\n          \'primary_ammo_InvenCategory PistolAccuracyBase PistolAccuracyModifier PistolAccuracyMax PistolAccuracyMin\').split()\n_TOKEN = re.compile(r\'\\s+|//[^\\r\\n]*|/\\*.*?\\*/|"(?:\\\\.|[^"\\\\])*"|[{}]|[^\\s{}"]+\', re.S)\n_RESOURCE = re.compile(r\'cstrike/scripts/weapon/weapon_([a-z0-9_]+)\\.(txt|etxt)$\', re.I)\n\n\n# One canonical identity is shared by catalog lookup, aim policy, cadence and\n# diagnostics. The handle/address remains the runtime identity; this value only\n# joins the corresponding script profile and telemetry rows.\n_WEAPON_ALIASES = {\n    \'m4\': \'m4a1\', \'m4a1silencer\': \'m4a1_silencer\',\n    \'m4a1s\': \'m4a1_silencer\', \'scar_h\': \'scarh\',\n    \'scar-h\': \'scarh\', \'usp45\': \'usp\', \'xt_97\': \'xt97\',\n}\n\ndef canonical_weapon_name(classname):\n    if not isinstance(classname, str):\n        return \'\'\n    if not re.fullmatch(r\'[A-Za-z0-9_-]+\', classname):\n        return \'\'\n    value = classname.casefold().replace(\'-\', \'_\')\n    for prefix in (\'cweapon\', \'weapon\', \'cw\'):\n        if value.startswith(prefix):\n            value = value[len(prefix):]\n            break\n    value = value.strip(\'_\')\n    return _WEAPON_ALIASES.get(value, value)\n\ndef name_candidates(classname):\n    if not isinstance(classname, str) or not re.fullmatch(r\'[A-Za-z0-9_]+\', classname):\n        return ()\n    name = classname.lower()\n    canonical = canonical_weapon_name(classname)\n    raw = name[7:].lstrip(\'_\') if name.startswith(\'cweapon\') else (\n        name[6:].lstrip(\'_\') if name.startswith(\'weapon\') else name)\n    candidates = [raw, canonical]\n    if raw.startswith(\'c\'):\n        candidates.append(raw[1:])\n    return tuple(dict.fromkeys(x for x in candidates if x))\n\n\ndef decode_script(data, filename):\n    if not data or len(data) > MAX_SCRIPT:\n        raise ValueError(\'empty_or_oversize_script\')\n    if filename.lower().endswith(\'.etxt\'):\n        if len(data) < 18:\n            raise ValueError(\'truncated_script_header\')\n        version, cipher, flag, size = struct.unpack_from(\'<HBBI\', data, 10)\n        if version != 2 or flag >= 8 or size != len(data) - 18 or size <= 0:\n            raise ValueError(\'invalid_script_header\')\n        if cipher not in (1, 2):\n            raise ValueError(\'unsupported_script_cipher_\' + str(cipher))\n        secret = SCRIPT_KEYS[flag // 2]\n        name = Path(filename).name.encode(\'ascii\')\n        key = hashlib.md5(struct.pack(\'<I\', version) +\n                          (secret + name if flag % 2 else name + secret)).digest()\n        from pkg_assets import AES\n        block = 8 if cipher == 1 else 16\n        with AES(key[:block], \'DES\' if cipher == 1 else \'AES\') as decoder:\n            data = decoder.decrypt(data[18:])\n        padding = data[-1]\n        if not 1 <= padding <= block or data[-padding:] != bytes([padding]) * padding:\n            raise ValueError(\'invalid_script_padding\')\n        data = data[:-padding]\n    # Some locally exported .txt resources retained their binary padding.\n    padding = data[-1] if data else 0\n    if padding in (*range(1, 9), *range(14, 17)) and data[-padding:] == bytes([padding]) * padding:\n        data = data[:-padding]\n    encoding = \'utf-16\' if data.startswith((b\'\\xff\\xfe\', b\'\\xfe\\xff\')) else \'utf-8-sig\'\n    return data.decode(encoding, errors=\'replace\').rstrip(\'\\x00\')\n\n\ndef parse_default(text):\n    tokens = []\n    for match in _TOKEN.finditer(text):\n        token = match.group()\n        if token.isspace() or token.startswith((\'//\', \'/*\')):\n            continue\n        tokens.append(token)\n    pos = 0\n\n    def unquote(value):\n        return value[1:-1].replace(\'\\\\"\', \'"\') if value.startswith(\'"\') else value\n\n    def block(nested=False, depth=0):\n        nonlocal pos\n        if depth > 32:\n            raise ValueError(\'script_nesting_limit\')\n        result = {}\n        while pos < len(tokens):\n            key = tokens[pos]; pos += 1\n            if key == \'}\':\n                if not nested:\n                    raise ValueError(\'unexpected_closing_brace\')\n                return result\n            if key == \'{\' or pos >= len(tokens) or tokens[pos] == \'}\':\n                raise ValueError(\'missing_script_value\')\n            value = tokens[pos]; pos += 1\n            key = unquote(key).casefold()\n            if key == \'default\' and key in result:\n                raise ValueError(\'ambiguous_default_block\')\n            result[key] = block(True, depth + 1) if value == \'{\' else unquote(value)\n        if nested:\n            raise ValueError(\'unterminated_script_block\')\n        return result\n\n    tree = block()\n    root = tree.get(\'weapondata\', tree)\n    default = root.get(\'default\', root if \'weapontype\' in root else None) if isinstance(root, dict) else None\n    if not isinstance(default, dict):\n        raise ValueError(\'missing_default_block\')\n    result = {\'profile_source\': \'script_default_unverified_variant\'}\n    for field in FIELDS:\n        value = default.get(field.casefold())\n        if isinstance(value, str):\n            try:\n                number = float(value)\n            except ValueError:\n                result[field] = value.lower()\n            else:\n                if not math.isfinite(number):\n                    raise ValueError(\'nonfinite_\' + field)\n                result[field] = number\n    kind = result.get(\'WeaponType\')\n    if not kind:\n        raise ValueError(\'missing_WeaponType\')\n    projectile = (result.get(\'primary_ammo_InvenCategory\') == \'explosive\' and\n                  (result.get(\'Bullets\') == 0 or \'ProjectileForce\' in result))\n    if projectile:\n        result[\'profile_status\'] = \'projectile\'\n        return result\n    if kind in FIREARMS:\n        for field in (\'CycleTime\', \'Range\'):\n            if not isinstance(result.get(field), (int, float)) or result[field] <= 0:\n                raise ValueError(\'invalid_\' + field)\n        if result.get(\'FullAuto\') not in (0., 1.):\n            raise ValueError(\'invalid_FullAuto\')\n    result[\'profile_status\'] = \'ready\' if kind in FIREARMS else \'non_firearm\'\n    return result\n\n\ndef is_firearm(profile):\n    return bool(profile and profile.get(\'WeaponType\') in FIREARMS and\n                profile.get(\'profile_status\', \'ready\') == \'ready\')\n\n\ndef profile_stop_reason(profile):\n    if not profile:\n        return \'武器参数载入中或未找到\'\n    status = profile.get(\'profile_status\')\n    if status == \'projectile\':\n        return \'抛射武器弹道待验证\'\n    if status in (\'invalid\', \'retrying\'):\n        return \'武器参数读取异常：\' + str(profile.get(\'profile_error\', status))\n    return \'当前武器不属于普通枪械\'\n\n\ndef fire_gate(profile, *, enabled, ammo, path_allowed, distance, aligned, protected_safe,\n              head_pending, progress_allowed, pose_verified, pose_age):\n    """Final eligibility; the production controller and GPU oracle share inputs."""\n    try:\n        in_range = math.isfinite(distance) and 0 <= distance <= float((profile or {}).get(\'Range\', 8192.))\n    except (TypeError, ValueError, OverflowError):\n        in_range = False\n    return bool(enabled and is_firearm(profile) and 0 < ammo < 10000 and path_allowed\n                and in_range and aligned and protected_safe and not head_pending\n                and progress_allowed and pose_verified and 0 <= pose_age <= .06)\n\n\ndef weapon_cycle(profile):\n    value=(profile or {}).get(\'CycleTime\',.15)\n    return float(value) if type(value) in (int,float) and math.isfinite(value) and 0<value<=10 else .15\n\n\ndef trigger_due(profile, now, last_fire, pressed, manual_left):\n    """Preserve native weapon cycles; holding a trigger is not another shot."""\n    if pressed or manual_left or not is_firearm(profile):\n        return False\n    cycle = weapon_cycle(profile)\n    return bool(profile.get(\'FullAuto\', 0)) or now - last_fire >= cycle\n\n\nclass WeaponCatalog:\n    """Background installation scan with atomic snapshots and bounded retries.\n\n    get() never reads package files. Missing profiles are not permanently cached.\n    Custom script data always takes priority, including its explicit errors.\n    """\n    def __init__(self, root, *, autostart=True, clock=time.monotonic):\n        self.root = Path(root)\n        self.clock = clock\n        self.profiles = {}\n        self.metrics = {\'state\': \'pending\', \'generation\': 0}\n        self._signature = None\n        self._manifest = None\n        self._entries = {}\n        self._package_failures = []\n        self._package_index = {}\n        self._next_check = 0.\n        self._lock = threading.Lock()\n        self._thread = None\n        if autostart:\n            self.request_refresh()\n\n    def request_refresh(self):\n        with self._lock:\n            if (self._thread is not None and self._thread.is_alive()) or self.clock() < self._next_check:\n                return\n            self._next_check = self.clock() + 5.\n            self._thread = threading.Thread(target=self._refresh_guarded,\n                                            name=\'weapon-resource-reader\', daemon=True)\n            self._thread.start()\n\n    def _refresh_guarded(self):\n        try:\n            self.refresh()\n        except Exception as error:\n            # Catastrophic scan errors retain the last published snapshot.\n            # Per-resource failures below invalidate only the affected entry.\n            self.metrics = dict(self.metrics, state=\'retrying\', error=str(error))\n            self._signature = None\n\n    def get(self, classname, *, refresh=True):\n        if refresh and self.clock() >= self._next_check:\n            self.request_refresh()\n        profiles = self.profiles\n        for name in name_candidates(classname):\n            if name in profiles:\n                return profiles[name]\n        return None\n\n    def status(self, classname):\n        profile = self.get(classname, refresh=False)\n        return dict(state=profile.get(\'profile_status\') if profile else\n                    (self.metrics[\'state\'] if self.metrics[\'state\'] in (\'pending\',\'retrying\') else \'missing\'),\n                    source=profile.get(\'profile_path\') if profile else None,\n                    error=profile.get(\'profile_error\') if profile else self.metrics.get(\'error\'),\n                    catalog_state=self.metrics[\'state\'],catalog_error=self.metrics.get(\'error\'),\n                    generation=self.metrics.get(\'generation\', 0))\n\n    def _package_rows(self,path,read_header):\n        # Hash the encrypted index, not an entire multi-gigabyte archive. All\n        # selected weapon payloads are separately read and hashed every scan.\n        stat=path.stat();prior=self._package_index.get(path.name)\n        def digest(span):\n            with path.open(\'rb\') as handle:data=handle.read(span)\n            return hashlib.sha256(data).hexdigest()\n        if prior and prior[\'span\']<=stat.st_size and digest(prior[\'span\'])==prior[\'hash\']:\n            return prior[\'rows\']\n        _,rows=read_header(path)\n        span=min(stat.st_size,305+len(rows)*288)\n        self._package_index[path.name]=dict(rows=rows,span=span,hash=digest(span))\n        return rows\n\n    def refresh(self):\n        from pkg_assets import read_header, extract\n        began = self.clock()\n        packages = sorted((self.root / \'Data\').glob(\'*.pkg\'))\n        entries={};package_errors={};failures=[]\n        for path in packages:\n            error=None\n            try:rows=self._package_rows(path,read_header)\n            except (OSError,ValueError,UnicodeError,struct.error) as ex:\n                error=ex;failures.append(dict(package=path.name,error=str(ex)))\n                # Remember ownership/precedence of an unavailable known pack.\n                # Do not silently select a lower-priority copy of its weapons.\n                rows=self._package_index.get(path.name,{}).get(\'rows\',())\n            for entry in rows:\n                match=_RESOURCE.fullmatch(entry[\'name\'])\n                if match:\n                    name=match[1].lower();entries[name]=entry\n                    package_errors[name]=error\n        live={p.name for p in packages}\n        self._package_index={k:v for k,v in self._package_index.items() if k in live}\n        loose = {}\n        for directory in (\'Data/cstrike/scripts/weapon\', \'scripts/weapon\', \'custom/scripts/weapon\'):\n            folder = self.root / directory\n            # A plain override takes priority over the matching encrypted file.\n            for suffix in (\'.etxt\', \'.txt\'):\n                for path in sorted(folder.glob(\'weapon_*\' + suffix)):\n                    name = path.stem[7:].lower()\n                    if re.fullmatch(\'[a-z0-9_]+\', name):\n                        loose[name] = path\n        # Same-size rewrites can preserve the timestamp (or share a filesystem\n        # timestamp tick). Snapshot small loose scripts in the background and\n        # key them by content. get() remains an in-memory lookup, not file I/O.\n        loose_data = {}; loose_signature = []\n        for name, path in sorted(loose.items()):\n            try:\n                if path.stat().st_size > MAX_SCRIPT:\n                    raise ValueError(\'oversize_script\')\n                data = path.read_bytes()\n                if len(data) > MAX_SCRIPT:\n                    raise ValueError(\'oversize_script\')\n                loose_data[name] = (data, None)\n                identity = hashlib.sha256(data).hexdigest()\n            except (OSError, ValueError) as error:\n                # One locked/removed override must not clear every weapon.\n                loose_data[name] = (None, error)\n                identity = (\'read_error\', type(error).__name__, str(error))\n            loose_signature.append((name, str(path), identity))\n        # Content identity also applies to packaged scripts. A same-metadata\n        # payload rewrite must be detected before taking the no-change exit.\n        records={};resource_signature=[]\n        for name in sorted(set(entries)|set(loose)):\n            path=loose.get(name);entry=entries.get(name)\n            origin=str(path.relative_to(self.root)) if path else entry[\'package\']+\':\'+entry[\'name\']\n            storage=\'loose\' if path else \'package\'\n            data=None;error=None\n            try:\n                if path:\n                    data,error=loose_data[name]\n                    if error is not None:raise error\n                    filename=path.name\n                else:\n                    error=package_errors[name]\n                    if error is not None:raise error\n                    if (Path(entry[\'package\']).name!=entry[\'package\'] or\n                            not 0<=entry[\'stored\']<=MAX_SCRIPT):raise ValueError(\'invalid_package_record\')\n                    data=extract(self.root,entry);filename=entry[\'name\'].rsplit(\'/\',1)[-1]\n                if len(data)>MAX_SCRIPT:raise ValueError(\'oversize_script\')\n                fingerprint=hashlib.sha256(data).hexdigest()\n            except (OSError,ValueError,UnicodeError,struct.error) as ex:\n                error=ex;filename=\'\';fingerprint=(\'read_error\',type(ex).__name__,str(ex))\n            records[name]=(origin,storage,filename,data,error,fingerprint)\n            resource_signature.append((name,origin,storage,fingerprint))\n        signature=(tuple(resource_signature),tuple((f[\'package\'],f[\'error\']) for f in failures))\n        if signature == self._signature:\n            return\n        profiles={}\n        for name,(origin,storage,filename,data,error,fingerprint) in records.items():\n            try:\n                if error is not None:raise error\n                old=self.profiles.get(name)\n                if (old and old.get(\'profile_hash\')==fingerprint and old.get(\'profile_path\')==origin\n                        and old.get(\'profile_storage\')==storage):\n                    profiles[name]=old;continue\n                profile = parse_default(decode_script(data, filename))\n                profile.update(profile_hash=fingerprint)\n            except (OSError, ValueError, UnicodeError, struct.error) as error:\n                profile = dict(profile_status=\'retrying\' if isinstance(error, OSError) else \'invalid\',\n                                profile_error=str(error))\n            profile.update(profile_name=name, profile_path=origin,\n                           profile_storage=storage)\n            profiles[name] = profile\n        self.profiles = profiles\n        retrying=any(p.get(\'profile_status\')==\'retrying\' for p in profiles.values())\n        self._signature=None if retrying else signature\n        self._entries=entries;self._package_failures=failures\n        self.metrics = dict(state=\'retrying\' if failures else \'ready\', generation=self.metrics.get(\'generation\', 0) + 1,\n                            scripts=len(profiles), ready=sum(is_firearm(p) for p in profiles.values()),\n                            invalid=sum(p[\'profile_status\'] == \'invalid\' for p in profiles.values()),\n                            error=\'; \'.join(f["package"]+\': \'+f[\'error\'] for f in failures) or None,\n                            package_failures=self._package_failures, scan_ms=(self.clock()-began)*1000)\n\n\ndef load_profile(root, classname):\n    """Synchronous inspection/test entry; production uses the background catalog."""\n    catalog = WeaponCatalog(root, autostart=False)\n    catalog.refresh()\n    return catalog.get(classname, refresh=False)\n')

_EMBEDDED['mode_ally_policy'] = (1, '"""Automatic same-camp opponent display; saved checkbox values are not input.\n\nMode IDs/names are from the installed custom/scripts/cso2_modlist.csv and\nresource/cso2_schinese.txt. ui_team=0 alone is NOT an FFA rule: infection,\nhide-and-seek and cooperative modes also have that flag.\n"""\nfrom dataclasses import replace\nfrom target_rules import FFA_MODE, PVE_MODE\n\nFFA_IDS = frozenset((15, 25, 60))\nPVE_IDS = frozenset((16, 20, 24, 36, 44, 45, 46, 57, 65))\nMODE_NAMES = {15: \'个人决战模式\', 25: \'RPG个人决战模式\', 60: \'娱乐挑战\'}\nALLY_LABEL = \'ESP 显示队友，按模式脚本自动识别开启（自动瞄准也会瞄准队友）\'\n\n\ndef mode_rule(native_id, prior=\'普通竞技\'):\n    # Production never inherits a manually selected FFA rule into another mode.\n    if native_id in FFA_IDS:\n        return FFA_MODE\n    if native_id in PVE_IDS:\n        return PVE_MODE\n    if native_id in (4, 30, 68, 73):\n        return \'幽灵模式（按阵营）\'\n    if native_id in (3, 37, 53):\n        return \'生化感染（按阵营）\'\n    if native_id == 38:\n        return \'恶灵附身（按阵营）\'\n    return \'普通竞技\'\n\n\ndef decide(native_id):\n    enabled = native_id in FFA_IDS\n    return dict(enabled=enabled, native_mode_id=native_id,\n        name=MODE_NAMES.get(native_id, f\'模式 {native_id}\' if native_id else \'模式待确认\'),\n        reason=\'个人对抗：显示同阵营对手\' if enabled else\n               \'按真实阵营区分队友与敌人\' if native_id else \'等待模式确认，关闭队友显示\',\n        source=\'native_mode_policy\', saved_setting_used=False,\n        actual_team_allies_targeted=False)\n\n\ndef apply(frame, cfg):\n    """Presentation config only. Never turn actual allies into enemy entities."""\n    return replace(cfg, allies=bool(getattr(frame, \'native_mode_id\', 0) in FFA_IDS))\n')
_EMBEDDED['radar_buy_contract'] = (1, '"""Deterministic round/UI gate and automatic-mode regression; no game writes."""\nimport ast\nimport copy\nimport inspect\nimport io\nimport struct\nimport unittest\nfrom types import SimpleNamespace as NS\nfrom unittest.mock import Mock, patch\n\nfrom radar_buy_delay import (ClientRoundState, RadarBuyDelay, delay_value,\n    notice_lines, bridge_state, display_bridge_state, DELAY_HINT, RULES_GLOBAL, PROXY_RVA, PROPERTIES)\nfrom radar_notice_layout import layout as notice_layout, draw_notice, NOTICE_COLOR, OUTLINE_COLOR\nfrom radar_team_contract import RadarMemory, make_reader, make_frame, C, R, A\n\n\ndef round_memory(mem, count=1, frozen=True, started=50.):\n    rules = 0x32000000\n    mem.put(C+RULES_GLOBAL, struct.pack(\'<I\', rules))\n    mem.put(C+PROXY_RVA, b\'\\x8b\\x4c\\x24\\x08\\xa1\'+struct.pack(\'<I\', C+RULES_GLOBAL)+b\'\\x89\\x01\\xc3\')\n    for i, (rva, name, offset, kind) in enumerate(PROPERTIES):\n        text = 0x33000000+i*128\n        mem.put(text, name.encode().ljust(64,b\'\\x00\'))\n        mem.put(C+rva, struct.pack(\'<II\', text, kind))\n        mem.put(C+rva+44, struct.pack(\'<I\', offset))\n    blob = bytearray(20)\n    struct.pack_into(\'<i\',blob,0,count)\n    blob[8] = frozen\n    struct.pack_into(\'<f\',blob,16,started)\n    mem.put(rules+0x2c, blob)\n    return rules\n\n\ndef run():\n    import cso2_bot_tool as app\n    import native_radar as radar\n    from native_mode import NativeMode\n    from mode_ally_policy import apply, decide, mode_rule, FFA_IDS, PVE_IDS, ALLY_LABEL\n    from target_rules import is_enemy, FFA_MODE\n    from radar_delay_ui import DelayInput\n\n    class TimerTests(unittest.TestCase):\n        def setUp(self):\n            self.now = 100.\n            self.reader, self.frame = NS(mem=NS(pid=7)), make_frame()\n            self.sample = dict(scope=(7,\'ITALY\'), count=1, frozen=True, started=50., source=\'fixture\')\n            self.sampler = NS(read=lambda *_: dict(self.sample))\n            self.gate = RadarBuyDelay(lambda:self.now, self.sampler)\n        def step(self, **kw):\n            return self.gate.step(self.reader, self.frame, kw.get(\'enabled\',True), kw.get(\'seconds\',6))\n        def test_default_minimum_maximum_and_corrupt_settings(self):\n            for value, expected in [(\'6\',6),(\'15\',15),(\'0\',6),(\'5\',6),(\'99\',15),(\'999\',15),\n                    (\'1000\',6),(\'1.5\',6),(None,6),(\'１２\',6),(\'bad\',6),(\'\',6),(\' 10 \',10)]:\n                with self.subTest(value=value): self.assertEqual(delay_value(value),expected)\n            self.assertEqual(app.Config().radar_delay_seconds,6)\n            self.assertEqual(DELAY_HINT,\'最大15秒，最低6秒钟\')\n        def test_exact_six_second_countdown(self):\n            for tick in range(7):\n                self.now=100.+tick\n                state=self.step()\n                self.assertEqual(state[\'remaining\'],6-tick)\n                self.assertEqual(state[\'allowed\'],tick==6)\n                self.assertEqual(state[\'phase\'],\'countdown\' if tick<6 else \'ready\')\n        def test_fifteen_second_countdown(self):\n            self.sample[\'frozen\']=False\n            for tick in range(16):\n                self.now=100.+tick\n                state=self.step(seconds=15)\n                self.assertEqual(state[\'remaining\'],15-tick)\n                self.assertEqual(state[\'allowed\'],tick==15)\n        def test_freeze_ends_without_second_countdown(self):\n            self.step();self.now=110.;self.assertEqual(self.step()[\'phase\'],\'ready\')\n            self.sample.update(frozen=False,started=60.)\n            state=self.step();self.assertTrue(state[\'allowed\']);self.assertEqual(state[\'generation\'],1)\n        def test_short_freeze_still_obeys_selected_delay(self):\n            self.step();self.now+=3.;self.sample.update(frozen=False,started=53.)\n            self.assertEqual(self.step()[\'remaining\'],3)\n            self.now+=3.;self.assertTrue(self.step()[\'allowed\'])\n        def test_sparse_frame_rate_uses_clock_not_ticks(self):\n            self.sample[\'frozen\']=False;self.step();self.now+=20.\n            self.assertTrue(self.step()[\'allowed\'])\n        def test_each_round_count_change_or_reset_rearms(self):\n            self.sample[\'frozen\']=False;self.step();self.now+=20.;self.step()\n            for count in (2,3,0,1):\n                self.sample[\'count\']=count\n                state=self.step();self.assertFalse(state[\'allowed\']);self.assertEqual(state[\'remaining\'],6)\n                self.now+=10.;self.assertTrue(self.step()[\'allowed\'])\n        def test_same_count_freeze_entry_rearms(self):\n            self.sample[\'frozen\']=False;self.step();self.now+=20.;self.step()\n            self.sample[\'frozen\']=True;self.assertEqual(self.step()[\'remaining\'],6)\n        def test_repeated_restart_in_freeze_rearms(self):\n            self.step();self.now+=4.;self.sample[\'started\']+=1.\n            self.assertEqual(self.step()[\'remaining\'],6)\n        def test_live_restart_timestamp_rearms(self):\n            self.sample[\'frozen\']=False;self.step();self.now+=20.;self.step()\n            self.sample[\'started\']+=5.;self.assertFalse(self.step()[\'allowed\'])\n        def test_new_map_or_memory_scope_rearms(self):\n            self.sample[\'frozen\']=False;self.step();self.now+=20.;self.step()\n            self.sample[\'scope\']=(7,\'DUST2\');self.frame.map_name=\'maps/de_dust2.bsp\'\n            self.assertEqual(self.step()[\'remaining\'],6)\n            self.now+=20.;self.step();self.sample[\'scope\']=(8,\'DUST2\')\n            self.assertEqual(self.step()[\'remaining\'],6)\n        def test_team_or_entity_identity_change_rearms(self):\n            self.sample[\'frozen\']=False;self.step()\n            for field in (\'team\',\'serial\',\'address\',\'index\'):\n                self.now+=20.;self.step();setattr(self.frame.local,field,getattr(self.frame.local,field)+1)\n                self.assertEqual(self.step()[\'remaining\'],6)\n        def test_disable_reenable_and_disconnect_reset(self):\n            self.sample[\'frozen\']=False;self.step();self.now+=20.;self.step()\n            self.assertEqual(self.step(enabled=False)[\'phase\'],\'disabled\')\n            self.assertEqual(self.step()[\'remaining\'],6)\n            self.gate.reset();self.now+=20.;self.assertEqual(self.step()[\'remaining\'],6)\n        def test_read_failure_blocks_radar_and_recovers_deadline(self):\n            self.sample[\'frozen\']=False;self.step();self.now+=3.\n            self.sampler.read=Mock(side_effect=RuntimeError(\'transient\'))\n            self.assertFalse(self.step()[\'allowed\'])\n            self.sampler.read=lambda *_:dict(self.sample)\n            self.assertEqual(self.step()[\'remaining\'],3)\n            self.now+=3.;self.assertTrue(self.step()[\'allowed\'])\n        def test_missing_frame_cannot_activate(self):\n            self.frame=None;self.assertEqual(self.step()[\'phase\'],\'waiting\')\n        def test_display_countdown_and_active_copy(self):\n            state=self.step()\n            self.assertEqual(notice_lines(state,102.)[0],\'4 秒后开启雷达显示敌方功能\')\n            self.assertEqual(notice_lines(state,102.)[1],\'届时将无法购买 CT 阵营的拆弹器\')\n            self.assertEqual(notice_lines(state,106.),())\n            self.assertEqual(notice_lines(dict(phase=\'active\')),())\n            for phase in (\'ready\',\'waiting\',\'frozen\'):\n                self.assertEqual(notice_lines(dict(phase=phase)),())\n            self.assertEqual(notice_lines(dict(phase=\'disabled\')),())\n        def test_buy_notice_uses_actual_actor_team_and_switches_with_team(self):\n            for team, expected in ((2,\'届时将无法购买 T 阵营专属枪械\'),\n                                   (3,\'届时将无法购买 CT 阵营的拆弹器\'),\n                                   (0,\'届时将无法购买本阵营装备\'),\n                                   (1,\'届时将无法购买本阵营装备\')):\n                self.frame.local.team=team\n                state=self.step()\n                self.assertEqual(notice_lines(state,self.now)[1],expected)\n        def test_missing_real_team_does_not_infer_it_from_ui_team(self):\n            for ui_team in (2,3):\n                state=dict(phase=\'countdown\',deadline=106.,ui_local_team=ui_team)\n                self.assertEqual(notice_lines(state,100.)[1],\'届时将无法购买本阵营装备\')\n        def test_bridge_rejects_stale_wrong_map_pid_or_reused_actor(self):\n            state=self.step();payload=dict(radar_delay=state)\n            self.assertEqual(bridge_state(payload,self.frame,7,100.),state)\n            for field, value in [(\'map\',\'wrong\'),(\'pid\',9),(\'local_index\',2),(\'local_serial\',99),\n                    (\'local_address\',4),(\'local_team\',2),(\'observed_at\',98.),(\'observed_at\',101.)]:\n                with self.subTest(field=field):\n                    bad=dict(state,**{field:value})\n                    self.assertEqual(bridge_state(dict(radar_delay=bad),self.frame,7,100.)[\'phase\'],\'waiting\')\n\n    class ReaderTests(unittest.TestCase):\n        def setUp(self):\n            self.mem=RadarMemory();self.reader=make_reader(self.mem);self.frame=make_frame()\n            self.rules=round_memory(self.mem);self.read=ClientRoundState()\n        def test_valid_fields_without_server_and_no_writes(self):\n            state=self.read.read(self.reader,self.frame)\n            self.assertEqual((state[\'count\'],state[\'frozen\'],state[\'started\']),(1,True,50.))\n            self.assertEqual(self.mem.writes+self.mem.ui_writes,[])\n        def test_wrong_proxy_rejected_every_read(self):\n            self.read.read(self.reader,self.frame);self.mem.put(C+PROXY_RVA,b\'\\x90\')\n            with self.assertRaises(RuntimeError): self.read.read(self.reader,self.frame)\n        def test_wrong_property_name_type_or_offset_rejected(self):\n            for field,value in [(0,struct.pack(\'<I\',0x30000100)),(4,struct.pack(\'<I\',2)),(44,struct.pack(\'<I\',1))]:\n                round_memory(self.mem);self.mem.put(C+PROPERTIES[0][0]+field,value)\n                with self.assertRaises(RuntimeError): ClientRoundState().read(self.reader,self.frame)\n            self.assertEqual(self.mem.writes+self.mem.ui_writes,[])\n        def test_invalid_round_values_rejected(self):\n            for count,freeze,start in [(-1,1,50.),(10000001,1,50.),(1,2,50.),(1,1,float(\'nan\')),(1,0,-1.)]:\n                round_memory(self.mem,count,freeze,start)\n                with self.assertRaises(RuntimeError): self.read.read(self.reader,self.frame)\n        def test_zero_rules_pointer_waits(self):\n            self.mem.put(C+RULES_GLOBAL,bytes(4))\n            with self.assertRaises(RuntimeError): self.read.read(self.reader,self.frame)\n        def test_tearing_read_rejected(self):\n            original=self.mem.read;calls=0\n            def tearing(addr,size):\n                nonlocal calls\n                raw=original(addr,size)\n                if addr==self.rules+0x2c:\n                    calls+=1\n                    if calls==2:return struct.pack(\'<i\',2)+raw[4:]\n                return raw\n            self.mem.read=tearing\n            with self.assertRaises(RuntimeError): self.read.read(self.reader,self.frame)\n        def test_actor_checked_before_and_after_read(self):\n            self.reader.control_identity=Mock(side_effect=[None,RuntimeError(\'identity changed\')])\n            with self.assertRaises(RuntimeError): self.read.read(self.reader,self.frame)\n            self.assertEqual(self.reader.control_identity.call_count,2)\n        def test_ui_team_override_does_not_change_countdown_team_or_write_memory(self):\n            import radar_team_view as view\n            for real_team in (2,3):\n                self.frame.local.team=real_team\n                self.mem.put(A+0xa0,struct.pack(\'<i\',real_team))\n                self.mem.set_team(1,5-real_team)\n                state=RadarBuyDelay(lambda:100.).step(self.reader,self.frame,True)\n                self.assertEqual(state[\'local_team\'],real_team)\n                self.assertEqual(self.mem.i32(R+view.TEAM_OFFSET+4),5-real_team)\n                self.assertIn(\' CT \' if real_team==3 else \' T \',notice_lines(state,100.)[1])\n            self.assertEqual(self.mem.writes+self.mem.ui_writes,[])\n        def test_server_display_validates_client_identity_without_matching_server_pointers(self):\n            old=self.reader.global_addr\n            self.reader.global_addr=lambda k:{\'signon\':0x38000000,\'local_index\':0x38000004}.get(k) or old(k)\n            self.mem.put(0x38000000,struct.pack(\'<ii\',6,0))\n            state=RadarBuyDelay(lambda:100.).step(self.reader,self.frame,True)\n            displayed=copy.deepcopy(self.frame);displayed.source=\'server\'\n            displayed.local.address=0x45000000;displayed.local.serial=99\n            self.assertEqual(bridge_state(dict(radar_delay=state),displayed,7,100.)[\'phase\'],\'waiting\')\n            self.assertEqual(display_bridge_state(dict(radar_delay=state),displayed,self.reader,100.),state)\n            self.mem.put(old(\'entity_entries\')+16,struct.pack(\'<II\',A,8))\n            self.assertEqual(display_bridge_state(dict(radar_delay=state),displayed,self.reader,100.)[\'phase\'],\'waiting\')\n\n    class IntegrationTests(unittest.TestCase):\n        def setUp(self):\n            self.now=100.;self.mem=RadarMemory();round_memory(self.mem)\n            self.reader=make_reader(self.mem);self.frame=make_frame()\n            self.reader.capabilities=dict(radar=dict(available=True));self.reader.feature_retry_after={}\n            def write(mem,addr,old,new):\n                self.assertEqual(mem.read(addr,1),old)\n                self.assertEqual(addr,C+radar.PATCH_RVA)\n                off=radar.PATCH_OFFSET;mem.code=mem.code[:off]+new+mem.code[off+1:]\n                mem.writes.append((addr,old.hex(),new.hex()))\n            self.w=app.Worker.__new__(app.Worker)\n            self.w.reader=self.reader;self.w.cfg=