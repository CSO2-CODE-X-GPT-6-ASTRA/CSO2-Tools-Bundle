ules\')\n            candidates=[(pid,mods)]\n        elif self.module_provider is modules:\n            candidates,_,_=discover_game_modules()\n        else:\n            candidates=[]\n            for pid in game_pids():\n                try:mods=self.module_provider(pid)\n                except (MemoryError,OSError):continue\n                if all(name in mods for name in (\'client.dll\',\'engine.dll\')):candidates.append((pid,mods))\n        pid,self.mods=choose_candidate(candidates,self.game)\n        self.game=game_root(self.mods[\'client.dll\'][2]);self.mem=WinMemory(pid)\n        self.client=self.mods[\'client.dll\'][0];self.engine=self.mods[\'engine.dll\'][0]\n        try:\n            # Only engine view/session globals are resolved. No client target globals.\n            self.resolved,_=resolve_module(self.mem,self.mods[\'engine.dll\'],_BUNDLE_DATA[\'compat_specs.json\'][\'engine.dll\'])\n        except Exception:self.close();raise\n        self.attach_timing=dict(total_ms=round((time.monotonic()-started)*1000,3))\n\n    def close(self):\n        self.display_camera.reset()\n        if self.pose_refresher:\n            try:self.pose_refresher.close()\n            except (RuntimeError,OSError):pass\n            self.pose_refresher=None\n        if self.mem:self.mem.close();self.mem=None\n        self.bound=None;self.models.clear();self.types.clear();self.slots.clear();self.throw_states.clear()\n        self.pose_activity.tracks.clear();self.scope=None;self.hazard_reader=None;self.hazard_retry=0.\n\n    def invalidate_binding(self):\n        """Drop SERVER addresses after a module/source transition."""\n        self.display_camera.reset()\n        if self.pose_refresher:\n            try:self.pose_refresher.close()\n            except (RuntimeError,OSError):pass\n            self.pose_refresher=None\n        self.bound=None;self.base=0;self.scope=None;self.slots.clear()\n        self.throw_states.clear();self.models.clear();self.types.clear()\n        self.pose_activity.tracks.clear();self.hazard_reader=None;self.hazard_retry=0.\n\n    def global_addr(self,name):\n        if name not in (\'local_index\',\'signon\',\'view_angles\',\'render\',\'level_name\'):\n            raise NotReady(\'CLIENT target globals are disabled for ESP: \'+name)\n        return self.resolved[name]\n\n    def camera_matrix(self,local_origin=None,local_scale=1.):\n        return self.display_camera.read(\n            lambda:struct.unpack(\'<16f\',self.mem.read(self.global_addr(\'render\')+0x9c,64)),self.scope,local_origin,local_scale)\n\n    def bind(self):\n        self.mods.update(self.module_provider(self.mem.pid));server=self.mods.get(\'server.dll\')\n        if not server or not server_compatible(self):\n            raise NotReady(\'SERVER ESP requires a compatible server.dll; CLIENT fallback disabled\')\n        m=self.mem;s=server[0]\n        for rva,name,offset in FIELDS:\n            if m.string(m.u32(s+rva),64)!=name or m.u32(s+rva+4)!=offset:\n                raise NotReady(\'SERVER ESP field mismatch: \'+name)\n        try:self.scale_fields_verified=all(m.string(m.u32(s+rva),64)==name and m.u32(s+rva+4)==offset for rva,name,offset in SERVER_FIELDS)\n        except (MemoryError,OSError,ValueError):self.scale_fields_verified=False\n        checks=[(0x485e89,b\'\\x83\\xb9\'+struct.pack(\'<I\',s+TABLE)+b\'\\0\'),\n                (0x375fe3,b\'\\x81\\xfe\'+struct.pack(\'<I\',s+0xb5fa44)),\n                (0x8c007,b\'\\x8b\\x35\'+struct.pack(\'<I\',s+0xb5fa44)),(0x8c043,b\'\\x8b\\x76\\x0c\'),\n                (0x2f7be3,bytes.fromhex(\'8b8f44040000\')),\n                (0x2f7bd2,bytes.fromhex(\'8b9f74040000\')),\n                (0x67c6e2,b\'\\x3b\\x05\'+struct.pack(\'<I\',s+0xa5f45c)),\n                (0x67c6f1,b\'\\xa1\'+struct.pack(\'<I\',s+0xa5f42c)),\n                (0x589049,bytes.fromhex(\'6a01680c070000\'))]\n        weapon=bytes.fromhex(\'8b896c08000083f9ff74170fb7c1c1e00405\')+struct.pack(\'<I\',s+TABLE)\n        checks.appe