_EMBEDDED['native_mode'] = (1, '"""Read the CLIENT mode-manager path; no server module or game calls required."""\nimport struct\nimport time\n\n\nclass NativeMode:\n    def __init__(self, reader):\n        self.reader = reader\n        self.next = 0.\n        self.value = 0\n        self.scope = None\n        self.status = \'模式未确认\'\n\n    def read(self):\n        now = time.monotonic()\n        try:\n            r = self.reader\n            m, c = r.mem, r.client\n            signon = m.i32(r.global_addr(\'signon\'))\n            map_name = m.string(r.global_addr(\'level_name\'), 160)\n            scope = (id(m), m.pid, c, r.engine, signon, map_name)\n            if scope != self.scope:\n                self.scope, self.next, self.value = scope, 0., 0\n            if signon != 6 or not map_name:\n                self.value = 0\n                self.status = \'等待当前地图模式\'\n                return 0\n            if now < self.next:\n                return self.value\n            self.next, self.value = now+.2, 0\n            self.status = \'模式数据待校验\'\n            expected = b\'\\x8b\\x0d\'+struct.pack(\'<I\', c+0x1cdbb54)+bytes.fromhex(\'8b01ff90cc010000\')\n            if m.read(c+0x1a2710, len(expected)) != expected:\n                self.status = \'客户端模式入口待校验\'\n                return 0\n            manager = m.u32(c+0x1cdbb54)\n            if not manager or m.u32(m.u32(manager)+0x1cc) != r.engine+0x2c5850:\n                return 0\n            key = m.i32(manager+0x2e8)\n            head = m.u32(manager+0x2ec)\n            node = m.u32(head+4)\n            for _ in range(32):\n                if not node or node == head:\n                    return 0\n                left, parent, right, color, index, obj, owner = struct.unpack(\'<7I\', m.read(node,28))\n                if index == key:\n                    getter = m.u32(m.u32(obj)+0x20)\n                    if not r.engine <= getter < r.engine+r.mods[\'engine.dll\'][1]:\n                        return 0\n                    if m.read(getter,5) != bytes.fromhex(\'0fb64114c3\'):\n                        return 0\n                    value = m.read(obj+0x14,1)[0]\n                    if m.u32(c+0x1cdbb54) != manager or m.i32(manager+0x2e8) != key:\n                        return 0\n                    if (m.i32(r.global_addr(\'signon\')) != signon\n                            or m.string(r.global_addr(\'level_name\'),160) != map_name):\n                        return 0\n                    self.value = value\n                    self.status = f\'原生模式 ID {value}\'\n                    return value\n                node = left if key < index else right\n        except (RuntimeError, OSError, ValueError, AttributeError, KeyError, struct.error):\n            self.value, self.next = 0, 0.\n            self.status = \'模式数据待更新\'\n        return 0\n')





