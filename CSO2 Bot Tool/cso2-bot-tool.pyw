\'\n    # time horizon and accidentally hide exposure to a second, later blast.\n    horizon=max(min(.35,g[\'remaining\']) for g,_ in blasts)\n    speed=motion[\'speed\']\n    # Estimate the short acceleration transition rather than assuming an\n    # instantaneous reverse at full speed. Plans are re-evaluated every reply.\n    def position(direction,t):\n        transition=min(.08,t);carry=transition*(1.-transition/.16)\n        return add(origin,tuple(velocity[k]*carry+direction[k]*speed*(t-carry) for k in range(3)))\n    weights=[min(1.,.35/max(.01,g[\'remaining\'])) for g,_ in blasts]\n    baseline=sum(r*w for r,w in zip(baseline_risks,weights));options=[]\n    for i in range(8):\n        angle=math.radians(actor.get(\'yaw\',0.))+i*math.pi/4;direction=(math.cos(angle),math.sin(angle),0.)\n        risks=[_ghost_damage_risk(position(direction,min(horizon,g[\'remaining\'])),p,g[\'radius\']) for g,p in blasts]\n        score=sum(r*w for r,w in zip(risks,weights));end=position(direction,horizon)\n        # A route must lower combined exposure, not just escape one grenade\n        # while moving into another. There is no promise of zero damage.\n        from types import SimpleNamespace\n        probe=SimpleNamespace(local=SimpleNamespace(origin=origin))\n        if (score<baseline-1e-8 and length(sub(end,origin))>=.25\n                and DodgeControls._direction_safe(probe,result,direction)):\n            options.append((score,sum(risks),direction,end))\n    for score,total,direction,end in sorted(options,key=lambda item:item[0]):\n        # During a turn the momentum path bends; check short successive pieces\n        # rather than shortcutting the entire transition across a corner.\n        times=sorted(set([min(t,horizon) for t in (.02,.04,.06,.08)]+[min(horizon,g[\'remaining\']) for g,_ in blasts]))\n        current=origin;floor_points={}\n        for t in times:\n            desired=position(direction,t)\n            current=_ghost_walk_route(bsp,current,(desire