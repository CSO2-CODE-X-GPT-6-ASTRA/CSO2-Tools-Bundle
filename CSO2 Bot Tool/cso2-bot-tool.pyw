 f=pending_scene(\'clear\');e=f.reader.entity\n            e.aim_hitboxes=(box(e.head,(3.,3.,3.),1),box((100.,0.,64.),(4.,4.,4.),4),box((128.,0.,44.),(8.,8.,8.),2))\n            d=tick(f,10.);self.assertNotEqual(d[\'aim_part\'],\'head\');self.assertTrue(d[\'head_intent\'][\'body_fire\'])\n\n        def test_missing_wall_mode_still_has_head_fire(self):\n            f=pending_scene(\'clear\');f.cfg.walls=False\n            d=tick(f,10.);self.assertIn(True,f.inputs.events,d);self.assertEqual(d[\'aim_part\'],\'head\')\n\n        def test_real_wall_probe_rotates_to_exposed_head_edge(self):\n            from wall_service import WallService\n            from static_prop_guard import StaticPropGuard\n            from aim_points import AimPoint\n            from geometry import WallHit\n            from types import SimpleNamespace as NS\n            f=scene(p=USP,generic=False,distance=550.);e=f.reader.entity\n            e.aim_points=[AimPoint(\'h\'+str(i),\'head\',(550.,float(i),64.),1.,i) for i in range(5)]+[e.aim_points[1]]\n            w=WallService.__new__(WallService);rays=[]\n            def trace(a,b,**kw):\n                rays.append(b)\n                return [WallHit(.1,.4,165.,\'T\',1)] if b[2]>60 and b[1]<3.9 else []\n            w.fast_bsp=NS(trace=trace,surface_materials={},static_fire_guard=StaticPropGuard([],{}))\n            w.map_args=(\'\',f.frame.map_name,None);f.wall=w\n            for i in range(6):\n                w.refresh_target(f.frame,e,USP,confirm=True)\n                d=tick(f,10.+i*.01)\n                if d.get(\'aim_part\')==\'head\':break\n                self.assertEqual(f.control.target,2,d)\n            self.assertEqual(d[\'aim_part\'],\'head\',d)\n            self.assertEqual(d[\'aim_point_id\'],\'h4\');self.assertLessEqual(i,4)\n\n        def test_target_dies_stops(self):\n            f=pending_scene();tick(f,10.);f.reader.entity.health=0\n            tick(f,10.01);self.assertFalse(f.control.pressed);self.assertEqual(f.control.target,0)\n\n        def test_compact_log_keeps_branch_reason(self):\n            from compact_log import compact_context\n            f=pending_scene();d=tick(f,10.);compact=compact_context(d)\n            self.assertEqual(compact[\'head_intent\'],d[\'head_intent\'])\n            self.assertEqual(compact[\'head_selection\'],d[\'head_selection\'])\n\n        def test_head_coordinate_region_is_preserved_in_fire_snapshot(self):\n            from aim_points import head_region_label,AimPoint\n            self.assertEqual(head_region_label(\'0:eye:1\'),\'eye_right\')\n            self.assertEqual(head_region_label(\'0:eye:2\'),\'eye_left\')\n            f=pending_scene(\'clear\');e=f.reader.entity\n            e.aim_points=[AimPoint(\'0:eye:1\',\'head\',e.head,3.,-10,visibility=\'visible\',\n                penetration={\'kind\':\'clear\',\'allowed\':True},head_region=\'eye_right\',model_local=(1.,2.,3.))]\n            d=tick(f,10.);self.assertEqual(d[\'fire_snapshot\'][\'head_region\'],\'eye_right\')\n            self.assertEqual(d[\'fire_snapshot\'][\'head_model_coord\'],(1.,2.,3.))\n\n        def test_pressed_single_direct_target_uses_near_lane_without_extra_rays(self):\n            from wall_service import WallService\n            from static_prop_guard import StaticPropGuard\n            from types import SimpleNamespace as NS\n            f=pending_scene(\'clear\');e=f.reader.entity;calls=[]\n            w=WallService.__new__(WallService)\n            w.fast_bsp=NS(trace=lambda a,b:calls.append((a,b)) or [],surface_materials={},\n                static_fire_guard=StaticPropGuard([],{}))\n            w.map_args=(\'\',f.frame.map_name,None);w.fast_records={};w.body_cursors={};w.head_cursors={};w.probe_cursors={}\n            cfg=f.cfg\n            rays,targets=w.refresh_candidates(f.frame,cfg,f.weapon,e.index,\'head\',fast_current=True)\n            self.assertEqual(targets,[e.index]);self.assertEqual(w.fast_metrics[\'probe_policy\'],\'nearest_admitted_first\')\n            self.assertLessEqual(rays,1);self.assertLessEqual(len(calls),1)\n\n        def test_installed_head_only_does_not_fall_back_to_visible_body(self):\n            f=pending_scene(\'clear\');e=f.reader.entity\n            with patch(\'aim_points.hostage_ray_status\',side_effect=lambda fr,p,*a,**kw:\'fixture guard\' if p[2]>60 else \'\'):\n                h=aim_points.select_aim_view(f.frame,e,USP,10.,head_only=True,require_safe=False)\n                self.assertEqual(h.aim_part,\'head\');self.assertTrue(h.aim_guard_reason)\n                self.assertIsNone(aim_points.select_aim_view(f.frame,e,USP,10.,head_only=True))\n                body=aim_points.select_aim_view(f.frame,e,USP,10.,require_safe=False)\n                self.assertNotEqual(body.aim_part,\'head\');self.assertFalse(body.aim_guard_reason)\n\n        def test_installed_missing_head_and_repeat_install(self):\n            import experimental_aim,cso2_bot_tool\n            f=pending_scene();e=f.reader.entity\n            e.aim_points=[p for p in e.aim_points if p.part!=\'head\']\n            self.assertIsNone(aim_points.select_aim_view(f.frame,e,USP,10.,head_only=True))\n            before=aim_points.select_aim_view;experimental_aim.install()\n            self.assertIs(aim_points.select_aim_view,before)\n            self.assertIs(cso2_bot_tool.select_aim_view,before)\n\n    # The GUI installs these wrappers; importing modules alone misses their\n    # keyword/signature/selection semantics. Run the real startup aim policy\n    # here too, then restore aliases so other contracts remain isolated.\n    import cso2_bot_tool,aim_tracking,experimental_aim\n    with patch.object(aim_points,\'select_aim_view\',aim_points.select_aim_view), \\\n         patch.object(cso2_bot_tool,\'select_aim_view\',cso2_bot_tool.select_aim_view), \\\n         patch.object(aim_tracking.AimTracker,\'update\',aim_tracking.AimTracker.update):\n        experimental_aim.install()\n        out=io.StringIO();r=unittest.TextTestRunner(stream=out,verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(Tests))\n    if not r.wasSuccessful():raise AssertionError(out.getvalue())\n    return dict(passed=True,tests=r.testsRun,motion_weapon_scenarios=48,runtime_aim_installed=True,game_attached=False,live_accuracy_verified=False)\n')

_EMBEDDED['right_click_contract'] = (1, '"""Behavior replaces former read-only assertions; engine I/O simulated, logic real."""\nimport io,struct,unittest\nfrom dataclasses import replace\nfrom types import SimpleNamespace as NS\nfrom unittest.mock import patch\n\ndef reserve_empty_fixture(engine, reader):\n """Simulate native bind table/signatures, then run actual reservation logic."""\n reader.engine=getattr(reader,\'engine\',0x10000000)\n reader.mods=dict(getattr(reader,\'mods\',{}),**{\'inputsystem.dll\':(0x20000000,0,\'\')})\n m=reader.mem;read=m.read;u32=m.u32;string=getattr(m,\'string\',lambda a,n:\'\')\n e=reader.engine;base=0x20000000;names={0x30000000+i*32:v for i,v in ((107,\'MOUSE1\'),(108,\'MOUSE2\'),(109,\'MOUSE3\'))}\n def native_read(address,size):\n  for off,op in ((0xe58ed,b\'\\x8b\\x04\\xc5\'),(0xe5753,b\'\\x8b\\x34\\xed\')):\n   if address==e+off:return op+struct.pack(\'<I\',e+0xaeb8a0)\n  return read(address,size)\n def native_u32(address):\n  if address==e+0xaeb8a0+108*8:return 0\n  for index in (107,108,109):\n   if address==base+0x47150+index*4:return 0x30000000+index*32\n  return u32(address)\n m.read=native_read;m.u32=native_u32;m.string=lambda a,n:names[a] if a in names else string(a,n)\n reader.game_ui_visible=getattr(reader,\'game_ui_visible\',lambda:False)\n assert engine.aim_binding.step(reader,True)\n\ndef run():\n from engine_attack import EngineAttack,Mouse2Binding\n from combat37_contract import scene,tick,USP\n class Environment:\n  def __init__(self,value=\'slot3\'):\n   self.current=value;self.clock=10.;self.focus=True;self.menu=False;self.held=False;self.alive=True;self.queue=[];self.sent=[];self.switches=0;self.thread_pending=False;self.closed=0\n   self.r=NS(mem=NS(pid=7,alive=lambda:self.alive),engine=0x10000000,mods={\'inputsystem.dll\':(0x20000000,0,\'\')},game_ui_visible=lambda:self.menu,require_feature=lambda f:None)\n   self.r.mem.read=self.read;self.r.mem.u32=self.u32;self.r.mem.string=self.string\n   self.win=NS(foreg