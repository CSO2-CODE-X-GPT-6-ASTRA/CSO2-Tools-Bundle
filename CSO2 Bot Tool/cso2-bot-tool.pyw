not once[0]:once[0]=True;lane.invalidate()\n                return trace(a,b)\n            bsp.trace=invalidate_once\n            with patch(\'exit_exposure.time.perf_counter\',return_value=0.):lane._work(stop,lane.wake)\n            self.assertTrue(once[0]);self.assertIsNone(lane.completed)\n        def test_close_clears_state_and_invalidates_pending_generation(self):\n            lane,f,bsp,r=prime();generation=lane.generation\n            lane.request={\'old\':True};lane.completed={\'old\':True};lane.close()\n            self.assertGreater(lane.generation,generation);self.assertFalse(lane.cache)\n            self.assertFalse(lane.history);self.assertIsNone(lane.request);self.assertIsNone(lane.completed)\n        def test_exit_overrides_only_threat_strategies_with_direct_targets(self):\n            baseline=row(actor(index=2),error=.1);outlet=ranked_hint(row(actor(index=3,x=650.),error=8.))\n            self.assertIs(choose_visible([baseline,outlet],0,\'准星最近\'),baseline)\n            self.assertIs(choose_visible([baseline,outlet],0,COMPREHENSIVE),outlet)\n            outlet[1].visibility=\'blocked\';outlet[1].penetration=dict(kind=\'penetration\',allowed=True)\n            for strategy in (\'准星最近\',NEAR_FIRST,COMPREHENSIVE):\n                self.assertIs(choose_visible([baseline,outlet],0,strategy),baseline)\n        def test_near_contact_and_rush_take_precedence(self):\n            for distance,rushing in ((100.,False),(180.,False),(400.,True)):\n                nearby=row(actor(index=2,x=distance),error=9.);nearby[3][\'rushing\']=rushing\n                outlet=ranked_hint(row(actor(index=3,x=650.),error=.1))\n                self.assertIsNone(choose_exit([nearby,outlet],0))\n                self.assertIs(choose_visible([nearby,outlet],0,\'准星最近\'),outlet)\n                self.assertIs(choose_visible([nearby,outlet],0,NEAR_FIRST),nearby)\n                self.assertFalse(preempts(outlet,nearby))\n        def test_stale_hint_and_distant_distraction_ignored(self)