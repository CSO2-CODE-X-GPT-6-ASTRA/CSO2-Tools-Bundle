(128);block[:4]=MAGIC\n            struct.pack_into(\'<I\',block,0x18,8)\n            struct.pack_into(\'<5f\',block,0x30,math.pi/180.,180.,360.,89.,-89.)\n            struct.pack_into(\'<6I\',block,0x44,reader.global_addr(\'local_player\'),reader.global_addr(\'signon\'),\n                export_address(reader,\'kernel32.dll\',\'GetTickCount\'),\n                export_address(reader,\'user32.dll\',\'GetForegroundWindow\'),\n                export_address(reader,\'user32.dll\',\'GetAsyncKeyState\'),original)\n            struct.pack_into(\'<I\',block,0x64,reader.client+0x1cddb34)\n            self.write(self.data,bytes(block))\n            # Mark ownership first so error cleanup can undo an installed slot.\n            reader._anti_aim_owner=self;self.installed=True\n            try:self.swap_slot(original,self.address)\n            except Exception:\n                self.pause(\'ANTI AIM：安装未完成\');raise\n\n    def pause(self,reason=\'ANTI AIM：暂停\'):\n        if self.installed and self.handle:self.write(self.data+4,struct.pack(\'<I\',0))\n        self.status=reason;self.active_since=None\n        self.metrics.update(active=False,status=reason)\n        return self.status\n\n    def step(self,reader,frame,cfg):\n        if not cfg.anti_aim:\n            if self.installed:self.close()\n            self.status=\'ANTI AIM：关闭\';return self.status\n        mode,period,amplitude,pitch=settings(cfg)\n        now=self.clock()\n        foreground=self.win.foreground(reader.mem.pid)\n        if not foreground:return self.pause(\'ANTI AIM：游戏后台，暂停\')\n        if now-frame.stamp>.25:return self.pause(\'ANTI AIM：等待新帧\')\n        if reader.game_ui_visible():return self.pause(\'ANTI AIM：菜单中暂停\')\n        if any(self.win.down(key) for key in (1,2)):\n            return self.pause(\'ANTI AIM：开火／瞄准时暂停\')\n        # Respawn and map-exit races pause this frame. Letting NotReady reach\n        # Worker.feature_call latches it into capability_failures permanently.\n        from reader impor