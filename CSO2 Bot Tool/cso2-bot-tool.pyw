_EMBEDDED['overlay_service'] = (1, '"""Independent Python renderer with its own GIL, reader and native back buffer."""\nimport json,math,os,queue,subprocess,sys,threading,time,traceback,ctypes\nfrom pathlib import Path\nfrom dataclasses import asdict,replace,fields\n\nHERE=Path(__file__).resolve().parent\n\ndef drawing_projection(reader,frame):\n    """Read the view just before drawing; keep the measured ray frame intact."""\n    import copy\n    from reader import NotReady,MemoryError\n    from server_esp import camera_eye\n    started=time.monotonic()\n    try:\n        origin=frame.local.origin if frame.local.reported_alive and frame.local.health>0 else None\n        matrix=reader.camera_matrix(origin,frame.local.geometry_scale)\n        camera=getattr(reader,\'display_camera\',None)\n        camera_metrics=getattr(camera,\'metrics\',{})\n        if camera_metrics.get(\'state\')==\'held\':\n            # The optional late read may return a prior cycle\'s matrix. It\n            # must not replace this cycle\'s view or acquire a new timestamp.\n            raise NotReady(\'late camera returned a retained matrix\')\n        eye=camera_eye(matrix)\n        angles=(-math.degrees(math.atan2(matrix[14],math.hypot(matrix[12],matrix[13]))),\n                math.degrees(math.atan2(matrix[13],matrix[12])),0.)\n    except (NotReady,MemoryError,OSError,ValueError) as ex:\n        # A failed optional late read keeps this cycle\'s validated camera.\n        # Do not stamp it as new or fetch any prior frame/pose.\n        return frame,dict(refreshed=False,stamp=frame.stamp,read_ms=(time.monotonic()-started)*1000,\n                          error=type(ex).__name__+\': \'+str(ex))\n    projected=copy.copy(frame)\n    projected.matrix=matrix;projected.eye=eye;projected.angles=angles\n    return projected,dict(refreshed=True,stamp=getattr(camera,\'stamp\',0.) or time.monotonic(),\n                          read_ms=(time.monotonic()-started)*1000,error=\'\')\n\n\ndef _config_from_state(values):\n    from cso2_bot_tool import Config\n    values=values if isinstance(values,dict) else {}\n    fields=set(getattr(Config,\'__dataclass_fields__\',{}))\n    return Config(**{name:value for name,value in values.items() if name in fields})\n\ndef decode_config(values):\n    """Accept only current Config fields at the process boundary."""\n    from cso2_bot_tool import Config\n    if not isinstance(values,dict):\n        return Config()\n    names={field.name for field in fields(Config)}\n    return Config(**{name:value for name,value in values.items() if name in names})\n\n\ndef _wall_json_value(value,depth=0):\n    """Keep the wall bridge bounded and strictly JSON serializable."""\n    if depth>8:return None\n    if value is None or isinstance(value,(str,bool,int)):return value\n    if isinstance(value,float):return value if math.isfinite(value) else None\n    if isinstance(value,(list,tuple)):\n        return [_wall_json_value(item,depth+1) for item in value]\n    if isinstance(value,dict):\n        return {str(key):_wall_json_value(item,depth+1) for key,item in value.items()}\n    return str(value)\n\n\ndef _wall_payload(wall_cache):\n    """Transport only stamped positive signals from the obstacle producer."""\n    from esp_feedback import normalize_obstacle_signal\n    if not isinstance(wall_cache,dict):return {}\n    payload={}\n    for index,raw in wall_cache.items():\n        signal=normalize_obstacle_signal(raw)\n        if signal is None or signal.get(\'display_evidence_stamp\') is None:continue\n        try:payload[str(int(index))]=_wall_json_value(signal)\n        except (ValueError,TypeError):pass\n    return payload\n\n\ndef apply_wall_bridge(frame,wall_cache,wall_context,game_pid,now=None,reader=None,*,control_points=False):\n    """Consume the obstacle producer\'s positive bit for each current actor."""\n    from copy import copy\n    from collections import Counter\n    from esp_feedback import normalize_obstacle_signal\n    now=time.monotonic() if now is None else now\n    context=wall_context if isinstance(wall_context,dict) else {}\n    def elapsed_ms(key):\n        stamp=context.get(key)\n        return (now-stamp)*1000 if type(stamp) in (int,float) and math.isfinite(stamp) and 0<=stamp<=now else None\n    control_source=context.get(\'control_source\',frame.source)\n    rejected=Counter()\n    def source_of(actor):\n        source=getattr(actor,\'display_source\',\'\') or frame.source\n        return \'server\' if source==\'server_assist\' else source\n    def identity_matches(actor,expected,source):\n        if (not isinstance(expected,(tuple,list)) or len(expected)!=3\n                or any(type(v) is not int for v in expected) or expected[0]!=actor.index):return False\n        index,address,serial=expected\n        if address==actor.address and (serial==actor.serial or\n                source==\'server\' and serial&0x3ff==actor.serial&0x3ff):return True\n        # Pointers and serials are native to each table. Verify both records\n        # in the current process; equality across the two tables is invalid.\n        if reader is None or source not in (\'server\',\'client\'):return False\n        try:\n            import struct\n            from server_esp import TABLE\n            def native(which):\n                base=(reader.global_addr(\'entity_entries\') if which==\'client\' else\n                      reader.mods[\'server.dll\'][0]+TABLE)\n                return struct.unpack(\'<II\',reader.mem.read(base+index*16,8))\n            sender=native(\'server\' if source==\'client\' else \'client\');receiver=native(source)\n            return (sender==(address,serial) and receiver[0]==actor.address and\n                    (receiver[1]==actor.serial or source==\'server\' and receiver[1]&0x3ff==actor.serial&0x3ff))\n        except (OSError,ValueError,KeyError,AttributeError,struct.error):return False\n    signal_scope=(context.get(\'map\')==frame.map_name and context.get(\'pid\')==game_pid\n        and context.get(\'weapon\',frame.weapon)==frame.weapon\n        and identity_matches(frame.local,context.get(\'local_identity\'),frame.source))\n    def model_key(value):return str(value or \'\').replace(\'\\\\\',\'/\').lower()\n    shown=[];applied=0;signal_samples=[];held=0;match_methods=[]\n    valid_parts=frozenset((\'head\',\'torso\',\'pelvis\',\'body\',\'arm\',\'leg\',\'eye\'))\n    def key_part_hint(value):\n        """Infer only an explicit anatomical suffix from legacy signals."""\n        if not isinstance(value,str):return None\n        if value in valid_parts:return value\n        for part in valid_parts:\n            if value.endswith(\':\'+part) or (part==\'eye\' and \':eye:\' in value):return part\n        return None\n    for entity in frame.entities:\n        base=getattr(entity,\'_esp_bridge_base\',entity);shown.append(base)\n        if not isinstance(wall_cache,dict):continue\n        raw=wall_cache.get(str(base.index),wall_cache.get(base.index))\n        if raw is None:continue\n        stamp=raw.get(\'display_evidence_stamp\',raw.get(\'stamp\')) if isinstance(raw,dict) else None\n        age=(now-stamp)*1000 if type(stamp) in (int,float) and math.isfinite(stamp) else None\n        sample=dict(index=base.index,age_ms=age,\n            source_key=raw.get(\'display_point_key\') if isinstance(raw,dict) else None,\n            source_part=raw.get(\'display_point_part\') if isinstance(raw,dict) else None,\n            activated=False)\n        if len(signal_samples)<8:signal_samples.append(sample)\n        if not signal_scope:rejected[\'session\']+=1;continue\n        if not isinstance(raw,dict):rejected[\'format\']+=1;continue\n        if not identity_matches(base,[base.index,raw.get(\'address\'),raw.get(\'serial\')],source_of(base)):\n            rejected[\'identity\']+=1;continue\n        if model_key(raw.get(\'model\',base.model))!=model_key(base.model):rejected[\'model\']+=1;continue\n        bit=normalize_obstacle_signal(raw,now=now)\n        if bit is None:\n            rejected[\'invalid\']+=1;continue\n        from geometry import length,sub\n        endpoint=bit.get(\'display_ray_head\')\n        from esp_feedback import native_points\n        points=native_points(base)\n        key=bit.get(\'display_point_key\')\n        # The producer owns revocation after checking the new path. Match its\n        # joint identity to today\'s measured coordinates, never its old XYZ.\n        point=next((p for p in points if p.key==key),None) if key else None\n        match=\'exact_key\' if point is not None else None\n        if point is None and control_points:\n            part=bit.get(\'display_point_part\') or key_part_hint(key)\n            if part in valid_parts:\n                same=[p for p in points if p.part==part or part==\'eye\' and p.part==\'head\']\n                # The rig-only publisher names its head "head"; the CLIENT\n                # sampler names head hitbox centers/rings with native IDs.\n                # Pick a current point inside that same anatomical region.\n                # Numeric box IDs and generic skeleton joints are never\n                # guessed into another body region.\n                if same:\n                    point=min(same,key=lambda p:(\n                        (\':eye:\' not in p.key) if part==\'eye\' else (\':eye:\' in p.key),\n                        not p.key.endswith(\':c\'),-float(p.radius),p.priority,p.key))\n                    match=\'same_part\'\n        if point is None and not key and endpoint is not None:\n            point=next((p for p in points if length(sub(p.position,endpoint))<=0.5),None)\n            if point is not None:match=\'endpoint_fallback\'\n        if point is None:\n            rejected[\'missing_point\']+=1\n            sample.update(reason=\'missing_point\',current_keys=[p.key for p in points[:8]])\n            continue\n        if age is not None and age>90:held+=1\n        candidate=copy(base);candidate.aim_points=[copy(p) for p in base.aim_points]\n        candidate.display_penetration=dict(bit,\n            display_point_key=point.key,\n            display_point_part=point.part,\n            display_ray_head=tuple(point.position),\n            display_ray_eye=tuple(frame.eye))\n        candidate.visibility=\'visible\' if base.visibility==\'visible\' else \'penetrable\'\n        candidate._esp_bridge_base=base;shown[-1]=candidate;applied+=1\n        sample.update(activated=True,method=match,current_key=point.key,current_part=point.part)\n        if len(match_methods)<16:match_methods.append(dict(index=base.index,method=match,\n            source_key=key,current_key=point.key,part=point.part))\n    frame.entities=shown\n    return dict(valid=bool(signal_scope),records=len(wall_cache) if isinstance(wall_cache,dict) else 0,\n        applied=applied,positive_bits=applied,geometry_held=held,rejected=dict(rejected),\n        interface=\'one_bit\',sampler_visibility_preserved=True,\n        signal_samples=signal_samples,match_methods=match_methods,\n        penetration_activated=bool(applied),\n        worker_elapsed_ms=(context[\'result_finished_at\']-context[\'result_started_at\'])*1000\n            if all(type(context.get(k)) in (int,float) and math.isfinite(context[k])\n                   for k in (\'result_started_at\',\'result_finished_at\')) else None,\n        worker_to_render_ms=elapsed_ms(\'result_finished_at\'),\n        receiver_to_render_ms=elapsed_ms(\'result_received_at\'),\n        mailbox_to_render_ms=elapsed_ms(\'submitted_at\'))\n\n\n\ndef surface_snapshot(overlay,view):\n    """Bounded live-window evidence; a draw call alone is not presentation."""\n    from ctypes import wintypes as W\n    from native_overlay import window_order\n    u=overlay.u;hwnd=overlay.hwnd\n    u.GetWindow.argtypes=[W.HWND,W.UINT];u.GetWindow.restype=W.HWND\n    u.GetWindowRect.argtypes=[W.HWND,ctypes.POINTER(W.RECT)];u.GetWindowRect.restype=W.BOOL\n    rect=W.RECT();valid=bool(u.GetWindowRect(hwnd,ctypes.byref(rect)))\n    game=view.get(\'game_window\');order=window_order(u,hwnd,game)\n    return dict(hwnd=hwnd,visible=bool(u.IsWindowVisible(hwnd)),\n                topmost=bool(u.GetWindowLongPtrW(hwnd,-20)&8),\n                owner=u.GetWindowLongPtrW(hwnd,-8),game_window=game,\n                **order,\n                rect=[rect.left,rect.top,rect.right,rect.bottom] if valid else None,\n                submitted_frames=overlay.submitted_frames,\n                placement=dict(overlay.presentation_guard.metrics),scope=\'window_state_not_pixel_acceptance\')\n\n\nclass DisplayFaultSurface:\n    """Commit complete current scenes; supply gaps never submit a blank scene.\n\n    This stores actor identities/model capabilities, not poses or ray results.\n    The native front bitmap stays untouched until a validated replacement is\n    ready. Explicit session invalidation still hides it in serve().\n    """\n    def __init__(self):\n        self.holds=0;self.last={};self.rigs={};self.actors=set();self.scope=None;self.complete_frames=0\n    def validate(self,frame,stats=None):\n        from server_esp import DisplaySampleUnavailable\n        scope=(frame.source,frame.map_name,frame.local.address,frame.local.serial)\n        if scope!=self.scope:self.rigs={};self.actors.clear();self.scope=scope\n        if (stats or {}).get(\'chain_complete\') is False:\n            raise DisplaySampleUnavailable(\'ESP awaiting complete entity enumeration\')\n        present={e.index for e in frame.entities}\n        failed={row.get(\'index\') for row in (stats or {}).get(\'errors\',()) if isinstance(row,dict)}\n        if any(key[0] in failed and key[0] not in present for key in self.actors):\n            raise DisplaySampleUnavailable(\'ESP awaiting complete current actor read\')\n        # A missing current rig affects only that actor. Never turn it into a\n        # whole-frame display stop and never reuse a previous rig.\n    def submitted(self,frame=None):\n        self.complete_frames+=1\n        if frame is not None:\n            self.actors={(e.index,e.address,e.serial) for e in frame.entities\n                if e.health>0 and not e.dormant and e.ragdoll_present is not True}\n            self.rigs={(e.index,e.address,e.serial):e.model for e in frame.entities\n                if e.skeleton and e.health>0 and not e.dormant and e.ragdoll_present is not True}\n    def recover(self,overlay,error,now,last_success,sample_stamp,can_present,stage=\'sampling\'):\n        from server_esp import DisplaySampleUnavailable,DisplayCameraUnavailable\n        if not can_present:\n            self.last=dict(action=\'viewport_unavailable\',window_retained=True)\n        elif isinstance(error,(DisplaySampleUnavailable,DisplayCameraUnavailable)) or stage!=\'surface\':\n            self.holds+=1\n            self.last=dict(action=\'await_complete_frame\',window_retained=True,\n                sample_age_ms=max(0.,now-sample_stamp)*1000 if sample_stamp>0 else None,\n                previous_scene_age_ms=max(0.,now-last_success)*1000 if last_success>0 else None)\n        else:\n            self.last=dict(action=\'surface_retry\',window_retained=True,\n                           error=type(error).__name__+\': \'+str(error))\n        return self.last\n    def snapshot(self):\n        return dict(sample_fault_hides=0,expired_bitmap_clears=0,\n                    retained_bitmaps=self.holds,complete_frames=self.complete_frames,\n                    deadline_hides=False,last_action=dict(self.last))\n\n\nclass OverlayService:\n    def __init__(self,game,*,monitor=True,probe=None,journal=None):\n        from esp_watchdog import PresentationWatch,WatchdogJournal\n        self.game=game;self.closed=False;self.latest={};self.pending=None;self.wake=threading.Event()\n        self.mail_lock=threading.Lock();self.error=\'\';self.metrics={};self.restarts=0;self.last_restart=0.\n        self.transport_failed=False;self.proc=None;self.last_heartbeat=0.;self.received_metrics=False;self.targets={};self.wall_geometry={}\n        self.last_config=None;self.last_target=None;self.last_warning=None;self.last_wall_payload=None;self.warning_sent=0.\n        self.watch=PresentationWatch();self.supervision={}\n        self.supervisor_stop=threading.Event();self.lifecycle_lock=threading.Lock()\n        self.supervisor_thread=None;self.probe=probe;self.probe_windows=None\n        self.restart_streak=0;self.next_restart=0.;self.last_incident={}\n        self.journal=WatchdogJournal(HERE) if journal is None else journal\n        try:self._spawn()\n        except Exception:\n            self.closed=True\n            if self.proc is not None:self._stop_process(self.proc)\n            raise\n        if monitor:\n            self.supervisor_thread=threading.Thread(target=self._supervise,\n                name=\'ESP-presentation-supervisor\',daemon=True)\n            self.supervisor_thread.start()\n    @property\n    def metrics(self):\n        # Reader and supervisor own separate snapshots: neither overwrites the\n        # other\'s newer evidence. Callers receive a new top-level dictionary.\n        return dict(getattr(self,\'_metrics\',{}),supervisor=dict(getattr(self,\'supervision\',{})))\n    @metrics.setter\n    def metrics(self,value):\n        self._metrics=value\n    def _spawn(self):\n        self.targets={};self.wall_geometry={}\n        self.last_config=None;self.last_target=None;self.last_warning=None;self.last_wall_payload=None;self.warning_sent=0.\n        self.last_restart=time.monotonic()\n        self.last_heartbeat=self.last_restart;self.received_metrics=False\n        self.watch.reset(self.last_restart)\n        self.metrics=dict(state=\'starting\',stage=\'spawned\',reason=\'renderer_starting\',observed_at=self.last_restart,renderer_restarts=self.restarts)\n        self.proc=subprocess.Popen([sys.executable,\'-X\',\'utf8\',\'-u\',str(BUNDLE_ENTRY),\'--overlay-worker\',str(self.game)],stdin=subprocess.PIPE,\n            stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,text=True,encoding=\'utf-8\',creationflags=subprocess.CREATE_NO_WINDOW)\n        self.transport_failed=False\n        self.error=\'\'\n        proc=self.proc\n        self.writer=threading.Thread(target=self._write,args=(proc,),daemon=True)\n        self.reader=threading.Thread(target=self._read,args=(proc,),daemon=True)\n        # Clear any previous generation\'s close message before its replacement\n        # writer starts; the shared wake event may already be set after teardown.\n        with self.mail_lock:\n            self.pending=dict(self.latest) if self.latest else None\n        self.writer.start();self.reader.start()\n        if self.latest:\n            self.wake.set()\n    def _write(self,proc):\n        try:\n            while self.proc is proc and proc.poll() is None:\n                self.wake.wait(.5);self.wake.clear()\n                if self.proc is not proc:return\n                with self.mail_lock:\n                    if self.proc is not proc:return\n                    message=self.pending;self.pending=None\n                if message is not None:\n                    proc.stdin.write(json.dumps(message,ensure_ascii=False,separators=(\',\',\':\'))+\'\\n\');proc.stdin.flush()\n                    if message.get(\'close\'):return\n        except (OSError,ValueError) as ex:\n            if self.proc is proc:\n                self.transport_failed=True;self.error=str(ex)\n    def _read(self,proc):\n        try:\n            for line in proc.stdout:\n                event=json.loads(line)\n                if self.proc is not proc:return\n                if \'targets\' in event and isinstance(event[\'targets\'],dict):\n                    self.targets=event[\'targets\']\n                if \'wall_geometry\' in event and isinstance(event[\'wall_geometry\'],dict):\n                    self.wall_geometry=event[\'wall_geometry\']\n                if \'metrics\' in event and isinstance(event[\'metrics\'],dict):\n                    self.last_heartbeat=time.monotonic();self.received_metrics=True\n                    self.metrics=dict(event[\'metrics\'],renderer_restarts=self.restarts)\n                    if self.metrics.get(\'state\') in (\'rendering\',\'sampling_hidden\'):self.error=\'\'\n                if \'error\' in event:self.error=event[\'error\']\n        except (OSError,ValueError) as ex:\n            if self.proc is proc:\n                self.transport_failed=True;self.error=str(ex)\n        finally:\n            if self.proc is proc:self.targets={};self.wall_geometry={}\n            if not self.closed and self.proc is proc:\n                self.transport_failed=True\n                if not self.error:self.error=\'独立绘制进程已退出，等待自动重连\'\n    def _join_transport(self,timeout=.25):\n        current=threading.current_thread()\n        for thread in (getattr(self,\'writer\',None),getattr(self,\'reader\',None)):\n            if thread and thread is not current and thread.ident is not None:thread.join(timeout=timeout)\n    def _stop_process(self,proc):\n        # Ask the renderer to close its sampler, shared publisher and HWND first.\n        # A genuinely stuck process still has bounded terminate/kill escalation.\n        if proc.poll() is None:\n            with self.mail_lock:self.pending={\'close\':True}\n            self.wake.set()\n            try:proc.wait(timeout=2.)\n            except subprocess.TimeoutExpired:\n                proc.terminate()\n                try:proc.wait(timeout=.5)\n                except subprocess.TimeoutExpired:proc.kill();proc.wait(timeout=.5)\n        self.wake.set();self._join_transport(.25)\n        for stream in (proc.stdin,proc.stdout):\n            if stream:\n                try:stream.close()\n                except (OSError,ValueError):pass\n    def _probe_viewport(self,report):\n        if self.probe is not None:return self.probe(report)\n        pid=report.get(\'game_pid\')\n        if not isinstance(pid,int) or pid<=0:return None\n        if self.probe_windows is None:\n            from cso2_bot_tool import Windows\n            self.probe_windows=Windows()\n        win=self.probe_windows\n        view=dict(win.viewport_state(pid),probe=\'supervisor_native_window\',game_pid=pid)\n        hwnd=(report.get(\'presentation\') or {}).get(\'surface_hwnd\')\n        if not hwnd:hwnd=(report.get(\'surface\') or {}).get(\'hwnd\')\n        if hwnd:\n            from ctypes import wintypes as W\n            owner=W.DWORD();win.u.GetWindowThreadProcessId(hwnd,ctypes.byref(owner))\n            proc=self.proc\n            valid=bool(win.u.IsWindow(hwnd) and proc and owner.value==proc.pid)\n            view[\'surface_probe\']=dict(hwnd=hwnd,owner_pid=owner.value,valid=valid,\n                                       visible=bool(valid and win.u.IsWindowVisible(hwnd)))\n        return view\n    def _save_supervision(self,event=False):\n        if self.journal:\n            self.journal.write(dict(self.supervision,renderer=self._metrics,\n                                    last_incident=self.last_incident),event=event)\n    def _supervise(self):\n        # This clock runs even when Worker.submit(), aiming or control sampling\n        # stop making progress. The renderer remains a separate OS process.\n        while not self.supervisor_stop.wait(.5):\n            try:self._supervise_once()\n            except Exception as ex:\n                self.supervision=dict(self.supervision,state=\'supervisor_retry\',\n                    error=type(ex).__name__+\': \'+str(ex),observed_at=time.monotonic())\n                try:self._save_supervision(event=True)\n                except Exception:pass\n    def _supervise_once(self,now=None):\n        if self.closed or not self.lifecycle_lock.acquire(blocking=False):return False\n        try:\n            if self.closed:return False\n            now=time.monotonic() if now is None else now\n            proc=self.proc;report=dict(self._metrics);view=None;probe_error=\'\'\n            try:view=self._probe_viewport(report)\n            except Exception as ex:probe_error=type(ex).__name__+\': \'+str(ex)\n            enabled=bool(self.latest.get(\'cfg\',{}).get(\'esp\',True))\n            presentation_reason=self.watch.evaluate(report,now,enabled=enabled,viewport=view)\n            from esp_watchdog import presentation_state\n            state=presentation_state(report)\n            exited=proc is None or proc.poll() is not None\n            # Starting forever with fresh heartbeat also has a deadline.\n            starting=state==\'starting\' and now-self.last_restart<30.\n            silent=now-self.last_heartbeat>(5. if self.received_metrics else 15.)\n            reason=(\'renderer_exited\' if exited else\n                    \'renderer_transport_failed\' if self.transport_failed else\n                    \'renderer_silent\' if silent and not starting else\n                    \'renderer_startup_stalled\' if state==\'starting\' and not starting else\n                    presentation_reason)\n            healthy=self.watch.healthy_since\n            if not reason and healthy is not None and now-healthy>=5.:\n                self.restart_streak=0;self.next_restart=0.\n            self.supervision=dict(self.watch.snapshot,observed_at=now,\n                owner_pid=os.getpid(),renderer_pid=getattr(proc,\'pid\',None),\n                autonomous=True,monitor_kind=\'dedicated_thread_with_separate_renderer_process\',\n                heartbeat_age_seconds=round(max(0.,now-self.last_heartbeat),3),\n                restarts=self.restarts,restart_streak=self.restart_streak,\n                retry_in_seconds=round(max(0.,self.next_restart-now),3),\n                probe_error=probe_error,journal_error=getattr(self.journal,\'error\',\'\'),\n                last_restart_reason=self.last_incident.get(\'reason\',\'\'))\n            if not reason:\n                self._save_supervision();return True\n            self.supervision.update(state=\'restar