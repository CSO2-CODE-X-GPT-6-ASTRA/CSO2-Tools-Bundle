assed=True,tests=result.testsRun+team_result[\'tests\'],\n                ui_team_tests=team_result[\'tests\'],native_cpu_comparison_executed=True,\n                real_team_unchanged=True,rollback_verified=True,game_attached=False,\n                live_native_radar_verified=False,gpu_required=False)\n')

_EMBEDDED['radar_team_view'] = (1, '"""Client PlayerResource presentation-team override; never an actor-team write.\n\nEvidence is bound to client SHA-256 by native_radar.verify_image:\nGetTeam at RVA 0x860a70 reads interface+0x468+slot*4; the interface is\nresource+0x5d0, hence resource+0xa38+slot*4. RecvProxy at 0x861070\nalso maintains the 66-entry team\'s CRC at resource+0x1028.\n"""\nimport struct\nimport zlib\n\nRESOURCE_GLOBAL = 0xecd9f4\nTEAM_PROP = 0x1cf0af4\nTEAM_PROXY = 0x861070\nTEAM_OFFSET = 0xa38\nTEAM_CRC = 0x1028\nSLOTS = 66\nCONNECTED = 0x2b10\nCONNECTED_COUNT = 0x2c18\nGET_TEAM = 0x860a70\nGET_TEAM_CODE = bytes.fromhex(\'8b4424048d50ff83fa40770a8b848168040000c2040033c0c20400\')\nRESOURCE_VTABLE = 0xca2340\nINTERFACE_VTABLE = 0xca21e0\n\n\ndef probe_layout(reader):\n    m, c = reader.mem, reader.client\n    prop = c + TEAM_PROP\n    if (m.string(m.u32(prop), 32) != \'m_iTeam\'\n            or m.u32(prop + 44) != TEAM_OFFSET or m.u32(prop + 4) != 6):\n        raise RuntimeError(\'雷达 UI：阵营资源字段布局不匹配\')\n    # This build\'s Array3 constructor (0x8a8240) creates a DataTable,\n    # not a flat RecvProp array. Parent stride/count retain -1/1. The\n    # 66 entries live in prop+0x28\'s table, each a 60-byte scalar prop.\n    table = m.u32(prop + 40)\n    if not table:\n        raise RuntimeError(\'雷达 UI：阵营资源子表尚未初始化\')\n    props, count = struct.unpack(\'<II\', m.read(table, 8))\n    if not props or count != SLOTS:\n        raise RuntimeError(\'雷达 UI：阵营资源子表长度不匹配\')\n    children = m.read(props, SLOTS * 60)\n    for i in range(SLOTS):\n        kind = struct.unpack_from(\'<I\', children, i*60+4)[0]\n        proxy = struct.unpack_from(\'<I\', children, i*60+32)[0]\n        offset = struct.unpack_from(\'<I\', children, i*60+44)[0]\n        if kind != 0 or offset != i*4 or proxy != c+TEAM_PROXY:\n            raise RuntimeError(\'雷达 UI：阵营资源子项布局不匹配：\'+str(i))\n    if m.read(c + GET_TEAM, len(GET_TEAM_CODE)) != GET_TEAM_CODE:\n        raise RuntimeError(\'雷达 UI：原生 GetTeam 读取路径不匹配\')\n\n\ndef counts(blob, slots):\n    values = struct.unpack(\'<66i\', blob)\n    return {\'CT\': sum(values[i] == 3 for i in slots),\n            \'T\': sum(values[i] == 2 for i in slots)}\n\n\nclass UiTeamView:\n    def __init__(self):\n        self.owner = None\n        self.metrics = {\'active\': False, \'actor_team_written\': False,\n                        \'server_team_written\': False, \'live_render_verified\': False}\n        self.last_restore = \'none\'\n        self.writes = 0\n        self.slot_owned = False\n        self.restore_value = None\n\n    @staticmethod\n    def same_owner(m, o):\n        return (m.alive()\n                and m.u32(o[\'base\'] + RESOURCE_GLOBAL) == o[\'resource\']\n                and m.u32(o[\'local_pointer\']) == o[\'actor\']\n                and m.read(o[\'entry\'], 8) == o[\'entry_value\']\n                and m.string(o[\'level\'], 160).replace(\'\\\\\', \'/\') == o[\'map\']\n                and m.i32(o[\'actor\'] + 0xa0) == o[\'real_team\'])\n\n    def snapshot(self, reader, frame):\n        probe_layout(reader)\n        reader.control_identity(frame)\n        m, c, actor = reader.mem, reader.client, frame.local\n        index = actor.index\n        if not isinstance(index, int) or not 1 <= index < SLOTS:\n            raise RuntimeError(\'雷达 UI：本机玩家索引不匹配\')\n        real = m.i32(actor.address + 0xa0)\n        if real not in (2, 3) or real != actor.team:\n            raise RuntimeError(\'雷达 UI：等待当前 T/CT 角色\')\n        resource = m.u32(c + RESOURCE_GLOBAL)\n        if not resource:\n            raise RuntimeError(\'雷达 UI：等待当前玩家资源\')\n        if (m.u32(resource) != c + RESOURCE_VTABLE\n                or m.u32(resource + 0x5d0) != c + INTERFACE_VTABLE\n                or m.u32(c + INTERFACE_VTABLE + 0x34) != c + GET_TEAM):\n            raise RuntimeError(\'雷达 UI：玩家资源对象类型不匹配\')\n        number = m.i32(resource + CONNECTED_COUNT)\n        if not 1 <= number < SLOTS:\n            raise RuntimeError(\'雷达 UI：玩家资源列表暂未就绪\')\n        slots = struct.unpack(\'<\' + \'i\' * number, m.read(resource + CONNECTED, number * 4))\n        if len(set(slots)) != number or any(not 1 <= i < SLOTS for i in slots) or index not in slots:\n            raise RuntimeError(\'雷达 UI：玩家资源列表身份不匹配\')\n        blob = m.read(resource + TEAM_OFFSET, SLOTS * 4)\n        o = dict(mem=m, pid=m.pid, base=c, resource=resource, index=index,\n                 actor=actor.address, serial=actor.serial, real_team=real,\n                 ui_team=5-real, original_ui_team=struct.unpack_from(\'<i\', blob, index*4)[0],\n                 entry=reader.global_addr(\'entity_entries\')+index*16,\n                 entry_value=struct.pack(\'<II\', actor.address, actor.serial),\n                 local_pointer=reader.global_addr(\'local_player\'),\n                 level=reader.global_addr(\'level_name\'), map=frame.map_name,\n                 slot_address=resource+TEAM_OFFSET+index*4)\n        if not self.same_owner(m, o):\n            raise RuntimeError(\'雷达 UI：角色或地图在采样期间变化\')\n        return o, blob, slots\n\n    @staticmethod\n    def key(o):\n        return (id(o[\'mem\']), o[\'pid\'], o[\'base\'], o[\'resource\'], o[\'actor\'],\n                o[\'index\'], o[\'serial\'], o[\'map\'], o[\'real_team\'])\n\n    def _write_slot(self, o, expected, replacement):\n        m = o[\'mem\']\n        if not self.same_owner(m, o):\n            raise RuntimeError(\'雷达 UI：写入前资源身份变化\')\n        if m.i32(o[\'slot_address\']) != expected:\n            raise RuntimeError(\'雷达 UI：写入前阵营值变化\')\n        m.allow_write()\n        # Only the UI resource\'s local slot is written, never a whole array.\n        if expected != replacement:\n            m.write(o[\'slot_address\'], struct.pack(\'<i\', replacement))\n            self.writes += 1\n        if m.i32(o[\'slot_address\']) != replacement:\n            raise RuntimeError(\'雷达 UI：本机 UI 阵营回读不一致\')\n        blob = m.read(o[\'resource\'] + TEAM_OFFSET, SLOTS*4)\n        crc = zlib.crc32(blob) & 0xffffffff\n        if not self.same_owner(m, o) or m.read(o[\'resource\'] + TEAM_OFFSET, SLOTS*4) != blob:\n            raise RuntimeError(\'雷达 UI：资源更新中，等待稳定快照\')\n        # Preserve the native RecvProxy\'s table invariant, rather than leaving\n        # its companion field stale. Other slots are never overwritten.\n        if m.u32(o[\'resource\'] + TEAM_CRC) != crc:\n            m.write(o[\'resource\'] + TEAM_CRC, struct.pack(\'<I\', crc))\n            self.writes += 1\n        if (m.read(o[\'resource\'] + TEAM_OFFSET, SLOTS*4) != blob\n                or m.u32(o[\'resource\'] + TEAM_CRC) != crc):\n            raise RuntimeError(\'雷达 UI：资源回读变化，等待重新同步\')\n        return blob, crc\n\n    def step(self, reader, frame, allow_preexisting=False):\n        o, before, slots = self.snapshot(reader, frame)\n        if self.owner is not None and self.key(self.owner) != self.key(o):\n            self.close()\n            o, before, slots = self.snapshot(reader, frame)\n        current = struct.unpack_from(\'<i\', before, o[\'index\']*4)[0]\n        if self.owner is None:\n            if current != o[\'real_team\'] and not (allow_preexisting and current == o[\'ui_team\']):\n                raise RuntimeError(\'雷达 UI：已有其他阵营资源修改，未接管\')\n            self.owner = o\n            self.slot_owned = False\n            self.restore_value = None\n        elif current not in (o[\'real_team\'], o[\'ui_team\']):\n            raise RuntimeError(\'雷达 UI：其他修改改变了本机 UI 阵营\')\n        owned = self.owner\n        try:\n            if current != owned[\'ui_team\'] and not self.slot_owned:\n                self.restore_value = current\n                self.slot_owned = True\n            after, crc = self._write_slot(owned, current, owned[\'ui_team\'])\n        except Exception:\n            self.metrics = dict(self.metrics, active=False, pending_readback=True)\n            raise\n        baseline = bytearray(after)\n        struct.pack_into(\'<i\', baseline, o[\'index\']*4, o[\'real_team\'])\n        actual = reader.mem.i32(o[\'actor\']+0xa0)\n        if actual != o[\'real_team\']:\n            raise RuntimeError(\'雷达 UI：真实角色阵营变化，等待重新绑定\')\n        self.metrics = dict(active=True, local_index=o[\'index\'], real_team=actual,\n            ui_local_team=o[\'ui_team\'], ui_counts=counts(after, slots),\n            ui_counts_without_local_override=counts(baseline, slots),\n            connected_players=len(slots), resource=o[\'resource\'],\n            resource_team_offset=TEAM_OFFSET, native_team_crc=crc,\n            native_team_crc_matches=True, team_value_readback=True,\n            actor_team_written=False, server_team_written=False,\n            live_render_verified=False, write_operations=self.writes,\n            ui_slot_ownership=\'owned\' if self.slot_owned else \'preexisting\',\n            map=o[\'map\'])\n        return dict(self.metrics)\n\n    def close(self):\n        o = self.owner\n        if o is None:\n            return\n        m = o[\'mem\']\n        if not self.same_owner(m, o):\n            self.last_restore = \'retired_identity_not_written\'\n        else:\n            current = m.i32(o[\'slot_address\'])\n            if self.slot_owned and current == o[\'ui_team\']:\n                self._write_slot(o, current, self.restore_value)\n                self.last_restore = \'original_ui_team_and_native_crc_restored\'\n            elif current == o[\'original_ui_team\'] or (self.slot_owned and current == self.restore_value):\n                self.last_restore = \'already_restored_by_native_update\'\n            elif not self.slot_owned and current == o[\'ui_team\']:\n                self.last_restore = \'preexisting_ui_slot_preserved\'\n            else:\n                self.last_restore = \'foreign_ui_value_preserved\'\n        self.owner = None\n        self.slot_owned = False\n        self.restore_value = None\n        self.metrics = dict(active=False, actor_team_written=False,\n                            server_team_written=False, live_render_verified=False,\n                            restore=self.last_restore)\n')

_EMBEDDED['radar_team_contract'] = (1, '"""Presentation-team tests use real layout offsets, not hard-coded UI totals."""\nimport io,struct,unittest,zlib\nfrom types import SimpleNamespace as NS\nimport radar_team_view as view\n\nC=0x10000000\nR=0x20000000\nA=0x25000000\nGLOBALS={\'entity_entries\':0x23000000,\'local_player\':0x24000000,\'level_name\':0x24000100}\nMAP=\'maps/CS_ITALY.bsp\'\n\nclass RadarMemory:\n    def __init__(self):\n        import native_radar as radar\n        self.pid=7;self.live=True;self.code=radar.CONTEXT;self.carrier=4\n        self.writes=[];self.ui_writes=[];self.data={};self.fail_crc_once=False\n        self.put(R,bytes(0x3000))\n        self.put(A,bytes(0x100))\n        self.put(A+0xa0,struct.pack(\'<i\',3))\n        self.put(GLOBALS[\'local_player\'],struct.pack(\'<I\',A))\n        self.put(GLOBALS[\'entity_entries\']+16,struct.pack(\'<II\',A,7))\n        self.put(GLOBALS[\'level_name\'],MAP.encode().ljust(160,bytes(1)))\n        self.put(C+view.RESOURCE_GLOBAL,struct.pack(\'<I\',R))\n        self.put(R,struct.pack(\'<I\',C+view.RESOURCE_VTABLE))\n        self.put(R+0x5d0,struct.pack(\'<I\',C+view.INTERFACE_VTABLE))\n        self.put(C+view.INTERFACE_VTABLE+0x34,struct.pack(\'<I\',C+view.GET_TEAM))\n        self.put(C+view.GET_TEAM,view.GET_TEAM_CODE)\n        self.put(C+view.TEAM_PROP,bytes(60))\n        self.put(C+view.TEAM_PROP,struct.pack(\'<I\',0x30000100))\n        self.put(C+view.TEAM_PROP+4,struct.pack(\'<I\',6))\n        self.put(C+view.TEAM_PROP+44,struct.pack(\'<III\',view.TEAM_OFFSET,0xffffffff,1))\n        self.put(C+view.TEAM_PROP+40,struct.pack(\'<I\',0x31000000))\n        self.put(0x31000000,struct.pack(\'<II\',0x31001000,66))\n        children=bytearray(66*60)\n        for i in range(66):\n            struct.pack_into(\'<I\',children,i*60+32,C+view.TEAM_PROXY)\n            struct.pack_into(\'<I\',children,i*60+44,i*4)\n        self.put(0x31001000,children)\n        self.put(0x30000100,b\'m_iTeam\'.ljust(64,bytes(1)))\n        self.put(C+0x1d01780,struct.pack(\'<I\',0x30000000))\n        self.put(C+0x1d01780+44,struct.pack(\'<I\',0x1660))\n        self.put(0x30000000,b\'m_iPlayerC4\'.ljust(64,bytes(1)))\n        self.roster(range(1,22))\n        for i in range(1,22):self.set_team(i,3 if i==1 else 2)\n        self.sync_crc()\n    def put(self,addr,data):\n        self.data.update((addr+i,b) for i,b in enumerate(data))\n    def set_team(self,index,team):\n        self.put(R+view.TEAM_OFFSET+index*4,struct.pack(\'<i\',team))\n    def sync_crc(self):\n        self.put(R+view.TEAM_CRC,struct.pack(\'<I\',zlib.crc32(self.read(R+view.TEAM_OFFSET,264))))\n    def roster(self,slots):\n        slots=tuple(slots)\n        self.put(R+view.CONNECTED_COUNT,struct.pack(\'<i\',len(slots)))\n        self.put(R+view.CONNECTED,struct.pack(\'<\'+\'i\'*len(slots),*slots))\n    def alive(self):return self.live\n    def allow_write(self):\n        if not self.live:raise RuntimeError(\'dead fixture\')\n    def read(self,addr,size):\n        import native_radar as radar\n        off=addr-(C+radar.CONTEXT_RVA)\n        if 0<=off and off+size<=len(self.code):return self.code[off:off+size]\n        if addr==R+0x1660 and size==4:return struct.pack(\'<i\',self.carrier)\n        try:return bytes(self.data[addr+i] for i in range(size))\n        except KeyError as ex:raise AssertionError((\'unexpected_read\',hex(addr),size)) from ex\n    def write(self,addr,data):\n        if addr not in (R+view.TEAM_OFFSET+4,R+view.TEAM_CRC):\n            raise AssertionError((\'write_outside_UI_local_slot_or_crc\',hex(addr),data))\n        if addr==R+view.TEAM_CRC and self.fail_crc_once:\n            self.fail_crc_once=False;raise RuntimeError(\'fixture CRC write failure\')\n        self.put(addr,data);self.ui_writes.append((addr,data.hex()))\n    def u32(self,addr):return struct.unpack(\'<I\',self.read(addr,4))[0]\n    def i32(self,addr):return struct.unpack(\'<i\',self.read(addr,4))[0]\n    def string(self,addr,size):return self.read(addr,size).split(bytes(1))[0].decode()\n\ndef make_frame(team=3):\n    return NS(map_name=MAP,local=NS(team=team,index=1,address=A,serial=7))\n\ndef make_reader(mem):\n    reader=NS(mem=mem,client=C,global_addr=lambda k:GLOBALS[k])\n    def identity(frame):\n        m=reader.mem\n        if (m.u32(GLOBALS[\'local_player\'])!=frame.local.address\n                or m.read(GLOBALS[\'entity_entries\']+16,8)!=struct.pack(\'<II\',frame.local.address,frame.local.serial)):\n            raise RuntimeError(\'fixture actor changed\')\n    reader.control_identity=identity\n    return reader\n\ndef run():\n    from unittest.mock import Mock\n    from cso2_bot_tool import Worker,Config\n    from feature_caps import effective_config\n    class Tests(unittest.TestCase):\n        def setUp(self):\n            self.mem=RadarMemory();self.reader=make_reader(self.mem)\n            self.frame=make_frame();self.feature=view.UiTeamView()\n        def assert_crc(self):\n            self.assertEqual(self.mem.u32(R+view.TEAM_CRC),zlib.crc32(self.mem.read(R+view.TEAM_OFFSET,264)))\n        def test_ct_one_t_twenty_becomes_ui_ct_zero_t_twenty_one(self):\n            result=self.feature.step(self.reader,self.frame)\n            self.assertEqual(result[\'ui_counts\'],{\'CT\':0,\'T\':21})\n            self.assertEqual(result[\'ui_counts_without_local_override\'],{\'CT\':1,\'T\':20})\n            self.assertEqual(self.mem.i32(A+0xa0),3);self.assert_crc()\n        def test_only_local_ui_slot_and_crc_are_written(self):\n            before=self.mem.read(R+view.TEAM_OFFSET,264);actor=self.mem.read(A,256)\n            self.feature.step(self.reader,self.frame)\n            after=self.mem.read(R+view.TEAM_OFFSET,264)\n            self.assertEqual(before[:4],after[:4]);self.assertEqual(before[8:],after[8:])\n            self.assertEqual(self.mem.read(A,256),actor)\n            self.assertEqual({a for a,_ in self.mem.ui_writes},{R+view.TEAM_OFFSET+4,R+view.TEAM_CRC})\n        def test_disable_restores_original_count_and_crc(self):\n            self.feature.step(self.reader,self.frame);self.feature.close()\n            self.assertEqual(view.counts(self.mem.read(R+view.TEAM_OFFSET,264),range(1,22)),{\'CT\':1,\'T\':20})\n            self.assert_crc()\n        def test_repeated_step_is_idempotent(self):\n            self.feature.step(self.reader,self.frame);n=len(self.mem.ui_writes)\n            for _ in range(10):self.feature.step(self.reader,self.frame)\n            self.assertEqual(len(self.mem.ui_writes),n)\n        def test_symmetric_t_player_is_presented_as_ct(self):\n            self.mem.put(A+0xa0,struct.pack(\'<i\',2));self.frame.local.team=2\n            for i in range(1,22):self.mem.set_team(i,2 if i==1 else 3)\n            self.mem.sync_crc()\n            result=self.feature.step(self.reader,self.frame)\n            self.assertEqual(result[\'ui_counts\'],{\'CT\':21,\'T\':0})\n            self.assertEqual(self.mem.i32(A+0xa0),2)\n        def test_other_ct_players_are_not_reassigned(self):\n            self.mem.set_team(2,3);self.mem.set_team(3,3);self.mem.sync_crc()\n            result=self.feature.step(self.reader,self.frame)\n            self.assertEqual(result[\'ui_counts\'],{\'CT\':2,\'T\':19})\n        def test_roster_count_is_dynamic_not_literal_twenty_one(self):\n            self.mem.roster(range(1,8))\n            self.assertEqual(self.feature.step(self.reader,self.frame)[\'ui_counts\'],{\'CT\':0,\'T\':7})\n        def test_spectators_are_not_counted_as_t(self):\n            self.mem.set_team(2,1);self.mem.sync_crc()\n            self.assertEqual(self.feature.step(self.reader,self.frame)[\'ui_counts\'],{\'CT\':0,\'T\':20})\n        def test_c4_carrier_is_untouched(self):\n            self.mem.carrier=17;self.feature.step(self.reader,self.frame)\n            self.assertEqual(self.mem.i32(R+0x1660),17)\n        def test_native_resource_reset_is_reapplied(self):\n            self.feature.step(self.reader,self.frame);self.mem.set_team(1,3);self.mem.sync_crc()\n            self.assertEqual(self.feature.step(self.reader,self.frame)[\'ui_local_team\'],2);self.assert_crc()\n        def test_dead_process_is_not_written_on_close(self):\n            self.feature.step(self.reader,self.frame);n=len(self.mem.ui_writes);self.mem.live=False\n            self.feature.close();self.assertEqual(len(self.mem.ui_writes),n)\n        def test_reader_rebinding_restores_only_original_memory(self):\n            self.feature.step(self.reader,self.frame);new=RadarMemory();self.reader.mem=new\n            self.feature.close();self.assertEqual(new.ui_writes,[])\n            self.assertEqual(self.mem.i32(R+view.TEAM_OFFSET+4),3)\n        def test_slot_reuse_does_not_restore_into_new_player(self):\n            self.feature.step(self.reader,self.frame);n=len(self.mem.ui_writes)\n            self.mem.put(GLOBALS[\'entity_entries\']+16,struct.pack(\'<II\',A,8))\n            self.feature.close();self.assertEqual(len(self.mem.ui_writes),n)\n        def test_map_change_does_not_restore_into_new_map(self):\n            self.feature.step(self.reader,self.frame);n=len(self.mem.ui_writes)\n            self.mem.put(GLOBALS[\'level_name\'],b\'maps/NEW.bsp\'.ljust(160,bytes(1)))\n            self.feature.close();self.assertEqual(len(self.mem.ui_writes),n)\n        def test_changed_real_team_is_not_overwritten(self):\n            self.feature.step(self.reader,self.frame);n=len(self.mem.ui_writes)\n            self.mem.put(A+0xa0,struct.pack(\'<i\',2))\n            self.feature.close();self.assertEqual(len(self.mem.ui_writes),n)\n        def test_existing_foreign_ui_projection_is_not_adopted(self):\n            self.mem.set_team(1,2);self.mem.sync_crc()\n            with self.assertRaises(RuntimeError):self.feature.step(self.reader,self.frame)\n            self.assertEqual(self.mem.ui_writes,[])\n        def test_exact_preexisting_ui_projection_is_preserved(self):\n            self.mem.set_team(1,2);self.mem.sync_crc()\n            result=self.feature.step(self.reader,self.frame,allow_preexisting=True)\n            self.assertEqual(result[\'ui_slot_ownership\'],\'preexisting\')\n            self.assertEqual(self.mem.ui_writes,[])\n            self.feature.close()\n            self.assertEqual(self.mem.i32(R+view.TEAM_OFFSET+4),2)\n            self.assertEqual(self.mem.ui_writes,[])\n        def test_adopted_projection_native_reset_is_restored_only_after_our_write(self):\n            self.mem.set_team(1,2);self.mem.sync_crc()\n            self.feature.step(self.reader,self.frame,allow_preexisting=True)\n            self.mem.set_team(1,3);self.mem.sync_crc()\n            result=self.feature.step(self.reader,self.frame,allow_preexisting=True)\n            self.assertEqual(result[\'ui_slot_ownership\'],\'owned\')\n            self.feature.close()\n            self.assertEqual(self.mem.i32(R+view.TEAM_OFFSET+4),3)\n            self.assert_crc()\n        def test_foreign_ui_change_is_preserved_on_close(self):\n            self.feature.step(self.reader,self.frame);self.mem.set_team(1,4);self.mem.sync_crc()\n            n=len(self.mem.ui_writes);self.feature.close()\n            self.assertEqual(len(self.mem.ui_writes),n);self.assertEqual(self.mem.i32(R+view.TEAM_OFFSET+4),4)\n        def test_bad_native_getter_signature_zero_writes(self):\n            self.mem.put(C+view.GET_TEAM,bytes(len(view.GET_TEAM_CODE)))\n            with self.assertRaises(RuntimeError):self.feature.step(self.reader,self.frame)\n            self.assertEqual(self.mem.ui_writes,[])\n        def test_bad_field_layout_zero_writes(self):\n            self.mem.put(C+view.TEAM_PROP+44,struct.pack(\'<I\',0xdead))\n            with self.assertRaises(RuntimeError):self.feature.step(self.reader,self.frame)\n            self.assertEqual(self.mem.ui_writes,[])\n        def test_duplicate_roster_zero_writes(self):\n            self.mem.roster([1,1,2])\n            with self.assertRaises(RuntimeError):self.feature.step(self.reader,self.frame)\n            self.assertEqual(self.mem.ui_writes,[])\n        def test_local_missing_from_roster_zero_writes(self):\n            self.mem.roster([2,3])\n            with self.assertRaises(RuntimeError):self.feature.step(self.reader,self.frame)\n            self.assertEqual(self.mem.ui_writes,[])\n        def test_stale_actor_team_zero_writes(self):\n            self.frame.local.team=2\n            with self.assertRaises(RuntimeError):self.feature.step(self.reader,self.frame)\n            self.assertEqual(self.mem.ui_writes,[])\n        def test_partial_write_keeps_rollback_ownership(self):\n            self.mem.fail_crc_once=True\n            with self.assertRaises(RuntimeError):self.feature.step(self.reader,self.frame)\n            self.assertIsNotNone(self.feature.owner);self.feature.close()\n            self.assertEqual(self.mem.i32(R+view.TEAM_OFFSET+4),3);self.assert_crc()\n        def test_memory_proof_is_not_reported_as_render_proof(self):\n            result=self.feature.step(self.reader,self.frame)\n            self.assertFalse(result[\'live_render_verified\'])\n            self.assertFalse(result[\'actor_team_written\'])\n            self.assertFalse(result[\'server_team_written\'])\n        def test_real_nested_array_layout_passes(self):\n            self.assertEqual(self.mem.i32(C+view.TEAM_PROP+48),-1)\n            self.assertEqual(self.mem.u32(C+view.TEAM_PROP+52),1)\n            view.probe_layout(self.reader)\n        def test_wrong_nested_length_zero_writes(self):\n            self.mem.put(0x31000004,struct.pack(\'<I\',65))\n            with self.assertRaises(RuntimeError):self.feature.step(self.reader,self.frame)\n            self.assertEqual(self.mem.ui_writes,[])\n        def test_wrong_nested_stride_zero_writes(self):\n            self.mem.put(0x31001000+7*60+44,struct.pack(\'<I\',7*8))\n            with self.assertRaises(RuntimeError):self.feature.step(self.reader,self.frame)\n            self.assertEqual(self.mem.ui_writes,[])\n        def test_wrong_nested_proxy_zero_writes(self):\n            self.mem.put(0x31001000+7*60+32,struct.pack(\'<I\',C+0xdead))\n            with self.assertRaises(RuntimeError):self.feature.step(self.reader,self.frame)\n            self.assertEqual(self.mem.ui_writes,[])\n        def test_wrong_nested_type_zero_writes(self):\n            self.mem.put(0x31001000+7*60+4,struct.pack(\'<I\',1))\n            with self.assertRaises(RuntimeError):self.feature.step(self.reader,self.frame)\n            self.assertEqual(self.mem.ui_writes,[])\n        def test_missing_nested_table_zero_writes(self):\n            self.mem.put(C+view.TEAM_PROP+40,bytes(4))\n            with self.assertRaises(RuntimeError):self.feature.step(self.reader,self.frame)\n            self.assertEqual(self.mem.ui_writes,[])\n    class IntentTests(unittest.TestCase):\n        def worker(self,requested=True,available=True):\n            w=Worker.__new__(Worker)\n            w.reader=NS(capabilities={\'radar\':dict(available=available,reason=\'\' if available else \'fixture layout failure\')},\n                        feature_retry_after={})\n            w.cfg=Config(radar=requested);w.radar_status=\'雷达：关闭\';w.battle=None\n            # This fixture isolates capability intent after the independent timer gate.\n            # Real countdown/freeze integration is exercised by radar_buy_contract.\n            w.radar_delay=NS(step=Mock(return_value=dict(phase=\'ready\',allowed=True)))\n            w.native_radar=NS(owned=False,team_view=NS(owner=None),metrics=dict(active=False),\n                close=Mock(),step=Mock(return_value=\'雷达：UI CT=0 · T=21\'))\n            w.post=Mock()\n            w.cleanup=lambda label,action:action()\n            w.feature_call=lambda keys,action,cleanup:action()\n            return w\n        def test_requested_but_unavailable_is_not_reported_as_off(self):\n            w=self.worker(available=False);caps=w.reader.capabilities\n            status=w.update_native_radar(None,effective_config(w.cfg,caps),caps)\n            self.assertIn(\'fixture layout failure\',status)\n            self.assertNotEqual(status,\'雷达：关闭\')\n            w.native_radar.step.assert_not_called()\n        def test_runtime_evidence_retains_exact_probe_failure(self):\n            w=self.worker(available=False);d=w.radar_diagnostics()\n            self.assertTrue(d[\'requested\']);self.assertFalse(d[\'effective_enabled\'])\n            self.assertEqual(d[\'capability_reason\'],\'fixture layout failure\')\n        def test_recovered_capability_executes_preserved_request(self):\n            w=self.worker(available=False);caps=w.reader.capabilities\n            w.update_native_radar(None,effective_config(w.cfg,caps),caps)\n            caps[\'radar\']=dict(available=True,reason=\'\')\n            status=w.update_native_radar(None,effective_config(w.cfg,caps),caps)\n            self.assertEqual(status,\'雷达：UI CT=0 · T=21\')\n            w.native_radar.step.assert_called_once_with(w.reader,None,True)\n        def test_user_disabled_is_still_disabled(self):\n            w=self.worker(requested=False);caps=w.reader.capabilities\n            w.update_native_radar(None,effective_config(w.cfg,caps),caps)\n            w.native_radar.step.assert_called_once_with(w.reader,None,False)\n        def test_blocked_owned_patch_is_restored(self):\n            w=self.worker(available=False);w.native_radar.owned=True\n            caps=w.reader.capabilities;w.update_native_radar(None,effective_config(w.cfg,caps),caps)\n            w.native_radar.close.assert_called_once()\n        def test_diagnostics_do_not_claim_live_hud_acceptance(self):\n            self.assertFalse(self.worker().radar_diagnostics()[\'live_hud_verified\'])\n    output=io.StringIO()\n    suite=unittest.TestSuite(unittest.defaultTestLoader.loadTestsFromTestCase(c) for c in (Tests,IntentTests))\n    result=unittest.TextTestRunner(stream=output,verbosity=2).run(suite)\n    if not result.wasSuccessful():raise AssertionError(output.getvalue())\n    return dict(passed=True,tests=result.testsRun,ui_team_projection=True,\n                native_layout_verified=True,game_attached=False,live_render_verified=False)\n')

_EMBEDDED['esp_watchdog'] = (1, '"""Presentation liveness policy. No game-memory, input, GPU or UI writes."""\nimport json\nimport math\nimport os\nimport time\nfrom pathlib import Path\n\n\ndef number(value):\n    return isinstance(value, (float, int)) and not isinstance(value, bool) and math.isfinite(value)\n\n\ndef presentation_state(report):\n    """A submitted first frame is not an initialization phase.\n\n    Accept the old renderer\'s mislabeled event without fabricating scene\n    counters. A frozen first frame still hits the ordinary stall deadline.\n    """\n    state=report.get(\'state\',\'unobserved\')\n    submitted=report.get(\'submitted_frames\')\n    if submitted is None:\n        submitted=(report.get(\'presentation\') or {}).get(\'submitted_frames\')\n    if (state==\'starting\' and report.get(\'stage\')==\'first_frame_presented\'\n            and number(submitted) and submitted>0):\n        return \'rendering\'\n    return state\n\n\nclass PresentationWatch:\n    """A heartbeat is not evidence of a progressing scene."""\n    def __init__(self):\n        self.reset(0.)\n\n    def reset(self, now):\n        self.started = now\n        self.last_progress = now\n        self.fingerprint = None\n        self.problem = \'\'\n        self.problem_since = None\n        self.ready_since = None\n        self.healthy_since = None\n        self.snapshot = {}\n\n    def evaluate(self, metrics, now, *, enabled=True, viewport=None):\n        report = metrics if isinstance(metrics, dict) else {}\n        own_view = report.get(\'viewport\') or {}\n        view = viewport if isinstance(viewport, dict) and \'rect\' in viewport else own_view\n        session = report.get(\'session\') or {}\n        presentation = report.get(\'presentation\') or {}\n        surface = report.get(\'surface\') or {}\n        state = presentation_state(report)\n        self.snapshot = dict(state=\'observing\', renderer_state=state, restart_reason=\'\',\n            viewport=view, renderer_viewport=own_view, scene_frames=presentation.get(\'scene_frames\'),\n            submitted_frames=presentation.get(\'submitted_frames\', surface.get(\'submitted_frames\')),\n            scene_age_seconds=round(max(0., now-self.last_progress), 3),\n            live_pixels_verified=False)\n        passive = (\'disabled\' if not enabled else\n                   \'viewport_unavailable\' if not view.get(\'rect\') else\n                   \'waiting_for_session\' if session.get(\'signon\') != 6 and not session.get(\'error\') else \'\')\n        if passive:\n            self.problem = \'\'; self.problem_since = None\n            self.ready_since = None; self.healthy_since = None; self.last_progress = now\n            self.snapshot.update(state=passive)\n            return \'\'\n        if self.ready_since is None:\n            self.ready_since = now\n            self.last_progress = now\n        sequence = presentation.get(\'scene_frames\')\n        hwnd = presentation.get(\'surface_hwnd\', surface.get(\'hwnd\'))\n        fingerprint = (hwnd, sequence)\n        progressed = (number(sequence) and sequence > 0 and fingerprint != self.fingerprint)\n        if progressed:\n            self.fingerprint = fingerprint\n            self.last_progress = now\n        surface_probe = view.get(\'surface_probe\') or {}\n        entry = report.get(\'window_entry\') or {}\n        bitmap = report.get(\'bitmap\') or {}\n        unhealthy_surface = (surface_probe.get(\'valid\') is False or\n            surface_probe.get(\'visible\') is False or surface.get(\'visible\') is False)\n        from display_recovery import sampler_owns_wait\n        upstream_wait=sampler_owns_wait(report,now)\n        reason = (\'renderer_session_probe_failed\' if session.get(\'error\') else\n                  \'renderer_startup_stalled\' if state == \'starting\' else\n                  \'viewport_disagrees_with_renderer\' if state == \'sampling_hidden\' else\n                  \'renderer_recovering_without_scene\' if state != \'rendering\' and not upstream_wait else\n                  \'renderer_surface_unavailable\' if unhealthy_surface else\n                  \'renderer_bitmap_empty\' if bitmap.get(\'expected_primitives\',0)>0 and\n                      bitmap.get(\'nontransparent_pixels\')==0 else\n                  \'game_entry_not_presented\' if entry.get(\'pending\') else\n                  \'renderer_missing_presentation\' if not number(sequence) else\n                  \'renderer_scene_stalled\' if now-self.last_progress >= 4. and not upstream_wait else \'\')\n        if reason == \'renderer_scene_stalled\':\n            since = self.last_progress\n        else:\n            # Switching error strings/stages is not progress. Preserve the\n            # beginning of a continuous non-presenting incident.\n            since = self.problem_since if self.problem_since is not None else now\n        if reason:\n            self.problem = reason; self.problem_since = since; self.healthy_since = None\n            limit = 30. if state == \'starting\' else (2. if reason in (\n                \'renderer_bitmap_empty\',\'game_entry_not_presented\') else (4. if reason in (\n                \'renderer_scene_stalled\', \'renderer_surface_unavailable\') else 6.)\n            )\n            sampling = report.get(\'sampling_health\') or {}\n            # Do not repeatedly kill a new sampler before its own bounded\n            # initialization window can finish (resource/map startup).\n            if (reason == \'renderer_recovering_without_scene\' and\n                    sampling.get(\'process_alive\') is True and\n                    sampling.get(\'received_reply\') is False):\n                limit = 30.\n            restart = now-since >= limit\n            self.snapshot.update(state=\'restart_needed\' if restart else \'grace\',\n                problem=reason, incident_seconds=round(max(0., now-since), 3),\n                scene_age_seconds=round(max(0., now-self.last_progress), 3),\n                restart_reason=reason if restart else \'\')\n            return reason if restart else \'\'\n        if upstream_wait:\n            # Active source rejection is owned by acquisition. Retain all\n            # explicit surface/session/entry checks above; never call this a\n            # progressing scene or reset the service\'s healthy restart streak.\n            self.problem=\'\';self.problem_since=None;self.healthy_since=None\n            self.snapshot.update(state=\'waiting_for_sources\',recovery_owner=\'sampler\',\n                                 scene_age_seconds=round(max(0.,now-self.last_progress),3))\n            return \'\'\n        self.problem = \'\'; self.problem_since = None\n        if self.healthy_since is None: self.healthy_since = now\n        self.snapshot.update(state=\'progressing\' if progressed else \'awaiting_next_report\',\n                             scene_age_seconds=round(max(0., now-self.last_progress), 3))\n        return \'\'\n\n\nclass WatchdogJournal:\n    """Per-owner bounded journal; useful even when the control Worker is stuck."""\n    def __init__(self, directory, owner=None):\n        self.directory = Path(directory)\n        self.owner = int(owner if owner is not None else os.getpid())\n        self.stem = \'esp_watchdog_\' + str(self.owner)\n        self.next_at = 0.\n        self.error = \'\'\n        self.display_key = None\n        self.display_next_at = 0.\n\n    def _display_event(self, record, now):\n        """Keep short outages even when no process restart was warranted.\n\n        Called on the supervisor thread, never on the render/sample hot path.\n        Native window state and bitmap contents remain distinct from pixels\n        actually observed on the user\'s screen.\n        """\n        r=record.get(\'renderer\') or {}\n        if not r:return\n        continuity=r.get(\'display_continuity\') or {}\n        view=r.get(\'viewport\') or {}; session=r.get(\'session\') or {}\n        presentation=r.get(\'presentation\') or {}; bitmap=r.get(\'bitmap\') or {}\n        key=(r.get(\'state\'),r.get(\'reason\'),session.get(\'signon\'),\n             view.get(\'reason\'),presentation.get(\'surface_hwnd\'),\n             continuity.get(\'expired_bitmap_clears\'),\n             bitmap.get(\'expected_primitives\',0)>0 and bitmap.get(\'nontransparent_pixels\')==0)\n        if key==self.display_key and now<self.display_next_at:return\n        def fields(value,names):\n            value=value if isinstance(value,dict) else {}\n            return {name:value[name] for name in names if name in value}\n        sampling=r.get(\'sampling_health\') or {}; phase=sampling.get(\'phase\') or {}\n        entity=r.get(\'entities\') or r.get(\'entity_stats\') or {}\n        event=dict(time=record[\'time\'],mono=now,owner_pid=self.owner,\n            renderer_pid=r.get(\'pid\',record.get(\'renderer_pid\')),game_pid=r.get(\'game_pid\'),\n            build=r.get(\'esp_build\'),state=r.get(\'state\'),reason=r.get(\'reason\',\'\'),\n            source=r.get(\'source\'),session=session,viewport=view,\n            presentation=presentation,bitmap=bitmap,window_entry=r.get(\'window_entry\'),\n            surface=fields(r.get(\'surface\'),(\'hwnd\',\'visible\',\'topmost\',\'owner\',\'above_game\',\'rect\')),\n            scene=fields(r.get(\'scene\'),(\'entities\',\'skeletons\',\'skeleton_segments\',\'hidden_dead\',\'hidden_inactive\',\'hidden_dormant\')),\n            continuity=fields(continuity,(\'expired_bitmap_clears\',\'retained_bitmaps\',\'last_action\',\'hide_events\',\'last_hide_reason\')),\n            sampling=fields(sampling,(\'sampler_pid\',\'process_alive\',\'sequence\',\'sample_age_ms\',\'last_reply_age_ms\',\'received_reply\')),\n            sample_phase=fields(phase,(\'stage\',\'stage_age_ms\',\'stage_ms\',\'last_error\',\'cycle_ms\',\'max_cycle_ms\',\'sources\')),\n            sources=entity.get(\'sources\'),recovery=r.get(\'recovery\'),\n            supervisor=fields(record,(\'state\',\'restart_reason\',\'restarts\',\'heartbeat_age_seconds\')),\n            evidence=\'window_buffer_and_sample_timeline_not_live_pixel_acceptance\',\n            live_pixels_verified=False)\n        journal=self.directory/(\'esp_recovery_\'+str(self.owner)+\'.jsonl\')\n        if journal.exists() and journal.stat().st_size>4*1024*1024:\n            journal.replace(journal.with_name(\'esp_recovery_\'+str(self.owner)+\'.previous.jsonl\'))\n        with journal.open(\'a\',encoding=\'utf-8\') as stream:\n            stream.write(json.dumps(event,ensure_ascii=False,allow_nan=False)+\'\\n\')\n        self.display_key=key;self.display_next_at=now+15.\n\n    def write(self, record, *, event=False):\n        now = time.monotonic()\n        if not event and now < self.next_at: return\n        self.next_at = now+1.\n        record = dict(record, time=time.strftime(\'%Y-%m-%d %H:%M:%S\'),\n                      owner_pid=self.owner, evidence=\'process_window_and_scene_counters_not_pixels\')\n        try:\n            self.directory.mkdir(parents=True, exist_ok=True)\n            raw = json.dumps(record, ensure_ascii=False, allow_nan=False)\n            temp = self.directory/(self.stem+\'.tmp\')\n            temp.write_text(raw, encoding=\'utf-8\')\n            temp.replace(self.directory/(self.stem+\'.json\'))\n            if event:\n                journal = self.directory/(self.stem+\'.jsonl\')\n                if journal.exists() and journal.stat().st_size > 1024*1024:\n                    journal.replace(self.directory/(self.stem+\'.previous.jsonl\'))\n                with journal.open(\'a\', encoding=\'utf-8\') as stream:\n                    stream.write(raw+\'\\n\')\n            self._display_event(record,now)\n            self.error = \'\'\n        except (OSError, ValueError, TypeError) as ex:\n            self.error = str(ex)[:512]\n')

_EMBEDDED['esp_watchdog_contract'] = (1, '"""No-game watchdog regression gate, including real child-process recovery."""\nimport io\nimport json\nimport tempfile\nimport threading\nimport time\nimport unittest\nfrom pathlib import Path\nfrom types import SimpleNamespace as NS\nfrom unittest.mock import Mock, patch\n\nfrom esp_watchdog import PresentationWatch, WatchdogJournal\n\n\ndef report(state=\'rendering\', sequence=1, **kw):\n    value=dict(state=state, pid=101, observed_at=0., game_pid=0,\n        session=dict(signon=6,map=\'fixture\'),\n        viewport=dict(rect=[0,0,1280,720],reason=\'ready\',game_window=11),\n        presentation=dict(scene_frames=sequence,surface_hwnd=22,submitted_frames=sequence),\n        surface=dict(hwnd=22,visible=True,submitted_frames=sequence),\n        scene=dict(entities=0,skeletons=0))\n    value.update(kw)\n    return value\n\n\ndef run():\n    import overlay_service as service_module\n    from esp_window_entry import WindowEntry,bitmap_evidence\n\n    class PolicyTests(unittest.TestCase):\n        def setUp(self): self.watch=PresentationWatch()\n        def test_alive_frozen_scene_restarts(self):\n            m=report();self.assertEqual(self.watch.evaluate(m,0.),\'\')\n            self.assertEqual(self.watch.evaluate(m,3.9),\'\')\n            self.assertEqual(self.watch.evaluate(m,4.),\'renderer_scene_stalled\')\n        def test_empty_scene_with_progress_is_healthy(self):\n            for i in range(100):\n                self.assertEqual(self.watch.evaluate(report(sequence=i+1),float(i)),\'\')\n        def test_heartbeating_recovery_has_deadline(self):\n            m=report(\'recovering\')\n            self.assertEqual(self.watch.evaluate(m,0.),\'\')\n            self.assertEqual(self.watch.evaluate(m,6.),\'renderer_recovering_without_scene\')\n        def test_alternating_errors_do_not_reset_deadline(self):\n            for i in range(6):\n                self.assertEqual(self.watch.evaluate(report(\'recovering\',reason=str(i)),float(i)),\'\')\n            self.assertTrue(self.watch.evaluate(report(\'sampling_hidden\'),6.))\n        def test_real_minimization_is_passive(self):\n            for t in (0.,10.,100.,1000.):\n                self.assertEqual(self.watch.evaluate(report(\'sampling_hidden\'),t,\n                    viewport=dict(rect=None,reason=\'minimized\')),\'\')\n        def test_false_hidden_report_compared_to_native_probe(self):\n            m=report(\'sampling_hidden\',viewport=dict(rect=None,reason=\'minimized\'))\n            probe=dict(rect=[0,0,1280,720],reason=\'ready\')\n            self.assertEqual(self.watch.evaluate(m,0.,viewport=probe),\'\')\n            self.assertEqual(self.watch.evaluate(m,6.,viewport=probe),\'viewport_disagrees_with_renderer\')\n        def test_real_hidden_overrides_stale_child_ready(self):\n            for t in (0.,20.,999.):\n                self.assertEqual(self.watch.evaluate(report(),t,viewport=dict(rect=None,reason=\'hidden\')),\'\')\n        def test_disable_never_restarts_for_missing_picture(self):\n            for t in (0.,100.):\n                self.assertEqual(self.watch.evaluate(report(\'recovering\'),t,enabled=False),\'\')\n        def test_menu_and_loading_wait_without_restart(self):\n            for signon in (None,0,1,2,3,4,5):\n                self.assertEqual(self.watch.evaluate(report(\'recovering\',session=dict(signon=signon)),100.),\'\')\n        def test_restore_gets_fresh_grace(self):\n            self.watch.evaluate(report(\'recovering\'),0.)\n            self.watch.evaluate(report(\'sampling_hidden\'),100.,viewport=dict(rect=None))\n            self.assertEqual(self.watch.evaluate(report(\'recovering\'),101.),\'\')\n            self.assertTrue(self.watch.evaluate(report(\'recovering\'),107.))\n        def test_recovery_clears_incident(self):\n            self.watch.evaluate(report(\'recovering\'),0.)\n            self.watch.evaluate(report(\'rendering\',sequence=2),5.)\n            self.assertEqual(self.watch.evaluate(report(\'rendering\',sequence=3),6.),\'\')\n            self.assertIsNone(self.watch.problem_since)\n        def test_hidden_renderer_window_is_not_healthy(self):\n            m=report(surface=dict(visible=False,hwnd=22))\n            self.watch.evaluate(m,0.)\n            self.assertEqual(self.watch.evaluate(m,4.),\'renderer_surface_unavailable\')\n        def test_independent_probe_detects_missing_owned_window(self):\n            probe=dict(rect=[0,0,1280,720],surface_probe=dict(valid=False))\n            self.watch.evaluate(report(),0.,viewport=probe)\n            self.assertEqual(self.watch.evaluate(report(sequence=2),4.,viewport=probe),\'renderer_surface_unavailable\')\n        def test_surface_recreation_counter_reset_is_progress(self):\n            self.watch.evaluate(report(sequence=100),0.)\n            m=report(sequence=1);m[\'presentation\'][\'surface_hwnd\']=23\n            self.assertEqual(self.watch.evaluate(m,3.5),\'\')\n            self.assertEqual(self.watch.evaluate(m,7.),\'\')\n        def test_missing_presentation_counter_has_deadline(self):\n            m=report(presentation={})\n            self.watch.evaluate(m,0.)\n            self.assertEqual(self.watch.evaluate(m,6.),\'renderer_missing_presentation\')\n        def test_nan_counter_is_not_progress(self):\n            self.watch.evaluate(report(sequence=float(\'nan\')),0.)\n            self.assertEqual(self.watch.evaluate(report(sequence=float(\'nan\')),6.),\'renderer_missing_presentation\')\n        def test_starting_forever_has_deadline(self):\n            self.watch.evaluate(report(\'starting\'),0.)\n            self.assertEqual(self.watch.evaluate(report(\'starting\'),30.),\'renderer_startup_stalled\')\n        def test_reset_does_not_carry_dead_counter_to_new_process(self):\n            self.watch.evaluate(report(),0.)\n            self.watch.reset(100.)\n            self.assertEqual(self.watch.evaluate(report(),100.),\'\')\n        def test_sampler_startup_is_not_killed_every_six_seconds(self):\n            m=report(\'recovering\',sequence=0,sampling_health=dict(\n                process_alive=True,received_reply=False))\n            self.watch.evaluate(m,0.)\n            self.assertEqual(self.watch.evaluate(m,6.),\'\')\n            self.assertEqual(self.watch.evaluate(m,29.),\'\')\n            self.assertEqual(self.watch.evaluate(m,30.),\'renderer_recovering_without_scene\')\n        def test_broken_session_probe_is_not_mistaken_for_loading(self):\n            m=report(\'recovering\',session=dict(signon=None,error=\'fixture read failure\'))\n            self.watch.evaluate(m,0.)\n            self.assertEqual(self.watch.evaluate(m,6.),\'renderer_session_probe_failed\')\n\n    class ServiceTests(unittest.TestCase):\n        def make(self):\n            # Keep real supervision logic, with only process creation substituted.\n            with patch.object(service_module.OverlayService,\'_spawn\'):\n                s=service_module.OverlayService(\'fixture\',monitor=False,journal=False,probe=lambda m:m.get(\'viewport\'))\n            s.proc=NS(pid=101,poll=lambda:None)\n            s.last_restart=time.monotonic()-60\n            s.last_heartbeat=time.monotonic()\n            s.received_metrics=True;s.metrics=report()\n            s._stop_process=Mock()\n            def spawn():\n                s.proc=NS(pid=102,poll=lambda:None);s.last_restart=time.monotonic()\n                s.watch.reset(s.last_restart);s.transport_failed=False\n                s.metrics=report(\'starting\',sequence=0)\n            s._spawn=Mock(side_effect=spawn)\n            return s\n        def test_submit_health_entry_has_no_blocking_restarts(self):\n            s=self.make();s.proc=NS(pid=101,poll=lambda:1)\n            self.assertTrue(s.health_tick());s._stop_process.assert_not_called()\n        def test_child_exit_restarts_owned_child(self):\n            s=self.make();old=s.proc;old.poll=lambda:1\n            s._supervise_once();s._stop_process.assert_called_once_with(old)\n            self.assertEqual(s.restarts,1)\n        def test_transport_failure_restarts(self):\n            s=self.make();s.transport_failed=True;s._supervise_once()\n            self.assertEqual(s.last_incident[\'reason\'],\'renderer_transport_failed\')\n        def test_silence_restarts(self):\n            s=self.make();s.last_heartbeat-=10.;s._supervise_once()\n            self.assertEqual(s.last_incident[\'reason\'],\'renderer_silent\')\n        def test_bounded_startup_grace(self):\n            s=self.make();s.metrics=report(\'starting\')\n            s.last_restart=time.monotonic();s.last_heartbeat-=10.;s._supervise_once()\n            s._spawn.assert_not_called()\n            s.last_restart-=31.;s.last_heartbeat=time.monotonic();s._supervise_once()\n            self.assertEqual(s.last_incident[\'reason\'],\'renderer_startup_stalled\')\n        def test_closed_service_does_not_resurrect(self):\n            s=self.make();s.closed=True;s.proc.poll=lambda:1\n            s._supervise_once();s._spawn.assert_not_called()\n        def test_lifecycle_lock_avoids_double_restart(self):\n            s=self.make();s.proc.poll=lambda:1\n            with s.lifecycle_lock:self.assertFalse(s._supervise_once())\n            s._spawn.assert_not_called()\n        def test_retry_backoff_has_no_attempt_exhaustion(self):\n            s=self.make()\n            for i in range(100):\n                s.proc=NS(pid=100+i,poll=lambda:1);s.next_restart=0.\n                s._supervise_once()\n                self.assertLessEqual(s.supervision[\'retry_in_seconds\'],8.)\n            self.assertEqual(s.restarts,100)\n        def test_retry_delay_is_respected(self):\n            s=self.make();s.proc.poll=lambda:1;s.next_restart=time.monotonic()+100\n            s._supervise_once();s._spawn.assert_not_called()\n        def test_spawn_failure_retried_next_time(self):\n            s=self.make();s.proc.poll=lambda:1\n            s._spawn.side_effect=OSError(\'fixture create failure\')\n            self.assertFalse(s._supervise_once());self.assertEqual(s.supervision[\'state\'],\'restart_failed\')\n            s.next_restart=0.;s._supervise_once();self.assertEqual(s._spawn.call_count,2)\n        def test_probe_error_does_not_stop_supervision(self):\n            s=self.make();s.probe=Mock(side_effect=OSError(\'fixture probe\'))\n            s._supervise_once();self.assertIn(\'fixture probe\',s.supervision[\'probe_error\'])\n        def test_diagnostics_failure_does_not_disable_loop(self):\n            s=self.make()\n            calls=[]\n            s._supervise_once=lambda:calls.append(1) or (_ for _ in ()).throw(OSError(\'fixture\'))\n            class Stop:\n                def wait(self,_):return len(calls)>=2\n            s.supervisor_stop=Stop();s._supervise()\n            self.assertEqual(len(calls),2)\n\n    class EvidenceTests(unittest.TestCase):\n        def test_journal_is_independent_and_bounded(self):\n            with tempfile.TemporaryDirectory() as root:\n                j=WatchdogJournal(root,123)\n                old=Path(root)/\'esp_watchdog_123.jsonl\';old.write_text(\'x\'*(1024*1024+1))\n                j.write(dict(state=\'restart\',viewport=dict(game_window=11)),event=True)\n                self.assertEqual(j.error,\'\')\n                self.assertTrue(old.with_name(\'esp_watchdog_123.previous.jsonl\').exists())\n                r=json.loads((Path(root)/\'esp_watchdog_123.json\').read_text(\'utf-8\'))\n                self.assertEqual(r[\'owner_pid\'],123);self.assertEqual(r[\'viewport\'][\'game_window\'],11)\n        def test_runtime_retains_supervision_and_native_window_evidence(self):\n            from runtime_compat import RuntimeObservation\n            observer=RuntimeObservation()\n            r=report(observed_at=time.monotonic(),supervisor=dict(state=\'progressing\',restarts=2))\n            out=observer.observe(None,None,NS(esp=True),None,None,r)[\'esp\']\n            self.assertEqual(out[\'viewport\'][\'game_window\'],11)\n            self.assertEqual(out[\'presentation\'][\'scene_frames\'],1)\n            self.assertEqual(out[\'supervisor\'][\'restarts\'],2)\n            self.assertFalse(out[\'live_pixels_verified\'])\n\n    class ProcessTests(unittest.TestCase):\n        def test_autonomous_real_child_restart_and_config_replay(self):\n            # No calls to submit/health_tick occur while awaiting recovery.\n            # These are ordinary owned Python processes, not game processes.\n            child=r\'\'\'\nimport json,os,pathlib,sys,threading,time\nroot=pathlib.Path(__file__).parent\ncounter=root/\'generation.txt\'\ngeneration=int(counter.read_text())+1 if counter.exists() else 1\ncounter.write_text(str(generation))\nstop=threading.Event()\ndef read():\n    for line in sys.stdin:\n        cfg=json.loads(line)\n        if cfg.get(\'close\'):stop.set();return\n        if cfg.get(\'cfg\'): (root/(\'config_\'+str(generation)+\'.json\')).write_text(json.dumps(cfg))\n    stop.set()\nthreading.Thread(target=read,daemon=True).start()\nn=0\nwhile not stop.wait(.05):\n    n+=1\n    seq=1 if generation==1 else n\n    print(json.dumps(dict(metrics=dict(state=\'rendering\',pid=os.getpid(),game_pid=0,\n        observed_at=time.monotonic(),session=dict(signon=6),\n        viewport=dict(rect=[0,0,1280,720],reason=\'ready\'),\n        presentation=dict(scene_frames=seq,submitted_frames=seq,surface_hwnd=1),\n        surface=dict(visible=True)))),flush=True)\n\'\'\'\n            with tempfile.TemporaryDirectory(prefix=\'esp_watchdog_contract_\') as tmp:\n                root=Path(tmp);entry=root/\'fixture_child.py\';entry.write_text(child,encoding=\'utf-8\')\n                journal=WatchdogJournal(root,123)\n                with patch.object(service_module,\'BUNDLE_ENTRY\',entry):\n                    s=service_module.OverlayService(root,probe=lambda m:m.get(\'viewport\'),journal=journal)\n                    original=s.proc\n                    try:\n                        s.submit(NS(esp=True,fixture_setting=73),0,{})\n                        deadline=time.monotonic()+12.\n                        while time.monotonic()<deadline:\n                            if (s.restarts and (root/\'config_2.json\').exists() and\n                                s.supervision.get(\'state\')==\'progressing\'):break\n                            time.sleep(.05)\n                        self.assertEqual(s.restarts,1)\n                        self.assertNotEqual(original.pid,s.proc.pid)\n                        self.assertIsNotNone(original.poll())\n                        self.assertEqual(s.last_incident[\'reason\'],\'renderer_scene_stalled\')\n                        replay=json.loads((root/\'config_2.json\').read_text())\n                        self.assertEqual(replay[\'cfg\'][\'fixture_setting\'],73)\n                        self.assertTrue(s.supervisor_thread.is_alive())\n                        self.assertTrue((root/\'esp_watchdog_123.jsonl\').exists())\n                        replacement=s.proc\n                    finally:s.close()\n                    self.assertFalse(s.supervisor_thread.is_alive())\n                    self.assertIsNotNone(replacement.poll())\n\n    class EntryTests(unittest.TestCase):\n        def setUp(self):\n            self.entry=WindowEntry();self.cfg=NS(esp=True,esp_antialias=True)\n            self.view=dict(rect=(0,0,1280,720),game_window=11,foreground=True)\n            self.old=NS(hwnd=100,close=Mock())\n            self.created=[]\n            def create():\n                s=NS(hwnd=101+len(self.created),resize=Mock(),set_antialias=Mock(),\n                    bind_game_window=Mock(),close=Mock())\n                self.created.append(s);return s\n            self.factory=Mock(side_effect=create)\n        def step(self,now=0.):\n            self.old=self.entry.prepare(self.view,self.cfg,self.old,self.factory,now)\n            return self.old\n        def test_first_game_view_binds_new_surface_immediately(self):\n            old=self.old;new=self.step()\n            self.assertIsNot(old,new);old.close.assert_not_called()\n            new.bind_game_window.assert_called_once_with(11,foreground=True)\n            self.assertIsNone(self.entry.first_scene_at)\n            self.entry.presented(.01);self.assertEqual(self.entry.first_scene_at,.01)\n            old.close.assert_called_once()\n        def test_no_rebuild_every_frame(self):\n            for n in range(100):self.step(n*.01)\n            self.factory.assert_called_once()\n        def test_each_restore_rebuilds_once(self):\n            self.step();self.view=dict(self.view,rect=None);self.step(1.)\n            self.view=dict(self.view,rect=(0,0,1280,720));self.step(1.1)\n            self.assertEqual(self.factory.call_count,2)\n            self.assertEqual(self.entry.epoch,2)\n        def test_visible_foreground_return_rebinds(self):\n            self.step();self.view[\'foreground\']=False;self.step(1.)\n            self.view[\'foreground\']=True;self.step(2.)\n            self.assertEqual(self.factory.call_count,2)\n            self.assertEqual(self.entry.reason,\'game_focus_returned\')\n        def test_new_hwnd_rebinds(self):\n            self.step();self.view[\'game_window\']=12;self.step(1.)\n            self.assertEqual(self.factory.call_count,2)\n        def test_resolution_change_rebinds(self):\n            self.step();self.view[\'rect\']=(0,0,1920,1200);self.step(1.)\n            self.assertEqual(self.factory.call_count,2)\n        def test_disabled_does_not_create_surface(self):\n            self.cfg.esp=False;self.step();self.factory.assert_not_called()\n            self.cfg.esp=True;self.step(1.);self.factory.assert_called_once()\n        def test_failed_rebuild_keeps_old_surface_and_retries(self):\n            old=self.old;self.factory.side_effect=OSError(\'fixture allocation\')\n            self.assertIs(self.step(),old);old.close.assert_not_called()\n            self.step(.5);self.assertEqual(self.factory.call_count,1)\n            self.step(1.);self.assertEqual(self.factory.call_count,2)\n            self.assertTrue(self.entry.pending)\n        def test_partial_new_surface_is_cleaned_on_bind_failure(self):\n            new=NS(hwnd=101,resize=Mock(side_effect=OSError(\'fixture resize\')),close=Mock())\n            self.factory.side_effect=lambda:new\n            old=self.old;self.step();new.close.assert_called_once();old.close.assert_not_called()\n        def test_old_frame_never_acknowledges_new_entry(self):\n            self.step();self.entry.presented(.1)\n            self.view[\'foreground\']=False;self.step(1.)\n            self.view[\'foreground\']=True;self.step(2.)\n            self.assertIsNone(self.entry.first_scene_at);self.assertEqual(self.entry.frames,0)\n        def test_alpha_bitmap_detects_content_not_api_counter(self):\n            o=NS(width=2,height=1,per_pixel_alpha=True,image_bytes=lambda:b\'\\0\\0\\0\\0\'+b\'\\0\\0\\xff\\xff\')\n            self.assertEqual(bitmap_evidence(o,dict(position_markers=2))[\'nontransparent_pixels\'],1)\n        def test_color_key_bitmap_ignores_alpha(self):\n            o=NS(width=3,height=1,per_pixel_alpha=False,\n                image_bytes=lambda:b\'\\1\\1\\1\\0\'+b\'\\1\\1\\1\\xff\'+b\'\\0\\0\\xff\\0\')\n            self.assertEqual(bitmap_evidence(o,dict(position_markers=2))[\'nontransparent_pixels\'],1)\n        def test_empty_bitmap_with_draw_counters_is_a_fault(self):\n            w=PresentationWatch();m=report(bitmap=dict(nontransparent_pixels=0,expected_primitives=3))\n            w.evaluate(m,0.)\n            self.assertEqual(w.evaluate(m,2.),\'renderer_bitmap_empty\')\n        def test_legitimate_empty_scene_does_not_trigger_bitmap_fault(self):\n            w=PresentationWatch()\n            for n in range(8):\n                self.assertEqual(w.evaluate(report(sequence=n+1,\n                    bitmap=dict(nontransparent_pixels=0,expected_primitives=0)),float(n)),\'\')\n        def test_native_surface_rebuild_has_drawable_pixels(self):\n            from native_aa_overlay import SmoothOverlay\n            old=SmoothOverlay(visible=False,submit_hidden=True)\n            gate=WindowEntry()\n            view=dict(rect=(0,0,128,96),game_window=None,foreground=True)\n            new=gate.prepare(view,self.cfg,old,lambda:SmoothOverlay(visible=False,submit_hidden=True),0.)\n            try:\n                self.assertIsNot(old,new)\n                new.delete(\'all\');new.create_line(10,10,90,80,fill=\'#55e28c\',width=2);new.finish()\n                gate.presented()\n                self.assertGreater(bitmap_evidence(new,dict(skeletons=1))[\'nontransparent_pixels\'],0)\n            finally:gate.close();new.close();old.close()\n\n    class StartupTransitionTests(unittest.TestCase):\n        def test_first_frame_after_long_session_does_not_restart_renderer(self):\n            s=ServiceTests().make()\n            s.metrics=report(\'starting\',sequence=31,stage=\'first_frame_presented\',submitted_frames=1)\n            s._supervise_once()\n            s._spawn.assert_not_called()\n            self.assertEqual(s.supervision[\'renderer_state\'],\'rendering\')\n\n        def test_real_incident_zero_old_counter_does_not_trigger_startup_timer(self):\n            s=ServiceTests().make()\n            s.metrics=report(\'starting\',sequence=0,stage=\'first_frame_presented\',submitted_frames=1)\n            s._supervise_once()\n            s._spawn.assert_not_called()\n            self.assertNotEqual(s.last_incident.get(\'reason\'),\'renderer_startup_stalled\')\n\n        def test_first_frame_event_still_has_stall_deadline(self):\n            w=PresentationWatch()\n            m=report(\'starting\',sequence=1,stage=\'first_frame_presented\',submitted_frames=1)\n            self.assertEqual(w.evaluate(m,0.),\'\')\n            self.assertEqual(w.evaluate(m,4.),\'renderer_scene_stalled\')\n\n        def test_zero_counter_after_first_frame_is_not_immortal(self):\n            w=PresentationWatch()\n      