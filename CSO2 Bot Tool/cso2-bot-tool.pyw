ection source identity mismatch\')\n    changes={item[\'id\']:item for item in correction[\'instances\']}\n    if len(changes)!=len(correction[\'instances\']):raise ValueError(\'static bbox correction duplicate identity\')\n    result=[];applied=set()\n    for row in rows:\n        item=changes.get(row[0])\n        if item is None:\n            result.append(row);continue\n        if (row[0] in applied or len(row)!=3 or row[1]!=item[\'model\']\n                or row[2]!=item[\'old_bounds\']):\n            raise ValueError(\'static bbox correction instance mismatch\')\n        bounds=item[\'bounds\']\n        if (len(bounds)!=2 or any(len(v)!=3 for v in bounds)\n                or not all(math.isfinite(v) for side in bounds for v in side)\n                or any(bounds[0][i]>=bounds[1][i] for i in range(3))):\n            raise ValueError(\'static bbox correction bounds invalid\')\n        result.append([row[0],row[1],[list(side) for side in bounds]]);applied.add(row[0])\n    if applied!=set(changes):raise ValueError(\'static bbox correction missing instance\')\n    return result,applied\n\n\ndef unpack_hulls(raw):\n    if len(raw)<4:raise ValueError(\'hull header\')\n    count=struct.unpack_from(\'<I\',raw)[0];offset=4;hulls=[]\n    if count>100000:raise ValueError(\'hull count\')\n    for _ in range(count):\n        row=struct.unpack_from(\'<6dI\',raw,offset);offset+=52\n        n=row[-1]\n        if n>1000000 or offset+n*32>len(raw):raise ValueError(\'plane count\')\n        planes=[list(struct.unpack_from(\'<4d\',raw,offset+i*32)) for i in range(n)]\n        offset+=n*32;hulls.append([[[*row[:3]],[*row[3:6]]],planes])\n    if offset!=len(raw):raise ValueError(\'hull trailing bytes\')\n    return hulls\n\n\ndef hull_intervals(proxy,start,delta):\n    """All closed-hull crossings, so multiple pieces share one shot budget."""\n    q=tuple(a-b for a,b in zip(start,proxy.origin))\n    local=tuple(sum(a*b for a,b in zip(q,axis)) for axis in proxy.axes)\n    direction=tuple(sum(a*b for a,b in zip(delta,axis)) for axis in proxy.axes)\n    result=[]\n    for bounds,planes in proxy.hulls:\n        expanded=(tuple(x-.05 for x in bounds[0]),tuple(x+.05 for x in bounds[1]))\n        if not box_ray(expanded,local,direction):continue\n        lower,upper=0.,1.\n        for nx,ny,nz,distance in planes:\n            a=nx*local[0]+ny*local[1]+nz*local[2]-distance\n            rate=nx*direction[0]+ny*direction[1]+nz*direction[2]\n            if abs(rate)<1e-10:\n                if a>0:break\n            elif rate<0:lower=max(lower,-a/rate)\n            else:upper=min(upper,-a/rate)\n            if lower>upper:break\n        else:\n            if upper>0 and lower<1 and lower<=upper:result.append((max(0.,lower),min(1.,upper)))\n    return result\n\ndef load_static_geometry(map_name):\n    import json\n    from static_guard_data import GUARD_META,GUARD_DATA,MODEL_DATA\n    key=Path(str(map_name).replace(\'\\\\\',\'/\')).stem.lower()\n    meta=GUARD_META[key];data=zlib.decompress(base64.b85decode(GUARD_DATA[key]))\n    if len(data)!=meta[\'bytes\'] or hashlib.sha256(data).hexdigest()!=meta[\'sha256\']:\n        raise ValueError(\'static geometry external checksum mismatch\')\n    payload=json.loads(data);rows=payload[\'instances\']\n    if len(rows)!=meta[\'instances\']:raise ValueError(\'static geometry instance count\')\n    models={}\n    for name,identity in payload[\'models\'].items():\n        decoded=zlib.decompress(base64.b85decode(MODEL_DATA[identity]))\n        if hashlib.sha256(decoded).hexdigest()!=identity:\n            raise ValueError(\'shared static model checksum mismatch\')\n        models[name]=unpack_hulls(decoded)\n    rows,bbox_instances=apply_bbox_corrections(rows,meta,key)\n    return rows,dict(meta,map=key,bbox_corrections=len(bbox_instances)),models,payload[\'models\'],bbox_instances\n\n\ndef static_shape_proxies(rows,models=None,bbox_instances=None):\n    from types import SimpleNamespace\n    proxies=[]\n    for row in rows:\n        identity,model,bounds=row[:3]\n        if (len(bounds)!=2 or any(len(x)!=3 for x in bounds)\n                or not all(math.isfinite(x) for side in bounds for x in side)\n                or any(bounds[0][i]>bounds[1][i] for i in range(3))):\n            raise ValueError(\'static geometry bounds invalid\')\n        hulls=(models or {}).get(model) if len(row)>3 else None;axes=None;origin=None\n        if hulls:\n            origin=row[3];pitch,yaw,roll=map(math.radians,row[4])\n            sp,cp=math.sin(pitch),math.cos(pitch);sy,cy=math.sin(yaw),math.cos(yaw);sr,cr=math.sin(roll),math.cos(roll)\n            axes=((cp*cy,cp*sy,-sp),(sr*sp*cy-cr*sy,sr*sp*sy+cr*cy,sr*cp),(cr*sp*cy+sr*sy,cr*sp*sy-sr*cy,cr*cp))\n        proxies.append(SimpleNamespace(bounds=bounds,identity=identity,model=model,hulls=hulls,axes=axes,origin=origin,\n            bounds_source=\'engine_static_bbox\' if identity in (bbox_instances or ()) else \'unresolved_shape_bounds\'))\n    return proxies\n\n\nclass StaticGeometry:\n    """Pure collision shapes for ESP LOS; no material or weapon decisions."""\n    def __init__(self,rows,metadata,models=None,bbox_instances=None):\n        self.metadata=metadata\n        proxies=static_shape_proxies(rows,models,bbox_instances)\n        self.tree=BVH(proxies) if proxies else None\n\n    @classmethod\n    def for_map(cls,map_name):\n        rows,meta,models,identities,bbox=load_static_geometry(map_name)\n        return cls(rows,meta,models,bbox)\n')





