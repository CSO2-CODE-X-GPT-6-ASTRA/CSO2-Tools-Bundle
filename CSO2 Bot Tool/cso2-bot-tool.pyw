start[i])/delta[i]\n            lo,hi=max(lo,min(x,y)),min(hi,max(x,y))\n            if lo>hi: return None\n    return lo,hi\n\ndef box_ray(bounds, start, delta):\n    # BVH traversal needs only intersection, so avoid allocating intervals.\n    # Preserve the parallel-ray threshold and closed slab boundary behavior.\n    lo=0.0;hi=1.0\n    lower,upper=bounds\n    for i in range(3):\n        value=delta[i];position=start[i]\n        if abs(value)<1e-12:\n            if position<lower[i] or position>upper[i]:return False\n        else:\n            near=(lower[i]-position)/value\n            far=(upper[i]-position)/value\n            if near>far:near,far=far,near\n            if near>lo:lo=near\n            if far<hi:hi=far\n            if lo>hi:return False\n    return True\n\n\nclass BVH:\n    def __init__(self,brushes):\n        self.bounds=(tuple(min(b.bounds[0][i] for b in brushes) for i in range(3)),\n                     tuple(max(b.bounds[1][i] for b in brushes) for i in range(3)))\n        self.items=None;self.children=None\n        if len(brushes)<=12: self.items=brushes\n        else:\n            axis=max(range(3),key=lambda i:self.bounds[1][i]-self.bounds[0][i])\n            brushes.sort(key=lambda b:b.bounds[0][axis]+b.bounds[1][axis])\n            mid=len(brushes)//2\n            self.children=(BVH(brushes[:mid]),BVH(brushes[mid:]))\n    def candidates(self,start,delta):\n        if not box_ray(self.bounds,start,delta):return\n        if self.items is not None:\n            for b in self.items:\n                if box_ray(b.bounds,start,delta):yield b\n        else:\n            for child in self.children:yield from child.candidates(start,delta)\n\nclass BSP:\n    """World brushes only. Dynamic entities, props and displacements are not traced."""\n    def __init__(self,path,*,use_training=True):\n        self.path=Path(path);raw=self.path.read_bytes()\n        if len(raw)<1036 or raw[:4]!=b\'VBSP\':raise ValueError(\'不是 Source BSP 地图\')\n        self.ve