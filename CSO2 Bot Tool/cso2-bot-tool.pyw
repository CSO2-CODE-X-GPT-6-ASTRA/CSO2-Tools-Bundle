_EMBEDDED['aim_tracking_private'] = ('2026.10.07-aim-private-reader-evidence', '\n\n"""Time-based head tracking; follows observed motion without extrapolating hitscan targets."""\n\nimport math\n\nfrom geometry import aim_angles, angle_error, length, sub, wrap\nfrom runtime_diagnostics import weapon_identity\n\n\ndef _speed(value):\n    try:\n        values=tuple(float(v) for v in value)\n    except (TypeError,ValueError):return 0.\n    return length(values) if len(values)==3 and all(math.isfinite(v) for v in values) else 0.\n\n\ndef _pose_stamp(frame,target):\n    value=getattr(target,\'pose_sample_stamp\',0.)\n    if (isinstance(value,(int,float)) and not isinstance(value,bool) and\n            math.isfinite(value) and value>0. and abs(value-frame.stamp)<=.12):\n        return value,\'entity_pose\'\n    return frame.stamp,\'frame\'\n\n\ndef _motion_response(frame,target,previous,key,stamp,smoothing):\n    """Use observed motion only; never predict a target outside its hitbox."""\n    requested=max(1.,float(smoothing))\n    local_speed=_speed(getattr(frame.local,\'velocity\',None))\n    target_speed=_speed(getattr(target,\'velocity\',None))\n    reasons=[]\n    if local_speed>=20.:reasons.append(\'local_velocity\')\n    if target_speed>=20.:reasons.append(\'target_velocity\')\n    dt=stamp-previous[\'stamp\'] if previous else 0.\n    pose_shift=eye_shift=0.\n    if previous and previous[\'key\']==key and 0.<dt<=.05:\n        pose_shift=length(sub(target.head,previous[\'head\']))\n        eye_shift=length(sub(frame.eye,previous[\'eye\']))\n        # This covers crouches and stair/jump animation even when reported\n        # origin velocity is zero. Identity/part changes never inherit motion.\n        if .1<=pose_shift<64.:reasons.append(\'observed_pose_change\')\n        if .1<=eye_shift<64.:reasons.append(\'observed_eye_change\')\n    return dict(forced=bool(reasons),reasons=reasons,local_speed=local_speed,\n        target_speed=target_speed,pose_shift=pose_shift,eye_shift=eye_shift,\n        observed_span_ms=dt*1000,requested_smoothing=requested,\n        applied_smoothing=1. if reasons else requested,extrapolated=False)\n\n\ndef _limit_view_step(base, requested, max_pitch=28., max_yaw=55.):\n    """Bound one control tick so target churn cannot spin the camera."""\n    pitch_delta=max(-max_pitch,min(max_pitch,requested[0]-base[0]))\n    yaw_delta=max(-max_yaw,min(max_yaw,wrap(requested[1]-base[1])))\n    return (max(-89.,min(89.,base[0]+pitch_delta)),wrap(base[1]+yaw_delta)),(pitch_delta,yaw_delta)\n\n\n\n\n\ndef aim_tolerance(eye,target):\n\n    radius=target.head_radius*.8 if getattr(target,\'head_radius\',None) else 2.5\n    if not (getattr(target,\'head_source\',\'\')==\'anatomical_generic\' and\n            getattr(target,\'aim_part\',\'head\') in (\'torso\',\'pelvis\',\'body\')):\n        radius=min(2.5,radius)\n\n    return min(4.,math.degrees(math.atan2(radius,max(1.,length(sub(target.head,eye))))))\n\n\n\n\n\nclass AimTracker:\n\n    def __init__(self):\n\n        self.reset()\n\n\n\n    def reset(self):\n\n        self.previous = None\n\n\n\n    def update(self, frame, target, smoothing, recoil_scale):\n\n        raw = aim_angles(frame.eye, target.head)\n\n        desired = (max(-89., min(89., raw[0] - frame.punch[0]*2*recoil_scale)),\n\n                   wrap(raw[1] - frame.punch[1]*2*recoil_scale), 0.)\n\n        key = (frame.map_name, frame.local.address, frame.local.serial, target.index, target.address,target.serial,\n\n               target.model, target.head_bone, frame.weapon, recoil_scale,weapon_identity(frame),target.aim_id)\n\n        prev = self.previous\n\n        stamp,stamp_basis = _pose_stamp(frame,target)\n        dt = stamp-prev[\'stamp\'] if prev else .008\n        motion_response=_motion_response(frame,target,prev,key,stamp,smoothing)\n\n        continuous = bool(prev and key == prev[\'key\'] and 0 < dt <= .05\n\n                          and length(sub(target.head, prev[\'head\'])) < 64\n\n                          and length(sub(frame.eye, prev[\'eye\'])) < 64\n\n                          and angle_error(raw, prev[\'raw\']) < min(12., 720*dt))\n\n        base = frame.angles\n\n        movement = (0., 0.)\n\n        readback = False\n\n        local_speed = target_speed = None\n\n        if continuous:\n\n            # Apply measured head/eye motion immediately. Only the remaining\n\n            # acquisition error is smoothed; constant movement has no tail.\n\n            movement = tuple(wrap(raw[i]-prev[\'raw\'][i]) for i in range(2))\n\n            recoil_delta = tuple((frame.punch[i]-prev[\'punch\'][i])*2*recoil_scale for i in range(2))\n\n            readback = angle_error(frame.angles, prev[\'out\']) <= .03\n\n            if readback:\n\n                base = (frame.angles[0]+movement[0]-recoil_delta[0],\n\n                        wrap(frame.angles[1]+movement[1]-recoil_delta[1]), 0.)\n\n            local_speed = length(sub(frame.eye, prev[\'eye\']))/dt\n\n            target_speed = length(sub(target.head, prev[\'head\']))/dt\n\n        smoothing = motion_response[\'applied_smoothing\']\n\n        # Preserve the old 8 ms response at its nominal rate, independent of\n\n        # scheduler jitter. After pauses/reacquisition use one nominal step.\n\n        alpha = 1. if smoothing <= 1 else 1-(1-1/smoothing)**((dt if continuous else .008)/.008)\n\n        requested_out = (max(-89., min(89., base[0]+wrap(desired[0]-base[0])*alpha)),\n\n                         wrap(base[1]+wrap(desired[1]-base[1])*alpha), 0.)\n        bounded,step = _limit_view_step(frame.angles,requested_out)\n        out = (bounded[0],bounded[1],0.)\n\n        def shot_error(view):\n\n            shot=(view[0]+frame.punch[0]*2*recoil_scale,\n\n                  wrap(view[1]+frame.punch[1]*2*recoil_scale),0.)\n\n            return angle_error(shot,raw)\n\n        before = shot_error(frame.angles)\n\n        tracked = shot_error(base)\n\n        output_error = shot_error(out)\n\n        tolerance = aim_tolerance(frame.eye,target)\n\n        # Starting on a moving head also requires the previous write to have\n\n        # been read back while it was within tolerance. This is memory-level\n\n        # confirmation, not proof that the engine consumed a firing command.\n\n        start_ready = before < tolerance or bool(continuous and readback\n\n                         and prev[\'error\'] < prev[\'tolerance\'] and tracked < tolerance)\n\n        self.previous = dict(key=key, stamp=stamp, frame_stamp=frame.stamp, raw=raw, head=target.head,\n\n                             eye=frame.eye, punch=frame.punch, out=out,\n\n                             error=output_error, tolerance=tolerance)\n\n        return dict(out=out, desired=desired, raw=raw, observed_error_deg=before,\n\n                    tracked_error_deg=tracked, output_error_deg=output_error,\n\n                    tolerance_deg=tolerance, start_ready=start_ready,\n\n                    motion_compensated=continuous, previous_write_readback=readback,\n\n                    angular_motion_deg=movement, dt_ms=dt*1000,\n\n                    local_motion_speed=local_speed, target_motion_speed=target_speed,\n\n                    elevation_deg=-raw[0],height_delta=target.head[2]-frame.eye[2],\n\n                    horizontal_distance=math.hypot(target.head[0]-frame.eye[0],target.head[1]-frame.eye[1]),\n\n                    pitch_limited=abs(raw[0]-frame.punch[0]*2*recoil_scale-desired[0])>1e-6,\n\n                    error_basis=\'world_ray_with_recoil\',requested_out=requested_out,\n                    motion_response=motion_response,tracking_stamp_basis=stamp_basis,\n                    camera_step_deg=step,camera_guarded=out!=requested_out,\n                    camera_guard_reason=\'单帧视角变化超限\' if out!=requested_out else \'\')\n')
_EMBEDDED['aim_weapon_cadence'] = ('2026.10.07-aim-private-reader-evidence', '"""Per-weapon burst pacing. Script parameters are not live engine spread.\n\nCPU-only; never changes native fire mode, RNG, ammo or target selection.\nLegacy-model pauses are explicitly estimates, not verified recovery times.\n"""\nimport collections\nimport math\nfrom runtime_diagnostics import weapon_identity\nfrom weapon_profiles import is_firearm,weapon_cycle\n\n\ndef script_spread_hint(profile, flags=1, velocity=(0.,0.,0.)):\n    """A labelled script envelope, not engine RNG or an accuracy guarantee."""\n    profile=profile or {}\n    def value(key,default=0.):\n        v=profile.get(key,default)\n        return float(v) if type(v) in (int,float) and math.isfinite(v) and 0<=v<=10 else default\n    grounded=isinstance(flags,int) and bool(flags&1)\n    crouch=grounded and bool(flags&2)\n    speed=math.hypot(*velocity[:2]) if velocity and len(velocity)>=2 else 0.\n    if \'InaccuracyStand\' in profile:\n        key=\'InaccuracyJump\' if not grounded else \'InaccuracyMove\' if speed>80 else \'InaccuracyCrouch\' if crouch else \'InaccuracyStand\'\n        return max(.001,value(\'Spread\')+value(key,value(\'InaccuracyStand\')))\n    if profile.get(\'SpreadFunction\'):\n        key=\'JumpSpread\' if not grounded else \'RunSpread\' if speed>80 else \'DuckingSpread\' if crouch else \'DefaultSpread\'\n        return max(.001,value(key,value(\'DefaultSpread\',.01))*value(\'BaseAccuracy\',1.)+value(key+\'Offset\'))\n    return None\n\n\ndef recovery_weight(family_weight, fit, pressure, moving, airborne, distant, tiny, direct, aligned):\n    """Bounded, monotone HP/target-fit tradeoff; coefficients are policy, not physics."""\n    weight=family_weight+(1.-fit)*.45-pressure*fit*.25+(.15 if moving else 0.)\n    weight=max(0.,min(1.,weight))\n    if distant:weight=max(.85,weight)\n    if tiny:weight=max(.90,weight)\n    if not direct:weight=max(.90,weight)\n    if airborne or not aligned:weight=1.\n    return weight\n\n\ndef cadence_policy(profile, distance, flags=1, direct=False, radius=3., velocity=(0.,0.,0.),\n                   *,target_health=None,alignment_error=None):\n    profile = profile or {}\n    def number(name, default=0., maximum=10.):\n        value = profile.get(name, default)\n        return float(value) if type(value) in (int,float) and math.isfinite(value) and 0 <= value <= maximum else default\n    cycle = weapon_cycle(profile)\n    kind = profile.get(\'WeaponType\', \'unknown\')\n    automatic = bool(profile.get(\'FullAuto\', 0))\n    valid_distance = type(distance) in (int,float) and math.isfinite(distance) and distance >= 0\n    near = bool(direct and valid_distance and distance <= 192.)\n    grounded = isinstance(flags,int) and bool(flags & 1)\n    crouched = grounded and bool(flags & 2)\n    recovery = number(\'RecoveryTimeCrouch\' if crouched else \'RecoveryTimeStand\')\n    if recovery <= 0: recovery = max(number(\'RecoveryTimeStand\'),number(\'RecoveryTimeCrouch\'))\n    model = str(profile.get(\'SpreadFunction\') or (\'spread_fields\' if \'InaccuracyFire\' in profile else \'unknown\'))\n    source = \'script_recovery_parameter\' if recovery > 0 else \'not_available\'\n    # Do not invent a live spread value or apply a pistol formula to a rifle.\n    has_accuracy = recovery > 0 or model != \'unknown\'\n    if recovery <= 0 and model != \'unknown\':\n        recovery = max(.20, cycle * 2.)\n        source = \'legacy_burst_pause_estimate\'\n    speed = math.hypot(*velocity[:2]) if velocity and len(velocity) >= 2 else 0.\n    small = valid_distance and radius / max(1.,distance) < .006\n    precision = not valid_distance or distance > 768. or not grounded or speed > 80. or small\n    burst = 1 if precision or kind in (\'pistol\',\'sniperrifle\',\'sniper\',\'shotgun\') else 3\n    result = dict(weapon_type=kind,model=model,automatic=automatic,cycle=cycle,recovery=recovery,\n        interval=cycle if near or not has_accuracy else max(cycle,recovery),burst_limit=burst,\n        controlled=bool(is_firearm(profile) and has_accuracy and not near and recovery > cycle),\n        policy=\'near_survival_cycle\' if near else \'precision_burst\' if precision else \'bounded_burst\',\n        recovery_source=source,engine_spread_verified=False,profile_hash=profile.get(\'profile_hash\'),\n        stance=\'air\' if not grounded else \'crouch\' if crouched else \'stand\',moving=speed>80.,\n        target_angular_radius=math.atan2(max(0.,radius),max(1.,distance)) if valid_distance else None)\n    if not has_accuracy: result[\'policy\']=\'native_cycle_missing_accuracy\'\n    if not is_firearm(profile): result.update(controlled=False,policy=\'non_firearm\')\n    hp_valid=type(target_health) in (int,float) and math.isfinite(target_health) and target_health>0\n    error_valid=type(alignment_error) in (int,float) and math.isfinite(alignment_error) and alignment_error>=0\n    spread=script_spread_hint(profile,flags,velocity)\n    result.update(target_health=target_health if hp_valid else None,spread_hint=spread,\n                  health_basis=\'observed_entity_hp\',cadence_model=\'hp_fit_bounded_v2\',recovery_weight=1.)\n    # Missing HP/alignment preserves the historical precision policy. HP alone\n    # never grants fire permission; Controller has already verified the pose/ray.\n    if not (hp_valid and error_valid and valid_distance and spread and has_accuracy and is_firearm(profile)):\n        return result\n    angle=result[\'target_angular_radius\']\n    error=math.radians(alignment_error)\n    fit=max(0.,min(1.,(angle-error)/spread))\n    damage=profile.get(\'Damage\')\n    damage=float(damage) if type(damage) in (int,float) and math.isfinite(damage) and damage>0 else None\n    # Deliberately excludes armor, mode multipliers and head damage. This is an\n    # output-pressure index, not a predicted kill count or hit probability.\n    pressure=max(0.,min(1.,math.log2(max(1.,target_health/damage)/4.)/4.)) if damage 