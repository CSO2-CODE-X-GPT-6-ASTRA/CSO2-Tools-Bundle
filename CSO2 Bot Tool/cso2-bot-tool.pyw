eader.mem;self.scope=scope\n            try:\n                self.writer(reader.mem,reader.client+PATCH_RVA,b\'\\xc6\',b\'\\xc0\')\n            finally:\n                self.owned=reader.mem.read(reader.client+CONTEXT_RVA,len(CONTEXT))==PATCHED\n            if not self.owned:raise RuntimeError(\'雷达 UI：修改尚未生效\')\n            self.next_check=0.\n        if now>=self.next_check:\n            self.next_check=now+.25\n            if probe(reader)!=PATCHED:raise RuntimeError(\'雷达 UI：阵营过滤已变化，等待重新校验\')\n            team_view=self.team_view.step(reader,frame)\n            carrier=None;carrier_error=\'\'\n            try:\n                resource=reader.mem.u32(reader.client+0xecd9f4)\n                if resource:\n                    value=reader.mem.i32(resource+0x1660)\n                    carrier=value if 0<=value<=64 else None\n                    if carrier is None:carrier_error=\'carrier_index_out_of_range\'\n            except Exception as ex:carrier_error=str(ex)\n            self.metrics=dict(active=team_view[\'active\'],ui_team_rule=\'local_player_ui_opposite_team\',\n                real_team_written=False,server_team_written=False,esp_data_written=False,\n                patch_rva=PATCH_RVA,patch_bytes=\'c6 -> c0\',signature_verified=True,\n                source=\'native_client_radar\',coverage=\'received_native_player_and_radar_data\',\n                c4_carrier_index=carrier,c4_error=carrier_error,\n                map=frame.map_name,observed_at=now,live_render_verified=False,\n                team_view=team_view,ui_counts=team_view[\'ui_counts\'],\n                real_local_team=team_view[\'real_team\'],ui_local_team=team_view[\'ui_local_team\'])\n        counts=self.metrics.get(\'ui_counts\',{})\n        self.status=f"雷达：UI CT={counts.get(\'CT\',\'?\')} · T={counts.get(\'T\',\'?\')}"\n        return self.status\n    def close(self):\n        team_error=None\n        try:self.team_view.close()\n        except Exception as ex:team_error=ex\n        if self.reader is not None and self.owned:\n            mem=self.mem\n            if mem is not None and mem.alive():\n                base=self.scope[1]\n                raw=mem.read(base+CONTEXT_RVA,len(CONTEXT))\n                if raw==PATCHED:\n                    self.writer(mem,base+PATCH_RVA,b\'\\xc0\',b\'\\xc6\')\n                    if mem.read(base+CONTEXT_RVA,len(CONTEXT))!=CONTEXT:\n                        raise RuntimeError(\'雷达 UI：恢复回读未通过\')\n                elif raw!=CONTEXT:\n                    raise RuntimeError(\'雷达 UI：检测到其他代码修改，保留现场等待恢复\')\n        if team_error is not None:raise team_error\n        self.reader=None;self.mem=None;self.scope=None;self.owned=False;self.next_check=0.\n        self.status=\'雷达：关闭\';self.metrics=dict(active=False,real_team_written=False)\n\n\nclass RadarHint:\n    """Small on-hover text; never takes keyboard focus from the settings UI."""\n    def __init__(self,widget,translate=lambda s:s,text=HINT):\n        self.widget=widget;self.translate=translate;self.text=text;self.popup=None;self.timer=None\n        widget.bind(\'<Enter>\',self.schedule,add=\'+\')\n        widget.bind(\'<Leave>\',self.hide,add=\'+\')\n        widget.bind(\'<ButtonPress>\',self.hide,add=\'+\')\n        widget.bind(\'<Destroy>\',self.hide,add=\'+\')\n    def schedule(self,event=None):\n        self.hide();self.timer=self.widget.after(350,self.show)\n    def show(self):\n        import tkinter as tk\n        self.timer=None\n        if not self.widget.winfo_exists() or self.popup is not None:return\n        tip=tk.Toplevel(self.widget);self.popup=tip;tip.withdraw();tip.overrideredirect(True)\n        tip.attributes(\'-topmost\',True)\n        tk.Label(tip,text=self.translate(self.text),font=(\'Microsoft YaHei UI\',9),\n                 bg=\'#102944\',fg=\'#b8cde5\',wraplength=360,justify=\'left\',padx=8,pady=6).pack()\n        tip.update_idletasks()\n        x=max(0,min(self.widget.winfo_rootx(),tip.winfo_screenwidth()-tip.winfo_reqwidth()))\n        y=self.widget.winfo_rooty()+self.widget.winfo_height()+5\n        if y+tip.winfo_reqheight()>tip.winfo_screenheight():y=self.widget.winfo_rooty()-tip.winfo_reqheight()-5\n        tip.geometry(f\'+{x}+{max(0,y)}\');tip.deiconify()\n    def hide(self,event=None):\n        if self.timer is not None:\n            self.widget.after_cancel(self.timer);self.timer=None\n        if self.popup is not None:\n            popup=self.popup;self.popup=None;popup.destroy()\n')

_EMBEDDED['native_radar_contract'] = (1, '"""Native comparison execution plus reversible UI-only memory fixtures."""\nimport ctypes as C,io,unittest\nfrom types import SimpleNamespace as NS\n\n\ndef native_compare(instruction,left,right):\n    # Execute only the two comparison bytes in a local Windows x64 function.\n    # Preserve RSI, marshal EAX/ESI from the ABI and return ZF, no game access.\n    code=bytes.fromhex(\'568bf28bc1\')+instruction+bytes.fromhex(\'0f94c00fb6c05ec3\')\n    k=C.WinDLL(\'kernel32\',use_last_error=True)\n    k.VirtualAlloc.argtypes=[C.c_void_p,C.c_size_t,C.c_uint,C.c_uint];k.VirtualAlloc.restype=C.c_void_p\n    k.VirtualProtect.argtypes=[C.c_void_p,C.c_size_t,C.c_uint,C.POINTER(C.c_uint)];k.VirtualProtect.restype=C.c_int\n    k.VirtualFree.argtypes=[C.c_void_p,C.c_size_t,C.c_uint];k.VirtualFree.restype=C.c_int\n    k.FlushInstructionCache.argtypes=[C.c_void_p,C.c_void_p,C.c_size_t];k.FlushInstructionCache.restype=C.c_int\n    address=k.VirtualAlloc(None,len(code),0x3000,4)\n    if not address:raise C.WinError(C.get_last_error())\n    try:\n        C.memmove(address,code,len(code));old=C.c_uint()\n        if not k.VirtualProtect(address,len(code),0x20,C.byref(old)):raise C.WinError(C.get_last_error())\n        if not k.FlushInstructionCache(C.c_void_p(-1),address,len(code)):raise C.WinError(C.get_last_error())\n        return C.CFUNCTYPE(C.c_int,C.c_int,C.c_int)(address)(left,right)\n    finally:k.VirtualFree(address,0,0x8000)\n\n\ndef run():\n    import native_radar as radar\n    from radar_team_contract import RadarMemory as Memory,make_reader,make_frame,run as run_team_view\n    class Tests(unittest.TestCase):\n        def setUp(self):\n            self.mem=Memory();self.now=10.;self.checks=0\n            self.reader=make_reader(self.mem)\n            self.frame=make_frame()\n            def write(mem,addr,old,new):\n                self.assertEqual(mem.read(addr,len(old)),old)\n                self.assertEqual(addr,0x10000000+radar.PATCH_RVA)\n                off=radar.PATCH_OFFSET;mem.code=mem.code[:off]+new+mem.code[off+1:]\n                mem.writes.append((addr,old.hex(),new.hex()))\n            def verify(r):self.checks+=1\n            self.feature=radar.NativeRadar(clock=lambda:self.now,writer=write,image_check=verify)\n        def test_enable_changes_only_native_ui_comparison_byte(self):\n            self.feature.step(self.reader,self.frame,True)\n            self.assertEqual(self.mem.code,radar.PATCHED);self.assertEqual(len(self.mem.writes),1)\n            self.assertEqual(self.frame.local.team,3);self.assertFalse(self.feature.metrics[\'real_team_written\'])\n        def test_native_instruction_admits_both_camps_and_keeps_self(self):\n            for team in (2,3):\n                for other in (2,3):\n                    self.assertEqual(native_compare(bytes.fromhex(\'3bc6\'),team,other),int(team==other))\n                    self.assertEqual(native_compare(bytes.fromhex(\'3bc0\'),team,other),1)\n        def test_disable_restores_original(self):\n            self.feature.step(self.reader,self.frame,True);self.feature.step(self.reader,self.frame,False)\n            self.assertEqual(self.mem.code,radar.CONTEXT);self.assertEqual(len(self.mem.writes),2)\n        def test_panic_close_restores_original(self):\n            self.feature.step(self.reader,self.frame,True);self.feature.close();self.feature.close()\n            self.assertEqual(self.mem.code,radar.CONTEXT);self.assertEqual(len(self.mem.writes),2)\n        def test_c4_carrier_is_native_resource_not_invented(self):\n            self.feature.step(self.reader,self.frame,True);self.assertEqual(self.feature.metrics[\'c4_carrier_index\'],4)\n            self.now+=1;self.mem.carrier=0;self.feature.step(self.reader,self.frame,True)\n            self.assertEqual(self.feature.metrics[\'c4_carrier_index\'],0)\n        def test_invalid_carrier_is_not_accepted(self):\n            self.mem.carrier=65535;self.feature.step(self.reader,self.frame,True)\n            self.assertIsNone(self.feature.metrics[\'c4_carrier_index\'])\n        def test_live_enable_is_idempotent(self):\n            for _ in range(20):self.now+=.1;self.feature.step(self.reader,self.frame,True)\n            self.assertEqual(len(self.mem.writes),1);self.assertEqual(self.checks,1)\n        def test_signature_mismatch_writes_nothing(self):\n            self.mem.code=b\'\\x90\'*len(radar.CONTEXT)\n            with self.assertRaises(RuntimeError):self.feature.step(self.reader,self.frame,True)\n            self.assertEqual(self.mem.writes,[])\n        def test_identical_preexisting_patch_is_used_without_ownership(self):\n            self.mem.code=radar.PATCHED\n            self.feature.step(self.reader,self.frame,True)\n            self.assertTrue(self.feature.metrics[\'active\'])\n            self.assertEqual(self.feature.metrics[\'patch_ownership\'],\'preexisting\')\n            self.assertFalse(self.feature.owned)\n            self.feature.close();self.assertEqual(self.mem.code,radar.PATCHED);self.assertEqual(self.mem.writes,[])\n        def test_preexisting_patch_and_ui_slot_are_reused_without_rollback(self):\n            self.mem.code=radar.PATCHED\n            self.mem.set_team(1,2);self.mem.sync_crc()\n            self.feature.step(self.reader,self.frame,True)\n            self.assertEqual(self.feature.metrics[\'team_view\'][\'ui_slot_ownership\'],\'preexisting\')\n            self.feature.close()\n            self.assertEqual(self.mem.code,radar.PATCHED)\n            self.assertEqual(self.mem.i32(0x20000000+0xa38+4),2)\n            self.assertEqual(self.mem.ui_writes,[])\n        def test_unpatched_code_does_not_adopt_preexisting_ui_slot(self):\n            self.mem.set_team(1,2);self.mem.sync_crc()\n            with self.assertRaises(RuntimeError):self.feature.step(self.reader,self.frame,True)\n            self.assertEqual(self.mem.ui_writes,[])\n        def test_preexisting_patch_external_change_is_detected(self):\n            self.mem