'engine_bullet_id_verified\'])\n   self.assertEqual(log.ammo_request_context(frame,1)[\'status\'],\'no_matching_request\')\n  def test_request_association_preserves_ambiguity_identity_and_expiry(self):\n   import collections\n   from runtime_diagnostics import weapon_identity\n   frame,_=weapon_frame(stamp=10.1);key=weapon_identity(frame)\n   def request(n,t,key=key):return dict(request_id=n,mono=t,context={\'weapon_identity\':key})\n   for requests,count,status in (([request(1,10.01),request(2,10.02)],1,\'ambiguous_requests\'),\n       ([request(1,10.01)],2,\'ambiguous_requests\'),([request(1,9.)],1,\'no_matching_request\'),\n       ([request(1,10.01,(\'other_weapon\',))],1,\'no_matching_request\'),\n       ([request(1,float(\'nan\'))],1,\'no_matching_request\')):\n    log=BattleLog.__new__(BattleLog);log.accepted_fire_requests=collections.deque(requests,maxlen=32)\n    q=log.ammo_request_context(frame,count);self.assertEqual(q[\'status\'],status)\n    self.assertNotIn(\'context\',q);self.assertFalse(q[\'engine_bullet_id_verified\'])\n  def test_accepted_request_is_persisted_without_rewriting_prior_metrics(self):\n   with tempfile.TemporaryDirectory() as tmp:\n    a=AccuracyLedger(tmp)\n    try:\n     row=shot();row[\'accepted_fire_request\']={\'status\':\'unique_request\',\'request_id\':3,\n           \'engine_bullet_id_verified\':False,\'context\':{\'target\':8,\'firing_aim_point\':[1,2,3]}}\n     a.record(\'m\',row)\n     data=json.loads(a.db.execute("SELECT data FROM events WHERE kind=\'ammo_decreased\'").fetchone()[0])\n     self.assertEqual(data[\'accepted_fire_request\'][\'context\'][\'target\'],8)\n     self.assertEqual(data[\'context\'][\'target\'],7)\n     self.assertEqual(a.snapshot()[\'weapons\'][\'usp\'][\'rounds\'],1)\n     self.assertIsNone(a.snapshot()[\'weapons\'][\'usp\'][\'bullet_hit_rate\'])\n    finally:a.close()\n  def test_resume_and_duplicate_evidence_do_not_double_count(self):\n   with tempfile.TemporaryDirectory() as tmp:\n    a=AccuracyLe