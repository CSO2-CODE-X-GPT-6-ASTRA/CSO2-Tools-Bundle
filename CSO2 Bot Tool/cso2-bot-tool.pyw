or_lock();self.i18n.capture(root);self.i18n.refresh()\n        self.summon_control.check_binding()\n        root._ui_combos=[row[0] for row in self.i18n.combos];root._ui_action=self.record_ui_action;install_pointer_interactions(root)\n        def remember_geometry(event):\n            if event.widget is root and root.state()==\'normal\':self.normal_geometry=root.geometry()\n        root.bind(\'<Configure>\',remember_geometry,add=\'+\')\n        root.bind(\'<Unmap>\',self.summon_unmapped,add=\'+\')\n        root.protocol(\'WM_DELETE_WINDOW\',self.close)\n        if start_worker:\n            self.worker.cfg=self.config();self.worker.start();self.cursor_lock.start();self.summon_control.start();root.after(16,self.tick)\n    def refresh_client_notice(self):\n        state=self.resource_support_view.update(self.client_resource_report)\n        visible=state[\'visible\'];changed=visible!=self.resource_view_visible\n        self.resource_view_visible=visible\n        if visible:self.esp_legend_text.pack_forget()\n        self.client_notice.set_lines(support_lines(self.client_resource_report,self.i18n.lang) if visible else ())\n        text=support_countdown(state,self.i18n.lang);self.resource_countdown_text.set(text)\n        if text:\n            if not self.resource_countdown.winfo_manager():self.resource_countdown.pack(anchor=\'w\',fill=\'x\',pady=(4,0))\n        else:self.resource_countdown.pack_forget()\n        if changed:\n            if not visible:self.esp_legend_text.pack(anchor=\'w\',fill=\'x\')\n            self.refresh_radar_notice()\n            frame=self.worker.frame\n            self.wall_notice.set_lines(notice_lines(self.worker.wall_capability,frame.map_name)\n                if not visible and frame and not self.preview.get() else ())\n    def toggle_resource_support(self,*_):\n        self.resource_support_view.set_manual(self.show_resource_support.get())\n        self.refresh_client_notice()\n    def refresh_radar_notice(self,*_):\n        lines=radar_notice_lines(self.worker.radar_delay_state) if self.vars[\'radar\'].get() else ()\n        self.radar_notice_text.set(\'\\n\'.join(lines))\n        if lines and not getattr(self,\'resource_view_visible\',False):\n            notice=getattr(self,\'client_notice\',None)\n            if notice is None or not notice.winfo_manager():notice=getattr(self,\'wall_notice\',None)\n            options=dict(before=notice) if notice is not None and notice.winfo_manager() else {}\n            self.radar_notice.pack(anchor=\'w\',fill=\'x\',pady=(6,0),**options)\n        else:\n            self.radar_notice.pack_forget()\n        self.layout_radar_notice()\n    def layout_radar_notice(self,event=None):\n        width=max(1,self.esp_legend.winfo_width()-2)\n        if int(float(self.radar_notice.cget(\'wraplength\')))!=width:\n            self.radar_notice.configure(wraplength=width)\n        if self._radar_layout_job is None:\n            self._radar_layout_job=self.root.after_idle(self.fit_radar_notice)\n    def fit_radar_notice(self):\n        self._radar_layout_job=None\n        width,height=self._base_min_size\n        if self.radar_notice.winfo_manager() and self.canvas.winfo_height()>1 and self.esp_legend.winfo_width()>1:\n            # Keep the added line on screen after language/DPI/width changes.\n            required=self.root.winfo_height()-self.canvas.winfo_height()+self.esp_legend.winfo_reqheight()+20\n            height=max(height,min(self.root.winfo_screenheight()-80,required))\n        if self.root.minsize()!=(width,height):self.root.minsize(width,height)\n    def cursor_target_pid(self):\n        reader=self.worker.reader;mem=getattr(reader,\'mem\',None)\n        return mem.pid if mem else None\n    def build_connection_actions(self,parent):\n        row=ttk.Frame(parent);row.pack(fill=\'x\',pady=(4,0))\n        self.lobby_button=ttk.Button(row,text=\'立即断开地图连接\',command=lambda:self.request_action(\'return_lobby\'))\n        self.lobby_button.pack(side=\'left\');self.lobby_button.state([\'disabled\'])\n        self.feature_widgets[\'return_lobby\']=self.lobby_button\n        self.cycle_text=self.i18n.var(\'循环连接\')\n        self.cycle_button=ttk.Button(row,textvariable=self.cycle_text,command=lambda:self.request_action(\'connection_cycle\'))\n        self.cycle_button.pack(side=\'left\',padx=(6,0));self.cycle_button.state([\'disabled\'])\n        self.feature_widgets[\'connection_cycle\']=self.cycle_button\n        self.cycle_target=self.i18n.var(\'循环目标：未记录\')\n        ttk.Label(parent,textvariable=self.cycle_target,wraplength=310,justify=\'left\').pack(fill=\'x\',pady=(6,0))\n    def cursor_game_state(self,pid):\n        reader=self.worker.reader;mem=getattr(reader,\'mem\',None)\n        if not mem or mem.pid!=pid or not self.worker.enabled or self.worker.return_lobby.pending or self.worker.connection_cycle.active:return \'waiting\'\n        try:\n            if mem.i32(reader.global_addr(\'signon\'))!=6:return \'waiting\'\n            if reader.game_ui_visible():return \'menu\'\n            # CSO2\'s buy and character-selection Scaleform panels can be\n            # visible without toggling the generic GameUI flag. In those\n            # native panels Windows shows the game cursor; mouse-look hides it.\n            if self.win.cursor_visible():return \'menu\'\n            if not raw_mouse_input_enabled(reader):\n                now=time.monotonic()\n                if now>=getattr(self,\'cursor_input_retry\',0.):\n                    self.cursor_input_retry=now+3.;self.worker.commands.put((\'cursor_raw_input\',reader))\n                return \'input\'\n            return \'playing\'\n        except Exception:\n            # A transition or unavailable menu state must leave the pointer free.\n            return \'waiting\'\n    def refresh_cursor_lock(self):\n        enabled=self.cursor_lock.enabled\n        self.cursor_lock_text.set(\'鼠标锁定中心：开\' if enabled else \'鼠标锁定中心：关\')\n        self.cursor_lock_button.state([\'pressed\'] if enabled else [\'!pressed\'])\n        self.cursor_lock_status.set(self.cursor_lock.status)\n    def toggle_cursor_lock(self):\n        self.cursor_lock.set_enabled(not self.cursor_lock.enabled)\n        self.refresh_cursor_lock();self.save(silent=True)\n        self.feedback.set(\'鼠标锁定已开启：进入地图自动生效，ESC 菜单自动释放\' if self.cursor_lock.enabled else \'鼠标锁定已关闭\')\n    def set_topmost(self,enabled):\n        enabled=bool(enabled);self.floating_window.set_topmost(enabled);self.always_on_top=enabled\n        self.summon_control.topmost.set(enabled)\n    def choose_topmost(self,enabled):\n        self.set_topmost(enabled);self.save(silent=True)\n        self.feedback.set(\'已开启窗口置顶\' if self.always_on_top else \'已关闭窗口置顶\')\n    def summon_window(self,force_show=False):\n        self.summon_control.close_menu()\n        if not force_show and getattr(self,\'summon_visible\',False) and self.root.winfo_ismapped() and self.root.state()!=\'iconic\':\n            self.set_topmost(False);self.root.iconify();self.summon_visible=False\n            self.cursor_lock.suspend(False);self.worker.ui_pause.clear()\n        else:\n            self.cursor_lock.suspend(True);self.worker.ui_pause.set()\n            try:self.floating_window.show()\n            except Exception:\n                self.cursor_lock.suspend(False);self.worker.ui_pause.clear();raise\n            self.always_on_top=True;self.summon_visible=True\n            self.summon_control.topmost.set(True)\n        self.refresh_cursor_lock()\n        self.save(silent=True)\n    def sync_summon_pause(self):\n        """Reconcile Win32 visibility and explicit mouse return with the UI latch."""\n        if not self.worker.ui_pause.is_set():return\n        visible=bool(getattr(self,\'summon_visible\',False) and self.floating_window.visible())\n        reader=self.worker.reader\n        # A non-activating panel leaves game focus unchanged. Only a mouse\n        # press landing on the actual game window means return to play;\n        # clicking this panel, its popup or another program keeps it paused.\n        returning=bool(visible and reader and reader.mem and\n            (self.win.down(1) or self.win.down(2)) and\n            self.floating_window.pointer_on_game(self.win,reader.mem.pid))\n        if visible and not returning:return\n        self.summon_visible=False\n        if returning:\n            self.summon_control.close_menu();self.set_topmost(False);self.root.iconify()\n        self.cursor_lock.suspend(False);self.worker.ui_pause.clear()\n        self.refresh_cursor_lock()\n    def summon_unmapped(self,event):\n        if event.widget is self.root and getattr(self,\'summon_visible\',False):\n            self.summon_visible=False;self.cursor_lock.suspend(False);self.worker.ui_pause.clear()\n            self.refresh_cursor_lock()\n    def record_ui_action(self,event):\n        # A bounded trace distinguishes missing clicks from command/backend failures.\n        widget=event.widget\n        try:\n            path=HERE/\'ui_actions.jsonl\'\n            if path.exists() and path.stat().st_size>524288:path.replace(HERE/\'ui_actions.previous.jsonl\')\n            label=widget.cget(\'text\') if isinstance(widget,(ttk.Button,ttk.Checkbutton)) else widget.winfo_class()\n            record=dict(time=time.strftime(\'%Y-%m-%d %H:%M:%S\'),build=BUILD,widget=str(widget),label=str(label),event=\'mouse_release\',\n                        disabled=widget.instate([\'disabled\']) if isinstance(widget,(ttk.Button,ttk.Checkbutton)) else None,\n                        feedback=self.feedback.get(),lobby_busy=self.lobby_busy)\n            with path.open(\'a\',encoding=\'utf-8\') as fp:fp.write(json.dumps(record,ensure_ascii=False)+\'\\n\')\n        except (OSError,tk.TclError):pass\n    def build_health_controls(self,parent):\n        policy_row=ttk.Frame(parent);policy_row.pack(fill=\'x\',pady=(0,8))\n        self.vars[\'round_away_policy\']=tk.StringVar(value=Config().round_away_policy)\n        self.round_policy_button=ttk.Button(policy_row,text=POLICY_LABEL,command=self.show_round_policy_menu)\n        self.round_policy_button.pack(side=\'left\')\n        self.round_policy_menu=RoundPolicyMenu(self.root,self.round_policy_button,self.i18n,\n            self.vars[\'round_away_policy\'],self.set_round_policy)\n        self.round_policy_status=self.i18n.var(WAIT_PROMPT)\n        ttk.Label(policy_row,textvariable=self.round_policy_status,foreground=ACCENT,wraplength=180,justify=\'left\').pack(side=\'left\',fill=\'x\',expand=True,padx=(8,0))\n        self.vars[\'round_away_policy\'].trace_add(\'write\',lambda *_:self.refresh_round_policy())\n        self.i18n.refreshers.append(self.refresh_round_policy)\n        health_row=ttk.Frame(parent);health_row.pack(fill=\'x\')\n        self.check(health_row,\'lock_hp\',\'锁定固定血量\',False).pack_configure(side=\'left\',fill=\'none\')\n        self.vars[\'lock_hp_away\']=tk.BooleanVar(value=Config().lock_hp_away)\n        self.vars[\'lock_hp_away\'].trace_add(\'write\',lambda *_:self.setting_feedback(\'lock_hp_away\',HEALTH_AWAY_LABEL))\n        self.health_away_menu=AwayHealthMenu(health_row,self.vars[\'lock_hp_away\'],self.i18n)\n        self.health_away_menu.pack(side=\'left\',padx=(5,0))\n        self.check(parent,\'lock_hp_once\',\'每局锁定一次血量\',False)\n        for key,other in ((\'lock_hp\',\'lock_hp_once\'),(\'lock_hp_once\',\'lock_hp\')):\n            self.vars[key].trace_add(\'write\',lambda *_,k=key,o=other:self.vars[o].set(False) if self.vars[k].get() and self.vars[o].get() else None)\n    def refresh_round_policy(self):\n        policy=self.vars.get(\'round_away_policy\')\n        if policy is None:return\n        value=policy.get()\n        if value not in POLICIES:\n            value=WAIT_PROMPT;policy.set(value)\n        self.round_policy_status.set(value)\n    def show_round_policy_menu(self):\n        self.round_policy_menu.toggle()\n    def set_round_policy(self,policy):\n        if policy not in POLICIES:return\n        self.vars[\'round_away_policy\'].set(policy);self.save(silent=True)\n        self.feedback.set(POLICY_LABEL+\'：\'+policy)\n    def round_away_reply(self,request,choice):\n        result=self.round_away.decide(request,choice)\n        self.round_away_result(dict(result,choice=choice))\n    def round_away_result(self,result):\n        kind=result.get(\'kind\');choice=result.get(\'choice\')\n        if choice==ALWAYS and kind==\'submitted\':\n            self.vars[\'round_away_policy\'].set(AUTO_RESET);self.save(silent=True)\n        if kind==\'submitted\':self.feedback.set(\'已提交无限时间与对局刷新，正在回读确认\')\n        elif kind==\'skipped\':self.feedback.set(\'本次未处理；下次鼠标离开且倒计时继续时仍会提醒\')\n        elif kind==\'stale\':self.feedback.set(\'游戏状态已变化，本次未提交命令\')\n        elif kind==\'apply_unconfirmed\':self.feedback.set(\'无限时间命令未获回读确认\')\n    def check(self,parent,key,label,value):\n        v=tk.BooleanVar(value=getattr(Config(),key,value));self.vars[key]=v\n        widget=ttk.Checkbutton(parent,text=label,variable=v);widget.pack(anchor=\'w\',fill=\'x\')\n        if key in FEATURE_KEYS:self.feature_widgets[key]=widget\n        v.trace_add(\'write\',lambda *_:self.setting_feedback(key,label))\n        return widget\n    def setting_feedback(self,key,label):\n        if key==\'allies\':return  # Automatic indicator; mode policy owns this value.\n        if not self.vars[key].get():state=\'未勾选\'\n        elif key in CONFIG_KEYS and not self.capabilities.get(key,{}).get(\'available\',False):\n            state=\'已勾选，等待条件满足后自动生效\'+\'\\n\'+(self.capabilities.get(key,{}).get(\'reason\') or \'等待连接或进入对局\')\n        else:state=\'已勾选，满足触发条件时执行\'\n        self.feedback.set(label+\'\\n\'+state)\n    def apply_capabilities(self,capabilities):\n        # Capability probes control execution, not the user\'s saved intent.\n        self.capabilities=capabilities\n        for key,widget in self.feature_widgets.items():\n            enabled=key in CONFIG_KEYS or capabilities.get(key,{}).get(\'available\',False)\n            if key==\'allies\':enabled=False\n            if key in (\'host_magic_bullet\',\'client_magic_bullet\'):enabled=True\n            if key==\'return_lobby\':\n                reader=self.worker.reader\n                enabled=bool(reader and reader.mem and not self.lobby_busy and not self.cycle_active)\n            elif key==\'connection_cycle\':\n                reader=self.worker.reader\n                enabled=self.cycle_active or bool(reader and reader.mem and not self.lobby_busy)\n            if widget.instate([\'disabled\'])==bool(enabled):\n                widget.state([\'!disabled\'] if enabled else [\'disabled\'])\n    def health_display(self):\n        cfg=self.config()\n        if (self.vars[\'lock_hp\'].get() or self.vars[\'lock_hp_once\'].get()) and not (cfg.lock_hp or cfg.lock_hp_once):\n            return \'HP 数值无效，锁血暂停\'\n        key=\'lock_hp\' if cfg.lock_hp else \'lock_hp_once\' if cfg.lock_hp_once else None\n        if key and not self.capabilities.get(key,{}).get(\'available\',False):\n            return \'HP 锁定：已勾选，等待生效\'\n        return self.worker.health_status if key else \'HP 锁定：关闭\'\n    def sync_away_health(self):\n        enabled=self.config().lock_hp_away\n        session=None;away=None;reason=\'option_disabled\' if not enabled else \'waiting_session\'\n        if enabled:\n            try:session,away,reason=observe_health_away(self.worker,self.win,self.health_cursor,time.monotonic())\n            except Exception as ex:reason=\'observation_error: \'+str(ex)\n        changed=self.health_away.update(self.vars,enabled,session,away,reason)\n        self.worker.health_away_state=dict(self.health_away.state)\n        if changed:record_health_away(HERE/\'health_away_events.jsonl\',self.health_away.state,BUILD)\n    def sync_away_round(self):\n        policy=self.vars[\'round_away_policy\'].get()\n        if policy not in POLICIES:\n            policy=WAIT_PROMPT;self.vars[\'round_away_policy\'].set(policy)\n        event=self.round_away.tick(self.worker,self.win,self.health_cursor,policy,time.monotonic())\n        request=self.round_away.request\n        if self.round_away_dialog.request is not None and self.round_away_dialog.request!=request:\n            self.round_away_dialog.close()\n        # The child publishes a persistent request; a missed UI event cannot\n        # permanently lose a reminder while the main window is hidden.\n        if request is not None:\n            self.round_away_dialog.show(request)\n        state=dict(self.round_away.state)\n        signature=tuple(sorted((key,repr(value)) for key,value in state.items()\n            if key not in (\'cycle\',\'cycle_ms\')))\n        if signature!=getattr(self,\'round_away_signature\',None):\n            self.round_away_signature=signature;record_round_away(HERE/\'round_away_events.jsonl\',state,BUILD)\n        if event and event.get(\'kind\')==\'applied\':\n            self.feedback.set(\'已确认无限时间并刷新对局\')\n        elif event:\n            self.round_away_result(event)\n    def slider(self,parent,key,label,start,end,value):\n        v=tk.DoubleVar(value=value);self.vars[key]=v\n        labelvar=self.i18n.var()\n        def update(*_):labelvar.set(f\'{label}：{v.get():.1f}\')\n        v.trace_add(\'write\',update);update()\n        row=ttk.Frame(parent);row.pack(fill=\'x\',pady=(8,0))\n        ttk.Label(row,textvariable=labelvar).pack(side=\'left\')\n        ttk.Button(row,text=\'默认\',width=5,command=lambda:v.set(value)).pack(side=\'right\')\n        BlueSlider(parent,v,start,end).pack(fill=\'x\')\n    def combo(self,parent,key,label,values,default):\n        ttk.Label(parent,text=label).pack(anchor=\'w\',pady=(8,4));v=tk.StringVar(value=default);self.vars[key]=v;self.i18n.combo(parent,v,values).pack(fill=\'x\')\n    def config(self):\n        vals={k:v.get() for k,v in self.vars.items()};vals[\'enemy_team\']=0 if vals[\'enemy_team\']==\'自动\' else int(vals[\'enemy_team\'].split(\' · \')[0])\n        vals[\'radar_delay_seconds\']=self.radar_delay_input.value()\n        vals[\'allies\']=bool(getattr(self.worker,\'ally_policy\',{}).get(\'enabled\',False))\n        vals[\'anti_aim_period\']=int(vals[\'anti_aim_period\'])\n        if vals.get(\'round_away_policy\') not in POLICIES:vals[\'round_away_policy\']=WAIT_PROMPT\n        raw=str(vals.get(\'locked_hp\',\'\')).strip()\n        if raw.isdecimal() and len(raw)<=8 and 1<=int(raw)<=99999999:vals[\'locked_hp\']=int(raw)\n        else:vals[\'lock_hp\']=False;vals[\'lock_hp_once\']=False;vals[\'lock_hp_away\']=False;vals[\'locked_hp\']=99999\n        # The worker derives a temporary effective_config once the game is ready.\n        vals[\'language\']=self.i18n.lang\n        return Config(**vals)\n    def save(self,silent=False):\n        self.radar_delay_input.commit()\n        d=asdict(self.config());d[\'game\']=self.game.get();d[\'ui_schema\']=14\n        # Save user intent even while runtime validation pauses a feature.\n        d.update({k:bool(v.get()) for k,v in self.vars.items() if isinstance(v,tk.BooleanVar) and k!=\'allies\'})\n        d.update(self.health_away.saved_settings())\n        raw=str(self.vars[\'locked_hp\'].get()).strip()\n        if not (raw.isdecimal() and len(raw)<=8 and 1<=int(raw)<=99999999):d[\'locked_hp\']=self.vars[\'locked_hp\'].get()\n        d[\'preview\']=bool(self.preview.get());d[\'selected_tab\']=self.tabs.current\n        d[\'language\']=self.i18n.lang;d[\'always_on_top\']=self.always_on_top\n        d[\'summon_key\']=self.summon_control.key_text.get();d[\'summon_key_schema\']=2\n        d[\'cursor_center_lock\']=self.cursor_lock.enabled\n        d[\'skin_selection\']=self.skin_selection\n        d[\'window_geometry\']=self.normal_geometry or self.root.geometry()\n        d[\'window_state\']=\'zoomed\' if self.root.state()==\'zoomed\' else \'normal\'\n        temp=HERE/\'settings.tmp\';temp.write_text(json.dumps(d,ensure_ascii=False,indent=2),encoding=\'utf-8\');temp.replace(HERE/\'settings.json\')\n        if not silent:self.feedback.set(\'设置已保存；瞄准和开火仅在游戏前台按住右键时生效\')\n    def reset_defaults(self):\n        if self._defaults_undo is not None:\n            snapshot=self._defaults_undo\n            for key,value in snapshot[\'values\'].items():self.vars[key].set(value)\n            self.radar_delay_input.last=snapshot[\'radar_delay_last\']\n            self.set_topmost(snapshot[\'always_on_top\'])\n            self.summon_control.set_key(snapshot[\'summon_key\'])\n            self.cursor_lock.set_enabled(snapshot[\'cursor_center_lock\']);self.refresh_cursor_lock()\n            self.worker.cfg=self.config();self.save(silent=True)\n            self._defaults_undo=None\n            self.defaults_text.set(\'恢复默认值\');self.defaults_button.configure(style=\'TButton\')\n            self.feedback.set(\'已撤销恢复默认值，恢复到点击前的设置\')\n            return\n        self._defaults_undo=dict(values={key:v.get() for key,v in self.vars.items()},\n            always_on_top=self.always_on_top,cursor_center_lock=self.cursor_lock.enabled,\n            summon_key=self.summon_control.key_text.get(),\n            radar_delay_last=self.radar_delay_input.value())\n        self.defaults_text.set(\'撤销恢复默认值\');self.defaults_button.configure(style=\'UndoDefaults.TButton\')\n        defaults=asdict(Config())\n        for key,v in self.vars.items():\n            value=defaults[key]\n            if key==\'enemy_team\':value=\'自动\'\n            v.set(value)\n        self.set_topmost(False);self.summon_control.set_key(\'F6\');self.cursor_lock.set_enabled(True);self.refresh_cursor_lock()\n        self.worker.cfg=self.config();self.save(silent=True)\n        self.feedback.set(\'已恢复默认值；本次窗口关闭前可点击橘色按钮撤销\')\n    def load(self):\n        p=HERE/\'settings.json\'\n        if p.exists():\n            try:\n                d=json.loads(p.read_text(encoding=\'utf-8\'))\n                # Per-map degradation never changes the user\'s saved switches.\n                # Available maps keep the original static/penetration intent.\n                if isinstance(d.get(\'preview\'),bool):self.preview.set(d[\'preview\'])\n                tab=d.get(\'selected_tab\')\n                if isinstance(tab,int) and 0<=tab<len(self.tabs.pages):self.tabs.select(tab)\n                if d.get(\'language\') in (\'zh\',\'en\'):self.i18n.lang=d[\'language\']\n                if isinstance(d.get(\'always_on_top\'),bool):self.set_topmost(d[\'always_on_top\'])\n                from summon_ui import saved_key\n                self.summon_control.set_key(saved_key(d))\n                if isinstance(d.get(\'cursor_center_lock\'),bool):\n                    self.cursor_lock.set_enabled(d[\'cursor_center_lock\']);self.refresh_cursor_lock()\n                if isinstance(d.get(\'skin_selection\'),dict):self.skin_selection=d[\'skin_selection\']\n                geometry=d.get(\'window_geometry\',\'\')\n                if isinstance(geometry,str) and re.fullmatch(r\'\\d+x\\d+[+-]\\d+[+-]\\d+\',geometry):\n                    width,height,x,y=map(int,re.fullmatch(r\'(\\d+)x(\\d+)([+-]\\d+)([+-]\\d+)\',geometry).groups())\n                    api=C.windll.user32;left,top,span_x,span_y=(api.GetSystemMetrics(n) for n in (76,77,78,79))\n                    if x+80>left and x<left+span_x-80 and y+40>top and y<top+span_y-40:\n                        self.root.geometry(geometry);self.normal_geometry=geometry\n                self.saved_window_state=\'zoomed\' if d.get(\'window_state\')==\'zoomed\' else \'normal\'\n                for k,v in self.vars.items():\n                    if k==\'allies\':v.set(False);continue\n                    if k not in d:continue\n                    value=d[k]\n                    if k==\'radar_delay_seconds\':value=delay_value(value)\n                    if k==\'round_away_policy\' and value not in POLICIES:value=WAIT_PROMPT\n                    if k==\'enemy_team\':value={0:\'自动\',2:\'2 · T（恐怖分子）\',3:\'3 · CT（反恐精英）\'}.get(int(value),\'自动\')\n                    if k in (\'fov\',\'smoothing\',\'recoil_strength\',\'radar_span\',\'thirdperson_distance\'):\n                        limits={\'fov\':(1,50),\'smoothing\':(1,12),\'recoil_strength\':(0,1),\'radar_span\':(500,6000),\'thirdperson_distance\':(80,240)}\n                        value=max(limits[k][0],min(limits[k][1],float(value)))\n                    v.set(value)\n                if isinstance(d.get(\'game\'),str):self.game.set(d[\'game\'])\n            except (ValueError,TypeError,tk.TclError):self.status.set(\'设置文件有误，使用默认设置\')\n    def choose_game(self):\n        p=filedialog.askdirectory(parent=self.root,initialdir=self.game.get(),title=\'选择包含 Bin 的 cso2 目录\')\n        if p:self.game.set(p);self.feedback.set(\'已选择游戏目录；点击连接游戏应用\')\n    def request_action(self,command,argument=None):\n        if command==\'connection_cycle\':\n            if not self.cycle_active and self.lobby_busy:return\n            reader=self.worker.reader\n            if not self.cycle_active and (not reader or not reader.mem):\n                self.feedback.set(\'请先连接游戏\');return\n            self.cycle_active=not self.cycle_active\n            argument=dict(enabled=self.cycle_active,request_id=time.time_ns(),requested_at=time.monotonic())\n            self.cycle_text.set(\'停止循环\' if self.cycle_active else \'循环连接\')\n            self.apply_capabilities(self.capabilities)\n            self.worker.commands.put((command,argument))\n            self.feedback.set(\'正在启动循环连接…\' if self.cycle_active else \'正在停止循环连接…\')\n            return\n        if command==\'return_lobby\':\n            if self.cycle_active:\n                self.feedback.set(\'请先停止循环连接\');return\n            if self.lobby_busy:\n                record_lobby_event(\'ui_busy\');return\n            reader=self.worker.reader\n            if not reader or not reader.mem:\n                self.feedback.set(\'请先连接游戏\');record_lobby_event(\'ui_rejected\',reason=\'not_attached\');return\n            argument=dict(request_id=time.time_ns(),requested_at=time.monotonic())\n            record_lobby_event(\'ui_accepted\',**argument)\n            self.lobby_busy=True;self.lobby_button.state([\'disabled\'])\n        messages={\'return_lobby\':\'正在发送立即断开命令…\',\'diagnostics\':\'正在导出连接诊断…\',\'summary\':\'正在汇总当前对局日志…\',\n                  \'skin_roster\':\'正在读取 BOT 列表…\',\'skin_apply\':\'正在应用 BOT SKIN…\',\'skin_clear\':\'正在取消 BOT SKIN 指定…\',\'map\':\'正在载入所选地图…\'}\n        self.feedback.set(messages.get(command,\'正在处理…\'))\n        if command==\'skin_apply\':self.skin_selection.update(team=argument[\'team\'],bot=argument[\'index\'],skin=argument[\'skin\'])\n        self.worker.commands.put((command,argument))\n    def request_skin(self):\n        self.show_skin_dialog(None);self.request_action(\'skin_roster\')\n    def show_skin_dialog(self,snapshot):\n        if self.skin_dialog and self.skin_dialog.winfo_exists():\n            if snapshot is not None:self.skin_dialog.load(snapshot)\n            return\n        self.skin_dialog=SkinDialog(self.root,self.i18n,self.skin_selection,self.request_action)\n        if snapshot is not None:self.skin_dialog.load(snapshot)\n    def analyze_logs(self):\n        if getattr(self,\'analysis_running\',False):\n            self.feedback.set(\'日志分析正在进行…\');return\n        self.analysis_running=True;self.feedback.set(\'正在分析瞄准日志…\')\n        def analyze():\n            try:\n                from aim_audit import analyze_folder\n                path=analyze_folder(HERE/\'logs\');message=\'分析已保存：\'+str(path)\n            except Exception as ex:message=\'日志分析失败：\'+str(ex)\n            self.worker.events.put((\'analysis_done\',message))\n        threading.Thread(target=analyze,daemon=True).start()\n    def choose_map(self):\n        p=filedialog.askopenfilename(parent=self.root,initialdir=str(Path(self.game.get())/\'Data/cstrike/maps\'),filetypes=[(\'Source 地图\',\'*.bsp\')])\n        if p:self.request_action(\'map\',p)\n    def connect(self,automatic=False):\n        if self.connect_pending:self.feedback.set(\'正在连接游戏，请稍候…\');return\n        self.auto_connect=True;self.connect_pending=True;self.next_connect=time.monotonic()+2.\n        if not automatic:self.connect_failures=0\n        self.feedback.set(\'正在重新检测游戏…\' if automatic else \'正在连接游戏，请稍候…\')\n        if not automatic or not getattr(self,\'connect_failures\',0):self.status.set(\'正在识别游戏进程与数据地址…\')\n        self.worker.commands.put((\'attach\',self.game.get()))\n    def connection_finished(self,result):\n        self.connect_pending=False\n        ok=result.get(\'ok\',False) if isinstance(result,dict) else bool(self.worker.reader)\n        status=result.get(\'status\',\'\') if isinstance(result,dict) else \'\'\n        if ok:\n            self.connect_failures=0;self.feedback.set(\'连接完成\')\n        else:\n            # Startup is a race between the launcher and client/engine module\n            # loading. Keep the automatic attach loop armed with a short,\n            # fixed retry interval instead of exponential backoff, so the\n            # first tool instance recovers as soon as the EXE is ready.\n            self.connect_failures=getattr(self,\'connect_failures\',0)+1\n            delay=.25;self.next_connect=time.monotonic()+delay\n            self.feedback.set(\'连接未完成，持续重新检测\' if self.auto_connect else \'连接已取消\')\n        if status:self.status.set(status)\n    def restart_dead_worker(self):\n        """Replace an unexpectedly terminated worker so reconnect can run."""\n        if self.closing or not self.worker_started or self.worker.is_alive():return False\n        old=self.worker\n        try:\n            old.shutdown.set();old.disconnect()\n            # An exception before Worker.run\'s finally must not leave the\n            # asynchronous grenade trace writer alive across a replacement.\n            old.dodge.shutdown()\n        except Exception as ex:\n            self.status.set(\'旧 Worker 清理失败：\'+str(ex))\n        self.worker=Worker(self.win);self.worker.cfg=self.config();self.worker.start()\n        self.connect_pending=False;self.auto_connect=True;self.next_connect=0.\n        self.status.set(\'Worker 已恢复，正在重新连接游戏…\')\n        self.feedback.set(\'检测到后台线程退出，已自动重建\')\n        return True\n    def tick(self):\n        if self.closing:return\n        try:\n            self.restart_dead_worker()\n            self.sync_summon_pause()\n            self.sync_away_health()\n            self.sync_away_round()\n            cfg=self.config();self.worker.cfg=cfg\n            deadline=time.monotonic()+.006\n            for _ in range(64):\n                if time.monotonic()>=deadline:break\n                try:kind,msg=self.worker.events.get_nowait()\n                except queue.Empty:break\n                if kind==\'attach_done\':\n                    self.connection_finished(msg);continue\n                if kind==\'game_detected\':self.game.set(msg);continue\n                if kind==\'skin_roster\':self.show_skin_dialog(msg);self.feedback.set(\'BOT 列表已刷新\');continue\n                if kind==\'skin_result\':\n                    self.feedback.set(msg)\n                    if self.skin_dialog and self.skin_dialog.winfo_exists():self.skin_dialog.note.set(self.i18n.t(msg))\n                    continue\n                if kind==\'analysis_done\':self.analysis_running=False;self.feedback.set(msg);continue\n                if kind==\'capabilities\':self.apply_capabilities(msg);continue\n                if kind==\'lobby_busy\':self.lobby_busy=bool(msg);self.apply_capabilities(self.capabilities);continue\n                if kind==\'cycle_active\':\n                    self.cycle_active=bool(msg);self.cycle_text.set(\'停止循环\' if self.cycle_active else \'循环连接\')\n                    self.apply_capabilities(self.capabilities);continue\n                if kind==\'cycle_target\':self.cycle_target.set(\'循环目标：\'+msg);continue\n                if kind==\'command_result\':self.feedback.set(msg);continue\n                if kind==\'cursor_lock_disabled\':\n                    self.refresh_cursor_lock();self.save(silent=True);self.feedback.set(msg);continue\n                self.status.set(msg)\n                if kind==\'error\':\n                    # Clear a failed attach latch so automatic reconnect can retry.\n                    self.connect_pending=False\n            if self.auto_connect and not self.connect_pending and time.monotonic()>=self.next_connect:\n                reader=self.worker.reader\n                if reader is None or not reader.mem or not reader.mem.alive():self.connect(automatic=True)\n            frame=self.worker.frame\n            if frame and time.monotonic()-frame.stamp>.2:frame=None\n            panel_due=time.monotonic()-self.last_panel>.2\n            if panel_due:\n                if self.preview.get():\n                    self.display_state.tab_force_fire_active=False\n                    draw_scene(self.canvas,demo_frame(time.monotonic()),cfg,preview=True)\n                else:\n                    from server_esp_shared import preview_frame\n                    r=self.worker.reader;pid=r.mem.pid if r and r.mem else None\n                    preview=preview_frame(self,pid)\n                    if preview is not None:\n                        from radar_buy_delay import display_bridge_state\n                        preview.radar_delay_state=display_bridge_state(dict(radar_delay=self.worker.radar_delay_state),preview,r)\n                        from ghost_hostage_notice import display_state as hostage_display_state\n                        preview.ghost_hostage_protection=hostage_display_state(\n                            self.worker.control.diagnostic.get(\'ghost_hostage_protection\',{}),preview,r)\n                        self.display_state.tab_force_fire_active=bool(\n                            self.worker.control.diagnostic.get(\'tab_force_fire_active\',False))\n                    draw_scene(self.canvas,preview,cfg,self.worker.target,display_state=self.display_state,\n                               rmb_held=bool(cfg.quick_relock_hint and pid and self.win.foreground(pid) and self.win.down(2)))\n                self.last_panel=time.monotonic()\n            enemies=sum(e.enemy and not e.dormant for e in frame.entities) if frame else 0\n            if panel_due:\n                self.refresh_cursor_lock()\n                policy=self.worker.ally_policy\n                automatic=bool(policy.get(\'enabled\',False))\n                if self.vars[\'allies\'].get()!=automatic:self.vars[\'allies\'].set(automatic)\n                self.feature_widgets[\'allies\'].state([\'disabled\'])\n                self.ally_mode_text.set(policy[\'name\']+\'：\'+policy[\'reason\'])\n                self.refresh_radar_notice()\n                self.wall_notice.set_lines(notice_lines(self.worker.wall_capability,frame.map_name)\n                    if frame and not self.preview.get() and not self.resource_view_visible else ())\n                scan=self.client_resources.update(self.game.get())\n                self.client_resource_report=scan;self.refresh_client_notice()\n                reader=self.worker.reader;perf=self.worker.render_metrics\n                self.stats.set(f\'敌方 {enemies} · 采样 {reader.sample_ms:.1f} ms · 叠加 {perf.get("fps",0):.0f} FPS\' if frame and reader else \'等待对局数据\')\n                if frame:self.control_label.set(self.worker.control_status if (cfg.aim or cfg.fire or cfg.recoil) else (\'当前没有敌方实体\' if not enemies else \'瞄准、开火未开启\'))\n                elif self.worker.reader:self.control_label.set(self.worker.control_status)\n                self.log_label.set(self.worker.log_status)\n                from magic_bullet_service import status_text\n                self.magic_label.set(status_text(self.worker.magic.diagnostics(),\n                    (cfg.host_magic_bullet,cfg.client_magic_bullet)))\n                aa_cap=self.capabilities.get(\'anti_aim\',{})\n                aa_text=(self.worker.anti_aim.status if aa_cap.get(\'available\') else \'ANTI AIM：\'+aa_cap.get(\'reason\',\'等待对局\')) if cfg.anti_aim else \'ANTI AIM：关闭\'\n                self.anti_aim_label.set(aa_text)\n                if frame and frame.free_for_all:self.status.set(\'个人战已识别：自动显示并瞄准所有其他玩家\')\n        except Exception as ex:\n            self.status.set(f\'界面错误：{ex}\')\n            signature=(type(ex).__name__,str(ex))\n            if getattr(self,\'last_ui_error\',None)!=signature:\n                self.last_ui_error=signature\n                try:\n                    with (HERE/\'ui_error.log\').open(\'a\',encoding=\'utf-8\') as fp:\n                        fp.write(time.strftime(\'%Y-%m-%d %H:%M:%S\')+\'\\n\'+traceback.format_exc()+\'\\n\')\n                except OSError:pass\n        # GUI updates cannot stall the independent process that presents ESP.\n        self.root.after(50,self.tick)\n    def close(self):\n        self.closing=True\n        self.health_away_menu.close()\n        self.round_policy_menu.close()\n        self.round_away_dialog.close();self.round_away.close()\n        self.summon_control.close()\n        self.floating_window.close()\n        self.client_resources.close()\n        try:self.save(silent=True)\n        except Exception as ex:self.status.set(\'设置保存失败：\'+str(ex))\n        # Signal the worker before UI/native cleanup so an exception from one\n        # Windows handle cannot leave game controls running indefinitely.\n        self.worker.shutdown.set()\n        try:self.worker.stop_bhop()\n        except Exception as ex:self.status.set(\'独立连跳退出失败：\'+str(ex))\n        try:self.cursor_lock.close()\n        except Exception as ex:self.status.set(\'鼠标锁定清理失败：\'+str(ex))\n        preview_reader=getattr(self,\'server_preview_reader\',None)\n        if preview_reader:\n            try:preview_reader.close()\n            except Exception as ex:self.status.set(\'预览读取清理失败：\'+str(ex))\n            self.server_preview_reader=None\n        self.root.withdraw()\n        # Keep the interpreter alive while the worker restores process state\n        # and the bounded writer flushes its final match summary.\n        def finish():\n            if self.worker_started and self.worker.is_alive():self.root.after(50,finish)\n            else:self.root.destroy()\n        finish()\n\ndef relaunch_elevated():\n    """Match elevated games on a normal user launch; never elevate workers."""\n    if C.windll.shell32.IsUserAnAdmin():return False\n    import subprocess\n    executable=Path(sys.executable);hidden=executable.with_name(\'pythonw.exe\')\n    if hidden.is_file():executable=hidden\n    arguments=subprocess.list2cmdline([\'-P\',\'-X\',\'utf8\',str(BUNDLE_ENTRY),*sys.argv[1:]])\n    shell=C.windll.shell32;shell.ShellExecuteW.argtypes=[W.HWND,W.LPCWSTR,W.LPCWSTR,W.LPCWSTR,W.LPCWSTR,C.c_int]\n    shell.ShellExecuteW.restype=C.c_void_p\n    result=shell.ShellExecuteW(None,\'runas\',str(executable),arguments,str(BUNDLE_ENTRY.parent),0)\n    if not result or result<=32:raise RuntimeError(\'管理员权限未取得，无法连接以管理员身份运行的游戏；可重新启动工具并允许系统权限提示\')\n    return True\n\n\n\nclass ToolInstance:\n    """One GUI per entry path; repeat launches ask the existing GUI to show."""\n    def __init__(self,name=None,build_id=None):\n        import hashlib\n        self.api=C.WinDLL(\'kernel32\',use_last_error=True)\n        specs={\'CreateMutexW\':(W.HANDLE,[C.c_void_p,W.BOOL,W.LPCWSTR]),\n            \'CreateEventW\':(W.HANDLE,[C.c_void_p,W.BOOL,W.BOOL,W.LPCWSTR]),\n            \'OpenEventW\':(W.HANDLE,[W.DWORD,W.BOOL,W.LPCWSTR]),\n            \'SetEvent\':(W.BOOL,[W.HANDLE]),\'WaitForSingleObject\':(W.DWORD,[W.HANDLE,W.DWORD]),\n            \'CloseHandle\':(W.BOOL,[W.HANDLE])}\n        for key,(restype,argtypes) in specs.items():\n            fn=getattr(self.api,key);fn.restype=restype;fn.argtypes=argtypes\n        if name is None:\n            digest=hashlib.sha256(os.path.normcase(str(BUNDLE_ENTRY.resolve())).encode(\'utf-8\')).hexdigest()[:24]\n            name=\'Local\\\\CSO2_BOT_GUI_\'+digest\n        self.build_id=build_id or hashlib.sha256(BUNDLE_ENTRY.read_bytes()).hexdigest()\n        self.name=name;self.handle=None;self.event=None;self.build_event=None;self.root=None;self.job=None\n        C.set_last_error(0);self.handle=self.api.CreateMutexW(None,False,name)\n        error=C.get_last_error()\n        if not self.handle:raise C.WinError(error)\n        self.acquired=error!=183\n        if self.acquired:\n            self.event=self.api.CreateEventW(None,False,False,name+\'_SHOW\')\n            if not self.event:self.close();raise C.WinError(C.get_last_error())\n            self.build_event=self.api.CreateEventW(None,True,False,name+\'_BUILD_\'+self.build_id)\n            if not self.build_event:self.close();raise C.WinError(C.get_last_error())\n    def matching_build(self):\n        handle=self.api.OpenEventW(0x100000,False,self.name+\'_BUILD_\'+self.build_id)\n        if not handle:return False\n        self.api.CloseHandle(handle);return True\n    def wake_existing(self):\n        # The owner\'s Tk thread executes the same idempotent show path as F6,\n        # including cursor release/input pause, without activating the game.\n        handle=self.api.OpenEventW(2,False,self.name+\'_SHOW\')\n        if handle:\n            try:\n                if not self.api.SetEvent(handle):raise C.WinError(C.get_last_error())\n                return True\n            finally:self.api.CloseHandle(handle)\n        # Upgrade compatibility: pre-fix copies did not expose a wake event.\n        # Restore only a single matching GUI, never an arbitrary first match.\n        api=C.WinDLL(\'user32\',use_last_error=True)\n        callback_type=C.WINFUNCTYPE(W.BOOL,W.HWND,W.LPARAM)\n        specs={\'EnumWindows\':(W.BOOL,[callback_type,W.LPARAM]),\n            \'GetWindowTextW\':(C.c_int,[W.HWND,W.LPWSTR,C.c_int]),\n            \'GetClassNameW\':(C.c_int,[W.HWND,W.LPWSTR,C.c_int]),\n            \'ShowWindowAsync\':(W.BOOL,[W.HWND,C.c_int]),\n            \'SetWindowPos\':(W.BOOL,[W.HWND,W.HWND,C.c_int,C.c_int,C.c_int,C.c_int,W.UINT])}\n        for key,(restype,argtypes) in specs.items():\n            fn=getattr(api,key);fn.restype=restype;fn.argtypes=argtypes\n        found=[]\n        @callback_type\n        def visit(hwnd,_):\n            title=C.create_unicode_buffer(256);kind=C.create_unicode_buffer(64)\n            api.GetWindowTextW(hwnd,title,len(title));api.GetClassNameW(hwnd,kind,len(kind))\n            if title.value.startswith(\'CSO2 BOT Tool · \') and kind.value==\'TkTopLevel\':found.append(hwnd)\n            return True\n        api.EnumWindows(visit,0)\n        if len(found)!=1:return False\n        hwnd=found[0]\n        # SW_SHOWNOACTIVATE, SWP_NOACTIVATE: leave maximized game focus alone.\n        api.ShowWindowAsync(hwnd,4)\n        return bool(api.SetWindowPos(hwnd,W.HWND(-1),0,0,0,0,0x4053))\n    def listen(self,root,show):\n        self.root=root\n        def poll():\n            self.job=None\n            if self.event is None:return\n            try:\n                if self.api.WaitForSingleObject(self.event,0)==0:show()\n            finally:\n                if self.event is not None:self.job=root.after(100,poll)\n        poll()\n    def close(self):\n        if self.job is not None and self.root is not None:\n            try:self.root.after_cancel(self.job)\n            except tk.TclError:pass\n            self.job=None\n        if self.event:self.api.CloseHandle(self.event);self.event=None\n        if self.build_event:self.api.CloseHandle(self.build_event);self.build_event=None\n        if self.handle:self.api.CloseHandle(self.handle);self.handle=None\n\n\ndef main():\n    if os.name!=\'nt\':raise SystemExit(\'本工具需要 Windows。\')\n    if relaunch_elevated():return\n    instance=ToolInstance()\n    if not instance.acquired:\n        try:\n            if not instance.wake_existing():\n                messagebox.showinfo(\'CSO2 BOT Tool\',\'工具已在运行，正在初始化窗口或等待旧窗口响应。请稍后再次打开。\')\n            elif not instance.matching_build():\n                messa