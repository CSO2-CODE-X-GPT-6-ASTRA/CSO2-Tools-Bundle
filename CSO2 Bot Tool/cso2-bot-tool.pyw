ue,\'当前目标已对准\',pre_down=commit):\n                self.cadence.requested(self.last_fire)\n                if self.engagement[\'first_fire\'] is None:self.engagement[\'first_fire\']=self.clock()\n        if self.trigger and self.pressed and self.trigger.maintain() is False:\n            self.button(False,\'当前武器或弹量已变化\')\n            self.diagnostic.update(fire_allowed=False,input_weapon_guard=dict(self.trigger.fire_guard))\n        self.diagnostic.update(trigger_after=self.pressed,control_ms=max(0.,self.clock()-now)*1000)\n        return self.target\n\nclass Worker(threading.Thread):\n    def __init__(self,win):\n        super().__init__(daemon=True);self.win=win;self.aim_service=AimService(self.aim_settings);self.trigger=self.aim_service.trigger;self.control=self.aim_service.control;self.commands=queue.Queue();self.events=queue.Queue();self.cfg=Config();self.frame=None;self.reader=None;self.shutdown=threading.Event();self.enabled=False;self.target=0;self.bsp=None;self.map_key=None;self.wall_cache={};self.last_trace=0;self.weapon_cache={};self.status=\'未连接\';self.game=DEFAULT_GAME;self.manual_bsp=None;self.wall_service=None;self.trace_ms=0;self.control_status="未连接"\n        self.bhop_service=None;self.local_controls=LocalControls(win);self.battle=None;self.damage_sink=None;self.log_retry=0;self.last_log_poll=0;self.render_metrics={};self.log_status=\'日志未连接\'\n        self.overlay_service=None;self.last_overlay_submit=0;self.overlay_error=\'\';self.overlay_retry_at=0.;self.overlay_start_failures=0\n        self.last_quick_trace=0.\n        self.force_fire_active=False;self.force_fire_key_down=False;self.force_fire_scope=None\n        self.map_resources=MapResources();self.wall_capability={}\n        self.weapon_catalog=None\n        self.white_map=None\n        self.memory_monitor=None\n        self.server_visibility=ServerVisibility();self.visibility_status=\'未启用\'\n        self.bot_population=BotPopulation(win)\n        self.dodge=DodgeService(self.dodge_settings)\n        self.health_lock=LocalHealthLock();self.companion=CompanionLauncher(HERE.parent)\n        self.bot_skins=BotSkins();self.anti_aim=AntiAim(win);self.return_lobby=ReturnLobby(win,on_event=record_lobby_event)\n        self.connection_cycle=ConnectionCycle(win,on_event=record_lobby_event,\n                                              on_before_reconnect=self.pause_cycle_controls)\n        self.health_status=\'HP 锁定：关闭\';self.companion_status=self.companion.status\n        self.native_radar=NativeRadar();self.radar_status=self.native_radar.status\n        self.radar_delay=RadarBuyDelay();self.radar_delay_state={};self.ally_policy=ally_decision(0)\n        self.attached_waiting=False;self.waiting_cleanup={};self.waiting_cleanup_at=0.;self.feature_error_counts={}\n        self.ui_pause=threading.Event()\n        self.magic=MagicBulletService(win)\n        self.disconnect_pending=False\n    def aim_settings(self):\n        # Settings/lifecycle only; no target frames or per-shot messages.\n        cfg=getattr(self,\'_aim_effective_cfg\',self.cfg)\n        permitted=bool(self.enabled and not self.shutdown.is_set() and not self.ui_pause.is_set()\n            and not self.return_lobby.pending and not self.disconnect_pending\n            and (not self.connection_cycle.active or self.connection_cycle.phase==\'holding\'))\n        return cfg,permitted\n    def dodge_settings(self):\n        # Only user settings and explicit lifecycle gates cross processes.\n        # The child checks its own native mode, local identity and HE entities.\n        permitted=bool(self.enabled and not self.shutdown.is_set() and not self.ui_pause.is_set()\n            and not self.return_lobby.pending and not self.disconnect_pending\n            and (not self.connection_cycle.active or self.connection_cycle.phase==\'holding\'))\n        return dict(enabled=bool(self.cfg.grenade_dodge),\n                    ghost_only=bool(self.cfg.grenade_dodge_ghost_only),\n                    manual_bsp=str(self.manual_bsp) if self.manual_bsp else None),permitted\n    def route_wall_signal(self,signals,context):\n        # Fan out the SAME producer bit. Neither subscriber depends on drawing.\n        accepted=False\n        for subscriber in (getattr(self,\'aim_service\',None),self.overlay_service):\n            if subscriber is None:continue\n            try:accepted=bool(subscriber.submit_wall(signals,context)) or accepted\n            except Exception as ex:self.post(\'status\',\'穿透信号投递失败：\'+str(ex))\n        return accepted\n    def clear_force_fire_toggle(self,held=None):\n        if held is None:\n            try:held=bool(self.win.down(0x54))\n            except Exception:held=True\n        was_active=getattr(self,\'force_fire_active\',False)\n        self.force_fire_active=False;self.force_fire_key_down=held;self.force_fire_scope=None\n        self.trigger.tab_force=False\n        self.control.diagnostic.update(tab_force_fire_active=False,tab_force_fire_notice=\'\')\n        if self.frame is not None:self.frame.tab_force_fire_active=False\n        if was_active:self.control.release()\n    def update_force_fire_toggle(self,enabled,paused=False,scope=None):\n        # Poll even while paused/disabled: a held T must not re-enable on resume.\n        try:held=bool(self.win.down(0x54))\n        except Exception:\n            self.clear_force_fire_toggle(held=True);return False\n        prior=getattr(self,\'force_fire_scope\',None)\n        if not enabled or paused or (prior is not None and prior!=scope):\n            self.clear_force_fire_toggle(held)\n        elif held and not self.force_fire_key_down:\n            if self.force_fire_active:\n                # Clear while the latch is still active so the owned fire\n                # reservation emits its matching primary-attack UP now.\n                self.clear_force_fire_toggle(held)\n            else:\n                self.force_fire_active=True\n        self.force_fire_key_down=held;self.force_fire_scope=scope\n        return self.force_fire_active\n    def force_fire_config(self,frame,cfg,ui_paused=False):\n        try:\n            paused=bool(ui_paused or not self.win.foreground(self.reader.mem.pid)\n                        or self.reader.game_ui_visible() or frame.local.health<=0)\n        except Exception:paused=True\n        scope=(id(self.reader),self.reader.mem.pid,frame.map_name,\n               frame.local.address,frame.local.serial,getattr(frame,\'source_epoch\',None))\n        active=self.update_force_fire_toggle(bool(cfg.tab_force_fire),paused,scope)\n        return replace(cfg,tab_force_fire=active)\n    def update_wall_channel(self,f,cfg,weapon):\n        """Optional positive publisher. Exceptions cannot enter control cleanup."""\n        try:\n            self.wall_capability=self.map_resources.update(f.map_name,(self.reader.mem.pid,str(self.game)))\n            f.wall_capability=dict(self.wall_capability)\n            need_walls=bool(cfg.walls and (cfg.esp or cfg.arrows or cfg.aim or cfg.fire or cfg.tab_force_fire))\n            if need_walls:\n                key=(f.map_name,self.manual_bsp,self.wall_capability.get(\'generation\'))\n                if key!=self.map_key:\n                    if self.wall_service:self.wall_service.close()\n                    self.map_key=key;self.wall_cache={};self.trace_ms=0;self.dodge_plan=None\n                    self.wall_service=WallService(self.game,f.map_name,self.manual_bsp)\n                    self.post(\'status\',\'正在后台读取地图墙体…\')\n                from wall_service import wall_scope\n                scope=wall_scope(f,weapon)\n                context=dict(pid=self.reader.mem.pid,map=f.map_name,\n                    local_identity=[f.local.index,f.local.address,f.local.serial],weapon=f.weapon,\n                    source_epoch=f.source_epoch,control_source=f.source)\n                aim=getattr(self,\'aim_service\',None)\n                if aim:aim.set_scope(context)\n                if aim or callable(getattr(self.overlay_service,\'submit_wall\',None)):\n                    self.wall_service.signal_route=(scope,context,self.route_wall_signal)\n                if getattr(self,\'wall_result_scope\',None)!=scope:\n                    self.wall_cache={};self.wall_service.fast_records={};self.wall_result_scope=scope\n                    route=getattr(self.wall_service,\'signal_route\',None)\n                    if route:route[2]({},dict(route[1],clear_wall=True))\n                for event in self.wall_service.poll(f,weapon):\n                    if event.get(\'ready\'):\n                        training=event.get(\'training\') or {}\n                        source=\'外部挂载障碍物数据\' if training.get(\'geometry_source\')==\'external_world_brushes\' else \'运行时BSP回退\'\n                        verified=training.get(\'payload_hash_verified\') or training.get(\'hash_match\')\n                        self.post(\'status\',f"墙体已载入：{event[\'brushes\']} 个世界墙体 · {source} · 数据校验{\'通过\' if verified else \'待核对\'} · 完整碰撞与穿透校准待完成")\n                        if self.battle:self.battle.event(\'wall_ready\',map=f.map_name,training=training,brushes=event[\'brushes\'])\n                        if self.battle:self.battle.event(\'penetration_map_validation\',\n                            **event.get(\'penetration_validation\',{}))\n                    if \'error\' in event:\n                        if self.battle:self.battle.event(\'wall_error\',map=f.map_name,error=str(event[\'error\']),failed=bool(event.get(\'failed\')))\n                        # Wall data is an ESP-only observation. A\n                        # worker timeout clears only its positive ESP\n                        # markers; it never rewrites aim/fire fields.\n                        self.wall_cache={};self.dodge_plan=None;self.trace_ms=0\n                        if getattr(self.wall_service,\'signal_route\',None):\n                            route=self.wall_service.signal_route\n                            route[2]({},dict(route[1],clear_wall=True))\n                        if self.wall_service:self.wall_service.fast_records={}\n                        self.post(\'status\',event[\'error\'])\n                    if \'results\' in event:\n                        self.trace_ms=event[\'trace_ms\']\n                        # A batch belongs to one eye/pose snapshot. Do\n                        # not mix its actors with an older worker pass.\n                        self.wall_cache={index:record for index,*record in event[\'results\']}\n                        from wall_service import esp_positive_records\n                        self.wall_batch=dict(targets=len(event[\'results\']),\n                            sampled=sum(bool(row[8]) for row in event[\'results\']),\n                            positive=len(esp_positive_records(self.wall_cache)),\n                            trace_ms=self.trace_ms)\n                if time.monotonic()-self.last_trace>=.008:\n                    from wall_service import display_wall_frame\n                    candidates=[getattr(self.overlay_service,\'wall_geometry\',{}),\n                                getattr(getattr(self,\'aim_service\',None),\'geometry\',{})]\n                    display_packet=max(candidates,key=lambda packet:packet.get(\'stamp\',0.))\n                    wall_frame,self.wall_input=display_wall_frame(f,display_packet,self.reader,time.monotonic())\n                    def trace_key(e):\n                        info=threat_info(f,e)\n                        if cfg.strategy==COMPREHENSIVE:return (*comprehensive_key(info),e.index!=self.target)\n                        return (info[\'tier\'],e.index!=self.target,*priority_key(info)) if cfg.strategy==NEAR_FIRST else (e.index!=self.target,info[\'error\'])\n                    nearby=sorted((e for e in (wall_frame.entities if wall_frame is not None else ()) if e.enemy and candidate_points(e) and not e.dormant and (cfg.esp_npcs or entity_kind(e.classname)!=\'npc\')),\n                                  key=lambda e:trace_key(e if e.head else replace(e,head=e.aim_points[0].position)))\n                    if nearby:\n                        self.wall_service.submit(wall_frame.eye,nearby,weapon,wall_frame,with_dodge=False)\n                    self.last_trace=time.monotonic()\n            elif self.wall_service:\n                route=getattr(self.wall_service,\'signal_route\',None)\n                if route:route[2]({},dict(route[1],clear_wall=True))\n                self.wall_service.close();self.wall_service=None;self.map_key=None;self.wall_cache={} \n        except Exception as ex:\n            self.wall_cache={};self.trace_ms=0\n            self.wall_channel_error=type(ex).__name__+\': \'+str(ex)\n\n    def post(self,kind,message):self.events.put((kind,message))\n    def cleanup(self,label,action):\n        if not hasattr(self,\'cleanup_errors\'):self.cleanup_errors={}\n        try:\n            if action() is False:return False\n            self.cleanup_errors.pop(label,None);return True\n        except Exception as ex:\n            now=time.monotonic();old=self.cleanup_errors.get(label)\n            if old is None or old[0]!=str(ex) or now-old[1]>=5:\n                self.post(\'status\',label+\'：\'+str(ex));self.cleanup_errors[label]=(str(ex),now)\n            return False\n    def optional_service(self,label,factory):\n        try:return factory()\n        except Exception as ex:\n            self.post(\'status\',label+\'暂不可用：\'+str(ex));return None\n    def publish_capabilities(self,capabilities):\n        if self.return_lobby.pending:\n            capabilities={key:{\'available\':False,\'reason\':\'正在返回大厅，实时功能已暂停\'} for key in FEATURE_KEYS}\n        if capabilities!=getattr(self,\'last_capabilities\',None):\n            self.last_capabilities={k:dict(v) for k,v in capabilities.items()};self.post(\'capabilities\',self.last_capabilities)\n    def observe_runtime(self,frame=None,cfg=None,waiting_reason=\'\'):\n        from runtime_compat import RuntimeObservation\n        if not hasattr(self,\'runtime_observer\'):self.runtime_observer=RuntimeObservation()\n        record=self.runtime_observer.observe(self.reader,frame,self.cfg,cfg,self.control,\n            getattr(self,\'render_metrics\',{}),getattr(self,\'overlay_error\',\'\'),waiting_reason)\n        if record is None:return\n        record[\'bundle_revision\']=globals().get(\'BUNDLE_REVISION\',\'unavailable\')\n        record[\'wall_capability\']=dict(getattr(self,\'wall_capability\',{}))\n        record[\'white_map\']=dict(self.white_map.snapshot) if getattr(self,\'white_map\',None) else {}\n        record[\'return_lobby\']=self.return_lobby.diagnostics()\n        radar=getattr(self,\'native_radar\',None)\n        if radar is not None:\n            record[\'native_radar\']=self.radar_diagnostics()\n        def save():\n            journal=HERE/\'runtime_states.jsonl\'\n            if journal.exists() and journal.stat().st_size>2*1024*1024:journal.replace(HERE/\'runtime_states.previous.jsonl\')\n            with journal.open(\'a\',encoding=\'utf-8\') as stream:stream.write(json.dumps(record,ensure_ascii=False)+\'\\n\')\n            temp=HERE/\'runtime_state.tmp\';temp.write_text(json.dumps(record,ensure_ascii=False,indent=2),encoding=\'utf-8\')\n            temp.replace(HERE/\'runtime_state.json\')\n            events=record[\'connection\'].get(\'native_events\',[])\n            if events:\n                reasons=HERE/\'disconnect_reasons.jsonl\'\n                if reasons.exists() and reasons.stat().st_size>512*1024:reasons.replace(HERE/\'disconnect_reasons.previous.jsonl\')\n                with reasons.open(\'a\',encoding=\'utf-8\') as stream:\n                    for event in events:stream.write(json.dumps(dict(event,runtime_time=record[\'time\'],network=record[\'connection\'][\'network\']),ensure_ascii=False)+\'\\n\')\n        self.cleanup(\'联机显示瞄准状态日志\',save)\n        if self.battle and frame:self.cleanup(\'对局运行状态日志\',lambda:self.battle.event(\'runtime_state\',runtime=record))\n    def connection_transition(self,state,message,frame=None):\n        r=self.reader;memory=getattr(r,\'mem\',None)\n        pid=getattr(memory,\'pid\',None);pid=pid if isinstance(pid,int) else None\n        sample=getattr(r,\'session_state\',{})\n        sample=sample if isinstance(sample,dict) else {}\n        signon=sample.get(\'signon\');map_name=frame.map_name if frame is not None else sample.get(\'map\',\'\')\n        key=(state,pid,map_name,signon,message)\n        if key==getattr(self,\'last_connection_state\',None):return\n        self.last_connection_state=key\n        record=dict(time=time.strftime(\'%Y-%m-%d %H:%M:%S\'),state=state,pid=pid,map=map_name,\n            signon=signon,status=message,revision=\'2026.09.20-attached-backend1\',\n            process_attached=bool(memory),frame_ready=state==\'ready\')\n        self.last_connection_diagnostics=record\n        def save():\n            journal=HERE/\'connection_events.jsonl\'\n            if journal.exists() and journal.stat().st_size>512*1024:journal.replace(HERE/\'connection_events.previous.jsonl\')\n            with journal.open(\'a\',encoding=\'utf-8\') as stream:stream.write(json.dumps(record,ensure_ascii=False)+\'\\n\')\n            temp=HERE/\'connection_state.tmp\';temp.write_text(json.dumps(record,ensure_ascii=False,indent=2),encoding=\'utf-8\')\n            temp.replace(HERE/\'connection_state.json\')\n        self.cleanup(\'连接状态日志\',save)\n        if state==\'ready\':self.status=message;self.post(\'status\',message)\n    def feature_call(self,keys,action,cleanup=None):\n        now=time.monotonic()\n        retry=max((self.reader.feature_retry_after.get(key,0.) for key in keys),default=0.) if self.reader else 0.\n        if retry>now:\n            reason=next((self.reader.capability_failures.get(key,\'\') for key in keys if self.reader.capability_failures.get(key)), \'等待功能重试\')\n            return \'重试中：\'+reason\n        try:\n            result=action()\n            for key in keys:\n                if key not in self.reader.capability_failures:self.feature_error_counts.pop(key,None)\n            return result\n        except Exception as ex:\n            now=time.monotonic()\n            for key in keys:\n                count=min(4,self.feature_error_counts.get(key,0)+1);self.feature_error_counts[key]=count\n                delay=min(5.,.5*2**(count-1))\n                self.reader.capability_failures[key]=str(ex)\n                self.reader.feature_retry_after[key]=now+delay\n                self.reader.capabilities[key]={\'available\':False,\'reason\':str(ex),\'retry_after_seconds\':delay}\n            if cleanup:self.cleanup(\'功能停止\',cleanup)\n            self.publish_capabilities(self.reader.capabilities);self.post(\'status\',\'功能正在自动重试：\'+str(ex))\n            return \'重试中：\'+str(ex)\n    def radar_diagnostics(self):\n        caps=getattr(self.reader,\'capabilities\',{}) if self.reader else {}\n        cap=dict(caps.get(\'radar\',{}))\n        requested=bool(self.cfg.radar)\n        snapshot=radar_observation(self.native_radar.metrics,requested=requested,\n            available=bool(cap.get(\'available\')),current_map=getattr(self,\'radar_observation_map\',None),\n            waiting=getattr(self,\'radar_observation_waiting\',True),now=time.monotonic())\n        snapshot.update(status=self.radar_status,build=BUILD,capability_available=cap.get(\'available\'),\n            capability_reason=cap.get(\'reason\',\'\'),retry_after=getattr(self.reader,\'feature_retry_after\',{}).get(\'radar\'))\n        return snapshot\n    def update_native_radar(self,frame,cfg,caps):\n        self.radar_observation_map=getattr(frame,\'map_name\',None)\n        self.radar_observation_waiting=not bool(self.radar_observation_map)\n        gate=self.radar_delay.step(self.reader,frame,self.cfg.radar,cfg.radar_delay_seconds)\n        self.radar_delay_state=gate\n        if self.cfg.radar and not cfg.radar:\n            # A rejected probe is not a user switching the checkbox off.\n            # Preserve the reason so this no longer masquerades as "closed".\n            if self.native_radar.owned or self.native_radar.team_view.owner is not None:\n                self.cleanup(\'雷达 UI 恢复\',self.native_radar.close)\n            reason=caps.get(\'radar\',{}).get(\'reason\') or \'等待原生 UI 路径校验\'\n            status=\'雷达：等待校验 · \'+reason\n            self.radar_delay_state=dict(gate,phase=\'waiting\',allowed=False,error=reason)\n        else:\n            status=self.feature_call((\'radar\',),\n                lambda:self.native_radar.step(self.reader,frame,cfg.radar and gate[\'allowed\']),self.native_radar.close)\n            if cfg.radar and not gate[\'allowed\']:\n                lines=radar_notice_lines(gate)\n                status=\'雷达：\'+(lines[0] if lines else \'购买保护中，等待回合状态就绪\')\n            elif cfg.radar:\n                self.radar_delay_state=dict(gate,phase=\'active\' if self.native_radar.metrics.get(\'active\') else \'waiting\')\n        self.native_radar.metrics=dict(self.native_radar.metrics,buy_delay=dict(self.radar_delay_state))\n        if status!=self.radar_status:\n            self.radar_status=status;self.post(\'status\',status)\n            if self.battle:self.battle.event(\'native_radar\',status=status,details=self.radar_diagnostics())\n        return status\n    def attached_services(self):\n        # Settings delivery and independent renderer/diagnostic services do not\n        # depend on the control reader producing a player frame.\n        now=time.monotonic()\n        if self.enabled and self.reader and self.reader.mem:\n            self.dodge.start(self.game,self.reader.mem.pid)\n            self.dodge.resume()\n            self.dodge.poll()\n        if not self.cfg.radar and self.native_radar.owned:\n            self.cleanup(\'雷达 UI 恢复\',self.native_radar.close)\n        self.ensure_overlay()\n        if self.overlay_service and now-self.last_overlay_submit>=.1:\n            self.cleanup(\'显示设置同步\',lambda:self.overlay_service.submit(self.cfg,0,{},hostage_warnings={}))\n            self.last_overlay_submit=now\n            self.render_metrics=dict(self.overlay_service.metrics)\n    def ensure_overlay(self):\n        """A failed first construction is retryable, independently of player-frame controls."""\n        if not self.enabled or not self.reader or not self.reader.mem or self.shutdown.is_set():return False\n        now=time.monotonic()\n        if self.overlay_service is None or self.overlay_service.closed:\n            if now<self.overlay_retry_at:return False\n            self.overlay_retry_at=now+1.\n            try:\n                self.overlay_service=OverlayService(self.game)\n                self.overlay_service.submit(self.cfg,0,{},hostage_warnings={})\n                self.last_overlay_submit=now;self.overlay_error=\'\'\n            except Exception as ex:\n                service=self.overlay_service;self.overlay_service=None\n                if service:self.cleanup(\'绘制服务重建清理\',service.close)\n                self.overlay_start_failures+=1;message=str(ex)\n                self.render_metrics=dict(state=\'recovering\',reason=\'renderer_start_failed\',error=message,\n                    start_failures=self.overlay_start_failures,retry_seconds=1.,observed_at=now)\n                if message!=self.overlay_error:self.post(\'status\',\'ESP 正在自动重试：\'+message)\n                self.overlay_error=message;return False\n        self.cleanup(\'绘制服务自动恢复\',self.overlay_service.health_tick)\n        self.render_metrics=dict(self.overlay_service.metrics)\n        stamp=self.render_metrics.get(\'observed_at\')\n        if (self.render_metrics.get(\'state\') in (\'rendering\',\'sampling_hidden\')\n                and not self.overlay_service.error and isinstance(stamp,(int,float))\n                and 0<=now-stamp<=1.5):self.overlay_error=\'\'\n        return True\n    def drain_waiting_controls(self,force=False):\n        now=time.monotonic()\n        if not force and now<self.waiting_cleanup_at:return not self.waiting_cleanup\n        self.waiting_cleanup_at=now+.25\n        for label,action in list(self.waiting_cleanup.items()):\n            if self.cleanup(label,action):self.waiting_cleanup.pop(label,None)\n        return not self.waiting_cleanup\n    def resume_frame_controls(self):\n        if not self.attached_waiting:return\n        if not self.drain_waiting_controls(force=True):raise NotReady(\'游戏连接保留，正在完成上一轮按键释放\')\n        self.attached_waiting=False\n    def start_bhop(self):\n        # Only lifecycle/settings cross into this service. Its child owns every\n        # key/ground sample and jump write, independently of this Worker loop.\n        if self.bhop_service is None:\n            self.bhop_service=BhopService(self.game,self.reader.mem.pid,\n                lambda:bool(self.cfg.bhop and not self.shutdown.is_set()))\n    def stop_bhop(self):\n        service=self.bhop_service\n        if service is not None:\n            service.close()\n            if self.bhop_service is service:self.bhop_service=None\n    def disconnect(self):\n        bhop_stopped=self.cleanup(\'独立连跳停止\',self.stop_bhop)\n        self.cleanup(\'关闭 T 强制模式\',self.clear_force_fire_toggle)\n        magic_stopped=self.cleanup(\'魔法子弹停用\',self.magic.close)\n        self.radar_delay.reset();self.radar_delay_state={};self.ally_policy=ally_decision(0)\n        self.cleanup(\'循环连接停止\',self.connection_cycle.close);self.post(\'cycle_active\',False)\n        if self.return_lobby.pending:self.post(\'command_result\',\'已停止等待返回大厅；游戏队列中的退出请求无法撤回\')\n        self.cleanup(\'返回大厅监测停止\',self.return_lobby.close);self.post(\'lobby_busy\',False)\n        self.publish_capabilities({})\n        # Every resource gets its cleanup attempt even if the process vanished\n        # halfway through restoring another feature. Keep the command loop alive.\n        self.frame=None;self.enabled=False;self.target=0\n        self.last_connection_state=None\n        self.attached_waiting=False;self.waiting_cleanup={};self.waiting_cleanup_at=0.;self.feature_error_counts={}\n        self.cleanup(\'ANTI AIM 恢复\',self.anti_aim.close)\n        self.control.reason=\'连接已断开\';self.control.input_armed=False\n        self.cleanup(\'停止瞄准\',self.control.release)\n        self.cleanup(\'独立瞄准停止\',self.aim_service.close)\n        dodge_stopped=self.cleanup(\'独立躲雷停止\',self.dodge.close)\n        input_restored=self.cleanup(\'恢复开火按键\',self.trigger.close)\n        self.control.ammo_last=None;self.control.ammo_at=0.;self.control.last_weapon=\'\'\n        self.control.last_weapon_identity=None\n        self.control.last_fire=-100.;self.control.last_release=-100.\n        for name,label in ((\'native_radar\',\'雷达 UI 恢复\'),(\'bot_skins\',\'BOT SKIN 恢复\'),(\'health_lock\',\'HP 恢复\'),\n                           (\'memory_monitor\',\'内存监测停止\'),\n                           (\'bot_population\',\'自动补人恢复\'),(\'server_visibility\',\'本地主机同步恢复\'),\n                           (\'overlay_service\',\'绘制进程停止\'),(\'local_controls\',\'本机控制恢复\'),(\'white_map\',\'材质检测停止\')):\n            resource=getattr(self,name,None)\n            if resource:self.cleanup(label,resource.close)\n            if name in (\'memory_monitor\',\'overlay_service\',\'white_map\'):setattr(self,name,None)\n        self.dodge_plan=None\n        if self.damage_sink:\n            def drain_damage():\n                if self.reader and self.reader.mem and self.reader.mem.alive() and self.battle:\n                    self.battle.native(self.damage_sink.poll())\n            self.cleanup(\'伤害日志读取\',drain_damage)\n            self.cleanup(\'伤害日志恢复\',self.damage_sink.close);self.damage_sink=None\n        if self.battle:\n            self.cleanup(\'操作日志保存\',lambda:self.battle.actions(self.control))\n            self.cleanup(\'对局日志关闭\',self.battle.close);self.battle=None\n        if self.wall_service:\n            self.cleanup(\'墙体进程停止\',self.wall_service.close);self.wall_service=None\n        # A pending native bind still needs this reader for readback. Do not\n        # detach and attach a new owner until the one restore is confirmed.\n        if self.reader and input_restored:\n            self.cleanup(\'游戏句柄关闭\',self.reader.close);self.reader=None\n        self.bsp=None;self.map_key=None;self.wall_cache={};self.weapon_cache={};self.manual_bsp=None\n        self.disconnect_pending=not input_restored or not magic_stopped or not bhop_stopped or not dodge_stopped\n        return not self.disconnect_pending\n    def handle_not_ready(self,ex):\n        self.cleanup(\'暂停 T 强制模式\',self.clear_force_fire_toggle)\n        self.cleanup(\'魔法子弹停用\',self.magic.close)\n        reason=str(ex)\n        if getattr(self,\'white_map\',None) and getattr(self.reader,\'session_state\',{}).get(\'signon\')!=6:\n            self.white_map.invalidate()\n        self.radar_observation_waiting=True\n        self.radar_delay_state=dict(phase=\'waiting\',allowed=False)\n        self.ally_policy=ally_decision(0)\n        hard_reconnect_markers=(\'客户端模块已变化\',\'显示采样模块已变化\',\'结构定位失败\',\'运行中数据不符\',\'运行中数据结构不符\',\n            \'运行中结构指令变化\',\'运行中特征变化\',\'运行中地址操作数被重定向\',\'特征目标越界\',\n            \'多处特征定位结果冲突\',\'无法定位 \',\'加载范围不符\',\'字段未验证\',\'地址尚未动态验证\')\n        if any(marker in reason for marker in hard_reconnect_markers):\n            # A live process can still have rebuilt client/engine modules. The\n            # old reader handle is not usable after that point; release it so\n            # the UI reconnect loop performs a fresh attach.\n            self.disconnect()\n            self.post(\'status\',\'检测到游戏模块重载，正在自动重新连接\')\n            return\n        if self.reader and (not self.reader.mem or not self.reader.mem.alive()):\n            self.cleanup(\'退出前运行状态\',lambda:self.observe_runtime(waiting_reason=\'process_exited: \'+str(ex)))\n            self.disconnect();self.post(\'status\',\'游戏进程已退出，保留设置并等待重新检测\');return\n        self.connection_transition(\'waiting\',reason)\n        self.cleanup(\'等待运行状态\',lambda:self.observe_runtime(waiting_reason=reason))\n        # A lobby, map transition or network disconnect is not feature failure.\n        # Keep the process, capability probes, GUI settings and services alive.\n        self.frame=None;self.target=0;self.control.reason=reason;self.dodge_plan=None\n        self.control_status=\'功能开关保留 · \'+reason\n        # A network/map wait alone does not require an extra hotkey cycle.\n        # Focus/menu transitions still use the existing input rearming rule.\n        if self.reader:\n            try:\n                if not self.win.foreground(self.reader.mem.pid) or self.reader.game_ui_visible():self.control.input_armed=False\n            except (RuntimeError,OSError):self.control.input_armed=False\n        if not self.attached_waiting:\n            self.attached_waiting=True\n            self.waiting_cleanup={\'ANTI AIM 等待角色\':lambda:self.anti_aim.pause(\'ANTI AIM：已启用，等待角色\'),\n                \'释放旧瞄准按键\':self.control.release,\n                \'暂停原生右键保留\':self.trigger.pause_aim}\n            self.waiting_cleanup_at=0.\n        self.drain_waiting_controls()\n        self.attached_services()\n        if self.battle and self.reader:\n            def observe():\n                observation=self.reader.local_health_observation()\n                if observation:\n                    local,map_name,stamp,dead=observation\n                    self.battle.observe_health(local,map_name,stamp,self.control.diagnostic,reason,self.control.pressed,dead)\n            self.cleanup(\'等待对局时采样日志\',observe)\n            self.cleanup(\'等待对局时操作日志\',lambda:self.battle.actions(self.control))\n            def unready():\n                signon=self.reader.mem.i32(self.reader.global_addr(\'signon\')) if self.reader.mem and self.reader.mem.alive() else 0\n                self.battle.unready(reason,signon)\n            self.cleanup(\'等待对局时汇总日志\',unready)\n        msg=(\'已连接游戏进程 · 功能开关保留 · \'+reason) if self.reader else reason\n        if msg!=self.status:self.post(\'status\',msg);self.status=msg\n    def recover_runtime_fault(self,ex):\n        # An unrelated control/diagnostic failure is not permission to tear\n        # down a healthy independent ESP. Pause inputs and keep display retries.\n        try:alive=bool(self.reader and self.reader.mem and self.reader.mem.alive())\n        except Exception:alive=False\n        if alive:self.handle_not_ready(ex)\n        else:self.disconnect()\n    def pause_cycle_controls(self):\n        """Release owned input before every reconnect, not throughout its hold."""\n        self.magic.pause()\n        self.clear_force_fire_toggle()\n        self.control.input_armed=False;self.frame=None;self.target=0\n        actions=((\'循环释放瞄准开火\',self.control.release),\n                 (\'循环暂停右键辅助\',self.trigger.pause_aim),\n                 (\'循环释放闪避\',self.dodge.release),\n                 (\'循环暂停 ANTI AIM\',lambda:self.anti_aim.pause(\'循环重连中\')))\n        failed=[label for label,action in actions if not self.cleanup(label,action)]\n        self.dodge_plan=None\n        if failed:raise RuntimeError(\'重连前按键释放未完成：\'+\'、\'.join(failed))\n\n    def service_connection_cycle(self):\n        """Only command submission pauses frames; a connected hold remains usable."""\n        if not self.connection_cycle.active:return False\n        message=self.connection_cycle.poll()\n        if message:self.post(\'command_result\',message)\n        if not self.connection_cycle.active:\n            self.post(\'cycle_active\',False);return False\n        if self.connection_cycle.phase==\'holding\':return False\n        self.frame=None;self.target=0\n        self.attached_services()\n        self.cleanup(\'循环连接状态记录\',lambda:self.observe_runtime(\n            waiting_reason=\'循环连接命令提交中，暂时释放辅助按键\'))\n        return True\n\n    def begin_return_lobby(self,request=None,cycling=False):\n        if self.connection_cycle.active:raise RuntimeError(\'请先停止循环连接\')\n        if self.return_lobby.pending:raise RuntimeError(\'返回大厅请求正在处理，请勿重复点击\')\n        if not self.reader:raise NotReady(\'请先连接游戏\')\n        request=request or {};started=time.monotonic()\n        record_lobby_event(\'worker_received\',request_id=request.get(\'request_id\'),\n                           queue_ms=round((started-request.get(\'requested_at\',started))*1000,2))\n        # The dedicated probe still validates the live native entry and room state.\n        # Avoid rescanning every unrelated feature before an urgent exit request.\n        self.reader.require_feature(\'return_lobby\')\n        record_lobby_event(\'validated\',request_id=request.get(\'request_id\'),elapsed_ms=round((time.monotonic()-started)*1000,2))\n        # Restore controls while the old map is still valid, before cancellation.\n        self.magic.pause()\n        self.clear_force_fire_toggle()\n        self.control.input_armed=False;self.frame=None;self.target=0\n        actions=[(\'停止瞄准\',self.control.release),(\'暂停原生右键保留\',self.trigger.pause_aim),\n                 (\'雷达 UI 恢复\',self.native_radar.close),\n                 (\'ANTI AIM 恢复\',self.anti_aim.close),(\'闪避停止\',self.dodge.close),\n                 (\'本机控制恢复\',self.local_controls.close),(\'BOT SKIN 恢复\',self.bot_skins.close),\n                 (\'HP 恢复\',self.health_lock.close),(\'自动补人恢复\',self.bot_population.close),\n                 (\'本地主机同步恢复\',self.server_visibility.close)]\n        failed=[]\n        for label,action in actions:\n            began=time.monotonic();ok=self.cleanup(label,action)\n            if not ok:failed.append(label)\n            record_lobby_event(\'cleanup\',request_id=request.get(\'request_id\'),label=label,ok=ok,\n                               elapsed_ms=round((time.monotonic()-began)*1000,2))\n        self.dodge_plan=None\n        if failed:raise RuntimeError(\'辅助控制未完全停止，暂未退出地图：\'+\'、\'.join(failed))\n        if cycling:\n            self.return_lobby.close()\n            self.post(\'command_result\',self.connection_cycle.request(self.reader,request_id=request.get(\'request_id\')))\n            self.post(\'cycle_target\',self.connection_cycle.target)\n            self.post(\'cycle_active\',True)\n        else:\n            self.post(\'command_result\',self.return_lobby.request(self.reader,request_id=request.get(\'request_id\')))\n            self.post(\'lobby_busy\',True)\n        self.publish_capabilities({})\n    def handle_ui_command(self,cmd,arg):\n        kind=\'skin_result\' if cmd.startswith(\'skin_\') else \'command_result\'\n        try:\n            if cmd==\'return_lobby\':self.begin_return_lobby(arg)\n            elif cmd==\'connection_cycle\':\n                if (arg or {}).get(\'enabled\'):self.begin_return_lobby(arg,cycling=True)\n                else:\n                    self.connection_cycle.close();self.post(\'cycle_active\',False)\n                    self.post(\'command_result\',\'循环连接已停止；已排入游戏队列的单条命令仍可能执行\')\n            elif cmd==\'cursor_raw_input\':\n                # Reuse the existing native command path so center confinement\n                # does not suppress normal mouse-look in legacy input mode.\n                reader=self.reader\n                if reader is not arg or not reader or not reader.mem:return\n                if not self.win.foreground(reader.mem.pid) or reader.game_ui_visible():return\n                if not raw_mouse_input_enabled(reader):\n                    self.local_controls.camera.bind(reader,validate_camera=False)\n                    self.local_controls.camera.enqueue(\'m_rawinput 1\')\n            elif cmd==\'diagnostics\':\n                report=self.reader.diagnostics() if self.reader else getattr(self,\'last_connection_diagnostics\',{\'status\':\'未连接\',\'live_verified\':False})\n                path=HERE/\'diagnostics.json\';path.write_text(json.dumps(report,ensure_ascii=False,indent=2),encoding=\'utf-8\')\n                self.post(kind,f\'诊断已保存：{path.name}\')\n            elif cmd==\'summary\':\n                if self.battle:self.battle.summarize();self.post(kind,\'当前对局汇总已保存到 logs 文件夹\')\n                else:self.post(kind,\'当前没有对局日志；连接游戏并进入对局后自动记录\')\n            elif cmd==\'map\':\n                if not self.frame:raise NotReady(\'请在进入地图后选择对应 BSP\')\n                if Path(arg).stem.lower()!=Path(self.frame.map_name).stem.lower():raise NotReady(\'选择的 BSP 名称与当前地图不一致\')\n                if not Path(arg).is_file():raise NotReady(\'所选 BSP 文件不存在，请重新选择\')\n                self.manual_bsp=Path(arg);self.map_key=None;self.post(kind,\'已选择地图：\'+Path(arg).name)\n            elif cmd==\'skin_clear\':\n                self.bot_skins.close();self.post(kind,\'BOT SKIN：已取消指定；下次出生恢复原配置\')\n            elif cmd in (\'skin_roster\',\'skin_apply\'):\n                if not self.reader or not self.frame:raise NotReady(\'先连接游戏并进入本地对局，再刷新 BOT 列表\')\n                self.reader.require_feature(\'bot_skin\')\n                if cmd==\'skin_roster\':self.post(\'skin_roster\',self.bot_skins.snapshot(self.reader,self.frame))\n                else:self.post(kind,self.bot_skins.apply(self.reader,self.frame,arg))\n            else:self.post(kind,\'未识别的界面操作：\'+str(cmd))\n        except Exception as ex:\n            self.post(kind,\'操作未完成：\'+str(ex))\n            if cmd==\'connection_cycle\':self.post(\'cycle_active\',self.connection_cycle.active)\n            if cmd==\'return_lobby\':\n                record_lobby_event(\'failed\',request_id=(arg or {}).get(\'request_id\'),reason=str(ex))\n                self.post(\'lobby_busy\',self.return_lobby.pending)\n    def run(self):\n        while not self.shutdown.is_set():\n            began=time.monotonic()\n            try:\n                if self.disconnect_pending and not self.disconnect():\n                    self.shutdown.wait(.025);continue\n                while True:\n                    try:cmd,arg=self.commands.get_nowait()\n                    except queue.Empty:break\n                    if cmd==\'attach\':\n                        if not self.disconnect():\n                            self.commands.put((cmd,arg));break\n                        self.game=Path(arg);reader=ClientControlReader(self.game)\n                        try:reader.attach()\n                        except Exception as ex:\n                            self.last_connection_diagnostics={\'time\':time.strftime(\'%Y-%m-%d %H:%M:%S\'),\n                                \'status\':str(ex),\'live_verified\':False,\'compatibility\':reader.compatibility}\n                            self.cleanup(\'连接诊断保存\',lambda:(HERE/\'connection_diagnostics.json\').write_text(\n                                json.dumps(self.last_connection_diagnostics,ensure_ascii=False,indent=2),encoding=\'utf-8\'))\n                            self.cleanup(\'连接句柄关闭\',reader.close)\n                            self.post(\'attach_done\',{\'ok\':False,\'status\':str(ex)})\n                            if isinstance(ex,(NotReady,MemoryError,OSError)):raise NotReady(str(ex)) from ex\n                            raise\n                        self.reader=reader;self.game=reader.game;self.enabled=True;self.post(\'game_detected\',str(self.game));self.post(\'status\',reader.status)\n                        self.start_bhop()\n                        self.aim_service.start(self.game,self.reader.mem.pid)\n                        self.dodge.start(self.game,self.reader.mem.pid)\n                        if self.weapon_catalog is None or self.weapon_catalog.root!=self.game:\n                            self.weapon_catalog=WeaponCatalog(self.game)\n                        self.overlay_retry_at=0.;self.last_overlay_submit=0;self.overlay_error=\'\';self.ensure_overlay()\n                        self.battle=self.optional_service(\'对局日志\',lambda:BattleLog(HERE/\'logs\',resolve_local_names(self.game,BUNDLE_ENTRY)));self.log_retry=0\n                        self.memory_monitor=self.optional_service(\'内存监测\',lambda:MemoryMonitor(reader.mem.pid,self.battle)) if self.battle else None\n                        self.post(\'attach_done\',{\'ok\':True,\'status\':reader.status})\n                    else:self.handle_ui_command(cmd,arg)\n                if self.service_connection_cycle():\n                    self.shutdown.wait(.025);continue\n                if self.return_lobby.pending or self.return_lobby.watch_until:\n                    message=self.return_lobby.poll()\n                    if message:self.post(\'command_result\',message)\n                    if message:self.post(\'lobby_busy\',self.return_lobby.pending)\n                    if self.return_lobby.pending:\n                        self.frame=None;self.target=0\n                        self.cleanup(\'返回房间状态记录\',lambda:self.observe_runtime(waiting_reason=\'返回房间请求等待游戏确认\'))\n                        self.shutdown.wait(.025);continue\n                if self.enabled and self.reader:\n                    stages={};stage_start=time.perf_counter()\n                    self.control.service_fire_release(self.reader,self.frame)\n                    self.ensure_overlay()\n                    self.companion_status=self.companion.step(self.reader)\n                    caps=self.reader.refresh_capabilities();self.publish_capabilities(caps);cfg=effective_config(self.cfg,caps)\n                    ui_paused=self.ui_pause.is_set()\n                    if ui_paused:\n                        cfg=replace(cfg,aim=False,fire=False,tab_force_fire=False,recoil=False,bhop=False,thirdperson_key=False,grenade_dodge=False,anti_aim=False)\n                    self._aim_effective_cfg=cfg\n                    stages[\'pre_sample\']=(time.perf_counter()-stage_start)*1000;stage_start=time.perf_counter()\n                    f=self.reader.frame(cfg.mode,cfg.enemy_team,cfg.esp_grenades,include_allies=False)\n                    stages[\'client_sample\']=(time.perf_counter()-stage_start)*1000;stage_start=time.perf_counter()\n                    self.control.service_fire_release(self.reader,f)\n                    self.ally_policy=ally_decision(f.native_mode_id)\n                    cfg=auto_ally_config(f,cfg)\n                    self.resume_frame_controls()\n                    # Input ownership and T toggling live entirely in the child.\n                    self.aim_service.resume()\n                    self.dodge.start(self.game,self.reader.mem.pid)\n                    self.dodge.resume()\n                    self.publish_capabilities(caps)\n                    self.health_status=self.feature_call((\'lock_hp\',\'lock_hp_once\'),lambda:self.health_lock.step(self.reader,f,cfg.lock_hp,cfg.locked_hp,cfg.lock_hp_once),self.health_lock.close)\n                    self.update_native_radar(f,cfg,caps)\n                    if caps.get(\'bot_skin\',{}).get(\'available\'):self.feature_call((\'bot_skin\',),lambda:self.bot_skins.step(self.reader,f),self.bot_skins.close)\n                    elif self.bot_skins.reader:self.cleanup(\'BOT SKIN 停止\',self.bot_skins.close)\n                    sync_status=self.feature_call((\'fullmap_sync\',),lambda:self.server_visibility.step(self.reader,cfg.fullmap_sync),self.server_visibility.close)\n                    if sync_status!=self.visibility_status:\n                        self.visibility_status=sync_status;self.post(\'status\',sync_status)\n                        if self.battle:self.battle.event(\'visibility_sync\',status=sync_status)\n                    if self.battle and not self.damage_sink and began>=self.log_retry:\n                        self.log_retry=began+30\n                        try:\n                            self.reader.mods.update(modules(self.reader.mem.pid))\n                            self.damage_sink=GameLogSink(self.reader);self.battle.sink_available=True;self.battle.sink_error=\'\'\n                            self.battle.native_hurt_authoritative=True\n                        except Exception as ex:self.battle.sink_error=str(ex)\n                    if self.weapon_catalog is None or self.weapon_catalog.root!=self.game:\n                        self.w