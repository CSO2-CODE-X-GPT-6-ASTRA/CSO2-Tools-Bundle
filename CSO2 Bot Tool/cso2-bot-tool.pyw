_EMBEDDED['aim_audit'] = (1, '"""Streaming aim-log analysis; missing damage feedback is never counted as a miss."""\n\nimport collections,json,math,os\n\nfrom pathlib import Path\n\n\n\ndef analyze_folder(folder):\n\n    folder=Path(folder);folder.mkdir(parents=True,exist_ok=True)\n\n    counts=collections.Counter();reasons=collections.Counter();parts=collections.Counter();weapons={};scenarios={}\n\n    heads=collections.deque(maxlen=30);files=0;invalid=0;rounds=0;damage=0;head_damage=0;kills=0;head_kills=0\n\n    paths=collections.Counter();faults=collections.Counter();waits=collections.Counter()\n\n    latency={key:collections.deque(maxlen=10000) for key in (\'acquire_to_fire_ms\',\'first_eligible_wait_ms\',\'control_ms\')}\n\n    compact_summaries=[]; compact_ids=set(); skipped_detail_files=0\n    for summary_path in sorted(folder.glob(\'*.summary.json\')):\n        try:\n            summary=json.loads(summary_path.read_text(encoding=\'utf-8\'))\n            if summary.get(\'log_schema\',0)>=11 and summary.get(\'logging\',{}).get(\'profile\')==\'compact54\':\n                compact_summaries.append(summary);compact_ids.add(summary[\'id\'])\n        except (OSError,ValueError,KeyError,TypeError):continue\n    for path in sorted(folder.glob(\'*.jsonl\')):\n        if path.stem.split(\'.part\',1)[0] in compact_ids:\n            skipped_detail_files+=1;continue\n\n        files+=1\n\n        with path.open(encoding=\'utf-8\',errors=\'replace\') as fp:\n\n            for line in fp:\n\n                try:row=json.loads(line)\n\n                except ValueError:invalid+=1;continue\n\n                if not isinstance(row,dict):invalid+=1;continue\n\n                kind=row.get(\'kind\',\'unknown\');counts[kind]+=1\n\n                if kind==\'ammo_decreased\':\n\n                    n=max(0,int(row.get(\'rounds\',0)));rounds+=n\n\n                    weapon=weapons.setdefault(row.get(\'weapon\',\'unknown\'),dict(observed_rounds=0))\n\n                    weapon[\'observed_rounds\']+=n\n\n                elif kind==\'confirmed_damage\':damage+=1;head_damage+=bool(row.get(\'head\'))\n\n                elif kind==\'confirmed_kill\':kills+=1;head_kills+=bool(row.get(\'head\'))\n\n                elif kind==\'input_action\':\n\n                    if row.get(\'action\')==\'fire_down\':\n\n                        c=row.get(\'aim_context\') or {};paths[c.get(\'shot_path\',\'unknown\')]+=1\n\n                        for key,values in latency.items():\n\n                            value=c.get(key)\n\n                            if isinstance(value,(int,float)) and math.isfinite(value) and value>=0:values.append(value)\n\n                    elif row.get(\'action\')==\'fire_unconfirmed\':faults[\'trigger_without_ammo_change\']+=1\n\n                elif kind==\'aim_sample\':\n\n                    c=row.get(\'context\',{});reasons[row.get(\'reason\',\'\')]+=1;parts[c.get(\'aim_part\',\'unknown\')]+=1\n\n                    if c.get(\'control_budget_exceeded\'):faults[\'control_over_12ms\']+=1\n\n                    if c.get(\'write_readback_verified\') is False:faults[\'readback_not_verified\']+=1\n\n                    if c.get(\'within_weapon_range\') is False:faults[\'out_of_range\']+=1\n\n                    if c.get(\'fire_wait_reason\'):waits[c[\'fire_wait_reason\']]+=1\n\n                    if c.get(\'penetration\',{}).get(\'kind\')==\'penetration\' and not c.get(\'fire_allowed\'):faults[\'penetration_candidate_not_firing\']+=1\n\n                    value=c.get(\'first_eligible_wait_ms\')\n\n                    if isinstance(value,(int,float)) and value>16 and not c.get(\'first_shot_requested\') and not c.get(\'fire_wait_reason\'):\n\n                        faults[\'eligible_but_no_first_shot_over_16ms\']+=1\n\n                    distance=c.get(\'target_distance\',c.get(\'horizontal_distance\'))\n\n                    bucket=\'distance_unknown\' if not isinstance(distance,(int,float)) else \'close_0_192\' if distance<=192 else \'medium_192_512\' if distance<=512 else \'far_512_plus\'\n\n                    item=scenarios.setdefault(bucket,dict(samples=0,fire_allowed_samples=0,hostage_blocked_samples=0,head_samples=0,angular_error_sum=0.,angular_error_samples=0))\n\n                    item[\'samples\']+=1;item[\'fire_allowed_samples\']+=bool(c.get(\'fire_allowed\'))\n\n                    item[\'head_samples\']+=c.get(\'aim_part\')==\'head\'\n\n                    item[\'hostage_blocked_samples\']+=c.get(\'hostage_ray_safe\') is False\n\n                    error=c.get(\'write_readback_error_deg\')\n\n                    if isinstance(error,(int,float)) and math.isfinite(error):item[\'angular_error_sum\']+=error;item[\'angular_error_samples\']+=1\n\n                    if c.get(\'model_head\'):\n\n                        heads.append(dict(time=row.get(\'time\'),target=c.get(\'target\'),model=c.get(\'model\'),head=c[\'model_head\'],\n\n                                          aim_point=c.get(\'aim_point\'),part=c.get(\'aim_part\'),eye=c.get(\'eye\'),\n\n                                          selected_pose_age_ms=c.get(\'selected_pose_age_ms\'),reason=row.get(\'reason\')))\n\n    compact_timing={key:[] for key in latency}; compact_fault_frames=collections.Counter()\n    compact_decisions=collections.Counter(); compact_waits=collections.Counter()\n    compact_events=collections.Counter(); compact_sampled=collections.Counter(); compact_budgeted=collections.Counter()\n    compact_loss_by_logger={}\n    for summary in compact_summaries:\n        log=summary[\'logging\']; decision=summary.get(\'decision_totals\',{})\n        rounds+=summary.get(\'observed_rounds\',0)\n        damage+=summary.get(\'confirmed_damage_events\',0);head_damage+=summary.get(\'confirmed_head_damage_events\',0)\n        kills+=summary.get(\'confirmed_kills\',0);head_kills+=summary.get(\'confirmed_headshot_kills\',0)\n        compact_events.update(log.get(\'event_observations\',{}));compact_sampled.update(log.get