_EMBEDDED['aim_weapon_input_guard'] = ('2026.10.07-aim-private-reader-evidence', '"""Read-only, identity-coherent active-weapon snapshots for synthetic fire."""\nimport time,struct\n\n\ndef read_weapon_state(reader, local_address, *, include_reserve=False):\n    m=reader.mem;now=time.monotonic()\n    result=dict(valid=False,local_address=local_address,handle=0xffffffff,address=0,\n                classname=\'\',ammo=-1,stamp=now,reason=\'weapon_unavailable\',\n                ammo_basis=\'clip\',reserve_ammo=None,reserve_status=\'not_sampled\',ammo_type=None)\n    if not reader.fields_available(\'m_hActiveWeapon\',\'m_iClip1\'):\n        result[\'reason\']=\'weapon_fields_unverified\';return result\n    from aim_reader import MemoryError\n    try:\n        handle=m.u32(local_address+0xf0c)\n        address=reader.handle_entity(handle)\n        if not address:return result\n        classname=reader.classname(address)\n        ammo=m.i32(address+0xa30)\n        # Optional telemetry only; the final fire guard keeps its small read set.\n        # These fields and the 40 x uint16 array layout are verified by Reader.\n        if include_reserve:\n            result[\'reserve_status\']=\'fields_unverified\'\n            if reader.fields_available(\'m_iPrimaryAmmoType\',\'m_iAmmo\'):\n                try:\n                    ammo_type=m.i32(address+0xa20)\n                    if 0<=ammo_type<40:\n                        reserve=struct.unpack(\'<H\',m.read(local_address+0xdfc+ammo_type*2,2))[0]\n                        result.update(ammo_type=ammo_type,reserve_raw=reserve)\n                        if reserve<10000:result.update(reserve_ammo=reserve,reserve_status=\'verified_fields\')\n                        else:result[\'reserve_status\']=\'value_out_of_range\'\n                    else:result[\'reserve_status\']=\'ammo_type_out_of_range\'\n                except (MemoryError,OSError,ValueError,struct.error) as ex:\n                    result[\'reserve_status\']=\'read_error\';result[\'reserve_error\']=str(ex)\n        if (m.u32(local_address+0xf0c)!=handle or reader.handle_entity(handle)!=address):\n            result.update(reserve_ammo=None,reserve_status=\'identity_changed\')\n            result[\'reason\']=\'active_weapon_changed_during_read\';return result\n        if not -1<=ammo<10000:\n            result[\'reason\']=\'invalid_clip\';return result\n        result.update(valid=True,handle=handle,address=address,classname=classname,ammo=ammo,reason=\'\')\n    except (MemoryError,OSError,ValueError) as ex:\n        result[\'reason\']=type(ex).__name__+\': \'+str(ex)\n    return result\n\n\ndef weapon_key(state):\n    return tuple(state.get(k) for k in (\'local_address\',\'handle\',\'address\',\'classname\'))\n\n\ndef check_fire_weapon(reader, expected, now=None):\n    now=time.monotonic() if now is None else now\n    if not expected or not expected.get(\'valid\'):\n        return dict(allowed=False,reason=\'unverified_weapon_snapshot\')\n    if not 0<=now-expected[\'stamp\']<=.15:\n        return dict(allowed=False,reason=\'expired_weapon_snapshot\')\n    m=reader.mem;local=expected[\'local_address\']\n    if (m.i32(reader.global_addr(\'signon\'))!=6 or m.u32(reader.global_addr(\'local_player\'))!=local\n            or m.read(local+0x97,1)!=b\'\\0\' or m.i32(local+0x98)<=0):\n        return dict(allowed=False,reason=\'local_identity_or_life_changed\')\n    current=read_weapon_state(reader,local)\n    reason=(\'weapon_read_unverified\' if not current[\'valid\'] else\n            \'active_weapon_changed\' if weapon_key(current)!=weapon_key(expected) else\n            \'empty_clip\' if current[\'ammo\']<=0 else \'\')\n    return dict(allowed=not reason,reason=reason,expected=dict(expected),current=current)\n')
_EMBEDDED['dodge_enemy_policy'] = ('2026.10.07-aim-private-reader-evidence', '"""Horizontal escape directions must not reduce distance to a sampled enemy."""\nimport math\n\n\ndef away_from_enemies(origin, direction, enemies):\n    try:\n        if len(origin) != 3 or len(direction) != 3:\n            return False\n        if not all(math.isfinite(v) for v in (*origin, *direction)):\n            return False\n        norm = math.hypot(*direction[:2])\n        if norm < .5:\n            return False\n        for enemy in enemies:\n            point = enemy[\'origin\']\n            if len(point) != 3 or not all(math.isfinite(v) for v in point):\n                return False\n            dx, dy = point[0]-origin[0], point[1]-origin[1]\n            distance = math.hypot(dx, dy)\n            if distance < 1e-6:\n                return False\n            # Normalize the tolerance so remote enemies cannot amplify roundoff.\n            if (dx*direction[0]+dy*direction[1])/(distance*norm) > 1e-9:\n                return False\n        return True\n    except (KeyError, TypeError, ValueError, OverflowError):\n        return False\n')

