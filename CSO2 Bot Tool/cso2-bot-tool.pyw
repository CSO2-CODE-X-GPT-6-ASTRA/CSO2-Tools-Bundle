_EMBEDDED['aim_pose_evidence'] = ('2026.10.07-aim-private-reader-evidence', '"""Observe repeated native matrices without inventing an engine pose timestamp."""\nimport math\n\n\nclass PoseEvidence:\n    def __init__(self):\n        self.rows = {}\n\n    def observe(self, actor, scope):\n        evidence = dict(actor.pose_cache_evidence)\n        stamp = evidence.get(\'matrix_read_finished\')\n        if not isinstance(stamp, (float, int)) or not math.isfinite(stamp):\n            return evidence\n        key = (*scope, actor.index, actor.address, actor.serial, actor.model,\n               evidence.get(\'cache_address\'))\n        previous = self.rows.get(key)\n        same = bool(previous and stamp >= previous[\'stamp\'] and\n                    evidence.get(\'digest\') == previous[\'digest\'])\n        first = previous[\'first\'] if same else stamp\n        origin = previous[\'origin\'] if same else tuple(actor.origin)\n        evidence.update(matrix_same_as_previous=same,\n            matrix_unchanged_observed_ms=(stamp-first)*1000.,\n            origin_shift_during_unchanged_units=math.dist(origin, actor.origin),\n            observation_gap_ms=(stamp-previous[\'stamp\'])*1000. if previous and stamp >= previous[\'stamp\'] else None,\n            engine_pose_age_known=False, sampled_origin=tuple(actor.origin),\n            basis=\'software_observation_of_native_cache; not_engine_pose_age\')\n        if len(self.rows) >= 256 and key not in self.rows:\n            self.rows.clear()\n        self.rows[key] = dict(digest=evidence.get(\'digest\'), stamp=stamp,\n                              first=first, origin=origin)\n        return evidence\n')
_EMBEDDED['aim_priority'] = ('2026.10.07-aim-private-reader-evidence', '\n\n"""Shared proximity policy for candidate selection and wall-query scheduling."""\n\nimport math\nfrom geometry import aim_angles,angle_error,dot,length,sub,view_direction,wrap\n\n\n\nNEAR_FIRST=\'近身优先\'\n\nCOMPREHENSIVE=\'综合威胁\'\n\nTHREAT_HELP=\'普通瞄准与 T 强制模式统一：当前准星射线穿过多个敌人时先打近敌；旁边的近敌不抢占，转动准星可重新选敌。可见与可穿透目标都适用。\'\n\nDEFAULT_HOLD_DEG=0.5\nDEFAULT_SWITCH_MARGIN_DEG=0.5\n\n\ndef ray_nearest_key(frame,target,*,index=None):\n    """Current crosshair intersections first, near-to-far on that same ray.\n\n    Outside the ray, angular proximity owns acquisition. World distance alone\n    never makes a lateral enemy steal the player\'s crosshair selection.\n    Current native OBBs are authoritative; measured point radii are a fallback\n    when the reader has no OBBs (never the actor\'s broad collision bounds).\n    """\n    identity=index if index is not None else getattr(target,\'index\',0)\n    invalid=(2,float(\'inf\'),float(\'inf\'),identity)\n    try:\n        point=tuple(target.head);eye=tuple(frame.eye)\n        if len(point)!=3 or len(eye)!=3:return invalid\n        delta=sub(point,eye);direction=view_direction(frame.angles)\n        if not all(math.isfinite(v) for v in (*delta,*direction)):return invalid\n        forward=dot(delta,direction)\n        if forward<=0:return invalid\n        player_distance=length(sub(target.origin,frame.local.origin))\n        if not math.isfinite(player_distance):return invalid\n        boxes=getattr(target,\'aim_hitboxes\',())\n        if boxes:\n            hit=any(box.intersection(eye,tuple(v*1e8 for v in direction)) is not None for box in boxes)\n        else:\n            try:\n                from aim_geometry import candidate_points\n                samples=candidate_points(target)\n            except (AttributeError,TypeError):\n                # Lightweight telemetry objects used by diagnostics may only\n                # carry a head.  The native reader supplies full aim_points.\n                samples=()\n            if not samples and not getattr(target,\'aim_points_validated\',False):\n                samples=(type(\'RayPoint\',(),{\n                    \'position\':point,\n                    \'radius\':getattr(target,\'head_radius\',2.5) or 2.5,\n                })(),)\n            hit=False\n            for sample in samples:\n                offset=sub(sample.position,eye);along=dot(offset,direction)\n                radius=float(sample.radius)\n                if along<=0 or not math.isfinite(radius) or radius<=0:continue\n                perpendicular=length(tuple(offset[i]-along*direction[i] for i in range(3)))\n                if perpendicular<=radius:hit=True;break\n        error=angle_error(frame.angles,aim_angles(eye,point))\n        return (0,player_distance,forward,identity) if hit else (1,error,player_distance,identity)\n    except (AttributeError,TypeError,ValueError,OverflowError,IndexError):\n        return invalid\n\ndef choose_visible(ranked,previous,strategy,allow_penetration=True,*,distance_first=False):\n    from aim_decision import selection_tier as path_tier\n    if not ranked:\n        return None\n    # In the default crosshair policy, a locally direct ray is a hard\n    # foreground set.  Wallbang/penetration candidates are never allowed to\n    # replace a target the local ray can already reach, even when their raw\n    # angular score is smaller due to stale pose data.\n    if strategy not in (COMPREHENSIVE, NEAR_FIRST):\n        direct=[row for row in ranked\n                if path_tier(row[1].visibility,row[1].penetration,allow_penetration)==0]\n        if direct:\n            ranked=direct\n    tiers=[path_tier(row[1].visibility,row[1].penetration,allow_penetration) for row in ranked]\n    best_tier=min(tiers)\n    pool=[row for row,tier in zip(ranked,tiers) if tier==best_tier]\n    if distance_first and best_tier in (1,2):\n        current=next((row for row in pool if row[1].index==previous),None)\n        if current is not None:return current\n    # Firearm direct candidates remain in the foreground visibility class, but\n    # crosshair-nearest must follow the current view. Penetration stays in a\n    # separate lower-priority class.\n    if distance_first and best_tier==0 and strategy==\'准星最近\':\n        # Admission is owned by Controller; do not impose a second hidden\n        # cone on screen-search mode. Keep only a small angular hysteresis\n        # band for consecutive-frame jitter.\n        def crosshair_error(row):\n            value=row[2][2] if len(row)>2 and row[2] is not None else None\n            return value if type(value) in (int,float) and math.isfinite(value) else float(\'inf\')\n        best=min(pool,key=lambda row:(crosshair_error(row),row[1].index!=previous,row[1].index))\n        current=next((row for row in pool if row[1].index==previous),None)\n        if current is None or current is best:return best\n        # Hysteresis is only for a near tie; a materially closer target wins.\n        if crosshair_error(current) <= crosshair_error(best)+DEFAULT_SWITCH_MARGIN_DEG:\n            return current\n        return best\n    # Explicit crosshair policy: only a distance tie may retain the incumbent.\n    # A remembered live target, contact threat or exit hint cannot override\n    # the player\'s current crosshair. Visibility tiers remain the first gate.\n    if strategy==\'准星最近\':\n        return min(pool,key=lambda row:(row[2][2],row[1].index!=previous,row[1].index))\n    # A living direct target owns continuity across all weapons/strategies.\n    # Exit urgency, crosshair scores and incomplete damage do not displace it.\n    current=next((row for row in pool if row[1].index==previous),None)\n    if best_tier==0 and current is not None:return current\n    # Survival exception to crosshair ordering, only inside the already best\n    # direct/reachable class. Unknown or penetrated near targets never displace\n    # a visible far target. Screen/cone admission remains the controller\'s job.\n    # Only fresh, directly exposed rivals can carry an exit hint. A hidden\n    # doorway, penetration path or unknown ray receives no pre-aim preference.\n    from exit_exposure import choose_exit\n    exit_choice=choose_exit(pool,previous) if best_tier==0 else None\n    if exit_choice is not None:return exit_choice\n    if strategy==COMPREHENSIVE:return choose_comprehensive(pool,previous)\n    if strategy==NEAR_FIRST:return choose_near_first(pool,previous)\n    # Default mode is crosshair-first only after the local shot path gate.\n    # A direct local ray is the highest class; reciprocal visibility is kept\n    # as telemetry only and never changes admission or selection.\n    def default_key(row):\n        info=row[3] or {}\n        return (row[2][2], row[1].index!=previous, row[1].index)\n    best=min(pool,key=default_key)\n    current=next((row for row in pool if row[1].index==previous),None)\n    if current is None:return best\n    current_tier=path_tier(current[1].visibility,current[1].penetration,allow_penetration)\n    best_tier=path_tier(best[1].visibility,best[1].penetration,allow_penetration)\n    current_error=float(current[2][2]);best_error=float(best[2][2])\n    if current_tier==0 and best_tier==0 and best[1].index!=current[1].index:\n        if current_error<=DEFAULT_HOLD_DEG:return current\n        if best_error+DEFAULT_SWITCH_MARGIN_DEG>=current_error:return current\n    return best\n\n\n\n\n\ndef survival_rank(info,retain=False):\n    """Contact <=128u; near <=192u or observed fast closing; otherwise precise."""\n    info=info or {}\n    distance=info.get(\'distance\')\n    if not isinstance(distance,(int,float)) or not 0<=distance<1e8:return 2\n    # A small exit margin for the current identity avoids 127/129u flip-flops.\n    if distance<=(144. if retain else 128.):return 0\n    if distance<=(216. if retain else 192.) or (distance<=512. and info.get(\'rushing\') is True):return 1\n    return 2\n\n\ndef threat_info(frame,entity,mutual_visible=None):\n\n    delta=sub(entity.head,frame.eye);distance=length(delta)\n\n    velocity=entity.velocity;local_velocity=frame.local.velocity\n\n    closing=0.;approaching=0.\n\n    if velocity is not None and distance>0:\n\n        direction=tuple(v/distance for v in delta)\n\n        approaching=-sum(velocity[i]*direction[i] for i in range(3))\n\n        relative=sub(velocity,local_velocity or (0,0,0))\n\n        closing=-sum(relative[i]*direction[i] for i in range(3))\n\n    # Reciprocal visibility is telemetry only.  Selection priority is based\n    # on the local ray: a clear local path is always the highest visibility\n    # class, regardless of whether the other actor can see the local player.\n    reciprocal_sampled=mutual_visible is not None\n    if mutual_visible is None:\n        mutual_visible = False\n    reciprocal = bool(entity.visibility==\'visible\' and mutual_visible)\n    visibility_threat = 0 if entity.visibility==\'visible\' else 2\n\n    rush=distance<=512 and approaching>=100 and closing>=120 and distance/max(1,closing)<=1.5\n\n    tier=0 if distance<=192 or rush else (1 if distance<=512 else 2)\n\n    error=angle_error(frame.angles,aim_angles(frame.eye,entity.head))\n\n    rear=abs(wrap(aim_angles(frame.eye,entity.head)[1]-frame.angles[1]))>=95\n\n    throwing=0 if entity.grenade else 1 if entity.can_throw else 2\n\n    info=dict(tier=tier,distance=distance,closing_speed=closing,rushing=rush,rear=rear,error=error,\n                reciprocal_visible=reciprocal,reciprocal_sampled=reciprocal_sampled,visibility_threat=visibility_threat,\n                local_visibility_threat=visibility_threat,\n\n                throwable_rank=throwing,can_throw=entity.can_throw,holding_throwable=entity.grenade)\n    info[\'survival_rank\']=survival_rank(info)\n    info[\'engagement_policy\']=\'contact_survival\' if info[\'survival_rank\']==0 else \'near_survival\' if info[\'survival_rank\']==1 else \'precise_crosshair\'\n    return info\n\n\n\n\n\ndef priority_key(info):\n\n    return (info[\'tier\'],info[\'distance\'],0) if info[\'tier\']<2 else (2,info[\'throwable_rank\'],info[\'error\'])\n\n\n\n\n\ndef comprehensive_key(info):\n\n    if info[\'tier\']<2:return (info[\'tier\'],0,info[\'distance\'])\n\n    if info[\'throwable_rank\']<2:return (2,info[\'throwable_rank\'],info[\'error\'])\n\n    return (3,0,info[\'error\'])\n\n\n\n\n\ndef choose_comprehensive(ranked,previous):\n\n    best=min(ranked,key=lambda row:(*comprehensive_key(row[3]),row[1].index))\n\n    current=next((row for row in ranked if row[1].index==previous),None)\n\n    if current is None:return best\n\n    a,b=comprehensive_key(best[3]),comprehensive_key(current[3])\n\n    if a[:2]<b[:2]:return best\n\n    margin=max(16.,b[2]*.08) if a[0]<2 else .75\n\n    return best if a[:2]==b[:2] and a[2]+margin<b[2] else current\n\n\n\n\n\ndef choose_near_first(ranked,previous):\n\n    best=min(ranked,key=lambda row:(*priority_key(row[3]),row[1].index))\n\n    current=next((row for row in ranked if row[1].index==previous),None)\n\n    if current is None:return best\n\n    a,b=best[3],current[3]\n\n    if a[\'tier\']<b[\'tier\']:return best\n\n    # Similar threats retain continuity; a materially closer enemy preempts.\n\n    if a[\'tier\']==b[\'tier\']:\n\n        if a[\'tier\']==2 and a[\'throwable_rank\']<b[\'throwable_rank\']:return best\n\n        margin=max(24,b[\'distance\']*.12) if a[\'tier\']<2 else 3.\n\n        if a[\'tier\']<2 and a[\'distance\']+margin<b[\'distance\']:return best\n\n        if a[\'tier\']==2 and a[\'throwable_rank\']==b[\'throwable_rank\'] and a[\'error\']+margin<b[\'error\']:return best\n\n    return current\n\n\n\n\n\ndef response_smoothing(configured,info):\n\n    if info[\'tier\']==0:return 1.\n\n    if info[\'tier\']==1:return min(float(configured),1+(info[\'distance\']-192)/320)\n\n    return configured\n')
_EMBEDDED['aim_reader'] = ('2026.10.07-aim-private-reader-evidence', '\n"""External reader with live address/field discovery. No injection or DLL patching."""\nfrom __future__ import annotations\nimport ctypes as C\nfrom ctypes import wintypes as W\nfrom dataclasses import dataclass,field,replace\nimport hashlib,json,struct,time,os,re,math\nfrom pathlib import Path\nfrom geometry import finite,add,length,sub\nfrom scale_geometry import (client_scale,client_scale_info,radius as scaled_radius,\n                            eye_offset_valid,point_valid,matrix_valid,\n                            visual_scale_factor,visual_matrix)\nfrom target_rules import entity_kind,is_enemy,choose_head,FFA_MODE\nfrom menu_state import MenuState\nfrom aim_geometry import (ProtectedEntity,protect_hostages,sample_definitions,world_samples,\n                        world_hitboxes,filter_hostage_aim_points,hitbox_envelope,bounded_hostage_envelope,\n                        hostage_is_nearby)\nfrom runtime_compat import CompatibilityError,choose_candidate,game_root,resolve_module,resolve_signature,connection_kind\nfrom native_mode import NativeMode\nfrom model_support import studio_header,validate_rig,adapt_hitboxes,UnsupportedModel\n\nHERE=Path(__file__).resolve().parent\nDEFAULT_GAME=next((p for p in (BUNDLE_ENTRY.parent/\'CSO2/cso2\',BUNDLE_ENTRY.parent/\'cso2\',BUNDLE_ENTRY.parent) if (p/\'Bin/client.dll\').is_file() and (p/\'Bin/engine.dll\').is_file()),BUNDLE_ENTRY.parent/\'CSO2/cso2\')\nclass NotReady(RuntimeError):pass\nclass MemoryError(RuntimeError):pass\n\nclass SnapshotError(MemoryError):\n    def __init__(self,pid,code):\n        self.pid=pid;self.winerror=code\n        reason={5:\'拒绝访问：工具与游戏的运行权限可能不同\',24:\'模块列表正在变化\',\n                299:\'模块暂时不可读或进程位数不同\',87:\'进程已退出或参数失效\'}.get(code,\'系统读取失败\')\n        super().__init__(f\'PID {pid} 模块/进程读取失败（Windows {code}：{reason}）\')\n\nclass PROCESSENTRY32W(C.Structure):\n    _fields_=[(\'dwSize\',W.DWORD),(\'cntUsage\',W.DWORD),(\'th32ProcessID\',W.DWORD),(\'th32DefaultHeapID\',C.c_size_t),(\'th32ModuleID\',W.DWORD),(\'cntThreads\',W.DWORD),(\'th32ParentProcessID\',W.DWORD),(\'pcPriClassBase\',W.LONG),(\'dwFlags\',W.DWORD),(\'szExeFile\',W.WCHAR*260)]\nclass MODULEENTRY32W(C.Structure):\n    _fields_=[(\'dwSize\',W.DWORD),(\'th32ModuleID\',W.DWORD),(\'th32ProcessID\',W.DWORD),(\'GlblcntUsage\',W.DWORD),(\'ProccntUsage\',W.DWORD),(\'modBaseAddr\',C.c_void_p),(\'modBaseSize\',W.DWORD),(\'hModule\',W.HMODULE),(\'szModule\',W.WCHAR*256),(\'szExePath\',W.WCHAR*260)]\n\nclass WinMemory:\n    def __init__(self,pid):\n        self.k=C.WinDLL(\'kernel32\',use_last_error=True)\n        self.k.OpenProcess.argtypes=[W.DWORD,W.BOOL,W.DWORD];self.k.OpenProcess.restype=W.HANDLE\n        self.k.CloseHandle.argtypes=[W.HANDLE];self.k.CloseHandle.restype=W.BOOL\n        self.k.ReadProcessMemory.argtypes=[W.HANDLE,C.c_void_p,C.c_void_p,C.c_size_t,C.POINTER(C.c_size_t)];self.k.ReadProcessMemory.restype=W.BOOL\n        self.k.WriteProcessMemory.argtypes=self.k.ReadProcessMemory.argtypes;self.k.WriteProcessMemory.restype=W.BOOL\n        self.k.GetExitCodeProcess.argtypes=[W.HANDLE,C.POINTER(W.DWORD)];self.k.GetExitCodeProcess.restype=W.BOOL\n        self.pid=pid;self.handle=self.k.OpenProcess(0x410,False,pid);self.write_handle=None\n        if not self.handle:raise MemoryError(f\'无法读取游戏进程（Windows 错误 {C.get_last_error()}）\')\n    def read(self,address,size):\n        if not 0x10000<=address<0xffff0000 or not 0<size<=4*1024*1024:raise MemoryError(\'读取地址或长度无效\')\n        buf=C.create_string_buffer(size);n=C.c_size_t()\n        if not self.k.ReadProcessMemory(self.handle,address,buf,size,C.byref(n)) or n.value!=size:\n            raise MemoryError(f\'内存读取失败 0x{address:08X}\')\n        return buf.raw\n    def u32(self,a):return struct.unpack(\'<I\',self.read(a,4))[0]\n    def i32(self,a):return struct.unpack(\'<i\',self.read(a,4))[0]\n    def vec(self,a):return struct.unpack(\'<3f\',self.read(a,12))\n    def string(self,a,n=160):return self.read(a,n).split(b\'\\0\')[0].decode(\'utf-8\',errors=\'replace\')\n    def alive(self):\n        status=W.DWORD()\n        return bool(self.k.GetExitCodeProcess(self.handle,C.byref(status))) and status.value==259\n    def allow_write(self):\n        if not self.write_handle:\n            self.write_handle=self.k.OpenProcess(0x28,False,self.pid)\n            if not self.write_handle:raise MemoryError(f\'无法写入视角（Windows 错误 {C.get_last_error()}）\')\n    def write(self,a,data):\n        if not self.write_handle:raise MemoryError(\'视角控制未启用\')\n        n=C.c_size_t();buf=C.create_string_buffer(data)\n        if not self.k.WriteProcessMemory(self.write_handle,a,buf,len(data),C.byref(n)) or n.value!=len(data):raise MemoryError(\'视角写入失败\')\n    def revoke_write(self):\n        if self.write_handle:self.k.CloseHandle(self.write_handle);self.write_handle=None\n    def close(self):\n        self.revoke_write()\n        if self.handle:self.k.CloseHandle(self.handle);self.handle=None\n\ndef snapshot_entries(flags,pid,entry_type,first,next_):\n    k=C.WinDLL(\'kernel32\',use_last_error=True)\n    k.CreateToolhelp32Snapshot.argtypes=[W.DWORD,W.DWORD];k.CreateToolhelp32Snapshot.restype=W.HANDLE\n    k.CloseHandle.argtypes=[W.HANDLE]\n    f,n=getattr(k,first),getattr(k,next_)\n    for fn in (f,n):fn.argtypes=[W.HANDLE,C.POINTER(entry_type)];fn.restype=W.BOOL\n    for attempt in range(3):\n        handle=k.CreateToolhelp32Snapshot(flags,pid);rows=[];code=0\n        if handle==C.c_void_p(-1).value:code=C.get_last_error()\n        else:\n            try:\n                row=entry_type();row.dwSize=C.sizeof(row);C.set_last_error(0)\n                ok=f(handle,C.byref(row))\n                while ok:\n                    rows.append(entry_type.from_buffer_copy(row));C.set_last_error(0)\n                    ok=n(handle,C.byref(row))\n                code=C.get_last_error()\n                if code in (0,18):\n                    yield from rows;return\n            finally:k.CloseHandle(handle)\n        if code not in (24,299) or attempt==2:raise SnapshotError(pid,code)\n        time.sleep(.01*(attempt+1))\n\ndef game_pids():\n    # The loaded module pair identifies the client, including renamed launchers.\n    return [e.th32ProcessID for e in snapshot_entries(2,0,PROCESSENTRY32W,\'Process32FirstW\',\'Process32NextW\') if e.th32ProcessID>4 and e.th32ProcessID!=os.getpid()]\n\ndef modules(pid):\n    return {e.szModule.lower():(e.modBaseAddr,e.modBaseSize,Path(e.szExePath)) for e in snapshot_entries(0x18,pid,MODULEENTRY32W,\'Module32FirstW\',\'Module32NextW\')}\n\n\ndef discover_game_modules(timeout=8.0, poll=0.10):\n    """Wait for the client/engine pair to settle after the game EXE starts."""\n    deadline=time.monotonic()+max(0.0,float(timeout));attempts=0;last_failures=[];last_pids=[]\n    while True:\n        attempts+=1\n        try:pids=game_pids()\n        except (MemoryError,OSError) as ex:pids=[];last_failures=[{\'pid\':None,\'error\':str(ex),\'winerror\':getattr(ex,\'winerror\',None)}]\n        last_pids=pids;candidates=[];failures=[]\n        for pid in pids:\n            try:mods=modules(pid)\n            except (MemoryError,OSError) as ex:\n                failures.append({\'pid\':pid,\'error\':str(ex),\'winerror\':getattr(ex,\'winerror\',None)});continue\n            if all(x in mods for x in (\'client.dll\',\'engine.dll\')):candidates.append((pid,mods))\n        if candidates:\n            return candidates,failures,dict(attempts=attempts,wait_seconds=round(max(0.0,timeout-(deadline-time.monotonic())),3),pids=last_pids)\n        last_failures=failures;remaining=deadline-time.monotonic()\n        if remaining<=0:return [],last_failures,dict(attempts=attempts,wait_seconds=float(timeout),pids=last_pids)\n        time.sleep(min(max(0.01,float(poll)),remaining))\n\n@dataclass\nclass Entity:\n    index:int\n    address:int\n    classname:str\n    team:int\n    health:int\n    origin:tuple\n    dormant:bool=False\n    enemy:bool=False\n    grenade:bool=False\n    weapon:str=\'\'\n    head:tuple|None=None\n    skeleton:list=field(default_factory=list)\n    zombie_class:int=0\n    visibility:str=\'blocked\'\n    wall_text:str=\'遮挡\'\n    model:str=\'\'\n    head_source:str=\'unavailable\'\n    head_bone:str=\'\'\n    owner_team:int=-1\n    velocity:tuple|None=None\n    flags:int|None=None\n    head_radius:float|None=None\n    wall_age_ms:float|None=None\n    wall_head_shift:float|None=None\n    wall_eye_shift:float|None=None\n    aim_points:list=field(default_factory=list)\n    aim_id:str=\'head\'\n    aim_part:str=\'head\'\n    wall_penetrable:bool=False\n    pose_bounds:tuple|None=None\n    pose_active:bool=False\n    pose_status:str=\'\'\n    reported_alive:bool=True\n    can_throw:bool=False\n    throwable_source:str=\'\'\n    throw_red_until:float=0.\n    aim_points_validated:bool=False\n    serial:int=0\n    ragdoll_present:bool|None=None\n    pose_confirmed:bool=False\n    pose_evidence:dict=field(default_factory=dict)\n    penetration:dict=field(default_factory=dict)\n    pose_diagnostic:dict=field(default_factory=dict)\n    aim_guard_reason:str=\'\'\n    geometry_scale:float=1.\n    geometry_body_scale:float=1.\n    geometry_head_scale:float=1.\n    geometry_scale_detected:bool=False\n    geometry_scale_applied:float=1.\n    geometry_head_scale_applied:float=1.\n    target_source:str=\'\'\n    aim_geometry:str=\'\'\n    pose_sample_stamp:float=0.\n    pose_cache_evidence:dict=field(default_factory=dict)\n    c4_carrier:bool=False\n    aim_hitboxes:tuple=()\n\n@dataclass\nclass Frame:\n    stamp:float\n    local:Entity\n    eye:tuple\n    angles:tuple\n    punch:tuple\n    matrix:tuple\n    entities:list\n    map_name:str\n    weapon:str\n    ammo:int\n    shots:int\n    mode:str\n    protected:list=field(default_factory=list)\n    protected_complete:bool=True\n    grenades:list=field(default_factory=list)\n    hazard_status:str=\'\'\n    native_mode_id:int=0\n    free_for_all:bool=False\n    protected_errors:list=field(default_factory=list)\n    # Control readback uses dataclasses.replace repeatedly. Provenance is part\n    # of the frame, not transient attributes that disappear after view writes.\n    source:str=\'\'\n    target_source:str=\'\'\n    local_source:str=\'\'\n    source_epoch:int=0\n    server_local_identity:tuple|None=None\n    server_base:int=0\n    hazard_diagnostics:dict=field(default_factory=dict)\n    weapon_state:dict=field(default_factory=dict)\n    c4_objects:list=field(default_factory=list)\n    esp_targets:dict=field(default_factory=dict,repr=False,compare=False)\n    control_provenance:dict=field(default_factory=dict,repr=False,compare=False)\n    hostage_aim_filter:dict=field(default_factory=dict,repr=False,compare=False)\n    # Civilian data is deliberately isolated from combat actors.\n    # Consumers that do not understand the hostage contract must never see a\n    # CHostage as an aim/fire target. Every acquisition owns a fresh list.\n    hostages:list=field(default_factory=list)\n    hostage_geometry:str=\'\'\n    hostage_scope:tuple|None=None\n\nclass AimReader:\n    def __init__(self,game=DEFAULT_GAME):\n        self.game=Path(game);self.profile=_BUNDLE_DATA[\'build_profile.json\']\n        self.mem=None;self.class_cache={};self.model_cache={};self.table_cache={};self.entity_scan=[];self.last_scan=0;self.status=\'未连接\';self.slot_cache={};self.sample_ms=0\n        self.menu=MenuState(self)\n        self.entity_stats={}\n        self.hazard_reader=None;self.hazard_retry=0.\n        from pose_activity import PoseActivity\n        self.pose_activity=PoseActivity()\n        self.inventory_cache={}\n        self.throwable_classes={};self.throw_states={}\n        from native_mode import NativeMode\n        self.native_mode=NativeMode(self)\n        self.resolved={};self.compatibility={};self.requested_game=str(self.game)\n        self.field_ok={};self.field_errors={};self.capabilities={};self.capability_failures={};self.next_capabilities=0.;self.module_provider=modules\n        self.pose_retry_after={}\n        self.feature_retry_after={}\n    def attach(self,pid=None):\n        if self.mem:self.close()\n        attach_started=time.monotonic()\n        self.resolved={};self.compatibility={\'requested_game\':str(self.game),\'modules\':{},\'stage\':\'discovery\'}\n        if pid is not None:\n            # A display worker already belongs to one game. Probe that PID,\n            # still validate its modules/structures, and never jump to another.\n            if isinstance(pid,bool) or not isinstance(pid,int) or pid<=4:\n                raise NotReady(\'Invalid pinned display PID\')\n            mods=self.module_provider(pid);failures=[]\n            if not all(n in mods for n in (\'client.dll\',\'engine.dll\')):\n                raise NotReady(\'Pinned display process is waiting for game modules\')\n            candidates=[(pid,mods)]\n            discovery=dict(attempts=1,wait_seconds=0.,pids=[pid],mode=\'pinned_pid\')\n        elif self.module_provider is modules:\n            candidates,failures,discovery=discover_game_modules()\n        else:\n            pids=game_pids();candidates=[];failures=[]\n            for pid in pids:\n                try:mods=self.module_provider(pid)\n                except (MemoryError,OSError) as ex:\n                    failures.append({\'pid\':pid,\'error\':str(ex),\'winerror\':getattr(ex,\'winerror\',None)});continue\n                if all(x in mods for x in (\'client.dll\',\'engine.dll\')):candidates.append((pid,mods))\n            discovery=dict(attempts=1,wait_seconds=0.,pids=pids)\n        self.compatibility.update(candidates=[{\'pid\':pid,\'game\':str(game_root(mods[\'client.dll\'][2]))} for pid,mods in candidates],\n                                  inaccessible_processes=len(failures),discovery=discovery)\n        self.compatibility[\'discovery_errors\']=failures\n        discovery_done=time.monotonic()\n        try:pid,self.mods=choose_candidate(candidates,self.game)\n        except CompatibilityError as ex:\n            message=str(ex)\n            if not candidates and failures:\n                # Names are diagnostic hints only; discovery still checks all\n                # processes, including completely renamed client executables.\n                try:names={e.th32ProcessID:e.szExeFile for e in snapshot_entries(2,0,PROCESSENTRY32W,\'Process32FirstW\',\'Process32NextW\')}\n                except MemoryError:names={}\n                for item in failures:item[\'name\']=names.get(item[\'pid\'],\'\')\n                related=[f for f in failures if any(word in f[\'name\'].casefold() for word in (\'counterstrike\',\'cso2\',\'csol2\'))]\n                if related:message=\'客户端进程无法读取；\'+\'；\'.join(f["name"]+\'：\'+f[\'error\'] for f in related[:3])\n                else:message+=f\'；另有 {len(failures)} 个进程不可读取，原因已记录到连接诊断\'\n            self.compatibility[\'error\']=message;raise NotReady(message) from ex\n        self.game=game_root(self.mods[\'client.dll\'][2])\n        self.compatibility.update(pid=pid,game=str(self.game),stage=\'module_validation\')\n        try:\n            self.mem=WinMemory(pid);self.client=self.mods[\'client.dll\'][0];self.engine=self.mods[\'engine.dll\'][0]\n            self.resolve_addresses()\n            addresses_done=time.monotonic()\n            self.verify_structures()\n        except Exception as ex:\n            self.compatibility[\'error\']=str(ex)\n            self.close();raise\n        self.compatibility[\'stage\']=\'ready\'\n        self.attach_timing=dict(discovery_ms=round((discovery_done-attach_started)*1000,3),\n            addresses_ms=round((addresses_done-discovery_done)*1000,3),\n            structures_ms=round((time.monotonic()-addresses_done)*1000,3),\n            total_ms=round((time.monotonic()-attach_started)*1000,3))\n        self.compatibility[\'attach_timing\']=dict(self.attach_timing)\n        self.status=f\'已动态识别进程 {pid} · {self.game} · 等待对局数据\'\n    def resolve_addresses(self):\n        for name,spec in _BUNDLE_DATA[\'compat_specs.json\'].items():\n            self.compatibility[\'modules\'][name]={\'path\':str(self.mods[name][2]),\'verified\':False}\n            try:addresses,report=resolve_module(self.mem,self.mods[name],spec,optional_keys=set(spec[\'anchors\'])-set(self.profile[\'globals\'])-{\'netprop:m_iHealth\',\'netprop:m_iTeamNum\',\'netprop:m_vecOrigin\'})\n            except (CompatibilityError,OSError) as ex:\n                self.compatibility[\'modules\'][name].update(getattr(ex,\'report\',{}))\n                raise NotReady(str(ex)) from ex\n            self.resolved.update(addresses);report[\'verified\']=True\n            self.compatibility[\'modules\'][name]=report\n    def verify_structures(self):\n        self.field_errors={};self.field_ok={}\n        self.compatibility[\'structures\']={}\n        for sig in self.profile[\'signatures\']:\n            # The old two-byte INC/RET is neither unique nor a layout contract.\n            # local_index is already resolved from full instruction anchors.\n            if sig[\'label\']==\'GetLocalPlayer\':continue\n            try:\n                rva=resolve_signature(self.mem,self.mods[sig[\'module\']],sig)\n                self.compatibility[\'structures\'][sig[\'label\']]={\'rva\':hex(rva),\'method\':\'instruction_scan\'}\n            except (CompatibilityError,MemoryError,OSError) as ex:\n                if sig[\'label\']!=\'BoneCacheCopy\':raise NotReady(\'结构定位失败：\'+sig[\'label\']+\'；\'+str(ex)) from ex\n                self.field_errors[\'bones\']=\'骨骼读取路径不可用：\'+str(ex)\n        self.field_ok[\'bones\']=\'bones\' not in self.field_errors\n        self.verify_netprops()\n    def verify_netprops(self):\n        checks=[dict(name=\'m_bRedraw\',offset=0xba8),dict(name=\'m_fThrowTime\',offset=0xbac),*self.profile[\'netprops\']]\n        for check in checks:\n            name=check[\'name\']\n            try:\n                a=self.resolv