_EMBEDDED['shot_region'] = (1, '"""Frontmost native hitgroup along a sampled ray, never an engine hit claim."""\nimport math\nfrom geometry import sub, length\n\nMULTIPLIERS = {1: 4., 3: 1.25, 6: .75, 7: .75}\nPART_MULTIPLIERS = {\'head\': 4., \'pelvis\': 1.25, \'leg\': .75}\n\n\ndef ballistic_part(entity, part):\n    """Anatomical labels never invent damage multipliers on generic rigs."""\n    from aim_points import requires_head_intent\n    return part if requires_head_intent(entity) else \'body\'\n\n\ndef inspect(eye, entity, point, part):\n    boxes = getattr(entity, \'aim_hitboxes\', ())\n    result = dict(available=False, allowed=True, intended_part=part, first_group=None,\n                  basis=\'sampled_native_hitbox_order\', engine_hit_verified=False)\n    from high_threat_models import is_high_threat_model\n    generic=(getattr(entity, \'head_source\', \'\') in\n             (\'anatomical_generic\', \'server_anatomical_generic\')\n             or is_high_threat_model(getattr(entity,\'model\',\'\')))\n    result[\'intended_multiplier\']=1. if generic else PART_MULTIPLIERS.get(part, 1.)\n    if not boxes:return result\n    if any(getattr(box, \'group\', -1) not in range(8) for box in boxes):\n        return result\n    ray = sub(point, eye)\n    distance = length(ray)\n    if not math.isfinite(distance) or distance <= 1e-5:\n        return dict(result, available=True, allowed=False, status=\'invalid_ray\')\n    # Continue a short distance through the chosen point, preserving direction.\n    # This also handles a point sampled on the numerical hitbox boundary.\n    delta = tuple(v * (distance + 4.) / distance for v in ray)\n    hits = []\n    for box in boxes:\n        interval = box.intersection(eye, delta)\n        if interval is not None:\n            hits.append((max(0., interval[0]) * (distance + 4.), box.group))\n    result[\'available\'] = True\n    if not hits:\n        return dict(result, allowed=False, status=\'ray_misses_native_boxes\')\n    nearest = min(d for d, _ in hits)\n    # Shared/overlapping surfaces are ambiguous. Keep the lower multiplier\n    # rather than claim that a head behind a hand will be registered first.\n    group = min((g for d, g in hits if d <= nearest + .01),\n                key=lambda g: MULTIPLIERS.get(g, 1.))\n    # Generic hitgroups have no head damage bonus even when the selected\n    # bone is anatomically labelled head. Still require an actual OBB hit.\n    actual = 1. if generic else MULTIPLIERS.get(group, 1.)\n    wanted = 1. if generic else PART_MULTIPLIERS.get(part, 1.)\n    result.update(first_group=group, entry_distance=nearest,\n                  relative_multiplier=actual, intended_multiplier=wanted,\n                  allowed=actual >= wanted,\n                  status=\'clear_to_intended_group\' if actual >= wanted else \'lower_group_in_front\')\n    return result\n\n\ndef damage_rank(eye, entity, point):\n    """Sort within the existing visibility tier; blocked heads do not win."""\n    key = (tuple(eye), point.key, tuple(point.position), point.part,\n           getattr(entity,\'head_source\',\'\'),getattr(entity,\'model\',\'\'))\n    boxes = getattr(entity, \'aim_hitboxes\', ())\n    cache = getattr(entity, \'_shot_region_cache\', None)\n    if cache is None or cache[0] is not boxes:\n        cache = (boxes, {})\n        entity._shot_region_cache = cache\n    if key not in cache[1]:\n        if len(cache[1]) >= 128:\n            cache[1].clear()\n        info = inspect(eye, entity, point.position, point.part)\n        # A self-occluded head point is not a head shot candidate. Prefer an\n        # actual exposed part over aiming at the wrong one knowingly.\n        cache[1][key] = (-info.get(\'intended_multiplier\', 1.) if info[\'allowed\'] else 0.)\n    return cache[1][key]\n')
_EMBEDDED['fast_acquire_contract'] = (1, '"""First-write coherence and candidate work budgets; synthetic input only."""\nimport copy\nimport io\nimport math\nimport unittest\nfrom dataclasses import replace\n\n\ndef moving_scene():\n    from combat37_contract import scene,USP\n    # Keep this fixture\'s cone below the synthetic head radius so the tests\n    # exercise motion-side geometry. Real USP spread is handled by the\n    # center-preserving accuracy path when its cone is larger than the head.\n    f=scene(p=dict(USP,Spread=.0001,InaccuracyStand=.0001),generic=False,distance=550.)\n    f.reader.entity.pose_sample_stamp=10.\n    f.reader.entity.velocity=(0.,200.,0.)\n    return f\n\n\ndef move(f,when,y):\n    e=f.reader.entity\n    e.pose_sample_stamp=when;e.head=(550.,y,64.);e.origin=(550.,y,0.)\n    e.aim_points=[replace(p,position=(550.,y,p.position[2])) for p in e.aim_points]\n\n\ndef crowded_scene(count=16):\n    from combat37_contract import scene,USP\n    f=scene(p=USP,generic=False,distance=550.)\n    f.frame.angles=f.reader.angles=(0.,-35.,0.)\n    for i in range(1,count):\n        e=copy.deepcopy(f.reader.entity);e.index+=i;e.address+=i*0x10000;e.serial+=i\n        e.head=(550.,20.*i,64.);e.origin=(550.,20.*i,0.)\n        e.aim_points=[replace(p,position=(550.,20.*i,p.position[2])) for p in e.aim_points]\n        f.wall.refresh_target(f.frame,e,f.weapon);f.frame.entities.append(e)\n    return f\n\n\ndef run():\n    from combat37_contract import scene,tick,USP\n    from geometry import aim_angles,angle_error,WallHit\n    from target_priority import threat_info\n    from compact_log import compact_context\n\n    class Tests(unittest.TestCase):\n        def test_thin_verified_metal_precedes_heavy_wall_but_not_direct(self):\n            from ballistics import selection_tier\n            def path(material,thickness):\n                return dict(kind=\'penetration\',allowed=True,\n                    layers=[dict(materials=[material],thickness=thickness)])\n            metal=path(\'native_M\',3.)\n            self.assertEqual(selection_tier(\'clear\',{\'kind\':\'clear\',\'allowed\':True}),0)\n            self.assertEqual(selection_tier(\'blocked\',metal,True),1)\n            self.assertEqual(selection_tier(\'blocked\',metal,False),3)\n            self.assertEqual(selection_tier(\'blocked\',path(\'native_M\',23.),True),2)\n            self.assertEqual(selection_tier(\'blocked\',path(\'native_C\',3.),True),2)\n            self.assertEqual(selection_tier(\'blocked\',dict(metal,guard_reason=\'pending\'),True),3)\n\n        def test_direct_incumbent_stages_next_visible_target(self):\n            from wall_service import WallService\n            f=crowded_scene(3)\n            f.cfg.strategy=\'近身优先\'\n            wall=WallService.__new__(WallService)\n            wall.fast_bsp=f.wall.fast_bsp\n            wall.map_args=(None,f.frame.map_name,None)\n            rays,checked=wall.refresh_candidates(f.frame,f.cfg,f.weapon,target=2)\n            self.assertGreater(rays,0)\n            self.assertEqual(checked[:2],[2,3])\n            self.assertGreaterEqual(wall.fast_metrics[\'direct_candidates\'],2)\n\n        def test_background_batch_covers_ten_actors_before_detail_budget(self):\n            from aim_points import candidate_points\n            from wall_service import trace_request\n            f=crowded_scene(10)\n            rows=[[e.index,e.address,e.head,e.model,\n                   [[p.key,p.position,p.part,p.priority,p.radius] for p in candidate_points(e)],\n                   e.serial,getattr(e,\'head_source\',\'\')] for e in f.frame.entities]\n            query=dict(eye=f.frame.eye,entities=rows,weapon=f.weapon,stamp=f.frame.stamp)\n            results=trace_request(f.wall.fast_bsp,query,{},budget_ms=0.)\n            self.assertEqual(len(results),10)\n            self.assertEqual({r[6] for r in results},{f.frame.stamp})\n            self.assertTrue(all(r[8] for r in results))\n            self.assertTrue(all(\'allowed\' in value[5] for r in results for value in r[8]))\n\n        def test_sixteen_candidates_do_not_reverse_trace_on_control_thread(self):\n            f=crowded_scene();trace=f.wall.fast_bsp.trace;calls=[]\n            def traced(a,b,**kw):\n                calls.append((a,b));return trace(a,b,**kw)\n            f.wall.fast_bsp.trace=traced;f.wall.trace=traced;d=tick(f,10.)\n            self.assertTrue(d[\'fire_commit\'][\'allowed\'])\n            self.assertFalse(any(b==f.frame.eye for a,b in calls))\n            self.assertTrue(calls)  # The actual forward-ray guard is still run.\n            self.assertEqual(d[\'aim_response\'][\'reciprocal_probe\'],\'not_sampled\')\n\n        def test_unobserved_reciprocal_flag_is_explicit(self):\n            f=scene(generic=False)\n            self.assertFalse(threat_info(f.frame,f.reader.entity)[\'reciprocal_sampled\'])\n            self.assertTrue(threat_info(f.frame,f.reader.entity,True)[\'reciprocal_sampled\'])\n\n        def test_first_write_uses_final_in_head_motion_point(self):\n            f=moving_scene();tick(f,10.);move(f,10.04,8.)\n            f.reader.writes.clear();d=tick(f,10.04)\n            self.assertTrue(d[\'head_motion\'][\'active\'])\n            self.assertEqual(len(f.reader.writes),1)\n            self.assertEqual(d[\'aim_pose_corrections\'],0)\n            self.assertLess(angle_error(f.reader.writes[0],aim_angles(f.frame.eye,d[\'firing_aim_point\'])),1e-8)\n            self.assertGreater(d[\'aim_response\'][\'preapplied_motion_units\'],0.)\n            self.assertTrue(d[\'actual_ray_retraced\'])\n\n        def test_motion_point_does_not_drift_from_repeated_radius_shrink(self):\n            f=moving_scene()\n            for n in range(12):\n                when=10.+n*.025;move(f,when,n*5.)\n                d=tick(f,when)\n                h=d[\'head_motion\'];p=f.reader.entity.aim_points[0]\n                self.assertLessEqual(math.dist(h[\'point\'],p.position)+h[\'remaining_radius\'],p.radius+1e-8)\n                if n:\n                    # Motion lead now consumes a bounded portion of the\n                    # measured head to cover the observed input-latency gap;\n                    # the invariant is containment, not the old fixed 30%\n                    # reservation.\n                    self.assertGreater(h[\'remaining_radius\'],0.)\n\n        def test_reversal_uses_current_center_not_old_motion_side(self):\n            f=moving_scene();tick(f,10.);move(f,10.04,8.);tick(f,10.04)\n            move(f,10.065,3.);f.reader.entity.velocity=(0.,-200.,0.)\n            f.reader.writes.clear();d=tick(f,10.065)\n            self.assertLessEqual(d[\'head_motion\'][\'offset\'][1],0.)\n            self.assertLess(angle_error(f.reader.writes[0],aim_angles(f.frame.eye,d[\'firing_aim_point\'])),1e-8)\n\n        def test_new_weapon_does_not_inherit_motion_offset(self):\n            for speed in (0.,-200.,200.):\n                f=moving_scene();tick(f,10.);move(f,10.04,8.)\n                f.frame.weapon_state[\'handle\']+=1\n                f.reader.entity.velocity=(0.,speed,0.)\n                d=tick(f,10.04);motion=d[\'head_motion\']\n                # The new weapon may use the current actor\'s native motion,\n                # but never a pose delta cached for the previous weapon.\n                self.assertNotIn(\'observed_velocity\',motion)\n                self.assertEqual(motion[\'motion_side_basis\'],\'current_native_relative_velocity\')\n                if speed:self.assertGreater(motion[\'offset\'][1]*speed,0.)\n                else:self.assertEqual(d[\'aim_response\'][\'preapplied_motion_units\'],0.)\n                self.assertGreaterEqual(motion[\'remaining_radius\'],1.5)\n\n        def test_new_identity_does_not_inherit_motion_offset(self):\n            for speed in (0.,-200.,200.):\n                f=moving_scene();tick(f,10.);move(f,10.04,8.)\n                f.reader.entity.serial+=1\n                f.reader.entity.velocity=(0.,speed,0.)\n                d=tick(f,10.04);motion=d[\'head_motion\']\n                self.assertNotIn(\'observed_velocity\',motion)\n                self.assertEqual(motion[\'motion_side_basis\'],\'current_native_relative_velocity\')\n                if speed:self.assertGreater(motion[\'offset\'][1]*speed,0.)\n                else:self.assertEqual(d[\'aim_response\'][\'preapplied_motion_units\'],0.)\n                self.assertGreaterEqual(motion[\'remaining_radius\'],1.5)\n\n        def test_stale_pose_does_not_create_initial_motion(self):\n            f=moving_scene();tick(f,10.);move(f,10.04,8.)\n            d=tick(f,10.2)\n            self.assertEqual(d[\'aim_response\'][\'preapplied_motion_units\'],0.)\n\n        def test_first_head_write_converges_within_existing_step_limit(self):\n            for error in (.1,5.,25.,50.):\n                f=scene(p=USP,generic=False,distance=550.)\n                f.frame.angles=f.reader.angles=(0.,-error,0.)\n                d=tick(f,10.)\n                self.assertEqual(len(f.reader.writes),1)\n                self.assertTrue(d[\'fire_commit\'][\'allowed\'])\n                self.assertLess(d[\'write_readback_error_deg\'],1e-8)\n\n        def test_server_generic_high_threat_uses_immediate_hittable_head_lock(self):\n            for model in (\'player/tr_ysht/tr_ysht.mdl\',\'player/tr_qipao01/tr_qipao01.mdl\',\'player/tr_san/tr_san.mdl\'):\n                f=scene(p=USP,generic=True,distance=550.)\n                f.cfg.smoothing=8.\n                f.reader.entity.model=model;f.reader.entity.head_source=\'server_anatomical_generic\'\n                f.frame.angles=f.reader.angles=(0.,-25.,0.)\n                d=tick(f,10.)\n                self.assertEqual(d[\'aim_part\'],\'head\')\n                self.assertTrue(d[\'aim_response\'][\'immediate\'])\n                self.assertTrue(d[\'fire_commit\'][\'allowed\'])\n                self.assertLess(angle_error(f.reader.writes[0],aim_angles(f.frame.eye,d[\'firing_aim_point\'])),1e-8)\n\n        def test_server_generic_high_threat_without_head_uses_immediate_body_lock(self):\n            for model in (\'player/tr_ysht/tr_ysht.mdl\',\'player/tr_qipao01/tr_qipao01.mdl\',\'player/tr_san/tr_san.mdl\'):\n                f=scene(p=USP,generic=True,distance=550.);f.cfg.smoothing=8.\n                e=f.reader.entity;e.model=model;e.head_source=\'server_anatomical_generic\'\n                e.aim_points=[p for p in e.aim_points if p.part!=\'head\']\n                f.frame.angles=f.reader.angles=(0.,-25.,0.)\n                d=tick(f,10.)\n                self.assertEqual(d[\'aim_part\'],\'torso\')\n                self.assertTrue(d[\'aim_response\'][\'immediate\'])\n                self.assertTrue(d[\'fire_commit\'][\'allowed\'])\n                self.assertLess(angle_error(f.reader.writes[0],aim_angles(f.frame.eye,d[\'firing_aim_point\'])),1e-8)\n\n        def test_direct_contact_body_immediate_in_crosshair_strategy(self):\n            f=scene(p=USP,generic=False,distance=128.)\n            f.reader.entity.aim_points=f.reader.entity.aim_points[1:]\n            f.cfg.smoothing=8.;f.frame.angles=f.reader.angles=(0.,-25.,0.)\n            d=tick(f,10.)\n            self.assertTrue(d[\'aim_response\'][\'immediate\'])\n            self.assertTrue(d[\'fire_commit\'][\'allowed\'])\n\n        def test_distant_visible_body_is_not_smoothed_by_weapon_or_model(self):\n            f=scene(p=USP,generic=False,distance=1024.)\n            f.reader.entity.aim_points=f.reader.entity.aim_points[1:]\n            f.cfg.smoothing=8.;f.frame.angles=f.reader.angles=(0.,-25.,0.)\n            d=tick(f,10.)\n            self.assertTrue(d[\'aim_response\'][\'immediate\'])\n            self.assertTrue(d[\'fire_commit\'][\'allowed\'])\n            self.assertLess(angle_error(f.reader.writes[0],aim_angles(f.frame.eye,d[\'firing_aim_point\'])),1e-8)\n\n        def test_movement_side_cover_still_blocks_down(self):\n            f=moving_scene();tick(f,10.);move(f,10.04,8.)\n            trace=f.wall.fast_bsp.trace\n            f.wall.fast_bsp.trace=lambda a,b,**kw:[WallHit(.2,.5,165.,\'T\',1)] if b[1]>8.1 else trace(a,b,**kw)\n            d=tick(f,10.04)\n            self.assertFalse(d[\'fire_allowed\']);self.assertFalse(f.control.pressed)\n            self.assertTrue(d[\'actual_ray_retraced\'])\n\n        def test_fast_head_bad_readback_blocks_down(self):\n            f=moving_scene();f.reader.bad_readback=True\n            d=tick(f,10.)\n            self.assertFalse(d[\'fire_allowed\']);self.assertNotIn(True,f.inputs.events)\n\n        def test_compact_log_preserves_response_without_budget_increase(self):\n            f=moving_scene();d=tick(f,10.)\n            self.assertEqual(compact_context(d)[\'aim_response\'],d[\'aim_response\'])\n            from compact_log import DETAIL_BYTES,SUMMARY_BYTES,RECENT_BYTES\n            self.assertEqual(DETAIL_BYTES+SUMMARY_BYTES+RECENT_BYTES,786432)\n\n    output=io.StringIO()\n    result=unittest.TextTestRunner(stream=output,verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(Tests))\n    if not result.wasSuccessful():raise AssertionError(output.getvalue())\n    return dict(passed=True,tests=result.testsRun,game_attached=False,game_input=False,\n        live_first_shot_latency_verified=False,live_kill_guarantee=False)\n')
_EMBEDDED['crosshair_radar_contract'] = (1, '"""Strict crosshair ranking, radar deadline and final input-boundary tests."""\nimport copy,io,json,math,unittest\nfrom dataclasses import replace\nfrom types import SimpleNamespace as NS\n\n\ndef native_input_fixture(f,change=\'stable\'):\n    """Use the actual Controller -> EngineAttack chain with in-memory I/O."""\n    import struct\n    from engine_attack import EngineAttack\n    engine=EngineAttack(f.inputs);engine.reader=f.reader;engine.verified=True\n    engine.primary=0x90000;engine.secondary_address=0x90004\n    writes=[];states={};checks=[];m=f.reader.mem\n    m.alive=lambda:True;m.allow_write=lambda:None\n    m.u32=lambda address:states.get(address,0)\n    def write(address,data):\n        value=struct.unpack(\'<I\',data)[0];states[address]=value;writes.append((address,value))\n    m.write=write;f.reader.require_feature=lambda feature:None\n    def verify():\n        checks.append(len(checks)+1)\n        if len(checks)==2:\n            if change==\'view\':f.reader.angles=(0.,5.,0.)\n            elif change==\'expired\':f.now[0]+=.02\n            elif change==\'identity\':f.reader.entity.serial+=1\n            elif change==\'weapon\':return False\n        return True\n    engine.verify_fire_weapon=verify;f.control.trigger=engine\n    from right_click_contract import reserve_empty_fixture\n    reserve_empty_fixture(engine,f.reader)\n    return NS(engine=engine,writes=writes,checks=checks)\n\n\ndef run():\n    from target_priority import choose_visible\n    from combat37_contract import scene,tick,USP\n    from combat38_contract import multi_scene\n    from geometry import aim_angles,angle_error\n    from fire_commit import confirm_after_weapon\n    from engine_attack import EngineAttack\n\n    def equal_distance_scene(automatic=True):\n        # The new firearm rule orders distance first. Equal-distance actors\n        # still exercise current-view and recoil-independent tie-breaking.\n        f=multi_scene(automatic);e=f.visible\n        # Integer Pythagorean pair avoids a 1-ulp distance mismatch.\n        e.head=(480.,140.,64.);e.origin=(480.,140.,0.)\n        e.aim_points=[replace(p,position=(480.,140.,p.position[2])) for p in e.aim_points]\n        return f\n\n    def row(index,error,kind=\'clear\',distance=500.,rushing=False):\n        e=NS(index=index,visibility=\'visible\' if kind==\'clear\' else \'blocked\',\n             penetration=dict(kind=kind,allowed=True))\n        info=dict(distance=distance,tier=0 if distance<192. else 2,rushing=rushing,\n            exit_threat=dict(eligible=True,exposed=True,score=100.,eta=.1,age_ms=0.))\n        return error,e,(error,(0.,0.,0.),error),info\n\n    class Tests(unittest.TestCase):\n        def test_crosshair_wins_over_contact_exit_and_current_lock(self):\n            closest=row(1,.1,distance=2000.)\n            distractions=[row(2,25.,distance=80.),row(3,35.,distance=400.,rushing=True)]\n            for previous in (0,1,2,3):\n                self.assertIs(choose_visible([*distractions,closest],previous,\'准星最近\'),closest)\n\n        def test_small_mouse_change_immediately_reselects_closest(self):\n            a=row(1,.11);b=row(2,.1)\n            self.assertIs(choose_visible([a,b],1,\'准星最近\'),b)\n            self.assertIs(choose_visible([a,b],2,\'准星最近\'),b)\n\n        def test_equal_distance_retains_identity_without_extra_margin(self):\n            a=row(1,.1);b=row(2,.1)\n            self.assertIs(choose_visible([a,b],2,\'准星最近\'),b)\n\n        def test_direct_exit_wins_over_crosshair_wallbang(self):\n            hidden=row(1,.01,\'penetration\');visible=row(2,20.)\n            self.assertIs(choose_visible([hidden,visible],1,\'准星最近\'),visible)\n\n        def test_crosshair_matrix_has_no_distance_or_hp_bias(self):\n            for n in range(1,65):\n                rows=[row(i+1,abs(i-n/2)+i*.001,distance=60.+i*60.,rushing=i%2==0) for i in range(n)]\n                expected=min(rows,key=lambda r:r[2][2])\n                for previous in (0,1,n):\n                    self.assertIs(choose_visible(rows,previous,\'准星最近\'),expected)\n\n        def test_semiauto_controller_reselects_after_crosshair_view_change(self):\n            f=equal_distance_scene(automatic=False);f.cfg.strategy=\'准星最近\';f.control.release()\n            f.wall.fast_bsp.trace=lambda *a,**kw:[]\n            for e in f.frame.entities:f.wall.refresh_target(f.frame,e,f.weapon)\n            tick(f,10.01);self.assertEqual(f.control.target,2)\n            f.reader.angles=aim_angles(f.frame.eye,f.visible.head)\n            d=tick(f,10.2)\n            # Explicit crosshair-nearest mode follows the fresh view even for\n            # semi-auto weapons; identity continuity belongs to near/composite\n            # threat policies, not to a materially different aim direction.\n            expected=min(f.frame.entities,key=lambda e:angle_error(f.reader.angles,aim_angles(f.frame.eye,e.head))).index\n            self.assertEqual(f.control.target,expected)\n            self.assertEqual(d[\'selection_reason\'],\'current_crosshair_nearest\')\n\n        def test_recoil_does_not_move_the_crosshair_ranking_origin(self):\n            f=equal_distance_scene();f.cfg.strategy=\'准星最近\';f.control.release()\n            f.wall.fast_bsp.trace=lambda *a,**kw:[]\n            f.frame.punch=(0.,7.,0.)\n            for e in f.frame.entities:f.wall.refresh_target(f.frame,e,f.weapon)\n            tick(f,10.01)\n            self.assertEqual(f.control.target,2)\n\n        def test_view_updated_after_scan_is_used_for_selection(self):\n            f=equal_distance_scene();f.cfg.strategy=\'准星最近\';f.control.release()\n            f.wall.fast_bsp.trace=lambda *a,**kw:[]\n            for e in f.frame.entities:f.wall.refresh_target(f.frame,e,f.weapon)\n            view=aim_angles(f.frame.eye,f.visible.head)\n            def camera(frame):\n                if not f.reader.writes:f.reader.angles=view\n                return replace(frame,angles=f.reader.angles)\n            f.reader.control_view=camera;tick(f,10.01)\n            self.assertEqual(f.control.target,3)\n\n        def test_radar_deadline_independent_of_freeze_for_all_settings(self):\n            from radar_buy_delay import RadarBuyDelay\n            for seconds in range(6,16):\n                f=scene();now=[10.]\n                sample=dict(scope=(1,\'map\'),count=0,frozen=True,started=1.,source=\'fixture\')\n                gate=RadarBuyDelay(lambda:now[0],NS(read=lambda *_:dict(sample)))\n                gate.step(f.reader,f.frame,True,seconds)\n                now[0]=10.+seconds-.001\n                self.assertFalse(gate.step(f.reader,f.frame,True,seconds)[\'allowed\'])\n                now[0]+=.001\n                self.assertTrue(gate.step(f.reader,f.frame,True,seconds)[\'allowed\'])\n\n        def fixture_after_check(self):\n            f=scene(p=USP,generic=False,distance=550.);tick(f,10.)\n            return f\n\n        def test_post_weapon_changed_view_blocks_down(self):\n            f=self.fixture_after_check();f.reader.angles=(0.,5.,0.)\n            self.assertFalse(confirm_after_weapon(f.control,f.reader,f.frame,f.reader.entity,1.))\n            self.assertEqual(f.control.diagnostic[\'fire_commit\'][\'status\'],\'ray_changed_after_weapon\')\n\n        def test_post_weapon_expired_pose_blocks_down(self):\n            f=self.fixture_after_check();f.now[0]+=.02\n            self.assertFalse(confirm_after_weapon(f.control,f.reader,f.frame,f.reader.entity,1.))\n            self.assertEqual(f.control.diagnostic[\'fire_commit\'][\'status\'],\'pose_expired_after_weapon\')\n\n        def test_post_weapon_stable_ray_remains_ready(self):\n            f=self.fixture_after_check()\n            self.assertTrue(confirm_after_weapon(f.control,f.reader,f.frame,f.reader.entity,1.))\n            self.assertTrue(f.control.diagnostic[\'fire_commit\'][\'post_weapon_verified\'])\n\n        def test_engine_runs_final_guard_after_weapon_without_down_on_failure(self):\n            for accepted in (True,False):\n                calls=[];m=NS(alive=lambda:True,allow_write=lambda:None,write=lambda *a:calls.append(\'down\'),pid=9)\n                e=EngineAttack(NS(foreground=lambda pid:True,down=lambda key:False))\n                e.reader=NS(mem=m,require_feature=lambda f:None);e.primary=1\n                e.verify_fire_weapon=lambda:calls.append(\'weapon\') or True\n                def commit():calls.append(\'aim\');return True\n                commit.after_weapon_check=lambda:calls.append(\'final\') or accepted\n                self.assertEqual(e.set_guarded(commit),accepted)\n                self.assertEqual(calls,[\'weapon\',\'aim\',\'weapon\',\'final\']+([\'down\'] if accepted else []))\n\n        def test_controller_native_chain_checks_final_view_pose_and_identity(self):\n            for change,status in ((\'stable\',\'ready\'),(\'view\',\'ray_changed_after_weapon\'),\n                    (\'expired\',\'pose_expired_after_weapon\'),(\'identity\',\'identity_changed_after_weapon\'),\n                    (\'weapon\',None)):\n                with self.subTest(change=change):\n                    f=scene(p=USP,generic=False,distance=550.)\n                    native=native_input_fixture(f,change);d=tick(f,10.)\n                    down=(native.engine.primary,3) in native.writes\n                    self.assertEqual(down,change==\'stable\',d)\n                    self.assertEqual(f.control.pressed,change==\'stable\',d)\n                    self.assertEqual(len(native.checks),3 if change==\'stable\' else 2)\n                    if status:self.assertEqual(d[\'fire_commit\'][\'status\'],status,d)\n                    if change==\'stable\':self.assertTrue(d[\'fire_commit\'][\'post_weapon_verified\'])\n                    else:self.assertFalse(d[\'fire_allowed\'],d)\n\n        def test_large_fire_context_keeps_first_shot_evidence(self):\n            from compact_log import encode,RECORD_BYTES\n            f=self.fixture_after_check();d=copy.deepcopy(f.control.diagnostic)\n            d[\'penetration\']={\'huge\':[\'X\'*500 for _ in range(200)]}\n            d[\'selection_rejections\']=[{\'huge\':\'X\'*500} for _ in range(200)]\n            raw=encode(dict(kind=\'input_action\',action=\'fire_down\',aim_context=d))\n            record=json.loads(raw)\n            self.assertLessEqual(len(raw),RECORD_BYTES)\n            self.assertIn(\'fire_snapshot\',record[\'aim_context\'])\n            self.assertIn(\'fire_commit\',record[\'aim_context\'])\n\n    out=io.StringIO();result=unittest.TextTestRunner(stream=out,verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(Tests))\n    if not result.wasSuccessful():raise AssertionError(out.getvalue())\n    return dict(passed=True,tests=result.testsRun,game_attached=False,game_input=False,\n        crosshair_policy=\'closest_current_view_within_best_visibility\',live_first_shot_hits_verified=False)\n')
_EMBEDDED['latency_precision_contract'] = (1, '"""Moving input/pose timing regressions; no attached process or input."""\nimport io,math,unittest\nfrom dataclasses import replace\nfrom types import SimpleNamespace as NS\n\n\ndef timed_scene(profile=None,local_speed=0.,enemy_speed=250.):\n    from combat37_contract import scene,USP\n    f=scene(p=profile or USP,generic=False,distance=550.)\n    f.cfg.strategy=\'准星最近\';f.frame.local.velocity=(0.,local_speed,0.)\n    f.reader.entity.velocity=(0.,enemy_speed,0.);f.counts=dict(actors=0,views=0,traces=0)\n    original=f.reader.read_entity;trace=f.wall.fast_bsp.trace\n    def actor(*args,**kwargs):\n        began=f.now[0];e=original(*args,**kwargs);y=enemy_speed*(began-10.)\n        e.origin=(550.,y,0.);e.head=(550.,y,64.)\n        e.aim_points=[replace(p,position=(550.,y,p.position[2])) for p in e.aim_points]\n        e.pose_sample_stamp=began;e.target_source=\'client\'\n        f.now[0]+=.0012;f.counts[\'actors\']+=1\n        return e\n    def camera(frame):\n        f.now[0]+=.0002;f.counts[\'views\']+=1\n        return replace(frame,eye=(0.,local_speed*(f.now[0]-10.),64.),angles=f.reader.angles)\n    def traced(a,b,**kwargs):\n        f.now[0]+=.0006;f.counts[\'traces\']+=1;return trace(a,b,**kwargs)\n    f.reader.read_entity=actor;f.reader.control_view=camera;f.wall.fast_bsp.trace=traced\n    f.reader.entity.pose_sample_stamp=10.;f.reader.entity.target_source=\'client\'\n    return f\n\n\ndef bone_scene(scale=1.):\n    import struct\n    from reader import Reader\n    from aim_points import sample_definitions\n    r=Reader.__new__(Reader);entity=bytearray(0x1000);header=bytearray(180)\n    header[:4]=b\'IDST\';struct.pack_into(\'<i\',header,4,48)\n    struct.pack_into(\'<ii\',header,156,2,180)\n    struct.pack_into(\'<I\',entity,0x918,0x2000)\n    struct.pack_into(\'<I\',entity,0x8d0,0x4000);struct.pack_into(\'<i\',entity,0x8dc,2)\n    struct.pack_into(\'<f\',entity,0x600,scale)\n    matrices=b\'\'.join(struct.pack(\'<12f\',1,0,0,550,0,1,0,0,0,0,1,z) for z in (64,44))\n    blocks={(0x3000,180):bytes(header),(0x4000,96):matrices}\n    r.mem=NS(u32=lambda addr:0x3000 if addr==0x2000 else 0,\n             read=lambda addr,size:blocks[(addr,size)])\n    r.table_cache={(0,\'scale_fields\'):{\'m_flModelScale\':0x600}}\n    boxes=[(0,1,(-3.,-3.,-3.,3.,3.,3.)),(1,2,(-8.,-8.,-8.,8.,8.,8.))]\n    definitions=sample_definitions(boxes,[\'head\',\'chest\'],(0,(0.,0.,0.)))\n    cached=([(0,1)],(0,(0.,0.,0.)),{0,1},\'fixture\',\'head_hitgroup\',\'head\',3.,definitions,boxes)\n    r.model_cache={(0x3000,bytes(header),active,b\'\'):cached for active in (0,1)}\n    return r,entity\n\n\ndef run():\n    from combat37_contract import scene,tick,USP,XT97\n    from first_shot_contract import run as previous_contract\n    from aim_points import AimPoint\n    from geometry import angle_error,aim_angles\n    from crosshair_radar_contract import native_input_fixture\n\n    class Tests(unittest.TestCase):\n        def test_head_edge_readback_waits_instead_of_firing(self):\n            # The old broad radius accepted this 0.025-degree drift. It is\n            # inside the full head but outside the requested central margin.\n            f=scene(p=USP,generic=False,distance=550.)\n            original=f.reader.set_angles\n            def drift(angles):\n                original((angles[0],angles[1]+.025,angles[2]))\n            f.reader.set_angles=drift\n            d=tick(f,10.)\n            self.assertFalse(f.control.pressed)\n            self.assertEqual(d[\'fire_commit\'][\'status\'],\'head_not_centered\')\n            self.assertNotIn(True,f.inputs.events)\n\n        def test_calculated_head_followup_not_overridden_by_clear_ray(self):\n            from weapon_cadence import WeaponCadence\n            for family in (\'pistol\',\'rifle\',\'submachinegun\',\'machinegun\',\'sniperrifle\',\'shotgun\'):\n                profile=dict(USP,WeaponType=family,FullAuto=family in (\'rifle\',\'submachinegun\',\'machinegun\'))\n                f=scene(p=profile,generic=False,distance=150.)\n                target=replace(f.reader.entity,aim_part=\'head\',head_radius=3.,visibility=\'visible\')\n                c=WeaponCadence();c.observe(f.frame,10.);c.requested(10.)\n                f.frame.ammo-=1;f.frame.stamp=10.02;c.observe(f.frame,10.02)\n                q=c.assess(profile,f.frame,target,dict(kind=\'clear\',allowed=True),10.15,10.,alignment_error=0.)\n                self.assertTrue(q[\'head_recovery_hold\'],(family,q))\n                self.assertTrue(q[\'ready\'],(family,q))\n                self.assertEqual(q[\'interval\'],q[\'cycle\'])\n                self.assertTrue(q[\'removed_unverified_direct_recovery\'])\n                c=WeaponCadence();c.observe(f.frame,10.15)\n                first=c.assess(profile,f.frame,target,dict(kind=\'clear\',allowed=True),10.15,-100.,alignment_error=0.)\n                self.assertTrue(first[\'ready\'],(family,first))\n\n        def test_final_smaller_head_rechecks_schedule_before_down(self):\n            f=scene(p=USP,generic=False,distance=128.)\n            first=tick(f,10.);interval=first[\'fire_cadence\'][\'interval\'];tick(f,10.02,True)\n            original=f.reader.read_entity;reads=[0]\n            def read(*args,**kwargs):\n                e=original(*args,**kwargs);reads[0]+=1\n                if reads[0]>=2:\n                    e.head_radius=.5;e.aim_points=[replace(p,radius=.5) for p in e.aim_points]\n                return e\n            f.reader.read_entity=read\n            d=tick(f,10.02+interval+.001)\n            self.assertFalse(f.control.pressed)\n            self.assertEqual(d[\'fire_commit\'][\'status\'],\'fresh_head_recovery_pending\')\n            self.assertEqual(f.inputs.events,[True,False])\n            d=tick(f,10.02+USP[\'RecoveryTimeStand\']+.001)\n            self.assertTrue(f.control.pressed,d)\n\n        def test_wallbang_uses_configured_cone_not_hidden_three_degrees(self):\n            from aim_selection_contract import fixture,step\n            # Current user requests obstacle acquisition. Keep the configured\n            # cone and final material/ray/identity checks, not the old 3deg cap.\n            for angle in (3.01,8.,11.9):\n                f=fixture(thickness=5.);f.cfg.strategy=\'准星最近\';f.cfg.fov=12.\n                f.reader.angles=f.frame.angles=(0.,angle,0.)\n                d=step(f)\n                self.assertEqual(f.control.target,2,d)\n                self.assertTrue(f.reader.writes,d)\n                self.assertEqual(d[\'selected_path_tier\'],2)\n            for angle in (12.01,15.,60.):\n                f=fixture(thickness=5.);f.cfg.strategy=\'准星最近\';f.cfg.fov=12.\n                f.reader.angles=f.frame.angles=(0.,angle,0.)\n                d=step(f)\n                self.assertEqual(f.reader.writes,[])\n                self.assertFalse(f.control.pressed)\n                self.assertTrue(any(r[\'reject_stage\'] in (\'wallbang_crosshair_limit\',\'outside_fov\')\n                    for r in d[\'selection_rejections\']))\n            f=fixture(thickness=80.);f.cfg.strategy=\'准星最近\';f.cfg.fov=12.\n            f.reader.angles=f.frame.angles=(0.,8.,0.)\n            d=step(f);self.assertFalse(f.control.pressed,d)\n\n        def test_direct_visible_target_precedes_nearer_wallbang_all_weapon_families(self):\n            from combat38_contract import multi_scene\n            for profile in (USP,XT97,dict(USP,WeaponType=\'rifle\',CycleTime=.2),dict(USP,WeaponType=\'sniperrifle\',CycleTime=1.25)):\n                f=multi_scene(automatic=bool(profile.get(\'FullAuto\')))\n                f.weapon=profile;f.cfg.strategy=\'准星最近\';f.control.release()\n                d=tick(f,10.01)\n                self.assertEqual(f.control.target,f.visible.index)\n                self.assertEqual(d[\'selected_path_tier\'],0)\n\n        def test_direct_pose_becoming_wall_does_not_move_aim(self):\n            f=scene(p=XT97,generic=False,distance=550.)\n            original=f.wall.refresh_target\n            def covered(*args,**kwargs):\n                f.wall.thickness=5.;return original(*args,**kwargs)\n            f.wall.refresh_target=covered\n            d=tick(f,10.)\n            self.assertEqual(f.reader.writes,[]);self.assertFalse(f.control.pressed)\n            self.assertEqual(d[\'selection_reason\'],\'fresh_path_downgrade_visible_barrier\')\n\n        def test_low_part_lock_rechecks_newly_exposed_head_all_weapon_families(self):\n            from wall_service import WallService\n            from static_prop_guard import StaticPropGuard\n            from aim_points import select_aim_view\n            for kind,automatic in ((\'pistol\',0),(\'rifle\',1),(\'sniperrifle\',0),(\'shotgun\',0),(\'machinegun\',1),(\'submachinegun\',1)):\n                for old_part in (\'torso\',\'pelvis\',\'leg\'):\n                    profile=dict(USP,WeaponType=kind,FullAuto=automatic)\n                    f=scene(p=profile,generic=False,distance=550.);e=f.reader.entity\n                    e.aim_points.append(AimPoint(\'leg\',\'leg\',(550.,0.,12.),3.,40))\n                    w=WallService.__new__(WallService);calls=[]\n                    w.fast_bsp=NS(trace=lambda a,b:calls.append(b) or [],surface_materials={},static_fire_guard=StaticPropGuard([],{}))\n                    w.map_args=(\'\',f.frame.map_name,None)\n                    w.refresh_target(f.frame,e,profile,old_part,probe_only=True)\n                    self.assertEqual(calls,[e.head],(kind,old_part))\n                    self.assertEqual(select_aim_view(f.frame,e,profile,10.).aim_part,\'head\')\n\n        def test_covered_center_rotates_to_current_slit_head_sample(self):\n            from wall_service import WallService\n            from static_prop_guard import StaticPropGuard\n            f=scene(p=USP,generic=False,distance=550.);e=f.reader.entity\n            e.aim_points.insert(1,AimPoint(\'head_side\',\'head\',(550.,3.,64.),2.,1))\n            w=WallService.__new__(WallService);calls=[]\n            def trace(a,b):\n                calls.append(b)\n                return [NS(enter=.1,leave=.9,thickness=440.,texture=\'fixture\')] if b[1]==0 else []\n            w.fast_bsp=NS(trace=trace,surface_materials={},static_fire_guard=StaticPropGuard([],{}));w.map_args=(\'\',f.frame.map_name,None)\n            w.refresh_target(f.frame,e,USP,\'torso\',probe_only=True)\n            e.aim_points[1].position=(550.,4.,42.)\n            w.refresh_target(f.frame,e,USP,\'torso\',probe_only=True)\n            # The fast lane now probes one exposed-area body point after a\n            # blocked head. This is required to classify an actor as directly\n            # visible before wall candidates enter selection.\n            self.assertEqual(calls,[(550.,0.,64.),(550.,0.,44.),(550.,4.,42.)])\n            self.assertEqual(e.aim_points[1].visibility,\'visible\')\n            # Unprobed points stay blocked in the three-state ESP contract;\n            # they never inherit the newly exposed side point\'s permission.\n            self.assertEqual(e.aim_points[0].visibility,\'blocked\')\n            self.assertFalse(e.aim_points[0].penetrable)\n            self.assertEqual(e.aim_points[0].penetration,{})\n\n        def test_clear_head_selection_does_not_intersect_every_limb(self):\n            from aim_points import select_aim_view\n            from c4_precision_contract import box\n            from unittest.mock import patch\n            import shot_region\n            f=scene(p=USP,generic=False,distance=550.);e=f.reader.entity\n            e.aim_hitboxes=(box(e.head,(3.,3.,3.),1),box((550.,0.,44.),(10.,10.,10.),2))\n            e.aim_points += [AimPoint(\'body\'+str(i),\'torso\',(550.,0.,44.),3.,10+i,visibility=\'visible\',penetration=dict(kind=\'clear\',allowed=True)) for i in range(40)]\n            with patch.object(shot_region,\'inspect\',wraps=shot_region.inspect) as calls:\n                self.assertEqual(select_aim_view(f.frame,e,USP,10.).aim_part,\'head\')\n                self.assertEqual(calls.call_count,1)\n\n        def test_control_allies_keep_identity_without_bone_or_inventory_work(self):\n            import struct\n            from reader import Reader\n            from unittest.mock import patch,Mock\n            data=bytearray(0x1a10)\n            struct.pack_into(\'<i\',data,0x98,100);struct.pack_into(\'<i\',data,0xa0,3)\n            struct.pack_into(\'<3f\',data,0x300,100.,0.,0.);struct.pack_into(\'<3f\',data,0x3d0,100.,0.,0.)\n            r=Reader.__new__(Reader);r.classname=lambda p:\'CCSPlayer\'\n            r.mem=NS(read=lambda p,n:bytes(data[:n]))\n            r.fields_available=lambda *a:a==(\'bones\',)\n            r.handle_entity=lambda h:0;r.slot_cache={};r.throw_states={}\n            r.bones=Mock(return_value=((100.,0.,64.),[((100.,0.,40.),(100.,0.,64.))]))\n            with patch(\'reader.client_scale_info\',return_value=dict(maximum=1.,body=1.,head=1.,detected=False)),patch(\'reader.client_scale\',return_value=1.):\n                e=r.read_entity(2,0x1000,control_context=(3,\'普通竞技\',0,False))\n                self.assertEqual(e.team,3);self.assertEqual(e.health,100)\n                self.assertEqual(e.aim_points,[]);r.bones.assert_not_called()\n                # FFA, explicit team override, a changed enemy team and the\n                # separate display reader all retain full current geometry.\n                for context in ((3,\'普通竞技\',0,True),(3,\'普通竞技\',3,False),(2,\'普通竞技\',0,False),None):\n                    got=r.read_entity(2,0x1000,control_context=context)\n                    self.assertEqual(got.head,(100.,0.,64.))\n                self.assertEqual(r.bones.call_count,4)\n\n        def test_pose_cache_is_per_snapshot_and_keeps_head_body_scales_distinct(self):\n            import struct\n            from aim_points import world_samples,world_hitboxes\n            origin=(100.,0.,0.);blob=struct.pack(\'<12f\',1,0,0,100,0,1,0,0,0,0,1,32)\n            cache={};defs=[(\'head\',\'head\',0,(0.,0.,0.),2.,0),(\'body\',\'torso\',0,(0.,0.,0.),2.,10)]\n            samples=world_samples(defs,blob,{0:True},origin,4.,2.,3.,pose_cache=cache)\n            boxes=world_hitboxes([(0,1,(-2.,)*3+(2.,)*3),(0,2,(-2.,)*3+(2.,)*3)],blob,origin,4.,2.,3.,pose_cache=cache)\n            self.assertEqual([p.position[2] for p in samples],[96.,64.])\n            self.assertEqual([b.origin[2] for b in boxes],[96.,64.]);self.assertEqual(len(cache),2)\n            r,data=bone_scene();old={};new={}\n            r.bones(0x1000,(550.,0.,0.),data,old)\n            # Different entity data must be decoded, with no previous pose memo.\n            struct.pack_into(\'<i\',data,0x5e0,1)\n            r.bones(0x1000,(550.,0.,0.),data,new,aim_key=\'0:0:c\')\n            self.assertEqual(new[\'aim_points\'],[])\n\n        def test_short_stale_frame_releases_then_resumes_without_rmb_repress(self):\n            for profile in (USP,XT97):\n                f=scene(p=profile,generic=False);tick(f,10.)\n                self.assertTrue(f.control.pressed)\n                f.now[0]=10.24;f.frame.stamp=10.\n                f.control.step(f.reader,f.frame,f.cfg,f.weapon,f.wall)\n                self.assertFalse(f.control.pressed);self.assertTrue(f.control.input_armed)\n                self.assertTrue(f.control.diagnostic[\'input_gate\'][\'resume_on_fresh_frame\'])\n                d=tick(f,10.25)\n                self.assertNotIn(\'请先松开\',f.control.reason)\n                self.assertTrue(f.control.input_armed,d)\n\n        def test_long_stall_and_session_change_still_require_release(self):\n            for change in (\'long\',\'local\',\'map\',\'future\'):\n                f=scene(p=USP,generic=False);tick(f,10.)\n                f.now[0]=10.7 if change==\'long\' else 10.24;f.frame.stamp=10.\n                if change==\'local\':f.frame.local.serial+=1\n                elif change==\'map\':f.frame.map_name=\'maps/new.bsp\'\n                elif change==\'future\':f.frame.stamp=11.\n                f.control.step(f.reader,f.frame,f.cfg,f.weapon,f.wall)\n                self.assertFalse(f.control.pressed,change);self.assertFalse(f.control.input_armed,change)\n                tick(f,10.8)\n                self.assertFalse(f.control.input_armed,change)\n\n        def test_focus_loss_during_stale_pause_still_disarms(self):\n            f=scene();tick(f,10.)\n            f.now[0]=10.24;f.frame.stamp=10.\n            f.control.step(f.reader,f.frame,f.cfg,f.weapon,f.wall)\n            f.inputs.active=False\n            f.control.step(f.reader,f.frame,f.cfg,f.weapon,f.wall)\n            self.assertFalse(f.control.input_armed);self.assertFalse(f.control.pressed)\n\n        def test_selection_camera_refresh_preserves_entity_age(self):\n            from reader import Reader\n            from unittest.mock import Mock\n            f=scene();original=f.frame\n            matrix=(0.,1.,0.,0.,0.,0.,1.,-64.,0.,0.,0.,0.,1.,0.,0.,0.)\n            current=replace(original,eye=(1.,2.,64.),angles=(0.,3.,0.))\n            r=NS(control_view=Mock(return_value=current),camera_matrix=Mock(return_value=matrix),control_identity=Mock())\n            got=Reader.control_selection_view(r,original)\n            self.assertEqual(got.matrix,matrix);self.assertEqual(got.angles,current.angles)\n            self.assertEqual(got.eye,current.eye);self.assertEqual(got.stamp,original.stamp)\n            self.assertIs(got.entities,original.entities);r.control_identity.assert_called_once_with(current)\n\n        def test_new_camera_admits_visible_target_before_old_projection(self):\n            f=scene(p=USP,generic=False);f.cfg.strategy=\'准星最近\'\n            f.frame.matrix=(0.,)*16\n            f.reader.control_view=lambda frame:replace(frame,angles=f.reader.angles)\n            calls=[]\n            def current(frame):\n                calls.append(True)\n                return replace(frame,angles=f.reader.angles,\n                    matrix=(0.,1.,0.,0.,0.,0.,1.,-64.,0.,0.,0.,0.,1.,0.,0.,0.))\n            f.reader.control_selection_view=current\n            d=tick(f,10.)\n            self.assertTrue(calls);self.assertTrue(f.control.pressed,d)\n            self.assertTrue(d[\'selection_projection_refreshed\'])\n\n        def test_weapon_damage_totals_survive_compact_log_budget(self):\n            from compact_log import JournalPolicy\n            policy=JournalPolicy(limit=4096)\n            for i in range(300):\n                data=dict(kind=\'confirmed_damage\',mono=i*.1,weapon=\'CWeaponUSP\',\n                    hitgroup=\'head\' if i%2 else \'chest\',damage=80 if i%2 else 24,\n                    health=20 if i%2 else 76,damage_armor=10 if i%2 else 0)\n                raw=policy.prepare(data)\n                if raw:policy.committed(data,raw)\n            row=policy.snapshot()[\'confirmed_damage_by_weapon\'][\'usp\']\n            self.assertEqual(row[\'events\'],300);self.assertEqual(row[\'head_events\'],150)\n            self.assertEqual(row[\'head_target_survived\'],150)\n            self.assertEqual(row[\'armored_head_events\'],150)\n            self.assertEqual(row[\'head_damage_min\'],80)\n            self.assertLessEqual(policy.used,4096)\n\n        def test_damage_summary_preserves_known_and_unknown_outcomes(self):\n            import json\n            from compact_log import JournalPolicy,summary_bytes\n            policy=JournalPolicy()\n            for data in (dict(damage=129,health=0,damage_armor=0),dict(damage=92),dict(damage=113,health=0,damage_armor=14)):\n                policy.observe(dict(kind=\'confirmed_damage\',weapon=\'m4a1\',hitgroup=\'head\',**data))\n            kept=json.loads(summary_bytes({},policy))[\'logging\'][\'confirmed_damage_by_weapon\'][\'m4a1\']\n            self.assertEqual(kept[\'head_damage_min\'],92);self.assertEqual(kept[\'head_damage_max\'],129)\n            self.assertEqual(kept[\'head_target_zero_health\'],2);self.assertEqual(kept[\'head_target_survived\'],0)\n            self.assertEqual(kept[\'armored_head_events\'],1)\n\n        def test_direct_down_reuses_admission_pose_and_confirms_once(self):\n            for profile in (USP,XT97):\n                f=timed_scene(profile);d=tick(f,10.)\n                self.assertTrue(f.control.pressed,d)\n                self.assertTrue(d[\'fire_commit\'][\'allowed\'])\n                self.assertEqual(f.counts[\'actors\'],2)\n                self.assertTrue(d[\'direct_commit_lane\'])\n\n        def test_aim_write_to_fire_commit_is_under_ten_ms(self):\n            """The fast lane must submit DOWN immediately after the aim write.\n\n            This is a simulated timing gate for the full Controller ->\n            fire_commit -> EngineAttack path. It measures the diagnostic\n            boundary already recorded by the candidate; it does not claim a\n            live game or OS scheduler latency guarantee.\n            """\n            for profile in (USP, XT97):\n                f=timed_scene(profile);d=tick(f,10.)\n                self.assertTrue(d[\'fire_commit\'][\'allowed\'],d)\n                measured=d[\'fire_commit\'].get(\'aim_to_fire_ms\')\n                self.assertIsInstance(measured,(int,float),d)\n                self.assertGreaterEqual(measured,0.,d)\n                self.assertLess(measured,10.,d)\n                self.assertLess(d[\'fire_commit\'].get(\'elapsed_ms\',float(\'inf\')),10.,d)\n\n        def test_simultaneous_strafing_and_moving_bot(self):\n            for local,enemy in ((200.,250.),(-200.,250.),(200.,-250.),(200.,0.)):\n                f=timed_scene(local_speed=local,enemy_speed=enemy);d=tick(f,10.)\n                self.assertTrue(f.control.pressed,(local,enemy,d))\n                self.assertLess(d[\'fire_commit\'][\'error_deg\'],d[\'fire_commit\'][\'fire_tolerance_deg\'])\n                self.assertLessEqual(f.counts[\'actors\'],2)\n\n        def test_current_crosshair_does_not_launch_exit_geometry(self):\n            f=scene();f.cfg.strategy=\'准星最近\'\n            def unexpected(*args):raise AssertionError(\'irrelevant exit geometry scheduled\')\n            f.control.exit_exposure.annotate=unexpected\n            d=tick(f,10.)\n            self.assertEqual(d[\'exit_analysis\'][\'state\'],\'crosshair_only\')\n\n        def test_direct_ray_stops_hidden_candidate_detail(self):\n            from wall_service import WallService\n            f=scene();f.cfg.strategy=\'准星最近\'\n            other=replace(f.reader.entity,index=3,address=0x30000,head=(550.,50.,64.),\n                aim_points=[AimPoint(\'head\',\'head\',(550.,50.,64.),3.,0)])\n            f.frame.entities.append(other)\n            f.frame.matrix=(0.,1.,0.,0.,0.,0.,1.,-64.,0.,0.,0.,0.,1.,0.,0.,0.)\n            w=WallService.__new__(WallService);w.fast_bsp=NS();calls=[]\n            def refresh(frame,e,weapon,*args,**kwargs):\n                calls.append(e.index)\n                for p in e.aim_points:p.visibility=\'visible\';p.penetration=dict(kind=\'clear\',allowed=True)\n                return 1\n            w.refresh_target=refresh\n            w.refresh_candidates(f.frame,f.cfg,f.weapon)\n            self.assertEqual(calls,[2]);self.assertTrue(w.fast_metrics[\'hidden_detail_deferred\'])\n\n        def test_bad_readback_in_direct_lane_still_blocks_down(self):\n            f=scene(p=USP,generic=False,distance=550.);f.reader.bad_readback=True\n            d=tick(f,10.)\n            self.assertFalse(f.control.pressed,d)\n\n        def test_arm_before_head_does_not_stop_search_for_exposed_enemy(self):\n            from wall_service import WallService\n            from aim_points import world_hitboxes\n            import struct\n            f=scene();f.cfg.strategy=\'准星最近\'\n            e=f.reader.entity\n            matrices=b\'\'.join(struct.pack(\'<12f\',1,0,0,x,0,1,0,0,0,0,1,64) for x in (128,100))\n            e.aim_hitboxes=world_hitboxes([(0,1,(-3.,-3.,-3.,3.,3.,3.)),\n                                         (1,4,(-4.,-4.,-4.,4.,4.,4.))],matrices,e.origin)\n            e.head_source=\'head_hitgroup\';e.aim_points=e.aim_points[:1]\n            other=replace(e,index=3,address=0x30000,head=(128.,30.,64.),aim_hitboxes=(),\n                aim_points=[AimPoint(\'head\',\'head\',(128.,30.,64.),3.,0)])\n            f.frame.entities.append(other)\n            f.frame.matrix=(0.,1.,0.,0.,0.,0.,1.,-64.,0.,0.,0.,0.,1.,0.,0.,0.)\n            w=WallService.__new__(WallService);w.fast_bsp=NS();calls=[]\n            def refresh(frame,entity,weapon,*args,**kwargs):\n                calls.append(entity.index)\n                for p in entity.aim_points:p.visibility=\'visible\';p.penetration=dict(kind=\'clear\',allowed=True)\n                return 1\n            w.refresh_target=refresh;w.refresh_candidates(f.frame,f.cfg,f.weapon)\n            self.assertEqual(calls,[2,3]);self.assertTrue(w.fast_metrics[\'direct_found\'])\n\n        def test_final_native_guard_preserved_on_fast_lane(self):\n            for change in (\'view\',\'expired\',\'identity\',\'weapon\'):\n                f=scene(p=USP,generic=False,distance=550.)\n                n=native_input_fixture(f,change);d=tick(f,10.)\n                self.assertNotIn((n.engine.primary,3),n.writes,(change,d))\n\n        def test_selected_pose_reader_is_used_at_input_boundary(self):\n            f=scene(p=USP,generic=False,distance=550.);calls=[]\n            def selected(index,address,key):\n                calls.append(key);return f.reader.read_entity(index,address,with_inventory=False)\n            f.reader.read_aim_entity=selected\n            d=tick(f,10.)\n            self.assertTrue(f.control.pressed,d);self.assertEqual(calls,[\'head\'])\n\n        def test_direct_usp_repeats_at_native_cycle_but_never_early(self):\n            f=scene(p=USP,generic=False,distance=128.)\n            first=tick(f,10.);self.assertTrue(f.control.pressed,first)\n            interval=first[\'fire_cadence\'][\'interval\']\n            self.assertEqual(interval,USP[\'CycleTime\'])\n            self.assertGreater(first[\'fire_cadence\'][\'estimated_policy_interval\'],interval)\n            tick(f,10.02,True);self.assertFalse(f.control.pressed)\n            early=tick(f,10.+interval-.001);self.assertFalse(f.control.pressed,early)\n            due=tick(f,10.+interval+.001);self.assertTrue(f.control.pressed,due)\n            self.assertTrue(due[\'fire_commit\'][\'allowed\'])\n\n        def test_cover_semi_uses_own_cycle_without_estimated_recovery(self):\n            from click_cadence import click_schedule\n            base=dict(cycle=.15,interval=.27,controlled=True,automatic=False,weapon_type=\'pistol\',\n                      eligible_geometry=True,engine_spread_verified=False)\n            direct=click_schedule(dict(base,direct=True),{},10.15,False,10.)\n            cover=click_schedule(dict(base,direct=False),{},10.15,False,10.)\n            self.assertTrue(direct[\'ready\']);self.assertTrue(direct[\'removed_unverified_direct_recovery\'])\n            self.assertTrue(cover[\'ready\']);self.assertAlmostEqual(cover[\'interval\'],.15)\n            self.assertAlmostEqual(cover[\'configured_interval\'],.27)\n\n        def test_selected_point_keeps_full_hitgroups_scales_and_model_cache(self):\n            for scale in (1.,2.):\n                r,data=bone_scene(scale);full={};selected={};again={}\n                r.bones(0x1000,(550.,0.,0.),data,full)\n                r.bones(0x1000,(550.,0.,0.),data,selected,aim_key=\'0:0:c\')\n                r.bones(0x1000,(550.,0.,0.),data,again)\n                self.assertEqual(len(selected[\'aim_points\']),1)\n                self.assertEqual(selected[\'aim_points\'][0].position,(550.,0.,64.*scale))\n                self.assertEqual(selected[\'aim_hitboxes\'],full[\'aim_hitboxes\'])\n                self.assertEqual([b.group for b in selected[\'aim_hitboxes\']],[1,2])\n                self.assertEqual(again[\'aim_points\'],full[\'aim_points\'])\n                self.assertGreater(len(again[\'aim_points\']),1)\n\n        def test_selected_point_does_not_reuse_previous_hitbox_set(self):\n            import struct\n            r,data=bone_scene();struct.pack_into(\'<i\',data,0x5e0,1);meta={}\n            r.bones(0x1000,(550.,0.,0.),data,meta,aim_key=\'0:0:c\')\n            self.assertEqual(meta[\'aim_points\'],[]);self.assertEqual(len(meta[\'aim_hitboxes\']),2)\n\n        def test_decision_log_keeps_input_boundary_reason_within_budget(self):\n            import json,tempfile\n            from battle_log import BattleLog\n            from maintenance_contract import weapon_frame\n            from compact_log import encode\n            with tempfile.TemporaryDirectory(prefix=\'bot_latency_\') as tmp:\n                log=BattleLog(tmp,set(),clock=lambda:10.);f,_=weapon_frame();log._start(f)\n                rows=[];log.event=lambda kind,**data:rows.append(dict(kind=kind,**data))\n                try:\n                    context=dict(fire_allowed=False,direct_commit_lane=True,\n                                 fire_commit=dict(status=\'pose_expired_after_weapon\',allowed=False))\n                    log.aim_fire_decision(f,NS(target=3,pressed=False,reason=\'tracking\'),context,1.,2.)\n                    row=json.loads(encode(rows[-1]))\n                    self.assertEqual(row[\'fire_commit\'][\'status\'],\'pose_expired_after_weapon\')\n                    self.assertTrue(row[\'direct_commit_lane\'])\n                    self.assertLessEqual(len(encode(row)),8192)\n                finally:log.close()\n\n    stream=io.StringIO();result=unittest.TextTestRunner(stream=stream,verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(Tests))\n    if not result.wasSuccessful():raise AssertionError(stream.getvalue())\n    return dict(passed=True,tests=result.testsRun,game_attached=False,game_input=False,\n                modeled_read_timing=True,live_latency_verified=False,live_hit_rate_verified=False)\n')
_EMBEDDED['model_precision_contract'] = (1, '"""Model-relative head-point and cadence regressions; no live process/input."""\nimport io,unittest\nfrom dataclasses import replace\nfrom aim_points import AimPoint,select_aim_view\nfrom combat37_contract import scene,tick,USP\n\ndef run():\n    class Tests(unittest.TestCase):\n        def test_native_model_uses_eye_ring_when_spread_fits(self):\n            f=scene(p=USP,generic=False,distance=128.);e=f.reader.entity\n            e.aim_points=[AimPoint(\'eye:0\',\'head\',e.head,3.,-10,visibility=\'visible\',penetration={\'kind\':\'clear\',\'allowed\':True}),\n                          AimPoint(\'head:c\',\'head\',e.head,7.,0,visibility=\'visible\',penetration={\'kind\':\'clear\',\'allowed\':True})]\n            self.assertEqual(select_aim_view(f.frame,e,USP,10.).aim_id,\'eye:0\')\n\n        def test_far_native_model_uses_larger_head_center_for_followups(self):\n            f=scene(p=USP,generic=False,distance=804.);e=f.reader.entity\n            e.aim_points=[AimPoint(\'eye:0\',\'head\',e.head,1.8,-10,visibility=\'visible\',penetration={\'kind\':\'clear\',\'allowed\':True}),\n                          AimPoint(\'head:c\',\'head\',e.head,7.,0,visibility=\'visible\',penetration={\'kind\':\'clear\',\'allowed\':True})]\n            v=select_aim_view(f.frame,e,USP,10.);self.assertEqual(v.aim_id,\'head:c\')\n            d=tick(f,10.);self.assertTrue(d[\'fire_cadence\'][\'first_shot\'])\n            self.assertTrue(d[\'fire_cadence\'][\'direct_precision_hold\'])\n\n        def test_generic_character_stays_body_only(self):\n            f=scene(p=USP,generic=True,distance=128.);e=f.reader.entity;e.model=\'player/tr_qipao01/tr_qipao01.mdl\';e.head_source=\'anatomical_generic\'\n            e.aim_points=[AimPoint(\'torso\',\'torso\',(128.,0.,44.),12.,1,visibility=\'visible\',penetration={\'kind\':\'clear\',\'allowed\':True})]\n            self.assertEqual(select_aim_view(f.frame,e,USP,10.).aim_part,\'torso\')\n\n        def test_tfa_normal_head_and_shot_region_remain_native(self):\n            f=scene(p=USP,generic=False,distance=160.);e=f.reader.entity;e.model=\'player/tr_tfa_sa2/tr_tfa_sa2.mdl\';e.head_source=\'head_hitgroup\'\n            e.aim_points=[AimPoint(\'eye:0\',\'head\',e.head,2.,-10,visibility=\'visible\',penetration={\'kind\':\'clear\',\'allowed\':True}),\n                          AimPoint(\'head:c\',\'head\',e.head,7.,0,visibility=\'visible\',penetration={\'kind\':\'clear\',\'allowed\':True})]\n            self.assertEqual(select_aim_view(f.frame,e,USP,10.).aim_part,\'head\')\n            d=tick(f,10.);self.assertEqual(d[\'shot_region\'][\'intended_part\'],\'head\')\n\n        def test_usp_small_head_followup_uses_own_cycle(self):\n            f=scene(p=USP,generic=False,distance=804.);d=tick(f,10.)\n            self.assertTrue(f.control.pressed);self.assertTrue(d[\'fire_cadence\'][\'direct_precision_hold\'])\n            interval=d[\'fire_cadence\'][\'interval\'];self.assertAlmostEqual(interval,USP[\'CycleTime\'])\n            self.assertAlmostEqual(d[\'fire_cadence\'][\'estimated_policy_interval\'],USP[\'RecoveryTimeStand\'])\n            tick(f,10.02,True);self.assertFalse(f.control.pressed)\n            tick(f,10.+interval-.001);self.assertFalse(f.control.pressed)\n            d=tick(f,10.+interval+.001);self.assertTrue(f.control.pressed,d)\n\n        def test_auto_small_head_uses_recovery_with_final_pose_gate(self):\n            for name,cycle in ((\'m4a1\',.09),(\'acr\',.088)):\n                p=dict(USP,profile_name=name,WeaponType=\'rifle\',FullAuto=1,CycleTime=cycle,RecoveryTimeStand=.37762)\n                f=scene(p=p,generic=False,distance=1024.);d=tick(f,10.)\n                self.assertTrue(f.control.pressed)\n                self.assertTrue(d[\'fire_cadence\'][\'direct_precision_hold\'])\n                self.assertAlmostEqual(d[\'fire_cadence\'][\'estimated_policy_interval\'],p[\'RecoveryTimeStand\'])\n                self.assertAlmostEqual(d[\'fire_cadence\'][\'interval\'],cycle)\n                self.assertAlmostEqual(d[\'fire_cadence\'][\'effective_interval\'],cycle)\n                tick(f,10.02,True)\n                d=tick(f,10.+cycle+.001);self.assertTrue(f.control.pressed,d)\n\n        def test_wait_does_not_pretend_to_fix_running_or_air_spread(self):\n            for flags,speed in ((1,200.),(0,0.),(0,200.)):\n                f=scene(p=USP,generic=False,distance=804.)\n                f.frame.local.flags=flags;f.frame.local.velocity=(speed,0.,0.)\n                d=tick(f,10.);self.assertTrue(d[\'fire_cadence\'][\'direct_precision_hold\'])\n                self.assertAlmostEqual(d[\'fire_cadence\'][\'interval\'],USP[\'CycleTime\'])\n                self.assertAlmostEqual(d[\'fire_cadence\'][\'estimated_policy_interval\'],USP[\'RecoveryTimeStand\'])\n                self.assertFalse(d[\'fire_cadence\'][\'engine_spread_verified\'])\n                self.assertGreater(d[\'fire_cadence\'][\'spread_hint\'],d[\'fire_cadence\'][\'target_angular_radius\'])\n\n        def test_crouch_keeps_recovery_estimate_but_uses_native_cycle(self):\n            f=scene(p=USP,generic=False,distance=804.);f.frame.local.flags=3\n            d=tick(f,10.)\n            self.assertAlmostEqual(d[\'fire_cadence\'][\'estimated_policy_interval\'],USP[\'RecoveryTimeCrouch\'])\n            self.assertAlmostEqual(d[\'fire_cadence\'][\'interval\'],USP[\'CycleTime\'])\n\n        def test_visible_eye_beats_larger_head_behind_obstacle(self):\n            f=scene(p=USP,generic=False,distance=804.);e=f.reader.entity\n            e.aim_points=[AimPoint(\'eye:0\',\'head\',e.head,1.8,-10,visibility=\'visible\',penetration={\'kind\':\'clear\',\'allowed\':True}),\n                          AimPoint(\'head:c\',\'head\',e.head,7.,0,visibility=\'blocked\',penetrable=True,\n                                   penetration={\'kind\':\'penetrable\',\'allowed\':True})]\n            self.assertEqual(select_aim_view(f.frame,e,USP,10.,allow_penetration=True).aim_id,\'eye:0\')\n\n        def test_arm_in_front_does_not_win_by_large_radius(self):\n            from c4_precision_contract import box\n            f=scene(p=USP,generic=False,distance=804.);e=f.reader.entity\n            e.aim_hitboxes=(box(e.head,(7.,7.,7.),1),box((780.,0.,64.),(1.,1.,1.),4))\n            e.aim_points=[AimPoint(\'head:c\',\'head\',e.head,7.,0,visibility=\'visible\',penetration={\'kind\':\'clear\',\'allowed\':True}),\n                          AimPoint(\'head:side\',\'head\',(804.,4.,64.),2.,1,visibility=\'visible\',penetration={\'kind\':\'clear\',\'allowed\':True})]\n            self.assertEqual(select_aim_view(f.frame,e,USP,10.).aim_id,\'head:side\')\n\n        def test_real_wall_probe_starts_at_more_robust_native_head(self):\n            from wall_service import WallService\n            from static_prop_guard import StaticPropGuard\n            from types import SimpleNamespace as NS\n            f=scene(p=USP,generic=False,distance=804.);e=f.reader.entity\n            e.aim_points.insert(0,AimPoint(\'0:12:eye:0\',\'head\',(804.,0.,65.),1.,-10))\n            w=WallService.__new__(WallService);calls=[]\n            w.fast_bsp=NS(trace=lambda a,b:calls.append(b) or [],surface_materials={},static_fire_guard=StaticPropGuard([],{}))\n            w.map_args=(\'\',f.frame.map_name,None)\n            w.refresh_target(f.frame,e,USP,probe_only=True)\n            self.assertEqual(calls,[e.head])\n\n        def test_shot_tail_retains_every_received_event_after_detail_budget(self):\n            import json\n            from compact_log import JournalPolicy,summary_bytes,SUMMARY_BYTES\n            p=JournalPolicy(limit=4096)\n            for i in range(300):\n                row=dict(kind=\'ammo_decreased\',mono=i*.15,observation_id=str(i),rounds=1,weapon=\'USP\',\n                         prior_aim=dict(target=25,target_serial=745,model=\'player/tr_tfa_sa2/tr_tfa_sa2.mdl\',aim_part=\'head\'))\n                raw=p.prepare(row)\n                if raw:p.committed(row,raw)\n                p.prepare(dict(kind=\'confirmed_damage\',mono=i*.15+.01,victim_index=25,sequence=i,weapon=\'usp\',hitgroup=\'left arm\',damage=23,health=32))\n            s=p.snapshot();tail=s[\'precision_tail\']\n            self.assertEqual(len(tail),96);self.assertEqual(tail[-1][\'sequence\'],299)\n            self.assertEqual(tail[-2][\'observation_id\'],\'299\')\n            self.assertEqual(sum(x[\'kind\']==\'ammo_decreased\' for x in tail),48)\n            raw=summary_bytes({},p);self.assertLessEqual(len(raw),SUMMARY_BYTES)\n            # A nearly full aggregate summary trims the evidence ring rather\n            # than losing the entire summary to a budget exception.\n            raw=summary_bytes(dict(payload=\'x\'*(SUMMARY_BYTES-15000)),p)\n            self.assertLessEqual(len(raw),SUMMARY_BYTES)\n            self.assertTrue(json.loads(raw)[\'logging\'][\'precision_tail_trimmed_for_summary_budget\'])\n\n    out=io.StringIO();r=unittest.TextTestRunner(stream=out,verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(Tests))\n    if not r.wasSuccessful():raise AssertionError(out.getvalue())\n    return dict(passed=True,tests=r.testsRun,game_attached=False,game_input=False,live_hit_rate_verified=False)\n')
_EMBEDDED['log_process'] = (1, '"""Independent log aggregation; bounded immutable messages, no game handles/input.\n\nOnly the private anonymous pipes of our own child carry these packets. The\nrestricted decoder accepts primitives and SimpleNamespace, never game objects.\n"""\nimport collections, datetime, io, json, os, pickle, queue, struct, subprocess, sys, threading, time, uuid\nfrom pathlib import Path\nfrom types import SimpleNamespace as NS\n\nMAX_PACKET=2*1024*1024\nMAX_BYTES=8*1024*1024\nFRAME_LIMIT=96\nQUEUE_LIMIT=128\nSTATE_FIELDS=(\'sink_available\',\'sink_error\',\'sink_dropped\',\'sink_diagnostics\',\n              \'native_hurt_authoritative\',\'render_metrics\',\'memory_health\')\nENTITY_FIELDS=(\'index\',\'address\',\'serial\',\'classname\',\'team\',\'health\',\'zombie_class\',\n    \'velocity\',\'flags\',\'head\',\'origin\',\'enemy\',\'visibility\',\'model\',\'head_source\',\'head_bone\',\n    \'dormant\',\'can_throw\',\'throwable_source\',\'pose_status\',\'pose_confirmed\',\'pose_evidence\',\n    \'ragdoll_present\',\'pose_diagnostic\')\nFRAME_FIELDS=(\'stamp\',\'map_name\',\'weapon\',\'ammo\',\'weapon_state\',\'eye\',\'angles\',\'punch\',\n    \'mode\',\'native_mode_id\',\'free_for_all\',\'protected_complete\',\'protected_errors\')\n\ndef fields(obj,names):\n    return NS(**{key:getattr(obj,key) for key in names if hasattr(obj,key)})\n\ndef snapshot_entity(entity):\n    result=fields(entity,ENTITY_FIELDS)\n    # BattleLog uses only len(skeleton), not coordinates.\n    result.skeleton=range(len(getattr(entity,\'skeleton\',())))\n    return result\n\ndef snapshot_frame(frame,detailed=True):\n    result=fields(frame,FRAME_FIELDS);result.local=snapshot_entity(frame.local)\n    result.log_detail_sample=bool(detailed)\n    result.entities=([snapshot_entity(e) for e in frame.entities] if detailed else\n        [NS(index=e.index,address=e.address,serial=e.serial,health=e.health,head=e.head,origin=e.origin)\n         for e in frame.entities])\n    result.protected=[]\n    for obj in (frame.protected if detailed else ()):\n        row=fields(obj,(\'index\',\'bounds\',\'dormant\',\'sampled_at\'))\n        row.hitboxes=[fields(b,(\'bounds\',\'origin\',\'inverse\',\'scales\')) for b in obj.hitboxes]\n        result.protected.append(row)\n    return result\n\nclass Decoder(pickle.Unpickler):\n    def find_class(self,module,name):\n        if (module,name)==(\'types\',\'SimpleNamespace\'):return NS\n        if (module,name)==(\'builtins\',\'range\'):return range\n        raise ValueError(\'Unexpected diagnostic object: \'+module+\'.\'+name)\n\ndef encode_packet(message):\n    raw=pickle.dumps(message,protocol=4)\n    if len(raw)>MAX_PACKET:raise ValueError(\'Diagnostic packet exceeds bound\')\n    return struct.pack(\'<I\',len(raw))+raw\n\ndef read_exact(stream,count):\n    parts=[]\n    while count:\n        chunk=stream.read(count)\n        if not chunk:raise EOFError(\'Diagnostic pipe closed\')\n        parts.append(chunk);count-=len(chunk)\n    return b\'\'.join(parts)\n\ndef read_packet(stream):\n    size=struct.unpack(\'<I\',read_exact(stream,4))[0]\n    if not 0<size<=MAX_PACKET:raise ValueError(\'Invalid diagnostic packet length\')\n    value=Decoder(io.BytesIO(read_exact(stream,size))).load()\n    if not isinstance(value,dict):raise ValueError(\'Invalid diagnostic packet\')\n    return value\n\ndef write_packet(stream,packet):\n    remaining=memoryview(packet)\n    while remaining:\n        count=stream.write(remaining)\n        if not count:raise OSError(\'Short diagnostic pipe write\')\n        remaining=remaining[count:]\n    stream.flush()\n\nclass LogProcess:\n    """BattleLog facade: preserve FIFO observations, never wait in frame()."""\n    def __init__(self,folder,local_names,clock=time.monotonic,rotate_bytes=None,entry=None):\n        self.folder=Path(folder);self.local_names=set(local_names);self.clock=clock\n        self.entry=Path(entry or globals()[\'BUNDLE_ENTRY\']);self.rotate_bytes=rotate_bytes\n        self.current=None;self.error=\'\';self.sink_available=False;self.sink_error=\'尚未连接伤害日志\'\n        self.transport_id=uuid.uuid4().hex\n        self.sink_dropped=0;self.sink_diagnostics={};self.native_hurt_authoritative=False\n        self.render_metrics={};self.memory_health={};self._closed=False\n        self._cv=threading.Condition();self._items=collections.deque();self._bytes=0\n        self.proc=None;self.generation=0;self.sequence=0;self.ack=0;self.last_reply=0.\n        self.dropped=0;self.serialization_failures=0;self.transport_lost=0;self.restarts=0\n        self.child_status={};self.packet_bytes=0;self.submit_ms=0.;self._deadline=None\n        self._detail_at=-float(\'inf\');self._detail_generation=-1\n        self._detail_scope=None\n        self.last_fault=\'\';self.last_frame_packet_bytes=0\n        self._stop=threading.Event();self._send_done=False\n        self.thread=threading.Thread(target=self._supervise,name=\'log-process-transport\',daemon=True)\n        self.thread.start()\n\n    def metrics(self):\n        return dict(backend=\'independent_process\',pid=getattr(self.proc,\'pid\',None),transport_id=self.transport_id,\n            generation=self.generation,restarts=self.restarts,queued=len(self._items),\n            queued_bytes=self._bytes,queue_limit=QUEUE_LIMIT,queue_byte_limit=MAX_BYTES,\n            dropped_messages=self.dropped,unacknowledged_on_exit=self.transport_lost,\n            serialization_failures=self.serialization_failures,last_submit_ms=self.submit_ms,\n            last_packet_bytes=self.packet_bytes,last_frame_packet_bytes=self.last_frame_packet_bytes,\n            last_fault=self.last_fault,child=dict(self.child_status))\n\n    def _send(self,op,args=(),important=False):\n        start=time.perf_counter()\n        try:\n            with self._cv:\n                if self._closed:self.dropped+=1;return False\n                if len(self._items)>=(QUEUE_LIMIT if important else FRAME_LIMIT):\n                    self.droppe