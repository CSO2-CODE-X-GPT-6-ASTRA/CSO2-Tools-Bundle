_EMBEDDED['aim_fire_acceptance_contract'] = (1, '"""User\'s ESP-consumer contract through Controller -> commit -> EngineAttack."""\nimport copy,io,json,struct,unittest\nfrom dataclasses import replace\nfrom unittest.mock import patch\nfrom aim_points import AimPoint,ProtectedEntity,select_aim_view\nfrom esp_targeting import consume,state\nfrom moving_fire_contract import native_fixture\n\n\ndef publication(f, verdict=\'visible\'):\n    actor=f.reader.entity\n    points=[dict(key=p.key,part=p.part,position=list(p.position),radius=p.radius,\n        priority=p.priority,visibility=verdict if p.part==\'head\' else p.visibility,\n        head_region=p.head_region,model_local=p.model_local) for p in actor.aim_points]\n    return dict(schema=\'esp.targets.v1\',pid=f.reader.mem.pid,map=f.frame.map_name,\n        weapon=f.frame.weapon,stamp=f.now[0],eye=list(f.frame.eye),source=f.frame.source,\n        local=[f.frame.local.index,f.frame.local.serial],\n        actors=[dict(identity=[actor.index,actor.address,actor.serial,actor.model],\n            team=actor.team,health=actor.health,pose_stamp=f.now[0],points=points)])\n\n\ndef native_step(f,t,verdict=\'visible\',message=None):\n    f.now[0]=t;f.frame.stamp=t;f.frame.weapon_state[\'stamp\']=t\n    f.frame.angles=f.reader.angles\n    message=publication(f,verdict) if message is None else message\n    sample,info=consume(f.frame,json.loads(json.dumps(message)),f.reader.mem.pid,t,f.reader)\n    assert sample is not None,info\n    with patch(\'weapon_input_guard.time.monotonic\',side_effect=lambda:f.now[0]):\n        f.control.step(f.reader,sample,f.cfg,f.weapon,None)\n    return f.control.diagnostic\n\n\ndef run():\n    class Tests(unittest.TestCase):\n        def test_each_positive_state_writes_native_down_without_obstacle_metadata(self):\n            for verdict in (\'visible\',\'penetrable\'):\n                f=native_fixture();f.cfg.wallbang=False;f.cfg.walls=True\n                for p in f.reader.entity.aim_points:\n                    p.penetration=dict(allowed=False,kind=\'blocked\',requires_native_trace=True)\n                message=publication(f,verdict)\n                for p in message[\'actors\'][0][\'points\']:p[\'visibility\']=verdict\n                d=native_step(f,10.,verdict,message)\n                self.assertIn((0x90000,3),f.native_writes,d)\n                self.assertEqual(d[\'visibility\'],verdict)\n        def test_blocked_never_aims_or_fires_even_when_old_metadata_is_positive(self):\n            f=native_fixture()\n            for p in f.reader.entity.aim_points:p.visibility=\'blocked\';p.penetrable=True;p.penetration={\'allowed\':True,\'kind\':\'penetration\'}\n            native_step(f,10.,\'blocked\')\n            self.assertEqual(f.reader.writes,[]);self.assertNotIn((0x90000,3),f.native_writes)\n        def test_no_duplicate_bone_or_obstacle_read_in_full_native_chain(self):\n            f=native_fixture()\n            f.reader.read_entity=lambda *a,**kw:(_ for _ in ()).throw(AssertionError(\'duplicate bones\'))\n            f.wall.refresh_target=lambda *a,**kw:(_ for _ in ()).throw(AssertionError(\'obstacle recheck\'))\n            d=native_step(f,10.)\n            self.assertTrue(f.control.pressed,d)\n        def test_alive_unchanged_health_never_causes_stop(self):\n            f=native_fixture();hp=f.reader.entity.health\n            for i in range(50):\n                if i and i%5==0:f.frame.ammo-=1\n                d=native_step(f,10.+i*.01)\n                self.assertTrue(f.control.pressed,d)\n                with patch(\'weapon_input_guard.time.monotonic\',side_effect=lambda:f.now[0]):\n                    self.assertFalse(f.control.service_fire_release(f.reader,f.frame))\n            self.assertEqual(f.reader.entity.health,hp)\n            self.assertEqual([v for a,v in f.native_writes if a==0x90000],[3])\n        def test_semi_auto_clip_confirmation_release_and_followup(self):\n            f=native_fixture();f.weapon[\'FullAuto\']=0\n            native_step(f,10.);f.frame.ammo-=1\n            native_step(f,10.02);native_step(f,10.12)\n            self.assertEqual([v for a,v in f.native_writes if a==0x90000],[3,4,3])\n        def test_head_blocked_body_clear_then_head_reappears(self):\n            f=native_fixture();actor=f.reader.entity\n            actor.aim_points=[AimPoint(\'head\',\'head\',actor.head,3.,0,\'blocked\'),\n                AimPoint(\'torso\',\'torso\',(150.,0.,44.),12.,10,\'visible\')]\n            d=native_step(f,10.,\'blocked\');self.assertEqual(d[\'aim_part\'],\'torso\');self.assertTrue(f.control.pressed)\n            d=native_step(f,10.12,\'visible\');self.assertEqual(d[\'aim_part\'],\'head\');self.assertTrue(f.control.pressed)\n        def test_all_six_parts_on_each_generic_model_are_eligible(self):\n            for model in (\'tr_ysht\',\'tr_qipao01\',\'tr_san\'):\n                for part in (\'head\',\'torso\',\'pelvis\',\'body\',\'arm\',\'leg\'):\n                    f=native_fixture();actor=f.reader.entity\n                    actor.model=\'models/player/\'+model+\'.mdl\';actor.head_source=\'anatomical_generic\'\n                    actor.aim_points=[AimPoint(part,part,actor.head,3.,0,\'visible\')]\n                    d=native_step(f,10.);self.assertEqual(d[\'aim_part\'],part);self.assertTrue(f.control.pressed,d)\n        def test_visible_body_wins_over_obstructed_head(self):\n            f=native_fixture();actor=f.reader.entity\n            actor.aim_points=[AimPoint(\'head\',\'head\',actor.head,3.,0,\'blocked\'),\n                AimPoint(\'arm\',\'arm\',(150.,8.,60.),4.,10,\'visible\')]\n            d=native_step(f,10.,\'blocked\');self.assertEqual(d[\'aim_part\'],\'arm\');self.assertTrue(f.control.pressed,d)\n        def test_ghost_hostage_overlap_selects_nonintersecting_enemy_bone(self):\n            f=native_fixture();f.frame.mode=\'stealth\';actor=f.reader.entity\n            actor.aim_points=[AimPoint(\'head\',\'head\',actor.head,3.,0,\'visible\'),\n                AimPoint(\'arm\',\'arm\',(150.,28.,44.),5.,10,\'visible\')]\n            f.frame.protected=[ProtectedEntity(9,0x30000,((70.,-3.,60.),(80.,3.,68.)),sampled_at=10.)]\n            d=native_step(f,10.);self.assertEqual(d[\'aim_part\'],\'arm\');self.assertTrue(f.control.pressed,d)\n        def test_non_ghost_ignores_hostages(self):\n            f=native_fixture();f.frame.mode=\'普通竞技\'\n            f.frame.protected=[ProtectedEntity(9,0x30000,((70.,-3.,60.),(80.,3.,68.)),sampled_at=10.)]\n            d=native_step(f,10.);self.assertEqual(d[\'aim_part\'],\'head\');self.assertTrue(f.control.pressed,d)\n        def test_input_background_menu_invalid_weapon_empty_and_bad_readback_stop(self):\n            for condition in (\'foreground\',\'menu\',\'weapon\',\'empty\',\'view\'):\n                f=native_fixture()\n                if condition==\'foreground\':f.inputs.foreground=lambda pid:False\n                if condition==\'menu\':f.reader.game_ui_visible=lambda:True\n                if condition==\'weapon\':f.reader.handle_entity=lambda h:0\n                if condition==\'empty\':f.frame.ammo=0\n                if condition==\'view\':f.reader.bad_readback=True\n                native_step(f,10.)\n                self.assertNotIn((0x90000,3),f.native_writes,condition)\n        def test_publication_original_stamp_does_not_renew_with_camera(self):\n            f=native_fixture();m=publication(f);sample,info=consume(f.frame,m,f.reader.mem.pid,10.121,f.reader)\n            self.assertIsNone(sample);self.assertEqual(info[\'status\'],\'session_or_age_mismatch\')\n        def test_wrong_pid_map_serial_model_and_weapon_drop_publication(self):\n            for field in (\'pid\',\'map\',\'serial\',\'model\',\'weapon\'):\n                f=native_fixture();m=publication(f)\n                if field in (\'pid\',\'map\',\'weapon\'):m[field]=\'different\'\n                elif field==\'serial\':m[\'actors\'][0][\'identity\'][2]+=1\n                else:m[\'actors\'][0][\'identity\'][3]=\'different\'\n                sample,info=consume(f.frame,m,f.reader.mem.pid,10.,f.reader)\n                self.assertTrue(sample is None or not sample.entities,field)\n        def test_malformed_messages_do_not_throw(self):\n            f=native_fixture()\n            for value in (None,[],{\'schema\':\'esp.targets.v1\',\'local\':[1,\'bad\']},\n                dict(publication(f),actors=\'bad\'),dict(publication(f),eye=[1,2])):\n                sample,info=consume(f.frame,value,f.reader.mem.pid,10.,f.reader)\n                self.assertTrue(sample is None or not sample.entities)\n        def test_cross_source_requires_both_native_identities(self):\n            from server_esp import TABLE\n            f=native_fixture();m=publication(f);m.update(source=\'server\',server_base=0x100000)\n            f.reader.mods={\'server.dll\':(0x100000,0x100000,\'fixture\')}\n            m[\'actors\'][0][\'identity\'][1]=0x30000\n            read=f.reader.mem.read\n            f.reader.mem.read=lambda address,size:struct.pack(\'<II\',0x30000,f.reader.entity.serial) if address==0x100000+TABLE+2*16 else read(address,size)\n            sample,info=consume(f.frame,m,f.reader.mem.pid,10.,f.reader)\n            self.assertEqual(len(sample.entities),1,info);self.assertEqual(sample.entities[0].address,f.reader.entity.address)\n            f.reader.mem.read=lambda address,size:b\'\\0\'*8\n            sample,info=consume(f.frame,m,f.reader.mem.pid,10.,f.reader)\n            self.assertEqual(sample.entities,[])\n        def test_missing_velocity_and_repeated_current_pose_do_not_wait(self):\n            f=native_fixture(None)\n            for i in range(12):\n                d=native_step(f,10.+i*.002)\n                self.assertTrue(f.control.pressed,d)\n        def test_short_failure_recovers_on_next_valid_publication(self):\n            f=native_fixture();f.reader.bad_readback=True\n            native_step(f,10.);self.assertFalse(f.control.pressed)\n            f.reader.bad_readback=False\n            native_step(f,10.01);self.assertTrue(f.control.pressed)\n        def test_measured_simulated_io_latency_and_native_down(self):\n            f=native_fixture();mem=f.reader.mem\n            for name in (\'read\',\'vec\',\'i32\',\'u32\'):\n                original=getattr(mem,name)\n                def cost(*args,_fn=original):f.now[0]+=.0001;return _fn(*args)\n                setattr(mem,name,cost)\n            d=native_step(f,10.)\n            self.assertTrue(f.control.pressed,d);self.assertGreater(d[\'first_aim_to_fire_ms\'],0.)\n            self.assertLessEqual(d[\'first_aim_to_fire_ms\'],100.)\n        def test_no_inventory_or_secondary_down_commands(self):\n            f=native_fixture();native_step(f,10.);f.control.release()\n            self.assertTrue(all(a==0x90000 for a,v in f.native_writes),f.native_writes)\n        def test_death_to_next_target_requests_native_down_within_60ms(self):\n            f=native_fixture();first=f.reader.entity\n            second=replace(first,index=3,address=0x25000,serial=3,\n                head=(150.,8.,64.),origin=(150.,8.,0.),\n                aim_points=[AimPoint(\'head\',\'head\',(150.,8.,64.),3.,0,\'visible\')])\n            f.frame.entities=[first,second]\n            native_step(f,10.)\n            first.health=0;f.now[0]=10.01;f.control.observe_lifecycle(f.frame)\n            read=f.reader.mem.read\n            def measured_read(*args):f.now[0]+=.0001;return read(*args)\n            f.reader.mem.read=measured_read\n            f.reader.entity=second\n            d=native_step(f,10.01)\n            self.assertEqual(f.control.target,3,d);self.assertTrue(f.control.pressed,d)\n            self.assertLessEqual(d[\'kill_to_switch_ms\'],60.)\n            self.assertLessEqual((d[\'fire_down_completed_stamp\']-d[\'death_seen_stamp\'])*1000,60.)\n            self.assertEqual([v for a,v in f.native_writes if a==0x90000],[3,4,3])\n        def test_t_force_overrides_regular_aim_toggle_and_stops_when_toggled_off(self):\n            f=native_fixture();f.cfg.aim=False;f.cfg.tab_force_fire=True\n            with patch(\'weapon_input_guard.time.monotonic\',side_effect=lambda:f.now[0]):\n                f.advance(10.)\n            self.assertTrue(f.control.pressed)\n            f.cfg.tab_force_fire=False\n            with patch(\'weapon_input_guard.time.monotonic\',side_effect=lambda:f.now[0]):\n                f.advance(10.01)\n            self.assertFalse(f.control.pressed)\n        def test_retired_ray_transport_never_grants_aim_or_fire(self):\n            f=native_fixture();actor=f.reader.entity;p=actor.aim_points[0]\n            message=dict(pid=f.reader.mem.pid,scope=dict(map=f.frame.map_name,weapon=f.frame.weapon,\n                source=f.frame.source,local=[f.frame.local.index,f.frame.local.address,f.frame.local.serial]),\n                rays=[dict(identity=[actor.index,actor.address,actor.serial,actor.model],stamp=10.,\n                    eye=list(f.frame.eye),point=list(p.position),part=p.part,\n                    path=dict(kind=\'penetration\',allowed=True))])\n            sample,info=consume(f.frame,message,f.reader.mem.pid,10.,f.reader)\n            self.assertIsNone(sample);self.assertEqual(info[\'status\'],\'no_publication\')\n            with patch(\'weapon_input_guard.time.monotonic\',return_value=10.):\n                f.control.step(f.reader,replace(f.frame,entities=[]),f.cfg,f.weapon,None)\n            self.assertNotIn((0x90000,3),f.native_writes)\n\n        def test_current_positive_transport_fires_without_obstacle_metadata(self):\n            f=native_fixture();message=publication(f,\'penetrable\')\n            for p in message[\'actors\'][0][\'points\']:p[\'visibility\']=\'penetrable\'\n            d=native_step(f,10.,message=message)\n            self.assertTrue(f.control.pressed,d);self.assertEqual(d[\'visibility\'],\'penetrable\')\n    stream=io.StringIO();suite=unittest.defaultTestLoader.loadTestsFromTestCase(Tests)\n    result=unittest.TextTestRunner(stream=stream,verbosity=2).run(suite)\n    print(stream.getvalue())\n    if not result.wasSuccessful():raise AssertionError(\'aim/fire acceptance failed\')\n    return dict(tests=result.testsRun,passed=True,real_controller_commit_engineattack=True,\n        scope=\'aim_fire_esp_consumer_only\',simulated=True,live_confirmation=False)\n')

_EMBEDDED['attack_cadence'] = (1, '"""Native primary-attack edges; no health, wall, spread or velocity waits."""\nfrom weapon_profiles import weapon_cycle\n\n\ndef assess(control, frame, weapon, now):\n    cycle=weapon_cycle(weapon)\n    automatic=bool((weapon or {}).get(\'FullAuto\',False))\n    record=control.cadence.records.get(control.cadence.current,{})\n    confirmed=record.get(\'shots_in_press\',0)>0\n    release=bool(control.pressed and not automatic and\n        (confirmed or now-control.press_time>=min(.05,cycle)))\n    # Holding an automatic primary delegates its cycle to the game. A target\n    # switch must not add another software cooldown before the new DOWN.\n    native_ready=automatic or (now-control.last_fire>=cycle and now-control.last_release>=.012)\n    manual=bool(control.win.down(1) and not control.pressed and now-control.last_release>.08)\n    ready=not control.pressed and native_ready and not manual\n    return dict(ready=ready,release=release,continuous=automatic,controlled=not automatic,\n        cycle=cycle,interval=cycle,burst_limit=None if automatic else 1,\n        press_timeout_ms=min(.05,cycle)*1000,wait_ms=max(0.,cycle-(now-control.last_fire))*1000,\n        wait_reason=\'manual_primary\' if manual else \'native_cycle\' if not native_ready else \'\',\n        basis=\'native_cycle_and_primary_edges\',engine_spread_verified=False)\n')

_EMBEDDED['esp_targeting'] = (1, '"""Three-state ESP targeting contract; consumers never trace obstacles."""\nimport math,struct\nfrom dataclasses import replace\nfrom aim_points import AimPoint\nfrom geometry import finite\nfrom esp_sources import MAX_AGE as MAX_TARGET_AGE\n\nPOSITIVE = (\'visible\', \'penetrable\')\n\ndef state(value):\n    return \'visible\' if value == \'visible\' else \'penetrable\' if value in POSITIVE else \'blocked\'\n\ndef public_path(visibility, detail=None, *, allow_blocked=False):\n    verdict = state(visibility)\n    return dict(kind=\'visible\' if verdict == \'visible\' else \'penetration\' if verdict == \'penetrable\' else \'blocked\',\n                allowed=verdict != \'blocked\' or allow_blocked, basis=\'esp_published_point\',\n                esp_verdict=verdict, forced_blocked=verdict==\'blocked\' and allow_blocked)\n\ndef point_reachable(point, allow_penetration=True, *, allow_blocked=False):\n    return state(point.visibility) != \'blocked\' or allow_blocked\n\ndef entity_reachable(entity, allow_penetration=True):\n    return state(entity.visibility) != \'blocked\'\n\ndef selection_tier(visibility, path=None, allow_penetration=True):\n    verdict = state(visibility)\n    return 0 if verdict == \'visible\' else 2 if verdict == \'penetrable\' else 3\n\ndef packet(raw, classified, pid, now):\n    """Direct callers export the finished renderer, never reconstruct raw bones."""\n    from esp_feedback import shared_verdict_packet,shared_scope\n    if (type(raw.stamp) not in (int,float) or not math.isfinite(raw.stamp)\n            or not 0<=now-raw.stamp<=MAX_TARGET_AGE or shared_scope(raw)!=shared_scope(classified)):return {}\n    return shared_verdict_packet(classified,pid,now)\n\n\ndef consume(frame, message, pid, now, reader):\n    """Match published bones to the current native identity; never run BSP here."""\n    if not isinstance(message, dict) or message.get(\'schema\') != \'esp.targets.v1\':\n        return None, dict(status=\'no_publication\', accepted=0)\n    stamp = message.get(\'stamp\')\n    local = message.get(\'local\') or ()\n    try:\n        compatible = (message.get(\'pid\') == pid and message.get(\'map\') == frame.map_name\n            and message.get(\'weapon\') == frame.weapon and len(local) == 2\n            and local[0] == frame.local.index and (int(local[1]) & 0x3ff) == (frame.local.serial & 0x3ff)\n            and type(stamp) in (int, float) and math.isfinite(stamp) and 0 <= now-stamp <= MAX_TARGET_AGE\n            and finite(message.get(\'eye\', ())) and len(message.get(\'eye\', ())) == 3)\n    except (TypeError, ValueError, OverflowError):\n        compatible = False\n    if not compatible:\n        return None, dict(status=\'session_or_age_mismatch\', accepted=0)\n    by_index = {e.index: e for e in frame.entities}\n    entities = []\n    rows = message.get(\'actors\')\n    if not isinstance(rows, list):\n        return None, dict(status=\'invalid_publication\', accepted=0)\n    for row in rows:\n        try:\n            index, address, serial, model = row[\'identity\']\n            current = by_index.get(index)\n            if (current is None or current.model != model or current.team != row[\'team\']\n                    or current.health <= 0 or current.dormant or row[\'health\'] <= 0\n                    or (current.serial & 0x3ff) != (serial & 0x3ff)):\n                continue\n            if message.get(\'source\') == frame.source and current.address != address:\n                continue\n            # Cross-source addresses differ. Both native entries must still\n            # refer to the exact published SERVER and current CLIENT actors.\n            if message.get(\'source\') != frame.source:\n                from server_esp import TABLE\n                base = message.get(\'server_base\')\n                native=(getattr(reader,\'mods\',{}) or {}).get(\'server.dll\')\n                if message.get(\'source\') != \'server\' or not native or base != native[0]:\n                    continue\n                if reader.mem.read(base+TABLE+index*16, 8) != struct.pack(\'<II\', address, serial):\n                    continue\n            points = []\n            for p in row[\'points\']:\n                position = tuple(p[\'position\']); radius = p[\'radius\']\n                if (len(position) != 3 or not finite(position) or type(radius) not in (int, float)\n                        or not math.isfinite(radius) or radius <= 0 or not isinstance(p[\'key\'],str)\n                        or p[\'part\'] not in (\'head\',\'torso\',\'pelvis\',\'body\',\'arm\',\'leg\',\'eye\')\n                        or type(p[\'priority\']) is not int):\n                    continue\n                verdict = state(p[\'visibility\'])\n                points.append(AimPoint(p[\'key\'], p[\'part\'], position, radius, p[\'priority\'],\n                    visibility=verdict, wall_age_ms=max(0., now-stamp)*1000,\n                    penetrable=verdict == \'penetrable\', penetration=public_path(verdict),\n                    head_region=p.get(\'head_region\', \'center\'), model_local=p.get(\'model_local\')))\n            if not points:continue\n            verdict = min((state(p.visibility) for p in points), key=lambda v: selection_tier(v), default=\'blocked\')\n            pose_stamp = row[\'pose_stamp\']\n            if type(pose_stamp) not in (int, float) or not math.isfinite(pose_stamp) or not 0 <= now-pose_stamp <= MAX_TARGET_AGE:\n                continue\n            entities.append(replace(current, aim_points=points, aim_points_validated=True,\n                visibility=verdict, penetration=public_path(verdict),\n                health=current.health, pose_sample_stamp=pose_stamp))\n        except (KeyError, ValueError, TypeError, OverflowError, AttributeError, RuntimeError, struct.error):\n            continue\n    current_frame=replace(frame,entities=entities)\n    # A full CLIENT population read is not the lifetime of the ESP pose.\n    # Re-read local identity/view/weapon; only their new snapshot may renew\n    # the control frame. Published target stamps remain unchanged.\n    if entities and callable(getattr(reader,\'control_view\',None)):\n        current_frame=reader.control_view(current_frame)\n        if callable(getattr(reader,\'control_weapon\',None)):\n            current_frame=reader.control_weapon(current_frame)\n        local_stamp=current_frame.weapon_state.get(\'stamp\')\n        if type(local_stamp) in (int,float) and math.isfinite(local_stamp) and abs(now-local_stamp)<=.15:\n            current_frame=replace(current_frame,stamp=local_stamp)\n    diagnostic=dict(status=\'consumed\',accepted=len(entities),\n        age_ms=max(0.,now-stamp)*1000,source=message.get(\'source\'),owner=message.get(\'owner\'),\n        render_stamp=message.get(\'render_stamp\'),population_age_ms=max(0.,now-frame.stamp)*1000,\n        local_state_stamp=current_frame.stamp,\n        states={v:sum(e.visibility==v for e in entities) for v in (\'visible\',\'penetrable\',\'blocked\')})\n    current_frame.esp_publication=diagnostic\n    return current_frame,diagnostic\n\n\n')

_EMBEDDED['aim_fire_cleanup_contract'] = (1, '"""Regressions for the removed consumer gates, through native primary writes."""\nimport ast\nimport inspect\nimport io\nimport json\nimport math\nimport struct\nimport unittest\nfrom dataclasses import replace\nfrom types import SimpleNamespace as NS\nfrom unittest.mock import patch\nfrom aim_fire_acceptance_contract import publication, native_step\nfrom aim_points import AimPoint, ProtectedEntity, filter_hostage_aim_points\nfrom aim_tracking import aim_tolerance\nfrom moving_fire_contract import native_fixture\nfrom engine_attack import Mouse2Binding\nfrom geometry import angle_error, aim_angles\n\n\ndef binding_fixture(value=\'slot3\'):\n    import right_click_contract\n    parent=ast.parse(inspect.getsource(right_click_contract.run)).body[0]\n    node=next(n for n in parent.body if isinstance(n,ast.ClassDef) and n.name==\'Environment\')\n    env=dict(NS=NS,struct=struct,Mouse2Binding=Mouse2Binding)\n    exec(compile(ast.Module(body=[node],type_ignores=[]),\'native_binding_fixture\',\'exec\'),env)\n    return env[\'Environment\'](value)\n\n\ndef current_message(f):\n    return publication(f)\n\n\n\ndef run():\n    class Tests(unittest.TestCase):\n        def test_small_native_readback_motion_inside_hitbox_fires(self):\n            f=native_fixture();write=f.reader.set_angles\n            def moving_write(out):\n                write(out);f.reader.angles=(out[0],out[1]+.05,0.)\n            f.reader.set_angles=moving_write\n            d=native_step(f,10.)\n            self.assertTrue(f.control.pressed,d);self.assertIn((0x90000,3),f.native_writes)\n            self.assertGreater(d[\'write_readback_drift_deg\'],.03)\n            self.assertLess(d[\'write_readback_error_deg\'],d[\'tolerance_deg\'])\n\n        def test_small_motion_during_final_weapon_read_fires_and_continues(self):\n            f=native_fixture();verify=f.control.trigger.verify_fire_weapon;calls=[0]\n            def moving_verify():\n                ok=verify();calls[0]+=1\n                if calls[0]==2:f.reader.angles=(f.reader.angles[0],f.reader.angles[1]+.05,0.)\n                return ok\n            f.control.trigger.verify_fire_weapon=moving_verify\n            d=native_step(f,10.)\n            self.assertTrue(f.control.pressed,d)\n            self.assertGreater(d[\'fire_commit\'][\'post_weapon_sight_drift_deg\'],.03)\n            f.frame.ammo-=1\n            for i in range(1,15):\n                d=native_step(f,10.+i*.008)\n                self.assertTrue(f.control.pressed,d)\n            self.assertEqual([v for a,v in f.native_writes if a==0x90000],[3])\n\n        def test_motion_outside_hitbox_during_final_read_still_rejects(self):\n            f=native_fixture();verify=f.control.trigger.verify_fire_weapon;calls=[0]\n            def displaced():\n                ok=verify();calls[0]+=1\n                if calls[0]==2:f.reader.angles=(f.reader.angles[0],f.reader.angles[1]+3.,0.)\n                return ok\n            f.control.trigger.verify_fire_weapon=displaced\n            d=native_step(f,10.)\n            self.assertNotIn((0x90000,3),f.native_writes)\n            self.assertEqual(d[\'fire_commit\'][\'status\'],\'sight_outside_published_hitbox_after_weapon\')\n\n        def test_each_generic_model_prioritizes_penetrable_head_over_clear_body(self):\n            for model in (\'tr_ysht\',\'tr_qipao01\',\'tr_san\'):\n                f=native_fixture();a=f.reader.entity\n                a.model=\'models/player/\'+model+\'.mdl\';a.head_source=\'anatomical_generic\'\n                a.aim_points=[AimPoint(\'head\',\'head\',a.head,3.,0,\'penetrable\'),\n                    AimPoint(\'arm\',\'arm\',(150.,5.,60.),5.,10,\'visible\')]\n                d=native_step(f,10.,\'penetrable\')\n                self.assertEqual(d[\'aim_part\'],\'head\');self.assertEqual(d[\'visibility\'],\'penetrable\')\n                self.assertTrue(f.control.pressed,d)\n\n        def test_in_range_candidate_wins_when_crosshair_target_is_out_of_range(self):\n            f=native_fixture();a=f.reader.entity\n            a.aim_points=[AimPoint(\'head\',\'head\',a.head,3.,0,\'visible\')]\n            b=replace(a,index=3,address=0x25000,serial=3,head=(70.,20.,64.),origin=(70.,20.,0.),\n                aim_points=[AimPoint(\'head\',\'head\',(70.,20.,64.),3.,0,\'visible\')])\n            m=publication(f);f.reader.entity=b;m[\'actors\']+=publication(f)[\'actors\']\n            f.frame.entities=[a,b];f.weapon[\'Range\']=100.\n            d=native_step(f,10.,message=m)\n            self.assertEqual(f.control.target,3,d);self.assertTrue(f.control.pressed,d)\n            self.assertIn(dict(index=2,reject_stage=\'outside_weapon_range\'),d[\'selection_rejections\'])\n\n        def test_expired_candidate_does_not_starve_fresh_candidate(self):\n            f=native_fixture();a=f.reader.entity\n            b=replace(a,index=3,address=0x25000,serial=3,head=(150.,10.,64.),origin=(150.,10.,0.),\n                aim_points=[AimPoint(\'head\',\'head\',(150.,10.,64.),3.,0,\'visible\')])\n            a.pose_sample_stamp=9.8;f.reader.entity=b;b.pose_sample_stamp=10.\n            f.frame.entities=[a,b]\n            f.frame.weapon_state[\'stamp\']=10.\n            with patch(\'weapon_input_guard.time.monotonic\',side_effect=lambda:f.now[0]):\n                f.control.step(f.reader,f.frame,f.cfg,f.weapon,None)\n            self.assertEqual(f.control.target,3);self.assertTrue(f.control.pressed,f.control.diagnostic)\n\n        def test_current_published_point_survives_client_eye_and_pose_drift(self):\n            for change in (\'eye\',\'point\',\'missing_client_bones\'):\n                f=native_fixture();m=current_message(f);point=tuple(m[\'actors\'][0][\'points\'][0][\'position\'])\n                if change==\'eye\':f.frame.eye=(f.frame.eye[0]+.001,*f.frame.eye[1:])\n                elif change==\'point\':\n                    p=f.reader.entity.aim_points[0]\n                    f.reader.entity.aim_points=[replace(p,position=(p.position[0]+.001,*p.position[1:]))]\n                else:\n                    f.reader.entity.aim_points=[];f.reader.entity.head=None\n                    f.reader.entity.aim_points_validated=True\n                d=native_step(f,10.,message=m)\n                self.assertTrue(f.control.pressed,d);self.assertEqual(d[\'aim_point\'],point)\n\n        def test_current_stale_identity_and_empty_points_never_grant_a_shot(self):\n            from esp_targeting import consume\n            for changed in (\'age\',\'identity\',\'map\',\'blocked\',\'invalid_position\'):\n                f=native_fixture();m=current_message(f)\n                if changed==\'age\':m[\'stamp\']=9.8\n                elif changed==\'identity\':m[\'actors\'][0][\'identity\'][2]+=1\n                elif changed==\'map\':m[\'map\']=\'other_map\'\n                elif changed==\'blocked\':m[\'actors\'][0][\'points\']=[]\n                else:m[\'actors\'][0][\'points\']=[]\n                sample,info=consume(f.frame,m,f.reader.mem.pid,10.,f.reader)\n                self.assertTrue(sample is None or not sample.entities,(changed,info))\n\n        def test_native_input_probes_do_not_depend_on_client_bones(self):\n            from feature_caps import probe\n            f=native_fixture();r=f.reader\n            r.capability_failures={};r.client=0x100000;r.field_ok={\'bones\':False};r.field_errors={}\n            fields=[]\n            with patch(\'feature_caps.menu\'),patch(\'feature_caps.fields\',side_effect=lambda r,*names:fields.extend(names)),\\\n                    patch(\'feature_caps.command_entry\'),patch.object(Mouse2Binding,\'verify\'),\\\n                    patch.object(Mouse2Binding,\'binding\',return_value=\'\'):\n                for key in (\'aim\',\'aim_npcs\',\'fire\'):probe(r,key)\n            self.assertNotIn(\'bones\',fields);self.assertNotIn(\'m_hRagdoll\',fields)\n            self.assertIn(\'m_hActiveWeapon\',fields)\n            d=native_step(f,10.);self.assertTrue(f.control.pressed,d)\n\n        def test_ghost_nonintersecting_bone_uses_producer_geometry_once(self):\n            f=native_fixture();f.frame.mode=\'stealth\';a=f.reader.entity\n            a.aim_points=[AimPoint(\'head\',\'head\',a.head,3.,0,\'visible\')]\n            f.frame.protected=[ProtectedEntity(9,0x30000,((70.,12.,60.),(80.,16.,68.)),sampled_at=9.94)]\n            self.assertEqual(filter_hostage_aim_points(f.frame)[\'filtered\'],0)\n            # This older age-expanded/BSP helper must not participate in either\n            # selection or native commit; its removal is checked behaviorally.\n            with patch(\'aim_points.hostage_ray_status\',side_effect=AssertionError(\'duplicate hostage policy\')):\n                d=native_step(f,10.)\n            self.assertTrue(f.control.pressed,d);self.assertEqual(d[\'aim_part\'],\'head\')\n\n        def test_ghost_overlap_falls_back_to_clear_arm_and_other_modes_ignore(self):\n            for mode,expected in ((\'stealth\',\'arm\'),(\'普通竞技\',\'head\')):\n                f=native_fixture();f.frame.mode=mode;a=f.reader.entity\n                a.aim_points=[AimPoint(\'head\',\'head\',a.head,3.,0,\'visible\'),\n                    AimPoint(\'arm\',\'arm\',(150.,28.,44.),5.,10,\'visible\')]\n                f.frame.protected=[ProtectedEntity(9,0x30000,((70.,-3.,60.),(80.,3.,68.)),sampled_at=10.)]\n                d=native_step(f,10.)\n                self.assertTrue(f.control.pressed,d);self.assertEqual(d[\'aim_part\'],expected)\n\n        def test_disappeared_target_switch_has_observation_metric_and_no_wait(self):\n            f=native_fixture();native_step(f,10.);a=f.reader.entity\n            b=replace(a,index=3,address=0x25000,serial=3,head=(150.,8.,64.),origin=(150.,8.,0.),\n                aim_points=[AimPoint(\'head\',\'head\',(150.,8.,64.),3.,0,\'visible\')])\n            f.frame.entities=[b];f.reader.entity=b;f.now[0]=10.01\n            f.control.observe_lifecycle(f.frame)\n            d=native_step(f,10.01)\n            self.assertEqual(f.control.target,3);self.assertTrue(f.control.pressed,d)\n            self.assertEqual(d[\'target_end_reason\'],\'disappeared\')\n            self.assertLessEqual(d[\'target_end_to_lock_ms\'],60.)\n            self.assertNotIn(\'kill_to_switch_ms\',d)\n            self.assertEqual([v for a,v in f.native_writes if a==0x90000],[3,4,3])\n\n        def test_lost_binding_submission_recovers_preserves_original_and_never_switches(self):\n            e=binding_fixture(\'slot3\');self.assertFalse(e.b.step(e.r,True))\n            e.queue.clear();e.submitted();e.clock+=.26\n            self.assertFalse(e.b.step(e.r,True));self.assertEqual(len(e.sent),2)\n            e.execute();self.assertTrue(e.b.step(e.r,True));self.assertEqual(e.b.before,\'slot3\')\n            e.press();self.assertEqual(e.switches,0)\n            e.held=False;self.assertFalse(e.b.close());e.execute();self.assertTrue(e.b.close())\n            self.assertEqual(e.current,\'slot3\')\n\n        def test_slow_inflight_binding_command_is_not_duplicated_or_restored_out_of_order(self):\n            e=binding_fixture();e.b.step(e.r,True)\n            for _ in range(15):\n                e.clock+=1.;self.assertFalse(e.b.step(e.r,True))\n            self.assertEqual(len(e.sent),1)\n            self.assertFalse(e.b.close());e.execute();self.assertFalse(e.b.close())\n            e.execute();self.assertTrue(e.b.close());self.assertEqual(e.current,\'slot3\')\n\n        def test_confirmed_empty_binding_pause_does_not_block_real_fire(self):\n            f=native_fixture();b=f.control.trigger.aim_binding\n            b.reader=f.reader;b.ready=False;b.reservation_confirmed=True\n            b.source_was_empty=True;b.last_observed=\'\'\n            d=native_step(f,10.)\n            self.assertTrue(f.control.pressed,d);self.assertIn((0x90000,3),f.native_writes)\n\n        def test_pending_binding_has_truthful_stop_reason_and_recovers_native_down(self):\n            f=native_fixture();b=f.control.trigger.aim_binding;b.reader=f.reader;b.ready=False\n            d=native_step(f,10.)\n            self.assertFalse(f.control.pressed);self.assertEqual(d[\'stop_reason\'],\'rmb_reservation_pending\')\n            b.ready=True\n            d=native_step(f,10.008);self.assertTrue(f.control.pressed,d)\n            self.assertIn((0x90000,3),f.native_writes)\n\n    stream=io.StringIO()\n    result=unittest.TextTestRunner(stream=stream,verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(Tests))\n    print(stream.getvalue())\n    if not result.wasSuccessful():raise AssertionError(\'aim/fire cleanup regression failed\')\n    return dict(tests=result.testsRun,passed=True,real_controller_commit_engineattack=True,\n        simulated=True,live_confirmation=False)\n')

_EMBEDDED['t_rmb_contract'] = (1, '"""T eligibility toggle and RMB actions through the published native pipeline."""\nimport copy, io, unittest\nfrom dataclasses import replace\nfrom unittest.mock import patch\nfrom aim_fire_acceptance_contract import native_step, publication\nfrom moving_fire_contract import native_fixture\nfrom esp_targeting import consume, packet\n\n\ndef run():\n    class Tests(unittest.TestCase):\n        def message(self, f, visibility):\n            value = publication(f, visibility)\n            for row in value[\'actors\']:\n                for point in row[\'points\']:point[\'visibility\'] = visibility\n            return value\n\n        def test_t_alone_never_writes_aim_or_primary_down(self):\n            for visibility in (\'visible\', \'penetrable\', \'blocked\'):\n                f = native_fixture();f.cfg.tab_force_fire = True\n                f.inputs.down = lambda key: False\n                with patch.object(f.reader, \'set_angles\', wraps=f.reader.set_angles) as aim:\n                    native_step(f, 10., message=self.message(f, visibility))\n                    aim.assert_not_called()\n                self.assertFalse(f.control.pressed);self.assertNotIn((0x90000, 3), f.native_writes)\n\n        def test_same_rmb_pipeline_adds_only_blocked_eligibility(self):\n            for enabled in (False, True):\n                for visibility in (\'visible\', \'penetrable\', \'blocked\'):\n                    f = native_fixture();f.cfg.tab_force_fire = enabled\n                    with patch.object(f.reader, \'set_angles\', wraps=f.reader.set_angles) as aim:\n                        d = native_step(f, 10., message=self.message(f, visibility))\n                        expected = enabled or visibility != \'blocked\'\n                        self.assertEqual(aim.called, expected, d)\n                        self.assertEqual(f.control.pressed, expected, d)\n                        self.assertEqual((0x90000, 3) in f.native_writes, expected, d)\n                    if expected:\n                        self.assertEqual(d[\'visibility\'], visibility)\n                        self.assertEqual(d[\'fire_commit\'][\'status\'], \'ready\')\n                        self.assertEqual(d[\'shot_path\'], \'blocked\' if visibility == \'blocked\'\n                                         else \'visible\' if visibility == \'visible\' else \'penetration\')\n\n        def test_rmb_release_stops_before_scanning_and_prevents_new_aim(self):\n            f = native_fixture();f.cfg.tab_force_fire = True;held = [True]\n            f.inputs.down = lambda key: key == 2 and held[0]\n            native_step(f, 10., message=self.message(f, \'blocked\'))\n            self.assertTrue(f.control.pressed)\n            held[0] = False\n            self.assertTrue(f.control.service_fire_release(f.reader, f.frame))\n            with patch.object(f.reader, \'set_angles\', wraps=f.reader.set_angles) as aim:\n                native_step(f, 10.01, message=self.message(f, \'blocked\'));aim.assert_not_called()\n            self.assertFalse(f.control.pressed)\n            self.assertEqual([v for a,v in f.native_writes if a == 0x90000], [3,4])\n\n        def test_t_off_while_rmb_held_rejects_blocked_without_new_aim(self):\n            f = native_fixture();f.cfg.tab_force_fire = True\n            native_step(f, 10., message=self.message(f, \'blocked\'))\n            f.cfg.tab_force_fire = False\n            with patch.object(f.reader, \'set_angles\', wraps=f.reader.set_angles) as aim:\n                native_step(f, 10.01, message=self.message(f, \'blocked\'));aim.assert_not_called()\n            self.assertFalse(f.control.pressed)\n            self.assertEqual([v for a,v in f.native_writes if a == 0x90000], [3,4])\n\n        def test_force_aims_at_esp_position_instead_of_client_bones(self):\n            f = native_fixture();f.cfg.tab_force_fire = True\n            message = self.message(f, \'blocked\')\n            head = next(p for p in message[\'actors\'][0][\'points\'] if p[\'part\'] == \'head\')\n            original = tuple(head[\'position\']);head[\'position\'][1] += 12.\n            d = native_step(f, 10., message=message)\n            self.assertTrue(f.control.pressed, d)\n            self.assertEqual(d[\'aim_point\'], tuple(head[\'position\']))\n            self.assertNotEqual(d[\'aim_point\'], original)\n\n        def test_live_ammo_focus_reservation_and_identity_checks_remain(self):\n            for condition in (\'empty\', \'focus\', \'reservation\', \'identity\'):\n                f = native_fixture();f.cfg.tab_force_fire = True\n                message = self.message(f, \'blocked\')\n                if condition == \'empty\':f.frame.ammo = 0\n                if condition == \'focus\':f.inputs.foreground = lambda pid: False\n                if condition == \'reservation\':\n                    binding = f.control.trigger.aim_binding\n                    binding.reader = f.reader;binding.ready = False;binding.reservation_confirmed = False\n                if condition == \'identity\':message[\'actors\'][0][\'identity\'][2] += 1\n                native_step(f, 10., message=message)\n                self.assertFalse(f.control.pressed, condition)\n                self.assertNotIn((0x90000, 3), f.native_writes, condition)\n\n        def test_stale_esp_never_falls_back_to_client_in_t_mode(self):\n            f = native_fixture();f.cfg.tab_force_fire = True\n            message = self.message(f, \'blocked\');message[\'stamp\'] = 9.8\n            sample, info = consume(f.frame, message, f.reader.mem.pid, 10., f.reader)\n            self.assertIsNone(sample, info)\n            f.frame.weapon_state[\'stamp\'] = 10.\n            with patch(\'weapon_input_guard.time.monotonic\', side_effect=lambda:f.now[0]):\n                f.control.step(f.reader, replace(f.frame, entities=[]), f.cfg, f.weapon, None)\n            self.assertNotIn((0x90000, 3), f.native_writes)\n\n        def test_followup_native_fire_after_ammo_confirmation(self):\n            for automatic in (True, False):\n                f = native_fixture();f.cfg.tab_force_fire = True;f.weapon[\'FullAuto\'] = int(automatic)\n                native_step(f, 10., message=self.message(f, \'blocked\'))\n                f.frame.ammo -= 1;f.frame.shots += 1;f.reader.entity.health -= 1\n                for t in (10.02, 10.04, 10.08, 10.12, 10.16, 10.20, 10.24, 10.28, 10.32, 10.4):\n                    f.now[0] = t\n                    d = native_step(f, t, message=self.message(f, \'blocked\'))\n                    if automatic:self.assertTrue(f.control.pressed, d)\n                edges = [v for a,v in f.native_writes if a == 0x90000]\n                if automatic:self.assertEqual(edges, [3])\n                else:self.assertGreaterEqual(edges.count(3), 2, edges);self.assertIn(4, edges)\n                f.inputs.down = lambda key: False\n                self.assertTrue(f.control.service_fire_release(f.reader, f.frame))\n                self.assertEqual(f.native_writes[-1], (0x90000, 4))\n\n        def test_producer_keeps_all_raw_points_and_exact_clear_endpoint(self):\n            f = native_fixture();raw = copy.deepcopy(f.frame);shown = copy.deepcopy(raw)\n            actor = shown.entities[0];head = actor.head\n            actor.display_visibility_stamp = 10.;actor.esp_visible_points = (head,)\n            value = packet(raw, shown, f.reader.mem.pid, 10.)\n            points = value[\'actors\'][0][\'points\']\n            self.assertEqual({tuple(p[\'position\']) for p in points},\n                             {tuple(p.position) for p in raw.entities[0].aim_points})\n            self.assertTrue(all(p[\'visibility\'] == (\'visible\' if tuple(p[\'position\']) == head else \'blocked\')\n                                for p in points))\n            self.assertTrue(all(type(p[\'priority\']) is int for p in points))\n\n        def test_producer_exports_real_head_and_joints_for_all_three_models(self):\n            for model in (\'tr_ysht\', \'tr_qipao01\', \'tr_san\'):\n                f = native_fixture();raw = copy.deepcopy(f.frame);actor = raw.entities[0]\n                actor.model = f\'models/player/{model}.mdl\';actor.aim_points = [];actor.aim_points_validated = False\n                actor.skeleton = [(actor.head, (150., 0., 48.)), ((150., 0., 48.), (150., 0., 32.))]\n                value = packet(raw, copy.deepcopy(raw), f.reader.mem.pid, 10.)\n                points = value[\'actors\'][0][\'points\']\n                self.assertEqual({tuple(p[\'position\']) for p in points}, {actor.head, (150.,0.,48.), (150.,0.,32.)})\n                self.assertTrue(all(p[\'visibility\'] == \'blocked\' for p in points))\n\n        def test_render_retiming_and_stale_visibility_never_renew_evidence(self):\n            f = native_fixture();raw = copy.deepcopy(f.frame);shown = copy.deepcopy(raw)\n            shown.entities[0].esp_visible_points = (shown.entities[0].head,)\n            shown.entities[0].display_visibility_stamp = 9.8;shown.stamp = 10.\n            presentation = publication(f)\n            value = packet(raw, shown, f.reader.mem.pid, 10.)\n            self.assertTrue(all(p[\'visibility\'] == \'blocked\' for p in value[\'actors\'][0][\'points\']))\n            raw.stamp = 9.8\n            self.assertEqual(packet(raw, shown, f.reader.mem.pid, 10.), {})\n\n        def test_native_head_fallback_keeps_obstacle_signal_on_generic_rigs(self):\n            from wall_service import WALL_SIGNAL_SCHEMA, _wall_publish_weapon_key\n            for model in (\'tr_ysht\', \'tr_qipao01\', \'tr_san\'):\n                f = native_fixture();raw = copy.deepcopy(f.frame);actor = raw.entities[0]\n                actor.model = f\'models/player/{model}.mdl\';actor.aim_points = [];actor.aim_points_validated = False\n                shown = copy.deepcopy(raw);display = shown.entities[0]\n                display.display_penetration = dict(penetrable=True, schema=WALL_SIGNAL_SCHEMA, kind=\'penetration\', allowed=True,\n                    wall_publish_positive=True, obstacle_assessment_complete=True, map=raw.map_name,\n                    weapon=_wall_publish_weapon_key({\'weapon\':raw.weapon}), profile_hash=\'fixture-profile\',\n                    display_evidence_stamp=9.98, display_ray_eye=raw.eye, display_ray_head=actor.head,\n                    display_point_part=\'head\')\n                value = packet(raw, shown, f.reader.mem.pid, 10.)\n                self.assertEqual(value[\'actors\'][0][\'points\'][0][\'visibility\'], \'penetrable\')\n                self.assertEqual(value[\'actors\'][0][\'pose_stamp\'], 10.)\n                display.display_penetration[\'display_evidence_stamp\'] = 9.8\n                value = packet(raw, shown, f.reader.mem.pid, 10.)\n                self.assertEqual(value[\'actors\'][0][\'points\'][0][\'visibility\'], \'penetrable\')\n                self.assertEqual(value[\'actors\'][0][\'pose_stamp\'], 10.)\n                shown.eye = tuple(v + 2 for v in shown.eye)\n                value = packet(raw, shown, f.reader.mem.pid, 10.)\n                self.assertEqual(value[\'actors\'][0][\'points\'][0][\'visibility\'], \'blocked\')\n\n        def test_mismatched_classifier_session_never_authorizes_raw_geometry(self):\n            f = native_fixture();raw = copy.deepcopy(f.frame);shown = copy.deepcopy(raw)\n            shown.map_name = \'different_map\';shown.entities[0].display_visibility_stamp = 10.\n            shown.entities[0].esp_visible_points = (shown.entities[0].head,)\n            value = packet(raw, shown, f.reader.mem.pid, 10.)\n            self.assertEqual(value,{})\n\n        def test_actual_esp_producer_packet_drives_native_rmb_pipeline(self):\n            for visibility in (\'visible\', \'blocked\'):\n                f = native_fixture();f.cfg.tab_force_fire = True\n                raw = copy.deepcopy(f.frame);actor = raw.entities[0]\n                actor.aim_points = [];actor.aim_points_validated = False\n                shown = copy.deepcopy(raw)\n                if visibility == \'visible\':\n                    shown.entities[0].display_visibility_stamp = 10.\n                    shown.entities[0].esp_visible_points = (actor.head,)\n                message = packet(raw, shown, f.reader.mem.pid, 10.)\n                d = native_step(f, 10., message=message)\n                self.assertEqual(d[\'aim_point\'], actor.head)\n                self.assertEqual(d[\'visibility\'], visibility)\n                self.assertTrue(f.control.pressed, d);self.assertIn((0x90000, 3), f.native_writes)\n\n    output = io.StringIO();result = unittest.TextTestRunner(stream=output, verbosity=2).run(\n        unittest.defaultTestLoader.loadTestsFromTestCase(Tests))\n    if not result.wasSuccessful():raise AssertionError(output.getvalue())\n    return dict(passed=result.wasSuccessful(), tests=result.testsRun, failures=len(result.failures), errors=len(result.errors),\n                real_controller_commit_engineattack=True, live_behavior_verified=False)\n')

_EMBEDDED['esp_handoff_contract'] = (1, '"""Finished renderer -> JSON transport -> native aim/primary attack regression."""\nimport copy,inspect,io,json,struct,unittest\nfrom dataclasses import replace\nfrom types import MethodType,SimpleNamespace as NS\nfrom unittest.mock import patch\nfrom aim_points import AimPoint\nfrom esp_feedback import shared_verdict_packet\nfrom esp_targeting import consume,packet,MAX_TARGET_AGE\nfrom moving_fire_contract import native_fixture\n\n\ndef rendered(f,verdict=\'visible\',shift=12.,stamp=10.):\n    frame=copy.deepcopy(f.frame);frame.stamp=stamp\n    actor=frame.entities[0];actor.pose_sample_stamp=stamp\n    actor.head=(actor.head[0],actor.head[1]+shift,actor.head[2])\n    actor.aim_points=[replace(p,position=(p.position[0],p.position[1]+shift,p.position[2]))\n                      for p in actor.aim_points]\n    actor.visibility=verdict;actor.esp_visible_points=tuple(p.position for p in actor.aim_points)\n    actor.display_visibility_stamp=stamp\n    if verdict==\'penetrable\':actor.display_penetration=dict(penetrable=True,display_evidence_stamp=stamp,display_ray_head=actor.head)\n    return frame\n\n\ndef submit(f,shown,t=None):\n    now=shown.stamp if t is None else t;f.now[0]=now\n    f.frame.weapon_state[\'stamp\']=now;f.frame.angles=f.reader.angles\n    value=shared_verdict_packet(shown,f.reader.mem.pid,now)\n    value=json.loads(json.dumps(value))\n    with patch(\'weapon_input_guard.time.monotonic\',side_effect=lambda:f.now[0]):\n        sample,info=consume(f.frame,value,f.reader.mem.pid,now,f.reader)\n        assert sample is not None,info\n        f.control.step(f.reader,sample,f.cfg,f.weapon,None)\n    f.control.diagnostic[\'esp_publication\']=info\n    return f.control.diagnostic,value\n\n\ndef current_local_reads(f):\n    """Real Reader refresh methods, with native-memory fixture identities."""\n    from reader import Reader\n    r=f.reader;local=f.frame.local;old_global=r.global_addr\n    r.global_addr=lambda key:0x88000 if key==\'entity_entries\' else old_global(key)\n    old_read=r.mem.read;old_vec=r.mem.vec\n    r.mem.read=lambda a,n:struct.pack(\'<II\',local.address,local.serial) if a==0x88000+local.index*16 and n==8 else old_read(a,n)\n    r.mem.vec=lambda a:(0.,0.,64.) if a==local.address+0x18c else (0.,0.,0.) if a==local.address+0x300 else old_vec(a)\n    r.control_identity=MethodType(Reader.control_identity,r)\n    r.control_view=MethodType(Reader.control_view,r)\n    r.control_weapon=MethodType(Reader.control_weapon,r)\n\n\ndef run():\n    evidence={}\n    class Tests(unittest.TestCase):\n        def test_render_visible_and_penetrable_replace_raw_blocked_bones(self):\n            for verdict in (\'visible\',\'penetrable\'):\n                f=native_fixture();f.frame.entities[0].visibility=\'blocked\'\n                shown=rendered(f,verdict)\n                f.frame.entities[0].head=None;f.frame.entities[0].aim_points=[]\n                d,value=submit(f,shown)\n                self.assertEqual(value[\'owner\'],\'esp_render\')\n                self.assertEqual(d[\'aim_point\'],shown.entities[0].head)\n                self.assertEqual(d[\'visibility\'],verdict)\n                self.assertTrue(f.control.pressed,d);self.assertIn((0x90000,3),f.native_writes)\n\n        def test_final_packet_is_exported_without_raw_geometry_reconstruction(self):\n            f=native_fixture();raw=copy.deepcopy(f.frame);shown=rendered(f)\n            raw.entities[0].aim_points=[];raw.entities[0].head=None\n            value=shared_verdict_packet(shown,f.reader.mem.pid,10.)\n            self.assertEqual(packet(raw,shown,f.reader.mem.pid,10.),value)\n\n        def test_renderer_publishes_obstacle_geometry_without_aim_verdict(self):\n            from overlay_service import serve\n            source=inspect.getsource(serve)\n            submit_at=source.index(\'fault_surface.submitted(display_frame)\')\n            export_at=source.index(\'from esp_feedback import shared_geometry_packet\',submit_at)\n            publish_at=source.index("output.post({\'wall_geometry\':shared_geometry_packet(display_frame,")\n            self.assertLess(source.index(\'visibility.update(display_frame,\'),submit_at)\n            self.assertLess(submit_at,export_at);self.assertLess(export_at,publish_at)\n            self.assertIn(\'publication_start=time.monotonic()\',source[submit_at:export_at])\n            self.assertEqual(source.count("output.post({\'wall_geometry\':shared_geometry_packet(display_frame,"),1)\n            self.assertNotIn("output.post({\'targets\':targets})",source)\n            self.assertNotIn(\'targeting_frame=\',source)\n            self.assertNotIn(\'ray_verdicts\',source)\n\n        def test_body_visible_head_blocked_uses_the_rendered_body(self):\n            f=native_fixture();shown=rendered(f)\n            body=next(p for p in shown.entities[0].aim_points if p.part==\'torso\')\n            shown.entities[0].esp_visible_points=(body.position,)\n            d,value=submit(f,shown)\n            self.assertEqual(d[\'aim_part\'],\'torso\');self.assertEqual(d[\'aim_point\'],body.position)\n            self.assertTrue(f.control.pressed,d)\n\n        def test_visible_body_and_final_esp_penetrable_head_prioritize_head(self):\n            f=native_fixture();shown=rendered(f);actor=shown.entities[0]\n            body=next(p for p in actor.aim_points if p.part==\'torso\')\n            actor.esp_visible_points=(body.position,)\n            actor.display_penetration=dict(penetrable=True,display_evidence_stamp=10.,display_ray_head=actor.head)\n            d,value=submit(f,shown)\n            self.assertEqual(value[\'actors\'][0][\'visibility\'],\'visible\')\n            self.assertEqual(d[\'aim_part\'],\'head\');self.assertEqual(d[\'visibility\'],\'penetrable\')\n            self.assertTrue(f.control.pressed,d)\n\n        def test_native_render_rig_without_aimpoint_cache_exports_checked_joints(self):\n            for model in (\'tr_ysht\',\'tr_qipao01\',\'tr_san\'):\n                f=native_fixture();a=f.frame.entities[0];a.model=f\'models/player/{model}.mdl\'\n                shown=rendered(f);a=shown.entities[0];a.aim_points=[];a.aim_points_validated=False\n                body=(150.,12.,44.);a.skeleton=[(a.head,body)];a.esp_visible_points=(body,)\n                d,value=submit(f,shown)\n                self.assertEqual(d[\'aim_point\'],body);self.assertEqual(d[\'aim_part\'],\'body\')\n                self.assertTrue(f.control.pressed,d)\n\n        def test_deliberately_empty_renderer_points_never_reintroduce_head(self):\n            f=native_fixture();shown=rendered(f);a=shown.entities[0]\n            a.aim_points=[];a.aim_points_validated=True\n            a.skeleton=[(a.head,(150.,12.,44.))]\n            self.assertEqual(shared_verdict_packet(shown,f.reader.mem.pid,10.)[\'actors\'],[])\n\n        def test_blocked_only_added_by_t_and_rmb_owns_actions(self):\n            for force,held,expected in ((False,True,False),(True,True,True),(True,False,False)):\n                f=native_fixture();f.cfg.tab_force_fire=force;f.inputs.down=lambda key:key==2 and held\n                with patch.object(f.reader,\'set_angles\',wraps=f.reader.set_angles) as aim:\n                    d,value=submit(f,rendered(f,\'blocked\'))\n                    self.assertEqual(aim.called,expected,d)\n                self.assertEqual(f.control.pressed,expected,d)\n                if expected:\n                    f.inputs.down=lambda key:False\n                    self.assertTrue(f.control.service_fire_release(f.reader,f.frame))\n                    self.assertEqual(f.native_writes[-1],(0x90000,4))\n\n        def test_positive_packets_do_not_call_consumer_bones_or_obstacles(self):\n            f=native_fixture();shown=rendered(f,\'penetrable\')\n            f.reader.read_entity=lambda *a,**kw:(_ for _ in ()).throw(AssertionError(\'consumer rebuilt bones\'))\n            f.wall.refresh_target=lambda *a,**kw:(_ for _ in ()).throw(AssertionError(\'consumer wall classification\'))\n            d,value=submit(f,shown);self.assertTrue(f.control.pressed,d)\n\n        def test_render_pose_age_is_original_even_when_camera_is_fresh(self):\n            f=native_fixture();shown=rendered(f);shown.entities[0].pose_sample_stamp=10.-MAX_TARGET_AGE-.001\n            value=shared_verdict_packet(shown,f.reader.mem.pid,10.)\n            self.assertEqual(value[\'actors\'],[])\n\n        def test_old_ray_evidence_is_blocked_in_fresh_render_frame(self):\n            for verdict in (\'visible\',\'penetrable\'):\n                f=native_fixture();shown=rendered(f,verdict)\n                shown.entities[0].display_visibility_stamp=9.8\n                shown.entities[0].display_penetration={\'display_evidence_stamp\':9.8}\n                d,value=submit(f,shown)\n                self.assertTrue(all(p[\'visibility\']==\'blocked\' for p in value[\'actors\'][0][\'points\']))\n                self.assertFalse(f.control.pressed,d)\n\n        def test_reused_pose_or_alive_grace_is_not_republished_as_current(self):\n            for flag in (\'display_pose_reused\',\'display_alive_grace\'):\n                f=native_fixture();shown=rendered(f);setattr(shown.entities[0],flag,True)\n                self.assertEqual(shared_verdict_packet(shown,f.reader.mem.pid,10.)[\'actors\'],[])\n\n        def test_real_local_refresh_recovers_slow_population_without_renewing_esp(self):\n            f=native_fixture();shown=rendered(f);f.frame.stamp=9.65\n            current_local_reads(f)\n            d,value=submit(f,shown)\n            self.assertTrue(f.control.pressed,d)\n            self.assertGreaterEqual(d[\'esp_publication\'][\'population_age_ms\'],349.)\n            self.assertEqual(value[\'actors\'][0][\'pose_stamp\'],10.)\n            self.assertEqual(d[\'frame_stamp\'],10.)\n\n        def test_slow_population_does_not_make_stale_esp_current(self):\n            f=native_fixture();current_local_reads(f);f.frame.stamp=9.65\n            value=shared_verdict_packet(rendered(f),f.reader.mem.pid,10.)\n            with patch(\'weapon_input_guard.time.monotonic\',side_effect=lambda:10.2):\n                sample,info=consume(f.frame,value,f.reader.mem.pid,10.2,f.reader)\n            self.assertIsNone(sample);self.assertEqual(info[\'status\'],\'session_or_age_mismatch\')\n\n        def test_control_population_skips_bones_and_preserves_inventory_defaults(self):\n            from client_control import ClientControlReader\n            from reader import Reader\n            f=native_fixture();frame=copy.deepcopy(f.frame);actor=frame.entities[0]\n            r=ClientControlReader.__new__(ClientControlReader)\n            r.control_scope=None;r.source_epoch=0;r.entity_stats={}\n            r.mem=NS(pid=1234,read=lambda a,n:struct.pack(\'<II\',actor.address,actor.serial))\n            r.global_addr=lambda key:0x88000;r.control_identity=lambda frame:None\n            with patch.object(Reader,\'frame\',return_value=frame) as scan:\n                result=r.frame()\n            self.assertFalse(scan.call_args.kwargs[\'with_bones\'])\n            self.assertTrue(scan.call_args.kwargs[\'observe_inactive\'])\n            self.assertNotIn(\'with_aimpoints\',scan.call_args.kwargs)\n            self.assertEqual(result.entities[0].serial,actor.serial)\n\n        def test_model_identity_is_still_read_without_rebuilding_control_bones(self):\n            from client_control import ClientControlReader\n            from reader import Reader\n            f=native_fixture();actor=copy.deepcopy(f.reader.entity);actor.model=\'\'\n            header=bytearray(180);header[:4]=b\'IDST\';struct.pack_into(\'<i\',header,4,48)\n            model=b\'player/tr_san.mdl\';header[12:12+len(model)]=model\n            r=ClientControlReader.__new__(ClientControlReader);r.global_addr=lambda key:0x88000\n            entry=0x88000+actor.index*16\n            r.mem=NS(u32=lambda a:0x91000 if a==actor.address+0x918 else 0x92000,\n                read=lambda a,n:s