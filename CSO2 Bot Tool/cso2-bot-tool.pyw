_EMBEDDED['pose_activity'] = (1, '\n\n"""Temporal pose evidence. Motion is an estimate, never a synthetic HP value."""\n\nimport math\n\nfrom collections import deque\n\nfrom geometry import length,sub\n\nfrom target_rules import entity_kind\n\n\n\n\n\nclass PoseActivity:\n\n    def __init__(self):self.tracks={};self.map_name=None\n\n    def update(self,frame):\n\n        if self.map_name!=frame.map_name:self.tracks.clear();self.map_name=frame.map_name\n\n        seen=set()\n\n        for entity in frame.entities:\n\n            key=(entity.index,entity.address,entity.serial,entity.model);seen.add(key)\n\n            points=[p for segment in entity.skeleton for p in segment]\n\n            pose=entity.head\n\n            upright=bool(pose and points and pose[2]-min(p[2] for p in points)>20\n\n                         and pose[2]-entity.origin[2]>18 and not entity.dormant)\n\n            previous=self.tracks.get(key);now=frame.stamp\n\n            state=dict(stamp=now,origin=entity.origin,head=pose,hits=0,active_until=0.)\n\n            if upright and previous and previous[\'head\'] and 0<now-previous[\'stamp\']<=.1:\n\n                dt=now-previous[\'stamp\'];shift=length(sub(entity.origin,previous[\'origin\']))\n\n                pose_change=length(sub(sub(pose,entity.origin),sub(previous[\'head\'],previous[\'origin\'])))\n\n                moving=(.03<shift<=max(16.,600*dt) or .015<pose_change<12.)\n\n                state[\'hits\']=previous[\'hits\']+1 if moving else 0\n\n                state[\'active_until\']=previous[\'active_until\']\n\n                if state[\'hits\']>=3:state[\'active_until\']=now+.25\n\n            entity.pose_active=bool(upright and state[\'active_until\']>=now and state[\'active_until\']>0)\n\n            entity.pose_status=\'站立活动\' if entity.pose_active else \'姿态待确认\'\n\n            entity.pose_confirmed=False;entity.pose_evidence={}\n\n            if entity.health==1 and entity_kind(entity.classname)==\'player\':\n\n                eligible=upright and len(entity.skeleton)>=6 and entity.ragdoll_present is False\n\n                history=previous.get(\'history\',deque()) if previous else deque()\n\n                confirmed_until=previous.get(\'confirmed_until\',0.) if previous else 0.\n\n                if not eligible:\n\n                    history.clear();confirmed_until=0.\n\n                    entity.pose_status=(\'布娃娃排除\' if entity.ragdoll_present else\n\n                                        \'布娃娃状态待确认\' if entity.ragdoll_present is None else \'姿态待确认\')\n\n                else:\n\n                    if history and (now-history[-1][0]>.16 or now<history[-1][0]):history.clear();confirmed_until=0.\n\n                    # Keep a time window, not a frame counter. High sampling\n\n                    # rates cannot turn a single impact into sustained activity.\n\n                    relative=tuple(sub(point,entity.origin) for segment in entity.skeleton for point in segment)\n\n                    lengths=tuple(length(sub(a,b)) for a,b in entity.skeleton)\n\n                    if not history or now-history[-1][0]>=.015:\n\n                        history.append((now,entity.origin,relative,lengths,entity.velocity))\n\n                    while history and now-history[0][0]>.45:history.popleft()\n\n                    if len(history)>=5:\n\n                        first,last=history[0],history[-1];elapsed=last[0]-first[0]\n\n                        delta=sub(last[1],first[1]);travel=math.hypot(delta[0],delta[1])\n\n                        path=sum(math.hypot(b[1][0]-a[1][0],b[1][1]-a[1][1]) for a,b in zip(history,list(history)[1:]))\n\n                        consistent=all(len(row[3])==len(first[3]) and all(abs(a-b)<=max(1.,a*.12)\n\n                                       for a,b in zip(first[3],row[3])) for row in history)\n\n                        articulation=max((length(sub(a,b)) for a,b in zip(first[2],last[2])),default=0.)\n\n                        speeds=[row[4] for row in history if row[4] is not None]\n\n                        velocity=tuple(sum(v[i] for v in speeds)/len(speeds) for i in range(2)) if speeds else (0.,0.)\n\n                        speed=math.hypot(*velocity);observed=travel/max(.001,elapsed)\n\n                        agreement=(speed>8 and observed>8 and abs(speed-observed)<=max(80.,observed*.65)\n\n                                   and (velocity[0]*delta[0]+velocity[1]*delta[1])>speed*travel*.5)\n\n                        locomotion=(elapsed>=.24 and travel>=8 and travel>=path*.55 and observed<=650\n\n                                    and consistent and (agreement or .12<articulation<20))\n\n                        entity.pose_evidence=dict(window_ms=round(elapsed*1000),travel=round(travel,2),\n\n                            upright=True,rig_consistent=consistent,velocity_agreement=agreement,\n\n                            articulation=round(articulation,3),ragdoll=False)\n\n                        if locomotion:confirmed_until=now+.35\n\n                    entity.pose_confirmed=confirmed_until>now\n\n                    entity.pose_active=entity.pose_active or entity.pose_confirmed\n\n                    entity.pose_status=\'真玩家（HP1活动证据）\' if entity.pose_confirmed else \'HP1活动待确认\'\n\n                state[\'history\']=history;state[\'confirmed_until\']=confirmed_until\n\n            self.tracks[key]=state\n\n        self.tracks={key:state for key,state in self.tracks.items() if key in seen}\n\n')





