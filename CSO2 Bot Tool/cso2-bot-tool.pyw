e NotReady(\'SERVER ESP camera invalid\')\n    return point\n\n\ndef validate_primary_camera(matrix, local_origin=None,local_scale=1.):\n    """Reject a finite but foreign render pass, without inventing a camera.\n\n    The captured failing pass has the correct rotation but a camera thousands\n    of units away. A 512-unit bound accommodates the supported 240-unit third\n    person camera, crouch/view offsets and a recent position sample. No world\n    coordinates or matrix components are substituted to make a read pass.\n    """\n    eye=camera_eye(matrix)\n    axes=[matrix[i:i+3] for i in (0,4,12)]\n    norms=[math.sqrt(sum(v*v for v in a)) for a in axes]\n    if not .95<=norms[2]<=1.05 or min(norms[:2])<=.01:\n        raise ValueError(\'display camera perspective basis invalid\')\n    if any(abs(sum(x*y for x,y in zip(axes[a],axes[b])))/(norms[a]*norms[b])>.02\n           for a,b in ((0,1),(0,2),(1,2))):\n        raise ValueError(\'display camera basis changed during read\')\n    distance=None\n    if local_origin is not None:\n        if len(local_origin)!=3 or not finite(local_origin):\n            raise ValueError(\'display local position invalid\')\n        distance=math.dist(eye,local_origin)\n        if distance>radius(local_scale,512.):\n            raise ValueError(\'secondary render camera outside local view\')\n    return eye,distance\n\n\ndef projection_profile(matrix):\n    """Rotation/translation-independent perspective scales, not a fixed FOV."""\n    forward=math.hypot(*matrix[12:15])\n    return (math.hypot(*matrix[:3])/forward,\n            math.hypot(*matrix[4:7])/forward)\n\n\ndef same_projection(a,b,tolerance=.005):\n    return a is not None and b is not None and all(\n        abs(x-y)<=tolerance*max(abs(x),abs(y),1e-6) for x,y in zip(a,b))\n\n\n# Bounds apply only to the display. Raw shared consumers keep their 50 ms gate.\n# Display sample retention remains the existing transport deadline.  The\n# separate 90 ms ray target is a performance m