                      server_pose_verified=False)\n                    self.control.diagnostic.update(self.trigger.diagnostics())\n                    binding=getattr(self.trigger,\'aim_binding\',None)\n                    restore_pending=bool(self.waiting_cleanup or\n                                         getattr(binding,\'restore_pending\',False) or\n                                         any(\'恢复\' in key or \'暂停\' in key\n                                             for key in getattr(self,\'cleanup_errors\',{})))\n                    self.control.diagnostic.update(build=BUILD,quick_trace_rays=quick_rays,quick_trace_targets=quick_targets,rmb_held=self.win.down(2),\n                        restore_pending=restore_pending,\n                        weapon_profile_status=self.weapon_catalog.status(f.weapon),\n                        aim_enabled=cfg.aim,fire_enabled=cfg.fire,mode=f.mode,\n                        point_visibility=dict(collections.Counter(p.visibility for e in f.entities if e.enemy for p in e.aim_points)),\n                        hostage_aim_filter=dict(getattr(f,\'hostage_aim_filter\',{})),\n                        obstacle_input_isolated=True)\n                    self.feature_call((\'thirdperson_key\',),lambda:self.local_controls.step_camera(self.reader,f,cfg),self.local_controls.close)\n                    self.dodge.poll()\n                    population_status=self.feature_call((\'autofill_enemies\',),lambda:self.bot_population.step(self.reader,f,cfg.autofill_enemies),self.bot_population.close)\n                    self.control.diagnostic[\'bot_population\']=dict(self.bot_population.metrics)\n                    self.control.diagnostic[\'grenade_dodge\']=dict(self.dodge.metrics)\n                    self.control.diagnostic[\'health_lock\']=dict(self.health_lock.metrics,status=self.health_status,\n                        auto_away=dict(getattr(self,\'health_away_state\',{})))\n                    self.control.diagnostic[\'esp_wall_channel\']=dict(\n                        input=dict(getattr(self,\'wall_input\',{})),batch=dict(getattr(self,\'wall_batch\',{})),\n                        submitted_targets=getattr(self.wall_service,\'last_submit_targets\',0),\n                        submit_status=getattr(self.wall_service,\'last_submit_status\',\'disabled\'),\n                        delivery_status=getattr(self.wall_service,\'signal_delivery_status\',\'disabled\'),\n                        delivery_error=getattr(self.wall_service,\'signal_delivery_error\',\'\'))\n                    self.control.diagnostic[\'native_radar\']=self.radar_diagnostics()\n                    self.control.diagnostic[\'ally_mode_policy\']=dict(self.ally_policy)\n                    self.control.diagnostic.update(native_mode_id=f.native_mode_id,free_for_all=f.free_for_all,allies_targeted=cfg.allies or f.free_for_all)\n                    f.tab_force_fire_active=bool(self.control.diagnostic.get(\'tab_force_fire_active\',False))\n                    self.control_status=self.control.reason+\' · \'+population_status+\' · \'+self.dodge.status\n                    if self.overlay_service:\n                        if began-self.last_overlay_submit>=.016:\n                            self.overlay_service.submit(cfg,self.target,None,hostage_warnings=dict(\n                                pid=self.reader.mem.pid,map=f.map_name,local_identity=[f.local.index,f.local.address,f.local.serial],\n                                weapon=f.weapon,source_epoch=f.source_epoch,control_source=f.source,\n                                tab_force_fire_active=bool(getattr(f,\'tab_force_fire_active\',False)),\n                                ghost_hostage_protection=dict(self.control.diagnostic.get(\'ghost_hostage_protection\',{})),\n                                wall_capability=dict(self.wall_capability),radar_delay=dict(self.radar_delay_state),\n                                failures=[dict(e) for e in f.protected_errors if e.get(\'stage\')==\'hostage\']));self.last_overlay_submit=began\n                        self.render_metrics=dict(self.overlay_service.metrics)\n                        self.render_metrics[\'server_visibility\']=self.visibility_status\n                        if self.overlay_service.error and self.overlay_error!=self.overlay_service.error:\n                            self.overlay_error=self.overlay_service.error;self.post(\'status\',\'绘制进程异常：\'+self.overlay_error)\n                    if self.battle:\n                        self.battle.render_metrics=self.render_metrics\n                        stages[\'features_after_control\']=(time.perf_counter()-stage_start)*1000\n                        stages[\'previous_log_submit\']=getattr(self.battle,\'submit_ms\',0.)\n                        self.control.diagnostic[\'loop_stages_ms\']=stages\n                        self.battle.frame(f,self.control,self.reader.sample_ms,self.trace_ms,cfg,weapon)\n                        if self.damage_sink and began-self.last_log_poll>=.1:\n                            try:\n                                lines=self.damage_sink.poll()\n                                self.battle.sink_available=True;self.battle.sink_error=\'\'\n                                self.battle.sink_dropped=self.damage_sink.dropped\n                                self.battle.sink_diagnostics=dict(self.damage_sink.diagnostics)\n                                self.battle.native(lines)\n                            except Exception as ex:self.battle.sink_error=str(ex);self.battle.sink_available=False\n                            self.last_log_poll=began\n                        s=self.battle.current\n                        if s:\n                            hits=s[\'confirmed_damage_events\'];heads=s[\'confirmed_head_damage_events\']\n                            self.log_status=f\'我命中：头部 {heads}/{hits}\' if hits else \'我命中：暂无确认记录\'\n                            if self.battle.error:self.log_status=\'日志写入错误：\'+self.battle.error\n                            elif self.battle.sink_error:self.log_status=\'采样日志正常；伤害日志：\'+self.battle.sink_error\n                            if s[\'received_attack_events\']:\n                                self.log_status+=f" · 我被击中 {s[\'received_attack_events\']} 次，其中头部 {s[\'received_head_damage_events\']} 次、未知部位 {s[\'received_unknown_hitgroup_events\']} 次 · 头部伤害 {s[\'received_head_damage_total\']} · 评分 {s[\'attack_score\']}"\n                            elif s[\'observed_health_loss_events\']:\n                                self.log_status+=\' · 已观察到掉血，但未收到本人受伤事件；头部命中未确认\'\n                            else:self.log_status+=\' · 等待本人受伤事件；头部命中未确认\'\n                    self.frame=f\n                    if self.white_map is None:\n                        from white_map import WhiteMapService\n                        self.white_map=self.optional_service(\'入图材质检测\',lambda:WhiteMapService(HERE/\'logs\'/\'map-material-check.jsonl\'))\n                    if self.white_map:self.cleanup(\'入图材质观察\',lambda:self.white_map.submit(self.reader,f))\n                    self.cleanup(\'联机显示瞄准状态\',lambda:self.observe_runtime(f,cfg))\n                    self.connection_transition(\'ready\',f\'对局数据正常 · {Path(f.map_name).stem} · PID {self.reader.mem.pid}\',f)\n            except NotReady as ex:\n                self.handle_not_ready(ex)\n            except MemoryError as ex:\n                # Losing one memory read during a transition must not disable\n                # auto-connect or discard a living process handle.\n                self.handle_not_ready(ex)\n            except Exception as ex:\n                self.recover_runtime_fault(ex)\n                now=time.monotonic();signature=(type(ex).__name__,str(ex))\n                if signature!=getattr(self,\'runtime_fault_signature\',None) or now>=getattr(self,\'runtime_fault_report_at\',0.):\n                    self.runtime_fault_signature=signature;self.runtime_fault_report_at=now+5.;self.post(\'error\',str(ex))\n                    try:\n                        with (HERE/\'tool_error.log\').open(\'a\',encoding=\'utf-8\') as fp:fp.write(time.strftime(\'%Y-%m-%d %H:%M:%S\')+\'\\n\'+traceback.format_exc()+\'\\n\')\n                    except OSError as log_error:self.post(\'status\',\'错误日志无法保存：\'+str(log_error))\n            self.shutdown.wait(max(.001,.008-(time.monotonic()-began)))\n        self.disconnect()\n        while self.disconnect_pending:\n            # shutdown is already set; waiting on that event would busy-spin.\n            time.sleep(.025);self.disconnect()\n        self.cleanup(\'闪避线程停止\',self.dodge.shutdown)\n\ndef demo_frame(t=0):\n    local=Entity(1,0,\'CCSPlayer\',3,100,(0,0,0))\n    entities=[]\n    for i,(x,y,grenade,team) in enumerate([(270,55,True,2),(370,-75,False,2),(-240,140,True,2),(-220,-200,False,2),(290,140,False,3)],2):\n        y+=math.sin(t+i)*14\n        e=Entity(i,0,\'CCSPlayer\',team,100 if i%2 else 65,(x,y,0),enemy=team!=3,grenade=grenade,weapon=\'CHEGrenade\' if grenade else \'CWeaponAK47\')\n        pts=[(x,y,72),(x,y,60),(x,y,40),(x,y-15,55),(x,y-20,40),(x,y+15,55),(x,y+20,40),(x,y-9,20),(x,y-10,0),(x,y+9,20),(x,y+10,0)]\n        e.head=pts[0];e.skeleton=[(pts[a],pts[b]) for a,b in [(0,1),(1,2),(1,3),(3,4),(1,5),(5,6),(2,7),(7,8),(2,9),(9,10)]]\n        e.visibility=\'visible\';e.wall_age_ms=0.;e.wall_text=\'离线演示\';entities.append(e)\n    matrix=(0,-1,0,0, 0,0,1.5,-96, 0,0,1,0, 1,0,0,0)\n    return Frame(time.monotonic(),local,(0,0,64),(0,0,0),(0,0,0),matrix,entities,\'离线演示\',\'CWeaponAK47\',30,0,\'普通竞技\')\n\ndef draw_scene(canvas,frame,cfg,target=0,preview=False,display_state=None,rmb_held=False):\n    language=getattr(cfg,\'language\',\'zh\')\n    from ui_text import EN as OVERLAY_EN,dynamic_english\n    def display_text(text):\n        if language!=\'en\':return text\n        return OVERLAY_EN.get(text) or dynamic_english(text,display_text) or text\n    from presentation import distance_label,draw_distance_labels,FAR_HEAD_RANGE,rapid_approach,fast_approaching,draw_approach_warning,approach_warning_scale,edge_rig_segments\n    from esp_pipeline import observer_display_actor\n    from esp_pipeline import combat_display_actor\n    from high_threat_models import is_high_threat_model\n    from high_threat_overlay import rig_anchor,draw_label as draw_threat_label\n    if not isinstance(canvas,RetainedCanvas):\n        if not hasattr(canvas,\'_retained\'):canvas._retained=RetainedCanvas(canvas)\n        canvas=canvas._retained\n    canvas.delete(\'all\');w=max(1,canvas.winfo_width());h=max(1,canvas.winfo_height())\n    if not preview and frame is not None:cfg=auto_ally_config(frame,cfg)\n    notice_y=18\n    tab_force_active=bool(getattr(frame,\'tab_force_fire_active\',False) or\n                          getattr(display_state,\'tab_force_fire_active\',False))\n    if tab_force_active:\n        # Keep the diagnostic banner centered below the scoreboard area so it\n        # stays readable over the game scene without covering actor labels.\n        banner_w=min(620.,max(340.,w*.38));banner_h=46.;center=w/2.;top=notice_y\n        canvas.create_rectangle(center-banner_w/2,top,center+banner_w/2,top+banner_h,\n                                fill=\'#182b3d\',outline=\'#ffb34d\',width=2)\n        canvas.create_text(center,top+banner_h/2,text=\'允许射击遮挡目标已开启，按鼠标右键连遮挡的敌人一起打\',\n                           fill=\'#ffd27a\',font=(OVERLAY_FONT,16,\'bold\'),anchor=\'center\')\n        notice_y=top+banner_h+10\n    if not preview and frame is not None and cfg.radar:\n        from radar_notice_layout import draw_notice\n        notice_y=max(notice_y,draw_notice(canvas,getattr(frame,\'radar_delay_state\',{}),OVERLAY_FONT,language=language))\n    if not preview and frame is not None and cfg.esp:\n        from ghost_hostage_notice import draw_notice as draw_hostage_notice\n        notice_y=draw_hostage_notice(canvas,getattr(frame,\'ghost_hostage_protection\',{}),OVERLAY_FONT,notice_y,language)\n    if preview:\n        canvas.create_rectangle(0,0,w,h,fill=\'#101b29\',outline=\'\')\n        for y in range(int(h*.6),h,42):canvas.create_line(0,y,w,y,fill=\'#203145\')\n        for x in range(0,w,75):canvas.create_line(w/2,h*.47,x,h,fill=\'#203145\')\n        canvas.create_text(22,88,text=display_text(\'离线预览 · 模拟数据\'),fill=ACCENT,font=(OVERLAY_FONT,13,\'bold\'),anchor=\'nw\')\n        canvas.create_text(22,116,text=display_text(\'此画面只验证绘制，不代表已连接游戏。\'),fill=MUTED,font=(OVERLAY_FONT,10),anchor=\'nw\')\n    stats={\'entities\':0,\'on_screen\':0,\'off_screen\':0,\'dormant\':0,\'skeletons\':0,\'skeleton_segments\':0,\'edge_skeletons\':0,\'position_markers\':0,\'arrows\':0,\'radar\':0,\n           \'layers_prepared\':0,\'visible\':0,\'blocked\':0,\'penetrable\':0,\'throwables\':0,\'missing_rigs\':0,\'health_bars\':0,\n           \'hidden_dead\':0,\'hidden_inactive\':0,\'hidden_allies\':0,\'hidden_dormant\':0,\'near_alerts\':0,\'distance_labels\':0,\'label_overflow\':0,\'host_markers\':0,\'head_only\':0,\'approach_warnings\':0,\'front_wall_skeletons\':0,\'c4_markers\':0,\'high_threat_labels\':0,\'actor_layers\':[]}\n    if not frame or (not preview and getattr(frame,\'source\',\'\') not in (\'server\',\'client\')):canvas.finish();return stats\n    if not preview and cfg.esp and cfg.quick_relock_hint and rmb_held:\n        from radar_notice_layout import layout\n        text=display_text(\'单点右键移动鼠标可快速切换敌人！\')\n        measure=(lambda font,s:int(canvas.tk.call(\'font\',\'measure\',font,s))) if hasattr(canvas,\'tk\') else None\n        spec=layout(w,h,[text],OVERLAY_FONT,measure)\n        x=spec[\'x\'];y=max(notice_y,spec[\'y\']);radius=spec[\'outline\']\n        common=dict(text=text,font=spec[\'font\'],anchor=\'ne\')\n        for dx,dy in ((-radius,0),(radius,0),(0,-radius),(0,radius)):\n            canvas.create_text(x+dx,y+dy,fill=\'#000000\',**common)\n        canvas.create_text(x,y,fill=\'#ffad55\',**common)\n    screen=Projector(frame.matrix,w,h);distance_items=[]\n    def layer(e,name):stats[\'actor_layers\'].append((e.index,e.address,e.serial,name))\n    for e in frame.entities:\n        # Sky cameras, triggers and other helper entities are not ESP actors.\n        if not combat_display_actor(e):layer(e,\'non_combat\');continue\n        if not cfg.esp_npcs and entity_kind(e.classname)==\'npc\':layer(e,\'npc_disabled\');continue\n        # No current position or proof of life: never retain a dormant actor\'s\n        # last spawn/death location as a live arrow.\n        if e.dormant:stats[\'hidden_dormant\']+=1;layer(e,\'dormant\');continue\n        if e.health<=0 or (e.health==1 and e.ragdoll_present is True):stats[\'hidden_dead\']+=1;layer(e,\'dead\');continue\n        if not e.reported_alive:stats[\'hidden_inactive\']+=1;layer(e,\'inactive\');continue\n        carrier=bool(getattr(e,\'c4_carrier\',False))\n        observer_actor=observer_display_actor(frame,e)\n        carrier_only=not e.enemy and not cfg.allies and not observer_actor\n        if carrier_only and not carrier:stats[\'hidden_allies\']+=1;layer(e,\'ally_disabled\');continue\n        if carrier_only:\n            stats[\'entities\']+=1;stats[\'c4_markers\']+=int(carrier);layer(e,\'c4_carrier_only\');continue\n        stats[\'entities\']+=1;stats[\'dormant\']+=int(e.dormant)\n        stats[\'host_markers\']+=int(getattr(e,\'display_source\',\'\')==\'server\')\n        distance=length(sub(e.origin,frame.local.origin))\n        closing_warning=fast_approaching(frame,e,distance)\n        wall_age=getattr(e,\'wall_age_ms\',None)\n        wall_fresh=wall_age is not None and math.isfinite(wall_age) and 0<=wall_age<=180.\n        # ESP visibility is the current eye-to-bone ray result. A missing or\n        # expired sample stays blocked while the current model remains drawn.\n        visible=not e.dormant and wall_fresh and e.visibility==\'visible\'\n        if not cfg.walls:\n            wall_fresh=False;visible=False\n        throwable=bool(e.grenade)\n        color=distance_color(distance,throwable)\n        high_threat=bool(e.enemy and is_high_threat_model(e.model))\n        head=screen(e.head) if e.head else None\n        # The visible/blocked distinction only selects the display layer.\n        # A transient missing ray does not alternate a live rig with a marker.\n        layer_state=display_state\n        if layer_state is None:\n            from presentation import DisplayStability\n            layer_state=DisplayStability()\n        display_visibility=layer_state.visibility(frame,e,visible,wall_fresh)\n        visible=display_visibility==\'visible\'\n        warning_scale=approach_warning_scale(frame,e,distance,visible)\n        # A visible target has its current rig; other states keep the actor\'s\n        # marker and applicable labels. Penetrable targets also get a full bar.\n        detailed=bool(e.skeleton) and cfg.walls and visible;front_wall=False\n        stats[\'throwables\']+=int(throwable)\n        lines=[line for a,b in e.skeleton if (line:=screen.segment(a,b)) is not None] if detailed else []\n        anchor=rig_anchor(e,screen) if high_threat else None\n        if anchor is None:anchor=head if screen.in_view(head) else None\n        if anchor is None and lines:anchor=min((point for line in lines for point in line),key=lambda p:p[1])\n        if anchor is None:\n            for point in (add(e.origin,(0,0,64)),e.origin):\n                projected=screen(point)\n                if screen.in_view(projected):anchor=projected;break\n        # A hand/leg can be visible while head and origin are offscreen.\n        # Keep its marker anchored to an actual clipped SERVER rig segment.\n        if anchor is None:\n            for a,b in e.skeleton:\n                clipped=screen.segment(a,b)\n                if clipped is not None:\n                    anchor=min(clipped,key=lambda point:point[1]);break\n        on=anchor is not None\n        stats[\'on_screen\' if on else \'off_screen\']+=1\n        detailed=detailed and bool(lines) and not carrier_only\n        language=getattr(cfg,\'language\',\'zh\')\n        labels={\'visible\':(\'Visible\',\'可见\'),\'penetrable\':(\'Penetrable\',\'可穿透\'),\'blocked\':(\'Blocked\',\'遮挡\')}\n        visibility_text=labels[display_visibility][0 if language==\'en\' else 1]\n        health_label=visibility_text if display_visibility in (\'visible\',\'penetrable\') else \'\'\n        stats[display_visibility]+=1\n        marker_text=distance_label(distance)+\' · \'+visibility_text if distance<=FAR_HEAD_RANGE else \'\'\n        from model_support import entity_status\n        if marker_text and entity_status(e)==\'unsupported\':\n            marker_text+=\' · \'+(\'Model unsupported\' if language==\'en\' else \'模型未支持\')\n        if not e.skeleton:stats[\'missing_rigs\']+=1\n        if cfg.esp and on:\n            x,y=anchor\n            # Both command layers use exactly the same camera and entity sample.\n            # No cross-process frame queue and no extra display-switch delay.\n            rig_layer=DrawLayer();stats[\'layers_prepared\']+=2\n            for pa,pb in lines:rig_layer.add(\'line\',*pa,*pb,fill=color,width=2)\n            if screen.in_view(head):rig_layer.add(\'oval\',head[0]-3,head[1]-4,head[0]+3,head[1]+3,outline=color,width=2)\n            label_x=max(24,min(w-24,x));label_y=max(23,min(h-12,y))\n            health_layer=DrawLayer()\n            health_layer.add(\'text\',label_x,label_y-16,text=str(e.health),fill=color,font=(OVERLAY_FONT,9,\'bold\'))\n            health_layer.add(\'rectangle\',label_x-17,label_y-8,label_x+17,label_y-5,fill=\'#182230\',outline=\'\')\n            health_layer.add(\'rectangle\',label_x-17,label_y-8,label_x-17+34*max(0,min(1,e.health/100)),label_y-5,fill=color,outline=\'\')\n            if detailed:\n                rig_layer.paint(canvas);stats[\'skeletons\']+=1\n                stats[\'skeleton_segments\']+=len(lines)\n                stats[\'front_wall_skeletons\']+=int(front_wall)\n            else:\n                stats[\'position_markers\']+=1\n                canvas.create_oval(x-3,y-3,x+3,y+3,outline=color,width=2)\n            if health_label:\n                health_layer.paint(canvas);stats[\'health_bars\']+=1\n            if entity_status(e)==\'unsupported\':\n                canvas.create_text(label_x,label_y+14,text=display_text(\'模型未支持\'),fill=\'#ffd54a\',font=(OVERLAY_FONT,9,\'bold\'))\n            visible_warning=closing_warning\n            if visible_warning:\n                draw_approach_warning(canvas,x,y-96 if high_threat else y-42 if detailed else y,w,h,throwable,yellow_only=True,scale=warning_scale)\n                stats[\'approach_warnings\']+=1;stats[\'near_alerts\']+=1\n            if high_threat:\n                stats[\'high_threat_labels\']+=int(draw_threat_label(canvas,x,y-72,w,h,language))\n            if marker_text:distance_items.append(((e.index,e.address,e.serial),x,y-40,marker_text,color,distance,x,y))\n            stats[\'c4_markers\']+=int(carrier);layer(e,\'skeleton\' if detailed else \'distance\')\n        if cfg.arrows and (e.enemy or carrier or observer_actor) and not on:\n            # Keep the saved edge-indicator setting; only its presentation changes.\n            points=side_arrow(frame.eye,e.head or e.origin,frame.angles[1],w,h,matrix=frame.matrix,pitch=frame.angles[0])\n            urgent=rapid_approach(frame,e,distance,visible,False)\n            edge_drawn=False\n            if urgent or closing_warning:\n                draw_approach_warning(canvas,points[0],points[1],w,h,throwable,points,yellow_only=not urgent,scale=max(1.25,warning_scale) if urgent else warning_scale)\n                stats[\'approach_warnings\']+=1;stats[\'arrows\']+=1;stats[\'near_alerts\']+=1\n                if marker_text:distance_items.append(((e.index,e.address,e.serial),points[0],points[1]+26,marker_text,color,distance,points[0],points[1]))\n                if urgent and cfg.esp:\n                    edge_lines=edge_rig_segments(frame,e,points[:2],w,h)\n                    for pa,pb in edge_lines:canvas.create_line(*pa,*pb,fill=color,width=2)\n                    if edge_lines:\n                        edge_drawn=True;stats[\'edge_skeletons\']+=1;stats[\'skeletons\']+=1\n                        stats[\'skeleton_segments\']+=len(edge_lines)\n            else:\n                if marker_text:distance_items.append(((e.index,e.address,e.serial),points[0],points[1],marker_text,color,distance,points[0],points[1]))\n                stats[\'position_markers\']+=1\n                x,y=points[:2];canvas.create_oval(x-3,y-3,x+3,y+3,outline=color,width=2)\n            stats[\'c4_markers\']+=int(carrier)\n            if high_threat and cfg.esp:\n                stats[\'high_threat_labels\']+=int(draw_threat_label(canvas,points[0],points[1]-32,w,h,language))\n            layer(e,\'edge_skeleton\' if edge_drawn else \'edge_warning\' if urgent or closing_warning else \'edge_distance\')\n        elif not on:layer(e,\'edge_disabled\')\n        if on and not cfg.esp:layer(e,\'esp_disabled\')\n    stats[\'hidden_samples\']=[dict(index=e.index,hp=e.health,reported_alive=e.reported_alive,\n        ragdoll=e.ragdoll_present)\n        for e in frame.entities if e.health>0 and not e.reported_alive][:12]\n    stats[\'distance_labels\']=draw_distance_labels(canvas,distance_items,w,h,fallback_markers=False)\n    stats[\'label_overflow\']=len(distance_items)-stats[\'distance_labels\']\n    stats[\'grenades\']=0\n    if getattr(cfg,\'esp_grenades\',True):\n        for grenade in frame.grenades:\n            if grenade.remaining<=0:continue\n            center=screen(grenade.origin)\n            if not screen.in_view(center):continue\n            projected=[screen(add(grenade.origin,(x,y,z))) for x in (-3,3) for y in (-3,3) for z in (-3,3)]\n            projected=[p for p in projected if screen.in_view(p)]\n            half=min(18.,max(6.,max((max(abs(p[0]-center[0]),abs(p[1]-center[1])) for p in projected),default=6.)))\n            x,y=center\n            canvas.create_rectangle(x-half,y-half,x+half,y+half,outline=\'#ff4c61\',width=2)\n            stats[\'grenades\']+=1\n    stats[\'hostage_warnings\']=0\n    if cfg.esp:\n        for warning in getattr(frame,\'hostage_warnings\',[]):\n            origin=tuple(warning[\'origin\']);distance=length(sub(origin,frame.local.origin))\n            if not math.isfinite(distance) or not 0<=distance<=10./.0254:continue\n            anchor=screen(add(origin,(0,0,80)))\n            if not screen.in_view(anchor):continue\n            x=max(80,min(w-80,anchor[0]));y=max(16,min(h-16,anchor[1]))\n            for dx,dy in ((-1,0),(1,0),(0,-1),(0,1)):\n                canvas.create_text(x+dx,y+dy,text=display_text(\'人质拦截失败\'),fill=\'#101820\',font=(OVERLAY_FONT,12,\'bold\'))\n            canvas.create_text(x,y,text=display_text(\'人质拦截失败\'),fill=\'#ffd54a\',font=(OVERLAY_FONT,12,\'bold\'))\n            stats[\'hostage_warnings\']+=1\n    from c4_esp import draw as draw_c4\n    stats[\'c4_markers\']=draw_c4(canvas,frame,cfg,screen,OVERLAY_FONT)\n    canvas.finish()\n    return stats\n\n\nclass App:\n    def __init__(self,root,start_worker=True):\n        self.root=root;self.win=Windows();self.worker=Worker(self.win);self.vars={};self.feature_widgets={};self.capabilities={};self.closing=False;self.worker_started=start_worker;self.last_panel=0\n        self.display_state=DisplayStability();self.auto_connect=True;self.next_connect=0.;self.connect_pending=False\n        self.normal_geometry=None;self.saved_window_state=\'normal\'\n        self._defaults_undo=None  # Window-session snapshot; never persisted.\n        self.health_away=AwayHealthSwitch();self.health_cursor=CursorPosition();self.round_away=RoundAwayService();self.round_away_dialog=None\n        self.client_resources=ClientResources(report_path=HERE/\'logs\'/\'client-resource-scan.json\')\n        self.client_resource_report={}\n        self.resource_support_view=ResourceSupportView();self.resource_view_visible=False\n        self