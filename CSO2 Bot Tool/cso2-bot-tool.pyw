_EMBEDDED['aim_recoil_policy'] = ('2026.10.07-aim-private-reader-evidence', '\n"""Small runtime aim/fire policy.\n\nOnly two operational path classes exist here: ``clear`` and ``penetration``.\nEverything else is an obstruction and is never converted into permission by\nthe controller.  The ESP can still render its own three display classes.\n"""\nfrom dataclasses import replace\nimport math\n\n\nWEAPON_PROFILES = {\n    \'ak47\': {\'pitch_bias\': 0.012, \'yaw_bias\': -0.004},\n    \'m4a1\': {\'pitch_bias\': 0.009, \'yaw_bias\': 0.002},\n    \'m4a1_silencer\': {\'pitch_bias\': 0.008, \'yaw_bias\': 0.001},\n    \'famas\': {\'pitch_bias\': 0.011, \'yaw_bias\': -0.002},\n    \'galil\': {\'pitch_bias\': 0.013, \'yaw_bias\': -0.003},\n    \'aug\': {\'pitch_bias\': 0.008, \'yaw_bias\': 0.001},\n    \'sg552\': {\'pitch_bias\': 0.009, \'yaw_bias\': -0.001},\n    \'scar20\': {\'pitch_bias\': 0.006, \'yaw_bias\': 0.001},\n    \'g3sg1\': {\'pitch_bias\': 0.006, \'yaw_bias\': -0.001},\n    \'mp5navy\': {\'pitch_bias\': 0.006, \'yaw_bias\': 0.001},\n    \'p90\': {\'pitch_bias\': 0.005, \'yaw_bias\': 0.001},\n    \'ump45\': {\'pitch_bias\': 0.008, \'yaw_bias\': -0.002},\n    \'default\': {\'pitch_bias\': 0.0, \'yaw_bias\': 0.0},\n}\n\n\ndef _weapon_key(name):\n    try:\n        from weapon_profiles import canonical_weapon_name\n        return canonical_weapon_name(name)\n    except (ImportError, AttributeError, TypeError, ValueError):\n        return str(name or \'\').lower().replace(\'cweapon\', \'\')\n\n\ndef weapon_profile(name):\n    return WEAPON_PROFILES.get(_weapon_key(name), WEAPON_PROFILES[\'default\'])\n\n\ndef install_recoil_policy(aim_tracking_module):\n    """Preserve measured recoil and expose movement telemetry for contracts."""\n    original_update = aim_tracking_module.AimTracker.update\n    if getattr(original_update, \'_measured_recoil_policy\', False):\n        return\n\n    def update(self, frame, target, smoothing, recoil_scale):\n        result = original_update(self, frame, target, smoothing, recoil_scale)\n        profile = weapon_profile(getattr(frame, \'weapon\', \'\'))\n        shots = max(0, min(8, int(getattr(frame, \'shots\', 0) or 0)))\n        punch = tuple(float(v) for v in getattr(frame, \'punch\', (0., 0., 0.)))\n        motion = result.get(\'motion_response\', {})\n        result[\'experimental_recoil\'] = {\n            \'profile\': _weapon_key(getattr(frame, \'weapon\', \'\')) or \'default\',\n            \'shots\': shots,\n            \'measured_punch\': punch,\n            \'bias\': (0.0, 0.0, 0.0),\n            \'configured_bias\': (profile[\'pitch_bias\'] * shots / 8.0,\n                                profile[\'yaw_bias\'] * shots / 8.0, 0.0),\n            \'bias_applied\': False,\n            \'movement_aim\': {\n                \'forced\': bool(motion.get(\'forced\')),\n                \'speed\': 0.0,\n                \'target_speed\': motion.get(\'target_speed\', 0.0),\n                \'pose_shift\': motion.get(\'pose_shift\', 0.0),\n                \'reasons\': motion.get(\'reasons\', []),\n                \'requested_smoothing\': smoothing,\n                \'applied_smoothing\': motion.get(\'applied_smoothing\', smoothing),\n                \'threshold\': 20.0,\n            },\n            \'algorithm\': \'measured_punch_observed_target_motion_v3\',\n        }\n        return result\n\n    update._measured_recoil_policy = True\n    aim_tracking_module.AimTracker.update = update\n\n\ndef install():\n    import aim_tracking_private as aim_tracking\n    install_recoil_policy(aim_tracking)\n')
_EMBEDDED['aim_runtime'] = ('2026.10.07-aim-private-reader-evidence', '"""Private aim worker runtime; no UI or ESP implementation imports."""\nfrom __future__ import annotations\nimport ctypes as C\nfrom ctypes import wintypes as W\nimport copy, math, time, threading, collections\nfrom dataclasses import dataclass, replace, fields\nfrom geometry import *\nfrom aim_reader import Entity, Frame, NotReady, MemoryError\nfrom aim_geometry import select_aim_view, candidate_points, hostage_ray_clear, hostage_ray_status, protect_hostages\nfrom weapon_profiles import is_firearm, profile_stop_reason, weapon_cycle\nfrom runtime_diagnostics import accuracy_profile, weapon_identity\nfrom target_rules import target_is_active, entity_kind\nfrom aim_tracking_private import AimTracker, aim_tolerance\nfrom aim_decision import selection_tier, ray_nearest_key, acquisition_key\nfrom aim_priority import threat_info\nAA_MODES=(\'背身\', \'背身抖动\')\nAA_PITCHES=(\'保持\', \'低头\', \'抬头\')\n\n@dataclass\nclass Config:\n    esp:bool=True\n    esp_npcs:bool=True\n    fullmap_sync:bool=True\n    arrows:bool=True\n    radar:bool=False\n    radar_delay_seconds:int=6\n    allies:bool=False\n    aim:bool=True\n    anti_aim:bool=False\n    anti_aim_mode:str=AA_MODES[0]\n    anti_aim_jitter:float=30.0\n    anti_aim_period:int=8\n    anti_aim_pitch:str=AA_PITCHES[0]\n    aim_npcs:bool=True\n    fire:bool=True\n    recoil:bool=True\n    host_magic_bullet:bool=False\n    client_magic_bullet:bool=False\n    walls:bool=True\n    require_clear:bool=True\n    wallbang:bool=True\n    tab_force_fire:bool=False\n    screen_acquire:bool=True\n    fov:float=12.0\n    smoothing:float=4.0\n    recoil_strength:float=1.0\n    radar_span:float=2000.0\n    strategy:str=\'准星最近\'\n    mode:str=\'普通竞技\'\n    enemy_team:int=0\n    bhop:bool=True\n    thirdperson_key:bool=True\n    thirdperson_distance:float=150.0\n    esp_grenades:bool=True\n    esp_antialias:bool=True\n    autofill_enemies:bool=True\n    grenade_dodge:bool=True\n    grenade_dodge_ghost_only:bool=True\n    lock_hp:bool=True\n    lock_hp_once:bool=False\n    locked_hp:int=99999\n    language:str=\'zh\'\n\n\nclass Windows:\n    def __init__(self):\n        self.u=C.WinDLL(\'user32\',use_last_error=True)\n        self.u.GetForegroundWindow.restype=W.HWND\n        self.u.GetAncestor.argtypes=[W.HWND,W.UINT];self.u.GetAncestor.restype=W.HWND\n        self.u.GetWindowThreadProcessId.argtypes=[W.HWND,C.POINTER(W.DWORD)]\n        self.u.GetClientRect.argtypes=[W.HWND,C.POINTER(W.RECT)]\n        self.u.ClientToScreen.argtypes=[W.HWND,C.POINTER(W.POINT)]\n        self.u.IsWindowVisible.argtypes=[W.HWND];self.u.IsIconic.argtypes=[W.HWND]\n        self.u.IsWindow.argtypes=[W.HWND];self.u.IsWindow.restype=W.BOOL\n        self.enum_window_proc=C.WINFUNCTYPE(W.BOOL,W.HWND,W.LPARAM)\n        self.u.EnumWindows.argtypes=[self.enum_window_proc,W.LPARAM];self.u.EnumWindows.restype=W.BOOL\n        self.viewport_window=None;self.viewport_pid=None;self.next_window_scan=0.\n        try:\n            self.dwm=C.WinDLL(\'dwmapi\',use_last_error=True)\n            self.dwm.DwmGetWindowAttribute.argtypes=[W.HWND,W.DWORD,C.c_void_p,W.DWORD]\n        except OSError:self.dwm=None\n        self.u.GetAsyncKeyState.argtypes=[C.c_int];self.u.GetAsyncKeyState.restype=C.c_short\n        class CURSORINFO(C.Structure):\n            _fields_=[(\'cbSize\',W.DWORD),(\'flags\',W.DWORD),(\'hCursor\',getattr(W,\'HCURSOR\',W.HANDLE)),(\'ptScreenPos\',W.POINT)]\n        self.CURSORINFO=CURSORINFO\n        self.u.GetCursorInfo.argtypes=[C.POINTER(CURSORINFO)];self.u.GetCursorInfo.restype=W.BOOL\n        self.u.SetWindowPos.argtypes=[W.HWND,W.HWND,C.c_int,C.c_int,C.c_int,C.c_int,W.UINT]\n        self.u.GetParent.argtypes=[W.HWND];self.u.GetParent.restype=W.HWND\n        self.u.GetWindowLongPtrW.argtypes=[W.HWND,C.c_int];self.u.GetWindowLongPtrW.restype=C.c_ssize_t\n        self.u.SetWindowLongPtrW.argtypes=[W.HWND,C.c_int,C.c_ssize_t];self.u.SetWindowLongPtrW.restype=C.c_ssize_t\n        class MOUSEINPUT(C.Structure):\n            _fields_=[(\'dx\',W.LONG),(\'dy\',W.LONG),(\'mouseData\',W.DWORD),(\'dwFlags\',W.DWORD),(\'time\',W.DWORD),(\'dwExtraInfo\',C.c_size_t)]\n        class KEYBDINPUT(C.Structure):\n            _fields_=[(\'wVk\',W.WORD),(\'wScan\',W.WORD),(\'dwFlags\',W.DWORD),(\'time\',W.DWORD),(\'dwExtraInfo\',C.c_size_t)]\n        class HARDWAREINPUT(C.Structure):\n            _fields_=[(\'uMsg\',W.DWORD),(\'wParamL\',W.WORD),(\'wParamH\',W.WORD)]\n        class INPUTUNION(C.Union):_fields_=[(\'mi\',MOUSEINPUT),(\'ki\',KEYBDINPUT),(\'hi\',HARDWAREINPUT)]\n        class INPUT(C.Structure):_fields_=[(\'type\',W.DWORD),(\'u\',INPUTUNION)]\n        self.INPUT=INPUT\n        self.u.SendInput.argtypes=[W.UINT,C.POINTER(INPUT),C.c_int];self.u.SendInput.restype=W.UINT\n    def down(self,key):return bool(self.u.GetAsyncKeyState(key)&0x8000)\n    def cursor_visible(self):\n        info=self.CURSORINFO(C.sizeof(self.CURSORINFO))\n        return bool(self.u.GetCursorInfo(C.byref(info)) and info.flags&1)\n    def foreground(self,pid):\n        h=self.u.GetForegroundWindow();v=W.DWORD();self.u.GetWindowThreadProcessId(h,C.byref(v))\n        return h if v.value==pid else None\n    def viewport(self,pid):\n        return self.viewport_state(pid)[\'rect\']\n    def viewport_state(self,pid):\n        foreground=self.u.GetForegroundWindow();owner=W.DWORD()\n        self.u.GetWindowThreadProcessId(foreground,C.byref(owner))\n        state=dict(rect=None,foreground_pid=owner.value,foreground_window=int(foreground or 0),\n                   foreground=owner.value==pid,reason=\'window_not_found\',window_policy=\'visible_game_window\')\n        def inspect(hwnd):\n            if not hwnd or not self.u.IsWindow(hwnd):return None,\'window_not_found\'\n            process=W.DWORD();self.u.GetWindowThreadProcessId(hwnd,C.byref(process))\n            if process.value!=pid:return None,\'window_not_found\'\n            if self.u.IsIconic(hwnd):return None,\'minimized\'\n            if not self.u.IsWindowVisible(hwnd):return None,\'hidden\'\n            dwm=getattr(self,\'dwm\',None);cloaked=W.DWORD()\n            if dwm and dwm.DwmGetWindowAttribute(hwnd,14,C.byref(cloaked),C.sizeof(cloaked))==0 and cloaked.value:\n                return None,\'cloaked\'\n            rect=W.RECT();pt=W.POINT()\n            if not self.u.GetClientRect(hwnd,C.byref(rect)) or not self.u.ClientToScreen(hwnd,C.byref(pt)):\n                return None,\'client_rect_unavailable\'\n            width,height=rect.right-rect.left,rect.bottom-rect.top\n            if width<320 or height<200:return None,\'client_rect_too_small\'\n            return (pt.x,pt.y,width,height),\'ready\'\n        if getattr(self,\'viewport_pid\',None)!=pid:\n            self.viewport_pid=pid;self.viewport_window=None;self.next_window_scan=0.\n        now=time.monotonic();cached=getattr(self,\'viewport_window\',None)\n        rect,reason=inspect(cached)\n        # A game can recreate its top-level window during map load or a\n        # fullscreen transition. Do not wait for the previous 250 ms scan\n        # interval when the cached handle is already invalid.\n        # A cached HWND may still exist but become hidden during recreation.\n        # Probe its visible replacement immediately on the ready->unavailable\n        # transition, without busy-enumerating permanently minimized windows.\n        if cached and not rect and getattr(self,\'viewport_last_reason\',\'ready\')==\'ready\':\n            self.next_window_scan=0.\n        # A visible foreground game window is stronger evidence than a stale\n        # cached handle and requires no full enumeration.\n        if owner.value==pid and foreground!=cached:\n            foreground_rect,_=inspect(foreground)\n            if foreground_rect:\n                cached=foreground;rect=foreground_rect;reason=\'ready\';self.viewport_window=cached\n        if now>=getattr(self,\'next_window_scan\',0.):\n            self.next_window_scan=now+.25;candidates=[];reasons=[]\n            def visit(hwnd,_):\n                item,why=inspect(hwnd)\n                if item:candidates.append((item[2]*item[3],hwnd==cached,int(hwnd),item))\n                elif why!=\'window_not_found\':reasons.append((why,int(hwnd)))\n                return True\n            callback=self.enum_window_proc(visit)\n            if not self.u.EnumWindows(callback,0) and not candidates:\n                state[\'scan_error\']=C.get_last_error()\n            if candidates:\n                _,_,cached,rect=max(candidates);self.viewport_window=cached;reason=\'ready\'\n            elif not rect and reasons:\n                # A minimized Valve001 window is the real game surface, not\n                # the process\'s hidden D3DProxyWindow/IME helpers. Retaining\n                # the real handle also restores immediately without a scan.\n                priority={\'minimized\':4,\'cloaked\':3,\'client_rect_unavailable\':2,\n                          \'client_rect_too_small\':1,\'hidden\':0}\n                reason,cached=max(reasons,key=lambda x:(priority.get(x[0],-1),x[1]==cached))\n                self.viewport_window=cached\n        self.viewport_last_reason=reason\n        state.update(game_window=int(cached or 0),reason=reason,rect=rect)\n        return state\n    def mouse_button(self,down):\n        event=self.INPUT();event.type=0;event.u.mi.dwFlags=2 if down else 4\n        if self.u.SendInput(1,C.byref(event),C.sizeof(event))!=1:raise RuntimeError(\'Windows 未接受鼠标输入\')\n    def overlay_style(self,window):\n        handle=self.u.GetParent(window.winfo_id()) or window.winfo_id()\n        style=self.u.GetWindowLongPtrW(handle,-20)\n        self.u.SetWindowLongPtrW(handle,-20,style|0x80000|0x20|0x8000000|0x80)\n        self.u.SetWindowPos(handle,W.HWND(-1),0,0,0,0,0x1|0x2|0x10|0x20)\n\n\nclass Controller:\n    """Explicit fire-down/fire-up state, target continuity, and exact stop reasons."""\n    def __init__(self,windows,clock=time.monotonic,trigger=None):\n        self.win=windows;self.clock=clock;self.target=0;self.pressed=False;self.press_time=0;self.last_fire=-100;self.last_release=-100;self.previous_punch=(0,0,0);self.reason=\'瞄准未开启\';self.actions=collections.deque(maxlen=4096);self.chain_until=0;self.aim_punch=None;self.last_weapon=\'\'\n        self.trigger=trigger;self.ammo_last=None;self.ammo_at=0.;self.trigger_stalled=False\n        self.input_armed=True\n        self.tracking=AimTracker();self.diagnostic={}\n        self.last_clear=None\n        self.engagement=None\n        self.death_seen_stamp=None\n        self.pending_switch=None\n        from aim_weapon_cadence import WeaponCadence\n        self.cadence=WeaponCadence()\n        self.last_weapon_identity=None\n        self.focus_memory=None\n        self.force_cancel_requested=False\n        self._button_lock=threading.RLock()\n        self.pose_refresh=None\n        self.motion=None\n    def remember_focus(self,frame,target,now):\n        self.focus_memory=dict(key=(frame.map_name,frame.local.address,frame.local.serial,\n            frame.weapon,target.index,target.address,target.serial,target.model),at=now)\n    def previous_focus(self,frame,now):\n        memory=self.focus_memory\n        if memory is None:return self.target\n        def discard():\n            if self.target==memory[\'key\'][4]:self.target=0\n            self.focus_memory=None\n            return self.target\n        if now-memory[\'at\']>.35 or now<memory[\'at\']:\n            return discard()\n        key=memory[\'key\']\n        if key[:4]!=(frame.map_name,frame.local.address,frame.local.serial,frame.weapon):\n            return discard()\n        actor=next((e for e in frame.entities if e.index==key[4]),None)\n        if actor is None or not target_is_active(actor) or not actor.enemy or (actor.address,actor.serial,actor.model)!=key[5:]:\n            return discard()\n        return self.target or actor.index\n    def sync_weapon(self,frame,now):\n        key=(frame.map_name,frame.local.address,frame.local.serial,frame.weapon,weapon_identity(frame))\n        changed=key!=self.last_weapon_identity\n        if changed:\n            if self.pressed and not self.button(False,\'当前武器实体变化，释放旧扳机\'):\n                return False\n            self.last_weapon_identity=key;self.last_weapon=frame.weapon\n            self.ammo_last=None;self.ammo_at=now;self.last_fire=-100.;self.trigger_stalled=False\n            self.aim_punch=None;self.previous_punch=(0.,0.,0.);self.tracking.reset()\n            self.focus_memory=None\n            self.engagement=None;self.last_clear=None\n            self.death_seen_stamp=None\n            self.pending_switch=None\n            self.target=0\n        reloaded=self.ammo_last is not None and frame.ammo>self.ammo_last\n        if reloaded:\n            if self.pressed and not self.button(False,\'换弹完成，释放旧射击序列\'):return False\n            self.last_fire=-100.;self.trigger_stalled=False\n            self.cadence.last_policy={}\n            self.tracking.reset()\n        if self.ammo_last is not None and frame.ammo<self.ammo_last:self.ammo_at=now\n        self.ammo_last=frame.ammo\n        self.diagnostic[\'weapon_identity_changed\']=changed\n        return True\n    def drain_actions(self):\n        result=[]\n        while self.actions:\n            try:result.append(self.actions.popleft())\n            except IndexError:break\n        return result\n    def observe_lifecycle(self,frame,reader=None):\n        import struct\n        actor=next((e for e in frame.entities if e.index==self.target),None)\n        if self.target and (actor is None or not target_is_active(actor)) and self.death_seen_stamp is None:\n            self.death_seen_stamp=self.clock()\n            self.target_end_reason=\'disappeared\' if actor is None else \'killed\' if actor.health<=0 else \'inactive\'\n            if actor is None and reader is not None and self.focus_memory:\n                # Confirm death from the same live slot generation; absence\n                # alone is not a kill and does not enter the kill metric.\n                index,address,serial=self.focus_memory[\'key\'][4:7]\n                try:\n                    if reader.mem.read(reader.target_entry(index),8)==struct.pack(\'<II\',address,serial):\n                        if reader.mem.i32(address+0x98)<=0:self.target_end_reason=\'killed\'\n                except (MemoryError,NotReady,ValueError,struct.error):pass\n    def service_fire_release(self,reader,frame=None):\n        """Release an expired/confirmed pulse before the next expensive scan.\n\n        Same control thread only. These checkpoints do not promise a hard\n        wall-clock deadline while an individual process read is blocked.\n        """\n        if not self.pressed:return False\n        # The 10ms weapon owner may release input while this worker samples.\n        if self.trigger and getattr(self.trigger,\'active\',True) is False:\n            self.pressed=False\n            guard=dict(getattr(self.trigger,\'fire_guard\',{}))\n            self.reason=guard.get(\'reason\') or \'当前武器输入已释放\'\n            self.actions.append(dict(action=\'fire_up\',target=self.target,mono=self.clock(),reason=self.reason))\n            return True\n        if not self.win.down(2):\n            self.reason=\'按住右键瞄准、开火\'\n            return self.button(False,self.reason)\n        if frame is not None and protect_hostages(frame.mode) and frame.protected:\n            from aim_fire_commit import read_sight,check_hostage_sight\n            try:\n                sampled=read_sight(reader,frame,1.)\n                clear=sampled is not None and check_hostage_sight(\n                    self,frame,sampled[2],None,\'held_before_sampling\')\n            except (MemoryError,NotReady,ValueError,OSError):\n                clear=False;self.reason=\'人质保护视角读取失败\'\n            if not clear:return self.button(False,self.reason)\n        if self.cadence.last_policy.get(\'continuous\'):\n            if self.trigger and self.trigger.maintain() is False:\n                return self.button(False,\'当前武器或弹量已变化\')\n            return False\n        now=self.clock();record=self.cadence.records.get(self.cadence.current,{})\n        limit=self.cadence.last_policy.get(\'press_timeout_ms\',50.)/1000.\n        confirmed=record.get(\'shots_in_press\',0)>0\n        if confirmed or now-self.press_time>=limit:\n            self.diagnostic[\'early_release\']=\'clip_confirmed\' if confirmed else \'bounded_press_timeout\'\n            return self.button(False,\'耗弹确认或按键到期，扫描前释放扳机\')\n        if frame is not None and callable(getattr(reader,\'control_weapon\',None)):\n            try:fresh=reader.control_weapon(frame)\n            except (MemoryError,NotReady,ValueError):\n                if not self.button(False,\'武器采样变化，扫描前释放扳机\'):raise\n                return True\n            if weapon_identity(fresh)!=weapon_identity(frame) or weapon_identity(fresh)!=self.cadence.current:\n                return self.button(False,\'武器变化，扫描前释放扳机\')\n            confirmed=confirmed or fresh.ammo<record.get(\'ammo\',fresh.ammo) or fresh.ammo<=0\n        if confirmed or self.clock()-self.press_time>=limit:\n            self.diagnostic[\'early_release\']=\'clip_confirmed\' if confirmed else \'bounded_press_timeout\'\n            return self.button(False,\'耗弹确认或按键到期，扫描前释放扳机\')\n        return False\n    def button(self,down,why,pre_down=None):\n        with self._button_lock:\n            return self._button(down,why,pre_down)\n    def _button(self,down,why,pre_down=None):\n        if down and self.force_cancel_requested:\n            self.reason=\'按T取消强制瞄准开火\';self.diagnostic.update(\n                force_cancel_blocked_down=True,fire_allowed=False,stop_reason=self.reason)\n            return False\n        if self.pressed==down:return True\n        if down and pre_down:\n            pre_down.before_input_check=lambda:not self.force_cancel_requested\n        if self.trigger:\n            guarded=getattr(self.trigger,\'set_guarded\',None) if down and pre_down else None\n            if down and pre_down and not callable(guarded) and not pre_down():return False\n            accepted=guarded(pre_down) if callable(guarded) else self.trigger.set(down)\n            if accepted is False:\n                guard=dict(getattr(self.trigger,\'fire_guard\',{}))\n                self.reason=guard.get(\'reason\') or self.reason\n                self.diagnostic.update(trigger_rejected=True,fire_allowed=False,\n                                       input_weapon_guard=guard,stop_reason=self.reason)\n                return False\n        else:\n            if down and pre_down and not pre_down():return False\n            self.win.mouse_button(down)\n        now=self.clock();self.pressed=down\n        if down:self.press_time=now;self.last_fire=now\n        else:self.last_release=now\n        if down:\n            # This timestamp is taken only after EngineAttack.set() (or the\n            # native mouse write) has returned, so it includes the complete\n            # weapon/view/identity/after-weapon admission path.\n            aim_stamp=self.diagnostic.get(\'aim_write_stamp\')\n            elapsed=(max(0.,now-aim_stamp)*1000\n                     if isinstance(aim_stamp,(int,float)) else None)\n            self.diagnostic[\'fire_down_completed_stamp\']=now\n            if self.motion is not None:\n                self.motion.completed(self.diagnostic.get(\'motion_compensation\'),now)\n            if self.trigger and self.trigger.tab_force and getattr(self,\'force_first_down_pending\',False):\n                self.diagnostic[\'t_first_down_ms\']=max(0.,now-self.force_input_observed)*1000.\n                self.force_first_down_pending=False\n            self.diagnostic[\'aim_to_fire_ms\']=elapsed\n            refresh=self.diagnostic.get(\'pose_refresh\');age=None\n            if isinstance(refresh,dict):\n                stamp=refresh.get(\'pose_stamp\')\n                age=(now-stamp)*1000 if isinstance(stamp,(int,float)) else None\n                refresh[\'after_down_age_ms\']=age\n                evidence=refresh.get(\'pose_cache_evidence\') or {}\n                matrix_stamp=evidence.get(\'matrix_read_finished\')\n                refresh[\'matrix_read_to_down_ms\']=((now-matrix_stamp)*1000.\n                    if isinstance(matrix_stamp,(int,float)) and now>=matrix_stamp else None)\n                commit_info=self.diagnostic.get(\'fire_commit\')\n                if isinstance(commit_info,dict):\n                    commit_info[\'after_down_age_ms\']=age\n            engagement=self.engagement if isinstance(self.engagement,dict) else {}\n            lock_stamp=(engagement.get(\'first_lock_stamp\') if engagement.get(\'first_fire\') is None\n                        else self.diagnostic.get(\'aim_lock_stamp\'))\n            if isinstance(lock_stamp,(int,float)):\n                self.diagnostic[\'lock_to_fire_ms\']=max(0.,now-lock_stamp)*1000\n                self.diagnostic[\'lock_to_fire_limit_ms\']=90.\n                self.diagnostic[\'lock_to_fire_within_goal\']=self.diagnostic[\'lock_to_fire_ms\']<=90.\n            engagement=self.engagement if isinstance(self.engagement,dict) else None\n            if engagement is not None:\n                if isinstance(aim_stamp,(int,float)):\n                    if engagement.get(\'first_aim_write_stamp\') is None:\n                        engagement[\'first_aim_write_stamp\']=aim_stamp\n                first_stamp=engagement.get(\'first_aim_write_stamp\')\n                if isinstance(first_stamp,(int,float)):\n                    first_elapsed=max(0.,now-first_stamp)*1000\n                    if engagement.get(\'first_aim_to_fire_ms\') is None:\n                        engagement[\'first_aim_to_fire_ms\']=first_elapsed\n                    self.diagnostic[\'first_aim_to_fire_ms\']=engagement[\'first_aim_to_fire_ms\']\n                if isinstance(engagement.get(\'acquired\'),(int,float)):\n                    self.diagnostic[\'acquire_to_fire_ms\']=max(0.,now-engagement[\'acquired\'])*1000\n            info=self.diagnostic.get(\'fire_commit\')\n            if isinstance(info,dict):info[\'aim_to_fire_ms\']=elapsed\n            snapshot=self.diagnostic.get(\'fire_snapshot\')\n            if isinstance(snapshot,dict):\n                commit=snapshot.get(\'fire_commit\')\n                if isinstance(commit,dict):\n                    commit[\'aim_to_fire_ms\']=elapsed\n                    commit[\'after_down_age_ms\']=age\n        context=copy.deepcopy(self.diagnostic)\n        timer=getattr(self,\'aim_latency_timer\',None)\n        if timer is not None and timer.detected is not None:\n            latency=timer.snapshot(\'fire_down_submitted\' if down else \'fire_up_submitted\',\n                now=now,target=self.target,requested=True)\n            stamp=(self.diagnostic.get(\'fire_snapshot\') or {}).get(\'pose_stamp\')\n            if isinstance(stamp,(int,float)):latency[\'sample_age_ms\']=(now-stamp)*1000\n            latency.update(fire_down=bool(down),pressed=bool(down))\n            context[\'aim_latency\']=latency\n        else:\n            # An UP between acquisitions has no new detection/decision chain.\n            context.pop(\'aim_latency\',None)\n        self.actions.append({\'action\':\'fire_down\' if down else \'fire_up\',\'target\':self.target,\'mono\':now,\'reason\':why,\'aim_context\':context})\n        return True\n\n    def request_force_cancel(self, reason=\'按T取消强制瞄准开火\'):\n        """Set the cancel barrier before releasing the native primary input."""\n        self.force_cancel_requested=True\n        with self._button_lock:\n            self.reason=reason\n            self.diagnostic.update(force_cancel_requested=True,stop_reason=reason)\n            if self.pressed:\n                if not self.button(False,reason):raise RuntimeError(\'T取消释放待重试\')\n            elif self.trigger and getattr(self.trigger,\'active\',False):\n                if self.trigger.set(False) is False:raise RuntimeError(\'T取消释放待重试\')\n        # Tracking/engagement cleanup belongs to the acquisition thread.\n    def release(self,*,preserve_target=False):\n        error=None\n        released=True\n        try:\n            if self.pressed:released=self.button(False,self.reason)\n            elif self.trigger and getattr(self.trigger,\'active\',False) is True:\n                released=self.trigger.set(False) is not False\n        except Exception as ex:error=ex\n        try:\n            if self.trigger:self.trigger.secondary(False)\n        except Exception as ex:\n            if error is None:error=ex\n        if error is None and not released:error=RuntimeError(\'开火释放未确认，将继续重试\')\n        self.pressed=not released;self.trigger_stalled=False\n        if not preserve_target:self.target=0\n        self.previous_punch=(0,0,0);self.chain_until=0;self.aim_punch=None\n        self.tracking.reset()\n        self.diagnostic.update(fire_allowed=False,target=self.target,stop_reason=self.reason,trigger_after=self.pressed)\n        self.last_clear=None\n        self.engagement=None\n        if not preserve_target:self.focus_memory=None;self.pending_switch=None\n        if error:\n            self.diagnostic[\'release_error\']=str(error)\n            raise error\n\n    def pause_frame(self,frame,reason,*,ui_paused=False):\n        # A skipped Controller.step must not publish the last match\'s target,\n        # death reason, firing pose or timing as the current frame\'s decision.\n        self.reason=reason;self.input_armed=False\n        self.diagnostic=dict(frame_stamp=frame.stamp,control_stamp=self.clock(),\n            frame_age_ms=max(0.,self.clock()-frame.stamp)*1000,weapon=frame.weapon,\n            ammo=frame.ammo,angles=frame.angles,eye=frame.eye,\n            local_velocity=frame.local.velocity,local_flags=frame.local.flags,\n            target=0,fire_allowed=False,ui_paused=bool(ui_paused),\n            control_skipped=True,stop_reason=reason)\n        self.release()\n\n    def input_ready(self,reader):\n        try:\n            if not self.win.foreground(reader.mem.pid):reason=\'游戏已切到后台，停止辅助\'\n            elif reader.game_ui_visible():reason=\'游戏菜单中，辅助控制暂停\'\n            elif not self.win.down(2):\n                self.reason=\'按住右键瞄准\';self.release();return False\n            else:return True\n        except Exception as ex:\n            reason=\'输入状态读取失败，停止辅助\';self.diagnostic[\'input_guard_error\']=str(ex)\n        self.input_armed=False;self.reason=reason;self.release();return False\n\n    def identity_current(self,reader,frame,target):\n        import struct\n        if callable(getattr(reader,\'control_identity\',None)):reader.control_identity(frame)\n        entry=reader.target_entry(target.index)\n        if struct.unpack(\'<II\',reader.mem.read(entry,8))==(target.address,target.serial):return True\n        self.reason=\'目标身份变化，等待新实体\';self.release();return False\n\n    def firing_pose(self,reader,frame,target,weapon=None):\n        """Compatibility validation only; independent control refreshes below."""\n        from aim_decision import MAX_TARGET_AGE\n        stamp=target.pose_sample_stamp or frame.stamp\n        if not self.identity_current(reader,frame,target):return None\n        if not 0<=self.clock()-stamp<=MAX_TARGET_AGE:return None\n        self.diagnostic.update(fire_pose_verified=True,motion_gate=\'esp_published_pose\')\n        return target\n    def step(self,reader,frame,cfg,weapon,wall_service=None):\n        """Current sampled verdict -> point selection -> sight -> primary attack."""\n        from dataclasses import replace\n        from aim_decision import selection_tier,MAX_TARGET_AGE\n        from attack_cadence import assess as native_cadence\n        if self.force_cancel_requested:self.release();return 0\n        now=self.clock();force=bool(cfg.tab_force_fire)\n        prior_target=self.target\n        prior_actor=next((e for e in frame.entities if e.index==prior_target),None)\n        self.diagnostic=dict(frame_stamp=frame.stamp,control_stamp=now,\n            frame_age_ms=max(0.,now-frame.stamp)*1000,weapon=frame.weapon,ammo=frame.ammo,\n            control_provenance=dict(frame.control_provenance),\n            angles=frame.angles,punch=frame.punch,eye=frame.eye,shots=frame.shots,\n            target=0,trigger_before=self.pressed,tab_force_fire_active=force,\n            tab_force_fire_notice=\'允许射击遮挡目标已开启，按鼠标右键连遮挡的敌人一起打\' if force else \'\',\n            wall_mode=\'force\' if force else \'native_control_ray\',\n            weapon_identity=weapon_identity(frame),weapon_snapshot=dict(frame.weapon_state),\n            reserve_ammo=frame.weapon_state.get(\'reserve_ammo\'),accuracy=accuracy_profile(weapon))\n        self.diagnostic[\'wall_handoff\']=dict(frame.control_provenance.get(\'wall_handoff\',{}))\n        if self.trigger:\n            self.trigger.tab_force=force\n            if callable(getattr(self.trigger,\'prepare_frame\',None)):self.trigger.prepare_frame(frame)\n        foreground=bool(self.win.foreground(reader.mem.pid))\n        try:menu=reader.game_ui_visible() if foreground else True\n        except Exception as ex:\n            menu=True;self.diagnostic[\'input_guard_error\']=str(ex)\n        self.diagnostic[\'input_gate\']=dict(foreground=foreground,menu=menu,\n            frame_fresh=0<=now-frame.stamp<=.15,tab_force_fire=force,\n            aim_request=\'rmb\' if self.win.down(2) else \'none\',allow_blocked=force)\n        if (not foreground or menu or not 0<=now-frame.stamp<=.15\n                or frame.local.health<=0 or (not cfg.aim and not force) or not self.win.down(2)):\n            self.reason=(\'游戏菜单中，辅助控制暂停\' if menu and foreground else\n                \'等待游戏前台及有效数据\' if not foreground else\n                \'采样暂时过期，等待新数据\' if not 0<=now-frame.stamp<=.15 else\n                \'当前玩家已死亡\' if frame.local.health<=0 else\n                \'瞄准未开启\' if not cfg.aim and not force else \'按住右键瞄准、开火\')\n            self.release();return 0\n        self.input_armed=True\n        if not self.sync_weapon(frame,now):return 0\n        self.cadence.observe(frame,now)\n        if self.trigger:\n            self.trigger.bind(reader);self.trigger.secondary(True)\n        if force:cfg=replace(cfg,aim=True,fire=True)\n        # Independent control keeps the eye used by this acquisition\'s ray.\n        # UI telemetry and legacy offline fixtures do not renew the native pose.\n        independent=frame.control_provenance.get(\'owner\')==\'aim_process\'\n        if not independent and callable(getattr(reader,\'control_view\',None)):frame=reader.control_view(frame)\n        if prior_actor is not None and not target_is_active(prior_actor) and self.death_seen_stamp is None:\n            self.death_seen_stamp=now\n            self.target_end_reason=\'killed\' if prior_actor.health<=0 else \'inactive\'\n        previous=self.previous_focus(frame,now)\n        rows=[];rejected=[]\n        scale=1. if cfg.fire else cfg.recoil_strength if cfg.recoil else 0.\n        sight=(frame.angles[0]+frame.punch[0]*2*scale,wrap(frame.angles[1]+frame.punch[1]*2*scale),0.)\n        rank_sight=frame.angles\n        for actor in frame.entities:\n            if not actor.enemy or not target_is_active(actor) or (not cfg.aim_npcs and entity_kind(actor.classname)==\'npc\'):continue\n            key=self.last_clear.get(\'point_id\',\'\') if self.last_clear and actor.index==previous else \'\'\n            target=select_aim_view(frame,actor,weapon,now,key,allow_penetration=True,\n                require_safe=True,allow_blocked=force)\n            if target is None:\n                rejected.append(dict(index=actor.index,reject_stage=\'blocked_or_hostage_intersection\'))\n                continue\n            tier=selection_tier(target.visibility)\n            stamp=target.pose_sample_stamp or frame.stamp\n            if not 0<=self.clock()-stamp<=MAX_TARGET_AGE:\n                rejected.append(dict(index=target.index,reject_stage=\'pose_expired\'));continue\n            threat=threat_info(frame,target)\n            # Selection is shared by normal RMB aim/fire and T force-fire:\n            # treat the current crosshair as one ray, then take the nearest\n            # actor on that ray within each path class. Current visible actors\n            # always outrank positive penetration targets.\n            score,error,reason=acquisition_key(frame,target,cfg,weapon)\n            if reason:\n                rejected.append(dict(index=target.index,reject_stage=reason,error_deg=error));continue\n            rows.append((tier,score,error,target,threat))\n        self.diagnostic.update(selection_rejections=rejected,\n            selection_candidates=[dict(index=r[3].index,serial=r[3].serial,tier=r[0],\n                part=r[3].aim_part,error_deg=r[2],path_source=r[3].visibility) for r in rows])\n        if not rows:\n            self.reason=\'画面内没有有效敌人\' if force else \'画面内没有可见或可穿透的敌人\'\n            self.release();return 0\n        chosen=min(rows,key=lambda row:(row[0],row[1]))\n        tier,selected_score,_,target,threat=chosen\n        if self.pressed and self.target!=target.index:self.button(False,\'目标已切换\')\n        self.target=target.index\n        if self.death_seen_stamp is not None and prior_target!=self.target:\n            self.pending_switch=dict(from_index=prior_target,to_index=self.target,selected_stamp=self.clock(),\n                death_seen_stamp=self.death_seen_stamp,reason=getattr(self,\'target_end_reason\',\'inactive\'))\n            self.death_seen_stamp=None\n        engage=(frame.map_name,frame.local.address,frame.local.serial,target.index,target.address,target.serial,frame.weapon)\n        if not self.engagement or self.engagement[\'key\']!=engage:\n            self.engagement=dict(key=engage,acquired=now,eligible=None,first_fire=None,\n                first_aim_write_stamp=None,first_aim_to_fire_ms=None)\n        stamp=target.pose_sample_stamp or frame.stamp\n        if not 0<=self.clock()-stamp<=MAX_TARGET_AGE:\n            self.reason=\'当前骨骼采样过期\';self.release();return 0\n        if not self.input_ready(reader) or not self.identity_current(reader,frame,target):return 0\n        # The ranked frame is never the firing pose. Refresh the selected\n        # client hitbox immediately before tracking; failures release input\n        # and wait for a new sample instead of reusing the old coordinates.\n        refresh_info=dict(status=\'unavailable\',pose_reused=True)\n        refresher=getattr(self,\'pose_refresh\',None)\n        if independent and callable(refresher):\n            refreshed,refresh_info=refresher(reader,frame,target,cfg,wall_service)\n            self.diagnostic[\'pose_refresh\']=refresh_info\n            if \'motion_compensation\' in refresh_info:\n                self.diagnostic[\'motion_compensation\']=refresh_info[\'motion_compensation\']\n            if refreshed is None:\n                self.reason=\'等待当前目标骨骼刷新\'\n                self.diagnostic.update(fire_allowed=False,fire_pose_verified=False,\n                    motion_fire_ready=False,stop_reason=self.reason,pose_reused=True)\n                self.release(preserve_target=True);return 0\n            target=refreshed\n            stamp=target.pose_sample_stamp or frame.stamp\n        else:\n            self.diagnostic[\'pose_refresh\']=refresh_info\n            if independent:\n                self.reason=\'当前骨骼刷新器未就绪\';self.release();return 0\n        if not self.input_ready(reader) or not self.identity_current(reader,frame,target):return 0\n        # Refresh and the optional one-point ray may have crossed a lifecycle\n        # change. Do not write angles from an expired or cancelled acquisition.\n        if self.force_cancel_requested or not 0<=self.clock()-stamp<=MAX_TARGET_AGE:\n            self.reason=\'当前骨骼刷新已取消或过期\';self.release();return 0\n        if ((cfg.screen_acquire and ((screen:=project(target.head,frame.matrix,2,2)) is None or\n                not (0<=screen[0]<=2 and 0<=screen[1]<=2))) or\n                (not cfg.screen_acquire and angle_error(rank_sight,aim_angles(frame.eye,target.head))>cfg.fov) or\n                ray_nearest_key(frame,target,index=target.index)[0]==2):\n            refresh_info[\'status\']=\'outside_current_acquisition\'\n            self.reason=\'当前骨骼已移出选取范围\';self.release();return 0\n        refresh_info[\'before_aim_age_ms\']=(self.clock()-stamp)*1000\n        sight=(frame.angles[0]+frame.punch[0]*2*scale,wrap(frame.angles[1]+frame.punch[1]*2*scale),0.)\n        if self.trigger:self.trigger.prepare_hostage_guard(frame,weapon)\n        if self.pressed and angle_error(sight,aim_angles(frame.eye,target.head))>=aim_tolerance(frame.eye,target):\n            self.button(False,\'当前准星偏离命中盒\')\n        tracking=self.tracking.update(frame,target,1.,scale)\n        self.tracking.previous[\'part\']=target.aim_part\n        self.diagnostic.update(tracking)\n        if self.force_cancel_requested:self.release();return 0\n        from aim_latency import begin_action\n        begin_action(self)\n        out=tracking[\'out\'];reader.set_angles(out);write_at=self.clock()\n        if self.force_cancel_requested:self.release();return 0\n        self.diagnostic[\'aim_write_stamp\']=write_at\n        if force and getattr(self,\'force_first_aim_pending\',False):\n            self.diagnostic[\'t_first_aim_ms\']=max(0.,write_at-self.force_input_observed)*1000.\n            self.force_first_aim_pending=False\n        if self.engagement[\'first_aim_write_stamp\'] is None:self.engagement[\'first_aim_write_stamp\']=write_at\n        view=reader.mem.vec(reader.global_addr(\'view_angles\'))\n        punch=reader.mem.vec(frame.local.address+0xfd8)\n        verified=finite(tuple(view)+tuple(punch))\n        actual=(view[0]+punch[0]*2*scale,wrap(view[1]+punch[1]*2*scale),0.)\n        error=angle_error(actual,aim_angles(frame.eye,ta