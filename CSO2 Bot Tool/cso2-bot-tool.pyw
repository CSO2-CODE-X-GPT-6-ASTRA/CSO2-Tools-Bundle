e repeatedly. Provenance is part\n    # of the frame, not transient attributes that disappear after view writes.\n    source:str=\'\'\n    target_source:str=\'\'\n    local_source:str=\'\'\n    source_epoch:int=0\n    server_local_identity:tuple|None=None\n    server_base:int=0\n    hazard_diagnostics:dict=field(default_factory=dict)\n    weapon_state:dict=field(default_factory=dict)\n    c4_objects:list=field(default_factory=list)\n    esp_targets:dict=field(default_factory=dict,repr=False,compare=False)\n    control_provenance:dict=field(default_factory=dict,repr=False,compare=False)\n    hostage_aim_filter:dict=field(default_factory=dict,repr=False,compare=False)\n    # Ghost-mode civilian data is deliberately isolated from combat actors.\n    # Consumers that do not understand the hostage contract must never see a\n    # CHostage as an aim/fire target.  The list is populated only for a live\n    # ghost-mode frame and is cleared on every ordinary-mode acquisition.\n    hostages:list=field(default_factory=list)\n    hostage_geometry:str=\'\'\n    hostage_scope:tuple|None=None\n\nclass Reader:\n    def __init__(self,game=DEFAULT_GAME):\n        self.game=Path(game);self.profile=_BUNDLE_DATA[\'build_profile.json\']\n        self.mem=None;self.class_cache={};self.model_cache={};self.table_cache={};self.entity_scan=[];self.last_scan=0;self.status=\'未连接\';self.slot_cache={};self.sample_ms=0\n        self.menu=MenuState(self)\n        self.entity_stats={}\n        self.hazard_reader=None;self.hazard_retry=0.\n        from pose_activity import PoseActivity\n        self.pose_activity=PoseActivity()\n        self.inventory_cache={}\n        self.throwable_classes={};self.throw_states={}\n        from native_mode import NativeMode\n        self.native_mode=NativeMode(self)\n        self.resolved={};self.compatibility={};self.requested_game=str(self.game)\n        self.field_ok={};self.field_errors={};self.capabilities={};self.capability_failures={};self.next_capabilities=0.;self.module_provider=modules\n        self.pose_retry_after={}\n        self.feature_retry_after={}\n    def attach(self,pid=None):\n        if self.mem:self.close()\n        attach_started=time.monotonic()\n        self.resolved={};self.compatibility={\'requested_game\':str(self.game),\'modules\':{},\'stage\':\'discovery\'}\n        if pid is not None:\n            # A display worker already belongs to one game. Probe that PID,\n            # still validate its modules/structures, and never jump to another.\n            if isinstance(pid,bool) or not isinstance(pid,int) or pid<=4:\n                raise NotReady(\'Invalid pinned display PID\')\n            mods=self.module_provider(pid);failures=[]\n            if not all(n in mods for n in (\'client.dll\',\'engine.dll\')):\n                raise NotReady(\'Pinned display process is waiting for game modules\')\n            candidates=[(pid,mods)]\n            discovery=dict(attempts=1,wait_seconds=0.,pids=[pid],mode=\'pinned_pid\')\n        elif self.module_provider is modules:\n            candidates,failures,discovery=discover_game_modules()\n        else:\n            pids=game_pids();candidates=[];failures=[]\n            for pid in pids:\n                try:mods=self.module_provider(pid)\n                except (MemoryError,OSError) as ex:\n                    failures.append({\'pid\':pid,\'error\':str(ex),\'winerror\':getattr(ex,\'winerror\',None)});continue\n                if all(x in mods for x in (\'client.dll\',\'engine.dll\')):candidates.append((pid,mods))\n            discovery=dict(attempts=1,wait_seconds=0.,pids=pids)\n        self.compatibility.update(candidates=[{\'pid\':pid,\'game\':str(game_root(mods[\'client.dll\'][2]))} for pid,mods in candidates],\n                                  inaccessible_processes=len(failures),discovery=discovery)\n        self.compatibility[\'discovery_errors\']=failures\n        discovery_done=time.monotonic()\n        probes=[]\n        def probe(item):\n            candidate=Reader(game_root(item[1][\'client.dll\'][2]))\n            candidate.module_provider=self.module_provider\n            report={\'pid\':item[0]};probes.append(report)\n            try:\n                candidate.attach(pid=item[0])\n                if not candidate.mem.alive():raise NotReady(\'客户端进程已退出\')\n                signon=candidate.mem.i32(candidate.global_addr(\'signon\'))\n                level=candidate.mem.string(candidate.global_addr(\'level_name\'),160)\n                report.update(readable=True,signon=signon,map=level)\n                return int(signon==6 and bool(level))\n            except (NotReady,MemoryError,OSError,CompatibilityError) as ex:\n                report.update(readable=False,error=str(ex));return None\n            finally:candidate.close()\n        try:pid,self.mods=choose_candidate(candidates,self.game,probe=probe if len(candidates)>1 else None)\n        except CompatibilityError as ex:\n            message=str(ex)\n            if not candidates and failures:\n                # Names are diagnostic hints only; discovery still checks all\n                # processes, including completely renamed client executables.\n                try:names={e.th32ProcessID:e.szExeFile for e in snapshot_entries(2,0,PROCESSENTRY32W,\'Process32FirstW\',\'Process32NextW\')}\n                except MemoryError:names={}\n                for item in failures:item[\'name\']=names.get(item[\'pid\'],\'\')\n                related=[f for f in failures if any(word in f[\'name\'].casefold() for word in (\'counterstrike\',\'cso2\',\'csol2\'))]\n                if related:message=\'客户端进程无法读取；\'+\'；\'.join(f["name"]+\'：\'+f[\'error\'] for f in related[:3])\n                else:message+=f\'；另有 {len(failures)} 个进程不可读取，原因已记录到连接诊断\'\n            self.compatibility.update(error=message,candidate_probes=probes);raise NotReady(message) from ex\n        self.compatibility[\'candidate_probes\']=probes\n        self.game=game_root(self.mods[\'client.dll\'][2])\n        self.compatibility.update(pid=pid,game=str(self.game),stage=\'module_validation\')\n        try:\n            self.mem=WinMemory(pid);self.client=self.mods[\'client.dll\'][0];self.engine=self.mods[\'engine.dll\'][0]\n            self.resolve_addresses()\n            addresses_done=time.monotonic()\n            self.verify_structures()\n        except Exception as ex:\n            self.compatibility[\'error\']=str(ex)\n            self.close();raise\n        self.compatibility[\'stage\']=\'ready\'\n        self.attach_timing=dict(discovery_ms=round((discovery_done-attach_started)*1000,3),\n            addresses_ms=round((addresses_done-discovery_done)*1000,3),\n            structures_ms=round((time.monotonic()-addresses_done)*1000,3),\n            total_ms=round((time.monotonic()-attach_started)*1000,3))\n        self.compatibility[\'attach_timing\']=dict(self.attach_timing)\n        self.status=f\'已动态识别进程 {pid} · {self.game} · 等待对局数据\'\n    def resolve_addresses(self):\n        for name,spec in _BUNDLE_DATA[\'compat_specs.json\'].items():\n            self.compatibility[\'modules\'][name]={\'path\':str(self.mods[name][2]),\'verified\':False}\n            try:addresses,report=resolve_module(self.mem,self.mods[name],spec,optional_keys=set(spec[\'anchors\'])-set(self.profile[\'globals\'])-{\'netprop:m_iHealth\',\'netprop:m_iTeamNum\',\'netprop:m_vecOrigin\'})\n            except (CompatibilityError,OSError) as ex:\n                self.compatibility[\'modules\'][name].update(getattr(ex,\'report\',{}))\n                raise NotReady(str(ex)) from ex\n            self.resolved.update(addresses);report[\'verified\']=True\n            self.compatibility[\'modules\'][name]=report\n    def verify_structures(self):\n        self.field_errors={};self.field_ok={}\n        self.compatibility[\'structures\']={}\n        for sig in self.profile[\'signatures\']:\n            # The old two-byte INC/RET is neither unique nor a layout contract.\n            # local_index