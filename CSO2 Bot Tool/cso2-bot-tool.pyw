ge(80,0x80000,eye=(0.,0.,64.))\n        expect(len(bone_reads)==int(state==\'near\'),(\'hostage bone read radius\',state,bone_reads))\n        if state in (\'rescued\',\'dead\'):expect(result is None,(\'inactive hostage retained\',state))\n        else:\n            display,guard=result\n            expect(guard.bounds and display.serial==3,(\'current fallback volume lost\',state))\n            if state==\'far\':expect(display.pose_diagnostic[\'reason\']==\'outside_15m_guard\',\'far diagnostic\')\n    outcomes=[];guard_times=[]\n    for mode in (\'普通竞技\',\'幽灵模式（按阵营）\'):\n        for path in (\'visible\',\'penetrable\',\'t_force\'):\n            with private_fixture(force=path==\'t_force\') as f:\n                f.cfg=replace(f.cfg,mode=mode);f.actors[0].velocity=(0.,0.,0.)\n                original=f.reader.frame;f.guard=((72.,-2.,60.),(78.,2.,68.))\n                def frame(*a,**kw):\n                    out=original(*a,**kw)\n                    out.protected=[ProtectedEntity(80,0x80000,f.guard,sampled_at=f.now)] if f.guard else []\n                    return out\n                f.reader.frame=frame;f.ready()\n                if path==\'penetrable\':f.wall=f.obstacle(f.actors[0])\n                f.tick()\n                if mode==\'幽灵模式（按阵营）\':\n                    expect(not f.control.pressed and (0x90000,3) not in f.native_writes,(mode,path,\'unsafe DOWN\'))\n                else:\n                    expect(f.control.pressed and (0x90000,3) in f.native_writes,(mode,path,\'non-ghost firing blocked\'))\n                f.guard=None;f.now+=.01;f.tick()\n                expect(f.control.pressed,(mode,path,\'safe shot failed to recover\',f.control.reason))\n                outcomes.append((mode,path))\n    for stage in (\'aim_readback\',\'after_weapon\',\'input_owner\',\'camera\',\'expired\',\'read_error\'):\n        with private_fixture() as f:\n            f.cfg=replace(f.cfg,mode=\'幽灵模式（按阵营）\')\n            f.actors[0].velocity=(0.,0.,0.)\n            original=f.reader.frame\n            def frame(*a,**kw):\n                out=original(*a,**kw)\n                out.protected=[ProtectedEntity(80,0x80000,((440.,3.5,60.),(450.,5.5,68.)),sampled_at=f.now)]\n                return out\n            f.reader.frame=frame;f.ready()\n            if stage==\'aim_readback\':\n                original_write=f.reader.set_angles\n                def write(angles):original_write(angles);f.angles=(0.,.6,0.)\n                f.reader.set_angles=write\n                f.tick();expect(not f.control.pressed,\'actual readback ray bypassed civilian\')\n            elif stage==\'after_weapon\':\n                original_weapon=f.trigger.verify_fire_weapon\n                def verify():\n                    ok=original_weapon()\n                    if f.control.diagnostic.get(\'fire_commit\',{}).get(\'allowed\'):f.angles=(0.,.6,0.)\n                    return ok\n                f.trigger.verify_fire_weapon=verify\n                f.tick();expect(not f.control.pressed,\'post-weapon ray bypassed civilian\')\n            else:\n                f.tick();expect(f.control.pressed,(\'safe initial DOWN failed\',stage,f.control.reason))\n                if stage==\'input_owner\':f.angles=(0.,.6,0.)\n                elif stage==\'camera\':f.local.origin=(0.,4.5,0.)\n                elif stage==\'expired\':f.now+=.16\n                else:\n                    old_vec=f.reader.mem.vec\n                    def failed(address):\n                        if address==f.local.address+0x300:raise OSError(\'temporary eye read error\')\n                        return old_vec(address)\n                    f.reader.mem.vec=failed\n                with patch(\'time.monotonic\',side_effect=lambda:f.now):\n                    f.trigger.poll_weapon();released=f.trigger.service_pending_release()\n                expect(released and not f.trigger.active and (0x90000,4) in f.native_writes,\n                    (\'held native input did not release during scan\',stage,f.trigger.fire_guard))\n                expect(f.trigger.hostage_guard.get(\'allowed\') is False,(\'monitor missing evidence\',stage))\n                guard_times.append(f.trigger.hostage_guard.get(\'elapsed_ms\'))\n                if stage==\'read_error\':f.reader.mem.vec=old_vec\n                f.local.origin=(0.,0.,0.);f.angles=(0.,0.,0.);f.now+=.01;f.tick()\n                expect(f.control.pressed,(\'safe held input did not recover\',stage,f.control.reason))\n    # The 15 m boundary is measured to the volume, not its center.\n    for near in (True,False):\n        with private_fixture() as f:\n            f.cfg=replace(f.cfg,mode=\'幽灵模式（按阵营）\')\n            f.actors[0].velocity=(0.,0.,0.);original=f.reader.frame\n            def frame(*a,**kw):\n                out=original(*a,**kw);x=HOSTAGE_CHECK_DISTANCE+(-1. if near else 1.)\n                out.protected=[ProtectedEntity(80,0x80000,((x,-2.,60.),(x+8.,2.,68.)),sampled_at=f.now)]\n                return out\n            f.reader.frame=frame;f.ready();f.tick()\n            expect(f.control.pressed!=near,(\'15m boundary\',near,f.control.reason))\n    return dict(mode_path_cases=outcomes,actual_readback=True,post_weapon=True,\n        continuous_release_without_aim_tick=True,current_local_camera=True,\n        stale_and_failed_read_release=True,safe_fire_recovers=True,radius_m=15.,\n        monitor_simulated_elapsed_ms=guard_times,reader_radius_before_bones=True)\n\n\ndef permanent_log():\n    import json\n    from aim_motion_log import MotionLog\n    with tempfile.TemporaryDirectory(prefix=\'aim-motion-audit-\') as temp:\n        log=MotionLog(\'test\',999999,entry=BUNDLE_ENTRY,folder=temp)\n        try:\n            for i in range(350):\n                expect(log.emit(\'aim_cycle\',dict(bone=(150.,i,64.),correction_deg=.1)),\'audit queue unexpectedly full\')\n            log.hurt(dict(kind=\'player_hurt\',source=\'server_fire_event\',victim_index=2,attacker_index=1,hitgroup=1,damage=40))\n            log.last_state=(\'running\',\'\')\n            log.cycle(NS(diagnostic=dict(hostage_fire_checks=[dict(allowed=False,checked=1,elapsed_ms=.2)],\n                hostage_fire_guard=dict(allowed=False,reason=\'fixture_hostage_intersection\')),\n                pressed=False,reason=\'fixture_hostage_intersection\'),1,\'running\',\'\')\n            deadline=time.monotonic()+8.\n            while log.ack<352 and time.monotonic()<deadline:time.sleep(.01)\n            expect(log.ack>=352,log.metrics())\n        finally:log.close()\n        rows=[json.loads(line) for line in log.path.read_text(\'utf8\').splitlines()]\n        expect(len(rows)==353 and log.ack==log.sequence and not log.thread.is_alive(),(\'not flushed\',len(rows),log.metrics()))\n        guard=next(row[\'payload\'] for row in rows if row[\'payload\'].get(\'hostage_fire_checks\'))\n        expect(guard[\'hostage_fire_guard\'][\'allowed\'] is False and guard[\'hostage_fire_checks\'][0][\'elapsed_ms\']==.2,\n            \'hostage interception evidence missing from permanent log\')\n        expect(all(row[\'writer_pid\']!=row[\'producer_pid\'] for row in rows),\'writer is not independent process\')\n        hurt=next(row[\'payload\'] for row in rows if row[\'kind\']==\'actual_damage\')\n        expect(hurt[\'hit_part\']==\'head\' and hurt[\'actual_hit_point\'] is None and hurt[\'actual_hit_bone\'] is None,\'invented hit XYZ/bone\')\n        expect(all(row[\'bundle_sha256\'] for row in rows),\'log lacks bundle identity\')\n    return dict(records=353,independent_process=True,flush=True,no_main_log_quota=True,\n        actual_hit_evidence_honest=True,hostage_interception_logged=True)\n\n\ndef log_recovery_and_damage_feed():\n    import json\n    from unittest.mock import Mock\n    from aim_motion_log import MotionLog\n    from game_log import GameLogSink\n    with tempfile.TemporaryDirectory(prefix=\'aim-motion-recovery-\') as temp:\n        log=MotionLog(\'test\',999999,entry=BUNDLE_ENTRY,folder=temp)\n        try:\n            def acknowledged(sequence):\n                deadline=time.monotonic()+8.\n                while log.ack<sequence and time.monotonic()<deadline:time.sleep(.01)\n                expect(log.ack>=sequence,log.metrics())\n            log.emit(\'invalid_velocity\',dict(velocity=(float(\'nan\'),float(\'inf\'),0.)))\n            acknowledged(1);child=log.proc;child.kill();child.wait(timeout=2.)\n            log.emit(\'after_writer_restart\',dict(bone=(150.,2.,64.)))\n            acknowledged(2);expect(log.restarts>=1,\'writer termination did not restart transport\')\n            event=dict(kind=\'player_hurt\',source=\'server_fire_event\',sequence=10,\n                victim_index=2,attacker_index=1,local_index=1,hitgroup=1,damage=40)\n            native=Mock(dropped=0,diagnostics={});native.poll.return_value=[event]\n            text=Mock(dropped=0);text.poll.return_value=[]\n            reader=NS(mem=NS(pid=999999),session_state=dict(map=\'cs_italy\',local_index=1,observed_at=10.))\n            with patch(\'game_log.NativeHurtSink\',return_value=native) as hook,patch(\'game_log.TextLogSink\',return_value=text),\\\n                    patch(\'aim_motion_log.MotionLog\',return_value=log):\n                sink=GameLogSink(reader)\n                expect(sink.poll()==[event],\'damage feed changed existing consumers\')\n                expect(hook.call_count==1,\'damage audit installed a duplicate hurt hook\')\n                acknowledged(3);sink.close();native.close.assert_called_once()\n        finally:log.close()\n        rows=[json.loads(line) for line in log.path.read_text(\'utf8\').splitlines()]\n        invalid=next(row for row in rows if row[\'kind\']==\'invalid_velocity\')\n        expect(invalid[\'payload\'][\'velocity\']==[None,None,0.] and len(invalid[\'nonfinite_fields_recorded_as_null\'])==2,\n            \'nonfinite diagnostics poisoned the writer queue\')\n        damage=next(row[\'payload\'] for row in rows if row[\'kind\']==\'actual_damage\')\n        expect(damage[\'local_attack\'] and damage[\'observation_context\'][\'map\']==\'cs_italy\',\'damage context missing\')\n        expect(not log.thread.is_alive() and log.ack==log.sequence,\'restart left writer or unacknowledged records\')\n    return dict(writer_restart=True,nonfinite_safe=True,damage_hook_reused=True,damage_context=True)\n\n\ndef run():\n    import traceback\n    checks={}\n    for fn in (vectors_and_time,history_and_fallback,production_fire_chain,safety_and_lifecycle,\n               hostage_fire_boundaries,permanent_log,log_recovery_and_damage_feed):\n        try:checks[fn.__name__]=dict(passed=True,evidence=fn())\n        except Exception:checks[fn.__name__]=dict(passed=False,error=traceback.format_exc())\n    return dict(passed=all(row[\'passed\'] for row in checks.values()),checks=checks,\n        scope=\'private aim motion compensation and independent audit\',simulated=True,live_confirmation=False)\n')
_EMBEDDED['ghost_hostage_notice'] = (1, '"""One-way aim guard status for the ESP top-right notice; no target data."""\nimport math,time\nfrom aim_geometry import protect_hostages,hostage_check_distance\n\nTEXT=\'ESP：仅幽灵模式人质旁不射击功能开启\'\n\ndef guard_state(frame,pid,now):\n    enabled=protect_hostages(frame.mode)\n    rows=[dict(index=h.index,distance_m=hostage_check_distance(frame.eye,h)*.0254)\n          for h in frame.protected] if enabled else []\n    nearby=[r for r in rows if r[\'distance_m\']<=15.]\n    return dict(active=bool(nearby),enabled=enabled,mode=frame.mode,radius_m=15.,\n        observed_at=frame.stamp,pid=pid,map=frame.map_name,\n        local_index=frame.local.index,local_address=frame.local.address,\n        local_serial=frame.local.serial,local_team=frame.local.team,\n        nearby=nearby,errors=list(frame.protected_errors),\n        nearest_m=min((r[\'distance_m\'] for r in rows),default=None))\n\ndef display_state(state,frame,reader,now=None):\n    # Reuse only the existing display identity check, including SERVER/CLIENT\n    # identity translation. This bridge carries no bones back into aim.\n    from radar_buy_delay import display_bridge_state\n    now=time.monotonic() if now is None else now\n    if not isinstance(state,dict) or frame is None:return {}\n    age=now-state.get(\'observed_at\',-math.inf)\n    if (not state.get(\'active\') or not protect_hostages(state.get(\'mode\'))\n            or not protect_hostages(frame.mode) or not 0<=age<=.2):return {}\n    checked=display_bridge_state(dict(radar_delay=state),frame,reader,now)\n    return checked if checked.get(\'active\') else {}\n\ndef draw_notice(canvas,state,font_family,top=18,language=\'zh\',now=None):\n    now=time.monotonic() if now is None else now\n    if (not state.get(\'active\') or not protect_hostages(state.get(\'mode\'))\n            or not 0<=now-state.get(\'observed_at\',-math.inf)<=.2):return top\n    from radar_notice_layout import layout\n    text=TEXT if language!=\'en\' else \'ESP: Ghost-mode hostage protection active nearby\'\n    measure=None\n    if hasattr(canvas,\'tk\'):\n        measure=lambda font,s:int(canvas.tk.call(\'font\',\'measure\',font,s))\n    spec=layout(canvas.winfo_width(),canvas.winfo_height(),[text],font_family,measure)\n    x=spec[\'x\'];y=max(top,spec[\'y\']);radius=spec[\'outline\']\n    common=dict(text=text,font=spec[\'font\'],anchor=\'ne\')\n    for dx,dy in ((-radius,0),(radius,0),(0,-radius),(0,radius)):\n        canvas.create_text(x+dx,y+dy,fill=\'#000000\',**common)\n    canvas.create_text(x,y,fill=\'#74dfb3\',**common)\n    return y+spec[\'line_step\']\n')
_EMBEDDED['ghost_hostage_contract'] = (1, '"""Focused ghost-only hostage checks using the production private fire chain."""\nimport copy,struct,time,traceback\nfrom dataclasses import replace\nfrom types import SimpleNamespace as NS\nfrom unittest.mock import patch\n\ndef expect(value,why):\n    if not value:raise AssertionError(why)\n\ndef layout_recovery():\n    from aim_reader import AimReader\n    fields={\'m_iHealth\':0x98,\'m_lifeState\':0x97,\'m_iTeamNum\':0xa0,\'m_vecOrigin\':0x3d0,\n        \'m_nHitboxSet\':0x5e0,\'m_vecMins\':0x25c,\'m_vecMaxs\':0x268,\'m_isRescued\':0xf34}\n    raw=bytearray(len(fields)*60);strings={};reads=[]\n    for i,(name,off) in enumerate(fields.items()):\n        strings[0x70000+i*128]=name\n        struct.pack_into(\'<I\',raw,i*60,0x70000+i*128)\n        struct.pack_into(\'<i\',raw,i*60+44,off)\n    clock=[10.];ready=[False]\n    def read(a,n):\n        reads.append((a,n))\n        if a==0x30000:return b\'\\xb8\'+struct.pack(\'<I\',0x40000)+b\'\\xc3\'\n        if a==0x50000:return struct.pack(\'<Ii\',0x60000,len(fields) if ready[0] else 0)\n        if a==0x60000:return bytes(raw)\n        raise AssertionError((a,n))\n    r=AimReader.__new__(AimReader);r.table_cache={}\n    r.mem=NS(u32=lambda a:{0x10008:0x20000,0x20008:0x30000,0x4000c:0x50000}[a],\n             read=read,string=lambda a,n:strings[a])\n    with patch(\'time.monotonic\',side_effect=lambda:clock[0]):\n        expect(not r.verify_npc(0x10000,True),\'incomplete table accepted\')\n        count=len(reads);ready[0]=True;clock[0]+=.1\n        expect(not r.verify_npc(0x10000,True) and len(reads)==count,\'failed layout retries every tick\')\n        clock[0]+=.2\n        expect(r.verify_npc(0x10000,True),\'negative layout cache never recovered\')\n        count=len(reads);expect(r.verify_npc(0x10000,True) and len(reads)==count,\'positive layout cache lost\')\n        r.table_cache={(0x20000,True):False};clock[0]+=1\n        expect(r.verify_npc(0x10000,True),\'old cached failure not recovered\')\n        r.table_cache={};struct.pack_into(\'<i\',raw,7*60+44,0xf38);clock[0]+=1\n        expect(not r.verify_npc(0x10000,True),\'invalid field offset accepted\')\n    return dict(transient_recovers=True,retry_seconds=.25,invalid_layout_rejected=True)\n\ndef modes_and_crossing():\n    from independent_motion_contract import private_fixture\n    from aim_geometry import ProtectedEntity,HOSTAGE_CHECK_DISTANCE,protect_hostages\n    from aim_fire_commit import hostage_status_for_sight\n    outcomes=[]\n    for mode in (\'幽灵模式（按阵营）\',\'幽灵模式\',\'stealth\',\'普通竞技\',\'生化模式\',\'PVE\',\'自由混战\'):\n        for path in (\'visible\',\'penetrable\',\'t_force\'):\n            with private_fixture(force=path==\'t_force\',binding=\'slot3\') as f:\n                f.cfg=replace(f.cfg,mode=mode);f.actors[0].velocity=(0.,0.,0.)\n                original=f.reader.frame;f.guard=((72.,-2.,60.),(78.,2.,68.))\n                def sample(*a,**k):\n                    frame=original(*a,**k)\n                    frame.protected=[ProtectedEntity(80,0x80000,f.guard,sampled_at=f.now)] if f.guard else []\n                    return frame\n                f.reader.frame=sample;f.ready()\n                if path==\'penetrable\':f.rays.blocked.add(2);f.wall=f.obstacle(f.actors[0])\n                f.tick();ghost=mode in (\'幽灵模式（按阵营）\',\'幽灵模式\',\'stealth\')\n                expect(protect_hostages(mode)==ghost,(\'mode scope expanded\',mode))\n                expect(f.control.pressed!=ghost,(mode,path,f.control.reason))\n                if ghost:\n                    expect((0x90000,3) not in f.native_writes,\'ghost unsafe DOWN\')\n                else:\n                    stale=replace(f.loop.frame,stamp=f.now-5.,protected=[ProtectedEntity(80,0x80000,f.guard)])\n                    f.trigger.prepare_hostage_guard(stale,f.weapon)\n                    expect(f.trigger._hostage_frame is None,\'non-ghost snapshot retained\')\n                    expect(hostage_status_for_sight(stale,(0.,0.,0.),f.weapon,f.now)==(\'\',0,[]),\'non-ghost final guard\')\n                    f.now+=.01\n                    with patch(\'time.monotonic\',side_effect=lambda:f.now):\n                        expect(f.trigger.maintain(),\'non-ghost held input blocked\')\n                f.guard=None;f.now+=.01;f.tick()\n                expect(f.control.pressed and (0x90000,3) in f.native_writes,\'eligible shot failed to recover\')\n                f.ammo-=1;f.now+=.02;f.tick();expect(f.control.pressed,\'continuous fire lost after ammo\')\n                expect(not f.inputs.switches,\'RMB switched weapon\')\n                f.inputs.keys.discard(2);f.tick()\n                expect(not f.trigger.active and (0x90000,4) in f.native_writes,\'RMB release missed UP\')\n                outcomes.append((mode,path))\n    # Start just outside 15 m; cross the boundary during a pending aim scan.\n    with private_fixture() as f:\n        f.cfg=replace(f.cfg,mode=\'幽灵模式（按阵营）\');f.actors[0].velocity=(0.,0.,0.)\n        original=f.reader.frame;x=HOSTAGE_CHECK_DISTANCE+1.\n        def sample(*a,**k):\n            frame=original(*a,**k)\n            frame.protected=[ProtectedEntity(80,0x80000,((x,-2.,60.),(x+8.,2.,68.)),sampled_at=f.now)]\n            return frame\n        f.reader.frame=sample;f.ready();f.tick()\n        expect(f.control.pressed,\'outside radius blocked\')\n        expect(f.trigger._hostage_frame.protected,\'far hostage discarded before moving camera guard\')\n        f.local.origin=(2.,0.,0.);f.now+=.01\n        with patch(\'time.monotonic\',side_effect=lambda:f.now):\n            f.trigger.poll_weapon();released=f.trigger.service_pending_release()\n        expect(released and not f.trigger.active,\'15m crossing failed to release before next aim sample\')\n        expect(f.trigger.hostage_guard.get(\'checked\')==1,\'current eye radius not used\')\n        f.local.origin=(0.,0.,0.);f.now+=.01;f.tick();expect(f.control.pressed,\'leaving radius failed to recover\')\n    return dict(mode_path_cases=outcomes,crossing_without_next_scan=True,down_up=True,ammo_continues=True)\n\ndef notice_boundary():\n    from independent_motion_contract import private_fixture\n    from aim_geometry import ProtectedEntity,HOSTAGE_CHECK_DISTANCE\n    from ghost_hostage_notice import guard_state,display_state,draw_notice,TEXT\n    from overlay_service import drawing_projection\n    class Canvas:\n        def __init__(self,width):self.rows=[];self.width=width\n        def winfo_width(self):return self.width\n        def winfo_height(self):return 1080\n        def create_text(self,x,y,**kw):self.rows.append((x,y,kw))\n    with private_fixture() as f:\n        f.cfg=replace(f.cfg,mode=\'幽灵模式（按阵营）\');f.ready();f.tick()\n        frame=f.loop.frame;frame.source=\'client\'\n        frame.protected=[ProtectedEntity(80,0x80000,((100.,0.,0.),(120.,20.,70.)))]\n        now=frame.stamp+.01\n        state=guard_state(frame,f.reader.mem.pid,now)\n        expect(state[\'active\'],\'near notice absent\')\n        checked=display_state(state,frame,f.reader,now);expect(checked.get(\'active\'),\'display bridge lost valid state\')\n        for key,value in ((\'pid\',2),(\'map\',\'different\'),(\'local_serial\',99),(\'mode\',\'普通竞技\'),(\'observed_at\',now-1.)):\n            expect(not display_state(dict(state,**{key:value}),frame,f.reader,now),(\'stale notice\',key))\n        other=replace(frame,mode=\'普通竞技\');expect(not display_state(state,other,f.reader,now),\'non-ghost display\')\n        for offset,expected in ((-1.,True),(1.,False)):\n            x=HOSTAGE_CHECK_DISTANCE+offset\n            frame.protected=[ProtectedEntity(80,0x80000,((x,-2.,60.),(x+8.,2.,68.)))]\n            expect(guard_state(frame,f.reader.mem.pid,now)[\'active\']==expected,\'notice 15m boundary\')\n        for width in (360,800,1920):\n            c=Canvas(width);bottom=draw_notice(c,state,\'Microsoft YaHei\',top=160,now=now)\n            expect(bottom>160 and c.rows and c.rows[-1][2][\'text\']==TEXT,\'wrong notice text\')\n            expect(all(0<=x<=width and y>=158 for x,y,_ in c.rows),\'notice overlaps previous banner or viewport\')\n            c.rows.clear();draw_notice(c,state,\'Microsoft YaHei\',now=now+1)\n            expect(not c.rows,\'stale banner retained\')\n        frame.ghost_hostage_protection=checked\n        fake=NS(camera_matrix=lambda *a:(0.,)*16)\n        with patch(\'server_esp.camera_eye\',return_value=frame.eye):\n            projected,_=drawing_projection(fake,frame)\n        expect(projected.ghost_hostage_protection==checked,\'late projection dropped banner\')\n    return dict(radius=True,mode=True,scope=True,stale_clears=True,responsive=True,projection_preserved=True)\n\ndef run():\n    from independent_motion_contract import hostage_fire_boundaries,production_fire_chain,safety_and_lifecycle\n    checks={}\n    for fn in (layout_recovery,modes_and_crossing,notice_boundary,hostage_fire_boundaries,production_fire_chain,safety_and_lifecycle):\n        try:checks[fn.__name__]=dict(passed=True,evidence=fn())\n        except Exception:checks[fn.__name__]=dict(passed=False,error=traceback.format_exc())\n    return dict(passed=all(c[\'passed\'] for c in checks.values()),checks=checks,simulated=True,live_confirmation=False)\n')

_EMBEDDED['bundle_update'] = (1, '"""Release discovery and transactional updates for the script and managed data."""\nimport ast\nimport ctypes\nfrom ctypes import wintypes as W\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path, PurePosixPath\nimport queue\nimport re\nimport secrets\nimport shutil\nimport subprocess\nimport sys\nimport threading\nimport time\nimport zipfile\n\nMETA = BUNDLE_UPDATE_METADATA\nPRODUCT = META[\'product\']\nVERSION = META[\'version\']\nREPOSITORY_ID = META[\'repository_id\']\nDIRECTORIES = tuple(META[\'directories\'])\nMAX_ARCHIVE = 256 * 1024 * 1024\nMAX_EXPANDED = 512 * 1024 * 1024\nMAX_JSON = 4 * 1024 * 1024\n\n\ndef digest(path):\n    result = hashlib.sha256()\n    with Path(path).open(\'rb\') as stream:\n        for block in iter(lambda: stream.read(1024 * 1024), b\'\'):\n            result.update(block)\n    return result.hexdigest()\n\n\ndef canonical(value):\n    return json.dumps(value, sort_keys=True, ensure_ascii=True, separators=(\',\', \':\')).encode(\'ascii\')\n\n\ndef fingerprint(value):\n    return hashlib.sha256(canonical(value)).hexdigest()\n\n\ndef version(value):\n    if not isinstance(value, str) or not re.fullmatch(r\'(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\', value):\n        raise ValueError(\'Invalid release version\')\n    return tuple(map(int, value.split(\'.\')))\n\n\ndef trusted_url(value, api=False):\n    from urllib.parse import urlsplit\n    parsed = urlsplit(value)\n    allowed = {\'api.github.com\'} if api else {\'github.com\', \'api.github.com\',\n                \'release-assets.githubusercontent.com\', \'objects.githubusercontent.com\'}\n    if (parsed.scheme != \'https\' or parsed.hostname not in allowed or parsed.username\n            or parsed.password or parsed.port not in (None, 443)):\n        raise ValueError(\'Untrusted update URL\')\n    return value\n\n\ndef fetch(url, limit=MAX_JSON, api=False, destination=None):\n    import urllib.request\n    class Redirect(urllib.request.HTTPRedirectHandler):\n        def redirect_request(self, req, fp, code, msg, headers, newurl):\n            trusted_url(newurl, api)\n            return super().redirect_request(req, fp, code, msg, headers, newurl)\n    headers = {\'User-Agent\': \'CSO2-BOT-Tool/\' + VERSION,\n               \'Accept\': \'application/vnd.github+json\' if api else \'application/octet-stream\'}\n    if not api and \'/git/blobs/\' in url:\n        headers[\'Accept\'] = \'application/vnd.github.raw+json\'\n    if api:\n        headers[\'X-GitHub-Api-Version\'] = \'2022-11-28\'\n    request = urllib.request.Request(trusted_url(url, api), headers=headers)\n    output = Path(destination).open(\'xb\') if destination is not None else None\n    result = bytearray(); size = 0\n    try:\n        with urllib.request.build_opener(Redirect).open(request, timeout=30) as response:\n            trusted_url(response.url, api)\n            if int(response.headers.get(\'Content-Length\', \'0\')) > limit:\n                raise ValueError(\'Update download exceeds size limit\')\n            while True:\n                block = response.read(min(1024 * 1024, limit - size + 1))\n                if not block:\n                    break\n                size += len(block)\n                if size > limit:\n                    raise ValueError(\'Update download exceeds size limit\')\n                if output is None:\n                    result.extend(block)\n                else:\n                    output.write(block)\n        if output is not None:\n            output.flush(); os.fsync(output.fileno())\n        return bytes(result) if output is None else size\n    finally:\n        if output is not None:\n            output.close()\n\n\ndef fetch_json(url, api=True):\n    return json.loads(fetch(url, MAX_JSON, api))\n\n\ndef safe_name(name):\n    if not isinstance(name, str) or not name or len(name) > 240:\n        raise ValueError(\'Invalid package path\')\n    path = PurePosixPath(name)\n    if path.is_absolute() or path.as_posix() != name:\n        raise ValueError(\'Invalid package path\')\n    for part in path.parts:\n        if (part in (\'.\', \'..\') or re.search(r\'[\\x00-\\x1f\\\\:<>"|?*]\', part)\n                or part.endswith((\' \', \'.\'))\n                or re.fullmatch(r\'(?i)(CON|PRN|AUX|NUL|COM[0-9]|LPT[0-9])(?:\\..*)?\', part)):\n            raise ValueError(\'Invalid package path\')\n    return path\n\n\ndef regular(path):\n    stat = path.lstat()\n    if path.is_symlink() or getattr(stat, \'st_file_attributes\', 0) & 0x400:\n        raise ValueError(\'Update paths must not be symbolic links or junctions\')\n    return stat\n\n\ndef file_record(path):\n    stat = regular(path)\n    if not path.is_file():\n        raise ValueError(\'Expected a regular file\')\n    return dict(size=stat.st_size, sha256=digest(path))\n\n\ndef directory_files(root):\n    if not root.exists():\n        return {}\n    regular(root)\n    if not root.is_dir():\n        raise ValueError(\'Expected a managed directory\')\n    result = {}\n    for path in sorted(root.rglob(\'*\')):\n        regular(path)\n        if path.is_file():\n            relative = path.relative_to(root).as_posix()\n            safe_name(relative)\n            result[relative] = file_record(path)\n    return result\n\n\ndef root_fingerprint(path):\n    if not path.exists():\n        return None\n    regular(path)\n    return fingerprint(directory_files(path)) if path.is_dir() else digest(path)\n\n\ndef validate_manifest(manifest):\n    if (not isinstance(manifest, dict) or manifest.get(\'schema\') != 2\n            or manifest.get(\'product\') != PRODUCT or manifest.get(\'repository_id\') != REPOSITORY_ID\n            or manifest.get(\'directories\') != list(DIRECTORIES)):\n        raise ValueError(\'Invalid BOT TOOL release manifest\')\n    version(manifest[\'version\'])\n    entry = manifest.get(\'entry\', \'\')\n    if len(safe_name(entry).parts) != 1 or not entry.lower().endswith(\'.pyw\'):\n        raise ValueError(\'Invalid entry script\')\n    files = manifest.get(\'files\')\n    if not isinstance(files, dict) or not 3 <= len(files) <= 20000 or entry not in files:\n        raise ValueError(\'Invalid release inventory\')\n    seen = set(); total = 0\n    for name, item in files.items():\n        parts = safe_name(name).parts\n        if name != entry and (len(parts) < 2 or parts[0] not in DIRECTORIES):\n            raise ValueError(\'Package contains an unmanaged path\')\n        if name.casefold() in seen:\n            raise ValueError(\'Duplicate package path\')\n        seen.add(name.casefold())\n        if (not isinstance(item, dict) or type(item.get(\'size\')) is not int\n                or not 0 <= item[\'size\'] <= MAX_ARCHIVE\n                or not re.fullmatch(\'[0-9a-f]{64}\', str(item.get(\'sha256\', \'\')))):\n            raise ValueError(\'Invalid release file metadata\')\n        total += item[\'size\']\n    if total > MAX_EXPANDED or any(not any(n.startswith(d + \'/\') for n in files) for d in DIRECTORIES):\n        raise ValueError(\'Incomplete or oversized release\')\n    if manifest.get(\'revision\') != fingerprint(dict(entry=entry, files=files)):\n        raise ValueError(\'Release inventory checksum mismatch\')\n    archive = manifest.get(\'archive\', {})\n    if (not isinstance(archive, dict) or len(safe_name(archive.get(\'asset\', \'\')).parts) != 1\n            or not archive[\'asset\'].lower().endswith(\'.zip\')\n            or type(archive.get(\'size\')) is not int or not 0 < archive[\'size\'] <= MAX_ARCHIVE\n            or not re.fullmatch(\'[0-9a-f]{64}\', str(archive.get(\'sha256\', \'\')))):\n        raise ValueError(\'Invalid update archive\')\n    return manifest\n\n\ndef expected_roots(manifest, target_name):\n    result = {target_name: manifest[\'files\'][manifest[\'entry\']][\'sha256\']}\n    for directory in DIRECTORIES:\n        files = {name[len(directory) + 1:]: row for name, row in manifest[\'files\'].items()\n                 if name.startswith(directory + \'/\')}\n        result[directory] = fingerprint(files)\n    return result\n\n\ndef snapshot(target):\n    target = Path(target).resolve()\n    return {name: root_fingerprint(target.parent / name) for name in (target.name, *DIRECTORIES)}\n\n\ndef discover(target, get_json=None):\n    import base64\n    from urllib.parse import quote\n    get_json = get_json or fetch_json\n    repo = get_json(f\'https://api.github.com/repositories/{REPOSITORY_ID}\')\n    if repo.get(\'id\') != REPOSITORY_ID:\n        raise ValueError(\'Update repository identity mismatch\')\n    api_url = trusted_url(repo[\'url\'], True)\n    candidates = []\n    for page in range(1, 11):\n        releases = get_json(api_url + f\'/releases?per_page=100&page={page}\')\n        if not isinstance(releases, list):\n            raise ValueError(\'Invalid releases response\')\n        for release in releases:\n            tag = str(release.get(\'tag_name\', \'\'))\n            if release.get(\'draft\') or release.get(\'prerelease\') or not tag.startswith(META[\'tag_prefix\']):\n                continue\n            try:\n                number = version(tag[len(META[\'tag_prefix\']):])\n            except ValueError:\n                continue\n            if number >= version(VERSION):\n                candidates.append((number, release))\n        if len(releases) < 100:\n            break\n    if not candidates:\n        return None\n    branch = quote(repo[\'default_branch\'], safe=\'\')\n    tree = get_json(f\'{api_url}/git/trees/{branch}?recursive=1\')\n    if tree.get(\'truncated\') or not isinstance(tree.get(\'tree\'), list):\n        raise ValueError(\'Incomplete update source tree\')\n    blobs = {r[\'path\']: r for r in tree[\'tree\'] if r.get(\'type\') == \'blob\'}\n    for _, release in sorted(candidates, key=lambda row: row[0], reverse=True):\n        suffix = \'/releases/\' + release[\'tag_name\'] + \'/\' + PRODUCT + \'.release.json\'\n        rows = [r for path, r in blobs.items() if path.endswith(suffix)]\n        if not rows:\n            continue\n        if len(rows) != 1 or rows[0].get(\'size\', 0) > MAX_JSON:\n            raise ValueError(\'BOT TOOL source manifest is ambiguous or oversized\')\n        row = rows[0]; blob = get_json(trusted_url(row[\'url\'], True))\n        if blob.get(\'encoding\') != \'base64\':\n            raise ValueError(\'Invalid source manifest encoding\')\n        manifest = validate_manifest(json.loads(base64.b64decode(blob[\'content\'])))\n        if release[\'tag_name\'] != META[\'tag_prefix\'] + manifest[\'version\']:\n            raise ValueError(\'Release version mismatch\')\n        archive = manifest[\'archive\']\n        archive_path = row[\'path\'].rsplit(\'/\', 1)[0] + \'/\' + archive[\'asset\']\n        archive_blob = blobs.get(archive_path)\n        if archive_blob is None or archive_blob.get(\'size\') != archive[\'size\']:\n            raise ValueError(\'Source update archive is missing or incomplete\')\n        before = snapshot(target)\n        expected = expected_roots(manifest, Path(target).name)\n        if before == expected:\n            return None\n        return dict(manifest=manifest, before=before,\n                    download_url=trusted_url(archive_blob[\'url\']),\n                    page_url=trusted_url(release[\'html_url\']),\n                    changed=[name for name in expected if expected[name] != before[name]])\n    return None\n\n\ndef validate_script(path, release_version):\n    raw = path.read_bytes()\n    if len(raw) > 16 * 1024 * 1024:\n        raise ValueError(\'Oversized update script\')\n    tree = ast.parse(raw.decode(\'utf-8-sig\'))\n    wanted = dict(APP_ID=PRODUCT, APP_VERSION=release_version, UPDATE_REPOSITORY_ID=REPOSITORY_ID,\n                  UPDATE_PROTOCOL=2, UPDATE_TAG_PREFIX=META[\'tag_prefix\'], UPDATE_COMPONENT_DIRS=DIRECTORIES)\n    found = {}\n    for node in tree.body:\n        if isinstance(node, ast.Assign):\n            for target in node.targets:\n                if isinstance(target, ast.Name) and target.id in wanted:\n                    if target.id in found:\n                        raise ValueError(\'Duplicate update identity\')\n                    found[target.id] = ast.literal_eval(node.value)\n    if found != wanted:\n        raise ValueError(\'Downloaded script belongs to a different tool or protocol\')\n    compile(tree, \'<BOT TOOL release>\', \'exec\')\n\n\ndef extract_package(archive, destination, manifest):\n    with zipfile.ZipFile(archive) as package:\n        items = package.infolist()\n        if len(items) != len(manifest[\'files\']) or {i.filename for i in items} != set(manifest[\'files\']):\n            raise ValueError(\'Archive inventory mismatch\')\n        for item in items:\n            record = manifest[\'files\'][item.filename]\n            mode = (item.external_attr >> 16) & 0o170000\n            if item.is_dir() or mode not in (0, 0o100000) or item.file_size != record[\'size\']:\n                raise ValueError(\'Invalid archive member\')\n            path = destination.joinpath(*safe_name(item.filename).parts)\n            path.parent.mkdir(parents=True, exist_ok=True)\n            size = 0; checksum = hashlib.sha256()\n            with package.open(item) as source, path.open(\'xb\') as output:\n                for block in iter(lambda: source.read(1024 * 1024), b\'\'):\n                    size += len(block)\n                    if size > record[\'size\']:\n                        raise ValueError(\'Expanded file size mismatch\')\n                    checksum.update(block); output.write(block)\n            if size != record[\'size\'] or checksum.hexdigest() != record[\'sha256\']:\n                raise ValueError(\'Expanded file checksum mismatch\')\n    validate_script(destination / manifest[\'entry\'], manifest[\'version\'])\n\n\ndef write_json(path, value):\n    temporary = path.with_suffix(path.suffix + \'.tmp\')\n    with temporary.open(\'w\', encoding=\'utf-8\') as stream:\n        json.dump(value, stream, ensure_ascii=True)\n        stream.flush(); os.fsync(stream.fileno())\n    os.replace(temporary, path)\n\n\ndef prepare(target, info, download=None):\n    target = Path(target).resolve(); regular(target)\n    manifest = validate_manifest(info[\'manifest\'])\n    before = snapshot(target)\n    if before != info[\'before\']:\n        raise RuntimeError(\'Local files changed after the update check; check again\')\n    for name in before:\n        if (target.parent / (name + \'.OLD\')).exists():\n            raise RuntimeError(\'An OLD backup already exists; preserve or recover it before another update\')\n    token = secrets.token_hex(16)\n    stage = target.parent / (\'.cso2-bot-update-\' + token)\n    stage.mkdir()\n    try:\n        archive = stage / \'download.zip\'\n        (download or fetch)(info[\'download_url\'], manifest[\'archive\'][\'size\'], destination=archive)\n        if archive.stat().st_size != manifest[\'archive\'][\'size\'] or digest(archive) != manifest[\'archive\'][\'sha256\']:\n            raise ValueError(\'Downloaded archive checksum mismatch\')\n        payload = stage / \'payload\'; payload.mkdir()\n        extract_package(archive, payload, manifest)\n        archive.unlink()\n        # An independent copy can keep applying/rolling back while the entry moves.\n        shutil.copyfile(target, stage / \'runner.pyw\')\n        plan = dict(schema=2, product=PRODUCT, repository_id=REPOSITORY_ID, token=token,\n                    target=target.name, parent_pid=os.getpid(), phase=\'prepared\',\n                    manifest=manifest, before=before, after=expected_roots(manifest, target.name))\n        ticket = stage / \'ticket.json\'; write_json(ticket, plan)\n        return ticket\n    except Exception:\n        # The stage was created above, under this exact tool root, with our token.\n        shutil.rmtree(stage)\n        raise\n\n\ndef read_ticket(ticket):\n    ticket = Path(ticket).absolute()\n    regular(ticket); regular(ticket.parent)\n    if ticket.name != \'ticket.json\' or ticket.stat().st_size > MAX_JSON:\n        raise ValueError(\'Invalid update ticket\')\n    plan = json.loads(ticket.read_text(encoding=\'utf-8\'))\n    token = plan.get(\'token\', \'\')\n    if (not re.fullmatch(\'[0-9a-f]{32}\', str(token))\n            or ticket.parent.name != \'.cso2-bot-update-\' + token\n            or plan.get(\'schema\') != 2 or plan.get(\'product\') != PRODUCT\n            or plan.get(\'repository_id\') != REPOSITORY_ID):\n        raise ValueError(\'Invalid update ticket identity\')\n    target_name = plan.get(\'target\', \'\')\n    if len(safe_name(target_name).parts) != 1 or not target_name.lower().endswith(\'.pyw\'):\n        raise ValueError(\'Invalid local script name\')\n    manifest = validate_manifest(plan[\'manifest\'])\n    if plan.get(\'after\') != expected_roots(manifest, target_name):\n        raise ValueError(\'Invalid update target checksums\')\n    before = plan.get(\'before\', {})\n    if set(before) != {target_name, *DIRECTORIES}:\n        raise ValueError(\'Invalid backup inventory\')\n    for value in before.values():\n        if value is not None and not re.fullmatch(\'[0-9a-f]{64}\', str(value)):\n            raise ValueError(\'Invalid backup checksum\')\n    if type(plan.get(\'parent_pid\')) is not int or plan[\'parent_pid\'] <= 0:\n        raise ValueError(\'Invalid old process identity\')\n    return plan, ticket.parent.parent / target_name\n\n\ndef wait_parent(pid, timeout=90):\n    if pid == os.getpid():\n        raise ValueError(\'The updater must run in a separate process\')\n    kernel = ctypes.WinDLL(\'kernel32\', use_last_error=True)\n    kernel.OpenProcess.argtypes = [W.DWORD, W.BOOL, W.DWORD]; kernel.OpenProcess.restype = W.HANDLE\n    kernel.WaitForSingleObject.argtypes = [W.HANDLE, W.DWORD]; kernel.WaitForSingleObject.restype = W.DWORD\n    kernel.CloseHandle.argtypes = [W.HANDLE]; kernel.CloseHandle.restype = W.BOOL\n    handle = kernel.OpenProcess(0x100000, False, pid)\n    if not handle:\n        if ctypes.get_last_error() == 87:\n            return\n        raise OSError(\'Cannot confirm that the previous tool exited\')\n    try:\n        if kernel.WaitForSingleObject(handle, int(timeout * 1000)) != 0:\n            raise TimeoutError(\'Previous tool is still shutting down; update cancelled\')\n    finally:\n        kernel.CloseHandle(handle)\n\n\ndef spawn(arguments):\n    return subprocess.Popen([sys.executable, \'-X\', \'utf8\', *map(str, arguments)],\n                            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n                            creationflags=getattr(subprocess, \'CREATE_NO_WINDOW\', 0), close_fds=True)\n\n\ndef acknowledge(ticket, running_path):\n    plan, target = read_ticket(ticket)\n    if (target.resolve() != Path(running_path).resolve() or plan[\'manifest\'][\'version\'] != VERSION\n            or snapshot(target) != plan[\'after\']):\n        raise ValueError(\'New application files did not pass startup verification\')\n    ready = Path(ticket).parent / \'ready.json\'\n    write_json(ready, dict(token=plan[\'token\'], pid=os.getpid(), revision=plan[\'manifest\'][\'revision\']))\n\n\ndef remove_verified_backup(path, expected):\n    if root_fingerprint(path) != expected:\n        raise RuntimeError(\'OLD backup changed; retained for recovery: \' + path.name)\n    if path.is_dir():\n        shutil.rmtree(path)\n    else:\n        path.unlink()\n\n\ndef apply(ticket, wait=None, launch=None, timeout=90, notify=None):\n    ticket = Path(ticket).absolute(); plan, target = read_ticket(ticket)\n    stage = ticket.parent; launch = launch or spawn\n    notify = notify or (lambda message: ctypes.windll.user32.MessageBoxW(None, message, \'CSO2 BOT Tool Update\', 0x10))\n    moved = []; installed = []; child = None; confirmed = False\n    names = [*DIRECTORIES, target.name]\n    try:\n        (wait or wait_parent)(plan[\'parent_pid\'])\n        if snapshot(target) != plan[\'before\']:\n            raise RuntimeError(\'Local files changed before installation; update cancelled\')\n        staged_target = stage / \'payload\' / plan[\'manifest\'][\'entry\']\n        if snapshot(staged_target) != expected_roots(plan[\'manifest\'], staged_target.name):\n            raise ValueError(\'Staged files changed before installation\')\n        validate_script(staged_target, plan[\'manifest\'][\'version\'])\n        for name in names:\n            if (target.parent / (name + \'.OLD\')).exists():\n                raise RuntimeError(\'Refusing to overwrite an existing OLD backup\')\n        plan[\'phase\'] = \'applying\'; write_json(ticket, plan)\n        for name in names:\n            current = target.parent / name\n            incoming = stage / \'payload\' / (plan[\'manifest\'][\'entry\'] if name == target.name else name)\n            if current.exists():\n                os.rename(current, target.parent / (name + \'.OLD\')); moved.append(name)\n            os.replace(incoming, current); installed.append(name)\n        plan[\'phase\'] = \'installed\'; write_json(ticket, plan)\n        child = launch([target, \'--bot-update-ticket\', ticket])\n        deadline = time.monotonic() + timeout\n        while time.monotonic() < deadline:\n            if child.poll() is not None:\n                raise RuntimeError(\'New application exited before startup confirmation\')\n            ready = stage / \'ready.json\'\n            if ready.exists():\n                message = json.loads(ready.read_text(encoding=\'utf-8\'))\n                if message.get(\'token\') != plan[\'token\'] or message.get(\'revision\') != plan[\'manifest\'][\'revision\']:\n                    raise ValueError(\'Invalid startup acknowledgement\')\n                confirmed = True\n                plan[\'phase\'] = \'confirmed\'; write_json(ticket, plan)\n                for name in moved:\n                    remove_verified_backup(target.parent / (name + \'.OLD\'), plan[\'before\'][name])\n                shutil.rmtree(stage)\n                return True\n            time.sleep(.1)\n        raise TimeoutError(\'New application did not confirm successful startup\')\n    except Exception as error:\n        if confirmed:\n            notify(\'新版已启动，部分 OLD 尚未清理，已保留。\\n\' + str(error))\n            return True\n        if child is not None and child.poll() is None:\n            # Ask the new UI to use its normal worker/input cleanup. Do not kill\n            # a process that may still own mouse bindings or primary attack.\n            (stage / \'cancel\').write_text(plan[\'token\'], encoding=\'ascii\')\n            try:\n                child.wait(timeout=45)\n            except subprocess.TimeoutExpired:\n                notify(\'新版仍在退出，OLD 已保留。关闭工具后可恢复旧文件。\\n\' + str(error))\n                return False\n        recovered = True\n        try:\n            for name in reversed(names):\n                current = target.parent / name\n                old = target.parent / (name + \'.OLD\')\n                if name in installed:\n                    if root_fingerprint(current) != plan[\'after\'][name]:\n                        raise RuntimeError(\'New files changed; automatic recovery stopped\')\n                    failed = stage / \'payload\' / (plan[\'manifest\'][\'entry\'] if name == target.name else name)\n                    os.replace(current, failed)\n                if name in moved:\n                    if root_fingerprint(old) != plan[\'before\'][name]:\n                        raise RuntimeError(\'OLD changed; automatic recovery stopped\')\n                    os.replace(old, current)\n            plan[\'phase\'] = \'rolled_back\'; write_json(ticket, plan)\n            if moved or installed:\n                launch([target, \'--skip-bot-update-once\'])\n        except Exception:\n            recovered = False\n        notify((\'更新失败，已恢复旧版。\\n\' if recovered and (moved or installed)\n                else \'更新未完成，原文件或 OLD 已保留。\\n\') + str(error))\n        return False\n\n\nclass ReleaseUpdater:\n    def __init__(self, app):\n        self.app = app; self.root = app.root; self.target = BUNDLE_ENTRY\n        self.inbox = queue.Queue(); self.busy = False; self.notified = set()\n        self.dialog = None; self.info = None; self.ticket = None\n        if \'--bot-update-ticket\' in sys.argv:\n            index = sys.argv.index(\'--bot-update-ticket\')\n            if index + 1 >= len(sys.argv):\n                raise ValueError(\'Missing update startup ticket\')\n            self.ticket = Path(sys.argv[index + 1])\n            read_ticket(self.ticket)\n            # The queue acknowledgement is delivered from Tk only after the\n            # window is visible and all installed files have been checked.\n            self.root.after(700, self.check_startup)\n        self.root.after(200, self.poll)\n        if \'--skip-bot-update-once\' not in sys.argv:\n            self.root.after(5000, self.periodic)\n\n    def text(self, zh, en):\n        return en if getattr(self.app.i18n, \'lang\', \'zh\') == \'en\' else zh\n\n    def background(self, operation, kind):\n        if self.busy or self.app.closing:\n            return\n        self.busy = True\n        def work():\n            try:\n                self.inbox.put((kind, operation()))\n            except Exception as error:\n                self.inbox.put((\'error\', (kind, str(error))))\n        threading.Thread(target=work, name=\'bot-release-update\', daemon=True).start()\n\n    def periodic(self):\n        if self.app.closing:\n            return\n        self.background(lambda: discover(self.target), \'checked\')\n        self.root.after(30 * 60 * 1000, self.periodic)\n\n    def check_startup(self):\n        if self.app.closing:\n            return\n        def verify():\n            plan, target = read_ticket(self.ticket)\n            if target.resolve() != self.target.resolve() or snapshot(target) != plan[\'after\']:\n                raise ValueError(\'Installed files failed startup verification\')\n            return plan\n        self.background(verify, \'startup_verified\')\n\n    def show(self, info):\n        import tkinter as tk\n        from tkinter import ttk\n        if self.dialog is not None and self.dialog.winfo_exists():\n            self.dialog.lift(); return\n        self.info = info\n        dialog = self.dialog = tk.Toplevel(self.root)\n        dialog.title(\'CSO2 BOT Tool Update\'); dialog.transient(self.root); dialog.resizable(False, False)\n        frame = ttk.Frame(dialog, padding=20); frame.pack(fill=\'both\', expand=True)\n        ttk.Label(frame, text=self.text(\'发现更新\', \'Update available\'), font=(\'Segoe UI\', 13, \'bold\')).pack(anchor=\'w\')\n        ttk.Label(frame, text=\'v\' + info[\'manifest\'][\'version\']).pack(anchor=\'w\', pady=(8, 4))\n        ttk.Label(frame, text=self.text(\'脚本或配套文件有更新。下载后会重启工具，\\n新版启动成功后删除 OLD 备份。\',\n                  \'An update is available for the script or its data.\\nThe tool restarts; OLD backups are removed after successful startup.\'),\n                  justify=\'left\').pack(anchor=\'w\')\n        buttons = ttk.Frame(frame); buttons.pack(anchor=\'w\', pady=(14, 0))\n        self.download_button = ttk.Button(buttons, text=self.text(\'直接下载\', \'Download\'), command=self.download)\n        self.download_button.pack(side=\'left\')\n        def open_page():\n            import webbrowser\n            webbrowser.open(trusted_url(info[\'page_url\']))\n        ttk.Button(buttons, text=self.text(\'访问远端 Release\', \'Open Release\'), command=open_page).pack(side=\'left\', padx=(10, 0))\n        self.progress = ttk.Label(frame, text=\'\', wraplength=460)\n        self.progress.pack(anchor=\'w\', pady=(10, 0))\n\n    def download(self):\n        if self.busy or self.app.closing:\n            return\n        self.download_button.state([\'disabled\'])\n        self.progress.configure(text=self.text(\'正在下载并校验…\', \'Downloading and verifying…\'))\n        self.background(lambda: prepare(self.target, self.info), \'prepared\')\n\n    def poll(self):\n        from tkinter import messagebox\n        if self.app.closing:\n            return\n        if self.ticket is not None and (self.ticket.parent / \'cancel\').exists():\n            self.app.close(); return\n        try:\n            while True:\n                kind, result = self.inbox.get_nowait(); self.busy = False\n                if kind == \'checked\' and result:\n                    revision = result[\'manifest\'][\'revision\']\n                    if revision not in self.notified:\n                        self.notified.add(revision); self.show(result)\n                elif kind == \'prepared\':\n                    try:\n                        self.app.save(silent=True)\n                        spawn([result.parent / \'runner.pyw\', \'--bot-apply-update\', result])\n                        self.app.close()\n                    except Exception as error:\n                        self.inbox.put((\'error\', (\'prepared\', str(error))))\n                elif kind == \'startup_verified\':\n                    if self.root.winfo_exists() and not self.app.closing:\n                        acknowledge(self.ticket, self.target)\n                elif kind == \'error\':\n                    source, message = result\n                    if source == \'checked\':\n                        continue  # Offline/limited API access must not interrupt play.\n                    if self.dialog is not None and self.dialog.winfo_exists():\n                        self.download_button.state([\'!disabled\'])\n                        self.progress.configure(text=self.text(\'更新失败，可重试或访问 Release。\', \'Update failed. Retry or open Release.\'))\n                    messagebox.showerror(\'CSO2 BOT Tool Update\', message, parent=self.root)\n        except queue.Empty:\n            pass\n        if not self.app.closing:\n            self.root.after(200, self.poll)\n')

