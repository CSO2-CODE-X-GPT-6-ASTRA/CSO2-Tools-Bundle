_EMBEDDED['collision_cache_io'] = (1, '"""Flat, external obstacle data, relative to the running entry script."""\nimport base64\nimport hashlib\nimport json\nimport os\nimport threading\nimport zlib\nfrom collections.abc import Mapping\nfrom contextlib import contextmanager\nfrom pathlib import Path\n\nDATA_DIRECTORY = \'1 - Shoot Through Data 射击穿透数据\'\nINDEX_NAME = \'wall_data_index.json\'\nINDEX_SCHEMA = \'cso2.obstacle-data.v1\'\nCACHE_ROOT = None\n_lock = threading.RLock()\n_indexes = {}\n_global_model_indexes = {}\n_local = threading.local()\n\n\ndef unpack_records(payload, size, checksum):\n    """Decode immutable fallback metadata once at import, off the frame loop."""\n    decoder = zlib.decompressobj()\n    raw = decoder.decompress(base64.b85decode(payload), size + 1)\n    if (len(raw) != size or not decoder.eof or decoder.unused_data or\n            hashlib.sha256(raw).hexdigest() != checksum):\n        raise ValueError(\'embedded obstacle metadata checksum\')\n    value = json.loads(raw)\n    if not isinstance(value, dict):\n        raise ValueError(\'embedded obstacle metadata shape\')\n    return value\n\n\ndef cache_root(entry=None, environ=None):\n    entry = Path(entry or BUNDLE_ENTRY).resolve()\n    env = os.environ if environ is None else environ\n    override = env.get(\'CSO2_COLLISION_CACHE\', \'\').strip()\n    if override:\n        value = Path(override).expanduser()\n        if not value.is_absolute():\n            raise ValueError(\'CSO2_COLLISION_CACHE must be an absolute directory\')\n        return value.resolve()\n    return entry.parent / DATA_DIRECTORY\n\n\ndef _root():\n    # Normalize both the explicit mount and the default sibling mount.  The\n    # candidate workspace uses a junction to the formal data directory; the\n    # old branch compared an unresolved root with a resolved file path and\n    # rejected every flat resource as "out of bounds".\n    return (Path(CACHE_ROOT).resolve() if CACHE_ROOT is not None\n            else cache_root().resolve())\n\n\ndef resource_roots():\n    # One authoritative mount; never silently borrow data from old directories.\n    return (_root(),)\n\n\ndef resource_locations():\n    return dict(resource_source=\'external_obstacle_mount\',\n                searched_roots=[str(p) for p in resource_roots()],\n                data_directory=DATA_DIRECTORY, index_file=INDEX_NAME,\n                explicit_override=bool(CACHE_ROOT is not None or\n                    os.environ.get(\'CSO2_COLLISION_CACHE\', \'\').strip()),\n                game_client_resources_checked=False)\n\n\ndef _resource_error(error, filename):\n    error.resource_relative = filename\n    return error\n\n\ndef _flat_path(filename):\n    if (not isinstance(filename, str) or not filename or\n            filename in (\'.\', \'..\') or any(c in filename for c in \'/\\\\:\')):\n        raise _resource_error(ValueError(\'obstacle data requires a flat filename: \' + str(filename)), str(filename))\n    root = _root()\n    path = (root / filename).resolve()\n    if path.parent != root:\n        raise _resource_error(ValueError(\'obstacle data path bounds: \' + filename), filename)\n    return path\n\n\ndef read_blob(relative, expected):\n    path = _flat_path(relative)\n    try:\n        raw = path.read_bytes()\n    except FileNotFoundError as exc:\n        raise _resource_error(FileNotFoundError(\'BOT TOOL 外部障碍物数据缺失：\' + relative +\n            \'；请补全脚本同级 \' + DATA_DIRECTORY + \'；不是游戏地图文件缺失\'), relative) from exc\n    except OSError as exc:\n        raise _resource_error(OSError(\'外部障碍物数据读取失败：\' + relative +\n            \'; code=\' + str(getattr(exc, \'winerror\', None) or exc.errno)), relative) from exc\n    if hashlib.sha256(raw).hexdigest() != expected:\n        raise _resource_error(ValueError(\'obstacle data identity mismatch: \' + relative), relative)\n    return raw\n\n\ndef _read_index(refresh=False):\n    key = str(_root())\n    with _lock:\n        if not refresh and key in _indexes:\n            value = _indexes[key]\n            if isinstance(value, Exception):\n                raise value\n            return value\n        try:\n            try:\n                raw = _flat_path(INDEX_NAME).read_bytes()\n            except FileNotFoundError:\n                # Baseline manifests still recover the original release if its\n                # index alone is lost. Changed/new data requires the new index.\n                value = None\n            else:\n                if len(raw) > 16 * 1024 * 1024:\n                    raise ValueError(\'obstacle index exceeds 16 MiB\')\n                value = json.loads(raw)\n                if not isinstance(value, dict) or value.get(\'schema\') != INDEX_SCHEMA:\n                    raise ValueError(\'obstacle index schema mismatch\')\n                for section in (\'world\', \'props\', \'models\', \'world_meta\', \'props_meta\'):\n                    if not isinstance(value.get(section), dict):\n                        raise ValueError(\'obstacle index section invalid: \' + section)\n        except (OSError, ValueError, TypeError) as exc:\n            value = _resource_error(exc, INDEX_NAME)\n        if len(_indexes) > 8:\n            _indexes.clear()\n        _indexes[key] = value\n        if isinstance(value, Exception):\n            raise value\n        return value\n\n\ndef _index():\n    pinned = getattr(_local, \'snapshot\', None)\n    return pinned[1] if pinned is not None and pinned[0] == str(_root()) else _read_index()\n\n\ndef global_model_index(refresh=False):\n    """Build a map-wide model-name -> shared hull identity index.\n\n    Prop payloads intentionally keep their local ``models`` table small.  A\n    later map can still reference a model first seen on another map, so the\n    local table is not sufficient to resolve an instance\'s closed hull.  This\n    function is called during map loading only; the result is cached per\n    external mount and never touched by the frame/control loop.\n    """\n    root = str(_root())\n    with _lock:\n        if not refresh and root in _global_model_indexes:\n            value = _global_model_indexes[root]\n            if isinstance(value, Exception):\n                raise value\n            return value\n        try:\n            index = _index()\n            if index is None:\n                value = {}\n            else:\n                result = {}\n                sources = {}\n                for map_name, row in sorted(index.get(\'props\', {}).items()):\n                    relative, expected = row\n                    raw = zlib.decompress(read_blob(relative, expected))\n                    payload = json.loads(raw)\n                    models = payload.get(\'models\', {})\n                    if not isinstance(models, dict):\n                        raise ValueError(\'obstacle props model table invalid: \' + str(map_name))\n                    for model, identity in models.items():\n                        if not isinstance(model, str) or not isinstance(identity, str):\n                            raise ValueError(\'obstacle model identity invalid: \' + str(map_name))\n                        previous = result.get(model)\n                        if previous is not None and previous != identity:\n                            raise ValueError(\'obstacle model identity conflict: \' + model)\n                        result[model] = identity\n                        sources.setdefault(model, []).append(map_name)\n                value = dict(result)\n        except (OSError, ValueError, TypeError, KeyError, zlib.error, json.JSONDecodeError) as exc:\n            value = _resource_error(exc, INDEX_NAME)\n        if len(_global_model_indexes) > 8:\n            _global_model_indexes.clear()\n        _global_model_indexes[root] = value\n        if isinstance(value, Exception):\n            raise value\n        return value\n\n\n@contextmanager\ndef data_snapshot(refresh=False):\n    """Pin one index version for a complete map load/probe, off the frame loop."""\n    previous = getattr(_local, \'snapshot\', None)\n    root = str(_root())\n    if previous is not None and previous[0] == root:\n        yield previous[1]\n        return\n    value = _read_index(refresh)\n    _local.snapshot = (root, value)\n    try:\n        yield value\n    finally:\n        _local.snapshot = previous\n\n\ndef _section(name, baseline):\n    index = _index()\n    value = baseline if index is None else index.get(name, baseline)\n    if not isinstance(value, dict):\n        raise _resource_error(ValueError(\'obstacle index section invalid: \' + name), INDEX_NAME)\n    return value\n\n\nclass IndexedRecords(Mapping):\n    def __init__(self, section, baseline):\n        self.section, self.baseline = section, baseline\n\n    def __getitem__(self, key):\n        return _section(self.section, self.baseline)[key]\n\n    def __iter__(self):\n        return iter(_section(self.section, self.baseline))\n\n    def __len__(self):\n        return len(_section(self.section, self.baseline))\n\n\nclass FrozenBlobMap(Mapping):\n    # Public name retained for embedded callers; payloads are EXTERNAL files.\n    def __init__(self, manifest, family=None):\n        self.baseline, self.family = manifest, family\n\n    @property\n    def manifest(self):\n        return _section(self.family, self.baseline) if self.family else self.baseline\n\n    def __len__(self):\n        return len(self.manifest)\n\n    def __iter__(self):\n        return iter(self.manifest)\n\n    def __getitem__(self, key):\n        relative, expected = self.manifest[key]\n        return base64.b85encode(read_blob(relative, expected)).decode(\'ascii\')\n\n\ndef map_metadata_token(key):\n    """Only current-map metadata participates; another map\'s edit stays local."""\n    index = _index()\n    if index is None:\n        return \'\'\n    selected = {s: index.get(s, {}).get(key) for s in\n                (\'world_meta\', \'props_meta\', \'surface_materials\', \'bbox_corrections\')}\n    # These shared classifications legitimately apply across maps.\n    selected[\'thin_model_materials\'] = index.get(\'thin_model_materials\', {})\n    selected[\'wood_model_materials\'] = index.get(\'wood_model_materials\', {})\n    return hashlib.sha256(json.dumps(selected, sort_keys=True, separators=(\',\', \':\')).encode()).hexdigest()\n\n\ndef verify_resources():\n    from wall_training import _GEOMETRY_B85\n    from static_guard_data import GUARD_DATA, MODEL_DATA\n    checked = total_bytes = expected_count = 0\n    errors = []\n    try:\n        with data_snapshot(refresh=True):\n            for family, values in ((\'world\', _GEOMETRY_B85), (\'props\', GUARD_DATA), (\'models\', MODEL_DATA)):\n                expected_count += len(values)\n                for key, row in values.manifest.items():\n                    filename = str(key)\n                    try:\n                        filename, expected = row\n                        total_bytes += len(read_blob(filename, expected))\n                        checked += 1\n                    except (OSError, ValueError, TypeError) as exc:\n                        errors.append(dict(family=family, key=key, file=filename, error=str(exc)))\n    except (OSError, ValueError, TypeError) as exc:\n        errors.append(dict(file=getattr(exc, \'resource_relative\', INDEX_NAME), error=str(exc)))\n    return dict(passed=not errors, checked=checked, bytes=total_bytes,\n                expected=expected_count, errors=errors, policy=\'flat_entry_relative_mount\',\n                resource_locations=resource_locations(),\n                override=bool(os.environ.get(\'CSO2_COLLISION_CACHE\', \'\').strip()))\n')
