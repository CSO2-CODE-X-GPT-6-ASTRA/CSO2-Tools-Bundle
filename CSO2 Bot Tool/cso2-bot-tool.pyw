_EMBEDDED['aim_points'] = (1, '\n"""Model-derived aim samples and ghost-mode civilian ray exclusion."""\nfrom dataclasses import dataclass,replace,field\nimport math,struct\nfrom geometry import add,sub,length,finite,box_ray,box_ray_interval\n\n\ndef protect_hostages(mode):\n    return mode in (\'stealth\',\'幽灵模式\',\'幽灵模式（按阵营）\')\n\n\n@dataclass\nclass AimPoint:\n    key:str\n    part:str\n    position:tuple\n    radius:float\n    priority:int\n    visibility:str=\'blocked\'\n    wall_text:str=\'遮挡\'\n    wall_age_ms:float|None=None\n    wall_head_shift:float|None=None\n    wall_eye_shift:float|None=None\n    penetrable:bool=False\n    penetration:dict=field(default_factory=dict)\n    head_region:str=\'center\'\n    model_local:tuple|None=None\n\n\ndef head_region_label(key):\n    """Stable model-relative label for the sampled skull coordinate."""\n    if not isinstance(key,str) or \':eye:\' not in key:return \'center\'\n    try:n=int(key.rsplit(\':\',1)[-1])\n    except (TypeError,ValueError):return \'center\'\n    return {0:\'eye_center\',1:\'eye_right\',2:\'eye_left\',3:\'eye_upper\',4:\'eye_lower\',\n            5:\'eye_upper_right\',6:\'eye_upper_left\',7:\'eye_lower_right\',8:\'eye_lower_left\'}.get(n,\'eye_ring\')\n\n\n@dataclass\nclass ProtectedEntity:\n    index:int\n    address:int\n    bounds:tuple|None\n    dormant:bool=False\n    hitboxes:tuple=()\n    sampled_at:float|None=None\n\n\n@dataclass(frozen=True)\nclass PoseHitbox:\n    bounds:tuple\n    origin:tuple\n    inverse:tuple\n    scales:tuple\n    group:int=-1\n\n    def intersects(self,start,delta,margin=0.):\n        return self.intersection(start,delta,margin) is not None\n\n    def intersection(self,start,delta,margin=0.):\n        relative=sub(start,self.origin)\n        local_start=tuple(sum(a*b for a,b in zip(row,relative)) for row in self.inverse)\n        local_delta=tuple(sum(a*b for a,b in zip(row,delta)) for row in self.inverse)\n        low,high=self.bounds\n        expanded=(tuple(low[i]-margin/self.scales[i] for i in range(3)),\n                  tuple(high[i]+margin/self.scales[i] for i in range(3)))\n        return box_ray_interval(expanded,local_start,local_delta)\n\n\ndef pose_transform(blob,bone,origin,factor,cache):\n    """Share only this pose\'s corrected basis between samples and hitboxes."""\n    key=(bone,factor)\n    if key not in cache:\n        from scale_geometry import visual_matrix\n        matrix=visual_matrix(struct.unpack_from(\'<12f\',blob,bone*48),origin,factor)\n        a,b,c,tx,d,e,f,ty,g,h,i,tz=matrix\n        scales=(math.sqrt(a*a+d*d+g*g),math.sqrt(b*b+e*e+h*h),math.sqrt(c*c+f*f+i*i))\n        sx,sy,sz=scales\n        orthogonal=(min(scales)>0 and abs(a*b+d*e+g*h)<1e-3*sx*sy\n                    and abs(a*c+d*f+g*i)<1e-3*sx*sz and abs(b*c+e*f+h*i)<1e-3*sy*sz)\n        cache[key]=(matrix,scales,orthogonal)\n    return cache[key]\n\n\ndef world_hitboxes(boxes,blob,origin,geometry_scale=1.,visual_factor=1.,head_visual_factor=None,*,pose_cache=None):\n    """Keep bone-local boxes oriented; an incomplete pose uses collision fallback."""\n    result=[];transforms={} if pose_cache is None else pose_cache\n    for bone,group,bounds in boxes:\n        if bone<0 or (bone+1)*48>len(blob) or len(bounds)!=6 or not finite(bounds):return ()\n        if not all(.01<bounds[i+3]-bounds[i]<4096 for i in range(3)):return ()\n        factor=head_visual_factor if group==1 and head_visual_factor is not None else visual_factor\n        matrix,scales,orthogonal=pose_transform(blob,bone,origin,factor,transforms)\n        axes=[tuple(matrix[j*4+i] for j in range(3)) for i in range(3)]\n        position=(matrix[3],matrix[7],matrix[11])\n        from scale_geometry import point_valid\n        if not finite(matrix) or min(scales)<=0 or not point_valid(position,origin,geometry_scale):return ()\n        if any(abs(sum(a*b for a,b in zip(axes[i],axes[j])))>1e-3*scales[i]*scales[j]\n               for i in range(3) for j in range(i)):return ()\n        inverse=tuple(tuple(v/(scales[i]**2) for v in axis) for i,axis in enumerate(axes))\n        result.append(PoseHitbox((tuple(bounds[:3]),tuple(bounds[3:])),position,inverse,scales,group))\n    return tuple(result)\n\n\ndef hitbox_envelope(boxes):\n    """World envelope computed once per pose for the cheap rejection pass."""\n    low=[float(\'inf\')]*3;high=[-float(\'inf\')]*3\n    for box in boxes:\n        a,b=box.bounds;center=tuple((a[i]+b[i])*.5 for i in range(3));half=tuple((b[i]-a[i])*.5 for i in range(3))\n        axes=tuple(tuple(v*box.scales[i]**2 for v in row) for i,row in enumerate(box.inverse))\n        for j in range(3):\n            middle=box.origin[j]+sum(axes[i][j]*center[i] for i in range(3))\n            extent=sum(abs(axes[i][j])*half[i] for i in range(3))\n            low[j]=min(low[j],middle-extent,box.origin[j]);high[j]=max(high[j],middle+extent,box.origin[j])\n    return tuple(low),tuple(high)\n\n\nHOSTAGE_MAX_ENVELOPE_SPAN=256.\nHOSTAGE_MAX_RAY_MARGIN=4.\n# Source world units are inches.  The aim/fire hostage guard is intentionally\n# local: a hostage more than 15 metres from the player\'s eye is outside this\n# expensive protection path, while nearby hostages retain exact OBB checks.\nSOURCE_UNITS_PER_METER=1./.0254\nHOSTAGE_CHECK_DISTANCE=15.*SOURCE_UNITS_PER_METER\n\n\ndef hostage_check_distance(eye, hostage):\n    """Return the shortest eye-to-volume distance in Source units."""\n    bounds=getattr(hostage,\'bounds\',None)\n    if bounds is None:\n        boxes=getattr(hostage,\'hitboxes\',()) or ()\n        if boxes: bounds=bounded_hostage_envelope(boxes)\n    if bounds is None:return 0.\n    try:\n        low,high=bounds;distance=0.\n        for i in range(3):\n            if eye[i]<low[i]:distance+=(low[i]-eye[i])**2\n            elif eye[i]>high[i]:distance+=(eye[i]-high[i])**2\n        return math.sqrt(distance)\n    except (TypeError,ValueError,IndexError,OverflowError):\n        return 0.\n\n\ndef hostage_is_nearby(eye, hostage):\n    """Apply the 15 m local guard before any per-point collision work."""\n    return hostage_check_distance(eye,hostage)<=HOSTAGE_CHECK_DISTANCE\n\ndef bounded_hostage_envelope(boxes,fallback=None):\n    """Return a finite, per-pose civilian envelope with a hard size bound.\n\n    The envelope is only a broad phase.  Exact current OBBs remain the\n    decision geometry when available.  Rejecting malformed/oversized data is\n    preferable to turning a bad model transform into a map-wide hostage\n    blocker; the caller may use its own validated collision fallback.\n    """\n    candidates=[]\n    if boxes:\n        try:candidates.append(hitbox_envelope(boxes))\n        except (TypeError,ValueError,IndexError,OverflowError):pass\n    if fallback is not None:candidates.append(fallback)\n    for candidate in candidates:\n        try:\n            low,high=candidate\n            if (len(low)!=3 or len(high)!=3 or not finite(tuple(low)+tuple(high))\n                    or any(not low[i]<high[i] for i in range(3))\n                    or any(high[i]-low[i]>HOSTAGE_MAX_ENVELOPE_SPAN for i in range(3))):continue\n            return tuple(float(v) for v in low),tuple(float(v) for v in high)\n        except (TypeError,ValueError,IndexError,OverflowError):continue\n    return None\n\n\ndef hostage_ray_margin(age,distance,cone_deg):\n    """Bound uncertainty without expanding a civilian into a wall-sized box."""\n    try:\n        age=min(.1,max(0.,float(age)));distance=max(0.,float(distance));cone=max(0.,float(cone_deg))\n        spread=distance*math.tan(math.radians(min(5.,cone)))\n        return min(HOSTAGE_MAX_RAY_MARGIN,1.+age*32.+min(2.,spread))\n    except (TypeError,ValueError,OverflowError):\n        return HOSTAGE_MAX_RAY_MARGIN\n\n\ndef sample_definitions(boxes,names,head_box,eye_local=None):\n    """Centers first, then inset face samples; all remain inside real hitboxes."""\n    centers=[];edges=[];eyes=[]\n    for i,(bone,group,bounds) in enumerate(boxes):\n        if not 0<=bone<len(names) or len(bounds)!=6 or not finite(bounds):continue\n        extent=[bounds[k+3]-bounds[k] for k in range(3)]\n        if not all(.02<x<4096 for x in extent):continue\n        center=tuple((bounds[k]+bounds[k+3])*.5 for k in range(3))\n        is_head=bool(head_box and bone==head_box[0] and center==head_box[1])\n        name=names[bone].lower()\n        if is_head:part,priority=\'head\',0\n        elif group==1:part,priority=\'head\',.2\n        elif group==3 or any(s in name for s in (\'pelvis\',\'hip\',\'bip01 pelvis\')):part,priority=\'pelvis\',2\n        elif group==2 or any(s in name for s in (\'spine\',\'chest\',\'body\')):part,priority=\'torso\',1\n        elif group in (4,5) or any(s in name for s in (\'arm\',\'hand\')):part,priority=\'arm\',3\n        elif group in (6,7) or any(s in name for s in (\'thigh\',\'calf\',\'leg\',\'foot\')):part,priority=\'leg\',4\n        elif group==0:part,priority=\'body\',2\n        else:continue\n        radius=min(extent)*.5\n        # The model\'s ``eyes`` attachment is expressed in this same hitbox\n        # local frame. Generate a small inscribed ring around it, so tall,\n        # short and scaled models use their own eye neighborhood rather than a\n        # world-space Z offset. Hitgroup remains head; this is only a point\n        # choice inside the native head box.\n        if is_head and eye_local is not None:\n            eye=list(eye_local[\'point\']);u,v=eye_local[\'axes\']\n            step=max(.08,min(extent)*.14)\n            for n,(dy,dz) in enumerate(((0.,0.),(1.,0.),(-1.,0.),(0.,1.),(0.,-1.),\n                                         (.707,.707),(-.707,.707),(.707,-.707),(-.707,-.707))):\n                local=list(eye)\n                margin=min(extent)*.08\n                local[u]=max(bounds[u]+margin,min(bounds[u+3]-margin,eye[u]+dy*step))\n                local[v]=max(bounds[v]+margin,min(bounds[v+3]-margin,eye[v]+dz*step))\n                local=tuple(local)\n                inset=min(local[k]-bounds[k] for k in range(3))\n                inset=min(inset,*(bounds[k+3]-local[k] for k in range(3)))\n                if inset>.02:eyes.append((f\'{i}:eye:{n}\',part,bone,local,max(.02,inset*.90),-10+n*.01))\n        centers.append((f\'{i}:c\',part,bone,center,radius,priority*10))\n        if part in (\'head\',\'pelvis\',\'torso\',\'body\'):\n            for axis in range(3):\n                for sign in (-1,1):\n                    point=list(center);point[axis]+=sign*extent[axis]*.28\n                    # Radius is distance to the nearest face after the offset.\n                    r=min(point[k]-bounds[k] for k in range(3))\n                    r=min(r,*(bounds[k+3]-point[k] for k in range(3)))\n                    edges.append((f\'{i}:{axis}:{sign}\',part,bone,tuple(point),r,priority*10+1))\n    # Keep every real hitbox center (studio metadata already caps 256 boxes).\n    # Optional rings/edges are bounded separately; truncating centers to 20\n    # silently excluded valid arm/leg bones on larger generic rigs.\n    centers.sort(key=lambda p:p[-1]);edges.sort(key=lambda p:p[-1])\n    return sorted((eyes[:12]+centers+edges[:max(0,48-len(eyes[:12]+centers))]),key=lambda p:p[-1])\n\n\ndef world_samples(definitions,blob,good,origin,geometry_scale=1.,visual_factor=1.,head_visual_factor=None,*,pose_cache=None):\n    """Project model-local aim samples through the same scale correction as ESP.\n\n    ``good`` is calculated from corrected matrices, so using the raw cache here\n    would leave automatic aim one model-size behind whenever the game stores a\n    normalized bone cache.  Head samples may use a separate factor when the\n    host tool scales head and body independently.\n    """\n    result=[];transforms={} if pose_cache is None else pose_cache;ox,oy,oz=origin\n    from scale_geometry import point_valid\n    for key,part,bone,point,radius,priority in definitions:\n        if not good.get(bone):continue\n        factor=head_visual_factor if part==\'head\' and head_visual_factor is not None else visual_factor\n        matrix,scales,valid=pose_transform(blob,bone,origin,factor,transforms)\n        if not valid:continue\n        scale=min(scales)\n        x,y,z=point;a,b,c,tx,d,e,f,ty,g,h,i,tz=matrix\n        px=a*x+b*y+c*z+tx;py=d*x+e*y+f*z+ty;pz=g*x+h*y+i*z+tz\n        if point_valid((px,py,pz),origin,geometry_scale):\n            result.append(AimPoint(key,part,(px,py,pz),radius*scale,priority,\n                                   head_region=head_region_label(key),model_local=tuple(point)))\n    return result\n\n\ndef candidate_points(entity):\n    from target_rules import target_is_active\n    from high_threat_models import is_high_threat_model\n    if not target_is_active(entity):return []\n    high_threat=is_high_threat_model(getattr(entity,\'model\',\'\'))\n    # A validated empty list is an intentional ESP decision: every sampled\n    # bone was behind the hostage envelope.  Do not fall back to ``entity.head``\n    # and accidentally re-introduce the rejected firing line.\n    if entity.aim_points or getattr(entity,\'aim_points_validated\',False):\n        points=entity.aim_points if getattr(entity,\'aim_points_validated\',False) else [p for p in entity.aim_points if point_in_actor(p.position,entity)]\n        # Anatomical labels describe real samples, not damage multipliers.\n        # All six native body regions are eligible on the requested rigs.\n        if high_threat:\n            from high_threat_models import valid_native_point\n            points=[p for p in points if valid_native_point(p)]\n        return points\n    if high_threat:return []\n    if not entity.head:return []\n    if not point_in_actor(entity.head,entity):return []\n    return [AimPoint(\'head\',\'head\',entity.head,entity.head_radius or 2.5,0,\n                     entity.visibility,entity.wall_text,entity.wall_age_ms,\n                     entity.wall_head_shift,entity.wall_eye_shift,entity.wall_penetrable,entity.penetration)]\n\n\ndef _hostage_point_ray(eye,point,ray_length):\n    """Prepare a full weapon corridor once, independent of hostage count."""\n    x=point[0]-eye[0];y=point[1]-eye[1];z=point[2]-eye[2]\n    if not finite((x,y,z)):return None\n    distance=math.sqrt(x*x+y*y+z*z)\n    if distance<1e-6:return None\n    reach=max(distance,float(ray_length) if math.isfinite(ray_length) else distance)\n    return x*reach/distance,y*reach/distance,z*reach/distance\n\n\ndef _hostage_point_intersection(eye, point, hostage, margin, ray_length=8192.,*,first_hit=False):\n    """Return the first normalized hit of an aim-point ray with a hostage.\n\n    ``PoseHitbox`` uses the same normalized segment convention as\n    ``box_ray_interval``.  The point radius is converted to a small world\n    margin so a bone\'s envelope, rather than only its center, is protected.\n    """\n    # Match the final hostage guard: a shot is protected for the complete\n    # weapon corridor, so a civilian behind the enemy also removes that one\n    # direction.  A safe bone on another side of the actor remains eligible.\n    delta=_hostage_point_ray(eye,point,ray_length)\n    if delta is None:return None\n    return _hostage_ray_intersection(eye,delta,hostage,margin,first_hit=first_hit)\n\n\ndef _hostage_ray_intersection(eye,delta,hostage,margin,*,first_hit=False):\n    return _hostage_volume_intersection(eye,delta,_hostage_volume(hostage,margin),\n                                       margin,first_hit=first_hit)\n\n\ndef _hostage_volume(hostage,margin):\n    """Prepare broad geometry separately from a point\'s exact OBB margin."""\n    boxes=getattr(hostage,\'hitboxes\',()) or ()\n    if boxes and not getattr(hostage,\'dormant\',False):\n        envelope=_hostage_point_envelope(hostage,boxes,margin)\n        individual=getattr(hostage,\'_point_box_envelopes\',{}).get(margin)\n        return envelope,boxes,individual,None\n    return None,(),None,getattr(hostage,\'bounds\',None)\n\n\ndef _hostage_volume_intersection(eye,delta,volume,margin,*,first_hit=False):\n    envelope,boxes,individual,bounds=volume\n    if boxes:\n        if envelope is not None and not box_ray(envelope,eye,delta):return None\n        hit=None\n        candidates=zip(boxes,individual) if individual is not None else ((box,None) for box in boxes)\n        for box,bounds in candidates:\n            if bounds is not None and not box_ray(bounds,eye,delta):continue\n            interval=box.intersection(eye,delta,margin)\n            if interval is not None:\n                if first_hit:return interval[0]\n                if hit is None or interval[0]<hit:hit=interval[0]\n        return hit\n    if bounds is None:return None\n    low,high=bounds\n    expanded=(tuple(low[i]-margin for i in range(3)),\n              tuple(high[i]+margin for i in range(3)))\n    interval=box_ray_interval(expanded,eye,delta)\n    return None if interval is None else interval[0]\n\n\ndef _hostage_point_envelope(hostage,boxes,margin):\n    """Exact conservative world envelope of the expanded local OBBs.\n\n    Invert the actual world-to-local matrix rather than assuming a perfectly\n    orthogonal pose. A collision fallback cannot bound a displaced hitbox and\n    is never substituted here. Invalid envelopes only disable this shortcut.\n    """\n    if getattr(hostage,\'_point_envelope_pose\',None) is not boxes:\n        hostage._point_envelope_pose=boxes;hostage._point_envelopes={};hostage._point_box_envelopes={}\n    cache=hostage._point_envelopes\n    if margin in cache:return cache[margin]\n    low=[float(\'inf\')]*3;high=[-float(\'inf\')]*3;individual=[]\n    try:\n        for box in boxes:\n            (a,b,c),(d,e,f),(g,h,i)=box.inverse\n            det=a*(e*i-f*h)-b*(d*i-f*g)+c*(d*h-e*g)\n            if not math.isfinite(det) or abs(det)<1e-20:raise ValueError(\'singular pose\')\n            rows=(((e*i-f*h)/det,(c*h-b*i)/det,(b*f-c*e)/det),\n                  ((f*g-d*i)/det,(a*i-c*g)/det,(c*d-a*f)/det),\n                  ((d*h-e*g)/det,(b*g-a*h)/det,(a*e-b*d)/det))\n            lo,hi=box.bounds\n            center=tuple((lo[k]+hi[k])*.5 for k in range(3))\n            half=tuple((hi[k]-lo[k])*.5+margin/box.scales[k] for k in range(3))\n            box_low=[];box_high=[]\n            for j,row in enumerate(rows):\n                mid=box.origin[j]+sum(row[k]*center[k] for k in range(3))\n                extent=sum(abs(row[k])*half[k] for k in range(3))\n                low[j]=min(low[j],mid-extent);high[j]=max(high[j],mid+extent)\n                box_low.append(mid-extent);box_high.append(mid+extent)\n            pad=1e-7*max(1.,*(abs(v) for v in box_low+box_high))\n            individual.append((tuple(v-pad for v in box_low),tuple(v+pad for v in box_high)))\n        if not finite(low+high) or any(low[k]>high[k] for k in range(3)):raise ValueError(\'invalid envelope\')\n        # Outward rounding leaves grazing rays in the exact narrow phase.\n        pad=1e-7*max(1.,*(abs(v) for v in low+high))\n        result=(tuple(v-pad for v in low),tuple(v+pad for v in high))\n    except (TypeError,ValueError,IndexError,OverflowError,ZeroDivisionError):result=None;individual=None\n    if len(cache)<64:\n        cache[margin]=result;hostage._point_box_envelopes[margin]=individual\n    return result\n\n\ndef hostage_candidates_for_points(eye,points,hostages,ray_length,*,rays=None,broad_margin=0.):\n    """Reject entire off-ray hostages before the per-bone loop.\n\n    The packet envelope contains every full-length ray from this eye through\n    the current actor\'s points. Overlap merely requests precise point tests.\n    """\n    if not points or not hostages:return ()\n    low=list(eye);high=list(eye);margin=broad_margin\n    if rays is None:rays=(_hostage_point_ray(eye,p.position,ray_length) for p in points)\n    for p,delta in zip(points,rays):\n        if delta is None:return tuple(hostages)\n        for i,v in enumerate(delta):\n            end=eye[i]+v;low[i]=min(low[i],end);high[i]=max(high[i],end)\n        margin=max(margin,max(.15,min(3.,p.radius*.35)))\n    result=[]\n    for h in hostages:\n        boxes=getattr(h,\'hitboxes\',()) or ()\n        if boxes and not h.dormant:envelope=_hostage_point_envelope(h,boxes,margin)\n        else:\n            bounds=getattr(h,\'bounds\',None)\n            envelope=None if bounds is None else (tuple(v-margin for v in bounds[0]),tuple(v+margin for v in bounds[1]))\n        if envelope is None or all(low[i]<=envelope[1][i] and high[i]>=envelope[0][i] for i in range(3)):\n            result.append(h)\n    return tuple(result)\n\n\ndef hostage_safe_points(eye,points,hostages,ray_length):\n    """Filter one independent acquisition, reusing each prepared ray."""\n    if not points or not hostages:return points\n    rays=[_hostage_point_ray(eye,p.position,ray_length) for p in points]\n    # Every exact point margin is capped at three world units. A shared\n    # envelope at that cap is conservative and needs only one construction\n    # per current hostage pose, even across models with different radii.\n    broad_margin=3.\n    possible=hostage_candidates_for_points(eye,points,hostages,ray_length,\n                                          rays=rays,broad_margin=broad_margin)\n    if not possible:return points\n    margins=[max(.15,min(3.,p.radius*.35)) for p in points]\n    # One conservative volume per hostage covers every point radius in this\n    # packet. Exact OBB tests still use the individual point\'s margin. This\n    # also bounds envelope work when models have many distinct bone radii.\n    volumes=[_hostage_volume(h,broad_margin) for h in possible]\n    kept=[]\n    for p,delta,margin in zip(points,rays,margins):\n        if delta is None:kept.append(p);continue\n        for volume in volumes:\n            if _hostage_volume_intersection(eye,delta,volume,margin,first_hit=True) is not None:break\n        else:kept.append(p)\n    return kept\n\n\ndef filter_hostage_aim_points(frame):\n    """Filter enemy bones that would put a ghost-mode hostage in the shot.\n\n    This is the sole producer-side hostage policy.  It removes only the\n    individual points whose eye-to-bone segment intersects a hostage volume;\n    other bones on the same actor stay eligible.  Other modes return without\n    touching entities or allocating hostage state.\n    """\n    if not protect_hostages(getattr(frame,\'mode\',\'\')):\n        result=dict(enabled=False,filtered=0,actors=0,hostages=0)\n        setattr(frame,\'hostage_aim_filter\',result)\n        return result\n    hostages=tuple(getattr(frame,\'protected\',()) or ())\n    if not hostages:\n        result=dict(enabled=True,filtered=0,actors=0,hostages=0)\n        setattr(frame,\'hostage_aim_filter\',result)\n        return result\n    total=actors=0\n    details=[]\n    eye=tuple(frame.eye)\n    for entity in getattr(frame,\'entities\',()) or ():\n        if not getattr(entity,\'enemy\',False):continue\n        points=list(getattr(entity,\'aim_points\',()) or ())\n        if not points and not getattr(entity,\'aim_points_validated\',False):continue\n        actors+=1;kept=[];removed=[]\n        for point in points:\n            margin=max(.15,min(3.,float(getattr(point,\'radius\',0.) or 0.)*.35))\n            first=None;hostage_id=None\n            for hostage in hostages:\n                entry=_hostage_point_intersection(eye,point.position,hostage,margin)\n                if entry is not None and (first is None or entry<first):\n                    first=entry;hostage_id=getattr(hostage,\'index\',None)\n            if first is None:kept.append(point)\n            else:\n                removed.append(dict(key=point.key,index=hostage_id,entry=float(first)))\n        if removed:\n            entity.aim_points=kept\n            entity.aim_points_validated=True\n            # Prevent the legacy head fallback when every published point was\n            # rejected by the producer-side hostage geometry.\n            if not kept:entity.head=None;entity.aim_id=\'\';entity.aim_part=\'\'\n            entity.hostage_filtered_points=removed\n            total+=len(removed)\n            details.append(dict(index=entity.index,removed=len(removed),remaining=len(kept),points=removed))\n    result=dict(enabled=True,filtered=total,actors=actors,hostages=len(hostages),details=details)\n    setattr(frame,\'hostage_aim_filter\',result)\n    return result\n\n\ndef point_in_actor(point,entity):\n    if not finite(point):return False\n    bounds=getattr(entity,\'pose_bounds\',None)\n    return bounds is None or all(bounds[0][i]<=point[i]<=bounds[1][i] for i in range(3))\n\n\ndef hostage_ray_status(frame,point,weapon=None,now=None,cone_deg=0.,diagnostic=None):\n    if not protect_hostages(frame.mode):return \'\'\n    # Read failures remain in telemetry; only readable civilian geometry blocks a shot.\n    if not frame.protected:return \'\'\n    delta=sub(point,frame.eye);distance=length(delta)\n    if distance<.001 or not finite(delta):return \'射线无效\'\n    # Check past the enemy as bullets can penetrate. Unknown spread is not\n    # modeled; the margin covers alignment tolerance and sample age only.\n    reach=float((weapon or {}).get(\'Range\',8192.))\n    if not math.isfinite(reach) or reach<=0:reach=8192.\n    reach=max(distance,reach)\n    ray=tuple(v*reach/distance for v in delta)\n    stamp=frame.stamp if now is None else now\n    failed={e.get(\'index\') for e in getattr(frame,\'protected_errors\',[]) if e.get(\'stage\')==\'hostage\'}\n    def blocked(hostage,entry):\n        if diagnostic is not None:\n            diagnostic.append(dict(index=hostage.index,entry_distance=entry*reach,\n                decision=\'intersects_firing_ray\'))\n        return True\n    for hostage in frame.protected:\n        if hostage.index in failed:continue\n        sampled=hostage.sampled_at if hostage.sampled_at is not None else frame.stamp\n        age=max(0.,stamp-sampled)\n        # A remote/dormant hostage does not disable the whole map. Only its\n        # own intersecting volume matters. Fresh native poses use precise OBBs.\n        if hostage.hitboxes and not hostage.dormant and age<=.1:\n            if getattr(hostage,\'_envelope_pose\',None) is not hostage.hitboxes:\n                hostage._envelope=bounded_hostage_envelope(hostage.hitboxes,hostage.bounds)\n                hostage._envelope_pose=hostage.hitboxes\n            if hostage._envelope is None:\n                # No finite envelope is safe to test.  The validated fallback\n                # below remains available when the native hitbox packet is\n                # still rebuilding; never let an exception widen the guard.\n                hostage._envelope_pose=None\n                if hostage.bounds is None:continue\n            else:\n                low,high=hostage._envelope\n                far=math.sqrt(sum(max(abs(low[i]-frame.eye[i]),abs(high[i]-frame.eye[i]))**2 for i in range(3)))\n                # The narrow phase expands along all three rotated local axes;\n                # keep the broad-phase margin bounded so a nearby enemy foot is\n                # not rejected merely because the hostage sample is late.\n                margin=hostage_ray_margin(age,far,cone_deg)*math.sqrt(3.)\n                envelope=(tuple(v-margin for v in low),tuple(v+margin for v in high))\n                if not box_ray(envelope,frame.eye,ray):continue\n                entries=[]\n                for hitbox in hostage.hitboxes:\n                    margin=hostage_ray_margin(age,length(sub(hitbox.origin,frame.eye)),cone_deg)\n                    interval=hitbox.intersection(frame.eye,ray,margin)\n                    if interval is not None:entries.append(interval[0])\n                if entries and blocked(hostage,min(entries)):return f\'射线经过人质 #{hostage.index}\'\n                continue\n        if hostage.bounds is None:continue\n        center=tuple((hostage.bounds[0][k]+hostage.bounds[1][k])*.5 for k in range(3))\n        margin=hostage_ray_margin(age,length(sub(center,frame.eye)),cone_deg)\n        bounds=(tuple(v-margin for v in hostage.bounds[0]),tuple(v+margin for v in hostage.bounds[1]))\n        interval=box_ray_interval(bounds,frame.eye,ray)\n        if interval is not None and blocked(hostage,interval[0]):return f\'射线经过人质 #{hostage.index}\'\n    return \'\'\n\n\n\ndef hostage_ray_clear(frame,point,weapon=None,now=None,cone_deg=0.):\n    return not hostage_ray_status(frame,point,weapon,now,cone_deg)\n\n\ndef head_point_key(eye,point,weapon,flags=1,velocity=(0.,0.,0.),*,spread_hint=False):\n    """Choose coverage within the native head group, using model-local radii.\n\n    Eye points remain preferred when their margin fits the script envelope.\n    Otherwise prefer the larger head sample; no model name or range cutoff.\n    The envelope is a configuration estimate, never a live hit probability.\n    """\n    from weapon_cadence import script_spread_hint\n    spread=script_spread_hint(weapon,flags,velocity) if spread_hint is False else spread_hint\n    angular=math.atan2(max(.01,point.radius),max(1.,math.dist(eye,point.position)))\n    if not spread or spread<=angular*.8:return (0,point.priority,-point.radius)\n    return (1,-angular,point.priority)\n\n\ndef requires_head_intent(entity):\n    """Ordinary models keep head intent; native generic rigs remain distinct."""\n    from high_threat_models import is_high_threat_model\n    return (getattr(entity,\'head_source\',\'\') not in (\'anatomical_generic\',\'server_anatomical_generic\')\n            and not is_high_threat_model(getattr(entity,\'model\',\'\')))\n\n\ndef _entity_speed(entity):\n    """Return finite world speed for the body-only stationary fallback."""\n    try:\n        value=tuple(float(v) for v in getattr(entity,\'velocity\',()) or ())\n    except (TypeError,ValueError):\n        return float(\'inf\')\n    if len(value)!=3 or not all(math.isfinite(v) for v in value):return float(\'inf\')\n    return math.sqrt(sum(v*v for v in value))\n\n\ndef select_aim_view(frame,entity,weapon,now,previous_key=\'\',allow_penetration=False,require_safe=True,*,head_only=False,allow_blocked=False):\n    from esp_targeting import point_reachable,selection_tier,public_path,state\n    points=[p for p in candidate_points(entity) if not head_only or p.part==\'head\']\n    if not head_only:points=[p for p in points if point_reachable(p,allow_blocked=allow_blocked)]\n    if not points:return None\n    # Keep anatomical head intent ahead of path class for one actor.  A\n    # penetrable head therefore remains the preferred point over a visible\n    # body fallback; the caller still ranks different actors by its current\n    # crosshair ray and player distance.\n    points.sort(key=lambda p:(p.part!=\'head\',selection_tier(p.visibility),\n        p.key!=previous_key,*head_point_key(frame.eye,p,weapon)))\n    reasons={}\n    hostages=frame.protected if protect_hostages(frame.mode) else ()\n    for p in points:\n        margin=max(.15,min(3.,float(p.radius)*.35))\n        reasons[p.key]=\'hostage_intersection\' if any(\n            _hostage_point_intersection(frame.eye,p.position,h,margin,\n                float((weapon or {}).get(\'Range\',8192.))) is not None for h in hostages) else \'\'\n        if not reasons[p.key]:break\n    else:\n        if require_safe:return None\n        p=points[0]\n    return replace(entity,head=p.position,head_radius=p.radius,aim_id=p.key,aim_part=p.part,\n        visibility=state(p.visibility),wall_text=p.wall_text,wall_age_ms=p.wall_age_ms,\n        wall_head_shift=p.wall_head_shift,wall_eye_shift=p.wall_eye_shift,\n        wall_penetrable=state(p.visibility)==\'penetrable\',penetration=public_path(p.visibility,allow_blocked=allow_blocked),\n        aim_guard_reason=reasons.get(p.key) or \'\')\n')





