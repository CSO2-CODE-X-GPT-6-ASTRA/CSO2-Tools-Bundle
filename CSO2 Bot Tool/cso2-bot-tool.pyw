_EMBEDDED['retained_canvas'] = (1, '\n\n"""Reuse canvas primitives instead of destroying the overlay on every frame."""\n\nclass RetainedCanvas:\n\n    def __init__(self,canvas):\n\n        self.canvas=canvas;self.items={};self.used={};self.pending=[]\n\n        self.batched=hasattr(canvas,\'tk\')\n\n        if self.batched:\n\n            canvas.tk.eval(\'proc ::cso2_canvas_batch {canvas ops} {foreach op $ops {$canvas {*}$op}}\')\n\n    def __getattr__(self,name):return getattr(self.canvas,name)\n\n    def delete(self,tag):\n\n        if tag==\'all\':self.used={};self.pending=[]\n\n        else:self.canvas.delete(tag)\n\n    def coords(self,ident,coords):\n\n        if self.batched:self.pending.append((\'coords\',ident,*coords))\n\n        else:self.canvas.coords(ident,*coords)\n\n    def configure_item(self,ident,options):\n\n        if self.batched:\n\n            args=[\'itemconfigure\',ident]\n\n            for k,v in options.items():args.extend((\'-\'+k,v))\n\n            self.pending.append(tuple(args))\n\n        else:self.canvas.itemconfigure(ident,**options)\n\n    def create(self,kind,coords,options):\n\n        slot=self.used.get(kind,0);self.used[kind]=slot+1;key=(kind,slot)\n\n        item=self.items.get(key)\n\n        if item is None:\n\n            ident=getattr(self.canvas,\'create_\'+kind)(*coords,**options)\n\n            self.items[key]=[ident,coords,options.copy(),True]\n\n        else:\n\n            ident,oldcoords,oldopts,shown=item\n\n            if coords!=oldcoords:self.coords(ident,coords);item[1]=coords\n\n            changed={k:v for k,v in options.items() if oldopts.get(k)!=v}\n\n            if not shown:changed[\'state\']=\'normal\';item[3]=True\n\n            if changed:self.configure_item(ident,changed);item[2]=options.copy()\n\n        return self.items[key][0]\n\n    def finish(self):\n\n        for (kind,slot),item in self.items.items():\n\n            if slot>=self.used.get(kind,0) and item[3]:\n\n                self.configure_item(item[0],{\'state\':\'hidden\'});item[3]=False\n\n        if self.pending:\n\n            self.canvas.tk.call(\'::cso2_canvas_batch\',self.canvas._w,tuple(self.pending));self.pending=[]\n\n    def create_line(self,*coords,**options):return self.create(\'line\',coords,options)\n\n    def create_text(self,*coords,**options):return self.create(\'text\',coords,options)\n\n    def create_oval(self,*coords,**options):return self.create(\'oval\',coords,options)\n\n    def create_polygon(self,*coords,**options):return self.create(\'polygon\',coords,options)\n\n    def create_rectangle(self,*coords,**options):return self.create(\'rectangle\',coords,options)\n\n')





