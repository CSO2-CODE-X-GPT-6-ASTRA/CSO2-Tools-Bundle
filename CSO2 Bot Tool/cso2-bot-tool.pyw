x:self.status=\'BOT SKIN：\'+str(ex)\n\n    def close(self):\n\n        if self.reader and self.reader.mem and self.reader.mem.alive():\n\n            for key,saved in list(self.records.items()):\n\n                self.restore(key,saved);self.records.pop(key)\n\n        self.reader=None;self.server=0;self.records.clear();self.status=\'BOT SKIN：未指定\'\n\n')





