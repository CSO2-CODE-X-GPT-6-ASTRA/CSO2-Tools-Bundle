yload):\n    import io,pickle\n    class Decoder(pickle.Unpickler):\n        def find_class(self,module,name):\n            if (module,name) in ((\'reader\',\'Frame\'),(\'reader\',\'Entity\'),(\'grenade_dodge\',\'Grenade\'),\n                                 (\'aim_points\',\'ProtectedEntity\'),(\'aim_points\',\'PoseHitbox\')):\n                return super().find_class(module,name)\n            raise ValueError(\'Invalid SERVER snapshot type\')\n    return Decoder(io.BytesIO(payload)).load()\n\n\nclass SamplePublication:\n    """A transient error must not erase an unread, still-fresh sample.\n\n    The retained payload is the already-serialized success message, not a new\n    sample. Its epoch, PID and original acquisition timestamp remain unchanged.\n    """\n    def __init__(self, mailbox, pid, clock=None):\n        self.mailbox=mailbox;self.pid=pid;self.clock=clock or time.monotonic\n        self.retained_errors=0;self.expired_publications=0;self.reset()\n\n    def reset(self):\n        self.payload=None;self.epoch=None;self.stamp=None;self.sequence=0\n\n    def success(self, epoch, packet):\n        import pickle\n        def fresh():\n            now=self.clock()\n            return all(isinstance(p.stamp,(int,float)) and math.isfinite(p.stamp)\n                and 0<=now-p.stamp<=DISPLAY_MAX_SAMPLE_AGE for p in packet[:2])\n        if not fresh():\n            self.expired_publications+=1\n            raise DisplaySampleUnavailable(\'ESP sample expired before publication\')\n        payload=pickle.dumps(dict(epoch=epoch,pid=self.pid,packet=packet),protocol=5)\n        if not fresh():\n            self.expired_publications+=1\n            raise DisplaySampleUnavailable(\'ESP sample expired during serialization\')\n        written=self.mailbox.write(payload)\n        if not written:raise DisplaySampleUnavailable(\'ESP publication mailbox busy\')\n        self.payload=payload\n        self.epoch=epoch;self.stamp=packet[0].stamp;self.sequence=packet[2][\'sequence