n        step=EntryTests.step\n\n        def test_same_view_display_signal_rebuilds_once(self):\n            self.step();old=self.old;old.surface_reset_reason=\'display_mode_changed\'\n            new=self.step(1.)\n            self.assertIsNot(new,old);self.assertEqual(self.entry.reason,\'display_mode_changed\')\n            self.assertIsNone(self.entry.first_scene_at)\n            for i in range(20):self.step(1.1+i*.01)\n            self.assertEqual(self.factory.call_count,2)\n\n        def test_reset_failure_retries_without_moving_deadline(self):\n            self.step();old=self.old;old.surface_reset_reason=\'desktop_composition_changed\'\n            self.factory.side_effect=OSError(\'fixture surface allocation\')\n            self.assertIs(self.step(1.),old)\n            for t in (1.1,1.2,1.4,1.9):\n                old.surface_reset_reason=\'desktop_composition_changed\';self.step(t)\n            self.assertEqual(self.factory.call_count,2)\n            self.assertEqual(self.entry.retry_at,2.)\n            self.step(2.);self.assertEqual(self.factory.call_count,3)\n\n        def test_disabled_defers_native_reset(self):\n            self.step();old=self.old;old.surface_reset_reason=\'display_mode_changed\'\n            self.cfg.esp=False;self.step(1.)\n            self.assertEqual(self.factory.call_count,1)\n            self.assertEqual(old.surface_reset_reason,\'display_mode_changed\')\n            self.cfg.esp=True;self.step(2.);self.assertEqual(self.factory.call_count,2)\n\n        def test_minimized_defers_native_reset(self):\n            self.step();old=self.old;old.surface_reset_reason=\'system_resumed\'\n            self.view[\'rect\']=None;self.step(1.)\n            self.assertEqual(self.factory.call_count,1)\n            self.view[\'rect\']=(0,0,1280,720);self.step(2.)\n            self.assertEqual(self.factory.call_count,2)\n\n        def test_native_signal_allowlist_excludes_normal_window_messages(self):\n            from esp_window_entry import surface_reset_message\n            for message in (0x000f,0x0047,0x0084,0x0021,0x0005):\n                self.assertEqual(surface_reset_message(message),\'\')\n            self.assertEqual(surface_reset_message(0x218,4),\'\')\n            self.assertEqual(surface_reset_message(0x218,18),\'system_resumed\')\n            self.assertEqual(surface_reset_message(0x31e),\'desktop_composition_changed\')\n\n        def test_real_hidden_hwnd_receives_display_notification(self):\n            import ctypes\n            from ctypes import wintypes as W\n            from native_overlay import NativeOverlay\n            overlay=NativeOverlay(visible=False,submit_hidden=True)\n            try:\n                post=overlay.u.PostMessageW\n                post.argtypes=[W.HWND,W.UINT,W.WPARAM,W.LPARAM];post.restype=W.BOOL\n                self.assertTrue(post(overlay.hwnd,0x7e,32,(720<<16)|1280))\n                overlay.pump()\n                self.assertEqual(overlay.surface_reset_reason,\'display_mode_changed\')\n                self.assertFalse(overlay.u.IsWindowVisible(overlay.hwnd))\n            finally:overlay.close()\n\n        def test_expired_source_is_not_reported_as_first_sample(self):\n            from esp_sources import source_wait_reason\n            result=source_wait_reason({\'server\':{\'sample_age_ms\':150.,\'error\':\'\'},\n                \'client\':{\'sample_age_ms\':130.,\'error\':\'\'}}, {\'server\':\'expired\',\'client\':\'expired\'})\n            self.assertIn(\'server: expired\',result);self.assertIn(\'client: expired\',result)\n            self.assertNotIn(\'first sample\',result)\n\n        def test_source_error_labels_do_not_change_with_sample_age(self):\n            from esp_sources import source_wait_reason\n            a=source_wait_reason({\'client\':{\'sample_age_ms\':130.}}, {\'client\':\'expired\'})\n            b=source_wait_reason({\'client\':{\'sample_age_ms\':131.}}, {\'client\':\'expired\'})\n            self.assertEqual(a,b)\n\n        def test_short_clears_are_journalled_without_a_restart(self):\n            with tempfile.TemporaryDirectory() as root:\n                j=WatchdogJournal(root,123)\n                m=report(sequence=20,display_continuity=dict(expired_bitmap_clears=0))\n                j.write(dict(state=\'progressing\',restarts=0,renderer=m))\n                m[\'display_continuity\'][\'expired_bitmap_clears\']=3;j.next_at=0.\n                j.write(dict(state=\'progressing\',restarts=0,renderer=m))\n                rows=[json.loads(x) for x in (Path(root)/\'esp_recovery_123.jsonl\').read_text(\'utf-8\').splitlines()]\n                self.assertEqual(len(rows),2)\n                self.assertEqual(rows[-1][\'continuity\'][\'expired_bitmap_clears\'],3)\n                self.assertEqual(rows[-1][\'supervisor\'][\'restarts\'],0)\n                self.assertFalse(rows[-1][\'live_pixels_verified\'])\n\n        def test_recovery_journal_keeps_fault_then_recovery(self):\n            with tempfile.TemporaryDirectory() as root:\n                j=WatchdogJournal(root,123)\n                j.write(dict(renderer=report(\'recovering\',reason=\'client: expired\')))\n                j.next_at=0.;j.write(dict(renderer=report(sequence=2)))\n                rows=[json.loads(x) for x in (Path(root)/\'esp_recovery_123.jsonl\').read_text(\'utf-8\').splitlines()]\n                self.assertEqual([r[\'state\'] for r in rows],[\'recovering\',\'rendering\'])\n\n        def test_recovery_journal_is_bounded(self):\n            with tempfile.TemporaryDirectory() as root:\n                p=Path(root)/\'esp_recovery_123.jsonl\';p.write_text(\'x\'*(4*1024*1024+1))\n                j=WatchdogJournal(root,123);j.write(dict(renderer=report()))\n                self.assertEqual(j.error,\'\')\n                self.assertTrue(p.with_name(\'esp_recovery_123.previous.jsonl\').exists())\n                self.assertLess(p.stat().st_size,8000)\n\n        def test_journal_retains_rejection_evidence_not_entities(self):\n            with tempfile.TemporaryDirectory() as root:\n                j=WatchdogJournal(root,123)\n                m=report(\'recovering\',sampling_health=dict(phase=dict(stage=\'error\',\n                    sources=dict(rejected=dict(client=\'expired\')))),scene=dict(entities=2,actor_layers=[\'sentinel\']))\n                j.write(dict(renderer=m))\n                r=json.loads((Path(root)/\'esp_recovery_123.jsonl\').read_text(\'utf-8\'))\n                self.assertEqual(r[\'sample_phase\'][\'sources\'][\'rejected\'][\'client\'],\'expired\')\n                self.assertNotIn(\'sentinel\',json.dumps(r))\n\n    suite=unittest.TestSuite(unittest.defaultTestLoader.loadTestsFromTestCase(c) for c in\n        (PolicyTests,ServiceTests,EvidenceTests,ProcessTests,EntryTests,StartupTransitionTests,RepeatRecoveryTests))\n    output=io.StringIO()\n    result=unittest.TextTestRunner(stream=output,verbosity=2).run(suite)\n    if not result.wasSuccessful():raise AssertionError(output.getvalue())\n    from esp_recovery_contract import run as check_recovery_latency\n    latency=check_recovery_latency()\n    return dict(passed=True,tests=result.testsRun+latency[\'tests\'],recovery_latency=latency,game_attached=False,game_input=False,\n        gpu_required=False,live_game_verified=False,real_owned_child_recovery=True,\n        independent_control_loop=True)\n')

_EMBEDDED['esp_window_entry'] = (1, '"""Immediate, renderer-owned surface renewal when entering the game view."""\nimport time\n\n\ndef surface_reset_message(message, wparam=0):\n    """Native display notifications are not focus/viewport-size changes."""\n    if message == 0x007e: return \'display_mode_changed\'  # WM_DISPLAYCHANGE\n    if message == 0x031e: return \'desktop_composition_changed\'\n    if message == 0x0218 and wparam in (7, 18): return \'system_resumed\'\n    return \'\'\n\n\nclass WindowEntry:\n    def __init__(self):\n        self.ready=False;self.focus=False;self.key=None\n        self.epoch=0;self.reason=\'\';self.requested_at=0.\n        self.pending=False;self.retry_at=0.;self.rebuilds=0;self.failures=0\n        self.first_scene_at=None;self.frames=0;self.error=\'\'\n        self.old_hwnd=None;self.new_hwnd=None\n        self.surface_ready_at=None;self.surface_build_ms=None\n        self.retiring=None\n\n    def invalidate(self,reason,now=None):\n        """Repair a lost surface without closing either sampling source."""\n        if self.pending:return\n        now=time.monotonic() if now is None else now\n        self.epoch+=1;self.reason=reason;self.requested_at=now\n        self.pending=True;self.retry_at=0.;self.first_scene_at=None;self.frames=0\n        self.surface_ready_at=None\n\n    def prepare(self,view,cfg,overlay,factory,now=None):\n        now=time.monotonic() if now is None else now\n        rect=view.get(\'rect\');focus=bool(view.get(\'foreground\',True))\n        if not rect or not cfg.esp:\n            self.ready=False;self.focus=focus\n            return overlay\n        # Consume a native reset once. Failed creation retains the existing\n        # pending request/retry deadline rather than resetting it every frame.\n        signal=getattr(overlay,\'surface_reset_reason\',\'\')\n        if signal:overlay.surface_reset_reason=\'\'\n        key=(view.get(\'game_window\'),rect[2],rect[3])\n        reason=(\'game_view_entered\' if not self.ready else\n                \'game_window_or_size_changed\' if key!=self.key else\n                \'game_focus_returned\' if focus and not self.focus else \'\')\n        self.ready=True;self.focus=focus;self.key=key\n        if reason:\n            # A new focus/size notification may replace the reason, but must\n            # not reset an existing allocation failure\'s retry deadline.\n            was_pending=self.pending\n            self.invalidate(reason,now)\n            if was_pending:self.reason=reason\n            else:self.surface_build_ms=None\n        elif signal:\n            self.invalidate(signal,now)\n        if not self.pending or now<self.retry_at:return overlay\n        candidate=None;build_started=time.monotonic()\n        try:\n            # Renew only the HWND/GDI back buffer, not the sampler, its process,\n            # reader or the input system. A visible stale HWND is not reused.\n            candidate=factory()\n            candidate.resize(rect);candidate.set_antialias(cfg.esp_antialias)\n            candidate.bind_game_window(view.get(\'game_window\'),foreground=focus)\n        except Exception as ex:\n            if candidate is not None:\n                try:candidate.close()\n                except Exception:pass\n            self.failures+=1;self.error=type(ex).__name__+\': \'+str(ex)\n            self.retry_at=now+1.\n            return overlay\n        self.old_hwnd=getattr(overlay,\'hwnd\',None)\n        self.new_hwnd=getattr(candidate,\'hwnd\',None)\n        # Keep the committed front surface until the replacement has really\n        # submitted a scene. Sampling/camera gaps must not expose a blank HWND.\n        if self.retiring is None:self.retiring=overlay\n        elif overlay is not self.retiring:\n            try:overlay.close()\n            except Exception:pass\n        self.error=\'\'\n        self.pending=False;self.rebuilds+=1\n        elapsed=time.monotonic()-build_started\n        self.surface_build_ms=round(elapsed*1000,3);self.surface_ready_at=now+elapsed\n        return candidate\n\n    def presented(self,now=None):\n        if self.pending or not self.ready:return\n        now=time.monotonic() if now is None else now\n        self.frames+=1\n        if self.first_scene_at is None:self.first_scene_at=now\n        if self.retiring is not None:\n            try:self.retiring.close()\n            except Exception as ex:self.error=\'previous_surface_close: \'+str(ex)\n            self.retiring=None\n\n    def close(self):\n        if self.retiring is not None:\n            try:self.retiring.close()\n            finally:self.retiring=None\n\n    def snapshot(self):\n        return dict(epoch=self.epoch,reason=self.reason,requested_at=self.requested_at,\n            pending=self.pending,first_scene_at=self.first_scene_at,frames=self.frames,\n            rebuilds=self.rebuilds,failures=self.failures,error=self.error,\n            previous_hwnd=self.old_hwnd,hwnd=self.new_hwnd,\n            surface_build_ms=self.surface_build_ms,surface_ready_at=self.surface_ready_at,\n            first_scene_delay_ms=(round(max(0.,self.first_scene_at-self.requested_at)*1000,3)\n                                  if self.first_scene_at is not None else None),\n            sampler_restarted=False,live_pixels_verified=False,\n            previous_surface_retained=self.retiring is not None)\n\n\ndef bitmap_evidence(overlay,scene):\n    """Inspect the submitted buffer, not just API success or draw counters."""\n    raw=overlay.image_bytes()\n    pixels=overlay.width*overlay.height\n    alpha=bool(getattr(overlay,\'per_pixel_alpha\',False))\n    if len(raw)!=pixels*4:raise ValueError(\'bitmap byte count does not match viewport\')\n    if alpha:\n        opaque=pixels-raw[3::4].count(0)\n    else:\n        # Color-key mode: RGB 01/01/01 is transparent, alpha is ignored.\n        normalized=bytearray(raw)\n        normalized[3::4]=bytes(pixels)\n        opaque=pixels-normalized.count(b\'\\1\\1\\1\\0\')\n    expected=sum(scene.get(k,0) for k in (\'position_markers\',\'skeletons\',\'edge_skeletons\',\n        \'arrows\',\'distance_labels\',\'grenades\',\'hostage_warnings\'))\n    return dict(nontransparent_pixels=opaque,expected_primitives=expected,\n        dimensions=[overlay.width,overlay.height],alpha=alpha,\n        evidence=\'renderer_bitmap_not_desktop_composition\',live_pixels_verified=False)\n')

_EMBEDDED['esp_recovery_contract'] = (1, '"""Display recovery latency gates; no game attachment or synthetic input."""\nimport io\nimport time\nimport unittest\nfrom pathlib import Path\nfrom types import SimpleNamespace as NS\nfrom unittest.mock import Mock, patch\n\n\ndef run(raise_on_failure=True):\n    import reader as client\n    import server_esp as server\n    import esp_shared as shared\n    from esp_window_entry import WindowEntry, bitmap_evidence\n\n    mods={\'client.dll\':(0x10000000,100,Path(\'fixture/Bin/client.dll\')),\n          \'engine.dll\':(0x20000000,100,Path(\'fixture/Bin/engine.dll\'))}\n\n    class AttachTests(unittest.TestCase):\n        def test_pinned_client_skips_global_discovery_but_keeps_validation(self):\n            r=client.Reader(\'fixture\');r.module_provider=Mock(return_value=mods)\n            mem=NS(pid=42,close=Mock())\n            with patch.object(client,\'game_pids\',side_effect=AssertionError(\'global scan\')), \\\n                 patch.object(client,\'discover_game_modules\',side_effect=AssertionError(\'global scan\')), \\\n                 patch.object(client,\'WinMemory\',return_value=mem), \\\n                 patch.object(r,\'resolve_addresses\') as resolve,patch.object(r,\'verify_structures\') as verify:\n                r.attach(pid=42)\n                r.module_provider.assert_called_once_with(42)\n                resolve.assert_called_once();verify.assert_called_once()\n                self.assertEqual(r.compatibility[\'discovery\'][\'mode\'],\'pinned_pid\')\n                self.assertIn(\'total_ms\',r.attach_timing)\n                r.close()\n\n        def test_pinned_server_keeps_engine_validation(self):\n            r=server.ServerDisplayReader(\'fixture\');r.module_provider=Mock(return_value=mods)\n            with patch.object(server,\'game_pids\',side_effect=AssertionError(\'global scan\')), \\\n                 patch.object(server,\'discover_game_modules\',side_effect=AssertionError(\'global scan\')), \\\n                 patch.object(server,\'WinMemory\',return_value=NS(pid=42,close=Mock())), \\\n                 patch.object(server,\'resolve_module\',return_value=({},{})) as validate:\n                r.attach(pid=42);validate.assert_called_once()\n                r.module_provider.assert_called_once_with(42);r.close()\n\n        def test_missing_pinned_modules_never_attach_another_game(self):\n            for cls,mod in [(client.Reader,client),(server.ServerDisplayReader,server)]:\n                r=cls(\'fixture\');r.module_provider=Mock(return_value={})\n                with patch.object(mod,\'game_pids\') as scan,patch.object(mod,\'WinMemory\') as memory:\n                    with self.assertRaises(client.NotReady):r.attach(pid=42)\n                    scan.assert_not_called();memory.assert_not_called()\n\n        def test_inaccessible_pinned_process_has_no_eight_second_scan(self):\n            for cls,mod in [(client.Reader,client),(server.ServerDisplayReader,server)]:\n                r=cls(\'fixture\');r.module_provider=Mock(side_effect=OSError(\'fixture access\'))\n                with patch.object(mod,\'discover_game_modules\') as scan:\n                    with self.assertRaises(OSError):r.attach(pid=42)\n                    scan.assert_not_called()\n\n        def test_invalid_pinned_pid_rejected(self):\n            for pid in (0,-1,True,\'42\'):\n                r=client.Reader(\'fixture\');r.module_provider=Mock()\n                with self.assertRaises(client.NotReady):r.attach(pid=pid)\n                r.module_provider.assert_not_called()\n\n        def test_failed_structure_validation_closes_handle(self):\n            r=client.Reader(\'fixture\');r.module_provider=Mock(return_value=mods)\n            mem=NS(pid=42,close=Mock())\n            with patch.object(client,\'WinMemory\',return_value=mem), \\\n                 patch.object(r,\'resolve_addresses\'), \\\n                 patch.object(r,\'verify_structures\',side_effect=client.NotReady(\'invalid structure\')):\n                with self.assertRaises(client.NotReady):r.attach(pid=42)\n                self.assertIsNone(r.mem);mem.close.assert_called_once()\n\n        def test_unspecified_pid_preserves_normal_discovery(self):\n            r=client.Reader(\'fixture\');r.module_provider=Mock(return_value=mods)\n            with patch.object(client,\'game_pids\',return_value=[42]) as scan, \\\n                 patch.object(client,\'WinMemory\',return_value=NS(pid=42,close=Mock())), \\\n                 patch.object(r,\'resolve_addresses\'),patch.object(r,\'verify_structures\'):\n                r.attach();scan.assert_called_once();self.assertEqual(r.mem.pid,42);r.close()\n\n        def test_adaptive_recovery_pins_current_process(self):\n            r=shared.AdaptiveDisplayReader.__new__(shared.AdaptiveDisplayReader)\n            r.display_pid=42;r.client_reader=NS(mem=NS(pid=42))\n            r.attach=Mock();r.recover_display();r.attach.assert_called_once_with(pid=42)\n\n    class RetryTests(unittest.TestCase):\n        def test_source_single_fault_retries_at_25ms_not_250ms(self):\n            import threading\n            import esp_sources\n            scope=(42,6,\'fixture/map\',1)\n            class FakeReader:\n                mem=NS(pid=42,alive=lambda:True)\n                entity_stats={};sample_ms=1.;calls=0\n                def attach(self,pid=None):self.pid=pid\n                def close(self):pass\n                def frame(self):\n                    self.calls+=1\n                    if self.calls==1:raise client.NotReady(\'fixture read gap\')\n                    return NS(map_name=\'fixture/map\',local=NS(index=1))\n            with patch.object(threading.Thread,\'start\'):\n                lane=esp_sources.DisplaySourceLane(\'fixture\',\'client\',42,factory=FakeReader)\n            delays=[]\n            class Wake:\n                def wait(self,delay):\n                    delays.append(delay)\n                    if len(delays)>=2:lane.stop.set()\n                def set(self):pass\n                def clear(self):pass\n            lane.wake=Wake();lane.configure(scope,(),{});lane._run()\n            self.assertEqual(lane.successes,1)\n            self.assertAlmostEqual(delays[0],.025)\n\n        def test_first_retry_at_quarter_second_not_two_seconds(self):\n            clock=[0.];r=shared.DisplayRetry(clock=lambda:clock[0])\n            self.assertFalse(r.failed(\'lost\'))\n            clock[0]=.249;self.assertFalse(r.failed(\'lost\'))\n            clock[0]=.25;self.assertTrue(r.failed(\'lost\'))\n\n        def test_repeated_failure_is_bounded_without_exhaustion(self):\n            clock=[0.];r=shared.DisplayRetry(clock=lambda:clock[0]);r.failed(\'lost\')\n            for i in range(100):\n                clock[0]=max(.25,r.next_at)\n                self.assertTrue(r.failed(\'lost\'))\n                self.assertGreaterEqual(r.next_at-clock[0],.25)\n                self.assertLessEqual(r.next_at-clock[0],2.)\n                self.assertFalse(r.failed(\'lost\'))\n            self.assertEqual(r.attempts,100)\n\n        def test_new_incident_does_not_inherit_old_backoff(self):\n            clock=[0.];r=shared.DisplayRetry(clock=lambda:clock[0]);r.failed(\'lost\')\n            for t in (.25,.5,1.,2.,4.):\n                clock[0]=t;r.failed(\'lost\')\n            r.succeeded();clock[0]=10.;r.failed(\'new\')\n            clock[0]=10.25;self.assertTrue(r.failed(\'new\'))\n            self.assertLessEqual(r.next_at-clock[0],.25)\n\n    class SamplerTests(unittest.TestCase):\n        def make(self):\n            s=server.ServerSampleProcess.__new__(server.ServerSampleProcess)\n            s.reader=NS(mem=NS(pid=42));s.latest=None;s.epoch=3\n            s.desired={\'epoch\':3,\'cfg\':{\'esp\':True}};s.sent=None;s._flush=Mock()\n            s.replies=NS(read_latest=lambda:None);s.proc=NS(poll=lambda:None,returncode=0)\n            s.last_start=0.;s.last_reply=0.;s.received_reply=True;s.active_since=0.\n            s.hard_error=\'\';s.error=\'\';s.close=Mock()\n            return s\n\n        def restart(self,s,now):\n            def init(instance,reader):\n                instance.reader=reader;instance.epoch=0;instance.last_start=now\n                instance.last_reply=now;instance.received_reply=False\n                instance.desired=None\n            with patch.object(server.time,\'monotonic\',return_value=now), \\\n                 patch.object(server.ServerSampleProcess,\'__init__\',init):\n                with self.assertRaises(client.NotReady):s.take()\n\n        def test_warm_silent_sampler_restarts_after_one_and_half_seconds(self):\n            s=self.make();self.restart(s,1.501)\n            s.close.assert_called_once();self.assertEqual(s.epoch,4)\n            self.assertEqual(s.desired[\'cfg\'],{\'esp\':True})\n            self.assertEqual(s.desired[\'epoch\'],4)\n\n        def test_short_warm_gap_does_not_restart(self):\n            s=self.make();self.restart(s,1.49);s.close.assert_not_called()\n\n        def test_cold_start_retains_thirty_second_window(self):\n            s=self.make();s.received_reply=False\n            self.restart(s,29.9);s.close.assert_not_called()\n            self.restart(s,30.1);s.close.assert_called_once()\n\n        def test_pause_never_counts_as_silence(self):\n            s=self.make();s.desired={\'epoch\':3,\'cfg\':None}\n            self.restart(s,100.);s.close.assert_not_called()\n\n        def test_resume_gets_fresh_deadline_without_faking_reply(self):\n            s=self.make();s.desired={\'epoch\':3,\'cfg\':None}\n            with patch.object(server.time,\'monotonic\',return_value=100.):\n                s.configure(NS(esp=True))\n            self.assertEqual(s.last_reply,0.)\n            self.restart(s,100.1);s.close.assert_not_called()\n            self.restart(s,101.501);s.close.assert_called_once()\n\n        def test_repeated_config_updates_never_extend_deadline(self):\n            s=self.make()\n            with patch.object(server.time,\'monotonic\',return_value=1.):\n                for _ in range(100):s.configure(NS(esp=True))\n            self.restart(s,1.501);s.close.assert_called_once()\n\n        def test_exited_sampler_does_not_wait_two_seconds(self):\n            s=self.make();s.proc.poll=lambda:1\n            self.restart(s,.251);s.close.assert_called_once()\n\n        def test_stale_samples_stay_stale(self):\n            s=self.make();f=NS(stamp=0.);s.latest=(f,f,dict(sequence=1))\n            with patch.object(server.time,\'monotonic\',return_value=.121):\n                with self.assertRaises(server.DisplaySampleUnavailable):s.take()\n            self.assertEqual(f.stamp,0.);s.close.assert_not_called()\n\n    class SurfaceTests(unittest.TestCase):\n        def make(self):\n            g=WindowEntry();cfg=NS(esp=True,esp_antialias=True)\n            view=dict(rect=(0,0,128,96),game_window=11,foreground=True)\n            def surface():return NS(hwnd=22,resize=Mock(),set_antialias=Mock(),\n                                    bind_game_window=Mock(),close=Mock())\n            factory=Mock(side_effect=surface);old=surface()\n            new=g.prepare(view,cfg,old,factory,0.);g.presented(.01)\n            return g,cfg,view,new,factory\n\n        def test_lost_window_rebuilds_without_focus_or_map_transition(self):\n            g,cfg,view,old,factory=self.make()\n            g.invalidate(\'surface_window_lost\',1.)\n            new=g.prepare(view,cfg,old,factory,1.)\n            self.assertIsNot(new,old);old.close.assert_not_called()\n            self.assertEqual(g.reason,\'surface_window_lost\')\n            self.assertIsNone(g.first_scene_at);g.presented(1.01);old.close.assert_called_once()\n            self.assertEqual(g.snapshot()[\'first_scene_delay_ms\'],10.)\n            self.assertFalse(g.snapshot()[\'sampler_restarted\'])\n\n        def test_repeated_invalidations_respect_failed_allocation_backoff(self):\n            g,cfg,view,old,factory=self.make()\n            factory.side_effect=OSError(\'fixture allocation\')\n            g.invalidate(\'surface_window_lost\',1.)\n            self.assertIs(g.prepare(view,cfg,old,factory,1.),old)\n            for i in range(100):\n                g.invalidate(\'surface_window_lost\',1.1)\n                self.assertIs(g.prepare(view,cfg,old,factory,1.1),old)\n            self.assertEqual(factory.call_count,2);old.close.assert_not_called()\n\n        def test_disabled_esp_stays_disabled_during_repair(self):\n            g,cfg,view,old,factory=self.make();cfg.esp=False\n            g.invalidate(\'surface_window_lost\',1.)\n            self.assertIs(g.prepare(view,cfg,old,factory,1.),old)\n            self.assertEqual(factory.call_count,1)\n\n        def test_real_native_surface_recovery_draws_pixels(self):\n            from native_aa_overlay import SmoothOverlay\n            cfg=NS(esp=True,esp_antialias=True)\n            view=dict(rect=(0,0,128,96),game_window=None,foreground=True)\n            factory=lambda:SmoothOverlay(visible=False,submit_hidden=True)\n            g=WindowEntry();old=factory();current=None\n            try:\n                current=g.prepare(view,cfg,old,factory)\n                g.presented();current.close()\n                g.invalidate(\'surface_window_lost\')\n                current=g.prepare(view,cfg,current,factory)\n                current.delete(\'all\');current.create_line(8,8,96,80,fill=\'#55e28c\',width=2)\n                current.finish();g.presented()\n                self.assertGreater(bitmap_evidence(current,dict(skeletons=1))[\'nontransparent_pixels\'],0)\n                self.assertIsNotNone(g.snapshot()[\'first_scene_delay_ms\'])\n            finally:\n                if current:current.close()\n                old.close()\n\n    suite=unittest.TestSuite(unittest.defaultTestLoader.loadTestsFromTestCase(c)\n        for c in (AttachTests,RetryTests,SamplerTests,SurfaceTests))\n    output=io.StringIO();result=unittest.TextTestRunner(stream=output,verbosity=2).run(suite)\n    summary=dict(passed=result.wasSuccessful(),tests=result.testsRun,\n        failures=len(result.failures),errors=len(result.errors),game_attached=False,\n        game_input=False,gpu_required=False,live_game_verified=False)\n    if not result.wasSuccessful():\n        summary[\'details\']=output.getvalue()\n        if raise_on_failure:raise AssertionError(output.getvalue())\n    return summary\n')

_EMBEDDED['aim_motion_contract'] = (1, '"""Observed-pose tracking fixtures; geometry tests are not bullet hit rates."""\nimport copy\nimport io\nimport math\nimport unittest\nfrom dataclasses import replace\nfrom unittest.mock import patch\n\n\nSCENARIOS=(\'stationary\',\'walk\',\'run\',\'stairs_up\',\'stairs_down\',\'jump\',\'crouch\',\'reverse\')\n\n\ndef pose(scenario,t,distance=512.,scale=1.,part=\'head\'):\n    speed=80. if scenario==\'walk\' else 250.\n    height=64. if part==\'head\' else 40.\n    y=0.;z=0.;velocity=(0.,0.,0.)\n    if scenario in (\'walk\',\'run\'):\n        y=speed*t;velocity=(0.,speed,0.)\n    elif scenario in (\'stairs_up\',\'stairs_down\'):\n        sign=1. if scenario==\'stairs_up\' else -1.\n        y=100.*t;z=sign*16.*math.floor(t/.10)\n        # Stair solver moves the origin even when reported vertical speed is 0.\n        velocity=(0.,100.,0.)\n    elif scenario==\'jump\':\n        phase=t%1.;y=120.*t;z=240.*phase-240.*phase*phase\n        velocity=(0.,120.,240.-480.*phase)\n    elif scenario==\'crouch\':\n        z=-28.*min(1.,max(0.,(t-.18)/.04)) if t<.52 else -28.*max(0.,1.-(t-.52)/.04)\n    elif scenario==\'reverse\':\n        y=250.*t if t<.25 else 125.-250.*t\n        velocity=(0.,250. if t<.25 else -250.,0.)\n    return (distance,y,(height+z)*scale),velocity\n\n\ndef fixture(part=\'torso\'):\n    from esp_skeleton_rules import fixture as display_fixture\n    f=display_fixture(count=1);t=f.entities[0]\n    f.eye=(0.,0.,64.);f.angles=(0.,0.,0.);f.punch=(0.,0.,0.)\n    f.stamp=10.;f.local.velocity=(0.,0.,0.);f.weapon=\'CWeaponXT97\';f.shots=0\n    t.head=(512.,0.,64.);t.aim_part=part;t.aim_id=part+\'_center\'\n    t.head_radius=3. if part==\'head\' else 7.\n    t.pose_sample_stamp=10.;t.velocity=(0.,0.,0.)\n    return f,t\n\n\ndef run(raise_on_failure=True):\n    import aim_tracking,experimental_aim\n    from geometry import aim_angles,angle_error\n    original=aim_tracking.AimTracker.update\n\n    class Tests(unittest.TestCase):\n        def tracker(self):\n            experimental_aim.install_recoil_policy(aim_tracking)\n            return aim_tracking.AimTracker()\n\n        def test_stationary_player_running_bot_removes_body_lag(self):\n            f,t=fixture();t.head=(512.,64.,40.);t.velocity=(0.,250.,0.)\n            out=self.tracker().update(f,t,4.,1.)\n            self.assertLess(out[\'output_error_deg\'],1e-8)\n            self.assertTrue(out[\'experimental_recoil\'][\'movement_aim\'][\'forced\'])\n\n        def test_zero_velocity_crouch_tracks_observed_pose(self):\n            f,t=fixture();tracker=self.tracker();tracker.update(f,t,4.,1.)\n            f.angles=tracker.previous[\'out\'];f.stamp+=.008;t.pose_sample_stamp=f.stamp\n            t.head=(512.,0.,40.)\n            out=tracker.update(f,t,4.,1.)\n            self.assertLess(out[\'output_error_deg\'],1e-8)\n            self.assertIn(\'observed_pose_change\',out[\'motion_response\'][\'reasons\'])\n\n        def test_same_frame_fresh_pose_has_new_tracking_time(self):\n            f,t=fixture();tracker=self.tracker();tracker.update(f,t,4.,1.)\n            f.angles=tracker.previous[\'out\'];t.pose_sample_stamp+=.008;t.head=(512.,8.,64.)\n            out=tracker.update(f,t,4.,1.)\n            self.assertAlmostEqual(out[\'dt_ms\'],8.)\n            self.assertEqual(out[\'tracking_stamp_basis\'],\'entity_pose\')\n            self.assertLess(out[\'output_error_deg\'],1e-8)\n\n        def test_static_body_retains_requested_smoothing(self):\n            f,t=fixture();t.head=(512.,100.,64.)\n            out=self.tracker().update(f,t,4.,1.)\n            self.assertFalse(out[\'motion_response\'][\'forced\'])\n            self.assertEqual(out[\'motion_response\'][\'applied_smoothing\'],4.)\n            self.assertGreater(out[\'output_error_deg\'],1.)\n\n        def test_identity_change_does_not_reuse_previous_pose_motion(self):\n            f,t=fixture();tracker=self.tracker();tracker.update(f,t,4.,1.)\n            f.stamp+=.008;t.pose_sample_stamp=f.stamp;t.serial+=1;t.head=(512.,30.,64.)\n            out=tracker.update(f,t,4.,1.)\n            self.assertFalse(out[\'motion_response\'][\'forced\'])\n            self.assertFalse(out[\'motion_compensated\'])\n\n        def test_part_change_does_not_reuse_previous_pose_motion(self):\n            f,t=fixture();tracker=self.tracker();tracker.update(f,t,4.,1.)\n            f.stamp+=.008;t.pose_sample_stamp=f.stamp;t.aim_id=\'pelvis_center\';t.aim_part=\'pelvis\'\n            t.head=(512.,0.,32.)\n            out=tracker.update(f,t,4.,1.)\n            self.assertFalse(out[\'motion_response\'][\'forced\'])\n\n        def test_bad_velocity_and_pose_clock_do_not_create_nonfinite_angles(self):\n            f,t=fixture();t.velocity=(math.nan,0.,0.);t.pose_sample_stamp=math.nan\n            out=self.tracker().update(f,t,4.,1.)\n            self.assertTrue(all(math.isfinite(v) for v in out[\'out\']))\n            self.assertEqual(out[\'tracking_stamp_basis\'],\'frame\')\n\n        def test_no_target_extrapolation_or_frame_mutation(self):\n            f,t=fixture();t.velocity=(0.,900.,0.)\n            before=copy.deepcopy((f,t))\n            out=self.tracker().update(f,t,4.,1.)\n            self.assertEqual(t.head,before[1].head);self.assertEqual(f.eye,before[0].eye)\n            self.assertEqual(out[\'raw\'],aim_angles(f.eye,t.head))\n            self.assertFalse(out[\'motion_response\'][\'extrapolated\'])\n\n        def test_camera_guard_preserved(self):\n            f,t=fixture();f.angles=(0.,-170.,0.);t.velocity=(0.,250.,0.)\n            out=self.tracker().update(f,t,4.,1.)\n            self.assertLessEqual(abs(out[\'camera_step_deg\'][0]),28.)\n            self.assertLessEqual(abs(out[\'camera_step_deg\'][1]),55.)\n\n        def test_requested_postures_head_and_body_across_rates_and_scales(self):\n            checked=0\n            for scenario in SCENARIOS:\n                for part in (\'head\',\'torso\'):\n                    for hz in (60.,120.,240.):\n                        for scale in (.5,1.,3.):\n                            f,t=fixture(part);tracker=self.tracker()\n                            for i in range(72):\n                                time=i/hz;t.head,t.velocity=pose(scenario,time,512.,scale,part)\n                                f.stamp=10.+time;t.pose_sample_stamp=f.stamp\n                                if i==0:f.angles=aim_angles(f.eye,t.head)\n                                out=tracker.update(f,t,1. if part==\'head\' else 4.,1.)\n                                self.assertLess(out[\'output_error_deg\'],1e-7,(scenario,part,hz,scale,i))\n                                f.angles=out[\'out\'];checked+=1\n            self.assertEqual(checked,10368)\n\n        def test_running_motion_preserves_all_weapon_recoil_profiles(self):\n            checked=0\n            for weapon in experimental_aim.WEAPON_PROFILES:\n                for part in (\'head\',\'torso\'):\n                    for hz in (60.,120.,240.):\n                        f,t=fixture(part);tracker=self.tracker();f.weapon=\'CWeapon\'+weapon\n                        for i in range(72):\n                            elapsed=i/hz\n                            f.stamp=10.+elapsed;t.pose_sample_stamp=f.stamp\n                            t.head,t.velocity=pose(\'run\',elapsed,512.,1.,part)\n                            f.punch=(-1.*math.sin(elapsed),.2*math.cos(elapsed),0.)\n                            f.shots=i%8\n                            out=tracker.update(f,t,1. if part==\'head\' else 4.,1.)\n                            self.assertLess(out[\'output_error_deg\'],1e-8,(weapon,part,hz,i))\n                            f.angles=out[\'out\'];checked+=1\n            self.assertEqual(checked,5616)\n\n    output=io.StringIO()\n    with patch.object(aim_tracking.AimTracker,\'update\',original):\n        result=unittest.TextTestRunner(stream=output,verbosity=2).run(\n            unittest.defaultTestLoader.loadTestsFromTestCase(Tests))\n    summary=dict(passed=result.wasSuccessful(),tests=result.testsRun,\n        pose_geometry_cases=10368,moving_recoil_cases=5616,\n        failures=len(result.failures),errors=len(result.errors),\n        scenarios=list(SCENARIOS),game_attached=False,game_input=False,\n        gpu_required=False,bullet_accuracy_verified=False)\n    if not result.wasSuccessful():\n        summary[\'details\']=output.getvalue()\n        if raise_on_failure:raise AssertionError(output.getvalue())\n    return summary\n')

_EMBEDDED['static_bbox_contract'] = (1, '"""Regression gate for rotated SOLID_BBOX guards; stdlib, no game or GPU."""\nimport copy\nimport io\nimport unittest\nfrom unittest.mock import patch\n\n# Recorded endpoints, not invented targets. The fifth path still intersects\n# the corrected box and must stay blocked.\nITALY_RAYS=(\n    ((-329.09637451171875,2062.67138671875,-94.96869659423828),\n     (-686.4640882694505,2113.8617155882635,-91.11677326366674),True),\n    ((-512.4398193359375,2171.52197265625,-94.96869659423828),\n     (-828.653585696177,2047.9450449204658,-106.71474478268182),False),\n    ((-371.6697998046875,2159.16455078125,-94.96869659423828),\n     (-909.7439779635374,2079.1617855967397,-88.00923125845388),True),\n)\n\n\ndef run():\n    import static_guard_data as data\n    from static_prop_guard import StaticPropGuard,apply_bbox_corrections,apply_fire_guard\n    from ballistics import fire_path_allowed\n    key=\'cs_italy\'\n    correction=data.BBOX_CORRECTIONS[key]\n    items=correction[\'instances\']\n    meta=dict(sha256=correction[\'source_guard_sha256\'],bsp_sha256=correction[\'bsp_sha256\'])\n\n    def original_rows():\n        return [[r[\'id\'],r[\'model\'],copy.deepcopy(r[\'old_bounds\'])] for r in items]\n\n    def fixed_guard():\n        rows,ids=apply_bbox_corrections(original_rows(),meta,key)\n        return StaticPropGuard(rows,{},bbox_instances=ids)\n\n    class BoundsTests(unittest.TestCase):\n        def test_logged_empty_space_is_not_a_winerack(self):\n            old=StaticPropGuard(original_rows(),{})\n            new=fixed_guard()\n            for start,end,expected in ITALY_RAYS:\n                with self.subTest(start=start):\n                    self.assertFalse(old.check(start,end)[\'allowed\'])\n                    self.assertEqual(new.check(start,end)[\'allowed\'],expected)\n\n        def test_actual_rack_hit_is_still_rejected(self):\n            for item in items:\n                with self.subTest(id=item[\'id\']):\n                    bounds=item[\'bounds\']\n                    center=tuple((a+b)*.5 for a,b in zip(*bounds))\n                    start=(bounds[0][0]-10,center[1],center[2])\n                    end=(bounds[1][0]+10,center[1],center[2])\n                    guard=StaticPropGuard([[item[\'id\'],item[\'model\'],bounds]],{},bbox_instances={item[\'id\']})\n                    result=guard.check(start,end)\n                    self.assertFalse(result[\'allowed\'])\n                    self.assertEqual(result[\'method\'],\'engine_static_bbox\')\n\n        def test_ray_beyond_box_remains_clear(self):\n            for item in items:\n                bounds=item[\'bounds\'];x=bounds[1][0]+2\n                guard=StaticPropGuard([[item[\'id\'],item[\'model\'],bounds]],{})\n                self.assertTrue(guard.check((x,bounds[0][1]-10,0),(x,bounds[1][1]+10,0))[\'allowed\'])\n\n        def test_ray_ending_before_box_remains_clear(self):\n            b=items[0][\'bounds\'];center=tuple((a+c)*.5 for a,c in zip(*b))\n            guard=StaticPropGuard([[1,\'fixture\',b]],{})\n            self.assertTrue(guard.check((b[0][0]-10,*center[1:]),(b[0][0]-1,*center[1:]))[\'allowed\'])\n\n        def test_point_inside_box_stays_blocked(self):\n            b=items[0][\'bounds\'];center=tuple((a+c)*.5 for a,c in zip(*b))\n            guard=StaticPropGuard([[1,\'fixture\',b]],{})\n            self.assertFalse(guard.check(center,center)[\'allowed\'])\n\n        def test_invalid_ray_stays_closed(self):\n            self.assertFalse(fixed_guard().check((float(\'nan\'),0,0),(1,0,0))[\'allowed\'])\n\n        def test_clear_guard_is_shared_by_fire_and_selection(self):\n            guard=fixed_guard()\n            for start,end,expected in ITALY_RAYS:\n                result=apply_fire_guard(dict(kind=\'clear\',allowed=True),guard,start,end,{},map_name=key)\n                self.assertEqual(fire_path_allowed(result,False),expected)\n                self.assertEqual(guard.check(start,end)[\'allowed\'],expected)\n\n        def test_guard_fix_does_not_bypass_existing_wall_rejection(self):\n            start,end,_=ITALY_RAYS[0]\n            result=apply_fire_guard(dict(kind=\'blocked\',allowed=False,reason=\'fixture world wall\'),\n                                   fixed_guard(),start,end,{},map_name=key)\n            self.assertFalse(fire_path_allowed(result,True))\n            self.assertEqual(result[\'reason\'],\'fixture world wall\')\n\n        def test_unrelated_map_is_unchanged(self):\n            rows=original_rows();new,ids=apply_bbox_corrections(rows,meta,\'fixture_other\')\n            self.assertIs(rows,new);self.assertFalse(ids)\n\n        def test_all_48_identities_are_bound(self):\n            rows,ids=apply_bbox_corrections(original_rows(),meta,key)\n            self.assertEqual(len(rows),48);self.assertEqual(ids,{r[\'id\'] for r in items})\n\n        def test_unrelated_rows_are_preserved(self):\n            untouched=[9999,\'fixture\',[[0,0,0],[1,1,1]]]\n            rows,ids=apply_bbox_corrections(original_rows()+[untouched],meta,key)\n            self.assertIs(rows[-1],untouched)\n\n        def test_original_payload_not_mutated(self):\n            rows=original_rows();before=copy.deepcopy(rows)\n            result,_=apply_bbox_corrections(rows,meta,key)\n            self.assertEqual(rows,before);self.assertIsNot(rows,result)\n\n        def test_changed_guard_hash_fails_closed(self):\n            with self.assertRaisesRegex(ValueError,\'identity mismatch\'):\n                apply_bbox_corrections(original_rows(),dict(meta,sha256=\'changed\'),key)\n\n        def test_changed_map_hash_fails_closed(self):\n            with self.assertRaisesRegex(ValueError,\'identity mismatch\'):\n                apply_bbox_corrections(original_rows(),dict(meta,bsp_sha256=\'changed\'),key)\n\n        def test_wrong_model_fails_closed(self):\n            rows=original_rows();rows[0][1]=\'different\'\n            with self.assertRaisesRegex(ValueError,\'instance mismatch\'):\n                apply_bbox_corrections(rows,meta,key)\n\n        def test_changed_old_bounds_fail_closed(self):\n            rows=original_rows();rows[0][2][0][0]+=1\n            with self.assertRaisesRegex(ValueError,\'instance mismatch\'):\n                apply_bbox_corrections(rows,meta,key)\n\n        def test_missing_instance_fails_closed(self):\n            with self.assertRaisesRegex(ValueError,\'missing instance\'):\n                apply_bbox_corrections(original_rows()[1:],meta,key)\n\n        def test_duplicate_instance_fails_closed(self):\n            rows=original_rows();rows.append(copy.deepcopy(rows[0]))\n            with self.assertRaisesRegex(ValueError,\'instance mismatch\'):\n                apply_bbox_corrections(rows,meta,key)\n\n        def test_invalid_new_bounds_fail_closed(self):\n            for value in (float(\'nan\'),float(\'inf\')):\n                changed=copy.deepcopy(correction)\n                changed[\'instances\'][0][\'bounds\'][0][0]=value\n                with patch.object(data,\'BBOX_CORRECTIONS\',dict(data.BBOX_CORRECTIONS,**{key:changed})):\n                    with self.assertRaisesRegex(ValueError,\'bounds invalid\'):\n                        apply_bbox_corrections(original_rows(),meta,key)\n\n        def test_exact_endpoints_cache_not_stale_after_move(self):\n            guard=fixed_guard();start,end,_=ITALY_RAYS[0]\n            first=guard.check(start,end)\n            self.assertTrue(guard.check(start,end)[\'cache_hit\'])\n            moved=guard.check((start[0],start[1]+1,start[2]),end)\n            self.assertFalse(moved[\'cache_hit\'])\n\n    stream=io.StringIO()\n    result=unittest.TextTestRunner(stream=stream,verbosity=2).run(\n        unittest.defaultTestLoader.loadTestsFromTestCase(BoundsTests))\n    if not result.wasSuccessful():\n        raise RuntimeError(\'Static BBOX contract FAILED\\n\'+stream.getvalue())\n    return dict(passed=True,tests=result.testsRun,failures=0,errors=0,\n                corrected_instances=48,game_attached=False,gpu_required=False,\n                actual_fire_verified=False)\n')

_EMBEDDED['radar_display_contract'] = (1, '"""Radar placement, notice and overlay font regression; no attachment or GPU."""\nimport ast\nimport inspect\nimport io\nimport textwrap\nimport time\nimport unittest\nfrom types import SimpleNamespace as NS\nfrom unittest.mock import Mock\n\n\ndef run():\n    import cso2_bot_tool as app\n    import presentation as drawing\n    import native_overlay as gdi\n    import native_aa_overlay as aa\n    from native_radar import HINT\n    from ui_components import EN\n\n    class DisplayTests(unittest.TestCase):\n        def test_radar_has_one_display_page_entry_after_thirdperson(self):\n            tree=ast.parse(textwrap.dedent(inspect.getsource(app.App.__init__)))\n            calls=[n for n in ast.walk(tree) if isinstance(n,ast.Call)\n                   and isinstance(n.func,ast.Attribute) and n.func.attr==\'check\'\n                   and len(n.args)>2 and isinstance(n.args[1],ast.Constant)]\n            radar=[n for n in calls if n.args[1].value==\'radar\']\n            self.assertEqual(len(radar),1)\n            self.assertEqual(radar[0].args[0].id,\'radar_row\')\n            self.assertIn(\'radar_row=ttk.Frame(display)\',inspect.getsource(app.App.__init__))\n            self.assertEqual(radar[0].args[2].value,\'雷达显示敌方\')\n            order=sorted((n for n in calls if getattr(n.args[0],\'id\',None) in (\'display\',\'radar_row\')),key=lambda n:n.lineno)\n            keys=[n.args[1].value for n in order]\n            self.assertEqual(keys[keys.index(\'thirdperson_key\')+1],\'radar\')\n\n        def test_notice_follows_existing_setting(self):\n            flag=NS(get=lambda:False);label=Mock()\n            view=NS(vars={\'radar\':flag},radar_notice=label,layout_radar_notice=Mock(),\n                    radar_notice_text=Mock(),worker=NS(radar_delay_state=dict(phase=\'countdown\',deadline=time.monotonic()+6.)))\n            app.App.refresh_radar_notice(view)\n            label.pack_forget.assert_called_once()\n            flag.get=lambda:True\n            app.App.refresh_radar_notice(view)\n            label.pack.assert_called_once_with(anchor=\'w\',fill=\'x\',pady=(6,0))\n            view.worker.radar_delay_state=dict(phase=\'active\')\n            app.App.refresh_radar_notice(view)\n            self.assertEqual(label.pack_forget.call_count,2)\n            view.radar_notice_text.set.assert_called_with(\'\')\n            self.assertFalse(app.Config().radar)\n\n        def test_enabled_notice_reserves_window_height(self):\n            root=NS(winfo_height=lambda:740,winfo_screenheight=lambda:1600,\n                    minsize=Mock(return_value=(1080,740)))\n            view=NS(vars={\'radar\':NS(get=lambda:True)},_base_min_size=(1080,740),\n                    _radar_layout_job=1,root=root,radar_notice=NS(winfo_manager=lambda:\'pack\'),canvas=NS(winfo_height=lambda:280),\n                    esp_legend=NS(winfo_width=lambda:600,winfo_reqheight=lambda:460))\n            app.App.fit_radar_notice(view)\n            root.minsize.assert_called_with(1080,940)\n            self.assertIsNone(view._radar_layout_job)\n\n        def test_disabled_notice_restores_original_minimum(self):\n            root=NS(minsize=Mock(return_value=(1080,940)))\n            view=NS(vars={\'radar\':NS(get=lambda:False)},_base_min_size=(1080,740),\n                    _radar_layout_job=1,root=root,radar_notice=NS(winfo_manager=lambda:\'\'))\n            app.App.fit_radar_notice(view)\n            root.minsize.assert_called_with(1080,740)\n\n        def test_notice_copy_and_color(self):\n            source=inspect.getsource(app.App.__init__)\n            self.assertIn("self.radar_notice_text=self.i18n.var(\'\')",source)\n            self.assertNotIn("self.i18n.var(\'雷达显示敌方已开启",source)\n            self.assertIn("fg=\'#ffad55\'",source)\n            self.assertIn("trace_add(\'write\',self.refresh_radar_notice)",source)\n            self.assertLess(source.index("trace_add(\'write\',self.refresh_radar_notice)"),source.index(\'self.load()\'))\n\n        def test_new_copy_is_translated(self):\n            self.assertEqual(EN[\'雷达显示敌方\'],\'Show enemies on radar\')\n            self.assertIn(\'C4\',EN[HINT])\n            self.assertIn(\'received\',EN[HINT])\n            self.assertIn(\'不改变真实阵营\',HINT)\n            notice=\'届时将无法购买本阵营装备\'\n            self.assertIn(\'equipment\',EN[notice])\n\n        def test_tk_fallback_uses_yahei(self):\n            class Canvas:\n                def __init__(self):self.fonts=[]\n                def create_text(self,*args,**kwargs):self.fonts.append(kwargs[\'font\'])\n            canvas=Canvas()\n            count=drawing.draw_distance_labels(canvas,[(1,200,100,\'12m 可穿透 C4\',\'#ff4c61\',472)],500,250,False)\n            self.assertEqual(count,1)\n            self.assertEqual(drawing.OVERLAY_FONT,\'Microsoft YaHei\')\n            self.assertEqual(len(canvas.fonts),5)\n            self.assertTrue(all(font[0]==drawing.OVERLAY_FONT for font in canvas.fonts))\n\n        def test_gdiplus_measure_and_paint_share_font(self):\n            painter=NS(label_extent=Mock(return_value=(100.,20.)),distance_label=Mock())\n            canvas=NS(per_pixel_alpha=True,aa=painter,flush_lines=Mock())\n            self.assertEqual(aa.SmoothOverlay.measure_distance_label(canvas,\'12m 可穿透\',11),(104.,24.))\n            aa.SmoothOverlay.create_distance_label(canvas,80,40,\'12m 可穿透\',\'#ffffff\',11)\n            font=(drawing.OVERLAY_FONT,11,\'bold\')\n            painter.label_extent.assert_called_once_with(\'12m 可穿透\',font)\n            painter.distance_label.assert_called_once_with(80,40,\'12m 可穿透\',\'#ffffff\',font)\n\n        def test_gdi_fallback_paints_yahei(self):\n            canvas=NS(per_pixel_alpha=False,create_text=Mock())\n            aa.SmoothOverlay.create_distance_label(canvas,80,40,\'12m 可穿透\',\'#ffffff\',11)\n            self.assertEqual(canvas.create_text.call_count,5)\n            for call in canvas.create_text.call_args_list:\n                self.assertEqual(call.kwargs[\'font\'][0],drawing.OVERLAY_FONT)\n            self.assertIn(\'(OVERLAY_FONT,9)\',inspect.getsource(gdi.NativeOverlay.create_text))\n            self.assertIn(\'(OVERLAY_FONT,9)\',inspect.getsource(aa.AAPainter.text))\n\n        def test_scene_text_and_health_numbers_use_yahei(self):\n            tree=ast.parse(textwrap.dedent(inspect.getsource(app.draw_scene)))\n            fonts=[n.value for n in ast.walk(tree) if isinstance(n,ast.keyword) and n.arg==\'font\']\n            # The duplicate unknown-map exception warning was consolidated\n            # into one current-map resource warning in hotplug48.\n            self.assertGreaterEqual(len(fonts),6)\n            self.assertIn(\'esp_notice_line(frame.wall_capability,frame.map_name)\',inspect.getsource(app.draw_scene))\n            self.assertTrue(all(isinstance(f,ast.Tuple) and isinstance(f.elts[0],ast.Name)\n                                and f.elts[0].id==\'OVERLAY_FONT\' for f in fonts))\n\n    suite=unittest.defaultTestLoader.loadTestsFromTestCase(DisplayTests)\n    stream=io.StringIO();result=unittest.TextTestRunner(stream=stream,verbosity=2).run(suite)\n    if not result.wasSuccessful():raise AssertionError(stream.getvalue())\n    return dict(passed=True,tests=result.testsRun,failures=len(result.failures),errors=len(result.errors),\n                game_attached=False,gpu_required=False)\n\n\nif __name__==\'__main__\':print(run())\n')

_EMBEDDED['maintenance_contract'] = (1, '"""Maintenance regressions: identity, telemetry and display-source stability."""\nimport ast, copy, io, json, math, struct, tempfile, unittest\nfrom dataclasses import replace\nfrom pathlib import Path\nfrom types import SimpleNamespace as NS\nfrom unittest.mock import patch\n\n\ndef weapon_frame(ammo=30,handle=0x10002,stamp=10.):\n    from aim_motion_contract import fixture\n    f,t=fixture(\'head\');f.ammo=ammo;f.stamp=stamp;t.pose_sample_stamp=stamp\n    f.local.index=2;f.local.address=0x40000;f.local.serial=3\n    f.weapon_state=dict(valid=True,local_address=f.local.address,handle=handle,address=0x60000,\n        classname=f.weapon,ammo=ammo,stamp=stamp,reserve_ammo=90,reserve_status=\'verified_fields\')\n    return f,t\n\n\ndef source_replay(seconds=20):\n    from esp_sources import StableDisplaySelector\n    scope=(7,6,\'maps/CS_ITALY.bsp\',2)\n    def packet(source,stamp):\n        f,_=weapon_frame(stamp=stamp);f.source=source;f.source_pid=7\n        f.server_base=0x100000 if source==\'server\' else 0\n        return f,dict(read_ms=1.),scope\n    selector=StableDisplaySelector();blanks=0\n    for i in range(int(seconds*100)):\n        now=10.+i*.01;p={\'client\':packet(\'client\',now-.01)}\n        if i%50<40:p[\'server\']=packet(\'server\',now-.02)\n        chosen,_=selector.choose(p,scope,now)\n        blanks+=chosen is None\n    return dict(seconds=seconds,switches=selector.switches,blank_samples=blanks,\n                last_source=selector.current,synthetic=True)\n\n\ndef run():\n    from runtime_diagnostics import accuracy_profile,weapon_identity,observed_ammo_drop,radar_observation\n    from weapon_input_guard import read_weapon_state\n    from aim_tracking import AimTracker\n    from cso2_bot_tool import Controller,Config\n    from esp_sources import StableDisplaySelector\n    scope=(7,6,\'maps/CS_ITALY.bsp\',2)\n\n    class IdentityTests(unittest.TestCase):\n        def test_dataclass_replace_preserves_weapon_snapshot(self):\n            f,_=weapon_frame();g=replace(f,angles=(1.,2.,0.))\n            self.assertEqual(weapon_identity(f),weapon_identity(g));self.assertIs(g.weapon_state,f.weapon_state)\n        def test_same_weapon_last_bullet_observed(self):\n            f,_=weapon_frame(ammo=1);g=replace(f,ammo=0,stamp=10.01)\n            self.assertEqual(observed_ammo_drop(f,g),1)\n        def test_same_class_different_handle_not_a_shot(self):\n            f,_=weapon_frame();g,_=weapon_frame(3,handle=0x20002,stamp=10.01)\n            self.assertEqual(observed_ammo_drop(f,g),0)\n        def test_local_serial_reuse_not_a_shot(self):\n            f,_=weapon_frame();g=copy.deepcopy(f);g.local.serial+=1;g.ammo=3;g.stamp+=.01\n            self.assertEqual(observed_ammo_drop(f,g),0)\n        def test_map_change_not_a_shot(self):\n            f,_=weapon_frame();g=replace(f,ammo=3,stamp=10.01,map_name=\'other\')\n            self.assertEqual(observed_ammo_drop(f,g),0)\n        def test_unknown_identity_not_a_shot(self):\n            f,_=weapon_frame();g=replace(f,ammo=3,stamp=10.01,weapon_state={})\n            self.assertEqual(observed_ammo_drop(f,g),0)\n        def test_large_gap_or_reload_not_a_shot(self):\n            f,_=weapon_frame(ammo=3)\n            for g in (replace(f,ammo=30,stamp=10.01),replace(f,ammo=2,stamp=11.),replace(f,ammo=2,stamp=9.)):\n                self.assertEqual(observed_ammo_drop(f,g),0)\n        def test_invalid_ammo_not_coerced_into_number(self):\n            f,_=weapon_frame()\n            for ammo in (None,True,float(\'nan\'),-1,10000):\n                self.assertEqual(observed_ammo_drop(f,replace(f,ammo=ammo,stamp=10.01)),0)\n        def test_weapon_owner_mismatch_is_unknown(self):\n            f,_=weapon_frame();f.weapon_state[\'local_address\']+=1\n            self.assertIsNone(weapon_identity(f))\n        def test_tracker_does_not_reuse_same_name_new_handle(self):\n            f,t=weapon_frame();tracker=AimTracker();r=tracker.update(f,t,1.,1.)\n            g,u=weapon_frame(10,handle=0x20002,stamp=10.008);g.angles=r[\'out\']\n            self.assertFalse(tracker.update(g,u,1.,1.)[\'motion_compensated\'])\n        def test_tracker_same_weapon_continuity_preserved(self):\n            f,t=weapon_frame();tracker=AimTracker();r=tracker.update(f,t,1.,1.)\n            g,u=weapon_frame(29,stamp=10.008);g.angles=r[\'out\']\n            self.assertTrue(tracker.update(g,u,1.,1.)[\'motion_compensated\'])\n        def test_new_handle_releases_old_trigger_and_resets_cooldown(self):\n            actions=[];c=Controller(NS(mouse_button=actions.append),clock=lambda:10.)\n            f,_=weapon_frame();self.assertTrue(c.sync_weapon(f,10.))\n            c.pressed=True;c.last_fire=9.99;c.target=5\n            g,_=weapon_frame(3,handle=0x20002,stamp=10.01)\n            self.assertTrue(c.sync_weapon(g,10.01));self.assertEqual(actions,[False])\n            self.assertFalse(c.pressed);self.assertEqual(c.target,0);self.assertEqual(c.last_fire,-100.)\n            self.assertEqual(c.ammo_at,10.01)\n        def test_same_handle_does_not_release_or_reset_cooldown(self):\n            actions=[];c=Controller(NS(mouse_button=actions.append),clock=lambda:10.)\n            f,_=weapon_frame();c.sync_weapon(f,10.);c.pressed=True;c.last_fire=9.99\n            c.sync_weapon(replace(f,ammo=29,stamp=10.01),10.01)\n            self.assertEqual(actions,[]);self.assertTrue(c.pressed);self.assertEqual(c.last_fire,9.99)\n        def test_failed_release_retains_identity_for_retry(self):\n            trigger=NS(set=lambda down:False)\n            c=Controller(NS(),clock=lambda:10.,trigger=trigger);f,_=weapon_frame();c.sync_weapon(f,10.)\n            old=c.last_weapon_identity;c.pressed=True\n            g,_=weapon_frame(3,handle=0x20002,stamp=10.01)\n            self.assertFalse(c.sync_weapon(g,10.01));self.assertTrue(c.pressed)\n            self.assertEqual(c.last_weapon_identity,old)\n        def test_progress_guard_ignores_new_weapon_clip_drop(self):\n            from ballistics import ShotProgressGuard\n            f,t=weapon_frame();guard=ShotProgressGuard();guard.observe(f,10.)\n            guard.assess(f,t,dict(kind=\'clear\',allowed=True),10.);guard.remember(f,t,10.)\n            g,u=weapon_frame(3,handle=0x20002,stamp=10.01);guard.observe(g,10.01)\n            self.assertEqual(guard.records[guard.key(f,t)][\'total_rounds\'],0)\n\n    class TelemetryTests(unittest.TestCase):\n        def reader(self, *, fields=True, ammo_type=2, reserve=47, race=False, fail=False):\n            local=0x40000;address=0x60000;count=[0]\n            def u32(a):\n                self.assertEqual(a,local+0xf0c);count[0]+=1\n                return 0x10002+(int(race) if count[0]>1 else 0)\n            def i32(a):\n                if a==address+0xa30:return 3\n                if a==address+0xa20:return ammo_type\n                raise AssertionError(a)\n            def read(a,n):\n                self.assertEqual((a,n),(local+0xdfc+ammo_type*2,2))\n                if fail:raise OSError(\'fixture unreadable reserve\')\n                return struct.pack(\'<H\',reserve)\n            return NS(mem=NS(u32=u32,i32=i32,read=read),\n                fields_available=lambda *names:fields or \'m_iAmmo\' not in names,\n                handle_entity=lambda h:address,classname=lambda a:\'CWeaponXT97\'),local\n        def test_rifle_function_parameters_preserved(self):\n            p=accuracy_profile(dict(SpreadFunction=\'rifle\',BaseAccuracy=.2,DefaultSpread=.015,RunSpread=.04))\n            self.assertEqual(p[\'model\'],\'rifle\');self.assertEqual(p[\'parameters\'][\'RunSpread\'],.04)\n            self.assertFalse(p[\'engine_verified\']);self.assertIsNone(p[\'live_spread\'])\n        def test_legacy_spread_preserved(self):\n            self.assertEqual(accuracy_profile(dict(Spread=.01))[\'parameters\'],dict(Spread=.01))\n        def test_missing_and_nonfinite_not_zero_filled(self):\n            self.assertEqual(accuracy_profile(dict(Spread=float(\'nan\')))[\'parameters\'],{})\n            self.assertEqual(accuracy_profile(None)[\'model\'],\'unknown\')\n        def test_reserve_uses_verified_uint16_layout(self):\n            r,local=self.reader(reserve=4321);s=read_weapon_state(r,local,include_reserve=True)\n            self.assertTrue(s[\'valid\']);self.assertEqual(s[\'ammo\'],3);self.assertEqual(s[\'reserve_ammo\'],4321)\n        def test_reserve_zero_distinct_from_unknown(self):\n            r,local=self.reader(reserve=0);s=read_weapon_state(r,local,include_reserve=True)\n            self.assertEqual(s[\'reserve_ammo\'],0);self.assertEqual(s[\'reserve_status\'],\'verified_fields\')\n        def test_reserve_sentinel_is_not_reported_as_65535_bullets(self):\n            r,local=self.reader(reserve=65535);s=read_weapon_state(r,local,include_reserve=True)\n            self.assertTrue(s[\'valid\']);self.assertIsNone(s[\'reserve_ammo\'])\n            self.assertEqual(s[\'reserve_status\'],\'value_out_of_range\')\n        def test_unverified_reserve_does_not_disable_clip(self):\n            r,local=self.reader(fields=False);s=read_weapon_state(r,local,include_reserve=True)\n            self.assertTrue(s[\'valid\']);self.assertIsNone(s[\'reserve_ammo\'])\n            self.assertEqual(s[\'reserve_status\'],\'fields_unverified\')\n        def test_invalid_reserve_index_not_read(self):\n            for index in (-1,40,99):\n                r,local=self.reader(ammo_type=index);s=read_weapon_state(r,local,include_reserve=True)\n                self.assertTrue(s[\'valid\']);self.assertIsNone(s[\'reserve_ammo\'])\n        def test_reserve_read_failure_does_not_disable_clip(self):\n            r,local=self.reader(fail=True);s=read_weapon_state(r,local,include_reserve=True)\n            self.assertTrue(s[\'valid\']);self.assertEqual(s[\'reserve_status\'],\'read_error\')\n        def test_reserve_race_rejects_entire_snapshot(self):\n            r,local=self.reader(race=True);s=read_weapon_state(r,local,include_reserve=True)\n            self.assertFalse(s[\'valid\']);self.assertIsNone(s[\'reserve_ammo\'])\n        def test_fire_guard_default_does_not_read_reserve(self):\n            r,local=self.reader(fail=True)\n            with patch.object(r.mem,\'read\',side_effect=AssertionError(\'unexpected reserve read\')):\n                s=read_weapon_state(r,local)\n                self.assertTrue(s[\'valid\']);self.assertEqual(s[\'reserve_status\'],\'not_sampled\')\n        def test_log_observation_ids_link_events_without_claiming_fire_tick(self):\n            from battle_log import BattleLog\n            with tempfile.TemporaryDirectory(prefix=\'cso2_maintenance_log_\') as tmp:\n                log=BattleLog(tmp,set(),clock=lambda:10.05)\n                f,_=weapon_frame();control=NS(diagnostic={\'frame_stamp\':10.,\'target\':3},\n                    reason=\'fixture\',pressed=True,target=3,drain_actions=lambda:[])\n                try:\n                    log.frame(f,control,1.,1.,Config())\n                    log.frame(replace(f,ammo=29,stamp=10.01),control,1.,1.,Config())\n                    switched,_=weapon_frame(3,handle=0x20002,stamp=10.02)\n                    log.frame(switched,control,1.,1.,Config())\n                    self.assertEqual(log.current[\'observed_rounds\'],1)\n                finally:log.close()\n                self.assertFalse(log.error)\n                records=[json.loads(line) for path in Path(tmp).glob(\'*.jsonl\') for line in path.read_text(encoding=\'utf-8\').splitlines()]\n                drops=[r for r in records if r[\'kind\']==\'ammo_decreased\']\n                self.assertEqual(len(drops),1);self.assertIsNone(drops[0][\'engine_shot_tick\'])\n                oid=drops[0][\'observation_id\']\n                for kind in (\'shot_observation\',\'target_health_observation\',\'penetration_validation_shot\'):\n                    self.assertEqual(next(r for r in records if r[\'kind\']==kind)[\'observation_id\'],oid)\n                from compact_log import SCHEMA\n                self.assertEqual(next(r for r in records if r[\'kind\']==\'match_start\')[\'log_schema\'],SCHEMA)\n\n    class DisplayTests(unittest.TestCase):\n        def packet(self,source,stamp):\n            f,_=weapon_frame(stamp=stamp);f.source=source;f.source_pid=7\n            f.server_base=0x100000 if source==\'server\' else 0\n            return f,dict(read_ms=1.),scope\n        def test_recurrent_server_gaps_do_not_ping_pong(self):\n            result=source_replay();self.assertEqual(result[\'switches\'],1)\n            self.assertEqual(result[\'blank_samples\'],0)\n        def test_server_returns_when_continuously_healthy(self):\n            s=StableDisplaySelector()\n            s.choose({\'server\':self.packet(\'server\',9.99)},scope,10.)\n            s.choose({\'client\':self.packet(\'client\',10.01)},scope,10.02)\n            for i in range(121):\n                now=10.03+i*.01\n                selected,_=s.choose({name:self.packet(name,now-.01) for name in (\'client\',\'server\')},scope,now)\n            self.assertEqual(selected[0].source,\'server\')\n        def test_recovery_cooldown_never_hides_only_fresh_source(self):\n            s=StableDisplaySelector()\n            s.choose({\'server\':self.packet(\'server\',9.99)},scope,10.)\n            s.choose({\'client\':self.packet(\'client\',10.01)},scope,10.02)\n            chosen,_=s.choose({\'server\':self.packet(\'server\',10.025)},scope,10.03)\n            self.assertEqual(chosen[0].source,\'server\')\n        def test_hard_expiry_stays_120ms(self):\n            s=StableDisplaySelector();p=self.packet(\'server\',10.)\n            self.assertIsNone(s.choose({\'server\':p},scope,10.121)[0]);self.assertEqual(p[0].stamp,10.)\n        def test_only_selected_frame_is_copied(self):\n            import esp_sources\n            with patch.object(esp_sources,\'copy_frame\',wraps=esp_sources.copy_frame) as copies:\n                StableDisplaySelector().choose({n:self.packet(n,9.99) for n in (\'client\',\'server\')},scope,10.)\n                self.assertEqual(copies.call_count,1)\n        def test_stale_radar_status_has_no_current_counts(self):\n            metrics=dict(active=True,observed_at=10.,map=\'italy\',ui_counts={\'CT\':0,\'T\':21},c4_carrier_index=4)\n            out=radar_observation(metrics,requested=True,available=True,current_map=\'italy\',now=12.)\n            self.assertFalse(out[\'active\']);self.assertTrue(out[\'applied_last_observation\'])\n            self.assertIsNone(out[\'ui_counts\']);self.assertIsNone(out[\'c4_carrier_index\'])\n            self.assertTrue(metrics[\'active\'])\n        def test_wait_or_map_change_invalidates_radar_immediately(self):\n            m=dict(active=True,observed_at=10.,map=\'italy\')\n            for kwargs in (dict(current_map=\'other\'),dict(current_map=\'italy\',waiting=True)):\n                self.assertFalse(radar_observation(m,requested=True,available=True,now=10.1,**kwargs)[\'active\'])\n        def test_fresh_radar_observation_preserved(self):\n            m=dict(active=True,observed_at=10.,map=\'italy\',ui_counts={\'CT\':0,\'T\':21})\n            self.assertTrue(radar_observation(m,requested=True,available=True,current_map=\'italy\',now=10.1)[\'active\'])\n        def test_disabled_or_missing_timestamp_is_not_effective(self):\n            for m,requested in ((dict(active=True),True),(dict(active=True,observed_at=10.,map=\'italy\'),False)):\n                self.assertFalse(radar_observation(m,requested=requested,available=True,current_map=\'italy\',now=10.1)[\'effective_enabled\'])\n\n    suite=unittest.TestSuite(unittest.defaultTestLoader.loadTestsFromTestCase(c)\n        for c in (IdentityTests,TelemetryTests,DisplayTests))\n    output=io.StringIO();result=unittest.TextTestRunner(stream=output,verbosity=2).run(suite)\n    if not result.wasSuccessful():raise AssertionError(output.getvalue())\n    return dict(passed=True,tests=result.testsRun,source_replay=source_replay(),\n        game_attached=False,game_input=False,gpu_required=False,bullet_accuracy_verified=False)\n')

_EMBEDDED['runtime_diagnostics'] = (1, '"""Pure diagnostic contracts. No process access, input or GPU dependencies."""\nimport math\nfrom weapon_profiles import canonical_weapon_name\n\n\nACCURACY_FIELDS = tuple((\'Spread SpreadAlt SpreadFunction BaseAccuracy AccuracyDivisor \'\n    \'AccuracyOffset MaxInaccuracy DefaultSpread DefaultSpreadOffset RunSpread RunSpreadOffset \'\n    \'MoveSpread MoveSpreadOffset JumpSpread JumpSpreadOffset DuckingSpread DuckingSpreadOffset \'\n    \'InaccuracyStand InaccuracyCrouch InaccuracyMove InaccuracyJump InaccuracyFire \'\n    \'InaccuracyLand InaccuracyLadder InaccuracyStandAlt InaccuracyCrouchAlt \'\n    \'InaccuracyMoveAlt InaccuracyJumpAlt InaccuracyFireAlt RecoveryTimeStand \'\n    \'RecoveryTimeCrouch PistolAccuracyBase PistolAccuracyModifier PistolAccuracyMax PistolAccuracyMin\').split())\n\n\ndef accuracy_profile(profile):\n    profile = profile or {}\n    fields = {}\n    for name in ACCURACY_FIELDS:\n        value = profile.get(name)\n        if (name == \'SpreadFunction\' and isinstance(value, str)) or (\n                isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value)):\n            fields[name] = value\n    return dict(model=fields.get(\'SpreadFunction\') or (\'spread_fields\' if fields else \'unknown\'),\n        parameters=fields, profile_hash=profile.get(\'profile_hash\'),\n        basis=\'script_default_not_live_accuracy\', engine_verified=False,\n        live_spread=None, live_inaccuracy=None, spread_seed=None)\n\n\ndef weapon_identity(frame):\n    """A classname alone is not a weapon identity (drop/pickup/respawn)."""\n    state = getattr(frame, \'weapon_state\', None) or {}\n    local = frame.local\n    handle, address = state.get(\'handle\'), state.get(\'address\')\n    if (state.get(\'valid\') is not True or state.get(\'local_address\') != local.address\n            or not canonical_weapon_name(frame.weapon)\n            or canonical_weapon_name(state.get(\'classname\')) != canonical_weapon_name(frame.weapon)\n            or not isinstance(handle, int) or isinstance(handle, bool) or not 0 <= handle < 0xffffffff\n            or not isinstance(address, int) or isinstance(address, bool) or address <= 0):\n        return None\n    return (frame.map_name, local.index, local.address, local.serial,\n            handle, address, canonical_weapon_name(frame.weapon))\n\n\ndef observed_ammo_drop(previous, frame):\n    """Return an observed clip delta, never an inferred hit or shot tick."""\n    if previous is None:\n        return 0\n    before, after = previous.ammo, frame.ammo\n    if (not all(isinstance(v, int) and not isinstance(v, bool) for v in (before, after))\n            or not 0 <= after < before < 10000 or before-after > 64\n            or not 0 < frame.stamp-previous.stamp <= .2):\n        return 0\n    identity = weapon_identity(frame)\n    return before-after if identity is not None and identity == weapon_identity(previous) else 0\n\n\ndef radar_observation(metrics, *, requested, available, current_map, waiting=False, now):\n    """Keep ownership/requested state distinct from fresh observed UI state."""\n    out = dict(metrics)\n    stamp = metrics.get(\'observed_at\')\n    age = now-stamp if isinstance(stamp, (int, float)) and math.isfinite(stamp) else None\n    reason = (\'disabled\' if not requested else \'waiting_for_session\' if waiting else\n        \'map_changed\' if not current_map or metrics.get(\'map\') != current_map else\n        \'capability_unavailable\' if not available else\n        \'observation_stale\' if age is None or not 0 <= age <= 1. else\n        \'not_applied\' if not metrics.get(\'active\') else \'\')\n    out.update(active=not reason, requested=bool(requested), effective_enabled=not reason,\n        applied_last_observation=bool(metrics.get(\'active\')),\n        observed_age_ms=age*1000 if age is not None else None,\n        observation_state=reason or \'current\', live_hud_verified=False)\n    if reason:\n        out.update(c4_carrier_index=None, ui_counts=None, ui_local_team=None,\n                   team_view=None, real_local_team=None)\n    return out\n')


_EMBEDDED['aim_selection_contract'] = (1, '"""Full controller and static-wood regression; no process attachment or input."""\nimport copy,io,json,math,struct,unittest\nfrom dataclasses import replace\nfrom types import SimpleNamespace as NS\nfrom unittest.mock import patch\nimport cso2_bot_tool as tool\nimport penetration_results as results\nfrom aim_points import AimPoint\nfrom ballistics import assess_path,fire_path_allowed,thin_visible_path\nfrom geometry import WallHit,aim_angles,angle_error,view_direction\nfrom reader import Entity,Frame\nfrom static_prop_guard import StaticPropGuard,apply_fire_guard\n\nWEAPON=dict(Penetration=2,Damage=40,Range=8192,RangeModifier=.98,primary_ammo=\'762mm\',\n            WeaponType=\'rifle\',FullAuto=1,CycleTime=.1,profile_source=\'script_default_unverified_variant\')\n\n\ndef estimate(thickness=5.,code=87,distance=1024.,weapon=None):\n    return assess_path([WallHit(128./distance,(128.+thickness)/distance,thickness,\'T\',1)],\n                       WEAPON if weapon is None else weapon,distance,\'head\',{\'T\':code} if code is not None else {})\n\n\nclass MemoryFixture:\n    pid=999999\n    def __init__(self,reader):self.reader=reader\n    def read(self,address,size):\n        e=self.reader.entity\n        if address==0x50000+e.index*16 and size==8:return struct.pack(\'<II\',e.address,e.serial)\n        raise AssertionError((\'unexpected fixture read\',address,size))\n    def vec(self,address):\n        if address==0x70000:return self.reader.angles\n        if address==0x10000+0xfd8:return (0.,0.,0.)\n        raise AssertionError((\'unexpected fixture vector\',address))\n\n\nclass ReaderFixture:\n    def __init__(self,entity):\n        self.entity=entity;self.angles=(0.,0.,0.);self.writes=[];self.mem=MemoryFixture(self);self.bad_readback=False\n    def global_addr(self,key):return {\'entity_entries\':0x50000,\'view_angles\':0x70000}[key]\n    def target_entry(self,index):return 0x50000+index*16\n    def game_ui_visible(self):return False\n    def read_entity(self,index,address,with_inventory=False):return copy.deepcopy(self.entity)\n    def set_angles(self,angles):\n        self.writes.append(tuple(angles));self.angles=tuple(angles)\n        if self.bad_readback:self.angles=(angles[0]+10.,angles[1],0.)\n\n\nclass InputFixture:\n    def __init__(self):self.events=[];self.active=True\n    def foreground(self,pid):return self.active\n    def down(self,key):return key==2\n    def mouse_button(self,down):self.events.append(bool(down))\n\n\nclass WallFixture:\n    def __init__(self,thickness,code=87,guard=None):\n        self.thickness=thickness;self.code=code;self.fast_bsp=NS(\n            trace=self.trace,surface_materials={\'T\':code} if code is not None else {},\n            static_fire_guard=guard or StaticPropGuard([],{}),\n            # This fixture supplies the complete ray itself. Incomplete BSP\n            # behavior is covered by explicit native-trace fixtures instead\n            # of being inferred from an absent attribute.\n            native_complete=True,incomplete=False)\n    def trace(self,start,end,**kwargs):\n        distance=math.dist(start,end)\n        if self.thickness==0:return []\n        return [WallHit(128./distance,(128.+self.thickness)/distance,self.thickness,\'T\',1)]\n    def refresh_target(self,frame,entity,weapon,*args,**kwargs):\n        states=[]\n        for p in entity.aim_points:\n            hits=self.trace(frame.eye,p.position)\n            p.penetration=results.gate_path(assess_path(hits,weapon,math.dist(frame.eye,p.position),p.part,self.fast_bsp.surface_materials),frame.map_name)\n            # The fixture must publish the same closed ESP contract as the\n            # production wall adapter.  Ballistic path details stay in\n            # ``penetration``; ``clear`` is not a display/control state.\n            p.visibility=(\'penetrable\' if hits and p.penetration[\'allowed\']\n                          else \'blocked\' if hits else \'visible\')\n            p.penetrable=bool(hits and p.penetration[\'allowed\'])\n            p.wall_age_ms=0.;p.wall_eye_shift=0.;p.wall_head_shift=0.\n            states.append(\'penetrable\' if p.penetrable else \'blocked\' if hits else \'visible\')\n        # The controller now consumes the ESP actor verdict. Keep the point\n        # path fixture\'s native clear/blocked detail for ballistic assertions,\n        # while exposing the public three-state result on the actor.\n        entity.visibility=(\'visible\' if \'visible\' in states else\n                           \'penetrable\' if \'penetrable\' in states else \'blocked\')\n        entity.wall_age_ms=0.;entity.display_visibility_stamp=frame.stamp\n        entity.display_penetration={\'penetrable\':True,\'age_ms\':0.} if entity.visibility==\'penetrable\' else {}\n\n\ndef fixture(thickness=5.,code=87,map_name=\'cs_italy\',height=64.,guard=None,weapon=None):\n    now=[10.]\n    local=Entity(1,0x10000,\'CCSPlayer\',2,100,(0.,0.,0.),serial=1,velocity=(0.,0.,0.),flags=1)\n    head=(1024.,0.,height)\n    point=AimPoint(\'head\',\'head\',head,3.,0)\n    enemy=Entity(2,0x20000,\'CCSPlayer\',3,100,(1024.,0.,height-64.),serial=2,enemy=True,head=head,\n        head_radius=3.,model=\'fixture.mdl\',head_bone=\'head\',head_source=\'head_hitgroup\',\n        velocity=(0.,0.,0.),aim_points=[point],aim_points_validated=True)\n    frame=Frame(now[0],local,(0.,0.,64.),(0.,0.,0.),(0.,0.,0.),(1.,)*16,[enemy],map_name,\'ak47\',30,0,\'普通竞技\')\n    cfg=tool.Config(walls=True,wallbang=True);cfg.screen_acquire=False;cfg.strategy=\'准星优先\';cfg.fov=90.\n    weapon=dict(WEAPON if weapon is None else weapon)\n    wall=WallFixture(thickness,code,guard);wall.refresh_target(frame,enemy,weapon)\n    reader=ReaderFixture(enemy);inputs=InputFixture();control=tool.Controller(inputs,clock=lambda:now[0])\n    return NS(now=now,frame=frame,cfg=cfg,weapon=weapon,wall=wall,reader=reader,inputs=inputs,control=control)\n\n\ndef step(f):\n    f.frame.stamp=f.now[0]\n    f.control.step(f.reader,f.frame,f.cfg,f.weapon,f.wall)\n    return f.control.diagnostic\n\n\ndef screen_fixture(error=35.,screen=True):\n    f=fixture(thickness=0.);f.cfg.strategy=\'准星最近\';f.cfg.screen_acquire=screen;f.cfg.fov=12.\n    f.frame.angles=(0.,-error,0.);f.reader.angles=f.frame.angles\n    # Deterministic forward camera: x axis is forward, y is screen-right.\n    f.frame.matrix=(0.,1.,0.,0., 0.,0.,1.,-64., 0.,0.,0.,0., 1.,0.,0.,0.)\n    return f\n\n\ndef wood_guard(thickness=5.,material=87,second=False):\n    low=(-thickness/2.,-80.,-80.);high=(thickness/2.,80.,80.)\n    planes=[(1.,0.,0.,high[0]),(-1.,0.,0.,-low[0]),(0.,1.,0.,80.),(0.,-1.,0.,80.),(0.,0.,1.,80.),(0.,0.,-1.,80.)]\n    rows=[[1,\'fixture\',((128.+low[0],-80.,-16.),(128.+high[0],80.,144.)),(128.,0.,64.),(0.,0.,0.)]]\n    if second:rows.append([2,\'unknown\',((500.,-80.,-16.),(504.,80.,144.))])\n    return StaticPropGuard(rows,{\'map\':\'cs_italy\'},{\'fixture\':[((low,high),planes)]},{\'fixture\':material})\n\n\ndef run(raise_on_failure=True):\n    class Tests(unittest.TestCase):\n        def test_screen_search_admits_visible_target_outside_disabled_slider(self):\n            f=screen_fixture();d=step(f)\n            self.assertEqual(f.control.target,2,d)\n            self.assertTrue(d.get(\'fire_allowed\'),d)\n            self.assertIn(True,f.inputs.events)\n        def test_cone_mode_still_honors_twelve_degree_limit(self):\n            f=screen_fixture(screen=False);d=step(f)\n            self.assertEqual(f.control.target,0);self.assertNotIn(True,f.inputs.events)\n        def test_outside_screen_target_remains_excluded(self):\n            f=screen_fixture();f.frame.matrix=(0.,1.,0.,0.,0.,0.,1.,-64.,0.,0.,0.,0.,-1.,0.,0.,0.)\n            step(f);self.assertEqual(f.control.target,0);self.assertNotIn(True,f.inputs.events)\n        def test_low_angle_already_accepted_is_preserved(self):\n            f=screen_fixture(error=5.);d=step(f)\n            self.assertTrue(d.get(\'fire_allowed\'),d)\n        def test_unknown_visibility_does_not_authorize_shot(self):\n            f=screen_fixture();f.reader.entity.aim_points[0].visibility=\'unknown\';f.reader.entity.aim_points[0].penetration={}\n            step(f);self.assertNotIn(True,f.inputs.events)\n        def test_empty_magazine_never_fires(self):\n            f=screen_fixture();f.frame.ammo=0;step(f);self.assertNotIn(True,f.inputs.events)\n        def test_failed_view_readback_never_fires(self):\n            f=screen_fixture();f.reader.bad_readback=True;step(f);self.assertNotIn(True,f.inputs.events)\n        def test_clear_path_priority_and_nearest_stay_intact(self):\n            from target_priority import choose_visible\n            def row(index,error,kind):\n                e=NS(index=index,visibility=\'visible\' if kind==\'clear\' else \'penetrable\' if kind==\'penetration\' else \'blocked\',penetration={\'kind\':kind,\'allowed\':True})\n                return (error,e,(error,(0,0,0),error),{})\n            chosen=choose_visible([row(1,.1,\'penetration\'),row(2,20.,\'clear\'),row(3,30.,\'clear\')],0,\'准星最近\',True)\n            self.assertEqual(chosen[1].index,2)\n        def target_row(self,index,error,distance,kind=\'clear\',rushing=False):\n            e=NS(index=index,visibility=\'visible\' if kind==\'clear\' else \'penetrable\' if kind==\'penetration\' else \'blocked\',penetration={\'kind\':kind,\'allowed\':True})\n            return (error,e,(error,(0,0,0),error),{\'distance\':distance,\'rushing\':rushing})\n        def test_crosshair_nearest_wins_with_or_without_incumbent(self):\n            from target_priority import choose_visible\n            rows=[self.target_row(1,.1,1400.),self.target_row(2,35.,80.)]\n            self.assertEqual(choose_visible(rows,1,\'准星最近\',True)[1].index,1)\n            self.assertEqual(choose_visible(rows,0,\'准星最近\',True)[1].index,1)\n        def test_firearm_crosshair_policy_switches_to_materially_nearer_visible_target(self):\n            from target_priority import choose_visible\n            current=self.target_row(1,4.,420.)\n            closer=self.target_row(2,.2,90.)\n            self.assertEqual(choose_visible([current,closer],1,\'准星最近\',True,\n                                             distance_first=True)[1].index,2)\n            # Screen-search admission belongs to Controller, not a hidden\n            # selector cone. Crosshair-nearest follows the current error; a\n            # small hysteresis band only suppresses sub-degree jitter.\n            turned=self.target_row(1,26.,420.)\n            self.assertEqual(choose_visible([turned,closer],1,\'准星最近\',True,\n                                             distance_first=True)[1].index,2)\n            self.assertEqual(choose_visible([closer],1,\'准星最近\',True,\n                                             distance_first=True)[1].index,2)\n            blocked=self.target_row(1,.1,420.,\'penetration\')\n            self.assertEqual(choose_visible([blocked,closer],1,\'准星最近\',True,\n                                             distance_first=True)[1].index,2)\n        def test_focus_memory_survives_only_transient_release_and_same_identity(self):\n            f=fixture(thickness=0.);old=f.reader.entity\n            f.control.remember_focus(f.frame,old,f.now[0])\n            f.control.target=old.index\n            f.control.release(preserve_target=True)\n            self.assertEqual(f.control.target,old.index)\n            self.assertEqual(f.control.previous_focus(f.frame,f.now[0]+.2),old.index)\n            changed=copy.deepcopy(old);changed.serial+=1\n            f.frame.entities=[changed]\n            self.assertEqual(f.control.previous_focus(f.frame,f.now[0]+.21),0)\n            self.assertEqual(f.control.target,0)\n            f.frame.entities=[old]\n            f.control.remember_focus(f.frame,old,f.now[0])\n            f.control.target=old.index\n            f.control.release(preserve_target=True)\n            self.assertEqual(f.control.previous_focus(f.frame,f.now[0]+.36),0)\n            self.assertEqual(f.control.target,0)\n            f.control.remember_focus(f.frame,old,f.now[0])\n            f.control.target=old.index\n            f.control.release()\n            self.assertEqual(f.control.previous_focus(f.frame,f.now[0]),0)\n        def test_transient_selected_pose_failure_releases_fire_without_losing_target(self):\n            # A currently direct-visible, alive incumbent is intentionally\n            # allowed to continue through feedback backoff.  Exercise the\n            # transient pose-failure contract on a non-direct candidate so\n            # the selected-pose gate remains observable.\n            f=fixture(thickness=0.);f.cfg.strategy=\'准星最近\'\n            step(f)\n            self.assertEqual(f.control.target,2)\n            self.assertTrue(f.control.pressed)\n            f.reader.entity.aim_points[0].visibility=\'unknown\'\n            f.reader.entity.aim_points[0].penetration={}\n            f.now[0]+=.02\n            d=step(f)\n            self.assertEqual(f.control.target,0,d)\n            self.assertFalse(f.control.pressed,d)\n            self.assertEqual(f.inputs.events,[True,False])\n            self.assertFalse(d[\'fire_allowed\'])\n        def test_unknown_wall_sample_keeps_live_identity_without_firing_old_ray(self):\n            f=fixture(thickness=0.);f.cfg.strategy=\'准星最近\'\n            step(f)\n            self.assertTrue(f.control.pressed)\n            for point in f.reader.entity.aim_points:\n                point.visibility=\'unknown\';point.penetration={}\n            f.now[0]+=.16\n            d=step(f)\n            self.assertEqual(f.control.target,0,d)\n            self.assertFalse(f.control.pressed,d)\n            self.assertEqual(f.inputs.events,[True,False])\n            self.assertFalse(d[\'fire_allowed\'])\n            f.wall.refresh_target(f.frame,f.reader.entity,f.weapon)\n            f.now[0]+=.02\n            d=step(f)\n            self.assertEqual(f.control.target,2,d)\n            self.assertTrue(d[\'fire_allowed\'],d)\n            self.assertEqual(f.inputs.events,[True,False,True])\n        def test_unknown_wall_identity_hold_expires(self):\n            f=fixture(thickness=0.);f.cfg.strategy=\'准星最近\'\n            step(f)\n            for point in f.reader.entity.aim_points:\n                point.visibility=\'unknown\';point.penetration={}\n            f.now[0]+=.36\n            d=step(f)\n            self.assertEqual(f.control.target,0,d)\n            self.assertFalse(f.control.pressed)\n        def test_blocked_wall_is_not_pending_identity(self):\n            f=fixture(thickness=0.);f.cfg.strategy=\'准星最近\'\n            step(f)\n            for point in f.reader.entity.aim_points:\n                point.visibility=\'blocked\';point.penetration={\'kind\':\'blocked\',\'allowed\':False}\n            f.now[0]+=.16\n            d=step(f)\n            self.assertEqual(f.control.target,0,d)\n            self.assertFalse(f.control.pressed)\n        def test_contact_wallbang_never_preempts_visible_far_enemy(self):\n            from target_priority import choose_visible\n            rows=[self.target_row(1,20.,1400.),self.target_row(2,.1,80.,\'penetration\')]\n            self.assertEqual(choose_visible(rows,2,\'准星最近\',True)[1].index,1)\n        def test_same_contact_band_uses_strict_crosshair_order(self):\n            from target_priority import choose_visible\n            rows=[self.target_row(1,.4,80.),self.target_row(2,.1,100.)]\n            self.assertEqual(choose_visible(rows,1,\'准星最近\',True)[1].index,2)\n            self.assertEqual(choose_visible(rows,0,\'准星最近\',True)[1].index,2)\n        def test_far_candidates_still_pick_crosshair_not_distance(self):\n            from target_priority import choose_visible\n            rows=[self.target_row(1,.1,2000.),self.target_row(2,4.,600.)]\n            self.assertEqual(choose_visible(rows,0,\'准星最近\',True)[1].index,1)\n        def test_rushing_enemy_does_not_override_crosshair(self):\n            from target_priority import choose_visible\n            rows=[self.target_row(1,.1,2000.),self.target_row(2,30.,400.,rushing=True)]\n            self.assertEqual(choose_visible(rows,1,\'准星最近\',True)[1].index,1)\n            self.assertEqual(choose_visible(rows,0,\'准星最近\',True)[1].index,1)\n        def test_survival_thresholds_and_invalid_distance(self):\n            from target_priority import survival_rank\n            for distance,expected in ((0.,0),(128.,0),(128.001,1),(192.,1),(192.001,2),(float(\'nan\'),2),(float(\'inf\'),2),(-1.,2)):\n                self.assertEqual(survival_rank({\'distance\':distance}),expected)\n        def test_near_boundary_does_not_override_crosshair(self):\n            from target_priority import choose_visible\n            rows=[self.target_row(1,.1,130.),self.target_row(2,.4,127.)]\n            self.assertEqual(choose_visible(rows,2,\'准星最近\',True)[1].index,1)\n            rows=[self.target_row(1,.1,600.),self.target_row(2,.4,80.)]\n            self.assertEqual(choose_visible(rows,1,\'准星最近\',True)[1].index,1)\n            self.assertEqual(choose_visible(rows,0,\'准星最近\',True)[1].index,1)\n        def test_semi_auto_keeps_crosshair_over_farther_contact(self):\n            f=screen_fixture(error=0.);far=f.reader.entity;near=copy.deepcopy(far)\n            near.index=3;near.address=0x30000;near.serial=3;near.head=(80.,40.,64.);near.origin=(80.,40.,0.)\n            near.aim_points[0].position=near.head;f.wall.refresh_target(f.frame,near,f.weapon)\n            class MultiMemory(MemoryFixture):\n                def read(self,address,size):\n                    for e in (far,near):\n                        if address==0x50000+e.index*16 and size==8:return struct.pack(\'<II\',e.address,e.serial)\n                    return super().read(address,size)\n            class MultiReader(ReaderFixture):\n                def read_entity(self,index,address,with_inventory=False):return copy.deepcopy(far if index==far.index else near)\n            f.reader=MultiReader(far);f.reader.mem=MultiMemory(f.reader)\n            f.frame.entities=[far,near];f.weapon[\'FullAuto\']=0;f.weapon[\'WeaponType\']=\'pistol\'\n            f.control.target=far.index\n            f.control.engagement=dict(key=(f.frame.map_name,f.frame.local.address,f.frame.local.serial,\n                far.index,far.address,far.serial,f.frame.weapon),first_fire=9.9,written_view=f.frame.angles)\n            # Semi-auto firearms use the same current crosshair ordering as\n            # automatic weapons. The closer actor is a 26-degree contact\n            # target, while the original actor is centered on the crosshair.\n            # Near-first behavior is covered by the explicit 近身优先 policy.\n            step(f);self.assertEqual(f.control.target,far.index)\n        def test_wood_shot_repeated_guard_is_idempotent(self):\n            g=wood_guard();p={\'kind\':\'clear\',\'allowed\':True}\n            a=apply_fire_guard(p,g,(0,0,64),(1024,0,64),WEAPON,\'head\',\'cs_italy\')\n            b=apply_fire_guard(a,g,(0,0,64),(1024,0,64),WEAPON,\'head\',\'cs_italy\')\n            self.assertTrue(a[\'allowed\']);self.assertEqual(a[\'layers\'],b[\'layers\'])\n        def test_wood_and_world_share_layer_and_power_limits(self):\n            world=results.gate_path(assess_path([WallHit(400/1024,435/1024,35,\'T\',1)],WEAPON,1024,\'head\',{\'T\':87}),\'cs_italy\')\n            p=apply_fire_guard(world,wood_guard(5.),(0,0,64),(1024,0,64),WEAPON,\'head\',\'cs_italy\')\n            self.assertTrue(p[\'allowed\'],p)\n            self.assertAlmostEqual(p[\'remaining_power\'],1.5)\n            world=results.gate_path(assess_path([WallHit(400/1024,438/1024,38,\'T\',1)],WEAPON,1024,\'head\',{\'T\':87}),\'cs_italy\')\n            p=apply_fire_guard(world,wood_guard(5.),(0,0,64),(1024,0,64),WEAPON,\'head\',\'cs_italy\')\n            self.assertFalse(p[\'allowed\'],p)\n            p=apply_fire_guard({\'kind\':\'clear\',\'allowed\':True},wood_guard(5.),(0,0,64),(1024,0,64),\n                               dict(WEAPON,Penetration=1),\'head\',\'cs_italy\')\n            self.assertTrue(p[\'allowed\'])\n            world=results.gate_path(assess_path([WallHit(400/1024,405/1024,5,\'T\',1)],\n                dict(WEAPON,Penetration=1),1024,\'head\',{\'T\':87}),\'cs_italy\')\n            self.assertFalse(apply_fire_guard(world,wood_guard(5.),(0,0,64),(1024,0,64),\n                dict(WEAPON,Penetration=1),\'head\',\'cs_italy\')[\'allowed\'])\n        def test_material_pair_bonus_requires_proven_matching_exit(self):\n            for code in (87,77):\n                thick=50. if code==87 else 30.\n                hit=WallHit(.1,.1+thick/1024,thick,\'A\',1,exit_texture=\'B\')\n                pair=assess_path([hit],WEAPON,1024,\'head\',{\'A\':code,\'B\':code})\n                self.assertTrue(pair[\'allowed\'],pair)\n                unknown=assess_path([hit],WEAPON,1024,\'head\',{\'A\':code})\n                mixed=assess_path([hit],WEAPON,1024,\'head\',{\'A\':code,\'B\':67})\n                self.assertFalse(unknown[\'allowed\']);self.assertFalse(mixed[\'allowed\'])\n        def test_mixed_world_boundaries_survive_prop_reassessment(self):\n            hit=WallHit(400/1024,410/1024,10,\'A\',1,exit_texture=\'B\')\n            world=results.gate_path(assess_path([hit],WEAPON,1024,\'head\',{\'A\':87,\'B\':67}),\'cs_italy\')\n            g=wood_guard(5.)\n            a=apply_fire_guard(world,g,(0,0,64),(1024,0,64),WEAPON,\'head\',\'cs_italy\')\n            b=apply_fire_guard(a,g,(0,0,64),(1024,0,64),WEAPON,\'head\',\'cs_italy\')\n            self.assertTrue(a[\'allowed\'],a);self.assertEqual(a[\'layers\'],b[\'layers\'])\n            self.assertEqual(a[\'layers\'][1][\'entry_material\'],87)\n            self.assertEqual(a[\'layers\'][1][\'exit_material\'],67)\n            self.assertEqual(a[\'layers\'][1][\'penetration_modifier\'],1.)\n        def test_overlapping_mixed_solids_do_not_gain_uniform_bonus(self):\n            hits=[WallHit(400/1024,430/1024,30,\'W\',1,exit_texture=\'W\'),\n                  WallHit(405/1024,410/1024,5,\'C\',1,exit_texture=\'C\')]\n            self.assertFalse(assess_path(hits,WEAPON,1024,\'head\',{\'W\':87,\'C\':67})[\'allowed\'])\n        def test_ray_start_inside_wood_remains_blocked(self):\n            p=apply_fire_guard({\'kind\':\'clear\',\'allowed\':True},wood_guard(),(128,0,64),(1024,0,64),WEAPON,\'head\',\'cs_italy\')\n            self.assertFalse(p[\'allowed\'],p)\n        def test_material_binding_rejects_different_hull_hash(self):\n            from static_prop_materials import WOOD_MODEL_MATERIALS\n            key=\'models/maps/de_dust2/de_dust2_doors03.mdl\'\n            with patch.dict(WOOD_MODEL_MATERIALS,{key:dict(WOOD_MODEL_MATERIALS[key],hull_sha256=\'0\'*64)}):\n                with self.assertRaises(ValueError):StaticPropGuard.for_map(\'de_dust2\')\n        def test_sa02_iron_gate_uses_metal_not_grate_budget(self):\n            guard=StaticPropGuard.for_map(\'de_sa02\')\n            eye=(444.,2600.,30.);point=(444.,2700.,30.)\n            evidence=guard.check(eye,point,allow_thin=True)\n            self.assertEqual(evidence[\'state\'],\'metal_surface_condition\')\n            self.assertEqual(evidence[\'surface_segments\'][0][\'prop_id\'],15)\n            self.assertAlmostEqual((evidence[\'surface_segments\'][0][\'leave\']-\n                evidence[\'surface_segments\'][0][\'enter\'])*math.dist(eye,point),4.335057,places=3)\n            usp=dict(Penetration=1,Damage=34,Range=4096,RangeModifier=.79,\n                     primary_ammo=\'BULLET_PLAYER_45ACP_2\',profile_source=\'script_default_unverified_variant\')\n            path=apply_fire_guard(dict(kind=\'clear\',allowed=True),guard,eye,point,usp,\'body\',\'de_sa02\')\n            self.assertTrue(path[\'allowed\'],path)\n            self.assertEqual(path[\'layers\'][0][\'materials\'],[\'native_M\'])\n            self.assertFalse(fire_path_allowed(path,False))\n            weak=dict(usp,primary_ammo=\'BULLET_PLAYER_45ACP_2\')\n            weak[\'Damage\']=.5\n            self.assertFalse(apply_fire_guard(dict(kind=\'clear\',allowed=True),guard,eye,point,weak,\'body\',\'de_sa02\')[\'allowed\'])\n            from static_prop_materials import METAL_MODEL_MATERIALS\n            key=\'models/maps/dm_sa02/dm_sa02_frontirongate01.mdl\'\n            with patch.dict(METAL_MODEL_MATERIALS,{key:dict(METAL_MODEL_MATERIALS[key],hull_sha256=\'0\'*64)}):\n                with self.assertRaises(ValueError):StaticPropGuard.for_map(\'de_sa02\')\n        def test_metal_shell_does_not_bypass_thickness_or_identity(self):\n            path=apply_fire_guard(dict(kind=\'clear\',allowed=True),wood_guard(40.,material=77),\n                                  (0,0,64),(1024,0,64),WEAPON,\'head\',\'de_sa02\')\n            self.assertFalse(path[\'allowed\'],path)\n            from static_prop_materials import METAL_MODEL_MATERIALS\n            key=\'models/maps/dm_sa02/dm_sa02_drumtong01.mdl\'\n            with patch.dict(METAL_MODEL_MATERIALS,{key:dict(METAL_MODEL_MATERIALS[key],hull_sha256=\'0\'*64)}):\n                with self.assertRaises(ValueError):StaticPropGuard.for_map(\'de_sa02\')\n        def test_selection_diagnostics_explain_screen_rejection(self):\n            f=screen_fixture();f.frame.matrix=(0.,)*16;d=step(f)\n            self.assertEqual(d[\'selection_rejections\'][0][\'reject_stage\'],\'outside_screen\')\n    stream=io.StringIO();result=unittest.TextTestRunner(stream=stream,verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(Tests))\n    report=dict(passed=result.wasSuccessful(),tests=result.testsRun,failures=len(result.failures),errors=len(result.errors),\n                detail=stream.getvalue(),game_attached=False,input_sent=False,gpu_required=False)\n    if raise_on_failure and not report[\'passed\']:raise AssertionError(report[\'detail\'])\n    return report\n')

