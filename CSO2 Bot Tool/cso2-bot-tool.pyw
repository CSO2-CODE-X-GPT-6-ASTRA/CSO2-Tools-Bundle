e.monotonic()]\n    options=dict(clock=lambda:now[0])\n    if init.get(\'rotate_bytes\') is not None:options[\'rotate_bytes\']=init[\'rotate_bytes\']\n    log=BattleLog(folder,init.get(\'names\',()),**options)\n    inbox=queue.Queue(8);ended=threading.Event();ack=0;last_status=0.;lag=0.;error=\'\'\n    def receive():\n        try:\n            while not ended.is_set():\n                packet=read_packet(stream)\n                while not ended.is_set():\n                    try:inbox.put(packet,timeout=.25);break\n                    except queue.Full:pass\n        except EOFError:pass\n        except Exception as ex:\n            inbox.put(dict(op=\'pipe_error\',error=str(ex)))\n        finally:\n            while not ended.is_set():\n                try:inbox.put(None,timeout=.25);break\n                except queue.Full:pass\n    thread=threading.Thread(target=receive,daemon=True);thread.start()\n    def status(force=False):\n        nonlocal last_status\n        real=time.monotonic()\n        if not force and real-last_status<.25:return\n        keys=(\'id\',\'map\',\'confirmed_damage_events\',\'confirmed_head_damage_events\',\'received_attack_events\',\n              \'received_head_damage_events\',\'received_unknown_hitgroup_events\',\'received_head_damage_total\',\n              \'attack_score\',\'observed_health_loss_events\')\n        current={k:log.current.get(k) for k in keys} if log.current else None\n        print(json.dumps(dict(ack=ack,current=current,error=error or log.error or log.accuracy_error,\n            metrics=dict(pid=os.getpid(),lag_ms=lag,writer_alive=log.thread.is_alive(),\n                writer_queue=log.queue.qsize(),dropped_records=log.dropped,\n                accuracy_archive=log.accuracy_health(),\n                generation=init.get(\'generation\'),game_handles=0))),flush=True)\n        last_status=real\n    status(True)\n    try:\n        while True:\n            try:packet=inbox.get(timeout=.25)\n            except queue.Empty: