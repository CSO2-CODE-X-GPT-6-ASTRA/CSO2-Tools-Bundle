_EMBEDDED['esp_geometry_fixture'] = (1, '"""Offline legacy geometry fixture. Never imported by production ESP."""\nimport time\nfrom geometry import finite,box_ray,hull_intervals\nVISIBLE="visible"\ndef brush_blocks(brush,start,delta):\n    """Same convex clipping and tolerances as the original BSP traversal."""\n    sx,sy,sz=start;dx,dy,dz=delta;enter,leave=0.,1.\n    for n,plane,_ in brush.planes:\n        distance=n[0]*sx+n[1]*sy+n[2]*sz-plane;den=n[0]*dx+n[1]*dy+n[2]*dz\n        if abs(den)<1e-10:\n            if distance>0:return False\n        else:\n            fraction=-distance/den\n            if den<0:enter=max(enter,fraction)\n            else:leave=min(leave,fraction)\n            if enter>leave:return False\n    return leave>max(enter,0) and leave>0 and enter<1\n\n\nclass _StaticPropBlocker:\n    """Cache marker for a static-prop hit; never passed to brush clipping."""\n    _display_static_prop=True\n\n\n_STATIC_PROP_BLOCKER=_StaticPropBlocker()\n\n\ndef blocking_brush(bsp,start,end,preferred=None,display=False):\n    """Recheck geometry against the CURRENT ray.\n\n    ``display`` deliberately has a less conservative policy than the fire\n    path.  Mounted map packages are world-brush-complete for ESP even though\n    they are not sufficient to authorize a shot.  A missing static-prop\n    bound is uncertainty for fire, but it is not an intersection on this\n    particular ray and therefore must not turn every actor into ``blocked``.\n    """\n    if (len(start)!=3 or len(end)!=3 or not finite(start) or not finite(end)\n            or (getattr(bsp,\'incomplete\',False) and not display)):\n        return _STATIC_PROP_BLOCKER,False\n    delta=(end[0]-start[0],end[1]-start[1],end[2]-start[2])\n    if sum(value*value for value in delta)<1e-12:return _STATIC_PROP_BLOCKER,False\n    if getattr(preferred,\'_display_static_prop\',False):preferred=None\n    # A blocker found for another joint in THIS frame is only a geometry\n    # candidate. Recheck the complete current segment, including a prop\'s\n    # actual hull; never reuse a verdict across points or frames.\n    if display and preferred is not None and box_ray(preferred.bounds,start,delta):\n        if hasattr(preferred,\'hulls\'):\n            if not preferred.hulls or hull_intervals(preferred,start,delta):return preferred,True\n        elif brush_blocks(preferred,start,delta):return preferred,True\n    # World BSP brushes are only half of the display collision surface.\n    # Static props (crates, gates, glass/grates) use the frozen hull/BBOX guard\n    # owned by WallService. For display, only an actual current-ray\n    # intersection blocks. The fire path keeps its separate missing-bounds\n    # abstention below this function\'s default mode.\n    neutral=getattr(bsp,\'static_geometry\',None)\n    if neutral is not None and getattr(neutral,\'tree\',None) is not None:\n        for proxy in neutral.tree.candidates(start,delta):\n            if proxy.hulls:\n                if hull_intervals(proxy,start,delta):return proxy if display else _STATIC_PROP_BLOCKER,False\n            elif box_ray(proxy.bounds,start,delta):\n                return proxy if display else _STATIC_PROP_BLOCKER,False\n    guard=None if neutral is not None else getattr(bsp,\'static_fire_guard\',None)\n    if guard is not None:\n        try:evidence=guard.check(start,end,allow_thin=False)\n        except (AttributeError,TypeError,ValueError,OverflowError,OSError):evidence={\'allowed\':False}\n        if not isinstance(evidence,dict) or evidence.get(\'allowed\') is not True:\n            # ``missing_bounds`` is not an intersection.  It remains a hard\n            # rejection for fire callers, while display can still use the\n            # world/known-prop result for this exact line of sight.\n            actual_prop_hit=(isinstance(evidence,dict) and\n                             (evidence.get(\'prop_id\') is not None or\n                              bool(evidence.get(\'surface_segments\')) or\n                              bool(evidence.get(\'thin_segments\'))))\n            if display and isinstance(evidence,dict) and evidence.get(\'missing_bounds\') and not actual_prop_hit:\n                evidence=dict(evidence,allowed=True,state=\'display_unresolved_prop_not_hit\')\n            else:\n                return _STATIC_PROP_BLOCKER,False\n        if not display and evidence.get(\'missing_bounds\',0):\n            return _STATIC_PROP_BLOCKER,False\n    if (preferred is not None and hasattr(preferred,\'planes\') and box_ray(preferred.bounds,start,delta)\n            and brush_blocks(preferred,start,delta)):\n        return preferred,True\n    for brush in bsp.tree.candidates(start,delta):\n        if brush is preferred:continue\n        if brush_blocks(brush,start,delta):return brush,False\n    return None,False\n\n\ndef world_blocked(bsp,start,end):\n    return blocking_brush(bsp,start,end)[0] is not None\n\n\ndef display_world_blocked(bsp,start,end):\n    """Return the current ESP line-of-sight result, never fire permission."""\n    return blocking_brush(bsp,start,end,display=True)[0] is not None\n\n\ndef trace_frame(bsp,request,budget_ms=None):\n    """Trace every current endpoint; store no cross-frame verdicts."""\n    started=time.perf_counter();results=[];rays=0;cache_hits=0;now=request[\'stamp\'];eye=tuple(request[\'eye\'])\n    rows=list(request[\'entities\'])\n    for key,origin,points in rows:\n        if not points:continue\n        visibility=\'blocked\';checked=[];preferred=None\n        # The old per-actor bundled tree rebuilt a broad-phase copy for every\n        # target. Profiling showed that copy/traversal cost dominated the\n        # actual rays (about 29-45 ms for one captured frame). Reuse the\n        # immutable map tree for this frame and keep the exact segment test\n        # per endpoint; this is faster without retaining any cross-frame\n        # visibility result.\n        current_geometry=bsp\n        # Every point retains its own ray proof; seeing one arm never grants\n        # permission to aim at a torso hidden behind a tree or wall.\n        for point in points:\n            rays+=1\n            blocker,hit=blocking_brush(current_geometry,eye,point,preferred,True);cache_hits+=int(hit)\n            if blocker is not None:preferred=blocker\n            if blocker is None:\n                visibility=VISIBLE;checked.append(point)\n        if visibility==\'blocked\':checked=list(points)\n        results.append([key,origin,eye,now,visibility,checked])\n    elapsed=(time.perf_counter()-started)*1000\n    return results,dict(rays=rays,targets=len(results),trace_ms=round(elapsed,3),\n                        blocker_cache_hits=cache_hits,bvh_traces=rays-cache_hits,\n                        budget_overrun_ms=round(max(0.,elapsed-budget_ms),3) if budget_ms is not None else 0.,\n                        deferred_targets=0,display_verdict_cache=False,\n                        current_ray_frame=True,same_frame_candidate_rechecks=cache_hits)\n\n\n')

_EMBEDDED['bhop_service'] = (1, '"""Independent jump input. No control frames, heartbeat leases or aim/fire access."""\nimport ctypes as C\nfrom ctypes import wintypes as W\nimport os\nfrom pathlib import Path\nimport struct\nimport subprocess\nimport sys\nimport threading\nimport time\nimport uuid\n\nPOLL_SECONDS = .004\n\n\ndef kernel():\n    k = C.WinDLL(\'kernel32\', use_last_error=True)\n    for name, args, result in (\n        (\'OpenProcess\', [W.DWORD, W.BOOL, W.DWORD], W.HANDLE),\n        (\'CreateEventW\', [C.c_void_p, W.BOOL, W.BOOL, W.LPCWSTR], W.HANDLE),\n        (\'OpenEventW\', [W.DWORD, W.BOOL, W.LPCWSTR], W.HANDLE),\n        (\'SetEvent\', [W.HANDLE], W.BOOL), (\'ResetEvent\', [W.HANDLE], W.BOOL),\n        (\'WaitForSingleObject\', [W.HANDLE, W.DWORD], W.DWORD),\n        (\'CloseHandle\', [W.HANDLE], W.BOOL)):\n        fn = getattr(k, name); fn.argtypes = args; fn.restype = result\n    return k\n\n\nclass Signals:\n    """Only settings and shutdown cross processes; no per-jump messages."""\n    def __init__(self, tag, create=False):\n        self.k = kernel(); self.handles = {}\n        try:\n            for name in (\'stop\', \'enabled\'):\n                path = tag + \'_\' + name\n                h = (self.k.CreateEventW(None, True, False, path) if create else\n                     self.k.OpenEventW(0x100000, False, path))\n                if not h: raise C.WinError(C.get_last_error())\n                self.handles[name] = h\n        except BaseException:\n            self.close(); raise\n\n    def is_set(self, name):\n        result = self.k.WaitForSingleObject(self.handles[name], 0)\n        if result not in (0, 0x102): raise C.WinError(C.get_last_error())\n        return result == 0\n\n    def set(self, name, value=True):\n        fn = self.k.SetEvent if value else self.k.ResetEvent\n        if not fn(self.handles[name]): raise C.WinError(C.get_last_error())\n\n    def wait(self, seconds):\n        result = self.k.WaitForSingleObject(self.handles[\'stop\'], max(1, round(seconds * 1000)))\n        if result not in (0, 0x102): raise C.WinError(C.get_last_error())\n        return result == 0\n\n    def close(self):\n        for h in self.handles.values(): self.k.CloseHandle(h)\n        self.handles.clear()\n\n\nclass Lifetime:\n    """Pinned process handles cannot be fooled by PID reuse."""\n    def __init__(self, parent_pid, game_pid):\n        self.k = kernel(); self.handles = []\n        try:\n            for pid in (parent_pid, game_pid):\n                h = self.k.OpenProcess(0x100000, False, int(pid))\n                if not h: raise C.WinError(C.get_last_error())\n                self.handles.append(h)\n        except BaseException:\n            self.close(); raise\n\n    def alive(self):\n        return all(self.k.WaitForSingleObject(h, 0) == 0x102 for h in self.handles)\n\n    def close(self):\n        for h in self.handles: self.k.CloseHandle(h)\n        self.handles.clear()\n\n\nclass Keys:\n    def __init__(self):\n        self.u = C.WinDLL(\'user32\', use_last_error=True)\n        self.u.GetAsyncKeyState.argtypes = [C.c_int]; self.u.GetAsyncKeyState.restype = C.c_short\n        self.u.GetForegroundWindow.argtypes = []; self.u.GetForegroundWindow.restype = W.HWND\n        self.u.GetWindowThreadProcessId.argtypes = [W.HWND, C.POINTER(W.DWORD)]\n        self.u.GetWindowThreadProcessId.restype = W.DWORD\n\n    def down(self): return bool(self.u.GetAsyncKeyState(0x20) & 0x8000)\n\n    def foreground(self, pid):\n        window = self.u.GetForegroundWindow(); actual = W.DWORD()\n        return bool(window and self.u.GetWindowThreadProcessId(window, C.byref(actual)) and actual.value == pid)\n\n\nclass JumpDriver:\n    """The sole jump writer, used only inside the child interpreter."""\n    def __init__(self, reader, keys, clock=time.monotonic, permitted=lambda: True):\n        self.reader = reader; self.keys = keys; self.clock = clock; self.permitted = permitted\n        self.focused = False; self.armed = False\n        self.owned = False; self.down = False; self.cycle = False; self.active = False\n        self.jump_time = 0.; self.identity = None; self.status = \'waiting\'\n        self.down_count = 0; self.up_count = 0; self.polls = 0\n\n    def verify_jump(self):\n        r = self.reader; m = r.mem; c = r.client\n        if m.read(c + 0x8e5224, 5) != b\'\\xb9\' + struct.pack(\'<I\', c + 0x10b51b0):\n            raise RuntimeError(\'跳跃状态签名不匹配\')\n\n    def verify(self):\n        self.reader.require_feature(\'bhop\')\n        self.verify_jump()\n        r = self.reader; prop = r.client + 0x1cec294\n        if r.mem.string(r.mem.u32(prop), 32) != \'m_fFlags\' or r.mem.u32(prop + 44) != 0x3e8:\n            raise RuntimeError(\'落地标志签名不匹配\')\n\n    def snapshot(self):\n        # Read only the local actor, never a full frame, bones, ESP or weapons.\n        from target_rules import entity_kind\n        r = self.reader; m = r.mem\n        if not m or not m.alive() or m.i32(r.global_addr(\'signon\')) != 6: return None\n        index = m.i32(r.global_addr(\'local_index\')) + 1\n        if not 1 <= index <= 128: return None\n        address = m.u32(r.global_addr(\'local_player\'))\n        if not address: return None\n        slot = r.global_addr(\'entity_entries\') + index * 16\n        entry = m.read(slot, 8)\n        if struct.unpack_from(\'<I\', entry)[0] != address: return None\n        if entity_kind(r.classname(address)) != \'player\': return None\n        vitals = m.read(address + 0x97, 13)\n        health = struct.unpack_from(\'<i\', vitals, 1)[0]; team = struct.unpack_from(\'<i\', vitals, 9)[0]\n        if vitals[0] != 0 or not 0 < health < 100000000 or not 0 <= team < 256: return None\n        flags = m.u32(address + 0x3e8)\n        # Reject a torn observation, including an entity slot reused at one address.\n        if (m.i32(r.global_addr(\'signon\')) != 6 or m.i32(r.global_addr(\'local_index\')) + 1 != index\n                or m.u32(r.global_addr(\'local_player\')) != address or m.read(slot, 8) != entry): return None\n        return (index, address, entry), bool(flags & 1)\n\n    def write(self, down):\n        self.verify_jump()\n        r = self.reader; r.mem.allow_write()\n        # Mark ownership before I/O: a partially successful write needs cleanup.\n        self.owned = True\n        r.mem.write(r.client + 0x10b51b8, struct.pack(\'<I\', 3 if down else 4))\n        self.down = down; self.jump_time = self.clock()\n        if down: self.down_count += 1\n        else: self.up_count += 1\n\n    def release(self):\n        if self.owned:\n            if self.reader.mem and self.reader.mem.alive(): self.write(False)\n            self.owned = False\n        self.down = False; self.cycle = False; self.active = False; self.identity = None\n\n    def tick(self, enabled=True):\n        self.polls += 1\n        space = self.keys.down()\n        foreground = self.keys.foreground(self.reader.mem.pid)\n        if not enabled or not foreground or self.reader.game_ui_visible():\n            self.release(); self.focused = False; self.armed = False; self.status = \'inactive\'; return\n        if not self.focused:\n            self.focused = True; self.armed = not space\n        if not space:\n            self.armed = True; self.release(); self.status = \'ready\'; return\n        if not self.armed:\n            self.status = \'release_space_to_arm\'; return\n        observation = self.snapshot()\n        if observation is None:\n            self.release(); self.status = \'waiting_local\'; return\n        identity, grounded = observation\n        if self.identity is not None and identity != self.identity: self.release()\n        self.identity = identity\n        was_active = self.active; self.active = True; now = self.clock()\n        if not grounded:\n            if self.down or not was_active: self.write(False)\n            self.cycle = False\n        elif not self.cycle or (not self.down and now - self.jump_time >= .09):\n            self.verify()\n            # Re-read Space, foreground and actor after validation, just before DOWN.\n            current = self.snapshot()\n            if (not self.permitted() or not self.keys.down() or not self.keys.foreground(self.reader.mem.pid)\n                    or self.reader.game_ui_visible() or current != (identity, True)):\n                self.release(); return\n            self.write(True); self.cycle = True\n        elif self.down and now - self.jump_time >= .035:\n            self.write(False)\n        self.status = \'jumping\'\n\n\ndef run_loop(driver, signals, lifetime, on_error=lambda ex: None):\n    """No frame age, parent heartbeat, key IPC, queue or parent loop dependency."""\n    release_pending = False\n    try:\n        while lifetime.alive() and not signals.is_set(\'stop\') and driver.reader.mem.alive():\n            try:\n                if release_pending:\n                    driver.release(); release_pending = False\n                driver.tick(signals.is_set(\'enabled\'))\n                delay = .025 if driver.status == \'inactive\' else POLL_SECONDS\n            except Exception as ex:\n                release_pending = True\n                try:\n                    driver.release(); release_pending = False\n                except Exception as cleanup: on_error(cleanup)\n                on_error(ex); delay = .02\n            if signals.wait(delay): break\n    finally:\n        driver.release()\n\n\ndef serve_bhop_worker(game, game_pid, parent_pid, tag):\n    from reader import Reader\n    from presentation import TimerResolution\n    lifetime = signals = reader = driver = None; timer = TimerResolution()\n    last_error = [\'\']\n    def report(ex):\n        message = type(ex).__name__ + \': \' + str(ex)\n        if message != last_error[0]:\n            print(time.strftime(\'%Y-%m-%d %H:%M:%S\'), message, file=sys.stderr, flush=True)\n            last_error[0] = message\n    try:\n        lifetime = Lifetime(parent_pid, game_pid); signals = Signals(tag)\n        reader = Reader(game)\n        while lifetime.alive() and not signals.is_set(\'stop\'):\n            try:\n                reader.attach(int(game_pid))\n                if reader.mem.pid != int(game_pid): raise RuntimeError(\'连跳进程 PID 不匹配\')\n                driver = JumpDriver(reader, Keys(), permitted=lambda:\n                    lifetime.alive() and not signals.is_set(\'stop\') and signals.is_set(\'enabled\'))\n                driver.verify()\n                timer.set_active(True)\n                run_loop(driver, signals, lifetime, report)\n                break\n            except Exception as ex:\n                report(ex)\n                if driver:\n                    try: driver.release()\n                    except Exception as cleanup: report(cleanup)\n                reader.close(); driver = None\n                if signals.wait(.5): break\n    finally:\n        try:\n            if driver: driver.release()\n        finally:\n            try:\n                if reader: reader.close()\n            finally:\n                timer.close()\n                if signals: signals.close()\n                if lifetime: lifetime.close()\n\n\ndef worker_command(game, game_pid, tag):\n    return [sys.executable, \'-X\', \'utf8\', \'-u\', str(BUNDLE_ENTRY), \'--bhop-worker\',\n            str(game), str(int(game_pid)), str(os.getpid()), tag]\n\n\nclass BhopService:\n    """Lifecycle supervision runs outside Worker.run; it never submits input."""\n    def __init__(self, game, game_pid, requested):\n        self.game = str(game); self.game_pid = int(game_pid); self.requested = requested\n        self.stopped = threading.Event(); self.error = \'\'; self.proc = None; self.starts = 0\n        self.thread = threading.Thread(target=self._watch, name=\'bhop-lifecycle\', daemon=True)\n        self.thread.start()\n\n    def _watch(self):\n        signals = None; log = None\n        try:\n            tag = \'Local\\\\CSO2_BHOP_\' + str(os.getpid()) + \'_\' + uuid.uuid4().hex\n            signals = Signals(tag, create=True)\n            log_path = BUNDLE_ENTRY.parent / \'CSO2_BOT_Tool\' / \'bhop_worker.log\'; log_path.parent.mkdir(parents=True, exist_ok=True)\n            log = log_path.open(\'ab\', buffering=0)\n            last = None; next_start = 0.\n            while not self.stopped.is_set():\n                enabled = bool(self.requested())\n                if enabled != last: signals.set(\'enabled\', enabled); last = enabled\n                if self.proc is not None and self.proc.poll() is not None:\n                    code = self.proc.returncode; self.proc = None\n                    if code == 0: break  # Bound game exited; do not attach to a reused PID.\n                    self.error = \'连跳子进程退出，正在重建：\' + str(code); next_start = time.monotonic() + .5\n                if self.proc is None and time.monotonic() >= next_start:\n                    try:\n                        self.proc = subprocess.Popen(worker_command(self.game, self.game_pid, tag),\n                            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=log,\n                            creationflags=subprocess.CREATE_NO_WINDOW)\n                        self.starts += 1; self.error = \'\'\n                    except OSError as ex:\n                        self.error = str(ex); next_start = time.monotonic() + 1.\n                self.stopped.wait(.02)\n        except Exception as ex:\n            self.error = type(ex).__name__ + \': \' + str(ex)\n        finally:\n            if signals: signals.set(\'stop\')\n            try:\n                if self.proc:\n                    try: self.proc.wait(timeout=2.)\n                    except subprocess.TimeoutExpired:\n                        self.error = \'连跳进程未及时退出，强制结束；跳跃释放未经确认\'\n                        self.proc.terminate(); self.proc.wait(timeout=1.)\n            finally:\n                if signals: signals.close()\n                if log: log.close()\n\n    def close(self):\n        self.stopped.set()\n        self.thread.join(timeout=3.5)\n        if self.thread.is_alive(): raise RuntimeError(\'连跳进程尚未完成退出\')\n')
_EMBEDDED['aim_motion_compensation'] = (1, '"""Private aim prediction from timestamped enemy bones and local camera motion.\n\nPredicted points are never damage evidence. Software timestamps do not reveal\nthe age of an engine bone cache or the tick on which a shot is consumed.\n"""\nimport math\nimport uuid\nfrom collections import deque\nfrom geometry import add, sub, length, dot, aim_angles, angle_error, wrap\n\nMAX_HORIZON = .050\nMAX_ANGLE = 4.0\nMAX_SPEED = 1200.0\n\n\ndef vector(value, limit=None):\n    try:\n        v = tuple(float(x) for x in value)\n        if len(v) != 3 or not all(math.isfinite(x) for x in v): return None\n        if limit is not None and length(v) > limit: return None\n        return v\n    except (TypeError, ValueError, OverflowError): return None\n\n\ndef scaled(v, t): return tuple(x*t for x in v)\n\n\ndef sample_stamp(actor):\n    evidence = getattr(actor, \'pose_cache_evidence\', {}) or {}\n    stamp = evidence.get(\'matrix_read_finished\', actor.pose_sample_stamp)\n    return stamp if type(stamp) in (int, float) and math.isfinite(stamp) else 0.\n\n\nclass MotionCompensator:\n    def __init__(self):\n        self.previous = None\n        self.camera = None\n        self.scope = None\n        self.tail = {}\n        self.tail_samples = {}\n        self.last_feedback = None\n        self.sequence = 0\n        self.session = uuid.uuid4().hex\n\n    def predict(self, frame, actor, point, now, path):\n        from runtime_diagnostics import weapon_identity\n        scope = (frame.map_name, frame.source_epoch, frame.local.address,\n                 frame.local.serial, frame.weapon, weapon_identity(frame))\n        if scope != self.scope:\n            self.previous = self.camera = None\n            self.tail.clear();self.tail_samples.clear();self.last_feedback=None; self.scope = scope\n        key = (scope, actor.index, actor.address, actor.serial, actor.model,\n               actor.target_source, point.key, point.part)\n        center = tuple(point.position); eye = tuple(frame.eye)\n        stamp = sample_stamp(actor)\n        eye_stamp = frame.control_provenance.get(\'motion_eye_stamp\', frame.stamp)\n        previous = self.previous if self.previous and self.previous[\'key\'] == key else None\n        camera = self.camera\n        self.sequence += 1\n        out = dict(id=self.session+\':\'+str(self.sequence), active=False,\n            reason=\'no_reliable_motion\', sample_stamp=stamp, eye_stamp=eye_stamp,\n            prepared_stamp=now, original_point=center, original_eye=eye,\n            aim_ray_point=center, predicted_bone=center, predicted_eye=eye,\n            point_id=point.key, part=point.part,\n            bone=actor.head_bone if point.part==\'head\' else None,\n            bone_identity_basis=\'native_head_metadata\' if point.part==\'head\' else \'point_key_only\',\n            target=(actor.index,actor.address,actor.serial), model=actor.model,\n            enemy_native_velocity=vector(actor.velocity,MAX_SPEED),\n            local_native_velocity=vector(frame.local.velocity,MAX_SPEED),\n            enemy_origin=tuple(actor.origin),local_origin=tuple(frame.local.origin),\n            local=(frame.local.index,frame.local.address,frame.local.serial),\n            map=frame.map_name, source_epoch=frame.source_epoch,\n            path=path, weapon_identity=weapon_identity(frame),\n            correction_deg=dict(pitch=0.,yaw=0.,cone=0.), angle_limit_deg=MAX_ANGLE,\n            actual_hit_point=None, actual_hit_bone=None, hit_evidence=\'not_observed\',\n            timing_basis=\'software_sample_to_estimated_primary_input_completion\',\n            engine_pose_age_known=False, engine_shot_tick_known=False)\n        if (not vector(center) or not vector(eye) or type(eye_stamp) not in (int,float)\n                or not math.isfinite(eye_stamp) or not 0 < stamp <= now\n                or not 0 < eye_stamp <= now or now-min(stamp,eye_stamp) > MAX_HORIZON):\n            out[\'reason\']=\'invalid_or_stale_samples\'; self.previous=self.camera=None\n            return center, out\n        current=dict(key=key, stamp=stamp, point=center, origin=tuple(actor.origin))\n        current_camera=dict(stamp=eye_stamp, eye=eye, origin=tuple(frame.local.origin))\n        # Duplicate reads may use current native velocity, but cannot overwrite\n        # the older sample needed to accumulate a measurable pose interval.\n        if not previous or stamp-previous[\'stamp\'] >= .004 or stamp < previous[\'stamp\']:\n            self.previous=current\n        if not camera or eye_stamp-camera[\'stamp\'] >= .004 or eye_stamp < camera[\'stamp\']:\n            self.camera=current_camera\n        enemy=vector(actor.velocity,MAX_SPEED)\n        own=vector(frame.local.velocity,MAX_SPEED)\n        enemy_basis=\'native_origin_velocity\' if enemy is not None else \'unavailable\'\n        own_basis=\'native_local_velocity\' if own is not None else \'unavailable\'\n        dt=stamp-previous[\'stamp\'] if previous else 0.\n        if previous and .004 <= dt <= .12:\n            shift=sub(center,previous[\'point\']); origin_shift=sub(actor.origin,previous[\'origin\'])\n            measured=vector(scaled(shift,1./dt),MAX_SPEED)\n            out.update(previous_bone=previous[\'point\'],previous_stamp=previous[\'stamp\'],\n                       enemy_bone_displacement=shift,enemy_origin_displacement=origin_shift,\n                       observed_bone_velocity=measured,observed_span_ms=dt*1000)\n            if measured is None or length(shift)>64:\n                out[\'reason\']=\'pose_discontinuity\'; return center,out\n            if enemy is None:\n                enemy=measured; enemy_basis=\'observed_bone_delta\'\n            else:\n                # Current native direction wins over an old interval at stops\n                # and reversals. Bone animation residual is only added when\n                # the body interval agrees with that current direction/speed.\n                body=scaled(origin_shift,1./dt)\n                animation=vector(sub(measured,body),160.)\n                trusted,weight=self.animation(animation,previous.get(\'animation\'),body,enemy)\n                current[\'animation\']=animation\n                out[\'enemy_animation_confidence\']=weight\n                if trusted is not None:\n                    enemy=add(enemy,trusted);enemy_basis=\'native_body_plus_confirmed_bone_animation\'\n        cdt=eye_stamp-camera[\'stamp\'] if camera else 0.\n        if camera and .004 <= cdt <= .12:\n            shift=sub(eye,camera[\'eye\']); body_shift=sub(frame.local.origin,camera[\'origin\'])\n            measured=vector(scaled(shift,1./cdt),MAX_SPEED)\n            out.update(previous_eye=camera[\'eye\'],previous_eye_stamp=camera[\'stamp\'],\n                       local_eye_displacement=shift,observed_eye_velocity=measured)\n            if measured is None or length(shift)>64:\n                out[\'reason\']=\'camera_discontinuity\';return center,out\n            if own is None:\n                own=measured;own_basis=\'observed_eye_delta\'\n            else:\n                body=scaled(body_shift,1./cdt)\n                animation=vector(sub(measured,body),160.)\n                trusted,weight=self.animation(animation,camera.get(\'animation\'),body,own)\n                current_camera[\'animation\']=animation\n                out[\'local_animation_confidence\']=weight\n                if trusted is not None:\n                    own=add(own,trusted);own_basis=\'native_local_plus_confirmed_eye_height_delta\'\n        out.update(enemy_velocity=enemy,local_velocity=own,\n                   enemy_velocity_basis=enemy_basis,local_velocity_basis=own_basis)\n        if enemy is None or own is None: return center,out\n        timing_path=path+(\':follow\' if frame.control_provenance.get(\'high_frequency_follow\') else \'\')\n        tail=self.tail.get(timing_path,.006)\n        samples=self.tail_samples.get(timing_path,())\n        out.update(timing_path=timing_path,tail_samples=len(samples),\n                   high_frequency_follow=bool(frame.control_provenance.get(\'high_frequency_follow\')),\n                   tail_estimator=\'quartile_bounded_half_update\',\n                   tail_spread_ms=(max(samples)-min(samples))*1000 if samples else 0.)\n        future=now+tail; eh=future-stamp; lh=future-eye_stamp\n        out.update(predicted_input_stamp=future,estimated_tail_ms=tail*1000,\n                   enemy_horizon_ms=eh*1000,local_horizon_ms=lh*1000)\n        if max(eh,lh)>MAX_HORIZON:\n            out[\'reason\']=\'prediction_horizon_exceeded\';return center,out\n        enemy_delta=scaled(enemy,eh);local_delta=scaled(own,lh)\n        bone=add(center,enemy_delta);future_eye=add(eye,local_delta)\n        # This endpoint expresses the future relative ray from the freshly\n        # measured CURRENT eye. Do not subtract own displacement a second time.\n        proposed=add(eye,sub(bone,future_eye));raw=aim_angles(eye,center)\n        delta=sub(proposed,center);factor=1.\n        if length(sub(proposed,eye))<1 or dot(sub(proposed,eye),sub(center,eye))<=0:\n            out[\'reason\']=\'predicted_target_crosses_eye\';return center,out\n        if angle_error(raw,aim_angles(eye,proposed))>MAX_ANGLE:\n            low,high=0.,1.\n            for _ in range(18):\n                mid=(low+high)*.5\n                if angle_error(raw,aim_angles(eye,add(center,scaled(delta,mid))))<=MAX_ANGLE:low=mid\n                else:high=mid\n            factor=low\n        result=add(center,scaled(delta,factor));angles=aim_angles(eye,result)\n        yaw=math.radians(raw[1]);forward=(math.cos(yaw),math.sin(yaw),0.)\n        right=(math.sin(yaw),-math.cos(yaw),0.)\n        relative=sub(enemy,own)\n        out.update(active=length(sub(result,center))>1e-7,reason=\'predicted_relative_motion\',\n            predicted_bone=bone,predicted_eye=future_eye,aim_ray_point=result,\n            enemy_prediction_displacement=enemy_delta,local_prediction_displacement=local_delta,\n            relative_velocity=relative,\n            relative_axes=dict(right=dot(relative,right),up=relative[2],forward=dot(relative,forward)),\n            original_angles=raw,compensated_angles=angles,\n            correction_deg=dict(pitch=angles[0]-raw[0],yaw=wrap(angles[1]-raw[1]),\n                                cone=angle_error(raw,angles)),\n            limited=factor<1.,applied_fraction=factor)\n        return result,out\n\n    @staticmethod\n    def animation(current, previous, body, native):\n        # Damp a first animation interval; consecutive reversal suppresses\n        # it entirely. Current native stop/reversal stays authoritative.\n        if current is None or length(sub(body,native))>80.:\n            return None,0.\n        if previous is None:return scaled(current,.5),.5\n        a,b=length(current),length(previous)\n        if a<1. or b<1. or dot(current,previous)<.85*a*b or length(sub(current,previous))>40.:\n            return None,0.\n        return scaled(current,.5),.5\n\n    def completed(self, info, now):\n        if not isinstance(info,dict):return\n        prepared=info.get(\'prepared_stamp\');stamp=info.get(\'sample_stamp\')\n        if type(prepared) not in (int,float) or not 0<=now-prepared<=.12:return\n        if info.get(\'id\')==self.last_feedback:return\n        self.last_feedback=info.get(\'id\')\n        path=info.get(\'timing_path\',info.get(\'path\'));old=self.tail.get(path,.006)\n        samples=self.tail_samples.setdefault(path,deque(maxlen=9))\n        ceiling=old+.004\n        if len(samples)>=5:\n            ordered=sorted(samples);q1=ordered[len(ordered)//4];q3=ordered[3*len(ordered)//4]\n            ceiling=max(ceiling,q3+1.5*(q3-q1))\n        samples.append(now-prepared)\n        # Use established timing spread for variable RPC cadence. A stable\n        # short path still bounds isolated stalls to a 2 ms estimate increase.\n        measured=min(now-prepared,ceiling)\n        self.tail[path]=min(.030,max(.001,.5*old+.5*measured))\n        info.update(software_down_stamp=now,actual_tail_ms=(now-prepared)*1000,\n                    actual_sample_to_down_ms=(now-stamp)*1000 if stamp else None,\n                    prediction_timing_error_ms=(now-info[\'predicted_input_stamp\'])*1000\n                        if \'predicted_input_stamp\' in info else None)\n')
_EMBEDDED['aim_motion_log'] = (1, '"""Permanent motion audit, independent of BattleLog\'s rotation and event budget.\n\nOnly bounded immutable snapshots enter the control-thread queue. A private\nwriter process owns JSON encoding and disk writes. IDs survive retries; a\nreader can deduplicate an acknowledged-write retry by (session, sequence).\n"""\nimport collections\nimport copy\nimport datetime\nimport hashlib\nimport json\nimport math\nimport os\nfrom pathlib import Path\nimport subprocess\nimport sys\nimport threading\nimport time\nimport uuid\nfrom log_process import encode_packet, read_packet, write_packet\n\nLABEL=\'敌人运动准星补偿\'\nLIMIT=1024\nHITGROUPS={0:\'generic\',1:\'head\',2:\'chest\',3:\'stomach\',4:\'left_arm\',5:\'right_arm\',6:\'left_leg\',7:\'right_leg\'}\n\n\ndef json_value(value, invalid, path=\'payload\'):\n    if isinstance(value,float) and not math.isfinite(value):\n        invalid.append(path);return None\n    if isinstance(value,dict):return {str(k):json_value(v,invalid,path+\'.\'+str(k)) for k,v in value.items()}\n    if isinstance(value,(tuple,list)):return [json_value(v,invalid,path+\'[\'+str(i)+\']\') for i,v in enumerate(value)]\n    return value\n\n\nclass MotionLog:\n    def __init__(self, role, game_pid, entry=None, folder=None):\n        self.entry=Path(entry or globals()[\'BUNDLE_ENTRY\'])\n        self.session=uuid.uuid4().hex;self.role=role;self.game_pid=int(game_pid)\n        self.folder=Path(folder) if folder else self.entry.parent/\'CSO2_BOT_Tool\'/LABEL\n        self.path=self.folder/(datetime.datetime.now().strftime(\'%Y%m%d_%H%M%S_\')+role+\'_\'+self.session+\'.jsonl\')\n        self.cv=threading.Condition();self.items=collections.deque();self.closed=False\n        self.stop=threading.Event();self.proc=None;self.sequence=0;self.ack=0\n        self.dropped=0;self.restarts=0;self.error=\'\';self.last_fault=\'\';self.pending=False\n        self.last_cycle=None;self.last_state=None;self.sha=None;self.submit_ms=0.\n        self.thread=threading.Thread(target=self._run,name=\'motion-audit-transport\',daemon=True)\n        self.thread.start()\n\n    def metrics(self):\n        return dict(path=str(self.path),session=self.session,role=self.role,\n            writer_pid=getattr(self.proc,\'pid\',None),queued=len(self.items),pending=self.pending,\n            submitted=self.sequence,acknowledged=self.ack,dropped=self.dropped,\n            restarts=self.restarts,error=self.error,last_fault=self.last_fault,\n            last_submit_ms=self.submit_ms,main_log_budget_applied=False)\n\n    def emit(self, kind, payload):\n        began=time.perf_counter()\n        try:\n            with self.cv:\n                self.sequence+=1\n                if self.closed or len(self.items)>=LIMIT:\n                    self.dropped+=1;return False\n                row=dict(schema=\'aim-motion.v1\',session=self.session,sequence=self.sequence,\n                    role=self.role,game_pid=self.game_pid,producer_pid=os.getpid(),kind=kind,\n                    mono=time.monotonic(),unix_ns=time.time_ns(),payload=copy.deepcopy(payload),\n                    dropped_before=self.dropped,restarts=self.restarts)\n                self.items.append(row);self.cv.notify();return True\n        except Exception as ex:\n            self.dropped+=1;self.error=\'motion_snapshot: \'+str(ex);return False\n        finally:self.submit_ms=(time.perf_counter()-began)*1000\n\n    def cycle(self, controller, cycle, state, error):\n        d=controller.diagnostic\n        if cycle!=self.last_cycle:\n            self.last_cycle=cycle\n            motion=d.get(\'motion_compensation\')\n            if motion or d.get(\'hostage_fire_checks\') or d.get(\'hostage_fire_guard\') or d.get(\'ghost_hostage_protection\',{}).get(\'enabled\'):\n                keys=(\'motion_compensation\',\'pose_refresh\',\'aim_latency\',\'aim_write_stamp\',\n                    \'written_angles\',\'readback_angles\',\'actual_sight\',\'actual_ray_endpoint\',\n                    \'fire_snapshot\',\'fire_commit\',\'ammo\',\'weapon\',\'fire_allowed\',\n                    \'aim_point_semantics\',\'fire_down_completed_stamp\',\n                    \'hostage_fire_checks\',\'hostage_fire_guard\',\'input_weapon_guard\',\'ghost_hostage_protection\')\n                self.emit(\'aim_cycle\',dict(cycle=cycle,pressed=controller.pressed,\n                    reason=controller.reason,state=state,error=error,\n                    **{k:d.get(k) for k in keys}))\n        key=(state,error)\n        if key!=self.last_state:\n            self.last_state=key;self.emit(\'worker_state\',dict(state=state,error=error))\n\n    def hurt(self, event, context=None):\n        self.emit(\'actual_damage\',dict(event,hit_part=HITGROUPS.get(event.get(\'hitgroup\'),\'unknown\'),\n            observation_context=context or {},\n            local_attack=event.get(\'attacker_index\')==event.get(\'local_index\')\n                if event.get(\'local_index\') is not None else None,\n            actual_hit_point=None,actual_hit_bone=None,\n            hit_point_reason=\'native_player_hurt_has_hitgroup_but_no_xyz_or_bone_id\',\n            shot_id=None,association=\'unassigned_event; batched delivery is not a unique shot match\'))\n\n    def _run(self):\n        pending=None\n        while not self.stop.is_set():\n            proc=None;watcher=None;retired=threading.Event();waiting=[None]\n            try:\n                if self.closed and not self.items and pending is None:return\n                if self.sha is None:self.sha=hashlib.sha256(self.entry.read_bytes()).hexdigest()\n                options=dict(stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,\n                    close_fds=True,bufsize=0)\n                if os.name==\'nt\':options[\'creationflags\']=subprocess.CREATE_NO_WINDOW\n                proc=subprocess.Popen([sys.executable,\'-X\',\'utf8\',\'-u\',str(self.entry),\n                    \'--motion-log-worker\',str(self.path)],**options)\n                self.proc=proc\n                def watch(child=proc):\n                    while not retired.wait(.2):\n                        if self.stop.is_set() or (waiting[0] is not None and time.monotonic()-waiting[0]>5.):\n                            try:child.kill()\n                            except OSError:pass\n                            return\n                watcher=threading.Thread(target=watch,name=\'motion-audit-watchdog\',daemon=True);watcher.start()\n                while not self.stop.is_set():\n                    with self.cv:\n                        if pending is None and self.items:pending=self.items.popleft()\n                        if pending is None:\n                            if self.closed:break\n                            self.cv.wait(.1)\n                            if proc.poll() is not None:raise OSError(\'motion writer exited\')\n                            continue\n                    self.pending=True\n                    packet=dict(pending,bundle_sha256=self.sha)\n                    waiting[0]=time.monotonic()\n                    write_packet(proc.stdin,encode_packet(packet))\n                    reply=read_packet(proc.stdout)\n                    waiting[0]=None\n                    if reply.get(\'error\'):raise OSError(reply[\'error\'])\n                    if reply.get(\'ack\')!=pending[\'sequence\']:raise ValueError(\'motion writer acknowledgement mismatch\')\n                    self.ack=pending[\'sequence\'];pending=None;self.pending=False;self.error=\'\'\n                proc.stdin.close();proc.wait(timeout=2.)\n                if proc.returncode:raise OSError(\'motion writer exit \'+str(proc.returncode))\n                return\n            except Exception as ex:\n                self.error=self.last_fault=type(ex).__name__+\': \'+str(ex)\n                self.restarts+=1\n            finally:\n                retired.set()\n                if proc:\n                    try:\n                        