_EMBEDDED['static_prop_guard']=(1, '"""Cheap automatic-fire abstention for omitted static prop envelopes.\n\nAn envelope hit is uncertainty, not proof of collision or of a stopped bullet.\nDecoding occurs at map loading; shot checks read only the frozen BVH in memory.\n"""\nimport math,time\nfrom collections import OrderedDict\nfrom pathlib import Path\nfrom types import SimpleNamespace\nfrom geometry import (BVH,box_ray,WallHit,apply_bbox_corrections,unpack_hulls,\n                      load_static_geometry,static_shape_proxies,hull_intervals)\n\n\n\n\nclass StaticPropGuard:\n    def __init__(self,rows,metadata,models=None,materials=None,bbox_instances=None):\n        self.metadata=metadata\n        self._checks=OrderedDict()\n        proxies=[SimpleNamespace(**vars(shape),material=(materials or {}).get(shape.model))\n                 for shape in static_shape_proxies(rows,models,bbox_instances)]\n        self.tree=BVH(proxies) if proxies else None\n        self.instance_count=len(proxies)\n        self.model_names=tuple(sorted({proxy.model for proxy in proxies}))\n        self.hull_instance_count=sum(bool(proxy.hulls) for proxy in proxies)\n        self.unknown_material_count=sum(proxy.material is None for proxy in proxies)\n\n    @classmethod\n    def for_map(cls,map_name):\n        from static_guard_data import THIN_MODEL_MATERIALS\n        from static_prop_materials import WOOD_MODEL_MATERIALS,METAL_MODEL_MATERIALS\n        rows,meta,models,identities,bbox_instances=load_static_geometry(map_name)\n        materials=dict(THIN_MODEL_MATERIALS)\n        for name,identity in identities.items():\n            for sources,code in ((WOOD_MODEL_MATERIALS,87),(METAL_MODEL_MATERIALS,77)):\n                source=sources.get(name)\n                if source is not None:\n                    if source[\'hull_sha256\']!=identity or source[\'material\']!=code:\n                        raise ValueError(\'static material hull identity mismatch\')\n                    materials[name]=code\n        return cls(rows,meta,models,materials,bbox_instances)\n\n    @staticmethod\n    def intersects(proxy,start,delta):\n        if not proxy.hulls:return True\n        q=tuple(a-b for a,b in zip(start,proxy.origin))\n        local=tuple(sum(a*b for a,b in zip(q,axis)) for axis in proxy.axes)\n        direction=tuple(sum(a*b for a,b in zip(delta,axis)) for axis in proxy.axes)\n        for bounds,planes in proxy.hulls:\n            expanded=(tuple(x-.05 for x in bounds[0]),tuple(x+.05 for x in bounds[1]))\n            if not box_ray(expanded,local,direction):continue\n            lower,upper=0.,1.\n            for nx,ny,nz,distance in planes:\n                distance_from=nx*local[0]+ny*local[1]+nz*local[2]-distance\n                rate=nx*direction[0]+ny*direction[1]+nz*direction[2]\n                if abs(rate)<1e-10:\n                    if distance_from>0:break\n                elif rate<0:lower=max(lower,-distance_from/rate)\n                else:upper=min(upper,-distance_from/rate)\n                if lower>upper:break\n            else:\n                if upper>0 and lower<1 and lower<=upper:return True\n        return False\n\n    @staticmethod\n    def intervals(proxy,start,delta):\n        return hull_intervals(proxy,start,delta)\n\n    def check(self,start,end,allow_thin=False):\n        # Frozen map geometry, exact endpoints only. Never reuse across camera\n        # movement or maps; weapon/part budgets are recomputed by the caller.\n        began=time.perf_counter();key=(tuple(start),tuple(end),allow_thin)\n        old=self._checks.get(key)\n        if old is not None:\n            self._checks.move_to_end(key)\n            return dict(old,cache_hit=True,check_ms=(time.perf_counter()-began)*1000)\n        result=self._check(start,end,allow_thin)\n        if result.get(\'state\')!=\'invalid_guard_ray\':\n            self._checks[key]=result\n            while len(self._checks)>128:self._checks.popitem(last=False)\n        return dict(result,cache_hit=False)\n\n    def _check(self,start,end,allow_thin=False):\n        began=time.perf_counter()\n        if len(start)!=3 or len(end)!=3 or not all(math.isfinite(v) for v in (*start,*end)):\n            return dict(allowed=False,state=\'invalid_guard_ray\',check_ms=0.)\n        delta=tuple(b-a for a,b in zip(start,end));hit=None;segments=[]\n        distance=math.sqrt(sum(v*v for v in delta))\n        if self.tree:\n            for proxy in self.tree.candidates(start,delta):\n                if allow_thin and proxy.hulls:\n                    intervals=self.intervals(proxy,start,delta)\n                    if not intervals:continue\n                    # Glass/grate keep their thin-surface policy. Uniform wood\n                    # uses the weapon\'s actual layer/power budget below; a known\n                    # material is not permission to shoot through arbitrary depth.\n                    # A decoded hull with no material is still usable thickness\n                    # evidence; its material is bounded conservatively later.\n                    if any(not 0<a<b<1 or (proxy.material in (71,89) and (b-a)*distance>32.) for a,b in intervals):hit=proxy;break\n                    segments.extend(dict(enter=a,leave=b,material=proxy.material,\n                                         material_state=(\'unknown_bounded\' if proxy.material is None else \'resolved\'),\n                                         prop_id=proxy.identity,model=proxy.model) for a,b in intervals)\n                    continue\n                if self.intersects(proxy,start,delta):hit=proxy;break\n        wood=any(s[\'material\']==87 for s in segments)\n        metal=any(s[\'material\']==77 for s in segments)\n        unknown=any(s.get(\'material\') is None for s in segments)\n        return dict(allowed=hit is None,state=\'static_prop_pending\' if hit else \'unknown_surface_condition\' if unknown else \'metal_surface_condition\' if metal else \'wood_surface_condition\' if wood else \'thin_surface_condition\' if segments else \'no_static_prop_guard_intersection\',\n                    prop_id=hit.identity if hit else None,model=hit.model if hit else None,\n                    method=\'decoded_closed_hulls\' if hit and hit.hulls else hit.bounds_source if hit else None,\n                    thin_segments=[s for s in segments if s[\'material\'] in (71,89)],\n                    surface_segments=segments,material_source=(\'thickness_only_conservative\' if unknown else \'phy_solid_surfaceprop\') if segments else None,\n                    check_ms=(time.perf_counter()-began)*1000,\n                    collision_verified=False,penetration_verified=False,\n                    full_collision_coverage=False,missing_bounds=self.metadata.get(\'skipped\',{}).get(\'missing_bounds\',0))\n\n\ndef apply_fire_guard(path,guard,start,end,weapon,part=\'body\',map_name=\'\',bsp=None,_margin=True):\n    from penetration_results import finalize_verdict\n    # Selection and trigger use the same assessment. Strip the earlier static\n    # pass before recomputing; otherwise an idempotent check doubles its layers.\n    world=path.get(\'world_path\',path)\n    result=dict(world)\n    if not result.get(\'allowed\'):return finalize_verdict(result)\n    evidence=guard.check(start,end,allow_thin=True) if guard is not None else dict(allowed=False,state=\'static_guard_pending\',check_ms=0.)\n    result[\'static_prop_guard\']=evidence\n    if not evidence[\'allowed\']:\n        result.update(allowed=False,guard_reason=evidence[\'state\'],reason=\'静态障碍的材质或有效厚度尚未满足射击条件\')\n    elif evidence.get(\'surface_segments\') or evidence.get(\'thin_segments\'):\n        from ballistics import assess_path\n        from penetration_results import gate_path\n        distance=math.dist(start,end);hits=[];materials={}\n        if distance<=0:return finalize_verdict(dict(result,allowed=False,guard_reason=\'invalid_guard_ray\',reason=\'射线距离无效\'))\n        for i,layer in enumerate(world.get(\'layers\') or []):\n            # Keep original boundaries when combining world and prop budgets;\n            # expanding a mixed merged layer into duplicate solids loses them.\n            sources=layer.get(\'surface_segments\')\n            if sources:\n                for j,source in enumerate(sources):\n                    key=f\'world:{i}:{j}\';materials[key]=source[\'entry_material\'];exit_key=None\n                    if type(source.get(\'exit_material\')) is int:\n                        exit_key=f\'{key}:exit\';materials[exit_key]=source[\'exit_material\']\n                    a,b=source[\'start\'],source[\'end\']\n                    hits.append(WallHit(a/distance,b/distance,b-a,key,source[\'contents\'],exit_texture=exit_key))\n                continue\n            for j,material in enumerate(layer[\'materials\']):\n                if material==\'unknown_material\':\n                    code=None\n                elif not isinstance(material,str) or len(material)!=8 or not material.startswith(\'native_\'):\n                    return finalize_verdict(dict(result,allowed=False,guard_reason=\'static_world_material_pending\',reason=\'静态世界材质未完成绑定\'))\n                else:code=ord(material[-1])\n                key=f\'world:{i}:{j}\';materials[key]=code\n                exit_key=None\n                if code==layer.get(\'entry_material\') and type(layer.get(\'exit_material\')) is int:\n                    exit_key=f\'{key}:exit\';materials[exit_key]=layer[\'exit_material\']\n                hits.append(WallHit(layer[\'start\']/distance,layer[\'end\']/distance,layer[\'thickness\'],key,\n                                    layer.get(\'contents\',1),exit_texture=exit_key))\n        for i,segment in enumerate(evidence.get(\'surface_segments\') or evidence[\'thin_segments\']):\n            key=f\'prop:{i}\';materials[key]=segment.get(\'material\')\n            a,b=segment[\'enter\'],segment[\'leave\']\n            hits.append(WallHit(a,b,(b-a)*distance,key,1,exit_texture=key))\n        estimate=gate_path(assess_path(hits,weapon,distance,part,materials),map_name or guard.metadata.get(\'map\',\'\'))\n        result.update(estimate,static_prop_guard=evidence,world_path=dict(world),\n                      static_prop_material_source=(\'thickness_only_conservative\' if any(\n                          segment.get(\'material\') is None for segment in evidence.get(\'surface_segments\') or evidence[\'thin_segments\'])\n                          else \'phy_solid_surfaceprop\'))\n        if not result.get(\'allowed\'):\n            if result.get(\'guard_reason\') not in (\'material_bound_pending\',\'material_bound_exceeded\',\n                                                   \'penetration_material_missing\'):\n                result[\'guard_reason\']=\'static_surface_budget_rejected\' if evidence.get(\'state\') in (\'wood_surface_condition\',\'metal_surface_condition\') else \'thin_surface_budget_rejected\'\n    elif (result.get(\'kind\')==\'penetration\' and (weapon or {}).get(\'profile_source\')!=\'native_verified\'\n            and not (result.get(\'penetration_validation\')==\'conditional_estimate\'\n                     and result.get(\'weapon_profile_valid\') is True)):\n        result.update(allowed=False,guard_reason=\'weapon_penetration_parameters_pending\')\n    if bsp is not None:\n        from penetration_exit import apply_exit_check\n        result=apply_exit_check(result,bsp,guard,start,end,weapon)\n        if _margin:\n            from penetration_margin import apply_margin_check\n            result=apply_margin_check(result,bsp,guard,start,end,weapon,part,map_name)\n    return finalize_verdict(result)\n\n')
