g,draw_scene\n            for state in (\'visible\',\'penetrable\',\'blocked\'):\n                f,canvas=scene_fixture(20.,state);f.entities[0].health=50\n                scene=draw_scene(canvas,f,Config())\n                self.assertEqual(scene[\'health_bars\'],int(state in (\'visible\',\'penetrable\')))\n                bars=[coords for kind,coords,_ in canvas.commands if kind==\'rectangle\']\n                self.assertEqual(len(bars),2 if state in (\'visible\',\'penetrable\') else 0)\n                if bars:\n                    self.assertAlmostEqual(bars[0][2]-bars[0][0],34.)\n                    self.assertAlmostEqual(bars[1][2]-bars[1][0],17.)\n\n        def test_30m_fast_closing_warning_is_yellow_and_grows_nearer(self):\n            from cso2_bot_tool import Config,draw_scene\n            sizes=[]\n            for distance in (25.,8.):\n                f,canvas=scene_fixture(distance);f.entities[0].velocity=(-250.,0.,0.)\n                scene=draw_scene(canvas,f,Config())\n                triangles=[(coords,opts) for kind,coords,opts in canvas.commands if kind==\'polygon\']\n                self.assertEqual(scene[\'approach_warnings\'],1);self.assertEqual(len(triangles),1)\n                coords,opts=triangles[0];self.assertEqual(opts[\'fill\'],\'#ffd54a\')\n                self.assertEqual(opts[\'outline\'],\'#101820\')\n                sizes.append(max(coords[::2])-min(coords[::2]))\n            self.assertGreater(sizes[1],sizes[0])\n            for distance,velocity in ((30.1,(-250.,0.,0.)),(20.,(0.,0.,0.)),(20.,(250.,0.,0.))):\n                f,canvas=scene_fixture(distance);f.entities[0].velocity=velocity\n                self.assertEqual(draw_scene(canvas,f,Config())[\'approach_warnings\'],0)\n\n        def test_offscreen_40m_warning_requires_enemy_eye_ray_not_body_exposure(self):\n            from cso2_bot_tool import Config,draw_scene\n            for metres,reverse,expected in ((39.,True,1),(40.1,True,0),(39.,False,0)):\n                f,canvas=scene_fixture(metres)\n                e=f.entities[0];delta=(-e.origin[0],metres/.0254,0.)\n                shift=lambda point:tuple(a+b for a,b in zip(point,delta))\n                e.origin=shift(e.origin);e.head=shift(e.head);e.skeleton=[(shift(a),shift(b)) for a,b in e.skeleton]\n                e.esp_reverse_sight=reverse;e.esp_reverse_sight_stamp=f.stamp\n                scene=draw_scene(canvas,f,Config())\n                self.assertEqual(scene[\'off_screen\'],1)\n                self.assertEqual(scene[\'approach_warnings\'],expected)\n                self.assertEqual(scene[\'edge_skeletons\'],expected)\n                triangles=[opts for kind,_,opts in canvas.commands if kind==\'polygon\']\n                if expected:\n                    self.assertEqual({triangles[0][\'fill\'],triangles[0][\'outline\']},{\'#ffd54a\',\'#ff4c61\'})\n\n        def test_coincident_labels_keep_every_element_without_distance_winner_flapping(self):\n            from presentation import layout_distance_labels\n            keys=[(i,100+i,i) for i in range(12)]\n            for tick in range(30):\n                items=[(key,960.,500.,\'20.0 M · 遮挡\',\'#55e28c\',800.+(i if tick%2 else -i)) for i,key in enumerate(keys)]\n                labels=layout_distance_labels(items,1920,1200)\n                self.assertEqual({row[0] for row in labels},set(keys))\n                self.assertEqual(len(labels),len(keys))\n\n    output=io.StringIO();result=unittest.TextTestRunner(stream=output,verbosity=2).run(\n        unittest.defaultTestLoader.loadTestsFromTestCase(Tests))\n    report=dict(passed=result.wasSuccessful(),tests=result.testsRun,failures=len(result.failures),\n        errors=len(result.errors),log=output.getvalue(),actual_serve_replay=True,\n        game_attached=False,game_input=False,live_flicker_verified=False)\n    if raise_on_failure and not report[\'passed\']:raise AssertionError(report[\'log\'])\n    return report\n\n\ndef scene_fixture(metres=20.,state=\'visible\',throwable=False):\n    from esp_skeleton_rules import fixture\n    from cso2_bot_tool import RetainedCanvas\n    f=fixture(state);f.stamp=10.;e=f.entities[0]\n    delta=(metres/.0254-e.origin[0],-e.origin[1],0.)\n    shift=lambda point:tuple(a+b for a,b in zip(point,delta))\n    e.origin=shift(e.origin);e.head=shift(e.head);e.skeleton=[(shift(a),shift(b)) for a,b in e.skeleton]\n    e.grenade=throwable;e.wall_age_ms=0.;e.display_visibility_stamp=f.stamp\n    e.esp_reverse_sight=state==\'visible\';e.esp_reverse_sight_stamp=f.stamp\n    if state==\'penetrable\':e.display_penetration=dict(penetrable=True,age_ms=0.)\n    class Canvas(RetainedCanvas):\n        def __init__(self):self.commands=[]\n        def __getattr__(self,name):raise AttributeError(name)\n        def create(self,kind,coords,options):self.commands.append((kind,coords,options));return len(self.commands)\n        def delete(self,*args):self.commands=[]\n        def winfo_width(self):return 1920\n        def winfo_height(self):return 1200\n        def finish(self):pass\n    return f,Canvas()\n')

_EMBEDDED['esp_output'] = (1, '"""One bounded output writer; a slow controller pipe never stalls drawing."""\nimport json,threading,time\n\n\nclass LatestOutput:\n    def __init__(self,stream,*,coalesce=True):\n        self.stream=stream;self.coalesce=coalesce;self.condition=threading.Condition()\n        self.pending={};self.closed=False;self.error=\'\';self.replaced=0;self.writes=0\n        self.write_ms=0.;self.max_write_ms=0.\n        self.thread=threading.Thread(target=self._run,name=\'ESP-latest-output\',daemon=True)\n        self.thread.start()\n\n    def post(self,event,topic=None):\n        topic=topic or (\'targets\' if \'targets\' in event else \'metrics\' if \'metrics\' in event else \'error\')\n        with self.condition:\n            if self.closed or self.error:return False\n            # Hidden regression runs keep their bounded replay observations.\n            key=topic if self.coalesce else (topic,self.writes+len(self.pending))\n            self.replaced+=int(key in self.pending)\n            self.pending[key]=event;self.condition.notify()\n        return True\n\n    def _run(self):\n        while True:\n            with self.condition:\n                while not self.pending and not self.closed:self.condition.wait()\n                if not self.pending:return\n                key=next(iter(self.pending));event=self.pending.pop(key)\n            started=time.monotonic()\n            try:\n                self.stream.write(json.dumps(event,ensure_ascii=False,separators=(\',\',\':\'))+\'\\n\')\n                self.stream.flush()\n            except (OSError,ValueError) as ex:\n                with self.condition:\n                    self.error=type(ex).__name__+\': \'+str(ex);self.pending.clear();self.closed=True\n                return\n            self.write_ms=(time.monotonic()-started)*1000\n            self.max_write_ms=max(self.max_write_ms,self.write_ms);self.writes+=1\n\n    def snapshot(self):\n        with self.condition:\n            return dict(mode=\'latest_only\',pending=len(self.pending),replaced=self.replaced,\n                writes=self.writes,write_ms=round(self.write_ms,3),max_write_ms=round(self.max_write_ms,3),\n                error=self.error,drawing_waits_for_pipe=False)\n\n    def close(self):\n        with self.condition:self.closed=True;self.condition.notify_all()\n        self.thread.join(timeout=.5)\n')

_EMBEDDED['esp_render_pose'] = (1, '"""Read current rendered actor poses, without replaying a server pose history."""\nimport copy,math,struct,time\nfrom geometry import finite\nfrom esp_pipeline import combat_display_actor,display_alive\nfrom reader import MemoryError\nfrom server_esp import DisplaySampleUnavailable,TABLE\n\n\ndef latch(reader,frame):\n    client=getattr(reader,\'client_reader\',None)\n    if client is None:return frame,dict(state=\'native_sample\',refreshed=0,read_ms=0.)\n    started=time.monotonic();m=client.mem;table=client.global_addr(\'entity_entries\')\n    result=copy.copy(frame);result.entities=[];refreshed=0\n    normalize=lambda value:str(value).replace(\'\\\\\',\'/\').lower().removeprefix(\'models/\')\n    for raw in frame.entities:\n        if not combat_display_actor(raw) or not display_alive(raw) or raw.dormant:\n            result.entities.append(copy.copy(raw));continue\n        try:\n            entry=table+raw.index*16;before=m.read(entry,8)\n            address,serial=struct.unpack(\'<II\',before)\n            if not address or serial&0x3ff!=raw.serial&0x3ff:\n                raise ValueError(\'render actor generation mismatch\')\n            if frame.source==\'client\' and (address,serial)!=(raw.address,raw.serial):\n                raise ValueError(\'render actor identity mismatch\')\n            expected=struct.pack(\'<II\',raw.address,raw.serial)\n            if frame.source==\'server\' and m.read(frame.server_base+TABLE+raw.index*16,8)!=expected:\n                raise ValueError(\'server actor changed before render pose\')\n            # CLIENT absolute origin and bone cache already describe the model\n            # being drawn, including engine interpolation. Do not translate a\n            # newer server rig or replay an old rig against today\'s camera.\n            pose_started=time.monotonic()\n            pose=client.read_entity(raw.index,address,with_bones=bool(raw.skeleton),\n                with_aimpoints=False,with_inventory=False,_pose_retry=False)\n            if (pose is None or pose.team!=raw.team or not finite(pose.origin)\n                    or (raw.model and pose.model and normalize(pose.model)!=normalize(raw.model))):\n                raise ValueError(\'current render actor unavailable\')\n            if raw.skeleton and not pose.dormant and not pose.skeleton:raise ValueError(\'current render rig unavailable\')\n            if m.read(entry,8)!=before:raise ValueError(\'render actor changed during pose read\')\n            if frame.source==\'server\' and m.read(frame.server_base+TABLE+raw.index*16,8)!=expected:\n                raise ValueError(\'server actor changed during render pose\')\n            shown=copy.copy(raw);shown.origin=pose.origin;shown.head=pose.head if not pose.dormant else None\n            shown.dormant=pose.dormant\n            shown.skeleton=list(pose.skeleton) if not pose.dormant else []\n            shown.aim_points=[];shown.aim_points_validated=False\n            shown.pose_bounds=pose.pose_bounds;shown.head_radius=pose.head_radius\n            native_stamp=getattr(pose,\'pose_sample_stamp\',0.)\n            shown.pose_sample_stamp=(native_stamp if type(native_stamp) in (int,float)\n                and math.isfinite(native_stamp) and 0<native_stamp<=time.monotonic() else pose_started)\n            shown.__dict__.pop(\'_display_points\',None)\n            shown.pose_diagnostic=dict(raw.pose_diagnostic,presentation_source=\'current_native_render_pose\',\n                render_pose_read_at=time.monotonic(),history_replayed=False)\n            result.entities.append(shown);refreshed+=1\n        except (MemoryError,ValueError,struct.error) as ex:\n            # Keep the committed surface while a fresh complete pose is being\n            # read. Neither a blank frame nor an old skeleton is republished.\n            raise DisplaySampleUnavailable(f\'ESP current render pose {raw.index}: {ex}\') from ex\n    result.position_stamp=time.monotonic()\n    return result,dict(state=\'current_native_render_pose\',refreshed=refreshed,\n        read_ms=round((result.position_stamp-started)*1000,3),history_replayed=False,\n        authority_source=frame.source,hostage_source_unchanged=True)\n')

_EMBEDDED['esp_legacy_cleanup_contract'] = (1, '"""Current ESP boundary: no retired protocols, weapon assessment or pose replay."""\nimport copy,io,inspect,time,unittest,uuid\nfrom types import SimpleNamespace as NS\nfrom unittest.mock import patch\n\n\ndef run(raise_on_failure=True):\n    from esp_skeleton_rules import fixture\n    from esp_feedback import normalize_obstacle_signal,shared_verdict_packet\n    from esp_targeting import consume,state\n    from overlay_service import apply_wall_bridge,_wall_payload\n    from aim_points import PoseHitbox,ProtectedEntity,hitbox_envelope,hostage_ray_status\n    from server_esp_shared import DisplayESPWriter,DisplayESPReader\n\n    class Tests(unittest.TestCase):\n        def test_retired_runtime_symbols_are_absent(self):\n            for name,symbols in {\n                \'server_esp\':(\'ServerRenderPump\',\'ServerPoseContinuity\',\'ServerPresentationClock\',\'ServerPresentationHistory\'),\n                \'esp_feedback\':(\'_shareable_path\',\'_display_signal\',\'penetration_text\',\'current_profile_token\',\'update_penetration\'),\n                \'esp_targeting\':(\'legacy_packet\',),\n                \'esp_pipeline\':(\'AsyncFrameVisibility\',\'DisplayReader\',\'DisplayContinuity\',\'DisplayHostPositions\'),\n                \'wall_service\':(\'_positive_scene\',\'update_esp_positives\',\'_update_esp_positives\')\n            }.items():\n                for symbol in symbols:\n                    with self.subTest(module=name,symbol=symbol):self.assertFalse(hasattr(__import__(name),symbol))\n\n        def test_old_positive_state_aliases_are_blocked(self):\n            for value in (\'penetration\',\'clear\',\'pending\',\'unknown\',\'invalid\',\'\',None):\n                self.assertEqual(state(value),\'blocked\')\n            self.assertEqual(state(\'visible\'),\'visible\');self.assertEqual(state(\'penetrable\'),\'penetrable\')\n\n        def test_only_positive_packet_is_accepted_and_private_metadata_is_removed(self):\n            value=dict(penetrable=True,stamp=10.,profile_hash=\'obsolete\',kind=\'clear\',allowed=True,\n                       weapon=\'obsolete\',exit_check={\'allowed\':True})\n            out=normalize_obstacle_signal(value,now=10.02)\n            self.assertTrue(out[\'penetrable\']);self.assertEqual(out[\'display_evidence_stamp\'],10.)\n            for key in (\'profile_hash\',\'kind\',\'allowed\',\'weapon\',\'exit_check\'):self.assertNotIn(key,out)\n            for value in (None,[],{\'kind\':\'penetration\',\'allowed\':True}, {\'penetrable\':1},{\'penetrable\':False}):\n                self.assertIsNone(normalize_obstacle_signal(value,now=10.))\n\n        def test_malformed_obstacle_geometry_never_crashes_or_clears_other_actors(self):\n            for field,values in {\'display_ray_eye\':(None,3,[1,2],[\'bad\',2,3],[1,2,float(\'nan\')]),\n                                 \'display_ray_head\':(None,True,[1,2],[\'bad\',2,3],[1,2,float(\'inf\')]),\n                                 \'serial\':(\'bad\',True), \'address\':([],False), \'model\':(None,3)}.items():\n                for value in values:\n                    f=fixture(\'blocked\',count=2);f.stamp=10.\n                    packet=dict(penetrable=True,stamp=10.,**{field:value})\n                    signals={f.entities[0].index:packet,f.entities[1].index:dict(penetrable=True,stamp=10.,\n                        address=f.entities[1].address,serial=f.entities[1].serial,\n                        display_ray_eye=f.eye,display_ray_head=f.entities[1].head)}\n                    scope=dict(pid=7,map=f.map_name,local_identity=[f.local.index,f.local.address,f.local.serial])\n                    with self.subTest(field=field,value=value):\n                        self.assertIsNone(normalize_obstacle_signal(packet,now=10.))\n                        result=apply_wall_bridge(f,signals,scope,7,10.)\n                        self.assertEqual(result[\'applied\'],1)\n                        self.assertEqual(f.entities[0].visibility,\'blocked\')\n                        self.assertEqual(f.entities[1].visibility,\'penetrable\')\n\n        def test_old_list_protocol_is_not_an_esp_input(self):\n            f=fixture(\'blocked\');e=f.entities[0]\n            row=[e.address,e.head,f.eye,\'penetrable\',\'可穿透\',f.stamp,e.model,\n                 [[\'head\',e.head,\'penetrable\',\'可穿透\',True,{\'kind\':\'penetration\',\'allowed\':True}]],e.serial]\n            self.assertEqual(_wall_payload({e.index:row}),{})\n            scope=dict(pid=7,map=f.map_name,local_identity=[f.local.index,f.local.address,f.local.serial])\n            self.assertEqual(apply_wall_bridge(f,{e.index:row},scope,7,f.stamp)[\'applied\'],0)\n\n        def test_current_visible_ray_cannot_be_replaced_by_control_metadata(self):\n            from presentation import DisplayStability\n            f=fixture();e=f.entities[0]\n            e.penetration={\'kind\':\'visible\',\'line_of_sight_verified\':False}\n            self.assertEqual(DisplayStability().visibility(f,e,True,True),\'visible\')\n            e.esp_visible_points=()\n            self.assertEqual(DisplayStability().visibility(f,e,True,True),\'blocked\')\n\n        def test_one_publication_uses_one_export_after_native_submission(self):\n            import esp_targeting,overlay_service\n            f=fixture();f.stamp=10.;e=f.entities[0];e.pose_sample_stamp=10.;e.display_visibility_stamp=10.\n            with patch(\'esp_feedback.shared_verdict_packet\',wraps=shared_verdict_packet) as export:\n                value=esp_targeting.packet(f,copy.deepcopy(f),7,10.)\n            self.assertEqual(export.call_count,1)\n            self.assertEqual(len({tuple(p[\'position\']) for p in value[\'actors\'][0][\'points\']}),23)\n            source=inspect.getsource(overlay_service.serve)\n            self.assertNotIn("output.post({\'targets\':",source)\n            self.assertEqual(source.count("output.post({\'wall_geometry\':shared_geometry_packet("),1)\n            self.assert