or=\'\'):\n    rows=[];legacy=request.get(\'wire_points\',10)==4\n    row_struct=LEGACY_REPLY_ROW if legacy else REPLY_ROW;capacity=4 if legacy else 10\n    for key,origin,eye,stamp,visibility,points in results:\n        if len(points)>10:raise ValueError(\'显示射线结果数量越界\')\n        if len(points)>capacity:raise ValueError(\'ESP legacy reply capacity exceeded\')\n        flat=[v for p in points for v in p]+[0.]*(capacity*3-len(points)*3)\n        rows.append(row_struct.pack(*key[:3],_text(key[3],128),*origin,\n                                   {\'visible\':1,\'penetrable\':2,\'blocked\':3}.get(visibility,3),len(points),*flat))\n    return REPLY.pack(request[\'sequence\'],request[\'stamp\'],*request[\'eye\'],metrics.get(\'rays\',0),\n        metrics.get(\'targets\',0),metrics.get(\'trace_ms\',0.),_text(request[\'map\'],128),\n        error.encode(\'utf-8\')[:255],len(rows))+b\'\'.join(rows)\n\n\ndef decode_reply(data):\n    if len(data)<REPLY.size:raise ValueError(\'ESP 回复不完整\')\n    v=REPLY.unpack_from(data);seq,stamp=v[:2];eye=v[2:5];count=v[10]\n    if not all(math.isfinite(x) for x in (stamp,*eye,v[7])):raise ValueError(\'ESP 回复数值无效\')\n    row_struct=LEGACY_REPLY_ROW if count and len(data)==REPLY.size+count*LEGACY_REPLY_ROW.size else REPLY_ROW\n    if len(data)!=REPLY.size+count*row_struct.size:raise ValueError(\'ESP 回复长度不一致\')\n    results=[]\n    for offset in range(REPLY.size,len(data),row_struct.size):\n        row=row_struct.unpack_from(data,offset)\n        if row[7] not in (1,2,3) or not 1<=row[8]<=(4 if row_struct is LEGACY_REPLY_ROW else 10):raise ValueError(\'ESP 回复采样点越界\')\n        if not all(math.isfinite(x) for x in (*row[4:7],*row[9:9+row[8]*3])):raise ValueError(\'ESP 回复坐标无效\')\n        results.append([[*row[:3],row[3].split(b\'\\0\')[0].decode(\'utf-8\')],row[4:7],eye,stamp,\n                        {1:\'visible\',2:\'penetrable\',3:\'blocked\'}[row[7]],[row[9+i*3:12+i*3] for i in range(row[8])]])\n    return dict(sequence=seq,map=v[8].split(b\'\\0