_EMBEDDED['wall_service'] = (1, '\n"""Run BSP loading and traces outside the ESP/input loop (no UI or input)."""\nimport gzip,hashlib,json,math,queue,subprocess,sys,threading,time\nfrom pathlib import Path\n\nHERE=Path(__file__).resolve().parent\n\n\ndef _wall_publish_index(map_name):\n    """Load the external positive-only wall capability for one map.\n\n    The worker reads this once while loading a map.  It never scans the mount\n    from the frame/control loop and it never turns a missing row into a\n    negative or unknown message for the ESP.\n    """\n    key=Path(str(map_name or \'\').replace(\'\\\\\',\'/\')).stem.lower()\n    try:\n        from collision_cache_io import _index,read_blob\n        mounted=_index() or {}\n        section=mounted.get(\'wall_publish\')\n        if not isinstance(section,dict):\n            return dict(state=\'missing\',map=key,reason=\'wall_publish_index_missing\')\n        schema=section.get(\'schema\')\n        if schema not in (\'cso2.wall-positive-index.v1\',\'cso2.wall-positive-index.v2\'):\n            return dict(state=\'invalid\',map=key,reason=\'wall_publish_schema_mismatch\')\n        item=section.get(\'positive_index\')\n        if not (isinstance(item,(list,tuple)) and len(item)==2):\n            return dict(state=\'invalid\',map=key,reason=\'wall_publish_entry_invalid\')\n        raw=read_blob(str(item[0]),str(item[1]))\n        if len(raw)>32*1024*1024:\n            return dict(state=\'invalid\',map=key,reason=\'wall_publish_index_oversize\')\n        decoded=gzip.decompress(raw)\n        if len(decoded)>128*1024*1024:\n            return dict(state=\'invalid\',map=key,reason=\'wall_publish_index_oversize\')\n        value=json.loads(decoded.decode(\'utf-8\'))\n        if (not isinstance(value,dict) or\n                value.get(\'schema\')!=schema or value.get(\'allowed_states\')!=[\'penetrable\'] or\n                not isinstance(value.get(\'maps\'),dict)):\n            return dict(state=\'invalid\',map=key,reason=\'wall_publish_payload_invalid\')\n        selected=value[\'maps\'].get(key)\n        if not isinstance(selected,dict):\n            return dict(state=\'map_missing\',map=key,reason=\'wall_publish_map_missing\',token=value.get(\'token\'))\n        if schema==\'cso2.wall-positive-index.v2\':\n            sources={name:mounted.get(name,{}).get(key) for name in\n                     (\'world\',\'props\',\'world_meta\',\'props_meta\',\'surface_materials\',\'bbox_corrections\')}\n            identity=hashlib.sha256(json.dumps(sources,sort_keys=True,separators=(\',\',\':\'),\n                                               allow_nan=False).encode(\'utf-8\')).hexdigest()\n            if selected.get(\'geometry_identity\')!=identity:\n                return dict(state=\'invalid\',map=key,reason=\'wall_publish_geometry_mismatch\')\n            weapons=value.get(\'weapons\')\n            if not isinstance(weapons,dict):\n                return dict(state=\'invalid\',map=key,reason=\'wall_publish_weapons_invalid\')\n            selected=dict(selected,weapons=weapons)\n        return dict(state=\'ready\',map=key,token=value.get(\'token\'),data=selected)\n    except (OSError,ValueError,TypeError,KeyError,UnicodeError,\n            gzip.BadGzipFile,json.JSONDecodeError) as ex:\n        return dict(state=\'invalid\',map=key,reason=type(ex).__name__+\': \'+str(ex))\n\n\ndef _wall_publish_weapon_key(weapon):\n    value=(weapon or {}).get(\'weapon\') or (weapon or {}).get(\'profile_name\')\n    try:\n        from weapon_profiles import canonical_weapon_name\n        return canonical_weapon_name(value)\n    except (ImportError,AttributeError,TypeError,ValueError):\n        return str(value or \'\').lower().replace(\'cweapon\',\'\').strip(\'_\')\n\n\ndef _apply_wall_publish(path,bsp,map_name,weapon):\n    """Attach the external positive capability without changing diagnostics.\n\n    The arithmetic path remains private.  A penetration path becomes a public\n    positive only when its exact weapon/profile and every measured material\n    pair are present in the verified offline index.\n    """\n    result=path if isinstance(path,dict) else {}\n    if not getattr(bsp,\'wall_publish_required\',False):\n        return result\n    index=getattr(bsp,\'wall_publish_index\',{})\n    result[\'wall_publish_required\']=True\n    result[\'wall_publish_state\']=index.get(\'state\',\'missing\') if isinstance(index,dict) else \'missing\'\n    result[\'wall_publish_positive\']=False\n    if result.get(\'kind\')!=\'penetration\' or result.get(\'allowed\') is not True:\n        return result\n    map_key=Path(str(map_name or \'\').replace(\'\\\\\',\'/\')).stem.lower()\n    if (not isinstance(index,dict) or index.get(\'state\')!=\'ready\' or\n            index.get(\'map\')!=map_key):\n        result[\'wall_publish_reason\']=\'positive capability not published\'\n        return result\n    data=index.get(\'data\') or {}\n    weapon_key=_wall_publish_weapon_key(weapon)\n    profile_hash=(weapon or {}).get(\'profile_hash\')\n    profile=(data.get(\'weapons\') or {}).get(weapon_key)\n    profile=profile.get(str(profile_hash)) if isinstance(profile,dict) else None\n    pairs=(profile or {}).get(\'pairs\') if isinstance(profile,dict) else None\n    layers=result.get(\'layers\')\n    if not isinstance(pairs,dict) or not isinstance(layers,list) or not layers:\n        result[\'wall_publish_reason\']=\'positive capability pair missing\'\n        return result\n    thickness_only=profile.get(\'thickness_only_max_path\') if isinstance(profile,dict) else None\n    thickness_policy=(profile or {}).get(\'thickness_only_material_bound\') if isinstance(profile,dict) else None\n    initial=profile.get(\'ammo_power\')\n    if initial is not None:\n        if (type(initial) not in (int,float) or not math.isfinite(initial) or initial<=0 or\n                result.get(\'initial_power\')!=initial or\n                result.get(\'native_ammo\')!=profile.get(\'native_ammo\') or\n                result.get(\'weapon_penetration_limit\')!=profile.get(\'penetration_layers\')):\n            result[\'wall_publish_reason\']=\'positive capability weapon parameters mismatch\'\n            return result\n    def source_budget(source):\n        entry=source.get(\'entry_material\');leave=source.get(\'exit_material\')\n        contents=source.get(\'contents\',1)\n        if type(contents) is not int:return None\n        if contents&8:\n            value=profile.get(\'contents8_max_path\')\n            return value*2 if type(value) in (int,float) and entry==leave and entry in (77,87) else value\n        if type(entry) is int and type(leave) is int:return pairs.get(f\'{entry}:{leave}\')\n        if entry is not None and type(entry) is not int:return None\n        if leave is not None and type(leave) is not int:return None\n        if type(entry) is int:return (profile.get(\'entry_min\') or {}).get(str(entry))\n        if type(leave) is int:return (profile.get(\'exit_min\') or {}).get(str(leave))\n        return thickness_only\n    for layer in layers:\n        if not isinstance(layer,dict):\n            result[\'wall_publish_reason\']=\'positive capability layer invalid\'\n            return result\n        entry=layer.get(\'entry_material\');exit_code=layer.get(\'exit_material\')\n        materials=layer.get(\'materials\')\n        if type(entry) is not int and isinstance(materials,list) and len(materials)==1:\n            token=materials[0]\n            if isinstance(token,str) and token.startswith(\'native_\') and len(token)==8:\n                entry=exit_code=ord(token[-1])\n        thickness=layer.get(\'thickness\')\n        unknown_layer=(layer.get(\'material_state\')==\'unknown_bounded\' or\n                       \'unknown_material\' in (layer.get(\'materials\') or []))\n        if unknown_layer:\n            budget=thickness_only\n            if (thickness_policy!=\'native_material_table_lower_bound_v1\' or\n                    type(budget) not in (int,float)):\n                result[\'wall_publish_reason\']=\'thickness-only bound not published\'\n                return result\n        else:\n            if initial is None and (type(entry) is not int or type(exit_code) is not int):\n                result[\'wall_publish_reason\']=\'positive capability material missing\'\n                return result\n            budget=pairs.get(str(entry)+\':\'+str(exit_code))\n        if initial is not None:\n            sources=layer.get(\'surface_segments\')\n            if not isinstance(sources,list) or not sources or any(not isinstance(s,dict) for s in sources):\n                result[\'wall_publish_reason\']=\'positive capability measured sources missing\'\n                return result\n            budgets=[source_budget(source) for source in sources]\n            if any(type(v) not in (int,float) or not math.isfinite(v) or v<=0 for v in budgets):\n                result[\'wall_publish_reason\']=\'positive capability source budget invalid\'\n                return result\n            budget=min(budgets)\n        if (type(budget) not in (int,float) or type(thickness) not in (int,float)\n                or not math.isfinite(float(budget)) or not math.isfinite(float(thickness))\n                or budget<=0 or thickness<=0 or thickness>float(budget)+1e-5):\n            result[\'wall_publish_reason\']=\'positive capability thickness not published\'\n            return result\n    result[\'wall_publish_positive\']=True\n    result[\'_wall_signal_scope\']=dict(map=map_key,weapon=weapon_key,profile_hash=str(profile_hash))\n    result[\'wall_publish_source\']=index.get(\'token\')\n    result[\'wall_publish_reason\']=(\'verified thickness-only conservative positive\'\n                                   if any(layer.get(\'material_state\')==\'unknown_bounded\' or\n                                          \'unknown_material\' in (layer.get(\'materials\') or [])\n                                          for layer in layers)\n                                   else \'verified material/thickness/weapon positive\')\n    return result\n\n\nWALL_SIGNAL_SCHEMA=\'cso2.wall-penetrable.v1\'\nWALL_SIGNAL_KEYS=frozenset((\'schema\',\'kind\',\'allowed\',\'wall_publish_positive\',\n    \'obstacle_assessment_complete\',\'map\',\'weapon\',\'profile_hash\'))\n\ndef _public_wall_path(path):\n    """Strip all private arithmetic, rejections and uncertainty at the boundary."""\n    if not isinstance(path,dict):return None\n    if path.get(\'schema\')==WALL_SIGNAL_SCHEMA:\n        if set(path)!=WALL_SIGNAL_KEYS:return None\n        if (path.get(\'kind\')!=\'penetration\' or path.get(\'allowed\') is not True or\n                path.get(\'wall_publish_positive\') is not True or\n                path.get(\'obstacle_assessment_complete\') is not True or\n                not all(isinstance(path.get(k),str) and path[k] for k in (\'map\',\'weapon\',\'profile_hash\'))):\n            return None\n        return dict(path)\n    if (path.get(\'kind\')!=\'penetration\' or path.get(\'wall_publish_positive\') is not True\n            or not _assessment_finished(path)):\n        return None\n    scope=path.get(\'_wall_signal_scope\') or {}\n    if not all(isinstance(scope.get(k),str) and scope[k] for k in (\'map\',\'weapon\',\'profile_hash\')):\n        return None\n    return dict(schema=WALL_SIGNAL_SCHEMA,kind=\'penetration\',allowed=True,\n        wall_publish_positive=True,obstacle_assessment_complete=True,\n        **{k:scope[k] for k in (\'map\',\'weapon\',\'profile_hash\')})\n\n\ndef _clear_obstacle_caches(bsp):\n    """Drop per-ray exit/margin evidence when a new shot scope begins."""\n    guard=getattr(bsp,\'static_fire_guard\',None)\n    for name in (\'_exit_checks\',\'_margin_checks\'):\n        cache=getattr(guard,name,None) if guard is not None else None\n        if cache is not None:cache.clear()\n\ndef _static_guard_has_verified_geometry(guard):\n    """Return whether the mounted prop guard has usable shape/material evidence."""\n    tree=getattr(guard,\'tree\',None) if guard is not None else None\n    if tree is None:return False\n    stack=[tree];seen=set()\n    while stack:\n        node=stack.pop()\n        if node is None or id(node) in seen:continue\n        seen.add(id(node))\n        items=getattr(node,\'items\',None)\n        if items is not None:\n            for proxy in items:\n                if (getattr(proxy,\'material\',None) is not None\n                        or bool(getattr(proxy,\'hulls\',None))\n                        or getattr(proxy,\'bounds_source\',None)==\'engine_static_bbox\'):\n                    return True\n            continue\n        stack.extend(getattr(node,\'children\',()) or ())\n    return False\n\n\ndef _visibility_from_path(path, fallback=None):\n    """The wall channel has one state; absence is never a visibility verdict."""\n    return \'penetrable\' if _public_wall_path(path) is not None else None\n\n\ndef apply_wall_result(entity,eye,record,now,display=False):\n    """Publish only a verified penetrable point to the ESP channel.\n\n    This function intentionally leaves visibility, aim points, penetration and\n    wall-control fields untouched.  Those belong to the aim/fire pipeline;\n    the wall module owns only the positive ESP marker below.\n    """\n    from geometry import length,sub\n    entity.esp_penetrable=False\n    entity.esp_penetrable_stamp=0.\n    entity.esp_penetrable_point=None\n    for point in getattr(entity,\'aim_points\',()):\n        point.esp_penetrable=False\n        point.esp_penetrable_stamp=0.\n        point.esp_penetrable_signal=None\n        point.esp_penetrable_eye=None\n        point.esp_penetrable_position=None\n    if entity.dormant or len(record)<6 or record[0]!=entity.address:return False\n    if len(record)>6 and record[6]!=entity.model:return False\n    if len(record)>8 and record[8]!=entity.serial:return False\n    stamp=record[5]\n    if not isinstance(stamp,(int,float)) or not math.isfinite(stamp):return False\n    age=(now-stamp)*1000\n    current=0<=age<(240 if display else 60)\n    if not current:return False\n    eye_shift=length(sub(record[2],eye))\n    if eye_shift>(16 if display else 4):return False\n    accepted=False\n    values={p[0]:p for p in record[7]} if len(record)>7 and isinstance(record[7],list) else {}\n    for point in getattr(entity,\'aim_points\',()):\n        value=values.get(point.key)\n        if value is None or len(value)<=5:continue\n        if length(sub(value[1],point.position))>(16. if display else 4.):continue\n        private_path=value[5]\n        public_path=_public_wall_path(private_path)\n        if not (bool(len(value)>4 and value[4]) and isinstance(public_path,dict)):\n            continue\n        point.esp_penetrable=True\n        point.esp_penetrable_stamp=stamp\n        point.esp_penetrable_signal=public_path\n        point.esp_penetrable_eye=tuple(record[2])\n        point.esp_penetrable_position=tuple(value[1])\n        entity.esp_penetrable=True\n        entity.esp_penetrable_stamp=stamp\n        entity.esp_penetrable_point=tuple(value[1])\n        accepted=True\n    return accepted\n\n\ndef display_wall_frame(frame,message,reader,now):\n    """Reuse the current ESP bones for obstacles, including host assist actors.\n\n    This returns a separate obstacle input; it never changes the control frame\n    or treats ESP visibility as a penetration verdict. Native identities and\n    the original geometry timestamps remain attached to each request.\n    """\n    from dataclasses import replace\n    from reader import Entity\n    from aim_points import AimPoint\n    from target_rules import target_is_active,entity_kind\n    from geometry import finite\n    import struct\n    info=dict(status=\'no_current_display_geometry\',input_targets=0,rejected=0)\n    def fresh(stamp):\n        return type(stamp) in (int,float) and math.isfinite(stamp) and 0<=now-stamp<=.060\n    def vector(value):\n        return isinstance(value,(list,tuple)) and len(value)==3 and finite(value)\n    if not isinstance(message,dict):return None,info\n    local=message.get(\'local\');stamp=message.get(\'stamp\');rows=message.get(\'actors\')\n    geometry_owner=((message.get(\'schema\')==\'obstacle.geometry.v1\' and\n                     message.get(\'owner\') in (\'esp_geometry\',\'aim_geometry\')) or\n                    (message.get(\'schema\')==\'esp.targets.v1\' and message.get(\'owner\')==\'esp_render\'))\n    if (not geometry_owner\n            or message.get(\'pid\')!=reader.mem.pid or message.get(\'map\')!=frame.map_name\n            or message.get(\'weapon\')!=frame.weapon or not fresh(stamp)\n            or not isinstance(local,(list,tuple)) or len(local)!=2\n            or local[0]!=frame.local.index or type(local[1]) is not int\n            or local[1]&0x3ff!=frame.local.serial&0x3ff\n            or not vector(message.get(\'eye\')) or not isinstance(rows,list)):\n        return None,info\n    current={e.index:e for e in frame.entities};actors=[];stamps=[stamp];host=None\n    for row in rows:\n        try:\n            index,address,serial,model=row[\'identity\'];source=row[\'source\']\n            if (any(type(v) is not int for v in (index,address,serial)) or not 0<index<32768\n                    or not isinstance(model,str) or not model or not fresh(row[\'geometry_stamp\'])\n                    or not vector(row[\'origin\']) or not entity_kind(row[\'classname\'])):raise ValueError(\'actor\')\n            if source==\'server_assist\':source=\'server\'\n            if source==\'client\':\n                actor=current.get(index)\n                if (actor is None or not target_is_active(actor) or not actor.enemy\n                        or (address,serial,model, row[\'team\'])!=(actor.address,actor.serial,actor.model,actor.team)):\n                    raise ValueError(\'client_identity\')\n                entry=reader.global_addr(\'entity_entries\')+index*16\n            elif source==\'server\':\n                from runtime_compat import native_loopback\n                from server_esp import TABLE\n                if host is None:host=native_loopback(reader) is True\n                if not host:raise ValueError(\'not_host\')\n                entry=reader.mods[\'server.dll\'][0]+TABLE+index*16\n            else:raise ValueError(\'source\')\n            pointer,native_serial=struct.unpack(\'<II\',reader.mem.read(entry,8))\n            if pointer!=address or (native_serial!=serial if source==\'client\' else native_serial&0x3ff!=serial&0x3ff):\n                raise ValueError(\'native_identity\')\n            points=[]\n            for p in row[\'points\']:\n                if (not vector(p[\'position\']) or not isinstance(p[\'key\'],str)\n                        or p[\'part\'] not in (\'head\',\'torso\',\'pelvis\',\'body\',\'arm\',\'leg\',\'eye\')\n                        or type(p[\'radius\']) not in (int,float) or not math.isfinite(p[\'radius\']) or p[\'radius\']<=0\n                        or type(p[\'priority\']) is not int):continue\n                points.append(AimPoint(p[\'key\'],p[\'part\'],tuple(p[\'position\']),p[\'radius\'],p[\'priority\']))\n            if not points:raise ValueError(\'no_points\')\n            actor=Entity(index,address,row[\'classname\'],row[\'team\'],row[\'health\'],tuple(row[\'origin\']),\n                enemy=True,serial=serial,model=model,head=points[0].position,head_source=row[\'head_source\'],\n                aim_points=points,aim_points_validated=True,reported_alive=row[\'reported_alive\'],\n                ragdoll_present=row[\'ragdoll_present\'],pose_confirmed=row[\'pose_confirmed\'],pose_sample_stamp=row[\'geometry_stamp\'])\n            if not target_is_active(actor):raise ValueError(\'dead\')\n            actors.append(actor);stamps.append(row[\'geometry_stamp\'])\n        except (KeyError,TypeError,ValueError,AttributeError,OSError,RuntimeError,OverflowError,struct.error):\n            info[\'rejected\']+=1\n    info.update(status=\'current_display_geometry\',input_targets=len(actors),geometry_age_ms=(now-min(stamps))*1000)\n    # The camera belongs to this display publication. Each actor keeps its\n    # own geometry stamp; one older actor must not age every positive result.\n    return replace(frame,stamp=stamp,eye=tuple(message[\'eye\']),entities=actors),info\n\n\nclass WallService:\n    def __init__(self,game,map_name,manual=None):\n        self.events=queue.Queue();self.requests=queue.Queue(maxsize=1)\n        self.busy=True;self.closed=False;self.proc=None\n        self.fast_bsp=None;self.map_args=(game,map_name,manual);self.fast_loading=False\n        self.fast_cursor=0;self.failures=0;self.next_retry=0.;self.pending_since=0.;self.ready=False\n        self.last_submit_status=\'not_submitted\';self.submit_dropped=0\n        self.last_submit_targets=0\n        self.latest_pending=None;self.pending_replaced=0;self.pending_expired=0\n        self.signal_route=None;self.signal_delivery_error=\'\';self.signal_delivery_status=\'waiting\'\n        self._start(time.monotonic())\n    def _start(self,now):\n        game,map_name,manual=self.map_args\n        self.events=queue.Queue();self.requests=queue.Queue(maxsize=1)\n        self.busy=True;self.ready=False;self.pending_since=now\n        self.latest_pending=None\n        try:\n            self.proc=subprocess.Popen([sys.executable,\'-X\',\'utf8\',\'-u\',str(BUNDLE_ENTRY),\'--wall-worker\',str(game),str(map_name),str(manual or \'\')],\n                stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,text=True,encoding=\'utf-8\',creationflags=subprocess.CREATE_NO_WINDOW)\n            threading.Thread(target=self._read,args=(self.proc,self.events),daemon=True).start()\n            threading.Thread(target=self._write,args=(self.proc,self.requests,self.events),daemon=True).start()\n        except (OSError,ValueError) as ex:\n            self._retire();self._retry(now)\n            self.events.put({\'error\':\'墙体进程启动失败，稍后重试：\'+str(ex)})\n    def _retry(self,now):\n        self.failures=min(self.failures+1,6)\n        self.next_retry=now+min(30.,2.**(self.failures-1))\n    def _read(self,proc,events):\n        try:\n            for line in proc.stdout:\n                received_at=time.monotonic()\n                event=json.loads(line)\n                if not isinstance(event,dict):raise ValueError(\'墙体响应格式无效\')\n                route=self.signal_route\n                if (route is not None and self.proc is proc and not self.closed\n                        and \'results\' in event and event.get(\'scope\')==route[0]):\n                    try:\n                        context=dict(route[1],result_received_at=received_at,\n                                     result_finished_at=event.get(\'finished_at\'),\n                                     result_started_at=event.get(\'started_at\'),\n                                     assessed=event.get(\'assessed\',[]))\n                        accepted=route[2](esp_positive_records({i:record for i,*record in event[\'results\']}),context)\n                        self.signal_delivery_status=\'accepted\' if accepted else \'rejected_by_overlay\'\n                        self.signal_delivery_error=\'\' if accepted else \'overlay_scope_or_config\'\n                    except Exception as ex:\n                        self.signal_delivery_status=\'error\'\n                        self.signal_delivery_error=type(ex).__name__+\': \'+str(ex)\n                # Partial positives already reached ESP. They must not mark the\n                # worker idle or dispatch another batch before this one ends.\n                if not event.get(\'partial\'):events.put(event)\n        except (OSError,ValueError) as ex:events.put({\'error\':str(ex),\'failed\':True})\n        finally:events.put({\'error\':\'墙体计算进程已退出\',\'failed\':True})\n    def _write(self,proc,requests,events):\n        try:\n            while not self.closed and proc.poll() is None:\n                try:body=requests.get(timeout=.1)\n                except queue.Empty:continue\n                if body is None:return\n                proc.stdin.write(json.dumps(body)+\'\\n\');proc.stdin.flush()\n        except (OSError,ValueError) as ex:events.put({\'error\':\'墙体请求发送失败：\'+str(ex),\'failed\':True})\n    @staticmethod\n    def _dispose(proc):\n        # Reap/close outside the input loop: a pipe writer may still hold its\n        # stream lock until the child has actually exited.\n        exited=False\n        try:\n            try:proc.wait(timeout=1);exited=True\n            except subprocess.TimeoutExpired:\n                proc.kill();proc.wait(timeout=1);exited=True\n        except OSError:exited=proc.poll() is not None\n        except subprocess.TimeoutExpired:pass\n        if exited:\n            for stream in (proc.stdin,proc.stdout):\n                if stream:\n                    try:stream.close()\n                    except (OSError,ValueError):pass\n    def _retire(self):\n        proc=self.proc;self.proc=None;self.busy=True;self.ready=False\n        self.latest_pending=None\n        self.fast_bsp=None;self.fast_records={}\n        try:self.requests.put_nowait(None)\n        except queue.Full:pass\n        if proc:\n            try:\n                if proc.poll() is None:proc.terminate()\n            except OSError:pass\n            threading.Thread(target=self._dispose,args=(proc,),daemon=True).start()\n    def poll(self,frame=None,weapon=None):\n        if self.closed:return []\n        now=time.monotonic();result=[];failed=False\n        for _ in range(64):\n            try:event=self.events.get_nowait()\n            except queue.Empty:break\n            result.append(event);failed=failed or event.get(\'failed\',False)\n            if event.get(\'ready\'):\n                self.ready=True;self.busy=False\n                if self.fast_bsp is None and not self.fast_loading:\n                    self.fast_loading=True;threading.Thread(target=self._load_scene,daemon=True).start()\n            if \'results\' in event:\n                self.busy=False;self.failures=0\n        if self.proc is not None:\n            expired=self.busy and now-self.pending_since>(2. if self.ready else 20.)\n            if failed or self.proc.poll() is not None or expired:\n                self._retire();self._retry(now)\n                result=[e for e in result if \'results\' not in e]\n                result.append({\'error\':\'墙体计算超时或退出，将自动重试\'})\n        if self.proc is None and now>=self.next_retry:self._start(now)\n        pending=getattr(self,\'latest_pending\',None)\n        scope=wall_scope(frame,weapon) if frame is not None else None\n        if scope is not None:result=[e for e in result if \'results\' not in e or e.get(\'scope\')==scope]\n        if pending is not None and self.ready and not self.busy:\n            self.latest_pending=None\n            if 0<=now-pending[\'stamp\']<=.060 and (scope is None or pending.get(\'scope\')==scope):self._dispatch(pending)\n            else:self.pending_expired+=1\n        return result\n    def _load_scene(self):\n        try:\n            scene=load_map(*self.map_args)\n            if not self.closed:self.fast_bsp=scene\n        except Exception as ex:self.events.put({\'error\':\'障碍物场景载入失败：\'+str(ex)})\n        finally:self.fast_loading=False\n\n    def submit(self,eye,entities,weapon,frame=None,with_dodge=True):\n        if self.closed:\n            self.last_submit_status=\'closed\';self.last_submit_targets=0;self.submit_dropped+=1;return False\n        if self.proc is None or self.proc.poll() is not None:\n            self.last_submit_status=\'worker_unavailable\';self.last_submit_targets=0;self.submit_dropped+=1;return False\n        from aim_points import candidate_points\n        stamp=frame.stamp if frame is not None else time.monotonic();rows=[]\n        for e in entities:\n            points=[[p.key,p.position,p.part,p.priority,p.radius] for p in 