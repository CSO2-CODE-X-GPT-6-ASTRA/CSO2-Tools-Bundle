--------\n# Current distance rules. The previous near-warning rule has been removed.\n# ---------------------------------------------------------------------------\nMETERS_PER_UNIT=.0254\nAPPROACH_WARNING_RANGE=40./METERS_PER_UNIT\nAPPROACH_WARNING_YELLOW=\'#ffd54a\'\n\n# ---------------------------------------------------------------------------\n# Distance-only markers. Source map units are inches (1 unit = 0.0254 m).\n# ---------------------------------------------------------------------------\ndef distance_label(distance):\n    return f\'{max(0.,distance)*METERS_PER_UNIT:.1f} M\'\n\n\ndef distance_font_size(distance):\n    """Discrete cached sizes: 15 pt at <=5 m, tapering to 9 pt at 50 m."""\n    if not isinstance(distance,(int,float)) or not math.isfinite(distance):return 9\n    metres=max(0.,distance)*METERS_PER_UNIT\n    return round(15.-6.*max(0.,min(1.,(metres-5.)/45.)))\n\n\ndef distance_label_extent(label,size):\n    # Conservative fallback for Tk/GDI; GDI+ supplies measured glyph bounds.\n    pixels=size*96./72.\n    return max(8.,len(label)*pixels*.8+6.),pixels*1.5+6.\n\n\ndef layout_distance_labels(items,width,height,measure=None):\n    """Keep every label; try nearby positions before permitting overlap."""\n    placed=[];result=[];measure=measure or distance_label_extent\n    def priority(row):\n        # Motion must not swap which coincident actor receives its label.\n        return (0 if \'C4\' in row[3].split() else 1,row[0])\n    for row in sorted(items,key=priority):\n        key,x,y,label,color=row[:5]\n        if not math.isfinite(x+y) or width<8 or height<8:continue\n        size=distance_font_size(row[5]) if len(row)>5 else 11\n        chosen=None;fallback=None\n        for font_size in range(size,max(9,size-2)-1,-1):\n            tw,th=measure(label,font_size);hw,hh=tw*.5+2.,th*.5+2.\n            if tw+4>width or th+4>height:continue\n            fallback=(max(hw,min(width-hw,x)),max(hh,min(height-hh,y)),hw,hh,font_size)\n            for d