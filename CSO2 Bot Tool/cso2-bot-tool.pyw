_ghost_hull_clear(bsp,start,end):\n    """Sweep a standing 32x32 footprint through static world brush planes."""\n    mins=(-16.,-16.,2.);maxs=(16.,16.,70.)\n    low=tuple(min(start[i],end[i])+mins[i] for i in range(3))\n    high=tuple(max(start[i],end[i])+maxs[i] for i in range(3))\n    nodes=[bsp.tree];delta=sub(end,start)\n    while nodes:\n        node=nodes.pop()\n        if any(high[i]<node.bounds[0][i] or low[i]>node.bounds[1][i] for i in range(3)):continue\n        if node.items is None:nodes.extend(node.children);continue\n        for brush in node.items:\n            if any(high[i]<brush.bounds[0][i] or low[i]>brush.bounds[1][i] for i in range(3)):continue\n            enter,leave=0.,1.;skip=False\n            for normal,plane,_ in brush.planes:\n                expanded=plane-sum(normal[i]*(mins[i] if normal[i]>=0 else maxs[i]) for i in range(3))\n                distance=dot(normal,start)-expanded;den=dot(normal,delta)\n                if abs(den)<1e-10:\n                    if distance>0:skip=True;break\n                else:\n                    fraction=-distance/den\n                    if den<0:enter=max(enter,fraction)\n                    else:leave=min(leave,fraction)\n                    if enter>leave:skip=True;break\n            if not skip and leave>max(enter,0.) and leave>0. and enter<1.:return False\n    return True\n\n\ndef _ghost_walk_route(bsp,start,end):\n    """Check the whole route, floor support, and bounded 18-unit steps."""\n    distance=math.hypot(end[0]-start[0],end[1]-start[1]);steps=max(1,math.ceil(distance/12.))\n    current=tuple(start)\n    for i in range(1,steps+1):\n        x=start[0]+(end[0]-start[0])*i/steps;y=start[1]+(end[1]-start[1])*i/steps\n        heights=[]\n        for ox,oy in ((0.,0.),(-16.,-16.),(-16.,16.),(16.,-16.),(16.,16.)):\n            top=(x+ox,y+oy,current[2]+18.01);bottom=(x+ox,y+oy,current[2]-18.01)\n            hits=bsp.trace(top,bottom)\n            if not hits or hits[0].normal[2]<=.65:return None