ey:False;f.control.service_fire_release(f.reader,f.frame)\n                self.assertEqual(f.native_writes[-1],(0x90000,4))\n\n        def test_render_pose_latch_retains_native_pose_sample_time(self):\n            from esp_render_pose import latch\n            f=native_fixture();raw=copy.deepcopy(f.frame);raw.entities[0].skeleton=[(raw.entities[0].head,(150.,0.,44.))]\n            current=copy.deepcopy(raw.entities[0]);current.pose_sample_stamp=9.99\n            current.head=(150.,8.,64.);current.skeleton=[(current.head,(150.,8.,44.))]\n            r=NS(client_reader=NS(mem=NS(read=lambda a,n:struct.pack(\'<II\',current.address,current.serial)),\n                 global_addr=lambda key:0x88000,read_entity=lambda *a,**kw:current))\n            value,info=latch(r,raw)\n            self.assertEqual(value.entities[0].pose_sample_stamp,9.99)\n            self.assertEqual(value.entities[0].head,current.head)\n            self.assertEqual(raw.entities[0].head,f.frame.entities[0].head)\n            current.pose_sample_stamp=0.;raw.stamp=9.7\n            with patch(\'esp_render_pose.time.monotonic\',return_value=10.):\n                value,info=latch(r,raw)\n            self.assertEqual(value.entities[0].pose_sample_stamp,10.)\n            self.assertEqual(raw.stamp,9.7)\n\n        def test_locked_native_readback_to_primary_down_excludes_esp_scan_time(self):\n            f=native_fixture();shown=rendered(f,stamp=10.)\n            for name in (\'read\',\'vec\',\'u32\',\'i32\'):\n                original=getattr(f.reader.mem,name)\n                def cost(*args,_fn=original):f.now[0]+=.0001;return _fn(*args)\n                setattr(f.reader.mem,name,cost)\n            f.frame.stamp=10.;f.frame.weapon_state[\'stamp\']=10.\n            d,value=submit(f,shown,t=10.04)\n            self.assertTrue(f.control.pressed,d)\n            self.assertGreater(d[\'lock_to_fire_ms\'],0.)\n            self.assertAlmostEqual(d[\'lock_to_fire_ms\'],(d[\'fire_down_completed_stamp\']-d[\'aim_l