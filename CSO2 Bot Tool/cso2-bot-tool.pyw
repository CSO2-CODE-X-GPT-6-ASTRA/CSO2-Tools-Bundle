_EMBEDDED['high_threat_contract'] = (1, '"""Deterministic high-threat actor/aim/cadence contracts; no game connection."""\nimport io\nimport math\nimport unittest\nfrom dataclasses import dataclass, field, replace\nfrom types import SimpleNamespace as NS\nfrom aim_points import AimPoint, select_aim_view\nfrom high_threat_models import (is_high_threat_model, high_threat_kind,\n    normalize_model_name, native_anchor, high_threat_cadence)\n\n\nMODELS = (\'player\\\\tr_ysht\\\\tr_ysht.mdl\',\n          \'player/tr_Qipao01/tr_Qipao01.mdl\', \'player/tr_san/tr_san.mdl\')\n\n\n@dataclass\nclass Actor:\n    model: str = MODELS[0]\n    health: int = 100\n    dormant: bool = False\n    ragdoll_present: bool = False\n    reported_alive: bool = True\n    pose_confirmed: bool = False\n    head: tuple | None = (100., 0., 64.)\n    head_radius: float = 3.\n    head_source: str = \'server_native_hitbox\'\n    pose_bounds: tuple | None = None\n    aim_points: list = field(default_factory=list)\n    aim_points_validated: bool = True\n    aim_id: str = \'head\'\n    aim_part: str = \'head\'\n    visibility: str = \'visible\'\n    wall_text: str = \'\'\n    wall_age_ms: float | None = 0.\n    wall_head_shift: float | None = 0.\n    wall_eye_shift: float | None = 0.\n    wall_penetrable: bool = False\n    penetration: dict = field(default_factory=lambda: dict(kind=\'visible\', allowed=True))\n    aim_guard_reason: str = \'\'\n\n\ndef actor(model=MODELS[0]):\n    e = Actor(model=model)\n    e.aim_points = [AimPoint(\'head\',\'head\',(100.,0.,64.),3.,0,visibility=\'visible\'),\n        AimPoint(\'torso\',\'torso\',(100.,0.,44.),12.,10,visibility=\'visible\'),\n        AimPoint(\'pelvis\',\'pelvis\',(100.,0.,30.),8.,20,visibility=\'visible\')]\n    return e\n\n\ndef base(**kw):\n    p = dict(cycle=.1,interval=.3,controlled=True,continuous=False,\n        burst_limit=1,weapon_type=\'rifle\',automatic=True,target_health=100,\n        stance=\'stand\',target_angular_radius=.1,direct=True,eligible_geometry=True)\n    p.update(kw)\n    return p\n\n\ndef rate(p=None,model=MODELS[0],**kw):\n    args = dict(aim_part=\'torso\',validated=True,alignment_error=0.)\n    args.update(kw)\n    return high_threat_cadence(base() if p is None else p,model,**args)\n\n\ndef run():\n    class Tests(unittest.TestCase):\n        def setUp(self):\n            self.frame=NS(eye=(0.,0.,64.),mode=\'\',protected=[],stamp=10.)\n        def test_installed_header_names_all_classified(self):\n            for model,kind in zip(MODELS,(\'hutao\',\'qipao\',\'tr_san\')):\n                self.assertTrue(is_high_threat_model(model))\n                self.assertEqual(high_threat_kind(model),kind)\n        def test_normalization(self):\n            self.assertEqual(normalize_model_name(\' Models\\\\PLAYER\\\\TR_SAN\\\\TR_SAN.MDL \'),\n                             \'models/player/tr_san/tr_san.mdl\')\n            self.assertTrue(is_high_threat_model(\'Models\\\\PLAYER\\\\TR_SAN\\\\TR_SAN.MDL\'))\n        def test_no_substring_or_hand_matches(self):\n            for model in (\'tr_santa.mdl\',\'tr_san_extra.mdl\',\'not_tr_san.mdl\',\n                \'models/player/tr_san/hand/hand_san.mdl\',\'models/props/tr_san.mdl\',\n                \'models/player/tr_ysht/hand/tr_ysht.mdl\',\'models/player/tr_san/other.mdl\',None):\n                self.assertFalse(is_high_threat_model(model),model)\n        def test_hittable_head_priority_for_each_model_even_server_provenance(self):\n            for model in MODELS:\n                e=actor(model);t=select_aim_view(self.frame,e,{},10.)\n                self.assertEqual(t.aim_part,\'head\')\n                self.assertEqual(e.head,(100.,0.,64.))\n        def test_blocked_head_uses_exposed_body_for_each_model(self):\n            for model in MODELS:\n                e=actor(model)\n                e.aim_points[0].visibility=\'blocked\'\n                e.aim_points[0].penetration=dict(kind=\'blocked\',allowed=False)\n                self.assertEqual(select_aim_view(self.frame,e,{},10.).aim_part,\'torso\')\n        def test_exposed_body_beats_penetrable_head(self):\n            e=actor();p=e.aim_points[0]\n            p.visibility=\'penetrable\';p.penetrable=True\n            p.penetration=dict(kind=\'penetration\',allowed=True)\n            self.assertEqual(select_aim_view(self.frame,e,{},10.,allow_penetration=True).aim_part,\'torso\')\n        def test_penetrable_head_priority_in_same_wall_lane(self):\n            e=actor()\n            for p in e.aim_points:\n                p.visibility=\'penetrable\';p.penetrable=True\n                p.penetration=dict(kind=\'penetration\',allowed=True)\n            self.assertEqual(select_aim_view(self.frame,e,{},10.,allow_penetration=True).aim_part,\'head\')\n        def test_no_head_uses_only_existing_body_samples(self):\n            e=actor();e.head=None;e.aim_points=e.aim_points[1:]\n            t=select_aim_view(self.frame,e,{},10.)\n            self.assertEqual(t.head,e.aim_points[0].position)\n            self.assertEqual(t.aim_part,\'torso\');self.assertIsNone(e.head)\n        def test_no_head_no_points_creates_no_firing_point(self):\n            e=actor();e.head=None;e.aim_points=[]\n            self.assertIsNone(select_aim_view(self.frame,e,{},10.))\n        def test_unknown_normal_actor_still_prefers_head(self):\n            self.assertEqual(select_aim_view(self.frame,actor(\'ct_st6.mdl\'),{},10.).aim_part,\'head\')\n        def test_visible_anatomical_head_replaces_covered_body(self):\n            e=actor()\n            for p in e.aim_points[1:]:\n                p.visibility=\'blocked\';p.penetration=dict(kind=\'blocked\',allowed=False)\n            self.assertEqual(select_aim_view(self.frame,e,{},10.).aim_part,\'head\')\n        def test_experimental_fallback_keeps_existing_native_head(self):\n            from experimental_aim import _fallback_view\n            e=actor();e.aim_points=e.aim_points[:1]\n            self.assertEqual(_fallback_view(self.frame,e,{},10.,\'\',False,False).aim_part,\'head\')\n            self.assertEqual(select_aim_view(self.frame,e,{},10.).aim_part,\'head\')\n        def test_largest_valid_native_sample_not_fixed_torso(self):\n            e=actor();e.aim_points.append(AimPoint(\'prop\',\'body\',(100.,0.,50.),30.,20,visibility=\'visible\'))\n            e.aim_points[0].visibility=\'blocked\'\n            e.aim_points[0].penetration=dict(kind=\'blocked\',allowed=False)\n            self.assertEqual(select_aim_view(self.frame,e,{},10.).aim_part,\'body\')\n        def test_dead_ragdoll_or_dormant_no_target(self):\n            for kw in (dict(health=0),dict(dormant=True),dict(health=1,ragdoll_present=True)):\n                self.assertIsNone(select_aim_view(self.frame,replace(actor(),**kw),{},10.))\n        def test_outside_pose_bounds_not_selected(self):\n            e=actor();e.aim_points_validated=False;e.pose_bounds=((90.,-10.,0.),(110.,10.,80.))\n            e.aim_points[1].position=(200.,0.,44.)\n            self.assertNotEqual(select_aim_view(self.frame,e,{},10.).aim_id,\'torso\')\n        def test_native_anchor_accepts_head_rejects_nan_and_zero_radius(self):\n            e=actor();self.assertEqual(native_anchor(e.aim_points).part,\'torso\')\n            self.assertEqual(native_anchor([e.aim_points[0],\n                AimPoint(\'bad\',\'torso\',(float(\'nan\'),0.,44.),10.,10),\n                AimPoint(\'zero\',\'body\',(100.,0.,44.),0.,10)]).part,\'head\')\n        def test_all_models_native_cycle(self):\n            for model in MODELS:\n                q=rate(model=model);self.assertTrue(q[\'high_threat_active\'])\n                self.assertEqual(q[\'interval\'],q[\'cycle\']);self.assertFalse(q[\'continuous\'])\n        def test_category_never_fabricates_high_hp(self):\n            for hp in (1,20,100,100000):\n                q=rate(base(target_health=hp));self.assertEqual(q[\'target_health\'],hp)\n        def test_unknown_model_policy_unchanged(self):\n            q=rate(model=\'ct_st6.mdl\');self.assertFalse(q[\'high_threat\']);self.assertEqual(q[\'interval\'],.3)\n        def test_cover_air_missing_hp_missing_identity_no_boost(self):\n            for kw in (dict(direct=False),dict(stance=\'air\'),dict(target_health=None),\n                       dict(target_health=0),dict(eligible_geometry=False),dict(cycle=0)):\n                q=rate(base(**kw));self.assertFalse(q[\'high_threat_active\']);self.assertEqual(q[\'interval\'],.3)\n        def test_unvalidated_wrong_part_and_error_no_boost(self):\n            for kw in (dict(validated=False),dict(aim_part=\'cosmetic\'),\n                       dict(alignment_error=20),dict(alignment_error=-1),dict(alignment_error=float(\'nan\'))):\n                self.assertFalse(rate(**kw)[\'high_threat_active\'])\n        def test_weapon_cycle_never_accelerated(self):\n            for cycle in (.03,.1,.19,.5,1.2):\n                for kind in (\'rifle\',\'pistol\',\'sniperrifle\',\'shotgun\',\'submachinegun\'):\n                    q=rate(base(cycle=cycle,weapon_type=kind));self.assertEqual(q[\'interval\'],cycle)\n        def test_click_down_up_ownership_preserved(self):\n            from click_cadence import click_schedule\n            q=rate();r=dict(last_request=10.,press_at=10.)\n            self.assertFalse(click_schedule(q,r,10.01,False,10.)[\'ready\'])\n            self.assertTrue(click_schedule(q,r,10.05,True,10.)[\'release\'])\n            self.assertTrue(click_schedule(q,r,10.101,False,10.,10.05)[\'ready\'])\n        def test_assess_pipeline_receives_category_and_rate(self):\n            from weapon_cadence import WeaponCadence\n            p=dict(WeaponType=\'pistol\',FullAuto=0,CycleTime=.19,Damage=25.,\n                RecoveryTimeStand=.5,InaccuracyStand=.03,InaccuracyFire=.02)\n            e=select_aim_view(self.frame,actor(),p,10.)\n            self.frame.local=NS(flags=1,velocity=(0.,0.,0.))\n            c=WeaponCadence();c.current=\'fixture\';c.records[\'fixture\']=dict(identity_verified=True)\n            q=c.assess(p,self.frame,e,e.penetration,10.,-100.,alignment_error=0.)\n            self.assertTrue(q[\'high_threat_active\']);self.assertEqual(q[\'interval\'],.19)\n            self.assertEqual(q[\'output_mode\'],\'paced_click\');self.assertTrue(q[\'ready\'])\n    output=io.StringIO()\n    result=unittest.TextTestRunner(stream=output,verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(Tests))\n    if not result.wasSuccessful():raise AssertionError(output.getvalue())\n    return dict(passed=True,tests=result.testsRun,models=list(MODELS),\n                real_body_samples_only=True,native_cycle_preserved=True,\n                game_attached=False,game_input=False,live_game_verified=False)\n')
_EMBEDDED['high_threat_display_contract'] = (1, '"""Headless rig visibility, label lifecycle and data isolation regression."""\nimport copy\nimport io\nimport unittest\n\n\ndef run():\n    import cso2_bot_tool as tool\n    from esp_skeleton_rules import fixture\n    from high_threat_overlay import COLOR,LABEL,rig_anchor\n\n    class Canvas(tool.RetainedCanvas):\n        def __init__(self):self.commands=[]\n        def create(self,kind,coords,options):\n            self.commands.append((kind,tuple(coords),dict(options)))\n            return len(self.commands)\n        def delete(self,*_):self.commands=[]\n        def winfo_width(self):return 1920\n        def winfo_height(self):return 1080\n        def finish(self):pass\n\n    def draw(frame,cfg=None,canvas=None):\n        canvas=canvas or Canvas()\n        stats=tool.draw_scene(canvas,frame,cfg or tool.Config(esp=True,arrows=True,esp_grenades=False))\n        labels=[(c,o) for k,c,o in canvas.commands if k==\'text\' and o.get(\'text\')==LABEL and o.get(\'fill\')==COLOR]\n        return stats,labels,canvas\n\n    class DisplayTests(unittest.TestCase):\n        def test_progress_reaim_uses_body_on_named_server_model(self):\n            from unittest.mock import Mock\n            from types import SimpleNamespace as NS\n            from aim_points import AimPoint\n            f=fixture();e=f.entities[0];e.model=\'tr_san.mdl\';e.head_source=\'server_native_hitbox\'\n            e.head=None;e.target_source=\'server\';e.aim_geometry=\'native_server_hitboxes\'\n            e.pose_sample_stamp=f.stamp;e.aim_points_validated=True\n            e.aim_points=[AimPoint(\'body\',\'torso\',(800.,-250.,42.),12.,10,visibility=\'visible\')]\n            control=tool.Controller.__new__(tool.Controller)\n            control.pressed=False;control.diagnostic={};control.tracking=Mock()\n            control.tracking.update.return_value={\'out\':(1.,2.,0.)}\n            control.clock=lambda:f.stamp\n            control.input_ready=Mock(return_value=True);control.identity_current=Mock(return_value=True)\n            control.shot_progress=Mock();control.shot_progress.assess.return_value={\'allowed\':False}\n            reader=NS(read_entity=Mock(return_value=e),set_angles=Mock())\n            result=control.reaim_head(reader,f,e,tool.Config(),{},None)\n            self.assertEqual(result,e.index);self.assertEqual(control.diagnostic[\'reaim_region\'],\'body\')\n            self.assertEqual(control.diagnostic[\'aim_part\'],\'torso\')\n            reader.set_angles.assert_called_once_with((1.,2.,0.))\n            self.assertFalse(control.diagnostic[\'fire_allowed\'])\n        def test_failed_body_probe_does_not_switch_headless_model_back_to_head(self):\n            from ballistics import ShotProgressGuard\n            f=fixture();e=f.entities[0];e.model=\'tr_san.mdl\';e.head_source=\'server_native_hitbox\'\n            progress=ShotProgressGuard();progress.records[progress.key(f,e)]={\'failures\':1}\n            self.assertIs(progress.head_view(f,e),e)\n        def test_named_models_without_head_keep_current_rig_and_label(self):\n            for model in (\'player/tr_ysht/tr_ysht.mdl\',\'player/tr_qipao01/tr_qipao01.mdl\',\'player/tr_san/tr_san.mdl\'):\n                with self.subTest(model=model):\n                    frame=fixture();e=frame.entities[0];e.model=model;e.head=None\n                    before=copy.deepcopy(vars(e));stats,labels,_=draw(frame)\n                    self.assertEqual(stats[\'skeletons\'],1)\n                    self.assertEqual(stats[\'skeleton_segments\'],len(e.skeleton))\n                    self.assertEqual(stats[\'high_threat_labels\'],1)\n                    self.assertEqual(len(labels),1)\n                    self.assertEqual(labels[0][1][\'anchor\'],\'center\')\n                    self.assertEqual(labels[0][1][\'font\'][1:],(14,\'bold\'))\n                    screen=tool.Projector(frame.matrix,1920,1080)\n                    x,y=rig_anchor(e,screen)\n                    self.assertAlmostEqual(labels[0][0][0],x)\n                    self.assertLess(labels[0][0][1],y)\n                    self.assertEqual(vars(e),before)\n        def test_no_rig_keeps_position_marker_and_never_manufactures_head(self):\n            f=fixture();e=f.entities[0];e.model=\'tr_san.mdl\';e.head=None;e.skeleton=[]\n            stats,labels,_=draw(f)\n            self.assertEqual(stats[\'position_markers\'],1)\n            self.assertEqual(len(labels),1);self.assertIsNone(e.head);self.assertEqual(e.aim_points,[])\n        def test_normal_or_similarly_named_model_has_no_label(self):\n            for model in (\'ct_sas.mdl\',\'tr_santa.mdl\',\'models/hands/tr_qipao01.mdl\'):\n                f=fixture();f.entities[0].model=model\n                self.assertEqual(draw(f)[1],[])\n        def test_visibility_does_not_hide_the_threat_marker(self):\n            for state in (\'clear\',\'blocked\',\'unknown\'):\n                f=fixture(state);e=f.entities[0];e.model=\'tr_san.mdl\';e.head=None\n                stats,labels,_=draw(f)\n                self.assertEqual(len(labels),1)\n                self.assertEqual(stats[\'skeletons\'],1)\n        def test_dead_dormant_inactive_and_allies_have_no_threat_label(self):\n            for field,value in ((\'health\',0),(\'dormant\',True),(\'reported_alive\',False),(\'enemy\',False)):\n                f=fixture();e=f.entities[0];e.model=\'tr_san.mdl\';setattr(e,field,value)\n                self.assertEqual(draw(f)[1],[])\n        def test_esp_disabled_hides_label(self):\n            f=fixture();f.entities[0].model=\'tr_san.mdl\'\n            self.assertEqual(draw(f,tool.Config(esp=False,arrows=True))[1],[])\n        def test_model_switch_and_entity_removal_clear_label(self):\n            f=fixture();f.entities[0].model=\'tr_san.mdl\';c=Canvas()\n            self.assertEqual(len(draw(f,canvas=c)[1]),1)\n            f.entities[0].model=\'ct_sas.mdl\';self.assertEqual(draw(f,canvas=c)[1],[])\n            f.entities=[];self.assertEqual(draw(f,canvas=c)[1],[])\n        def test_offscreen_labels_obey_esp_switch(self):\n            f=fixture();e=f.entities[0];e.model=\'tr_san.mdl\';e.head=None;e.skeleton=[];e.origin=(800.,2400.,0.)\n            stats,labels,_=draw(f)\n            self.assertEqual(stats[\'off_screen\'],1);self.assertEqual(len(labels),1)\n            self.assertEqual(draw(f,tool.Config(esp=False,arrows=True))[1],[])\n\n    stream=io.StringIO()\n    result=unittest.TextTestRunner(stream=stream,verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(DisplayTests))\n    if not result.wasSuccessful():raise RuntimeError(\'High threat display FAILED\\n\'+stream.getvalue())\n    return dict(passed=True,tests=result.testsRun,game_attached=False,game_input=False)\n')
_EMBEDDED['high_threat_models'] = (1, '"""Explicit model policy; identity labels never replace pose/ray verification.\n\nThe installed models have generic hitgroups (0), not a native head hitgroup.\n``tr_ysht`` is Hu Tao in the game\'s character table/localization. These names\nare a requested threat category, not proof of a particular health multiplier.\n"""\nimport math\nimport re\n\n\nHIGH_THREAT_LABEL = \'高威胁血厚！\'\nNATIVE_PARTS = (\'head\', \'torso\', \'pelvis\', \'body\', \'arm\', \'leg\')\n_CLASSES = {\n    \'tr_ysht\': \'hutao\', \'hutao\': \'hutao\', \'hu_tao\': \'hutao\', \'胡桃\': \'hutao\',\n    \'tr_qipao01\': \'qipao\', \'tr_qipao\': \'qipao\', \'qipao\': \'qipao\',\n    \'tr_san\': \'tr_san\',\n}\n\n\ndef normalize_model_name(model):\n    if not isinstance(model, str): return \'\'\n    return re.sub(\'/+\', \'/\', model.strip().replace(\'\\\\\', \'/\')).casefold()\n\n\ndef high_threat_kind(model):\n    """Match exact actor basenames; avoid hands, props and substring collisions."""\n    value = normalize_model_name(model)\n    if not value: return \'\'\n    parts = value.split(\'/\')\n    if any(p in (\'hand\', \'hands\', \'weapons\', \'props\') for p in parts[:-1]): return \'\'\n    name = parts[-1]\n    if name.endswith(\'.mdl\'): name = name[:-4]\n    return _CLASSES.get(name, \'\')\n\n\ndef is_high_threat_model(model):\n    return bool(high_threat_kind(model))\n\n\ndef valid_native_point(point):\n    """A native anatomical sample must be finite; no synthetic offsets."""\n    if getattr(point, \'part\', \'\') not in NATIVE_PARTS: return False\n    radius = getattr(point, \'radius\', None)\n    position = getattr(point, \'position\', None)\n    return (type(radius) in (int, float) and math.isfinite(radius) and radius > 0\n            and isinstance(position, (tuple, list)) and len(position) == 3\n            and all(type(v) in (int, float) and math.isfinite(v) for v in position))\n\n\ndef native_anchor(points):\n    """Largest existing native sample; all anatomical regions are eligible."""\n    body = [p for p in points if valid_native_point(p)]\n    return min(body, key=lambda p: (-p.radius, p.priority, p.key)) if body else None\n\n\ndef high_threat_cadence(base, model, *, aim_part, validated, alignment_error):\n    """Native-cycle generic-rig fire policy, after Controller\'s normal firing gates.\n\n    Only fresh direct native geometry receives this requested category\'s rate\n    policy. No health, damage, weapon cycle or target visibility is fabricated.\n    Click scheduling continues to own DOWN/UP edges and native cooldown.\n    """\n    out = dict(base)\n    kind = high_threat_kind(model)\n    out.update(high_threat=bool(kind), high_threat_class=kind,\n               high_threat_active=False)\n    if not kind: return out\n    angle = base.get(\'target_angular_radius\')\n    hp = base.get(\'target_health\')\n    numeric = lambda v: type(v) in (int, float) and math.isfinite(v)\n    if (not validated or aim_part not in NATIVE_PARTS\n            or not base.get(\'direct\') or not base.get(\'eligible_geometry\')\n            or base.get(\'stance\') == \'air\' or not numeric(hp) or hp <= 0\n            or not numeric(angle) or angle <= 0\n            or not numeric(alignment_error) or alignment_error < 0\n            or math.radians(alignment_error) > angle * .25): return out\n    cycle = base.get(\'cycle\')\n    if not numeric(cycle) or cycle <= 0 or base.get(\'weapon_type\') in (\'unknown\', \'knife\', \'grenade\'): return out\n    out.update(high_threat_active=True, interval=cycle, controlled=True,\n               continuous=False, burst_limit=1, policy=\'high_threat_native_cycle\',\n               rate_model=\'high_threat_verified_native_geometry_cycle\',\n               cadence_model=\'high_threat_native_cycle\',\n               high_threat_rate_basis=\'model_category_direct_native_not_damage_multiplier\')\n    return out\n')
_EMBEDDED['high_threat_overlay'] = (1, '"""Presentation-only labels and measured rig anchors for named heavy models."""\nimport math\n\nfrom presentation import OVERLAY_FONT\n\nLABEL = \'高威胁血厚！\'\nCOLOR = \'#ff3030\'\n\n\ndef rig_anchor(entity, screen):\n    """No guessed head: center above the currently projected measured body."""\n    points = [p for a,b in entity.skeleton\n              for segment in [screen.segment(a,b)] if segment is not None for p in segment]\n    if not points:\n        points = [p for sample in entity.aim_points\n                  for p in [screen(sample.position)] if screen.in_view(p)]\n    if not points:\n        return None\n    return ((min(p[0] for p in points)+max(p[0] for p in points))*.5,\n            min(p[1] for p in points))\n\n\ndef draw_label(canvas, x, y, width, height, language=\'zh\'):\n    if not math.isfinite(x+y) or width < 160 or height < 40:\n        return False\n    size = 14\n    from ui_text import EN\n    text = EN[LABEL] if language==\'en\' else LABEL\n    measure = getattr(type(canvas), \'measure_distance_label\', None)\n    tw,th = measure(canvas,text,size) if measure else ((len(text)*14*.85+12.,30.) if language==\'en\' else (142.,30.))\n    if tw+8 > width or th+8 > height:\n        return False\n    x = max(tw*.5+4,min(width-tw*.5-4,x))\n    y = max(th*.5+4,min(height-th*.5-4,y))\n    fast = getattr(type(canvas), \'create_distance_label\', None)\n    if fast is not None:\n        fast(canvas,x,y,text,COLOR,size)\n    else:\n        options = dict(text=text,font=(OVERLAY_FONT,size,\'bold\'),anchor=\'center\')\n        for dx,dy in ((-1,0),(1,0),(0,-1),(0,1)):\n            canvas.create_text(x+dx,y+dy,fill=\'#101820\',**options)\n        canvas.create_text(x,y,fill=COLOR,**options)\n    return True\n')
_EMBEDDED['radar_notice_layout'] = (1, '"""Large, outlined top-right countdown; pure layout and no process access."""\nimport math\nimport unicodedata\nfrom functools import lru_cache\n\nfrom radar_buy_delay import notice_lines\n\nNOTICE_COLOR = \'#ffcf4a\'\nOUTLINE_COLOR = \'#000000\'\n\n\ndef layout(width, height, lines, font_family=\'Microsoft YaHei\', measure=None,\n           line_height=None):\n    """Use 32 px (24 pt at 96 DPI) at 1080p, fitting narrow preview panels.\n\n    Negative Tk font sizes deliberately mean pixels: screen scaling determines\n    size once, avoiding a second OS/Tk DPI multiplier that can clip the banner.\n    Metrics callbacks accept the font tuple and (for measure) the text.\n    """\n    width, height = max(1, int(width)), max(1, int(height))\n    scale = max(.75, min(1.75, width / 1920., height / 1080.))\n    margin = max(18, round(24 * scale))\n    size = round(32 * scale)\n    outline = max(1, round(2 * scale))\n    available = max(1, width - margin * 2 - outline * 2)\n    if measure is None:\n        def measure(font, text):\n            units = sum(1. if unicodedata.east_asian_width(c) in (\'W\', \'F\') else .65\n                        for c in text)\n            return units * abs(font[1])\n    while True:\n        font = (font_family, -size, \'bold\')\n        if size <= 10 or all(measure(font, text) <= available for text in lines):\n            break\n        size -= 1\n    line_pixels = (int(line_height(font)) if line_height is not None\n                   else math.ceil(size * 1.5))\n    step = max(size, line_pixels) + max(4, round(size * .2))\n    return dict(x=max(margin, width-margin), y=margin, font=font,\n                line_step=step, outline=outline, margin=margin,\n                bottom_y=margin+len(lines)*step+outline+max(8, round(size*.25)))\n\n\ndef draw_notice(canvas, state, font_family=\'Microsoft YaHei\', now=None, language=\'zh\'):\n    """Draw through RetainedCanvas; return the next free warning y coordinate.\n\n    Caller begins/finishes the frame. Returning no primitives when the timer\n    expires lets RetainedCanvas hide every fill and outline from the old frame.\n    No lines returns the original resource-warning position, 18 px.\n    """\n    lines = notice_lines(state, now, language)\n    if not lines:\n        return 18\n    measure = line_height = None\n    if hasattr(canvas, \'tk\'):\n        metrics = getattr(canvas, \'_radar_notice_metrics\', None)\n        if metrics is None:\n            @lru_cache(maxsize=128)\n            def measure(font, text):\n                return int(canvas.tk.call(\'font\', \'measure\', font, text))\n            @lru_cache(maxsize=32)\n            def line_height(font):\n                return int(canvas.tk.call(\'font\', \'metrics\', font, \'-linespace\'))\n            metrics = canvas._radar_notice_metrics = (measure, line_height)\n        measure, line_height = metrics\n    spec = layout(canvas.winfo_width(), canvas.winfo_height(), lines,\n                  font_family, measure, line_height)\n    radius = spec[\'outline\']\n    offsets = ((-radius, -radius), (0, -radius), (radius, -radius),\n               (-radius, 0), (radius, 0),\n               (-radius, radius), (0, radius), (radius, radius))\n    for row, text in enumerate(lines):\n        x, y = spec[\'x\'], spec[\'y\']+row*spec[\'line_step\']\n        common = dict(text=text, font=spec[\'font\'], anchor=\'ne\')\n        for dx, dy in offsets:\n            canvas.create_text(x+dx, y+dy, fill=OUTLINE_COLOR, **common)\n        canvas.create_text(x, y, fill=NOTICE_COLOR, **common)\n    return spec[\'bottom_y\']\n')
_EMBEDDED['i18n_contract'] = ('2026.10.08-away-health-roundtime', '"""Language rendering regression without a game process or input events."""\nimport io\nimport unittest\n\n\ndef run():\n    from ui_components import LanguageUI\n    from mode_ally_policy import decide\n    from radar_buy_delay import notice_lines\n    from high_threat_overlay import draw_label\n\n    ui = LanguageUI.__new__(LanguageUI)\n\n    class Canvas:\n        def __init__(self):\n            self.labels = []\n\n        def create_text(self, x, y, **kw):\n            self.labels.append(kw[\'text\'])\n\n    class Tests(unittest.TestCase):\n        def test_baseline_screen_strings(self):\n            ui.lang = \'en\'\n            cases = (\n                \'CSO2 BOT Tool · 外部挂载障碍物数据\',\n                \'已连接游戏进程 · 功能开关保留 · 已检测到游戏进程，尚未连接服务器（状态 0）\',\n                \'连接完成\',\n                \'模式待确认：等待模式确认，关闭队友显示\',\n                \'允许厚障碍穿透射击（可见目标之后）\',\n                \'默认准星最近：可见且可击中目标优先，同组先选准星最近；玻璃、铁丝网按材质和厚度自动判断，厚障碍穿透目标后排。可见身体部位优先于隔墙头部。其他策略在同一可见等级内生效。按住右键瞄准，开启自动开火后对准即射击。\',\n                \'功能开关保留 · 已检测到游戏进程，尚未连接服务器（状态 0）\',\n                \'日志未连接\',\n            )\n            for raw in cases:\n                with self.subTest(raw=raw):\n                    self.assertFalse(any(\'\\u3400\' <= c <= \'\\u9fff\' for c in ui.t(raw)), ui.t(raw))\n\n        def test_all_native_mode_statuses(self):\n            ui.lang = \'en\'\n            for native_id in range(256):\n                rule = decide(native_id)\n                text = ui.t(rule[\'name\'] + \'：\' + rule[\'reason\'])\n                with self.subTest(native_id=native_id):\n                    self.assertFalse(any(\'\\u3400\' <= c <= \'\\u9fff\' for c in text), text)\n\n        def test_roundtrip_preserves_canonical_strings(self):\n            raw = \'模式待确认：等待模式确认，关闭队友显示\'\n            ui.lang = \'en\'\n            self.assertIn(\'ally display off\', ui.t(raw))\n            ui.lang = \'zh\'\n            self.assertEqual(ui.t(raw), raw)\n            self.assertEqual(decide(15)[\'name\'], \'个人决战模式\')\n            ui.lang = \'en\'\n            self.assertEqual(ui.t(\'倒计时\'), \'Countdown\')\n            self.assertEqual(ui.t(\'秒\'), \'s\')\n\n        def test_overlay_and_file_diagnostics(self):\n            ui.lang = \'en\'\n            raw = \'检测到 BOT TOOL 缺少墙体资源，地图名字是：cs_italy\'\n            self.assertEqual(ui.t(raw), \'Missing BOT TOOL obstacle data for map: cs_italy\')\n            self.assertEqual(ui.t(\'资源文件：world_cs_italy.bin\'), \'Resource file: world_cs_italy.bin\')\n            self.assertEqual(ui.t(\'高威胁血厚！\'), \'High threat · High HP!\')\n            canvas = Canvas()\n            self.assertTrue(draw_label(canvas, 200, 80, 800, 300, language=\'en\'))\n            self.assertEqual(canvas.labels[-1], \'High threat · High HP!\')\n\n        def test_radar_english_team_warning_and_expiry(self):\n            for team, equipment in ((2, \'T-exclusive weapons\'), (3, \'CT defuse kits\')):\n                state = dict(phase=\'countdown\', deadline=106, local_team=team)\n                lines = notice_lines(state, now=100, language=\'en\')\n                self.assertIn(\'6 seconds\', lines[0])\n                self.assertIn(equipment, lines[1])\n                self.assertEqual(notice_lines(state, now=106, language=\'en\'), ())\n\n    output = io.StringIO()\n    result = unittest.TextTestRunner(stream=output, verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(Tests))\n    if not result.wasSuccessful():\n        raise AssertionError(output.getvalue())\n    return dict(passed=True, tests=result.testsRun, game_attached=False, game_input=False)\n')
_EMBEDDED['ui_text'] = ('2026.10.08-away-health-roundtime', '"""Presentation translations only; canonical status and mode values stay intact."""\nimport re\n\nEN = {\n    \'单点右键移动鼠标可快速切换敌人！\': \'Click RMB and move the mouse to quickly switch targets!\',\n    \'游戏倒计时策略\': \'Round timer policy\',\n    \'等待提醒弹窗\': \'Waiting to prompt\',\n    \'鼠标移开游戏，自动重置对局+无限时间\': \'Mouse leaves game: restart round + unlimited time\',\n    \'游戏倒计时仍在继续，是否应用无限时间：\\n控制台：mp_roundtime 35791394 并刷新游戏\': \'The round countdown is still running. Apply unlimited time?\\nConsole: mp_roundtime 35791394, then restart the round.\',\n    \'仅处理本次\': \'Apply this time\',\n    \'永远激活：鼠标移开游戏，自动重置对局+无限时间\': \'Always apply: mouse leaves game, restart round + unlimited time\',\n    \'本次不处理\': \'Skip this time\',\n    \'已提交无限时间与对局刷新，正在回读确认\': \'Unlimited time and round restart submitted; checking the game state.\',\n    \'本次未处理；下次鼠标离开且倒计时继续时仍会提醒\': \'Skipped this time; you will be prompted again next time the mouse leaves while the countdown runs.\',\n    \'游戏状态已变化，本次未提交命令\': \'The game state changed; no command was submitted.\',\n    \'无限时间命令未获回读确认\': \'Unlimited time was not confirmed by the game state.\',\n    \'已确认无限时间并刷新对局\': \'Unlimited time and round restart confirmed.\',\n    \'鼠标离开游戏自动激活，鼠标回到游戏自动取消\': \'Automatically enable when the mouse leaves the game, disable when it returns\',\n    \'鼠标锁定：悬浮窗操作时已释放\': \'Mouse lock: released while the floating window is open\',\n    \'请按一个键\': \'Press a key\',\n    \'请按一个键，10 秒内有效；再次点击取消\': \'Press one key within 10 seconds; click again to cancel.\',\n    \'快捷键冲突：\': \'Shortcut conflict: \',\n    \'呼出快捷键已保存；未发现已知冲突\': \'Shortcut saved; no known conflicts found.\',\n    \'工具：H 切换视角\': \'Tool: H changes camera view\',\n    \'工具：Space 连跳\': \'Tool: Space triggers jumping\',\n    \'游戏：聊天 / 菜单 / 计分板常用键\': \'Game: chat / menu / scoreboard key\',\n    \'系统保留 F12\': \'F12 is reserved by Windows\',\n    \'已被其他程序注册\': \'Registered by another application\',\n    \'系统热键检测未完成\': \'System hotkey check did not complete\',\n    \'循环连接：断开 → 立即连接 → 等 6 秒 → 再断开、立即连接；6 秒从连接命令提交完成开始，不等加载或进房，再次点击停止。\': \'Cycle: disconnect, immediately connect, wait 6 s after local command submission completes, then disconnect and connect again. No loading or room-state gate. Click again to stop.\',\n    \'远端使用原生房间重连，保留房主与成员身份；不发送退出房间命令。\': \'Remote cycles use native room reconnect, preserving host and member identity. No leave-room command is sent.\',\n\n    \'快捷键呼出：\': \'Show window:\',\n    \'置顶\': \'Always on top\',\n    \'按一个键设置呼出快捷键，不使用组合键\': \'Press one key to set the shortcut; no key combinations.\',\n    \'请只按一个键，不使用组合键\': \'Press a single key without modifiers.\',\n    \'呼出快捷键已保存\': \'Window shortcut saved\',\n    \'展示资源支持率情况\': \'Show resource support status\',\n    \'房主可用：无视墙体穿透\': \'Host only: fire through walls\',\n    \'所有武器：当前选敌范围内，直接可见的敌人按距离从近到远处理，重叠时先近处；距离相同时再比较准星偏差。旧目标、出口威胁和残血不覆盖可见近敌。穿透目标排在可见敌人之后，仅在准星附近选择。瞄准模型自身眼周，遮挡时选择露出的真实命中部位。\':\n        \'All firearms: within the selected screen/cone, attack directly visible enemies from nearest to farthest, including overlapping targets. Equal distances use crosshair error. Old locks, exits and low health never override a closer visible enemy. Penetration follows visible targets and stays near the crosshair. Aim at the model eye region or an exposed native hitbox.\',\n    \'开火边界已变化，重新对准\': \'Aim changed at the firing boundary; realigning\',\n    \'持续可视优先：当前目标仍可视就持续跟随，死亡或失去可视后再选敌。直视目标优先于玻璃、铁丝网和厚障碍后的目标；重新选敌时再按准星距离、近身或出口威胁排序。优先瞄准模型自身的眼周区域，受遮挡时选择露出的真实命中部位。\':\n        \'Keep tracking the current visible target until it dies or loses visibility. Direct targets take priority over glass, grates and solid cover. Crosshair, proximity and exit threats rank new targets. Prefer the model eye region, then an exposed native hitbox.\',\n    \'可视目标复核中，保持锁定\': \'Rechecking visible target; retaining lock\',\n    \'正在跟随目标，等待开火前校准\': \'Tracking target; confirming aim before firing\',\n    \'耗弹确认或按键到期，扫描前释放扳机\': \'Shot observed or press expired; releasing before scan\',\n    \'武器采样变化，扫描前释放扳机\': \'Weapon sample changed; releasing before scan\',\n    \'武器变化，扫描前释放扳机\': \'Weapon changed; releasing before scan\',\n    \'CSO2 BOT Tool · 外部挂载障碍物数据\': \'CSO2 BOT Tool · External obstacle data\',\n    \'模式待确认\': \'Mode pending\',\n    \'自动关闭队友显示\': \'Ally display automatically off\',\n    \'等待模式确认，关闭队友显示\': \'Waiting for mode detection; ally display off\',\n    \'个人对抗：显示同阵营对手\': \'Free-for-all: show same-team opponents\',\n    \'按真实阵营区分队友与敌人\': \'Allies and enemies determined by their real teams\',\n    \'个人决战模式\': \'Free-for-all\',\n    \'RPG个人决战模式\': \'RPG free-for-all\',\n    \'娱乐挑战\': \'Fun challenge\',\n    \'连接完成\': \'Connected\',\n    \'日志未连接\': \'Match log not connected\',\n    \'已连接游戏进程\': \'Attached to game process\',\n    \'功能开关保留\': \'Feature settings preserved\',\n    \'允许厚障碍穿透射击（可见目标之后）\': \'Allow thick-cover penetration (visible targets first)\',\n    \'默认准星最近：可见且可击中目标优先，同组先选准星最近；玻璃、铁丝网按材质和厚度自动判断，厚障碍穿透目标后排。可见身体部位优先于隔墙头部。其他策略在同一可见等级内生效。按住右键瞄准，开启自动开火后对准即射击。\':\n        \'Nearest crosshair by default: visible, reachable targets first, then crosshair distance within that group. Glass and mesh use material and thickness checks; targets behind thick cover rank later. An exposed body takes priority over a head behind a wall. Other strategies apply within the same visibility tier. Hold RMB to aim; automatic fire shoots when aligned.\',\n    \'届时将无法购买 T 阵营专属枪械\': \'T-exclusive weapons will then be unavailable for purchase.\',\n    \'届时将无法购买 CT 阵营的拆弹器\': \'CT defuse kits will then be unavailable for purchase.\',\n    \'高威胁血厚！\': \'High threat · High HP!\',\n    \'人质拦截失败\': \'Hostage interception failed\',\n    \'模型未支持\': \'Model unsupported\',\n    \'离线预览 · 模拟数据\': \'Offline preview · Sample data\',\n    \'此画面只验证绘制，不代表已连接游戏。\': \'Rendering preview only; this does not indicate a game connection.\',\n    \'雷达：购买保护中，等待回合状态就绪\': \'Radar: buy protection active; waiting for round state\',\n    \'快去训练！自动准星继续基础模式。\': \'Train this map! Aim assistance continues in basic mode.\',\n    \'静态墙体未支持；快去训练！自动准星继续基础模式。\': \'Static walls unsupported; train this map! Aim assistance continues in basic mode.\',\n    \'请修复外部障碍物数据（1 - Shoot Through Data 射击穿透数据）！！！\': \'Repair the external obstacle data in the adjacent data folder!\',\n    \'请补全外部障碍物数据（1 - Shoot Through Data 射击穿透数据）！！！\': \'Add the missing external obstacle data to the adjacent data folder!\',\n    \'先连接游戏并进入本地对局，再刷新 BOT 列表\': \'Connect and enter a local match, then refresh the BOT list.\',\n    \'正在处理…\': \'Working…\',\n    \'当前没有可用 SKIN，请刷新列表\': \'No skins available; refresh the list.\',\n    \'请先刷新并选择同阵营 BOT 和 SKIN\': \'Refresh first, then select an allied BOT and a skin.\',\n    \'选择已失效，请刷新 BOT 列表\': \'Selection expired; refresh the BOT list.\',\n    \'HP 数值无效，锁血暂停\': \'Invalid HP value; health lock paused\',\n    \'房主工具：未启动\': \'Host tool: not started\',\n}\n\n\ndef dynamic_english(text, translate):\n    """Recognize full UI templates; never translate arbitrary path fragments."""\n    m = re.fullmatch(r\'(模式待确认|模式 \\d+|个人决战模式|RPG个人决战模式|娱乐挑战)：(.+)\',text)\n    if m:\n        return translate(m[1])+\': \'+translate(m[2])\n    m = re.fullmatch(r\'模式 (\\d+)\',text)\n    if m:return \'Mode \'+m[1]\n    m = re.fullmatch(r\'已检测到游戏进程，尚未连接服务器（状态 (\\d+)）\',text)\n    if m:return \'Game process detected; not connected to a server (state \'+m[1]+\')\'\n    m = re.fullmatch(r\'(当前地图没有墙体训练数据，地图名字是|BOT TOOL 墙体资源不可用，地图名字是|检测到 BOT TOOL 缺少墙体资源，地图名字是|资源文件)：(.*)\',text)\n    if m:\n        prefix={\'当前地图没有墙体训练数据，地图名字是\':\'No wall training data for map\',\n                \'BOT TOOL 墙体资源不可用，地图名字是\':\'Invalid BOT TOOL obstacle data for map\',\n                \'检测到 BOT TOOL 缺少墙体资源，地图名字是\':\'Missing BOT TOOL obstacle data for map\',\n                \'资源文件\':\'Resource file\'}[m[1]]\n        return prefix+\': \'+m[2]\n    m = re.fullmatch(r\'当前地图没有墙体训练数据：(.*?)(；静态墙体未支持)?；快去训练！\',text)\n    if m:return \'No wall training data for map: \'+m[1]+(\'; static walls unsupported\' if m[2] else \'\')+\'; train this map!\'\n    m = re.fullmatch(r\'BOT TOOL (墙体资源不可用|缺少墙体资源)：(.*?)(?:；文件：(.*?))?；请(修复|补全)外部障碍物数据！\',text)\n    if m:\n        return (\'Invalid\' if m[1]==\'墙体资源不可用\' else \'Missing\')+\' BOT TOOL obstacle data; map: \'+m[2]+(\n            \'; file: \'+m[3] if m[3] else \'\')+\'; \'+(\'repair\' if m[4]==\'修复\' else \'complete\')+\' the external data!\'\n    if \' · \' in text and text.startswith((\'已连接游戏进程 · \',\'功能开关保留 · \')):\n        return \' · \'.join(translate(part) for part in text.split(\' · \'))\n    return None\n')
_EMBEDDED['aim_fit'] = (1, '"""Script spread telemetry only; it does not change head selection.\n\nThis is a selection heuristic, never engine spread or a hit probability. Path\nvalidation, hostage checks and fresh pose/readback gates remain authoritative.\n"""\nimport math\nfrom weapon_cadence import script_spread_hint\n\n\ndef fit_info(frame, point, weapon):\n    radius = getattr(point, \'radius\', 0.)\n    distance = math.dist(frame.eye, point.position)\n    angle = math.atan2(radius, max(1., distance))\n    local = getattr(frame, \'local\', None)\n    spread = script_spread_hint(weapon, local.flags, local.velocity) if local is not None else None\n    valid = bool(spread and math.isfinite(spread) and math.isfinite(angle) and angle > 0.)\n    return dict(part=point.part, point_id=point.key,\n                angular_radius=angle, spread_estimate=spread,\n                fits=bool(valid and spread <= angle * .8),\n                basis=\'script_base_spread_not_live_probability\', engine_verified=False)\n\n\ndef prefer_fitting_body(frame, points, weapon, safe):\n    """Compatibility entry: exposed heads are no longer demoted by spread."""\n    return points\n')
_EMBEDDED['weapon_consistency_contract'] = (1, '"""Real controller paths with fixture inputs; no attachment or game input."""\nimport copy\nimport io\nimport unittest\nfrom dataclasses import replace\nfrom types import SimpleNamespace as NS\nfrom unittest.mock import patch\n\n\ndef run():\n    from aim_points import AimPoint, select_aim_view\n    from aim_fit import prefer_fitting_body\n    from weapon_profiles import canonical_weapon_name, WeaponCatalog\n    from runtime_diagnostics import weapon_identity\n    from weapon_cadence import WeaponCadence\n    from combat37_contract import scene, tick, XT97\n    from combat36_contract import USP\n    from maintenance_contract import weapon_frame\n    from ballistics import ShotProgressGuard\n    from reader import Reader, NotReady\n    from compact_log import JournalPolicy, DETAIL_BYTES\n\n    class Tests(unittest.TestCase):\n        def test_aliases_and_variants(self):\n            for n in (\'ACR\',\'CWeaponACR\',\'weapon_acr\',\'CWeapon_ACR\'):\n                self.assertEqual(canonical_weapon_name(n),\'acr\')\n            self.assertEqual(canonical_weapon_name(\'SCAR-H\'),\'scarh\')\n            self.assertEqual(canonical_weapon_name(\'CWeaponM4\'),\'m4a1\')\n            self.assertNotEqual(canonical_weapon_name(\'usp_silencer\'),canonical_weapon_name(\'usp\'))\n            for n in (\'\',None,\'../ACR\',\'acr.dll\'):\n                self.assertEqual(canonical_weapon_name(n),\'\')\n\n        def test_explicit_custom_profile_precedes_alias(self):\n            c=WeaponCatalog(\'.\',autostart=False);c.profiles={\'m4\':{\'custom\':1},\'m4a1\':{\'custom\':2}}\n            self.assertEqual(c.get(\'CWeaponM4\',refresh=False),{\'custom\':1})\n            del c.profiles[\'m4\'];self.assertEqual(c.get(\'CWeaponM4\',refresh=False),{\'custom\':2})\n\n        def test_identity_keeps_handle_and_accepts_name_forms(self):\n            f,_=weapon_frame();g=copy.deepcopy(f);g.weapon=\'weapon_\'+canonical_weapon_name(f.weapon)\n            self.assertEqual(weapon_identity(f),weapon_identity(g))\n            g.weapon_state[\'handle\']+=1\n            self.assertNotEqual(weapon_identity(f),weapon_identity(g))\n\n        def test_usp_small_head_retains_head_priority_through_controller(self):\n            # User corrected the requirement: improve head aim, never demote\n            # an exposed head due to a script spread estimate (2026-10-02).\n            f=scene(p=USP,generic=False,distance=550.)\n            d=tick(f,10.)\n            self.assertEqual(d[\'aim_part\'],\'head\');self.assertTrue(f.control.pressed)\n            self.assertFalse(d[\'aim_fit\'][\'fits\']);self.assertEqual(d[\'fire_snapshot\'][\'part\'],\'head\')\n            self.assertEqual(f.frame.entities[0].head,(550.,0.,64.))\n\n        def test_head_preserved_when_it_fits(self):\n            for p in (USP,XT97):\n                f=scene(p=p,generic=False,distance=128.)\n                d=tick(f,10.);self.assertEqual(d[\'aim_part\'],\'head\');self.assertTrue(f.control.pressed)\n\n        def test_clear_head_never_demoted_to_wall_or_hostage_body(self):\n            f=scene(p=USP,generic=False,distance=550.);points=f.reader.entity.aim_points\n            for state in (\'blocked\',\'unknown\'):\n                for p in points[1:]:p.visibility=state\n                result=prefer_fitting_body(f.frame,points,USP,lambda p:True)\n                self.assertEqual(result[0].part,\'head\')\n            for p in points[1:]:p.visibility=\'visible\'\n            result=prefer_fitting_body(f.frame,points,USP,lambda p:p.part==\'head\')\n            self.assertEqual(result[0].part,\'head\')\n\n        def test_missing_spread_or_fitting_body_preserves_head(self):\n            f=scene(p=USP,generic=False,distance=4000.);points=f.reader.entity.aim_points\n            for p in (USP,{}):\n                self.assertEqual(prefer_fitting_body(f.frame,points,p,lambda _:True)[0].part,\'head\')\n\n        def test_larger_body_does_not_bypass_unvalidated_geometry(self):\n            f=scene(p=USP,generic=False,distance=550.);e=f.reader.entity;e.aim_points_validated=False\n            view=select_aim_view(f.frame,e,USP,10.)\n            self.assertEqual(view.aim_part,\'head\')\n\n        def test_reload_resets_cadence(self):\n            f,_=weapon_frame(ammo=3);c=WeaponCadence();c.observe(f,10.);c.requested(10.)\n            f.ammo=2;f.stamp=10.01;c.observe(f,10.01)\n            self.assertEqual(c.records[c.current][\'sequence_shots\'],1)\n            f.ammo=30;f.stamp=10.02;c.observe(f,10.02)\n            r=c.records[c.current];self.assertEqual(r[\'sequence_shots\'],1)\n            self.assertIsNone(r[\'press_at\']);self.assertEqual(r[\'reset_reason\'],\'reload\')\n            f.stamp=10.5;c.observe(f,10.5)\n            self.assertEqual(c.records[c.current][\'sequence_shots\'],0)\n\n        def test_identity_switch_then_reload_clears_pending_press(self):\n            # A new weapon handle starts a fresh cadence record; reloading that\n            # identity must clear any pending press without reviving old shots.\n            f,_=weapon_frame(ammo=3);c=WeaponCadence();c.observe(f,10.);c.requested(10.)\n            f.ammo=2;f.stamp=10.01;c.observe(f,10.01)\n            previous=c.current;previous_shots=c.records[previous][\'sequence_shots\']\n            switched=copy.deepcopy(f)\n            switched.weapon_state=dict(f.weapon_state,handle=f.weapon_state[\'handle\']+1,ammo=1,stamp=10.02)\n            switched.ammo=1;c.observe(switched,10.02)\n            switched_identity=c.current\n            self.assertNotEqual(switched_identity,previous)\n            reloaded=copy.deepcopy(switched)\n            reloaded.weapon_state=dict(switched.weapon_state,ammo=30,stamp=10.03)\n            reloaded.ammo=30;c.observe(reloaded,10.03)\n            row=c.records[c.current]\n            self.assertEqual(previous_shots,1)\n            self.assertEqual(row[\'sequence_shots\'],0)\n            self.assertIsNone(row[\'press_at\'])\n            self.assertEqual(row[\'reset_reason\'],\'reload\')\n\n        def test_return_to_same_weapon_clears_old_pending_press(self):\n            f,_=weapon_frame();c=WeaponCadence();c.observe(f,10.);c.requested(10.)\n            other=copy.deepcopy(f);other.weapon_state[\'handle\']+=1;other.stamp=10.01\n            c.observe(other,10.01);f.stamp=10.02;c.observe(f,10.02)\n            self.assertIsNone(c.records[c.current][\'press_at\'])\n\n        def test_new_target_keeps_weapon_recovery_history(self):\n            f,t=weapon_frame();c=WeaponCadence();c.observe(f,10.);c.requested(10.)\n            f.ammo-=1;f.stamp=10.01;c.observe(f,10.01)\n            t.serial+=1;f.stamp=10.02;c.observe(f,10.02)\n            self.assertEqual(c.records[c.current][\'sequence_shots\'],1)\n\n        def test_old_progress_does_not_lock_same_name_new_weapon(self):\n            f,t=weapon_frame();g=ShotProgressGuard();g.assess(f,t,{\'kind\':\'clear\',\'allowed\':True},10.)\n            before=g.key(f,t);g.records[before][\'cumulative_locked\']=True\n            f.weapon_state[\'handle\']+=1\n            self.assertNotEqual(g.key(f,t),before)\n            self.assertTrue(g.assess(f,t,{\'kind\':\'clear\',\'allowed\':True},10.01)[\'allowed\'])\n\n        def test_body_retry_obeys_feedback_window_and_cumulative_limit(self):\n            f,t=weapon_frame();t.aim_part=\'torso\';g=ShotProgressGuard()\n            path={\'kind\':\'clear\',\'allowed\':True};g.assess(f,t,path,10.)\n            r=g.records[g.key(f,t)];r[\'rounds\']=6;r[\'total_rounds\']=6\n            g.wait_for_feedback(r,10.);g.reaimed(f,t)\n            self.assertFalse(g.assess(f,t,path,10.1,fresh=True)[\'allowed\'])\n            self.assertTrue(g.assess(f,t,path,10.21,fresh=True)[\'allowed\'])\n            r[\'total_rounds\']=10\n            probe=g.assess(f,t,path,10.22,fresh=True)\n            self.assertTrue(probe[\'allowed\'])\n            self.assertEqual(probe[\'status\'],\'feedback_retry\')\n            self.assertEqual(probe[\'recovery_bursts\'],1)\n\n        def test_limb_retry_requires_fresh_recheck_and_uses_bounded_burst(self):\n            path={\'kind\':\'clear\',\'allowed\':True}\n            for part in (\'arm\',\'leg\'):\n                f,t=weapon_frame();t.aim_part=part;g=ShotProgressGuard()\n                g.assess(f,t,path,10.)\n                record=g.records[g.key(f,t)]\n                record[\'rounds\']=record[\'limit\'];record[\'total_rounds\']=record[\'limit\']\n                # This fixture represents a recheck inside an already active\n                # recovery cycle; ordinary first-pass rechecks retain the\n                # normal clear-path limit of six rounds.\n                record[\'recovery_mode\']=True\n                g.wait_for_feedback(record,10.);g.reaimed(f,t)\n                self.assertFalse(g.assess(f,t,path,10.1,fresh=True)[\'allowed\'])\n                decision=g.assess(f,t,path,10.21,fresh=True)\n                self.assertTrue(decision[\'allowed\'],part)\n                self.assertEqual(decision[\'status\'],\'head_rechecked_burst\')\n                self.assertEqual(decision[\'round_limit\'],ShotProgressGuard.RECOVERY_SHOTS[\'clear\'])\n                self.assertIn(part,ShotProgressGuard.RECOVERY_PARTS)\n\n        def test_cumulative_cap_rechecks_and_recovers_after_ten_ammo_drops(self):\n            """A delayed HP sample must not permanently stop a live target."""\n            f,t=weapon_frame();t.aim_part=\'head\';path={\'kind\':\'clear\',\'allowed\':True}\n            g=ShotProgressGuard();now=10.;g.assess(f,t,path,now)\n\n            # Six confirmed clip decrements reach the normal clear-path burst\n            # limit and schedule the feedback window.\n            for _ in range(7):\n                g.remember(f,t,now);f.ammo-=1;now+=.01;g.observe(f,now)\n                decision=g.assess(f,t,path,now)\n            record=g.records[g.key(f,t)]\n            self.assertFalse(decision[\'allowed\']);self.assertEqual(record[\'rounds\'],6)\n\n            # A fresh head recheck after the backoff opens a bounded probe.\n            g.reaimed(f,t);now=record[\'retry_at\']+.01\n            decision=g.assess(f,t,path,now,fresh=True)\n            self.assertTrue(decision[\'allowed\']);self.assertTrue(record[\'probe\'])\n\n            # Four more ammo drops bring the cumulative total to ten.  The\n            # tenth drop must schedule a bounded recovery retry, not leave a\n            # permanent cumulative_ammo_cap lock.\n            for _ in range(4):\n                g.remember(f,t,now);f.ammo-=1;now+=.01;g.observe(f,now)\n                decision=g.assess(f,t,path,now,fresh=True)\n            record=g.records[g.key(f,t)]\n            self.assertTrue(decision[\'allowed\'])\n            self.assertEqual(decision[\'status\'],\'feedback_retry\')\n            self.assertEqual(record[\'recovery_bursts\'],1)\n            self.assertEqual(record[\'total_rounds\'],0)\n            self.assertLessEqual(record[\'probe_limit\'],ShotProgressGuard.RECOVERY_SHOTS[\'clear\'])\n            self.assertGreater(record[\'retry_at\'],now)\n\n        def test_clear_no_health_feedback_uses_bounded_retry_window(self):\n            f,t=weapon_frame(ammo=80);path={\'kind\':\'clear\',\'allowed\':True}\n            g=ShotProgressGuard();now=10.;g.assess(f,t,path,now,fresh=True);waits=[]\n            for _ in range(30):\n                g.remember(f,t,now);f.ammo-=1;now+=.01;g.observe(f,now)\n                decision=g.assess(f,t,path,now,fresh=True)\n                if not decision[\'allowed\']:\n                    waits.append(decision[\'retry_in_ms\'])\n                    g.reaimed(f,t)\n                    record=g.records[g.key(f,t)]\n                    now=max(now+.01,record[\'retry_at\']+.001)\n                    self.assertTrue(g.assess(f,t,path,now,fresh=True)[\'allowed\'])\n            self.assertTrue(waits)\n            self.assertLessEqual(max(waits),ShotProgressGuard.CLEAR_RETRY_MAX*1000)\n            self.assertGreaterEqual(g.records[g.key(f,t)][\'recovery_bursts\'],1)\n\n        def test_penetration_feedback_keeps_exponential_backoff(self):\n            f,t=weapon_frame();path={\'kind\':\'penetration\',\'allowed\':True,\n                \'layers\':[{\'start\':100.,\'end\':104.,\'thickness\':4.,\'materials\':{\'native_M\'}}]}\n            g=ShotProgressGuard();now=10.;g.assess(f,t,path,now,fresh=True)\n            for _ in range(5):\n                g.remember(f,t,now);f.ammo-=1;now+=.01;g.observe(f,now)\n                decision=g.assess(f,t,path,now,fresh=True)\n            self.assertFalse(decision[\'allowed\'])\n            self.assertGreaterEqual(decision[\'retry_in_ms\'],1000.)\n\n        def test_death_reload_and_weapon_change_break_pending_feedback(self):\n            from combat37_contract import scene,tick\n            live=scene();tick(live,10.);live.reader.entity.health=0;tick(live,10.01)\n            self.assertFalse(live.control.pressed)\n\n            path={\'kind\':\'clear\',\'allowed\':True}\n            f,t=weapon_frame();g=ShotProgressGuard();g.assess(f,t,path,10.)\n            record=g.records[g.key(f,t)];g.wait_for_feedback(record,10.)\n            t.health-=1\n            self.assertTrue(g.assess(f,t,path,10.01,fresh=True)[\'allowed\'])\n\n            f,t=weapon_frame();g=ShotProgressGuard();g.assess(f,t,path,10.)\n            record=g.records[g.key(f,t)];g.wait_for_feedback(record,10.)\n            f.ammo+=10;f.weapon_state[\'ammo\']=f.ammo\n            refreshed=g.assess(f,t,path,10.01,fresh=True)\n            self.assertTrue(refreshed[\'allowed\']);self.assertEqual(refreshed[\'status\'],\'ammo_refreshed\')\n\n            f,t=weapon_frame();g=ShotProgressGuard();g.assess(f,t,path,10.)\n            old=g.key(f,t);record=g.records[old];g.wait_for_feedback(record,10.)\n            f.weapon_state[\'handle\']+=1\n            self.assertNotEqual(g.key(f,t),old)\n            self.assertTrue(g.assess(f,t,path,10.01,fresh=True)[\'allowed\'])\n\n        def test_delayed_health_feedback_clears_suspicion(self):\n            f,t=weapon_frame();g=ShotProgressGuard();path={\'kind\':\'clear\',\'allowed\':True}\n            g.assess(f,t,path,10.);r=g.records[g.key(f,t)];g.wait_for_feedback(r,10.)\n            t.health-=1;q=g.assess(f,t,path,10.15,fresh=True)\n            self.assertTrue(q[\'allowed\']);self.assertEqual(q[\'failures\'],0)\n\n        def test_current_clip_is_used_without_changing_weapon(self):\n            f,t=weapon_frame();state=dict(f.weapon_state,ammo=0,stamp=10.01)\n            reader=NS(control_identity=lambda _:None)\n            with patch(\'weapon_input_guard.read_weapon_state\',return_value=state):\n                current=Reader.control_weapon(reader,f)\n            self.assertEqual(current.ammo,0);self.assertEqual(weapon_identity(current),weapon_identity(f))\n            self.assertNotEqual(f.ammo,current.ammo)\n\n        def test_pre_fire_weapon_race_rejected(self):\n            f,t=weapon_frame();state=dict(f.weapon_state,handle=f.weapon_state[\'handle\']+1)\n            with patch(\'weapon_input_guard.read_weapon_state\',return_value=state):\n                with self.assertRaises(NotReady):Reader.control_weapon(NS(control_identity=lambda _:None),f)\n\n        def test_server_merge_keeps_local_weapon_snapshot(self):\n            from server_control import ServerControlReader\n            f,_=weapon_frame();native=copy.deepcopy(f)\n            native.weapon_state={};native.local.address+=1\n            server=NS(frame=lambda *a,**k:native,sample_ms=0.,entity_stats={},base=123)\n            client=NS(frame=lambda *a,**k:f,sample_ms=0.)\n            reader=ServerControlReader.__new__(ServerControlReader)\n            reader.client_reader=client;reader.server_reader=server;reader.source_epoch=1\n            reader._server_ready=lambda:server\n            merged=reader.frame()\n            self.assertEqual(merged.weapon_state,f.weapon_state)\n            self.assertIsNot(merged.weapon_state,f.weapon_state)\n            self.assertEqual(weapon_identity(merged),weapon_identity(f))\n\n        def test_final_empty_clip_stops_controller(self):\n            f=scene(generic=False);f.reader.control_weapon=lambda frame:replace(frame,ammo=0,weapon_state=dict(frame.weapon_state,ammo=0,stamp=10.))\n            d=tick(f,10.);self.assertFalse(d[\'fire_allowed\']);self.assertNotIn(True,f.inputs.events)\n            self.assertEqual(d[\'fire_snapshot\'][\'ammo\'],0)\n\n        def test_log_counters_continue_after_detail_budget(self):\n            p=JournalPolicy(existing=DETAIL_BYTES)\n            for i in range(100):\n                p.prepare(dict(kind=\'confirmed_damage\',mono=i,weapon=\'CWeaponScarH\',damage=36,hitgroup=\'head\'))\n            row=p.snapshot()[\'confirmed_damage_by_weapon\'][\'scarh\']\n            self.assertEqual(row[\'events\'],100);self.assertEqual(row[\'head_events\'],100)\n            self.assertEqual(row[\'damage\'],3600);self.assertLessEqual(p.used,DETAIL_BYTES)\n\n    stream=io.StringIO();result=unittest.TextTestRunner(stream=stream,verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(Tests))\n    if not result.wasSuccessful():raise AssertionError(stream.getvalue())\n    return dict(passed=True,tests=result.testsRun,game_attached=False,game_input=False,live_hit_rate_verified=False)\n')
_EMBEDDED['head_motion'] = (1, '"""Bounded motion-side aim inside a freshly measured head, never outside it."""\nimport math\nfrom geometry import length,sub,dot\nfrom runtime_diagnostics import weapon_identity\n\n\ndef motion_side(frame,actor,point,velocity,eye_velocity,horizon,out,basis):\n    """Current in-head leading side; reserve at least half the head margin.\n\n    A model eye attachment may move the anchor toward its eye neighborhood.\n    It never changes hitgroup/damage and cannot pull the anchor behind the\n    motion direction. Timing is a bounded estimate, not a native shot tick.\n    """\n    center=tuple(point.position);radius=point.radius\n    relative=sub(velocity,eye_velocity);ray=sub(center,frame.eye);distance=length(ray)\n    if distance<=1:return out\n    direction=tuple(v/distance for v in ray)\n    across=tuple(relative[i]-direction[i]*dot(relative,direction) for i in range(3))\n    transverse=length(across)\n    if transverse<20:\n        out[\'motion_side_basis\']=basis;return out\n    unit=tuple(v/transverse for v in across)\n    amount=min(transverse*horizon,radius*.40,2.)\n    anchor=(0.,0.,0.);anchor_id=point.key\n    # The selected center and its eyes share this native box/bone prefix.\n    # Other head boxes and anonymous guessed eye heights are never borrowed.\n    if point.key.endswith(\':c\'):\n        prefix=point.key[:-2]+\':eye:\'\n        eye=next((p for p in getattr(actor,\'aim_points\',()) if p.part==\'head\' and\n                  p.key==prefix+\'0\' and p.radius>0 and\n                  all(math.isfinite(v) for v in p.position)),None)\n        if eye is not None:\n            toward=sub(eye.position,center)\n            # Preserve positive leading-side displacement even if the model\n            # is facing opposite its world/screen movement direction.\n            toward=tuple(toward[i]-unit[i]*dot(toward,unit) for i in range(3))\n            size=length(toward)\n            if size>1e-6:\n                anchor=tuple(v/size*min(size,radius*.10) for v in toward)\n                anchor_id=eye.key\n    offset=tuple(anchor[i]+unit[i]*amount for i in range(3));used=length(offset)\n    out.update(active=True,point=tuple(center[i]+offset[i] for i in range(3)),\n        offset=offset,offset_units=used,remaining_radius=radius-used,\n        horizon_ms=horizon*1000,relative_velocity=relative,eye_velocity=tuple(eye_velocity),\n        motion_side_basis=basis,motion_side_velocity=tuple(velocity),\n        motion_side_amount=amount,anchor_id=anchor_id,anchor_offset=anchor,\n        timing_basis=\'bounded_sample_age_plus_input_estimate_not_engine_tick\',\n        preserved_radius_fraction=(radius-used)/radius)\n    return out\n\n\nclass HeadMotion:\n    def __init__(self):self.previous=None\n\n    def reset(self):self.previous=None\n\n    def adjust(self,frame,actor,point,now,weapon=None):\n        center=tuple(point.position);radius=point.radius\n        out=dict(active=False,reason=\'head_center\',center=center,point=center,\n                 offset=(0.,0.,0.),offset_units=0.,remaining_radius=radius,\n                 horizon_ms=0.,basis=\'bounded_motion_latency_compensation\',\n                 motion_confidence=1.,motion_confidence_gate=.985,\n                 motion_fire_ready=True,motion_confidence_basis=\'stationary\',\n                 prediction_ready=False,prediction_fallback=False)\n        stamp=getattr(actor,\'pose_sample_stamp\',0.)\n        if (point.part!=\'head\' or not getattr(actor,\'aim_points_validated\',False)\n                or getattr(actor,\'head_source\',\'\') in (\'anatomical_generic\',\'server_anatomical_generic\')\n                or not (point.key.endswith(\':c\') or \':eye:\' in point.key or point.key.endswith(\'_center\') or point.key==\'head\')\n                or type(radius) not in (int,float) or not math.isfinite(radius) or radius<=0\n                or type(stamp) not in (int,float) or not math.isfinite(stamp) or not 0<stamp<=now\n                or now-stamp>.05):\n            self.reset();out[\'reason\']=\'unverified_or_stale_head\';return out\n        key=(frame.map_name,frame.local.address,frame.local.serial,\n             weapon_identity(frame),actor.index,actor.address,actor.serial,actor.model,\n             actor.target_source,point.key)\n        previous=self.previous\n        current=dict(key=key,stamp=stamp,center=center,eye=tuple(frame.eye),radius=radius)\n        reported_now=getattr(actor,\'velocity\',None)\n        reported_valid=bool(reported_now and len(reported_now)==3 and\n            all(math.isfinite(v) for v in reported_now))\n        reported_speed_now=length(reported_now) if reported_valid else 0.\n        native_velocity=tuple(reported_now) if reported_valid else None\n        current[\'native_velocity\']=native_velocity\n\n        def native_direction():\n            # Current entity velocity supplies direction even when animated\n            # skull velocity disagrees in magnitude. Reject only an invalid\n            # vector here, not natural animation/acceleration discrepancies.\n            local=getattr(frame.local,\'velocity\',None)\n            if (native_velocity is None or length(native_velocity)>500. or\n                    local is None or len(local)!=3 or not all(math.isfinite(v) for v in local)\n                    or length(local)>500.):return out\n            return motion_side(frame,actor,point,native_velocity,local,\n                min(.012,.006+max(0.,now-stamp)),out,\'current_native_relative_velocity\')\n\n        def discard_prediction(reason,basis=None,allow_native=True):\n            out.update(active=False,reason=reason,motion_fire_ready=True,\n                       prediction_ready=False,prediction_fallback=True,\n                       native_direction_allowed=allow_native)\n            if basis:out[\'motion_confidence_basis\']=basis\n            # A second read in the same simulation sample must not revive a\n            # predictor rejected earlier in that sample. I