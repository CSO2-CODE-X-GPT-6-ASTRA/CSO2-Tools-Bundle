_EMBEDDED['grenade_dodge'] = ('2026.10.07-aim-private-reader-evidence', 'from runtime_compat import server_compatible\n\n"""Role-routed HE telemetry, bounded prediction and foreground-only movement."""\nfrom dataclasses import dataclass\nimport dataclasses\nimport hashlib,json,math,queue,struct,threading,time\nfrom pathlib import Path\nfrom functools import lru_cache\nfrom geometry import add,sub,length,dot,finite\n\n\n@dataclass\nclass Grenade:\n    key:str\n    origin:tuple\n    velocity:tuple\n    remaining:float\n    radius:float\n    gravity:float\n    elasticity:float\n    source:str=\'server\'\n    timer_basis:str=\'server_native\'\n    model:str=\'\'\n\n\n@lru_cache(maxsize=8)\ndef native_he_defaults(path):\n    """Read the installed HE Create constants without accessing server memory."""\n    from runtime_compat import module_image\n    image=module_image(path)\n    checks=((0x57bcad,b\'\\xf3\\x0f\\x58\\x05\'+struct.pack(\'<I\',image.image_base+0x91e858)),\n            (0x57bcb6,bytes.fromhex(\'f30f1187c8040000\')),\n            (0x57bce7,bytes.fromhex(\'c7442410cdcccc3e\')),\n            (0x57bd4b,bytes.fromhex(\'c74424106666e63e\')))\n    if any(image.read_rva(rva,len(code))!=code for rva,code in checks):\n        raise RuntimeError(\'高爆手雷原生物理常量未验证\')\n    fuse=struct.unpack(\'<f\',image.read_rva(0x91e858,4))[0]\n    if not math.isfinite(fuse) or not .1<=fuse<=5:raise RuntimeError(\'高爆手雷原生引信参数异常\')\n    return fuse,.4,.45\n\n\nclass ClientGrenades:\n    """Live replicated projectiles; fuse age is an estimate, not a server timer."""\n    source=\'client\'\n    FIELDS=((0x1cff150,\'m_vInitialVelocity\',0x988),\n            (0x1cff18c,\'m_nFlyEffectType\',0x994),\n            (0x1ce54a0,\'m_flDamage\',0x974),(0x1ce54dc,\'m_DmgRadius\',0x964))\n    def __init__(self,reader,clock=time.monotonic):\n        from runtime_compat import field_check\n        self.reader=reader;self.clock=clock;self.first_seen={};self.scope=None;self.tables={}\n        self.metrics={