vents.find(e=>e.fingerprint===fingerprint && !e.flags.has(flag));\\n  const event=paired || {id:Process.id+\':\'+cfg.generation+\':hurt:\'+ ++damageSequence,wall:now,fingerprint,flags:new Set()};\\n  event.flags.add(flag);if(!paired)damageEvents.push(event);\\n  if(flag===0)for(const s of candidates)if(!s.damage_event_ids.includes(event.id))s.damage_event_ids.push(event.id);\\n  emit({kind:\'observed_client_player_hurt\',source:\'native_common_event_dispatch\',attacker_index:attacker,\\n    victim_index:victim,victim_serial:serial,damage,health,hitgroup:group,client_side_flag:flag,\\n    damage_event_id:event.id,paired_dispatch:!!paired,count_damage:flag===0,\\n    candidate_command_ids:candidates.map(s=>s.id),candidate_shot_ids:candidates.map(s=>s.shot_id).filter(Boolean),\\n    candidate_encoding_ids:candidates.map(s=>s.encoding_id),\\n    unselected_command_candidates:unselected.map(s=>s.id),\\n    candidate_count:candidates.length,shot_attribution_confirmed:false,\\n    candidate_delays_ms:candidates.map(s=>({command_id:s.id,elapsed_ms:now-s.started})),\\n    correlation:\'time_target_candidates_only\',packet_provenance_verified:false,acceptance_pass:false});\\n});}};\\nfunction shutdown() {\\n  shutdownRequested=true;accepting=false;frame=null;\\n  if(stopped)return {stopped:true};\\n  if(remoteAngleDirty && !scopeConnected())remoteAngleDirty=false;\\n  if(inFlight || callbackDepth || backgroundInFlight || remoteAngleDirty) {\\n    if(remoteAngleDirty && !lastRestoreWaiting){emit({kind:\'waiting_native_direction_restore\'});lastRestoreWaiting=true;}\\n    return {stopped:false,in_flight:inFlight,active_callbacks:callbackDepth,background_in_flight:backgroundInFlight,direction_restore_pending:remoteAngleDirty};\\n  }\\n  for(const h of hooks)h.detach();Interceptor.flush();stopped=true;return {stopped:true,direction_restore_pending:false};\\n}\\ntry {\\n  hooks.push(attachTracked(client.base.add(0x8e3b10),batchHook));\\n  hooks.push(attachTracked(client.base.add(0