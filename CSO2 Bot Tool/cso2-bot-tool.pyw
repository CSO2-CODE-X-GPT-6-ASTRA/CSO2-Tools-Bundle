e(msg,w)\n            if reset:self.surface_reset_reason=reset\n\n            if msg==0x84:return -1  # HTTRANSPARENT\n\n            if msg==0x21:return 3   # MA_NOACTIVATE\n\n            return self.u.DefWindowProcW(hwnd,msg,w,l)\n\n        import uuid\n        self.closed=False\n        self.proc=WNDPROC(proc);self.instance=self.k.GetModuleHandleW(None);self.name=f\'CSO2Overlay_{os.getpid()}_{uuid.uuid4().hex}\'\n\n        wc=WNDCLASS();wc.proc=self.proc;wc.instance=self.instance;wc.name=self.name\n\n        if not self.u.RegisterClassW(C.byref(wc)):raise C.WinError(C.get_last_error())\n\n        self.hwnd=self.u.CreateWindowExW(0x80000|0x20|0x8000000|0x80,self.name,\'CSO2 overlay\',0x80000000,0,0,1,1,None,None,self.instance,None)\n\n        if not self.hwnd:raise C.WinError(C.get_last_error())\n\n        self.resize((0,0,1280,720))\n\n    def __getattr__(self,name):raise AttributeError(name)\n\n    def winfo_width(self):return self.width\n\n    def winfo_height(self):return self.height\n\n    def bind_game_window(self,hwnd,foreground=True):\n\n        if self.presentation_guard.foreground!=bool(foreground):\n\n            self.presentation_guard.foreground=bool(foreground);self.presentation_guard.invalidate(\'game_focus_changed\')\n\n        if self.presentation_guard.game!=hwnd:\n\n            self.presentation_guard.game=hwnd;self.presentation_guard.invalidate(\'game_window_changed\')\n\n        # Keep this tool-owned popup above its owner even if CSO2 demotes\n\n        # unrelated topmost windows while restoring its rendering surface.\n\n        if hwnd and self.u.GetWindowLongPtrW(self.hwnd,-8)!=hwnd:\n\n            C.set_last_error(0)\n\n            previous=self.u.SetWindowLongPtrW(self.hwnd,-8,hwnd)\n\n            if not previous and C.get_last_error():raise C.WinError(C.get_last_error())\n\n            self.presentation_guard.invalidate(\'owner_rebound\')\n\n    def resize(self,rect):\n\n        x,y,w,h=rect\n\n        if w<=0 or h<=0:raise ValueError(\'