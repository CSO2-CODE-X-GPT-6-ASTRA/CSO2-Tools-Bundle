_EMBEDDED['aim_scope_wall_activation'] = (1, '"""Scoped regressions for obstacle bits entering the independent aim owner."""\nimport copy\nfrom dataclasses import replace\nfrom aim_scope_fixture import Fixture\n\n\ndef expect(value,message):\n    if not value:raise AssertionError(message)\n\n\ndef _point_setup(f):\n    from aim_points import AimPoint\n    actor=f.actors[0]\n    actor.aim_points=[AimPoint(\'0:4:c\',\'head\',actor.head,3.,0),\n        AimPoint(\'0:4:eye:0\',\'head\',(150.,0.,64.4),2.,-10),\n        AimPoint(\'0:8:c\',\'torso\',(150.,0.,45.),5.,1)]\n    return actor\n\n\ndef _packet(f,actor,key=\'head\',part=None):\n    packet=f.obstacle(actor)\n    signal=packet[\'signals\'][\'2\'];signal[\'display_point_key\']=key\n    if part is not None:signal[\'display_point_part\']=part\n    return packet\n\n\ndef activation_continuity():\n    cases=[]\n    for force in (False,True):\n      for key,part in ((\'head\',None),(\'server:4:c\',\'head\'),(\'server:4:eye:0\',\'head\')):\n        with Fixture(force=force) as f:\n            actor=_point_setup(f);f.ready();f.rays.blocked.add(actor.index)\n            f.loop.wall_provider=lambda:f.wall\n            f.wall={};before=len(f.rays.requests)\n            # Positive arrives during independent acquisition, with the\n            # producer\'s older XYZ and a different point-key namespace.\n            sent={\'done\':False};packet=_packet(f,actor,key,part)\n            def publish(event):\n                if event==\'bones\' and not sent[\'done\']:\n                    sent[\'done\']=True;f.wall=packet;f.move(actor,(150.,9.,64.))\n            f.io_hook=publish;f.tick()\n            diag=f.control.diagnostic\n            expect(f.control.pressed and diag[\'visibility\']==\'penetrable\',(force,key,diag))\n            expect(diag[\'aim_point_id\']==\'0:4:c\',(key,\'wrong current point\',diag))\n            expect(tuple(diag[\'fire_snapshot\'][\'point\'])==(150.,9.,64.),(\'old producer XYZ\',diag))\n            expect(len(f.rays.requests)==before,(\'positive target traced again\',key))\n            handoff=diag[\'wall_handoff\']\n            expect(handoff[\'penetration_activated\'] and handoff[\'rows_skipped\']==1,handoff)\n            expect(handoff[\'point_matches\'][0][\'method\']==\'same_part\',handoff)\n            expect(handoff[\'point_matches\'][0][\'source_key\']==key,handoff)\n            for y in (-9.,11.,-7.):\n                f.io_hook=lambda event,y=y:f.move(actor,(150.,y,64.)) if event==\'read_aim_entity\' else None\n                f.now+=.012;f.ammo-=1;f.tick()\n                expect(f.control.pressed and f.control.diagnostic[\'visibility\']==\'penetrable\',\n                       (\'continuity\',force,key,f.control.diagnostic))\n                expect(tuple(f.control.diagnostic[\'fire_snapshot\'][\'point\'])==(150.,y,64.),\'stale pose\')\n                expect(len(f.rays.requests)==before,\'continuous signal waited for native ray\')\n            f.wall=_packet(f,actor,key,part)\n            f.io_hook=lambda event:f.wall.clear() if event==\'read_aim_entity\' else None\n            f.now+=.02;f.tick()\n            expect(not f.control.pressed and f.control.diagnostic[\'pose_refresh\'][\'status\']==\'wall_revoked\',\n                   (\'revocation during firing read\',force,f.control.diagnostic))\n            f.io_hook=None;f.wall=_packet(f,actor,key,part);f.now+=.02;f.tick()\n            expect(f.control.pressed and f.control.diagnostic[\'visibility\']==\'penetrable\',\'positive recovery\')\n            cases.append(dict(force=force,producer_key=key,current_key=\'0:4:c\',\n                same_cycle=True,continuous=True,revocation=True,current_client_xyz=True))\n    return cases\n\n\ndef part_and_lifecycle_guards():\n    from overlay_service import apply_wall_bridge\n    cases=[]\n    with Fixture() as f:\n        actor=_point_setup(f);frame=f.reader.frame(f.cfg.mode,0,False,with_bones=True,with_aimpoints=True)\n        for field,value,reason in ((\'address\',0x22222,\'identity\'),(\'serial\',99,\'identity\'),\n                                  (\'model\',\'wrong.mdl\',\'model\')):\n            packet=_packet(f,actor,\'server:4:c\',\'head\');packet[\'signals\'][\'2\'][field]=value\n            probe=replace(frame,entities=[copy.deepcopy(actor)])\n            result=apply_wall_bridge(probe,packet[\'signals\'],packet[\'context\'],f.reader.mem.pid,f.now,\n                                     reader=f.reader,control_points=True)\n            expect(result[\'applied\']==0 and result[\'rejected\'].get(reason)==1,(field,result))\n            cases.append(field)\n        for part,keys in ((\'head\',[\'0:8:c\']),(\'torso\',[\'0:4:c\']),(\'eye\',[\'0:8:c\'])):\n            packet=_packet(f,actor,\'different:key\',part)\n            restricted=copy.deepcopy(actor);restricted.aim_points=[p for p in restricted.aim_points if p.key in keys]\n            probe=replace(frame,entities=[restricted])\n            result=apply_wall_bridge(probe,packet[\'signals\'],packet[\'context\'],f.reader.mem.pid,f.now,\n                                     reader=f.reader,control_points=True)\n            expect(result[\'applied\']==0 and result[\'rejected\'].get(\'missing_point\')==1,(part,result))\n        packet=_packet(f,actor,\'different:key\',\'head\');packet[\'context\'][\'map\']=\'other_map\'\n        result=apply_wall_bridge(replace(frame,entities=[copy.deepcopy(actor)]),packet[\'signals\'],packet[\'context\'],\n                                 f.reader.mem.pid,f.now,reader=f.reader,control_points=True)\n        expect(result[\'applied\']==0 and result[\'rejected\'].get(\'session\')==1,result)\n        # Unknown numeric/joint keys without part metadata cannot guess the\n        # native damage region. Existing exact keys still accept movement.\n        for key in (\'server:4:c\',\'esp:joint:12\'):\n            packet=_packet(f,actor,key)\n            result=apply_wall_bridge(replace(frame,entities=[copy.deepcopy(actor)]),packet[\'signals\'],packet[\'context\'],\n                                     f.reader.mem.pid,f.now,reader=f.reader,control_points=True)\n            expect(result[\'applied\']==0,(key,result))\n        packet=_packet(f,actor,\'0:4:c\');packet[\'signals\'][\'2\'][\'display_ray_head\']=(150.,100.,64.)\n        result=apply_wall_bridge(replace(frame,entities=[copy.deepcopy(actor)]),packet[\'signals\'],packet[\'context\'],\n                                 f.reader.mem.pid,f.now,reader=f.reader,control_points=True)\n        expect(result[\'applied\']==1 and result[\'match_methods\'][0][\'method\']==\'exact_key\',result)\n        # Default renderer behavior stays at exact point identity.\n        packet=_packet(f,actor,\'head\')\n        result=apply_wall_bridge(replace(frame,entities=[copy.deepcopy(actor)]),packet[\'signals\'],packet[\'context\'],\n                                 f.reader.mem.pid,f.now,reader=f.reader)\n        expect(result[\'applied\']==0,\'control-only mapping changed the renderer\')\n    return dict(identity_guards=cases,session=True,other_parts_rejected=True,\n                unknown_joints_rejected=True,exact_key_movement=True,renderer_unchanged=True)\n\n\ndef producer_transport():\n    from esp_feedback import normalize_obstacle_signal,merge_obstacle_signals\n    from overlay_service import _wall_payload\n    from wall_service import esp_positive_records\n    public=dict(schema=\'cso2.wall-penetrable.v1\',kind=\'penetration\',allowed=True,\n        wall_publish_positive=True,obstacle_assessment_complete=True,\n        map=\'cs_italy\',weapon=\'ak47\',profile_hash=\'fixture\')\n    point=[\'server:4:c\',(150.,0.,64.),\'penetrable\',\'positive\',True,public,\'head\']\n    record=[0x20000,(150.,0.,64.),(0.,0.,64.),\'penetrable\',\'positive\',10.,\'fixture.mdl\',[point],2]\n    signals=esp_positive_records({2:record})\n    expect(signals[2][\'display_point_part\']==\'head\',\'producer dropped anatomical part\')\n    normalized=normalize_obstacle_signal(signals[2],now=10.01)\n    expect(normalized[\'display_point_part\']==\'head\',\'normalizer dropped part\')\n    payload=_wall_payload(signals)\n    expect(payload[\'2\'][\'display_point_part\']==\'head\',\'wire dropped part\')\n    merged,revisions=merge_obstacle_signals({}, {}, payload,dict(result_started_at=10.))\n    expect(merged[\'2\'][\'display_point_part\']==\'head\',\'subscriber dropped part\')\n    merged,revisions=merge_obstacle_signals(merged,revisions,{},dict(result_started_at=10.02,\n        assessed=[[2,0x20000,2,\'fixture.mdl\']]))\n    expect(not merged,\'revocation failed\')\n    expect(normalize_obstacle_signal(dict(signals[2],display_point_part=\'invalid\')) is None,\'bad part accepted\')\n    return dict(producer=True,normalizer=True,wire=True,subscriber=True,revocation=True)\n\n\ndef run():\n    import traceback\n    checks={}\n    for fn in (activation_continuity,part_and_lifecycle_guards,producer_transport):\n        try:checks[fn.__name__]=dict(passed=True,evidence=fn())\n        except Exception:checks[fn.__name__]=dict(passed=False,error=traceback.format_exc())\n    return dict(passed=all(row[\'passed\'] for row in checks.values()),checks=checks,\n                scope=\'independent_aim_wall_activation\',simulated=True,game_attached=False,live_confirmation=False)\n')
_EMBEDDED['aim_scope_freshness'] = (1, '"""Independent aim freshness and obstacle handoff checks.\n\nThese checks exercise the production Controller -> fire_commit -> EngineAttack\npath. They intentionally move the fixture only after the ranked frame has\nbeen sampled, which is the failure mode that the older checks did not cover.\n"""\nimport copy\nimport math\nfrom dataclasses import replace\nfrom aim_scope_fixture import Fixture\n\n\ndef expect(value, message):\n    if not value:\n        raise AssertionError(message)\n\n\ndef _down(f):\n    return f.native_writes.count((0x90000, 3))\n\n\ndef _prepare(f, force):\n    f.cfg=copy.copy(f.cfg)\n    f.cfg.tab_force_fire=force\n    f.ready()\n    f.inputs.press(2)\n\n\ndef moving_after_rank():\n    evidence=[]\n    for force in (False, True):\n        with Fixture(force=force) as f:\n            _prepare(f, force)\n            actor=f.actors[0]\n            moved=(150., 11., 64.)\n            state={\'done\':False}\n            def hook(event):\n                if event==\'ray\' and not state[\'done\']:\n                    state[\'done\']=True\n                    f.move(actor,moved,(0.,420.,0.))\n            f.io_hook=hook\n            before=_down(f)\n            f.tick()\n            diag=f.control.diagnostic\n            expect(_down(f)>before, (\'current pose did not reach DOWN\',force,diag))\n            expect(tuple(diag[\'firing_aim_point\'])==moved, (\'firing old bone\',force,diag))\n            snap=diag.get(\'fire_snapshot\') or {}\n            expect(tuple(snap.get(\'point\',()))==moved, (\'snapshot old bone\',force,snap))\n            refresh=diag.get(\'pose_refresh\') or {}\n            expect(refresh.get(\'status\')==\'refreshed\' and not refresh.get(\'pose_reused\'),\n                   (\'refresh evidence missing\',force,refresh))\n            expect(refresh.get(\'pose_shift_units\',0)>0, (\'movement not measured\',force,refresh))\n            latency=diag.get(\'aim_latency\') or {}\n            expect(all(latency.get(k,999.)>=0. for k in (\'detection_ms\',\'decision_ms\',\'action_ms\',\'total_ms\')),\n                   (\'invalid simulated timing\',force,latency))\n            evidence.append(dict(force=force,point=moved,pose_shift_units=refresh.get(\'pose_shift_units\'),\n                latency={k:latency.get(k) for k in (\'detection_ms\',\'decision_ms\',\'action_ms\',\'total_ms\')}))\n            accepted=[a for a in f.actions if a[\'action\']==\'fire_down\'][-1][\'aim_context\']\n            frozen=copy.deepcopy(accepted)\n            expect(0<=refresh[\'before_fire_age_ms\']<refresh[\'after_down_age_ms\'],\n                   (\'pre-DOWN and post-DOWN timing not separated\',refresh))\n            expect(snap[\'fire_commit\'][\'before_fire_age_ms\']==refresh[\'before_fire_age_ms\'],\n                   (\'snapshot commit age differs\',snap,refresh))\n            for y in (4.,-8.,6.):\n                f.io_hook=lambda event,y=y: f.move(actor,(150.,y,64.)) if event==\'read_aim_entity\' else None\n                f.ammo-=1;f.now+=.012;f.tick()\n                expect(f.control.pressed and tuple(f.control.diagnostic[\'fire_snapshot\'][\'point\'])==(150.,y,64.),\n                       (\'continuous fire used stale bone\',force,f.control.diagnostic))\n                expect(accepted==frozen,\'later cycle mutated accepted firing context\')\n    return evidence\n\n\ndef refresh_fail_closed():\n    with Fixture() as f:\n        _prepare(f, False)\n        from reader import NotReady\n        f.io_hook=lambda event: (_ for _ in ()).throw(NotReady(\'fixture_refresh_only\')) if event==\'read_aim_entity\' else None\n        f.tick()\n        expect(_down(f)==0 and not f.control.pressed,\'missing pose refresh fired\')\n        expect((f.control.diagnostic.get(\'pose_refresh\') or {}).get(\'status\')==\'read_error\',\n               \'pose refresh failure was not logged\')\n        f.io_hook=None;f.now+=.02;f.tick()\n        expect(f.control.pressed,\'refresh I/O failure did not recover\')\n    return dict(missing_refresh_releases=True)\n\n\ndef penetrable_handoff():\n    for force in (False,True):\n      with Fixture(force=force) as f:\n        _prepare(f, force)\n        actor=f.actors[0]\n        f.rays.blocked.add(actor.index)\n        f.loop.wall_provider=lambda:f.wall\n        f.wall={}\n        state={\'published\':False}\n        def publish(event):\n            if event==\'bones\' and not state[\'published\']:\n                state[\'published\']=True\n                f.wall=f.obstacle(actor)\n        f.io_hook=publish\n        before_requests=len(f.rays.requests)\n        f.tick()\n        diag=f.control.diagnostic\n        expect(f.control.pressed and diag.get(\'visibility\')==\'penetrable\',\n               (\'same-cycle penetrable signal was not used\',diag))\n        expect(len(f.rays.requests)==before_requests,\n               (\'positive obstacle bit still waited for native ray\',f.rays.requests[before_requests:]))\n        handoff=diag.get(\'wall_handoff\') or {}\n        expect(handoff.get(\'stage\')==\'before_native_rays\',(\'wall handoff stage\',handoff))\n        for y in (2.,-4.,6.):\n            f.io_hook=lambda event,y=y:f.move(actor,(150.,y,64.)) if event==\'read_aim_entity\' else None\n            f.wall=f.obstacle(actor);f.ammo-=1;f.now+=.012;f.tick()\n            expect(f.control.pressed and f.control.diagnostic[\'visibility\']==\'penetrable\',\n                   (\'positive bit lost continuous fire\',force,f.control.diagnostic))\n            expect(tuple(f.control.diagnostic[\'fire_snapshot\'][\'point\'])==(150.,y,64.),\'producer XYZ reused\')\n            expect(len(f.rays.requests)==before_requests,\'continuous positive target traced again\')\n\n        # Revocation while the selected pose is being refreshed must cancel\n        # the shot instead of reusing the prior positive bit or old bone.\n        f.wall=f.obstacle(actor)\n        f.io_hook=lambda event: f.wall.clear() if event==\'read_aim_entity\' else None\n        f.now+=.02\n        f.tick()\n        refresh=f.control.diagnostic.get(\'pose_refresh\') or {}\n        expect(refresh.get(\'status\')==\'wall_revoked\' and not f.control.pressed,\n               (\'revoked penetrable signal still fired\',refresh))\n        # Re-publish and verify the positive handoff resumes on the next cycle.\n        f.io_hook=None;f.wall=f.obstacle(actor);f.now+=.02;f.tick()\n        expect(f.control.pressed and (f.control.diagnostic.get(\'pose_refresh\') or {}).get(\'ray_basis\')==\'producer_positive_bit\',\n               (\'penetrable handoff did not recover\',force,f.control.diagnostic))\n    return dict(modes=2,same_cycle_delivery=True,positive_target_ray_skipped=True,revocation_fail_closed=True,recovery=True)\n\n\ndef refresh_lifecycle_guards():\n    cases=[]\n    for force in (False,True):\n      for attr,value,expected in (\n            (\'health\',0,\'identity_or_lifecycle_changed\'),(\'dormant\',True,\'identity_or_lifecycle_changed\'),\n            (\'serial\',99,\'identity_or_lifecycle_changed\'),(\'model\',\'changed.mdl\',\'identity_or_lifecycle_changed\'),\n            (\'team\',2,\'identity_or_lifecycle_changed\'),(\'owner_team\',2,\'identity_or_lifecycle_changed\'),\n            (\'aim_points\',[],\'point_missing\'),(\'missing\',None,\'missing\'),\n            (\'pose_sample_stamp\',1.,\'refresh_stamp_invalid\'),(\'pose_sample_stamp\',None,\'refresh_stamp_invalid\'),\n            (\'point_position\',None,\'point_missing\'),(\'point_radius\',float(\'nan\'),\'point_missing\')):\n        with Fixture(force=force) as f:\n            _prepare(f,force);f.tick();expect(f.control.pressed,\'guard setup did not fire\')\n            read=f.reader.read_aim_entity\n            def altered(*args):\n                fresh=read(*args)\n                if attr==\'missing\':return None\n                if attr==\'point_position\':fresh.aim_points[0].position=value\n                elif attr==\'point_radius\':fresh.aim_points[0].radius=value\n                else:setattr(fresh,attr,value)\n                return fresh\n            f.reader.read_aim_entity=altered;before=_down(f);f.now+=.02;f.tick()\n            refresh=f.control.diagnostic.get(\'pose_refresh\') or {}\n            expect(not f.control.pressed and _down(f)==before and refresh.get(\'status\')==expected,(force,attr,refresh))\n            f.reader.read_aim_entity=read;f.now+=.02;f.tick();expect(f.control.pressed,(force,attr,\'did not recover\'))\n            cases.append((force,attr))\n    return dict(rejected_and_recovered=cases)\n\n\ndef changed_path_guards():\n    results=[]\n    for force in (False,True):\n        with Fixture(force=force) as f:\n            _prepare(f,force)\n            def block(event):\n                if event==\'read_aim_entity\':\n                    f.move(f.actors[0],(150.,8.,64.));f.rays.blocked.add(2)\n            f.io_hook=block;f.tick()\n            expect(f.control.pressed==force,(\'current blocked ray policy\',force,f.control.diagnostic))\n            f.io_hook=None;f.rays.blocked.clear();f.now+=.02;f.tick()\n            expect(f.control.pressed,\'current ray recovery\')\n        with Fixture(force=force) as f:\n            from aim_points import ProtectedEntity\n            f.cfg=replace(f.cfg,mode=\'幽灵模式（按阵营）\')\n            read=f.reader.frame\n            def protected(*args,**kwargs):\n                frame=read(*args,**kwargs)\n                frame.protected=[ProtectedEntity(80,0x80000,((70.,12.,58.),(85.,18.,70.)))]\n                return frame\n            f.reader.frame=protected;_prepare(f,force)\n            f.io_hook=lambda event:f.move(f.actors[0],(150.,30.,64.)) if event==\'read_aim_entity\' else None\n            f.tick()\n            expect(not f.control.pressed and (f.control.diagnostic.get(\'pose_refresh\') or {}).get(\'status\')==\'current_point_unsafe\',\n                   (\'refreshed ray bypassed nearby hostage\',force,f.control.diagnostic))\n        with Fixture(force=force) as f:\n            _prepare(f,force);f.cfg=replace(f.cfg,fov=5.)\n            f.io_hook=lambda event:f.move(f.actors[0],(150.,80.,64.)) if event==\'read_aim_entity\' else None\n            f.tick()\n            expect(not f.control.pressed and (f.control.diagnostic.get(\'pose_refresh\') or {}).get(\'status\')==\'outside_current_acquisition\',\n                   (\'refreshed pose escaped FOV\',force,f.control.diagnostic))\n        results.append(dict(force=force,blocked_policy=True,refreshed_hostage_protection=True,fov=True))\n    return results\n\n\ndef body_bit_visible_head():\n    from aim_points import AimPoint\n    for force in (False,True):\n        with Fixture(force=force) as f:\n            actor=f.actors[0]\n            actor.aim_points.append(AimPoint(\'torso\',\'torso\',(150.,0.,45.),5.,1,\'blocked\'))\n            f.wall=f.obstacle(actor);f.wall[\'signals\'][\'2\'].update(display_point_key=\'torso\',display_ray_head=(150.,0.,45.))\n            _prepare(f,force);before=len(f.rays.requests);f.tick()\n            expect(f.control.pressed and f.control.diagnostic[\'aim_part\']==\'head\' and\n                   f.control.diagnostic[\'visibility\']==\'visible\' and len(f.rays.requests)>before,\n                   (\'body bit hid visible head\',force,f.control.diagnostic))\n    return dict(modes=2,visible_head_preserved=True)\n\n\ndef worker_cycle_coverage():\n    from compact_log import DecisionTotals\n    from reader import NotReady\n    totals=DecisionTotals();reports=[]\n    for force,mode in ((False,\'rmb_aim_fire\'),(True,\'t_force_fire\')):\n        with Fixture(force=force) as f:\n            _prepare(f,force);f.tick()\n            f.bone_cost=.065;f.now+=.02;f.tick()\n            slow=f.control.diagnostic[\'aim_latency\'][\'total_ms\']\n            f.bone_cost=.002\n            for _ in range(3):f.now+=.02;f.tick()\n            f.fail_sample=True\n            try:f.tick()\n            except NotReady:pass\n            else:raise AssertionError(\'expected sampling error\')\n            f.fail_sample=False;f.tick()\n            report=f.loop.latency_totals.snapshot();row=report[\'by_mode\'][mode]\n            expect(report[\'cycles\']==f.loop.cycle==report[\'last_cycle\'],\'worker skipped cycles\')\n            expect(row[\'requested_ms\'][\'total_ms\'][\'max\']>=slow,\'slow skipped mailbox cycle missing\')\n            expect(row[\'statuses\'].get(\'error\')==1,\'error cycle not recorded\')\n            expect(row[\'requested_ms\'][\'total_ms\'][\'count\']==row[\'requested_cycles\'],\'requested cycle coverage\')\n            totals.observe(f.loop.frame,f.control,dict(f.control.diagnostic,worker_latency_totals=report),1.,2.)\n            reports.append(report)\n    saved=totals.snapshot()[\'worker_latency_totals\']\n    expect(saved[\'sessions\']==reports and saved[\'evicted_sessions\']==0,\'worker aggregates lost in battle summary\')\n    return dict(modes=2,all_completed_cycles=True,slow_unobserved_cycle_retained=True,error_counted=True)\n\n\ndef run():\n    checks={}\n    for fn in (moving_after_rank,refresh_fail_closed,penetrable_handoff,refresh_lifecycle_guards,\n               changed_path_guards,body_bit_visible_head,worker_cycle_coverage):\n        try: checks[fn.__name__]=dict(passed=True,evidence=fn())\n        except Exception as ex:\n            import traceback\n            checks[fn.__name__]=dict(passed=False,error=traceback.format_exc())\n    return dict(passed=all(v[\'passed\'] for v in checks.values()),checks=checks,\n                scope=\'independent_aim_fire_freshness\',simulated=True,game_attached=False,\n                live_confirmation=False)\n')
_EMBEDDED['dodge_reader'] = ('2026.10.07-aim-private-reader-evidence', '"""Independent local actor, enemy origins and HE acquisition; no ESP or bones."""\nimport math\nimport struct\nimport threading\nimport time\n\nfrom reader import Reader, Entity, Frame, NotReady\nfrom geometry import finite, length, sub\n\n\nclass DodgeReader(Reader):\n    def __init__(self, game):\n        super().__init__(game)\n        self.dodge_scope = None\n        self.next_projectile_scan = 0.\n        self.mode_lock = threading.Lock()\n\n    def mode_now(self):\n        # The UI dropdown and NativeMode\'s normal 200 ms cache cannot admit\n        # WASD after an actual mode transition.\n        with self.mode_lock:\n            self.native_mode.next = 0.\n            return self.native_mode.read()\n\n    def scope(self):\n        m = self.mem\n        if not m or not m.alive() or m.i32(self.global_addr(\'signon\')) != 6:\n            raise NotReady(\'等待当前对局\')\n        index = m.i32(self.global_addr(\'local_index\')) + 1\n        if not 1 <= index <= 128: raise NotReady(\'本地角色索引无效\')\n        address = m.u32(self.global_addr(\'local_player\'))\n        identity = struct.unpack(\'<II\', m.read(self.global_addr(\'entity_entries\') + index*16, 8))\n        map_name = m.string(self.global_addr(\'level_name\'), 160).replace(\'\\\\\', \'/\')\n        if not address or identity[0] != address or not map_name:\n            raise NotReady(\'本地角色或地图未同步\')\n        return m.pid, map_name, index, *identity\n\n    def local_frame(self):\n        from target_rules import entity_kind\n        from mode_ally_policy import mode_rule\n        started = time.monotonic()\n        scope = self.scope()\n        if scope != self.dodge_scope:\n            self.slot_cache.clear(); self.next_projectile_scan = 0.\n            self.hazard_reader = None; self.dodge_scope = scope\n        pid, map_name, index, address, serial = scope\n        name = self.classname(address)\n        if entity_kind(name) != \'player\': raise NotReady(\'本地角色类型未验证\')\n        data = self.mem.read(address, 0x3ec)\n        health = struct.unpack_from(\'<i\', data, 0x98)[0]\n        team = struct.unpack_from(\'<i\', data, 0xa0)[0]\n        if data[0x97] != 0 or not 0 < health < 100000000 or not 0 <= team < 256:\n            raise NotReady(\'本地角色未存活\')\n        origin = struct.unpack_from(\'<3f\', data, 0x300)\n        network = struct.unpack_from(\'<3f\', data, 0x3d0)\n        if not finite(origin) or length(sub(origin, network)) > 4096: origin = network\n        velocity = struct.unpack_from(\'<3f\', data, 0x198)\n        offset = struct.unpack_from(\'<3f\', data, 0x18c)\n        flags = struct.unpack_from(\'<I\', data, 0x3e8)[0]\n        angles = self.mem.vec(self.global_addr(\'view_angles\'))\n        if (not finite(origin+velocity+offset+angles) or length(velocity) >= 10000\n                or not -90 <= angles[0] <= 90):\n            raise NotReady(\'移动采样数据无效\')\n        local = Entity(index, address, name, team, health, origin,\n                       velocity=velocity, flags=flags, serial=serial)\n        mode = self.mode_now()\n        if self.scope() != scope: raise NotReady(\'采样时地图或角色发生变化\')\n        return Frame(started, local, tuple(a+b for a,b in zip(origin,offset)),\n                     angles, (0.,0.,0.), (), [], map_name, \'\', 0, 0,\n                     mode_rule(mode), native_mode_id=mode, source=\'independent_dodge\')\n\n    def scan_projectile_slots(self, force=False):\n        """Enumerate own CLIENT slots; do not read rigs or equipment."""\n        from target_rules import entity_kind\n        now = time.monotonic()\n        if not force and now < self.next_projectile_scan: return\n        m = self.mem; highest = m.i32(self.global_addr(\'highest_entity\'))\n        if not 1 <= highest < 32768: raise NotReady(\'手雷实体数量无效\')\n        entries = m.read(self.global_addr(\'entity_entries\'), (highest+1)*16)\n        slots = {}\n        for index in range(1, highest+1):\n            address, serial = struct.unpack_from(\'<II\', entries, index*16)\n            if not address: continue\n            cached = self.slot_cache.get(index)\n            if cached and cached[:2] == (address, serial):\n                kind = cached[2]\n            else:\n                name = self.classname(address)\n                kind = \'grenade\' if \'grenadeprojectile\' in name.lower() else entity_kind(name) or False\n            slots[index] = address, serial, kind\n        self.slot_cache = slots\n        self.next_projectile_scan = now + .02\n\n    def sample_enemies(self, frame, force=False):\n        from target_rules import is_enemy, entity_kind\n        started = time.monotonic()\n        self.scan_projectile_slots(force)\n        enemies = []\n        m = self.mem\n        for index, (address, serial, kind) in self.slot_cache.items():\n            if index == frame.local.index or kind not in (\'player\', \'npc\'):\n                continue\n            slot = self.global_addr(\'entity_entries\')+index*16\n            if struct.unpack(\'<II\', m.read(slot, 8)) != (address, serial):\n                raise NotReady(\'躲雷敌人身份变化，等待新采样\')\n            name = self.classname(address)\n            if kind == \'npc\' and not self.verify_npc(address):\n                raise NotReady(\'躲雷敌人字段未验证\')\n            data = m.read(address, 0x3dc)\n            health = struct.unpack_from(\'<i\', data, 0x98)[0]\n            team = struct.unpack_from(\'<i\', data, 0xa0)[0]\n            if data[0x97] != 0 or health <= 0 or data[0x21e]:\n                continue\n            if health >= 100000000 or not 0 <= team < 256:\n                raise NotReady(\'躲雷敌人状态无效\')\n            if not is_enemy(name, team, frame.local.team, frame.mode):\n                continue\n            if kind == \'npc\':\n                owner = self.handle_entity(m.u32(address+0xf48))\n                if owner and entity_kind(self.classname(owner)) == \'player\' and m.i32(owner+0xa0) == frame.local.team:\n                    continue\n            if kind == \'player\' and health == 1 and self.fields_available(\'m_hRagdoll\'):\n                ragdoll = self.handle_entity(m.u32(address+0x1688))\n                if ragdoll and \'ragdoll\' in self.classname(ragdoll).lower():\n                    continue\n            origin = struct.unpack_from(\'<3f\', data, 0x300)\n            network = struct.unpack_from(\'<3f\', data, 0x3d0)\n            if not finite(origin) or length(sub(origin, network)) > 4096:\n                origin = network\n            if not finite(origin):\n                raise NotReady(\'躲雷敌人位置无效\')\n            if struct.unpack(\'<II\', m.read(slot, 8)) != (address, serial):\n                raise NotReady(\'躲雷敌人采样时身份变化\')\n            enemies.append(dict(identity=(index, address, serial), origin=origin))\n        self.validate(frame)\n        snapshot = tuple(enemies)\n        frame.dodge_enemy_diagnostics = dict(source=\'own_client_origins\', count=len(snapshot),\n            sample_ms=(time.monotonic()-started)*1000, complete=True)\n        return snapshot\n\n    def escape_allowed(self, frame, keys):\n        from dodge_enemy_policy import away_from_enemies\n        # Refresh only our light origin sample before the actual WASD submit.\n        frame.dodge_enemy_submit = self.sample_enemies(frame, force=True)\n        angles = self.mem.vec(self.global_addr(\'view_angles\'))\n        if not finite(angles):\n            return False\n        yaw = math.radians(angles[1])\n        forward = int(0x57 in keys)-int(0x53 in keys)\n        left = int(0x41 in keys)-int(0x44 in keys)\n        norm = math.hypot(forward, left)\n        if not norm:\n            return False\n        direction = ((forward*math.cos(yaw)-left*math.sin(yaw))/norm,\n                     (forward*math.sin(yaw)+left*math.cos(yaw))/norm, 0.)\n        frame.dodge_submit_direction = direction\n        origin = self.mem.vec(frame.local.address+0x300)\n        network = self.mem.vec(frame.lo