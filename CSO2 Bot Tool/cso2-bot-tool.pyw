_EMBEDDED['runtime_compat'] = ('2026.10.08-readable-client-connection', '"""Read-only discovery using live instruction operands and data structures.\n\n\n\nFile digests are diagnostic metadata only, never compatibility gates.\n\n"""\n\nfrom pathlib import Path\n\nimport hashlib,ipaddress,json,re,struct\n\nfrom functools import lru_cache\n\n\n\n\n\nclass CompatibilityError(RuntimeError):pass\n\n\nclass ConnectionEvidence:\n    """Incremental native connection events; initial tails remain historical."""\n    def __init__(self):\n        self.scope=None;self.offset=0;self.pending=b\'\';self.identity=None;self.anchor=b\'\'\n        self.last=None;self.last_disconnect=None;self.error=\'\';self.next_poll=0.;self.gap=False;self.pending_initial=False\n\n    @staticmethod\n    def parse(line):\n        match=re.match(r\'^\\s*(\\d{1,2}:\\d{2}:\\d{2})\\s+(.+)$\',line)\n        if not match:return None\n        clock,body=match.groups();low=body.casefold()\n        if low.startswith((\'host disconnect reason\',\'base client state disconnected\')):\n            kind=\'disconnected\';reason=body.split(\':\',1)[-1].strip()\n            if \'connecting to local host\' in low:category=\'local_reconnect\'\n            elif \'connecting to remote host\' in low:category=\'remote_reconnect\'\n            elif \'host map helper\' in low:category=\'map_change\'\n            elif \'lost connection\' in low or \'timed out\' in low or \'timeout\' in low:category=\'connection_lost\'\n            elif \'kick\' in low or \'banned\' in low:category=\'server_rejected\'\n            elif \'disconnect by user\' in low or \'user disconnect\' in low:category=\'user_disconnect\'\n            else:category=\'native_disconnect\'\n        elif low.startswith(\'connect to \'):kind=\'connecting\';category=\'connect_request\';reason=body\n        elif low.startswith(\'set client signonstate to full\'):kind=\'connected\';category=\'full_connection\';reason=body\n        elif \'finished loading gameworld\' in low:kind=\'world_loaded\';category=\'map_loaded\';reason=body\n        elif low.startswith(\'connection \') and (\'failed\' in low or \'closed\' in low):kind=\'disconnected\';category=\'connection_failed\';reason=body\n        else:return None\n        return dict(native_clock=clock,kind=kind,category=category,reason=reason[:360])\n\n    def poll(self,game,pid,now=None,force=False):\n        import datetime,os,time\n        now=time.time() if now is None else now\n        if not force and now<self.next_poll:return []\n        self.next_poll=now+.5;events=[]\n        try:\n            root=Path(game);paths=[root/\'Bin/cso2_report_log.txt\',root/\'cso2_report_log.txt\']\n            paths=[p for p in paths if p.is_file()]\n            if not paths:paths=list(root.glob(\'*/cso2_report_log.txt\'))\n            if not paths:self.error=\'未找到原生连接日志\';return []\n            path=max(paths,key=lambda p:p.stat().st_mtime_ns);scope=(pid,str(path.resolve()))\n            with path.open(\'rb\') as stream:\n                stat=os.fstat(stream.fileno());stream.seek(0,2);size=stream.tell()\n                identity=(stat.st_dev,stat.st_ino);anchor_changed=False\n                if scope==self.scope and identity==self.identity and self.anchor and size>=self.offset:\n                    stream.seek(self.offset-len(self.anchor));anchor_changed=stream.read(len(self.anchor))!=self.anchor\n                reset=scope!=self.scope or identity!=self.identity or size<self.offset or anchor_changed\n                if reset:\n                    self.scope=scope;self.identity=identity;self.offset=max(0,size-65536);self.pending=b\'\'\n                    self.last=None;self.last_disconnect=None;self.anchor=b\'\'\n                self.gap=size-self.offset>131072\n                if self.gap:self.offset=size-131072;self.pending=b\'\';self.pending_initial=False\n                start=self.offset;stream.seek(start);raw=stream.read(min(131072,size-start));self.offset+=len(raw)\n                stream.seek(max(0,self.offset-32));self.anchor=stream.read(min(self.offset,32))\n            if (reset and start) or self.gap:raw=raw.partition(b\'\\n\')[2]\n            old_pending=bool(self.pending);old_pending_initial=self.pending_initial\n            lines=(self.pending+raw).split(b\'\\n\');self.pending=lines.pop()[-4096:]\n            self.pending_initial=reset or (old_pending_initial and old_pending and not lines)\n            for index,line in enumerate(lines):\n                event=self.parse(line.decode(\'utf-8\',\'replace\').rstrip(\'\\r\'))\n                if event is None:continue\n                try:\n                    h,m,s=map(int,event[\'native_clock\'].split(\':\'))\n                    stamp=datetime.datetime.fromtimestamp(stat.st_mtime).astimezone().replace(hour=h,minute=m,second=s,microsecond=0)\n                    if stamp.timestamp()>stat.st_mtime+60:stamp-=datetime.timedelta(days=1)\n                except ValueError:continue\n                age=now-stamp.timestamp()\n                initial=reset or (index==0 and old_pending and old_pending_initial)\n                event.update(native_time=stamp.isoformat(),time_basis=\'file_date_and_native_clock\',observed_at=datetime.datetime.fromtimestamp(now).astimezone().isoformat(),\n                    age_at_observation_seconds=round(age,3),source=str(path),pid_at_observation=pid,native_pid_verified=False,\n                    initial_tail=initial,evidence_gap=self.gap,incremental_recent=not initial and -2<=age<=10)\n                self.last=event\n                if event[\'kind\']==\'disconnected\':self.last_disconnect=event\n                events.append(event)\n            self.error=\'\'\n        except OSError as ex:self.error=str(ex)\n        return events\n\n    def snapshot(self,now=None):\n        import datetime,time\n        now=time.time() if now is None else now\n        current=None\n        if self.last and self.last[\'kind\']==\'disconnected\' and self.last[\'incremental_recent\