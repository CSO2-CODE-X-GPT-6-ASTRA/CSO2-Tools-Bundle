dd(key);validated.append((actors[key],verdict,tuple(tuple(p) for p in points)))\n        except Exception as ex:\n            validated=[];error=type(ex).__name__+\': \'+str(ex);self.trace_failures+=1\n        for entity,verdict,points in validated:\n            entity.visibility=verdict;entity.display_visibility_stamp=frame.stamp;entity.wall_age_ms=0.\n            entity.esp_visible_points=points if verdict==VISIBLE else ()\n            direct=set(entity.esp_visible_points)\n            entity.esp_reverse_sight=entity.head is not None and tuple(entity.head) in direct\n            entity.esp_reverse_sight_stamp=frame.stamp\n            for point in getattr(entity,\'aim_points\',()):\n                point.visibility=VISIBLE if tuple(point.position) in direct else BLOCKED\n        positive=0\n        for entity in frame.entities:\n            path=obstacle_inputs.get(identity(entity))\n            if (path is None or not combat_display_actor(entity) or not display_alive(entity) or entity.dormant):continue\n            entity.display_penetration=dict(path);positive+=1\n            if entity.visibility==BLOCKED:entity.visibility=PENETRABLE\n        if self.error and not error:self.recoveries+=1\n        self.error=error\n        self.metrics=dict(metrics,transport=\'native_trace_ray\',state=\'unavailable\' if error else \'ready\' if cfg.walls else \'basic\',\n            accepted=len(validated),error=error,invalid_rows=invalid,request_age_ms=0.,\n            obstacle_signal=dict(interface=\'one_bit\',positive=positive,max_age_ms=90.,cache=False),\n            obstacle_interface=\'current_frame_input_only\',obstacle_cache=False,\n            recovery=dict(trace_failures=self.trace_failures,recoveries=self.recoveries),\n            display_verdict_cache=False,current_ray_frame=True)\n\n    def close(self):\n        self.closed=True;self.native.close()\n\n\nclass CurrentFrameVisibility:\n    """Current-frame ESP adapter.\n\n    The display contract has no pending, clear, or unknown state.  Every call\n    hands the newest acquisition directly to ``FrameVisibility``; a missing\n    map/ray result leaves the model drawable with ``blocked`` state.\n    """\n    def __init__(self,game,*,factory=None,clock=None):\n        self.game=game;self.factory=factory or FrameVisibility;self.clock=clock or time.monotonic\n        self.lock=threading.Lock();self.stop=threading.Event();self.epoch=0;self.scope=None\n        self.last_frame_stamp=None;self.worker_ref=None\n        self.error=\'\';self.metrics={};self.last_worker_metrics={}\n\n    @staticmethod\n    def context(frame,cfg):\n        return (getattr(frame,\'source_pid\',None),frame.source,frame.source_epoch,\n            frame.server_base,frame.map_name,identity(frame.local),frame.local.team,\n            frame.local.health>0,\n            cfg.esp,cfg.arrows,cfg.allies,cfg.esp_npcs,cfg.walls,cfg.wallbang,\n            (getattr(frame,\'wall_capability\',None) or {}).get(\'token\'),\n            # Health is a display attribute, not a ray-scope boundary.  A\n            # single hit must not invalidate every actor\'s completed ray and\n            # make the whole overlay flash Blocked.  Identity, dormancy,\n            # team/enemy membership still invalidate the scope; lifecycle\n            # changes are handled per actor during endpoint transfer below.\n            tuple((identity(e),e.dormant,e.team,e.enemy) for e in frame.entities))\n\n    def reset(self):\n        with self.lock:\n            self.epoch+=1;self.scope=None;self.last_frame_stamp=None;self.last_worker_metrics={}\n\n    def _ensure_worker(self):\n        if self.stop.is_set() or self.worker_ref is not None:return\n        try:self.worker_ref=self.factory(self.game)\n        except Exception as ex:self.error=type(ex).__name__+\': \'+str(ex)\n\n    def prepare(self,raw,displayed,cfg):\n        from esp_sources import copy_frame\n        now=self.clock();scope=self.context(raw,cfg)\n        with self.lock:\n            if scope!=self.scope:\n                self.epoch+=1;self.scope=scope;self.last_worker_metrics={}\n        self._ensure_worker()\n        shown=copy_frame(displayed)\n        started=time.perf_counter();error=\'\'\n        worker=self.worker_ref\n        if self.stop.is_set() or worker is None:\n            for actor in shown.entities:\n                actor.visibility=BLOCKED;actor.wall_age_ms=None\n                actor.display_visibility_stamp=0.;actor.display_penetration={}\n            base=dict(state=\'unavailable\',accepted=0,rays=0)\n        else:\n            try:\n                worker.update(shown,cfg)\n                base=dict(getattr(worker,\'metrics\',{}) or {})\n            except Exception as ex:\n                error=type(ex).__name__+\': \'+str(ex);self.error=error\n                for actor in shown.entities:\n                    actor.visibility=BLOCKED;actor.wall_age_ms=None\n                    actor.display_visibility_stamp=0.;actor.display_penetration={}\n                base=dict(state=\'unavailable\',accepted=0,rays=0,error=error)\n        for actor in shown.entities:\n            if getattr(actor,\'visibility\',None) not in (VISIBLE,PENETRABLE,BLOCKED):\n                actor.visibility=BLOCKED\n            if actor.visibility!=PENETRABLE:\n                actor.wall_penetrable=False\n        elapsed=(time.perf_counter()-started)*1000\n        self.last_frame_stamp=raw.stamp\n        self.last_worker_metrics=dict(base)\n        self.metrics=dict(base,transport=\'same_frame\',enhanced=bool(base.get(\'state\')==\'ready\'),\n                          current_frame=True,selected_sample_age_ms=0.,worker_busy=False,\n                          worker_age_ms=0.,discarded_results=0,error=error or base.get(\'error\',\'\'),\n                          update_ms=round(elapsed,3),refresh_budget_ms=90.)\n        return raw,shown\n\n    def close(self):\n        self.stop.set()\n        worker=self.worker_ref\n        self.worker_ref=None\n        if worker is not None:\n            try:worker.close()\n            except Exception:pass\n        self.reset()\n')
_EMBEDDED['review_fixes_contract'] = (1, '"""Regression gates for the six maintenance32 review findings; no game access."""\nimport copy,io,json,math,os,tempfile,threading,time,unittest\nfrom collections import Counter\nfrom contextlib import ExitStack\nfrom pathlib import Path\nfrom types import SimpleNamespace as NS\nfrom unittest.mock import patch\n\n\ndef wait_for(check,timeout=2.):\n    end=time.monotonic()+timeout\n    while not check():\n        if time.monotonic()>=end:raise AssertionError(\'fixture deadline exceeded\')\n        time.sleep(.002)\n\n\ndef script(cycle=\'0.10\'):\n    return (\'WeaponData { Default { WeaponType rifle FullAuto 1 Range 8192 CycleTime \'+cycle+\' } }\').encode()\n\n\ndef run():\n    from esp_skeleton_rules import fixture\n    from maintenance_contract import weapon_frame\n    from cso2_bot_tool import Config\n    from esp_pipeline import CurrentFrameVisibility,FrameVisibility\n    from esp_sources import StableDisplaySelector,copy_frame\n    from server_esp import SamplePublication,DisplaySampleUnavailable\n    from weapon_profiles import WeaponCatalog,is_firearm\n    from battle_log import BattleLog\n    import pkg_assets,esp_feedback,esp_pipeline\n\n    class PublicationTests(unittest.TestCase):\n        def setUp(self):\n            self.now=10.;self.sent=[]\n            self.p=SamplePublication(NS(write=lambda b:self.sent.append(b) or len(b)),7,clock=lambda:self.now)\n        def packet(self,stamp=9.99):\n            f=fixture();f.stamp=stamp\n            return f,copy_frame(f),{\'sequence\':1}\n        def test_fresh_publication_keeps_original_timestamp(self):\n            self.p.success(1,self.packet());self.assertEqual(self.p.stamp,9.99);self.assertEqual(len(self.sent),1)\n        def test_stale_publication_never_written(self):\n            with self.assertRaises(DisplaySampleUnavailable):self.p.success(1,self.packet(9.8))\n            self.assertEqual(self.sent,[]);self.assertEqual(self.p.expired_publications,1)\n        def test_future_and_nonfinite_rejected(self):\n            for stamp in (10.1,float(\'nan\'),float(\'inf\')):\n                with self.assertRaises(DisplaySampleUnavailable):self.p.success(1,self.packet(stamp))\n            self.assertFalse(self.sent)\n        def test_expired_display_part_rejected(self):\n            p=self.packet();p[1].stamp=9.5\n            with self.assertRaises(DisplaySampleUnavailable):self.p.success(1,p)\n        def test_serialization_deadline_checked_again(self):\n            import pickle\n            dumps=pickle.dumps\n            def slow(*a,**kw):\n                result=dumps(*a,**kw);self.now+=.2;return result\n            with patch.object(pickle,\'dumps\',side_effect=slow):\n                with self.assertRaises(DisplaySampleUnavailable):self.p.success(1,self.packet())\n            self.assertFalse(self.sent)\n        def test_busy_mailbox_preserves_last_success(self):\n            self.p.success(1,self.packet());payload=self.p.payload\n            self.p.mailbox.write=lambda _:False\n            with self.assertRaises(DisplaySampleUnavailable):self.p.success(1,self.packet(10.))\n            self.assertEqual(self.p.payload,payload)\n\n    class AsyncTests(unittest.TestCase):\n        def setup_worker(self,callback=None):\n            self.now=10.;self.cfg=Config(esp=True,arrows=True)\n            self.worker=NS(metrics={\'state\':\'ready\',\'accepted\':1},close=lambda:None)\n            def update(frame,cfg):\n                if callback:callback(frame,cfg)\n                for e in frame.entities:\n                    e.visibility=\'visible\';e.wall_age_ms=0.;e.display_visibility_stamp=frame.stamp\n            self.worker.update=update\n            self.v=CurrentFrameVisibility(\'fixture\',factory=lambda _:self.worker,clock=lambda:self.now)\n            self.addCleanup(self.v.close)\n            self.f=fixture();self.f.stamp=10.\n        def submit(self,f=None):\n            f=f or self.f\n            return self.v.prepare(f,copy_frame(f),self.cfg)\n        def completed(self):\n            return self.submit()\n        def test_initial_base_keeps_entities_without_inventing_visibility(self):\n            self.setup_worker()\n            raw,shown=self.submit()\n            self.assertEqual(shown.entities[0].visibility,\'visible\');self.assertEqual(len(shown.entities),1)\n            self.assertEqual(raw.stamp,10.)\n        def test_completed_frame_is_coherent_pair_not_old_verdict_on_new_pose(self):\n            self.setup_worker();self.completed();self.now=10.01\n            current=copy_frame(self.f);current.stamp=self.now;current.entities[0].head=(1.,2.,3.)\n            raw,shown=self.submit(current)\n            self.assertTrue(self.v.metrics[\'enhanced\']);self.assertEqual(raw.stamp,shown.stamp)\n            self.assertEqual(shown.entities[0].visibility,\'visible\')\n            self.assertEqual(raw.stamp,10.01)\n        def test_completed_result_is_not_mutated_by_consumer(self):\n            self.setup_worker();self.completed();_,shown=self.submit()\n            shown.entities[0].visibility=\'poison\'\n            self.assertEqual(self.f.entities[0].visibility,\'visible\')\n        def test_reused_completed_result_reports_actual_evidence_age(self):\n            def stamp(frame,cfg):\n                for e in frame.entities:\n                    e.display_visibility_stamp=frame.stamp\n                    e.display_penetration={\'penetrable\':True,\'age_ms\':0.}\n            self.setup_worker(stamp);self.completed();self.now=10.03\n            f=copy_frame(self.f);f.stamp=self.now;_,shown=self.submit(f)\n            self.assertEqual(shown.entities[0].wall_age_ms,0.)\n            self.assertEqual(shown.entities[0].display_penetration[\'age_ms\'],0.)\n        def test_late_completed_result_not_retimestamped(self):\n            self.setup_worker();self.completed();self.now=10.10\n            f=copy_frame(self.f);f.stamp=self.now\n            raw,shown=self.submit(f)\n            self.assertTrue(self.v.metrics[\'enhanced\']);self.assertEqual(raw.stamp,10.10)\n            self.assertEqual(shown.entities[0].visibility,\'visible\')\n        def test_scope_changes_reject_completed_result(self):\n            # Scope changes use the new current frame immediately; no older\n            # packet is retained or promoted into the new scope.\n            for key,value in [(\'map_name\',\'other\'),(\'source\',\'client\'),(\'source_epoch\',4)]:\n                with self.subTest(key=key):\n                    self.setup_worker();f=copy_frame(self.f);setattr(f,key,value)\n                    raw,shown=self.submit(f);self.assertEqual(raw.stamp,shown.stamp)\n                    self.assertEqual(shown.entities[0].visibility,\'visible\');self.v.close()\n        def test_entity_reuse_and_death_reject_old_result(self):\n            for key,value in [(\'serial\',999),(\'health\',0),(\'model\',\'new\'),(\'dormant\',True)]:\n                with self.subTest(key=key):\n                    self.setup_worker();f=copy_frame(self.f);setattr(f.entities[0],key,value)\n                    raw,shown=self.submit(f);self.assertEqual(raw.stamp,shown.stamp)\n                    self.assertEqual(shown.entities[0].visibility,\'visible\');self.v.close()\n        def test_config_change_invalidates_pending_scope(self):\n            self.setup_worker();self.cfg.allies=not self.cfg.allies\n            self.submit();self.assertTrue(self.v.metrics[\'current_frame\'])\n        def test_epoch_reset_discards_completion(self):\n            self.setup_worker();self.completed();self.v.reset()\n            self.assertIsNone(self.v.last_frame_stamp);self.assertIsNone(self.v.scope)\n        def test_input_copy_is_worker_owned(self):\n            self.setup_worker();self.f.entities[0].visibility=\'unknown\';self.completed()\n            self.assertEqual(self.f.entities[0].visibility,\'unknown\')\n        def test_slow_ray_does_not_hold_base_publication(self):\n            self.setup_worker();begin=time.perf_counter();raw,shown=self.submit()\n            elapsed=(time.perf_counter()-begin)*1000\n            self.assertEqual(raw.stamp,shown.stamp);self.assertLess(elapsed,90.)\n            self.assertEqual(self.v.metrics[\'refresh_budget_ms\'],90.)\n        def test_pending_slot_is_latest_only_and_single_worker(self):\n            self.setup_worker()\n            for i in range(1,41):\n                self.now=10.+i/1000.;f=copy_frame(self.f);f.stamp=self.now;self.submit(f)\n            self.assertEqual(self.v.last_frame_stamp,10.04)\n        def test_worker_exception_allows_next_sample(self):\n            calls=[]\n            def fail_once(*a):\n                calls.append(1)\n                if len(calls)==1:raise ValueError(\'fixture bad ray\')\n            self.setup_worker(fail_once);self.submit();wait_for(lambda:bool(self.v.error))\n            self.now=10.01;f=copy_frame(self.f);f.stamp=self.now;self.submit(f)\n            self.assertEqual(self.v.metrics[\'state\'],\'ready\');self.assertEqual(self.v.last_frame_stamp,10.01)\n        def test_never_selects_older_completion_after_newer_base(self):\n            self.setup_worker();self.completed();self.v.last_emitted=10.02\n            self.now=10.03;f=copy_frame(self.f);f.stamp=self.now\n            raw,shown=self.submit(f);self.assertEqual(raw.stamp,10.03);self.assertEqual(shown.stamp,10.03)\n\n    class PenetrationTests(unittest.TestCase):\n        """The renderer consumes an obstacle-window packet; it never samples weapons."""\n        def setUp(self):\n            from esp_pipeline import FrameVisibility\n            from geometry import BVH,Brush\n            self.frame=fixture(\'blocked\');self.frame.stamp=10.\n            planes=[]\n            for axis in range(3):\n                normal=[0.,0.,0.];normal[axis]=1.;planes.append((tuple(normal),(300.,400.,200.)[axis],\'fixture\'))\n                normal=[0.,0.,0.];normal[axis]=-1.;planes.append((tuple(normal),-(200.,-400.,-100.)[axis],\'fixture\'))\n            wall=Brush(planes,((200.,-400.,-100.),(300.,400.,200.)),1)\n            from native_ray_contract import GeometryFixture\n            b=NS(tree=BVH([wall]),static_fire_guard=None,incomplete=True)\n            self.service=FrameVisibility(\'fixture\',provider=GeometryFixture(self.frame,b))\n            self.cfg=Config(esp=True,walls=True)\n        @staticmethod\n        def positive():\n            return dict(penetrable=True,kind=\'penetration\',allowed=True,obstacle_assessment_complete=True,\n                        static_prop_guard={\'allowed\':True},exit_check={\'allowed\':True},\n                        penetration_margin={\'allowed\':True})\n        def test_current_obstacle_packet_maps_to_penetrable(self):\n            self.frame.entities[0].display_penetration=self.positive()\n            self.service.update(self.frame,self.cfg)\n            self.assertEqual(self.frame.entities[0].visibility,\'penetrable\')\n            self.assertEqual(self.frame.entities[0].display_penetration.get(\'age_ms\'),0.)\n        def test_missing_packet_is_blocked_and_model_state_is_current(self):\n            self.frame.entities[0].display_penetration=self.positive()\n            self.service.update(self.frame,self.cfg)\n            self.frame.stamp=10.01;self.frame.entities[0].head=(900.,0.,64.)\n            self.frame.entities[0].display_penetration={}\n            self.service.update(self.frame,self.cfg)\n            self.assertEqual(self.frame.entities[0].visibility,\'blocked\')\n            self.assertEqual(self.frame.entities[0].display_penetration,{})\n        def test_non_penetrable_packet_never_uses_control_field(self):\n            self.frame.entities[0].display_penetration=dict(kind=\'blocked\',allowed=False,age_ms=0.)\n            self.frame.entities[0].penetration=self.positive();self.frame.entities[0].wall_penetrable=True\n            self.service.update(self.frame,self.cfg)\n            self.assertEqual(self.frame.entities[0].visibility,\'blocked\')\n        def test_obstacle_input_does_not_require_weapon_catalog(self):\n            class NoWeaponAccess:\n                def __getattr__(self,name):raise AssertionError(\'ESP touched weapon \'+name)\n            self.service._weapon_catalog=NoWeaponAccess()\n            self.frame.weapon=\'\'\n            self.service.update(self.frame,self.cfg)\n            self.assertEqual(self.frame.entities[0].visibility,\'blocked\')\n\n    class ResourceTests(unittest.TestCase):\n        def setUp(self):\n            self.tmp=tempfile.TemporaryDirectory();self.addCleanup(self.tmp.cleanup)\n            self.root=Path(self.tmp.name);(self.root/\'Data\').mkdir();self.entries={}\n            self.stack=ExitStack();self.addCleanup(self.stack.close)\n            self.headers=self.stack.enter_context(patch.object(pkg_assets,\'read_header\',side_effect=lambda p:({},self.entries[p.name])))\n            self.extracts=self.stack.enter_context(patch.object(pkg_assets,\'extract\',side_effect=lambda root,e:\n                (Path(root)/\'Data\'/e[\'package\']).read_bytes()[e[\'offset\']:e[\'offset\']+e[\'stored\']]))\n        def pack(self,name=\'a.pkg\',weapon=\'xt97\',cycle=\'0.10\'):\n            p=self.root/\'Data\'/name;data=script(cycle);p.write_bytes(b\'x\'*583+data)\n            self.entries[name]=[dict(name=\'cstrike/scripts/weapon/weapon_\'+weapon+\'.txt\',package=name,stored=len(data),offset=583)]\n            return p\n        def loose(self):\n            p=self.root/\'custom/scripts/weapon/weapon_aug.txt\';p.parent.mkdir(parents=True,exist_ok=True);p.write_bytes(script());return p\n        def catalog(self):\n            c=WeaponCatalog(self.root,autostart=False);c.refresh();return c\n        def test_same_metadata_payload_update_is_detected(self):\n            p=self.pack();c=self.catalog();st=p.stat();data=p.read_bytes().replace(b\'0.10\',b\'0.20\');p.write_bytes(data)\n            os.utime(p,ns=(st.st_atime_ns,st.st_mtime_ns));c.refresh()\n            self.assertEqual(c.get(\'CWeaponXT97\',refresh=False)[\'CycleTime\'],.2)\n            self.assertEqual(self.headers.call_count,1);self.assertEqual(self.extracts.call_count,2)\n        def test_same_metadata_index_update_is_detected(self):\n            p=self.pack();c=self.catalog();st=p.stat();p.write_bytes(b\'y\'+p.read_bytes()[1:])\n            self.entries[p.name][0]=dict(self.entries[p.name][0],name=\'cstrike/scripts/weapon/weapon_m4a1.txt\')\n            os.utime(p,ns=(st.st_atime_ns,st.st_mtime_ns));c.refresh()\n            self.assertIsNone(c.get(\'CWeaponXT97\',refresh=False));self.assertTrue(is_firearm(c.get(\'CWeaponM4A1\',refresh=False)))\n        def test_unrelated_stat_error_preserves_loose_weapon(self):\n            self.loose();c=self.catalog();bad=self.pack();stat=Path.stat\n            def fail(path,*a,**kw):\n                if path==bad:raise PermissionError(\'fixture locked package\')\n                return stat(path,*a,**kw)\n            with patch.object(Path,\'stat\',fail):c._refresh_guarded()\n            self.assertTrue(is_firearm(c.get(\'CWeaponAug\',refresh=False)));self.assertEqual(c.metrics[\'state\'],\'retrying\')\n        def test_known_failed_pack_does_not_poison_other_pack(self):\n            a=self.pack();self.pack(\'b.pkg\',\'m4a1\');c=self.catalog();stat=Path.stat\n            def fail(path,*a_,**kw):\n                if path==a:raise PermissionError(\'fixture lock\')\n                return stat(path,*a_,**kw)\n            with patch.object(Path,\'stat\',fail):c.refresh()\n            self.assertEqual(c.get(\'CWeaponXT97\',refresh=False)[\'profile_status\'],\'retrying\')\n            self.assertTrue(is_firearm(c.get(\'CWeaponM4A1\',refresh=False)))\n            c.refresh();self.assertTrue(is_firearm(c.get(\'CWeaponXT97\',refresh=False)))\n        def test_failed_override_does_not_fall_through_to_lower_package(self):\n            self.pack(\'a.pkg\');b=self.pack(\'b.pkg\',cycle=\'0.20\');c=self.catalog();stat=Path.stat\n            def fail(path,*a,**kw):\n                if path==b:raise PermissionError(\'fixture lock\')\n                return stat(path,*a,**kw)\n            with patch.object(Path,\'stat\',fail):c.refresh()\n            self.assertEqual(c.get(\'CWeaponXT97\',refresh=False)[\'profile_status\'],\'retrying\')\n        def test_unchanged_snapshot_preserves_identity_and_generation(self):\n            self.pack();c=self.catalog();snapshot=c.profiles;gen=c.metrics[\'generation\'];c.refresh()\n            self.assertIs(c.profiles,snapshot);self.assertEqual(c.metrics[\'generation\'],gen)\n        def test_deleted_package_removes_profile(self):\n            p=self.pack();c=self.catalog();p.unlink();c.refresh();self.assertIsNone(c.get(\'CWeaponXT97\',refresh=False))\n        def test_unexpected_scan_error_preserves_snapshot_and_reports_error(self):\n            self.loose();c=self.catalog();snapshot=c.profiles\n            with patch.object(c,\'refresh\',side_effect=RuntimeError(\'fixture scan failure\')):c._refresh_guarded()\n            self.assertIs(c.profiles,snapshot);self.assertEqual(c.status(\'CWeaponAug\')[\'catalog_state\'],\'retrying\')\n        def test_transient_decode_error_retries_unchanged_content(self):\n            import weapon_profiles\n            self.loose();c=WeaponCatalog(self.root,autostart=False)\n            with patch.object(weapon_profiles,\'decode_script\',side_effect=OSError(\'fixture crypto busy\')):c.refresh()\n            self.assertEqual(c.get(\'CWeaponAug\',refresh=False)[\'profile_status\'],\'retrying\')\n            c.refresh();self.assertTrue(is_firearm(c.get(\'CWeaponAug\',refresh=False)))\n\n    class LogTests(unittest.TestCase):\n        def setUp(self):\n            self.tmp=tempfile.TemporaryDirectory();self.addCleanup(self.tmp.cleanup)\n            self.log=BattleLog(self.tmp.name,set());self.addCleanup(self.log.close)\n        def drain(self):wait_for(lambda:self.log.queue.unfinished_tasks==0)\n        def test_nonserializable_record_isolated(self):\n            self.log._put(\'fixture.jsonl\',{\'bad\':object()});self.log._put(\'fixture.jsonl\',{\'ok\':1});self.drain()\n            self.assertTrue(self.log.thread.is_alive());self.assertEqual(self.log.serialization_failures,1)\n            self.assertEqual(self.log.dropped,1);self.assertIn(\'serialize\',self.log.error)\n            self.assertEqual(json.loads((Path(self.tmp.name)/\'fixture.jsonl\').read_text()),{\'ok\':1})\n        def test_circular_record_isolated(self):\n            x={};x[\'self\']=x;self.log._put(\'fixture.jsonl\',x);self.log._put(\'fixture.jsonl\',{\'ok\':1});self.drain()\n            self.assertEqual(self.log.written_records,1);self.assertEqual(self.log.dropped,1)\n        def test_disk_failure_does_not_kill_writer(self):\n            self.log._put(\'missing/fail.jsonl\',{\'x\':1});self.log._put(\'ok.jsonl\',{\'x\':2});self.drain()\n            self.assertEqual(self.log.dropped,1);self.assertEqual(self.log.written_records,1)\n            self.assertTrue(self.log.thread.is_alive());self.assertIsNotNone(self.log.last_write)\n        def test_control_record_error_isolated(self):\n            self.log.queue.put((\'bad-shape\',));self.log._put(\'ok.jsonl\',{\'x\':2});self.drain()\n            self.assertTrue(self.log.thread.is_alive());self.assertEqual(self.log.dropped,1)\n        def test_close_drains_and_finishes(self):\n            self.log._put(\'ok.jsonl\',{\'x\':2});self.log.close()\n            self.assertFalse(self.log.thread.is_alive())\n            # Cleanup\'s second close must not accumulate a new sentinel.\n            self.log._put(\'late.jsonl\',{\'late\':1});self.log.close()\n            self.assertEqual(self.log.queue.qsize(),0);self.assertEqual(self.log.dropped,1)\n\n    class SourceTests(unittest.TestCase):\n        scope=(7,6,\'maps/CS_ITALY.bsp\',2)\n        def packet(self,source,stamp):\n            f,_=weapon_frame(stamp=stamp);f.source=source;f.source_pid=7\n            f.server_base=0x100000 if source==\'server\' else 0\n            return f,{},self.scope\n        def test_threshold_wobble_has_no_switch_storm(self):\n            s=StableDisplaySelector()\n            for i in range(200):\n                now=10.+i*.01;ages={\'server\':.079 if i%2==0 else .081,\'client\':.081 if i%2==0 else .079}\n                chosen,_=s.choose({n:self.packet(n,now-age) for n,age in ages.items()},self.scope,now)\n                self.assertIsNotNone(chosen);self.assertLessEqual(now-chosen[0].stamp,.1)\n            self.assertEqual(s.switches,0)\n        def test_large_freshness_advantage_switches_immediately(self):\n            s=StableDisplaySelector();s.choose({\'server\':self.packet(\'server\',9.999)},self.scope,10.)\n            chosen,_=s.choose({\'server\':self.packet(\'server\',10.),\'client\':self.packet(\'client\',10.07)},self.scope,10.09)\n            self.assertEqual(chosen[0].source,\'client\')\n        def test_failed_current_source_falls_back_without_wait(self):\n            s=StableDisplaySelector();s.choose({\'server\':self.packet(\'server\',9.99)},self.scope,10.)\n            chosen,_=s.choose({\'client\':self.packet(\'client\',10.01)},self.scope,10.02)\n            self.assertEqual(chosen[0].source,\'client\')\n        def test_hard_expiry_is_not_relaxed(self):\n            s=StableDisplaySelector()\n            chosen,_=s.choose({n:self.packet(n,9.8) for n in (\'server\',\'client\')},self.scope,10.)\n            self.assertIsNone(chosen)\n\n    classes=(PublicationTests,AsyncTests,PenetrationTests,ResourceTests,LogTests,SourceTests)\n    suite=unittest.TestSuite(unittest.defaultTestLoader.loadTestsFromTestCase(c) for c in classes)\n    stream=io.StringIO();result=unittest.TextTestRunner(stream=stream,verbosity=2).run(suite)\n    if not result.wasSuccessful():raise AssertionError(stream.getvalue())\n    return dict(passed=True,tests=result.testsRun,game_attached=False,input_sent=False,gpu_required=False)\n')


