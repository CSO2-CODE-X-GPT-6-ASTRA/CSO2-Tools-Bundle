_EMBEDDED['target_priority'] = (1, '\n\n"""Shared proximity policy for candidate selection and wall-query scheduling."""\n\nimport math\nfrom geometry import aim_angles,angle_error,dot,length,sub,view_direction,wrap\n\n\n\nNEAR_FIRST=\'近身优先\'\n\nCOMPREHENSIVE=\'综合威胁\'\n\nTHREAT_HELP=\'普通瞄准与 T 强制模式统一：当前准星射线穿过多个敌人时先打近敌；旁边的近敌不抢占，转动准星可重新选敌。可见与可穿透目标都适用。\'\n\nDEFAULT_HOLD_DEG=0.5\nDEFAULT_SWITCH_MARGIN_DEG=0.5\n\n\ndef ray_nearest_key(frame,target,*,index=None):\n    """Current crosshair intersections first, near-to-far on that same ray.\n\n    Outside the ray, angular proximity owns acquisition. World distance alone\n    never makes a lateral enemy steal the player\'s crosshair selection.\n    Current native OBBs are authoritative; measured point radii are a fallback\n    when the reader has no OBBs (never the actor\'s broad collision bounds).\n    """\n    identity=index if index is not None else getattr(target,\'index\',0)\n    invalid=(2,float(\'inf\'),float(\'inf\'),identity)\n    try:\n        point=tuple(target.head);eye=tuple(frame.eye)\n        if len(point)!=3 or len(eye)!=3:return invalid\n        delta=sub(point,eye);direction=view_direction(frame.angles)\n        if not all(math.isfinite(v) for v in (*delta,*direction)):return invalid\n        forward=dot(delta,direction)\n        if forward<=0:return invalid\n        player_distance=length(sub(target.origin,frame.local.origin))\n        if not math.isfinite(player_distance):return invalid\n        boxes=getattr(target,\'aim_hitboxes\',())\n        if boxes:\n            hit=any(box.intersection(eye,tuple(v*1e8 for v in direction)) is not None for box in boxes)\n        else:\n            try:\n                from aim_points import candidate_points\n                samples=candidate_points(target)\n            except (AttributeError,TypeError):\n                # Lightweight telemetry objects used by diagnostics may only\n                # carry a head.  The native reader supplies full aim_points.\n                samples=()\n            if not samples and not getattr(target,\'aim_points_validated\',False):\n                samples=(type(\'RayPoint\',(),{\n                    \'position\':point,\n                    \'radius\':getattr(target,\'head_radius\',2.5) or 2.5,\n                })(),)\n            hit=False\n            for sample in samples:\n                offset=sub(sample.position,eye);along=dot(offset,direction)\n                radius=float(sample.radius)\n                if along<=0 or not math.isfinite(radius) or radius<=0:continue\n                perpendicular=length(tuple(offset[i]-along*direction[i] for i in range(3)))\n                if perpendicular<=radius:hit=True;break\n        error=angle_error(frame.angles,aim_angles(eye,point))\n        return (0,player_distance,forward,identity) if hit else (1,error,player_distance,identity)\n    except (AttributeError,TypeError,ValueError,OverflowError,IndexError):\n        return invalid\n\ndef choose_visible(ranked,previous,strategy,allow_penetration=True,*,distance_first=False):\n    from esp_targeting import selection_tier as path_tier\n    if not ranked:\n        return None\n    # In the default crosshair policy, a locally direct ray is a hard\n    # foreground set.  Wallbang/penetration candidates are never allowed to\n    # replace a target the local ray can already reach, even when their raw\n    # angular score is smaller due to stale pose data.\n    if strategy not in (COMPREHENSIVE, NEAR_FIRST):\n        direct=[row for row in ranked\n                if path_tier(row[1].visibility,row[1].penetration,allow_penetration)==0]\n        if direct:\n            ranked=direct\n    tiers=[path_tier(row[1].visibility,row[1].penetration,allow_penetration) for row in ranked]\n    best_tier=min(tiers)\n    pool=[row for row,tier in zip(ranked,tiers) if tier==best_tier]\n    if distance_first and best_tier in (1,2):\n        current=next((row for row in pool if row[1].index==previous),None)\n        if current is not None:return current\n    # Firearm direct candidates remain in the foreground visibility class, but\n    # crosshair-nearest must follow the current view. Penetration stays in a\n    # separate lower-priority class.\n    if distance_first and best_tier==0 and strategy==\'准星最近\':\n        # Admission is owned by Controller; do not impose a second hidden\n        # cone on screen-search mode. Keep only a small angular hysteresis\n        # band for consecutive-frame jitter.\n        def crosshair_error(row):\n            value=row[2][2] if len(row)>2 and row[2] is not None else None\n            return value if type(value) in (int,float) and math.isfinite(value) else float(\'inf\')\n        best=min(pool,key=lambda row:(crosshair_error(row),row[1].index!=previous,row[1].index))\n        current=next((row for row in pool if row[1].index==previous),None)\n        if current is None or current is best:return best\n        # Hysteresis is only for a near tie; a materially closer target wins.\n        if crosshair_error(current) <= crosshair_error(best)+DEFAULT_SWITCH_MARGIN_DEG:\n            return current\n        return best\n    # Explicit crosshair policy: only a distance tie may retain the incumbent.\n    # A remembered live target, contact threat or exit hint cannot override\n    # the player\'s current crosshair. Visibility tiers remain the first gate.\n    if strategy==\'准星最近\':\n        return min(pool,key=lambda row:(row[2][2],row[1].index!=previous,row[1].index))\n    # A living direct target owns continuity across all weapons/strategies.\n    # Exit urgency, crosshair scores and incomplete damage do not displace it.\n    current=next((row for row in pool if row[1].index==previous),None)\n    if best_tier==0 and current is not None:return current\n    # Survival exception to crosshair ordering, only inside the already best\n    # direct/reachable class. Unknown or penetrated near targets never displace\n    # a visible far target. Screen/cone admission remains the controller\'s job.\n    # Only fresh, directly exposed rivals can carry an exit hint. A hidden\n    # doorway, penetration path or unknown ray receives no pre-aim preference.\n    from exit_exposure import choose_exit\n    exit_choice=choose_exit(pool,previous) if best_tier==0 else None\n    if exit_choice is not None:return exit_choice\n    if strategy==COMPREHENSIVE:return choose_comprehensive(pool,previous)\n    if strategy==NEAR_FIRST:return choose_near_first(pool,previous)\n    # Default mode is crosshair-first only after the local shot path gate.\n    # A direct local ray is the highest class; reciprocal visibility is kept\n    # as telemetry only and never changes admission or selection.\n    def default_key(row):\n        info=row[3] or {}\n        return (row[2][2], row[1].index!=previous, row[1].index)\n    best=min(pool,key=default_key)\n    current=next((row for row in pool if row[1].index==previous),None)\n    if current is None:return best\n    current_tier=path_tier(current[1].visibility,current[1].penetration,allow_penetration)\n    best_tier=path_tier(best[1].visibility,best[1].penetration,allow_penetration)\n    current_error=float(current[2][2]);best_error=float(best[2][2])\n    if current_tier==0 and best_tier==0 and best[1].index!=current[1].index:\n        if current_error<=DEFAULT_HOLD_DEG:return current\n        if best_error+DEFAULT_SWITCH_MARGIN_DEG>=current_error:return current\n    return best\n\n\n\n\n\ndef survival_rank(info,retain=False):\n    """Contact <=128u; near <=192u or observed fast closing; otherwise precise."""\n    info=info or {}\n    distance=info.get(\'distance\')\n    if not isinstance(distance,(int,float)) or not 0<=distance<1e8:return 2\n    # A small exit margin for the current identity avoids 127/129u flip-flops.\n    if distance<=(144. if retain else 128.):return 0\n    if distance<=(216. if retain else 192.) or (distance<=512. and info.get(\'rushing\') is True):return 1\n    return 2\n\n\ndef threat_info(frame,entity,mutual_visible=None):\n\n    delta=sub(entity.head,frame.eye);distance=length(delta)\n\n    velocity=entity.velocity;local_velocity=frame.local.velocity\n\n    closing=0.;approaching=0.\n\n    if velocity is not None and distance>0:\n\n        direction=tuple(v/distance for v in delta)\n\n        approaching=-sum(velocity[i]*direction[i] for i in range(3))\n\n        relative=sub(velocity,local_velocity or (0,0,0))\n\n        closing=-sum(relative[i]*direction[i] for i in range(3))\n\n    # Reciprocal visibility is telemetry only.  Selection priority is based\n    # on the local ray: a clear local path is always the highest visibility\n    # class, regardless of whether the other actor can see the local player.\n    reciprocal_sampled=mutual_visible is not None\n    if mutual_visible is None:\n        mutual_visible = False\n    reciprocal = bool(entity.visibility==\'visible\' and mutual_visible)\n    visibility_threat = 0 if entity.visibility==\'visible\' else 2\n\n    rush=distance<=512 and approaching>=100 and closing>=120 and distance/max(1,closing)<=1.5\n\n    tier=0 if distance<=192 or rush else (1 if distance<=512 else 2)\n\n    error=angle_error(frame.angles,aim_angles(frame.eye,entity.head))\n\n    rear=abs(wrap(aim_angles(frame.eye,entity.head)[1]-frame.angles[1]))>=95\n\n    throwing=0 if entity.grenade else 1 if entity.can_throw else 2\n\n    info=dict(tier=tier,distance=distance,closing_speed=closing,rushing=rush,rear=rear,error=error,\n                reciprocal_visible=reciprocal,reciprocal_sampled=reciprocal_sampled,visibility_threat=visibility_threat,\n                local_visibility_threat=visibility_threat,\n\n                throwable_rank=throwing,can_throw=entity.can_throw,holding_throwable=entity.grenade)\n    info[\'survival_rank\']=survival_rank(info)\n    info[\'engagement_policy\']=\'contact_survival\' if info[\'survival_rank\']==0 else \'near_survival\' if info[\'survival_rank\']==1 else \'precise_crosshair\'\n    return info\n\n\n\n\n\ndef priority_key(info):\n\n    return (info[\'tier\'],info[\'distance\'],0) if info[\'tier\']<2 else (2,info[\'throwable_rank\'],info[\'error\'])\n\n\n\n\n\ndef comprehensive_key(info):\n\n    if info[\'tier\']<2:return (info[\'tier\'],0,info[\'distance\'])\n\n    if info[\'throwable_rank\']<2:return (2,info[\'throwable_rank\'],info[\'error\'])\n\n    return (3,0,info[\'error\'])\n\n\n\n\n\ndef choose_comprehensive(ranked,previous):\n\n    best=min(ranked,key=lambda row:(*comprehensive_key(row[3]),row[1].index))\n\n    current=next((row for row in ranked if row[1].index==previous),None)\n\n    if current is None:return best\n\n    a,b=comprehensive_key(best[3]),comprehensive_key(current[3])\n\n    if a[:2]<b[:2]:return best\n\n    margin=max(16.,b[2]*.08) if a[0]<2 else .75\n\n    return best if a[:2]==b[:2] and a[2]+margin<b[2] else current\n\n\n\n\n\ndef choose_near_first(ranked,previous):\n\n    best=min(ranked,key=lambda row:(*priority_key(row[3]),row[1].index))\n\n    current=next((row for row in ranked if row[1].index==previous),None)\n\n    if current is None:return best\n\n    a,b=best[3],current[3]\n\n    if a[\'tier\']<b[\'tier\']:return best\n\n    # Similar threats retain continuity; a materially closer enemy preempts.\n\n    if a[\'tier\']==b[\'tier\']:\n\n        if a[\'tier\']==2 and a[\'throwable_rank\']<b[\'throwable_rank\']:return best\n\n        margin=max(24,b[\'distance\']*.12) if a[\'tier\']<2 else 3.\n\n        if a[\'tier\']<2 and a[\'distance\']+margin<b[\'distance\']:return best\n\n        if a[\'tier\']==2 and a[\'throwable_rank\']==b[\'throwable_rank\'] and a[\'error\']+margin<b[\'error\']:return best\n\n    return current\n\n\n\n\n\ndef response_smoothing(configured,info):\n\n    if info[\'tier\']==0:return 1.\n\n    if info[\'tier\']==1:return min(float(configured),1+(info[\'distance\']-192)/320)\n\n    return configured\n')





