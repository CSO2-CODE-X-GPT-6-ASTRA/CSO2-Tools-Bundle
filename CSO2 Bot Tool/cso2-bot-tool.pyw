_EMBEDDED['radar_buy_delay'] = (1, '"""Read-only CLIENT round gate, shared by host and remote sessions."""\nimport math\nimport struct\nimport time\n\nDELAY_HINT = \'最大15秒，最低6秒钟\'\nBUY_WARNING = \'届时将无法购买本阵营装备\'\nBUY_WARNING_BY_TEAM = {\n    2: \'届时将无法购买 T 阵营专属枪械\',\n    3: \'届时将无法购买 CT 阵营的拆弹器\',\n}\nRULES_GLOBAL = 0x1cdb994\nPROXY_RVA = 0x7f9490\nPROPERTIES = ((0x1ce728c, \'m_bFreezePeriod\', 0x34, 0),\n              (0x1ce7340, \'m_iTotalRoundsPlayed\', 0x2c, 0),\n              (0x1ce737c, \'m_fRoundStartTime\', 0x3c, 1))\n\n\ndef delay_value(value):\n    text = str(value).strip()\n    if not text.isascii() or not text.isdecimal() or len(text) > 3:\n        return 6\n    return max(6, min(15, int(text)))\n\n\nclass ClientRoundState:\n    def __init__(self):\n        self.verified = None\n\n    def read(self, reader, frame):\n        m, c = reader.mem, reader.client\n        reader.control_identity(frame)\n        scope = (id(m), m.pid, c)\n        code = b\'\\x8b\\x4c\\x24\\x08\\xa1\' + struct.pack(\'<I\', c+RULES_GLOBAL) + b\'\\x89\\x01\\xc3\'\n        # Recheck the small proxy every sample; field registrations per binding.\n        if m.read(c+PROXY_RVA, len(code)) != code:\n            raise RuntimeError(\'雷达购买保护：客户端回合入口校验失败\')\n        if scope != self.verified:\n            for rva, name, offset, kind in PROPERTIES:\n                p = c+rva\n                if (m.string(m.u32(p), 64) != name or m.u32(p+44) != offset\n                        or m.u32(p+4) != kind):\n                    raise RuntimeError(\'雷达购买保护：回合字段不匹配 \'+name)\n            self.verified = scope\n        rules = m.u32(c+RULES_GLOBAL)\n        if not rules:\n            raise RuntimeError(\'雷达购买保护：等待当前回合\')\n        raw = m.read(rules+0x2c, 20)\n        count = struct.unpack_from(\'<i\', raw)[0]\n        frozen = raw[8]\n        started = struct.unpack_from(\'<f\', raw, 16)[0]\n        if (not 0 <= count <= 10000000 or frozen not in (0, 1)\n                or not math.isfinite(started) or not 0 <= started < 1e9):\n            raise RuntimeError(\'雷达购买保护：回合状态待同步\')\n        if m.u32(c+RULES_GLOBAL) != rules or m.read(rules+0x2c, 20) != raw:\n            raise RuntimeError(\'雷达购买保护：回合切换中\')\n        reader.control_identity(frame)\n        return dict(scope=(*scope, rules, frame.map_name), count=count,\n                    started=started, frozen=bool(frozen), source=\'client_recv_rules\')\n\n\nclass RadarBuyDelay:\n    def __init__(self, clock=time.monotonic, sampler=None):\n        self.clock = clock\n        self.sampler = sampler or ClientRoundState()\n        self.reset()\n\n    def reset(self):\n        self.previous = None\n        self.begin = None\n        self.identity = None\n        self.generation = 0\n        self.state = dict(phase=\'waiting\', allowed=False)\n\n    def step(self, reader, frame, enabled, seconds=6):\n        now = self.clock()\n        seconds = delay_value(seconds)\n        if not enabled:\n            self.reset()\n            self.state = dict(phase=\'disabled\', allowed=False, seconds=seconds, observed_at=now)\n            return dict(self.state)\n        try:\n            if frame is None or not frame.map_name:\n                raise RuntimeError(\'等待当前地图与玩家\')\n            local = frame.local\n            identity = (local.index, local.address, local.serial, local.team)\n            sample = self.sampler.read(reader, frame)\n            old = self.previous\n            changed = (old is None or identity != self.identity or old[\'scope\'] != sample[\'scope\']\n                       or old[\'count\'] != sample[\'count\']\n                       or (sample[\'frozen\'] and (not old[\'frozen\'] or old[\'started\'] != sample[\'started\']))\n                       or (not sample[\'frozen\'] and not old[\'frozen\'] and old[\'started\'] != sample[\'started\']))\n            # Freeze -> live can adjust the timestamp. It is the same round.\n            if changed:\n                self.begin = now\n                self.generation += 1\n            self.previous, self.identity = sample, identity\n            remaining = max(0, math.ceil(self.begin+seconds-now-1e-8))\n            # The user-selected duration is the complete delay. Frozen remains\n            # round-transition evidence, not a second invisible activation gate.\n            phase = \'countdown\' if remaining else \'ready\'\n            self.state = dict(phase=phase, allowed=phase == \'ready\', seconds=seconds,\n                remaining=remaining, deadline=self.begin+seconds, observed_at=now,\n                generation=self.generation, round_count=sample[\'count\'], frozen=sample[\'frozen\'],\n                map=frame.map_name, pid=reader.mem.pid, local_index=local.index,\n                # Reader.local.team is actor m_iTeamNum (+0xa0), not the\n                # PlayerResource presentation-team slot changed by radar UI.\n                local_team=local.team, local_address=local.address, local_serial=local.serial,\n                source=sample[\'source\'])\n        except Exception as exc:\n            # A read error pauses only radar, retaining the deadline on recovery.\n            self.state = dict(phase=\'waiting\', allowed=False, seconds=seconds,\n                observed_at=now, error=str(exc), map=getattr(frame, \'map_name\', None))\n        return dict(self.state)\n\n\ndef notice_lines(state, now=None, language=\'zh\'):\n    state = state or {}\n    phase = state.get(\'phase\', \'waiting\')\n    if phase == \'countdown\':\n        now = time.monotonic() if now is None else now\n        left = max(0, math.ceil(state.get(\'deadline\', now)-now-1e-8))\n        if left:\n            if language==\'en\':\n                warning={2:\'T-exclusive weapons will then be unavailable for purchase.\',\n                         3:\'CT defuse kits will then be unavailable for purchase.\'}.get(\n                    state.get(\'local_team\'),\'Team-exclusive equipment will no longer be available for purchase.\')\n                return (f\'Enemy radar activates in {left} seconds\',warning)\n            warning = BUY_WARNING_BY_TEAM.get(state.get(\'local_team\'), BUY_WARNING)\n            return (f\'{left} 秒后开启雷达显示敌方功能\', warning)\n    # This is a transient countdown, not a persistent status banner. Internal\n    # freeze / validation states stay in diagnostics rather than covering ESP.\n    return ()\n\n\ndef bridge_state(payload, frame, pid, now=None, client_identity=None):\n    state = (payload or {}).get(\'radar_delay\', {})\n    now = time.monotonic() if now is None else now\n    age = now-state.get(\'observed_at\', -math.inf)\n    address, serial = (client_identity if client_identity is not None\n                       else (frame.local.address, frame.local.serial))\n    if (state.get(\'map\') != frame.map_name or state.get(\'pid\') != pid\n            or state.get(\'local_index\') != frame.local.index\n            or state.get(\'local_address\') != address\n            or state.get(\'local_serial\') != serial\n            or state.get(\'local_team\') != frame.local.team or not 0 <= age <= 1.):\n        return dict(phase=\'waiting\', allowed=False)\n    return dict(state)\n\n\ndef display_bridge_state(payload, frame, reader, now=None):\n    """SERVER actor addresses differ from CLIENT; validate each lane separately."""\n    try:\n        client = getattr(reader, \'client_reader\', reader)\n        if getattr(frame, \'source\', \'\') != \'server\':\n            return bridge_state(payload, frame, client.mem.pid, now)\n        if not (payload or {}).get(\'radar_delay\', {}).get(\'pid\'):\n            return dict(phase=\'waiting\', allowed=False)\n        m = client.mem\n        if (m.i32(client.global_addr(\'signon\')) != 6\n                or m.i32(client.global_addr(\'local_index\'))+1 != frame.local.index\n                or m.string(client.global_addr(\'level_name\'),160).replace(\'\\\\\',\'/\') != frame.map_name):\n            return dict(phase=\'waiting\', allowed=False)\n        p = m.u32(client.global_addr(\'local_player\'))\n        address, serial = struct.unpack(\'<II\', m.read(client.global_addr(\'entity_entries\')+frame.local.index*16,8))\n        if not p or p != address or m.i32(p+0xa0) != frame.local.team:\n            return dict(phase=\'waiting\', allowed=False)\n        return bridge_state(payload, frame, m.pid, now, (address, serial))\n    except Exception:\n        return dict(phase=\'waiting\', allowed=False)\n')
_EMBEDDED['radar_delay_ui'] = (1, '"""Compact editable radar delay; incomplete edits retain the last valid value."""\nimport tkinter as tk\nfrom tkinter import ttk\nfrom native_radar import RadarHint\nfrom radar_buy_delay import delay_value, DELAY_HINT\n\n\nclass DelayInput:\n    def __init__(self, parent, checkbox, variable, translate=lambda s:s):\n        self.variable = variable\n        self.last = delay_value(variable.get())\n        # All controls must be actual children of the row. pack(in_=row) on\n        # a sibling gives it valid geometry but lets the row paint over it.\n        self.row = parent\n        if checkbox.master is not parent:\n            raise ValueError(\'Radar checkbox must be created inside its row\')\n        checkbox.pack_forget()\n        checkbox.pack(side=\'left\')\n        self.label = ttk.Label(self.row, text=translate(\'倒计时\'))\n        self.label._i18n_raw_text = \'倒计时\'\n        self.label.pack(side=\'left\', padx=(10, 5))\n        style = ttk.Style(parent)\n        style.configure(\'Radar.TSpinbox\',fieldbackground=\'#0b2038\',background=\'#173d63\',\n                        foreground=\'#b8cde5\',arrowcolor=\'#79b5ff\',bordercolor=\'#29517a\',\n                        lightcolor=\'#29517a\',darkcolor=\'#29517a\',padding=(3,3),arrowsize=12)\n        style.map(\'Radar.TSpinbox\',fieldbackground=[(\'readonly\',\'#0b2038\'),(\'!disabled\',\'#0b2038\')],\n                  foreground=[(\'!disabled\',\'#b8cde5\')],\n                  bordercolor=[(\'focus\',\'#3288ff\'),(\'!focus\',\'#29517a\')])\n        self.entry = ttk.Spinbox(self.row, from_=6, to=15, width=3, textvariable=variable,\n                                 command=self.commit,style=\'Radar.TSpinbox\',justify=\'center\')\n        self.entry.pack(side=\'left\')\n        self.unit = ttk.Label(self.row, text=translate(\'秒\'))\n        self.unit._i18n_raw_text = \'秒\'\n        self.unit.pack(side=\'left\', padx=(5, 0))\n        self.entry.configure(validate=\'key\', validatecommand=(self.entry.register(\n            lambda s: not s or (len(s)<=2 and s.isascii() and s.isdecimal())), \'%P\'))\n        self.entry.bind(\'<FocusOut>\', self.commit)\n        self.entry.bind(\'<Return>\', self.commit)\n        self.tips = [RadarHint(w, translate, text=DELAY_HINT) for w in (self.label,self.entry,self.unit)]\n\n    def value(self):\n        raw = str(self.variable.get()).strip()\n        if raw.isascii() and raw.isdecimal() and 6 <= int(raw) <= 15:\n            self.last = int(raw)\n        return self.last\n\n    def commit(self, event=None):\n        raw = str(self.variable.get()).strip()\n        self.last = delay_value(raw) if raw.isascii() and raw.isdecimal() else self.last\n        self.variable.set(str(self.last))\n        return self.last\n')

_EMBEDDED['weapon_accuracy'] = (1, '"""Persistent event-level weapon evidence, independent of per-match log budgets.\n\nSQLite transactions keep events and aggregates together. Only BattleLog\'s\nwriter calls this module; no process reads or control-thread disk work.\n"""\nimport hashlib,json,math,os,sqlite3,time\nfrom pathlib import Path\nfrom weapon_profiles import canonical_weapon_name\n\nCOUNTERS=(\'rounds\',\'shot_observations\',\'damage_events\',\'head_events\',\'body_events\',\n          \'generic_events\',\'unknown_events\',\'head_survived\',\'head_zero_health\',\n          \'armored_head_events\',\'damage_total\',\'associated_events\',\'ambiguous_events\',\n          \'observations_without_unique_damage_link\',\'direct_head_attempts\',\n          \'direct_head_hits\',\'direct_head_survived\',\'direct_head_first_request_attempts\',\n          \'direct_head_first_request_kills\',\'direct_head_first_request_survived\',\n          \'body_attempts\',\'penetration_attempts\',\'precision_observations_v2\',\n          \'precision_first_observations_v2\',\'precision_first_linked_v2\',\n          \'precision_first_head_zero_health_v2\',\'precision_first_head_survived_v2\',\n          \'precision_linked_v2\',\'precision_head_hits_v2\',\'precision_body_hits_v2\',\n          \'precision_first_head_hits_v2\',\'precision_first_body_hits_v2\',\n          \'precision_head_zero_health_v2\',\'precision_head_survived_v2\')\nKEEP_CONTEXT=(\'target\',\'target_serial\',\'target_health\',\'model\',\'head_source\',\'aim_part\',\n    \'target_distance\',\'head_radius\',\'local_velocity\',\'target_velocity\',\'local_flags\',\n    \'firing_aim_point\',\'actual_sight\',\'shot_path\',\'head_region\',\'head_model_coord\',\n    \'build\',\'frame_stamp\',\'weapon_identity\',\'fire_decision_stamp\',\'firing_punch\',\'firing_eye_xyz\',\n    \'visibility\',\'direct_commit_lane\')\n\ndef compact_context(row):\n    ctx=row.get(\'prior_aim\') or row.get(\'aim_context\') or {}\n    out={k:ctx[k] for k in KEEP_CONTEXT if k in ctx}\n    for source,keys in (\n        (\'fire_commit\',(\'status\',\'first_request\',\'pose_age_ms\',\'post_weapon_pose_age_ms\',\'error_deg\',\'tolerance_deg\')),\n        (\'fire_cadence\',(\'interval\',\'effective_interval\',\'configured_interval\',\'interval_basis\',\'spread_hint\',\n                         \'target_angular_radius\',\'recovery_source\',\'profile_hash\',\'recovery_reference_at\',\'next_press_at\')),\n        (\'fire_snapshot\',(\'stamp\',\'point\',\'part\',\'point_id\',\'aim_region\',\'head_region\',\'head_model_coord\',\n                         \'pose_stamp\',\'profile_hash\',\'path\',\'eye\',\'angles\',\'punch\')),\n        (\'head_motion\',(\'active\',\'reason\',\'prediction_ready\',\'prediction_fallback\',\'horizon_ms\',\'offset_units\',\n                        \'offset\',\'observed_velocity\',\'motion_side_basis\',\'motion_side_velocity\',\'relative_velocity\',\n                        \'anchor_id\',\'anchor_offset\',\'preserved_radius_fraction\',\'timing_basis\')),\n        (\'shot_region\',(\'first_group\',\'allowed\',\'status\'))):\n        value=ctx.get(source) or {}\n        if isinstance(value,dict):out[source]={k:value[k] for k in keys if k in value}\n    # Keep candidate diagnostics separate from temporal ammo/damage linking.\n    # The legacy candidate_count field below remains association-compatible.\n    for source in (\'candidate_refresh\',\'selection_candidates\'):\n        value=ctx.get(source)\n        if value is not None:out[source]=value\n    return clean(out)\n\ndef clean(value,limit=64):\n    if isinstance(value,float):return value if math.isfinite(value) else None\n    if isinstance(value,str):return value[:256]\n    if isinstance(value,(int,bool)) or value is None:return value\n    if isinstance(value,(tuple,list)):return [clean(x,limit) for x in value[:16]]\n    if isinstance(value,dict):return {str(k)[:80]:clean(v,limit) for k,v in list(value.items())[:limit]}\n    return str(value)[:160]\n\ndef encoded(row):return json.dumps(clean(row),ensure_ascii=False,separators=(\',\',\':\'),allow_nan=False)\ndef positive(value):\n    try:return max(0,int(value))\n    except (ValueError,TypeError,OverflowError):return 0\n\nclass AccuracyLedger:\n    def __init__(self,root,clock=time.monotonic):\n        self.root=Path(root);self.root.mkdir(parents=True,exist_ok=True)\n        self.clock=clock;self.last_export=-math.inf;self.changed=False;self.closed=False\n        self.db=sqlite3.connect(self.root/\'weapon_accuracy.sqlite3\',timeout=1.)\n        self.db.execute(\'PRAGMA journal_mode=WAL\');self.db.execute(\'PRAGMA synchronous=FULL\')\n        self.db.executescript(\'\'\'\n        CREATE TABLE IF NOT EXISTS sessions(\n            id TEXT PRIMARY KEY,map TEXT,build TEXT,started TEXT,finished INTEGER DEFAULT 0,\n            dropped INTEGER DEFAULT 0,sink_dropped INTEGER DEFAULT 0,origin TEXT DEFAULT \'live\');\n        CREATE TABLE IF NOT EXISTS profiles(\n            weapon TEXT,hash TEXT,parameters TEXT,PRIMARY KEY(weapon,hash));\n        CREATE TABLE IF NOT EXISTS session_profiles(\n            match_id TEXT,weapon TEXT,hash TEXT,PRIMARY KEY(match_id,weapon));\n        CREATE TABLE IF NOT EXISTS quality(\n            scope TEXT PRIMARY KEY,dropped INTEGER,sink_dropped INTEGER,archive_failures INTEGER,\n            transport_dropped INTEGER,transport_lost INTEGER,last_error TEXT);\n        CREATE TABLE IF NOT EXISTS events(\n            id TEXT PRIMARY KEY,match_id TEXT,kind TEXT,weapon TEXT,mono REAL,time TEXT,\n            target INTEGER,model TEXT,distance REAL,rounds INTEGER,hitgroup TEXT,damage INTEGER,\n            health INTEGER,damage_armor INTEGER,shot_id TEXT,association TEXT,data TEXT);\n        CREATE INDEX IF NOT EXISTS event_match_time ON events(match_id,kind,weapon,target,mono);\n        CREATE INDEX IF NOT EXISTS event_shot_link ON events(shot_id);\n        CREATE TABLE IF NOT EXISTS totals(weapon TEXT,build TEXT,counters TEXT,PRIMARY KEY(weapon,build));\n        CREATE TABLE IF NOT EXISTS model_totals(weapon TEXT,build TEXT,model TEXT,band TEXT,\n            counters TEXT,PRIMARY KEY(weapon,build,model,band));\n        \'\'\');self.db.commit()\n        note=self.root/\'说明.md\'\n        if not note.exists():note.write_text(\'\'\'# 武器实战长期统计\n\nweapon_accuracy.sqlite3 持续保存每次观察耗弹和每次确认伤害，独立于每局诊断日志的体积上限。不记录逐帧骨骼，不自动删除历史数据。\n\nsummary.json 是自动更新的累计汇总，按武器、脚本版本及目标模型/距离分组。rounds 是耗弹数；head_percent_of_all_damage 是头部占全部伤害事件的比例，沿用旧版 68% 的分母。head_percent_of_known_damage 另行排除 generic/unknown，两个指标分别保存。它们都不是逐发命中率。bullet_hit_rate 保持空值，直到有可靠逐发弹道与命中对应证据。\n\nevents 中的 unique_prior_ammo_context 仅表示同局、同枪、同目标、0.5 秒内唯一的单发耗弹上下文。它不证明引擎子弹 ID，也不证明当时模型身份；ambiguous/none 保留原始事件而不硬配。head_survived 与 head_zero_health 区分爆头未死和血量归零。无伤害反馈的耗弹不直接记为确定空枪。\n\nsource_quality 保留日志队列、跨进程传输及独立库写入失败计数；同一日志实例的累计计数取最大值，不跨局重复相加。damage_sink_dropped 是各日志实例观察到的最大值之和，采集源重建时属于下界。写入失败可能发生在事务已提交后的汇总导出阶段，故不冒充精确遗失事件数。过去精简日志未保存的事件不补造。\n\n目标 99.9% 只是用户要求，goal_verified 默认为 false。记录会覆盖所有实际使用的武器，尚未使用的武器没有实战样本。数据库按事件增长；停止使用工具会提交并关闭，重新启动后持续累积。\n\'\'\',\'utf8\')\n\n    def _add(self,weapon,build,counts,model=None,distance=None):\n        table=\'model_totals\' if model else \'totals\'\n        keys=(weapon,build,model,self.band(distance)) if model else (weapon,build)\n        where=\'weapon=? AND build=?\'+(\' AND model=? AND band=?\' if model else \'\')\n        found=self.db.execute(f\'SELECT counters FROM {table} WHERE {where}\',keys).fetchone()\n        totals=json.loads(found[0]) if found else {k:0 for k in COUNTERS}\n        for k,v in counts.items():totals[k]=totals.get(k,0)+v\n        placeholders=\',\'.join(\'?\' for _ in (*keys,0))\n        self.db.execute(f\'INSERT OR REPLACE INTO {table} VALUES({placeholders})\',(*keys,encoded(totals)))\n\n    @staticmethod\n    def band(distance):\n        if not isinstance(distance,(int,float)) or not math.isfinite(distance):return \'unknown\'\n        return \'0-255\' if distance<256 else \'256-511\' if distance<512 else \'512-1023\' if distance<1024 else \'1024-2047\' if distance<2048 else \'2048+\'\n\n    def record(self,match,row):\n        kind=row.get(\'kind\');weapon=canonical_weapon_name(row.get(\'weapon\')) or \'unknown\'\n        if kind not in (\'match_start\',\'match_end\',\'weapon_profile\',\'ammo_decreased\',\'confirmed_damage\'):\n            self.export();return\n        with self.db:\n            self.db.execute(\'INSERT OR IGNORE INTO sessions(id,map,build,started) VALUES(?,?,?,?)\',\n                (match,row.get(\'map\',\'\'),row.get(\'build\') or row.get(\'bundle_revision\',\'unknown\'),row.get(\'time\',\'\')))\n            if kind==\'match_start\':\n                self.db.execute(\'UPDATE sessions SET map=?,build=?,started=? WHERE id=?\',\n                    (row.get(\'map\',\'\'),row.get(\'build\') or row.get(\'bundle_revision\',\'unknown\'),row.get(\'time\',\'\'),match))\n            elif kind==\'match_end\':self.db.execute(\'UPDATE sessions SET finished=1 WHERE id=?\',(match,))\n            elif kind==\'weapon_profile\':\n                p=json.dumps(clean(row.get(\'parameters\') or {},256),ensure_ascii=False,sort_keys=True,separators=(\',\',\':\'),allow_nan=False)\n                digest=hashlib.sha256(p.encode()).hexdigest()\n                self.db.execute(\'INSERT OR IGNORE INTO profiles VALUES(?,?,?)\',(weapon,digest,p))\n                self.db.execute(\'INSERT OR REPLACE INTO session_profiles VALUES(?,?,?)\',(match,weapon,digest))\n            else:self._evidence(match,kind,weapon,row)\n        self.changed=True;self.export(force=kind==\'match_end\')\n\n    def _evidence(self,match,kind,weapon,row):\n        if kind==\'ammo_decreased\':key=match+\':ammo:\'+str(row.get(\'observation_id\') or (row.get(\'mono\'),row.get(\'clip_after\')))\n        else:key=match+\':damage:\'+str(row.get(\'sequence\') if row.get(\'sequence\') is not None else (row.get(\'event_id\') or (row.get(\'mono\'),row.get(\'victim_id\'),row.get(\'damage\'))))\n        if self.db.execute(\'SELECT 1 FROM events WHERE id=?\',(key,)).fetchone():return\n        ctx=compact_context(row);target=ctx.get(\'target\') if kind==\'ammo_decreased\' else row.get(\'victim_index\')\n        mono=row.get(\'mono\');mono=mono if isinstance(mono,(int,float)) and math.isfinite(mono) else 0.\n        shots=[];association=\'not_applicable\';shot_id=None\n        if kind==\'confirmed_damage\':\n            shots=self.db.execute(\'SELECT id,rounds,data FROM events WHERE match_id=? AND kind=? AND weapon=? AND target=? AND mono BETWEEN ? AND ? ORDER BY mono\',\n                (match,\'ammo_decreased\',weapon,target,mono-.5,mono)).fetchall() if target else []\n            association=\'unique_prior_ammo_context\' if len(shots)==1 and shots[0][1]==1 else \'ambiguous\' if shots else \'none\'\n            if association==\'unique_prior_ammo_context\':\n                shot_id=shots[0][0];ctx=json.loads(shots[0][2]).get(\'context\',{})\n        group=str(row.get(\'hitgroup\',\'unknown\')).strip().casefold().replace(\'_\',\' \')\n        numeric={\'0\':\'generic\',\'1\':\'head\',\'2\':\'chest\',\'3\':\'stomach\',\'4\':\'left arm\',\'5\':\'right arm\',\'6\':\'left leg\',\'7\':\'right leg\'}\n        group=numeric.get(str(group),str(group))\n        selection=ctx.get(\'selection_candidates\') if isinstance(ctx.get(\'selection_candidates\'),list) else []\n        candidate_scan_count=len(selection)\n        visible_candidate_count=sum(1 for item in selection\n            if isinstance(item,dict) and item.get(\'tier\')==0)\n        direct_head_candidate_count=sum(1 for item in selection\n            if isinstance(item,dict) and item.get(\'tier\')==0 and item.get(\'part\')==\'head\')\n        data=dict(time=row.get(\'time\'),source=row.get(\'source\'),sequence=row.get(\'sequence\'),\n            server_time=row.get(\'server_time\'),observation_id=row.get(\'observation_id\'),\n            context=ctx,association=association,bullet_link_verified=False,\n            sample_interval=row.get(\'sample_interval\'),candidate_count=len(shots),armor=row.get(\'armor\'),\n            candidate_scan_count=candidate_scan_count,\n            visible_candidate_count=visible_candidate_count,\n            direct_head_candidate_count=direct_head_candidate_count,\n            associated_ammo_count=len(shots),\n            feedback_available=row.get(\'damage_log_available\'),feedback_error=row.get(\'damage_log_error\'))\n        if kind==\'ammo_decreased\' and row.get(\'accepted_fire_request\'):\n            # Keep request-time evidence alongside the historical prior-frame\n            # context. Do not silently rewrite existing hit-rate denominators.\n            data[\'accepted_fire_request\']=clean(row[\'accepted_fire_request\'])\n        profile=self.db.execute(\'SELECT hash FROM session_profiles WHERE match_id=? AND weapon=?\',(match,weapon)).fetchone()\n        data.update(script_profile_hash=profile[0] if profile else None,trigger_was_held=row.get(\'trigger_was_held\'),\n            attacker_index=row.get(\'attacker_index\'),victim_index=row.get(\'victim_index\'),\n            prior_context_age_ms=row.get(\'prior_context_age_ms\'),weapon_identity=row.get(\'weapon_identity\'))\n        model=ctx.get(\'model\');distance=ctx.get(\'target_distance\')\n        rounds=positive(row.get(\'rounds\')) if kind==\'ammo_decreased\' else 0\n        amount=positive(row.get(\'damage\'));health=row.get(\'health\');armor=positive(row.get(\'damage_armor\'))\n        try:health=int(health) if health is not None else None\n        except (ValueError,TypeError,OverflowError):health=None\n        first_link=bool(shot_id and not self.db.execute(\'SELECT 1 FROM events WHERE shot_id=? LIMIT 1\',(shot_id,)).fetchone())\n        build=ctx.get(\'build\') or self.db.execute(\'SELECT build FROM sessions WHERE id=?\',(match,)).fetchone()[0]\n        counts=dict(rounds=rounds,shot_observations=kind==\'ammo_decreased\')\n        counts[\'observations_without_unique_damage_link\']=1 if kind==\'ammo_decreased\' else -int(first_link)\n        if kind==\'ammo_decreased\':\n            snap=ctx.get(\'fire_snapshot\') or {};commit=ctx.get(\'fire_commit\') or {}\n            direct=bool(rounds==1 and ctx.get(\'aim_part\')==\'head\' and\n                        snap.get(\'path\')==\'clear\' and snap.get(\'part\')==\'head\')\n            first=bool(direct and commit.get(\'first_request\') is True)\n            # Denominator is observed ammunition expenditure, including rows\n            # with no unique damage association. No feedback remains unknown.\n            counts.update(precision_observations_v2=int(direct),precision_first_observations_v2=int(first))\n            data[\'precision_observation_v2\']=dict(direct=direct,first_request=first,\n                basis=\'single_round_observation_with_engagement_context_not_engine_bullet_id\')\n        if kind==\'confirmed_damage\':\n            snap=ctx.get(\'fire_snapshot\') or {};commit=ctx.get(\'fire_commit\') or {}\n            direct=bool(association==\'unique_prior_ammo_context\' and\n                        snap.get(\'path\')==\'clear\' and snap.get(\'part\')==\'head\' and\n                        ctx.get(\'aim_part\')==\'head\')\n            first_request=bool(direct and commit.get(\'first_request\') is True)\n            counts.update(damage_events=1,damage_total=amount,head_events=group==\'head\',\n                body_events=group in (\'chest\',\'stomach\',\'left arm\',\'right arm\',\'left leg\',\'right leg\',\'body\'),\n                generic_events=group==\'generic\',unknown_events=group not in (\'head\',\'chest\',\'stomach\',\'left arm\',\'right arm\',\'left leg\',\'right leg\',\'body\',\'generic\'),\n                head_survived=group==\'head\' and isinstance(health,(int,float)) and health>0,\n                head_zero_health=group==\'head\' and health==0,armored_head_events=group==\'head\' and armor>0,\n                associated_events=association==\'unique_prior_ammo_context\',ambiguous_eve