self.lib.BCryptGenerateSymmetricKey(self.provider,C.byref(self.handle),None,0,secret,len(key),0))\n\n    @staticmethod\n\n    def check(status):\n\n        if status<0:raise OSError(f\'Windows AES error 0x{status&0xffffffff:08x}\')\n\n    def decrypt(self,data):\n\n        if len(data)%self.block_size:raise ValueError(\'CBC data not aligned\')\n\n        src=C.create_string_buffer(data);dst=C.create_string_buffer(len(data));iv=C.create_string_buffer(self.block_size);n=C.c_ulong()\n\n        self.check(self.lib.BCryptDecrypt(self.handle,src,len(data),None,iv,self.block_size,dst,len(data),C.byref(n),0))\n\n        assert n.value==len(data)\n\n        return dst.raw\n\n    def close(self):\n\n        if self.handle:self.lib.BCryptDestroyKey(self.handle);self.handle=None\n\n        if self.provider:self.lib.BCryptCloseAlgorithmProvider(self.provider,0);self.provider=None\n\n    def __enter__(self):return self\n\n    def __exit__(self,*_):self.close()\n\n\n\ndef key_for(secret,name):return hashlib.md5(secret+name.encode(\'ascii\')).hexdigest()[:16].encode(\'ascii\')\n\n\n\ndef read_header(path):\n\n    with path.open(\'rb\') as f:\n\n        f.seek(33);block=f.read(272)\n\n        if len(block)!=272:raise ValueError(\'Not a PKG data archive\')\n\n        for region,secret in enumerate(ENTRY_KEYS):\n\n            with AES(key_for(secret,path.name)) as cipher:\n\n                data=cipher.decrypt(block)\n\n                zero,count=struct.unpack_from(\'<II\',data,261)\n\n                if zero or count>100000 or 305+count*288>path.stat().st_size:continue\n\n                directory=data[:261].split(b\'\\0\')[0].decode(\'utf-8\',errors=\'replace\')\n\n                result=[];start=305+count*288\n\n                for _ in range(count):\n\n                    record=cipher.decrypt(f.read(288))\n\n                    name=record[:261].split(b\'\\0\')[0].decode(\'utf-8\')\n\n                    off,enc,dec=struct.unpack_from(\'<III\',record,261)\n\n                    if off+enc+start>path.stat().st_size or dec>enc:raise ValueError(\'PKG entry out of bounds\')\n\n                    result.append({\'name\':name.replace(\'\\\\\',\'/\').lstrip(\'/\'),\'package\':path.name,\'offset\':start+off,\'stored\':enc,\'size\':dec,\'encrypted\':bool(record[274]),\'region\':region})\n\n                return directory,result\n\n        raise ValueError(\'No known package key matched\')\n\n\n\ndef build_index(root):\n\n    entries={};failures=[];duplicates=[];packages=0\n\n    for path in sorted((Path(root)/\'Data\').glob(\'*.pkg\')):\n\n        try:directory,records=read_header(path)\n\n        except (OSError,ValueError,UnicodeError) as e:\n\n            failures.append({\'package\':path.name,\'error\':str(e)});continue\n\n        packages+=1\n\n        for record in records:\n\n            name=record[\'name\'].lower()\n\n            if name in entries:duplicates.append(name)\n\n            entries[name]=record\n\n    return {\'packages\':packages,\'entries\':entries,\'failures\':failures,\'duplicates\':duplicates}\n\n\n\n\n\ndef resource_index(root,cache):\n\n    """Index the actual package headers; cache separately for every installation."""\n\n    root=Path(root).resolve();cache=Path(cache)\n\n    packages=sorted((root/\'Data\').glob(\'*.pkg\'))\n\n    manifest=[(p.name,p.stat().st_size,p.stat().st_mtime_ns) for p in packages]\n\n    identity=hashlib.sha256(json.dumps([2,str(root).casefold(),manifest],ensure_ascii=False).encode()).hexdigest()\n\n    cachefile=cache/(identity+\'.json\');index=None\n\n    try:\n\n        saved=json.loads(cachefile.read_text(encoding=\'utf-8\'))\n\n        if isinstance(saved,dict) and saved.get(\'identity\')==identity and isinstance(saved.get(\'entries\'),dict):index=saved[\'entries\']\n\n    except (OSError,ValueError):pass\n\n    if index is None:\n\n        index={};failures=[];transient_failure=False\n\n        for path in packages:\n\n            try:_,records=read_header(path)\n\n            except (OSError,ValueError,UnicodeError) as ex:\n\n                transient_failure|=isinstance(ex,OSError)\n\n                failures.append({\'package\':path.name,\'error\':str(ex)});continue\n\n            for record in records:\n\n                key=record[\'name\'].lower()\n\n                if ((key.startswith(\'cstrike/maps/\') and key.endswith(\'.bsp\')) or\n\n                        (key.startswith(\'cstrike/materials/\') and key.endswith(\'.vmt\'))):index[key]=record\n\n        # Unsupported package encryption is stable until the manifest changes.\n\n        # Files temporarily unreadable must be retried instead of cached away.\n\n        if not transient_failure:\n\n            try:\n\n                cache.mkdir(parents=True,exist_ok=True)\n\n                fd,temp=tempfile.mkstemp(prefix=\'.index-\',suffix=\'.tmp\',dir=cache)\n\n                try:\n\n                    with os.fdopen(fd,\'w\',encoding=\'utf-8\') as stream:json.dump(dict(identity=identity,entries=index,failures=failures),stream)\n\n                    os.replace(temp,cachefile)\n\n                finally:\n\n                    if Path(temp).exists():Path(temp).unlink()\n\n            except OSError:pass\n\n    return index,identity\n\n\n\n\n\ndef map_entry(root,name,cache):\n\n    root=Path(root);index,identity=resource_index(root,cache);entry=index.get(name.lower())\n\n    if entry:\n\n        # Revalidate the chosen record against its current header, including cache hits.\n\n        package=entry.get(\'package\',\'\')\n\n        if Path(package).name!=package:raise ValueError(\'地图索引的资源包路径无效\')\n\n        _,records=read_header(root/\'Data\'/package)\n\n        entry=next((r for r in reversed(records) if r[\'name\'].lower()==name.lower()),None)\n\n    return entry,identity\n\n\n\ndef extract(root,entry):\n\n    with (Path(root)/\'Data\'/entry[\'package\']).open(\'rb\') as f:\n\n        f.seek(entry[\'offset\']);data=f.read(entry[\'stored\'])\n\n    if len(data)!=entry[\'stored\']:raise ValueError(\'Truncated resource\')\n\n    if entry[\'encrypted\']:\n\n        name=entry[\'name\'].rsplit(\'/\',1)[-1]\n\n        with AES(key_for(DATA_KEYS[entry[\'region\']],name)) as cipher:\n\n            data=b\'\'.join(cipher.decrypt(data[i:i+65536]) for i in range(0,len(data),65536))\n\n    return data[:entry[\'size\']]\n\n\n\nif __name__==\'__main__\':\n\n    import argparse\n\n    p=argparse.ArgumentParser();p.add_argument(\'root\');p.add_argument(\'output\');args=p.parse_args()\n\n    result=build_index(args.root)\n\n    Path(args.output).write_text(json.dumps(result,ensure_ascii=False,indent=2),encoding=\'utf-8\')\n\n    print(json.dumps({\'packages\':result[\'packages\'],\'entries\':len(result[\'entries\']),\'failures\':result[\'failures\'][:6],\'duplicates\':len(result[\'duplicates\'])}))\n\n')





