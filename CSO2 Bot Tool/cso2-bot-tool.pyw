_EMBEDDED['wall_capability']=(1, '"""Current-map optional resources. No drive scan, input, or frame-loop file I/O."""\nimport hashlib\nimport json\nimport threading\nimport time\nimport zlib\nfrom dataclasses import replace\nfrom pathlib import Path\n\n\ndef map_key(value):\n    return Path(str(value or \'\').replace(\'\\\\\', \'/\')).stem.lower()\n\n\ndef _inspect_map_snapshot(name):\n    """Validate only this world\'s dependencies, including shared prop models."""\n    from collision_cache_io import read_blob, resource_locations\n    from wall_training import _GEOMETRY_B85\n    from static_guard_data import GUARD_DATA, MODEL_DATA\n    key = map_key(name)\n    location = resource_locations()\n    checked = []\n    current_relative = \'wall_data_index.json\'\n    def read(values, item):\n        nonlocal current_relative\n        current_relative = \'wall_data_index.json\'\n        relative, expected = values.manifest[item]\n        current_relative = relative\n        raw = read_blob(relative, expected)\n        checked.append((relative, expected))\n        return raw\n    if key not in _GEOMETRY_B85.manifest or key not in GUARD_DATA.manifest:\n        return dict(available=False, state=\'untrained\', error=\'当前地图尚无预训练墙体数据\', files=0, **location)\n    try:\n        read(_GEOMETRY_B85, key)\n        props = json.loads(zlib.decompress(read(GUARD_DATA, key)))\n        if not isinstance(props, dict) or not isinstance(props.get(\'models\'), dict):\n            raise ValueError(\'static prop model references invalid\')\n        if any(not isinstance(value,str) for value in props[\'models\'].values()):\n            raise ValueError(\'static prop model identity invalid\')\n        for identity in sorted(set(props[\'models\'].values())):\n            read(MODEL_DATA, identity)\n    except FileNotFoundError as exc:\n        return dict(available=False, state=\'missing\', error=str(exc), files=len(checked),\n                    resource_relative=getattr(exc, \'resource_relative\', current_relative), **location)\n    except (OSError, ValueError, KeyError, TypeError, zlib.error) as exc:\n        return dict(available=False, state=\'invalid\', error=str(exc), files=len(checked),\n                    resource_relative=getattr(exc, \'resource_relative\', current_relative), **location)\n    from collision_cache_io import map_metadata_token\n    token = hashlib.sha256(json.dumps([checked, map_metadata_token(key)], sort_keys=True).encode()).hexdigest()\n    return dict(available=True, state=\'ready\', error=\'\', files=len(checked), token=token, **location)\n\n\ndef inspect_map(name):\n    from collision_cache_io import data_snapshot, resource_locations, INDEX_NAME\n    try:\n        with data_snapshot(refresh=True):\n            return _inspect_map_snapshot(name)\n    except (OSError, ValueError, KeyError, TypeError) as exc:\n        return dict(available=False, state=\'invalid\', error=str(exc), files=0,\n                    resource_relative=getattr(exc, \'resource_relative\', INDEX_NAME),\n                    **resource_locations())\n\n\nclass MapResources:\n    """One bounded background job, late-map results discarded by epoch."""\n    def __init__(self, probe=None, clock=None, interval=2.):\n        self.probe = probe or inspect_map\n        self.clock = clock or time.monotonic\n        self.interval = interval\n        self.lock = threading.Lock()\n        self.epoch = 0\n        self.key = \'\'\n        self.scope = None\n        self.name = \'\'\n        self.next_at = 0.\n        self.running = False\n        self.closed = False\n        self.generation = 0\n        self.result = dict(available=False, state=\'idle\', error=\'\')\n\n    def update(self, name, scope=None):\n        key = map_key(name)\n        now = self.clock()\n        with self.lock:\n            if (key, scope) != (self.key, self.scope):\n                self.key, self.name, self.scope = key, str(name or \'\'), scope\n                self.epoch += 1\n                self.next_at = 0.\n                self.result = dict(available=False, state=\'loading\' if key else \'idle\', error=\'\')\n            job = None\n            if key and not self.closed and not self.running and now >= self.next_at:\n                self.running = True\n                self.next_at = now + self.interval\n                job = (self.epoch, self.name)\n            result = dict(self.result, map_name=self.name, map_key=self.key, generation=self.generation)\n        if job:\n            try:\n                threading.Thread(target=self._run, args=job, name=\'CSO2-current-map-resources\', daemon=True).start()\n            except RuntimeError as exc:\n                self._publish(job[0], dict(available=False, state=\'invalid\', error=str(exc)))\n        return result\n\n    def _run(self, epoch, name):\n        try:\n            result = self.probe(name)\n        except Exception as exc:\n            result = dict(available=False, state=\'invalid\', error=type(exc).__name__ + \': \' + str(exc))\n        self._publish(epoch, result)\n\n    def _publish(self, epoch, result):\n        with self.lock:\n            self.running = False\n            if self.closed or epoch != self.epoch:\n                return\n            if result != self.result:\n                self.generation += 1\n            self.result = dict(result)\n\n    def close(self):\n        with self.lock:\n            self.closed = True\n            self.epoch += 1\n\n\ndef warning_for(state, current_map):\n    return bool(map_key(current_map) and isinstance(state, dict)\n                and state.get(\'map_key\') == map_key(current_map)\n                and state.get(\'state\') in (\'missing\', \'invalid\', \'untrained\'))\n\n\ndef notice_lines(state, current_map):\n    if not warning_for(state, current_map):\n        return ()\n    name = Path(str(current_map).replace(\'\\\\\', \'/\')).stem\n    if state.get(\'state\') == \'untrained\':\n        return (\'当前地图没有墙体训练数据，地图名字是：\' + name, \'静态墙体未支持；快去训练！自动准星继续基础模式。\')\n    relative = state.get(\'resource_relative\')\n    detail = (\'资源文件：\' + str(relative),) if relative else ()\n    if state.get(\'state\') == \'invalid\':\n        return (\'BOT TOOL 墙体资源不可用，地图名字是：\' + name,) + detail + (\'请修复外部障碍物数据（1 - Shoot Through Data 射击穿透数据）！！！\',)\n    return (\'检测到 BOT TOOL 缺少墙体资源，地图名字是：\' + name,) + detail + (\'请补全外部障碍物数据（1 - Shoot Through Data 射击穿透数据）！！！\',)\n\n\n\n\n\n\n\n\n\n\n\n\ndef gradient_color(index, count):\n    ratio = index / max(1, count - 1)\n    return \'#ff%02x%02x\' % (round(213 + (76 - 213) * ratio), round(74 + (61 - 74) * ratio))\n')
_EMBEDDED['hotplug48_contract'] = (1, '"""Hot-unplug, current-map notice, and basic input path regressions; no game input."""\nimport copy,hashlib,io,json,tempfile,threading,time,unittest,zlib\nfrom pathlib import Path\nfrom dataclasses import replace\nfrom unittest.mock import patch\nimport wall_capability as cap\nfrom cso2_bot_tool import Config\n\n\ndef run():\n    class Hotplug(unittest.TestCase):\n        def test_defaults(self):\n            self.assertTrue(Config().walls);self.assertTrue(Config().wallbang)\n        def test_current_map_only(self):\n            state=dict(map_key=\'zm_minecraft\',state=\'missing\',available=False)\n            self.assertTrue(cap.warning_for(state,\'maps/ZM_MINECRAFT.bsp\'))\n            for name in (\'cs_italy\',\'\',\'de_dust2\'):self.assertFalse(cap.warning_for(state,name))\n            self.assertEqual(cap.notice_lines(state,\'ZM_MINECRAFT\'),(\'检测到 BOT TOOL 缺少墙体资源，地图名字是：ZM_MINECRAFT\',\'请补全外部障碍物数据（1 - Shoot Through Data 射击穿透数据）！！！\'))\n        def test_loading_ready_lobby_silent(self):\n            for state in (\'ready\',\'loading\',\'idle\'):\n                self.assertFalse(cap.notice_lines(dict(map_key=\'cs_italy\',state=state),\'cs_italy\'))\n        def test_optional_resources_never_rewrite_control_intent(self):\n            cfg=Config(walls=True,wallbang=True)\n            before=copy.deepcopy(cfg.__dict__)\n            for state in (\'missing\',\'invalid\',\'loading\',\'ready\'):\n                cap.warning_for(dict(map_key=\'a\',state=state,available=state==\'ready\'),\'a\')\n                self.assertEqual(cfg.__dict__,before)\n        def wait_monitor(self,m,name):\n            deadline=time.monotonic()+3\n            while time.monotonic()<deadline:\n                s=m.update(name)\n                if not m.running and s[\'state\'] not in (\'loading\',\'idle\'):return m.update(name)\n                time.sleep(.002)\n            self.fail(\'resource monitor did not complete\')\n        def test_reinsert_same_map(self):\n            now=[0.];ready=[False];calls=[]\n            def probe(name):\n                calls.append(name);return dict(available=ready[0],state=\'ready\' if ready[0] else \'missing\',error=\'\')\n            m=cap.MapResources(probe,clock=lambda:now[0]);self.addCleanup(m.close)\n            self.assertEqual(self.wait_monitor(m,\'a\')[\'state\'],\'missing\')\n            for _ in range(20):m.update(\'a\')\n            self.assertEqual(calls,[\'a\'])\n            ready[0]=True;now[0]=3\n            self.assertEqual(self.wait_monitor(m,\'a\')[\'state\'],\'ready\')\n            ready[0]=False;now[0]=6\n            self.assertEqual(self.wait_monitor(m,\'a\')[\'state\'],\'missing\')\n        def test_late_old_map_is_discarded(self):\n            started=threading.Event();release=threading.Event()\n            def probe(name):\n                if name==\'a\':started.set();release.wait(2)\n                return dict(available=name==\'b\',state=\'ready\' if name==\'b\' else \'missing\',error=\'\')\n            m=cap.MapResources(probe);self.addCleanup(m.close)\n            m.update(\'a\');self.assertTrue(started.wait(1))\n            m.update(\'b\');release.set()\n            state=self.wait_monitor(m,\'b\')\n            self.assertEqual(state[\'map_key\'],\'b\');self.assertEqual(state[\'state\'],\'ready\')\n            self.assertFalse(cap.warning_for(m.update(\'\'),\'b\'))\n        def test_only_current_resources_and_checksums(self):\n            import collision_cache_io as cache,wall_training,static_guard_data as guards\n            with tempfile.TemporaryDirectory(prefix=\'hotplug48 \') as temp:\n                root=Path(temp)\n                def manifest(path,data):\n                    p=root/path;p.parent.mkdir(parents=True,exist_ok=True);p.write_bytes(data)\n                    return [path,hashlib.sha256(data).hexdigest()]\n                world={\'a\':manifest(\'world_a.bin\',b\'A\'),\'b\':[\'world_b.bin\',\'0\'*64]}\n                props={\'a\':manifest(\'props_a.bin\',zlib.compress(json.dumps({\'models\':{\'one\':\'model1\'}}).encode()))}\n                models={\'model1\':manifest(\'model_one.bin\',b\'hull\')}\n                with patch.object(cache,\'CACHE_ROOT\',root),patch.object(wall_training,\'_GEOMETRY_B85\',cache.FrozenBlobMap(world)),patch.object(guards,\'GUARD_DATA\',cache.FrozenBlobMap(props)),patch.object(guards,\'MODEL_DATA\',cache.FrozenBlobMap(models)):\n                    self.assertTrue(cap.inspect_map(\'a\')[\'available\'])\n                    p=root/\'world_a.bin\';p.unlink()\n                    self.assertEqual(cap.inspect_map(\'a\')[\'state\'],\'missing\')\n                    p.write_bytes(b\'X\');self.assertEqual(cap.inspect_map(\'a\')[\'state\'],\'invalid\')\n                    p.write_bytes(b\'A\');self.assertTrue(cap.inspect_map(\'a\')[\'available\'])\n                    (root/\'model_one.bin\').unlink();self.assertEqual(cap.inspect_map(\'a\')[\'state\'],\'missing\')\n                    self.assertEqual(cap.inspect_map(\'new_map\')[\'state\'],\'untrained\')\n        def basic(self):\n            from aim_selection_contract import screen_fixture\n            f=screen_fixture(error=0);f.cfg=replace(f.cfg,walls=False,wallbang=True)\n            for e in f.frame.entities:\n                # The ESP has explicitly published these current clear points.\n                # Missing local wall files must neither veto nor invent them.\n                e.visibility=\'visible\';e.penetration={}\n                for p in e.aim_points:p.visibility=\'visible\';p.penetration={}\n            return f\n        def test_basic_aim_without_wall_files(self):\n            f=self.basic()\n            with patch(\'wall_service.load_map\',side_effect=AssertionError(\'no file dependency\')):\n                f.control.step(f.reader,f.frame,f.cfg,f.weapon,None)\n            d=f.control.diagnostic\n            self.assertEqual(f.control.target,2,d);self.assertTrue(d.get(\'fire_allowed\'),d)\n            self.assertIn(True,f.inputs.events)\n            self.assertEqual(d[\'penetration\'][\'basis\'],\'esp_published_point\')\n            self.assertEqual(d[\'penetration\'][\'esp_verdict\'],\'visible\')\n        def test_unpublished_points_are_not_promoted_without_wall_files(self):\n            f=self.basic()\n            for e in f.frame.entities:\n                e.visibility=\'blocked\'\n                for p in e.aim_points:p.visibility=\'blocked\'\n            f.control.step(f.reader,f.frame,f.cfg,f.weapon,None)\n            self.assertEqual(f.control.target,0)\n            self.assertNotIn(True,f.inputs.events)\n        def test_loading_failure_and_ready_leave_published_control_path_intact(self):\n            from types import SimpleNamespace as NS\n            original=Config(walls=True,wallbang=True)\n            before=copy.deepcopy(original.__dict__)\n            for service in (None,NS(fast_bsp=None),NS(fast_bsp=object())):\n                f=self.basic();f.cfg=replace(original,screen_acquire=True)\n                f.control.step(f.reader,f.frame,f.cfg,f.weapon,service)\n                self.assertTrue(f.control.diagnostic.get(\'fire_allowed\'),f.control.diagnostic)\n                self.assertEqual(original.__dict__,before)\n        def test_basic_does_not_call_existing_wall_service(self):\n            f=self.basic()\n            f.wall.refresh_candidates=lambda *a:(_ for _ in ()).throw(AssertionError(\'static wall called\'))\n            f.control.step(f.reader,f.frame,f.cfg,f.weapon,f.wall)\n            self.assertTrue(f.control.diagnostic.get(\'fire_allowed\'))\n            self.assertNotIn(\'static_prop_guard\',f.control.diagnostic)\n        def test_basic_rechecks_pose_and_input_guards(self):\n            for reason in (\'ammo\',\'foreground\',\'readback\',\'dead\',\'outside\',\'stale\'):\n                f=self.basic()\n                if reason==\'ammo\':f.frame.ammo=0\n                elif reason==\'foreground\':f.inputs.active=False\n                elif reason==\'readback\':f.reader.bad_readback=True\n                elif reason==\'dead\':f.reader.entity.health=0\n                elif reason==\'stale\':f.frame.stamp-=1\n                elif reason==\'outside\':f.frame.matrix=(0.,1.,0.,0.,0.,0.,1.,-64.,0.,0.,0.,0.,-1.,0.,0.,0.)\n                f.control.step(f.reader,f.frame,f.cfg,f.weapon,None)\n                self.assertNotIn(True,f.inputs.events,(reason,f.control.diagnostic))\n        def test_gradient(self):\n            self.assertEqual(cap.gradient_color(0,10),\'#ffd54a\')\n            self.assertEqual(cap.gradient_color(9,10),\'#ff4c3d\')\n        def test_widget_under_radar_and_wraps(self):\n            import tkinter as tk\n            from ui_components import WallResourceNotice\n            root=tk.Tk();root.withdraw();self.addCleanup(root.destroy)\n            panel=tk.Frame(root);panel.pack(fill=\'x\')\n            radar=tk.Label(panel,text=\'雷达显示敌方已开启\');radar.pack()\n            notice=WallResourceNotice(panel)\n            notice.set_lines(cap.notice_lines(dict(map_key=\'zm_minecraft\',state=\'missing\'),\'ZM_MINECRAFT\'))\n            root.geometry(\'360x360\');root.deiconify();root.update();notice.fit();root.update()\n            self.assertEqual(panel.pack_slaves(),[radar,notice])\n            self.assertEqual(notice.cget(\'borderwidth\'),0)\n            self.assertIn(\'bold\',str(notice.cget(\'font\')))\n            self.assertGreater(int(notice.cget(\'height\')),2)\n            self.assertEqual(notice.get(\'1.0\',\'end-1c\'),\'\\n\'.join(notice.lines))\n            notice.set_lines(());self.assertFalse(notice.winfo_manager())\n    stream=io.StringIO();r=unittest.TextTestRunner(stream=stream,verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(Hotplug))\n    if not r.wasSuccessful():raise AssertionError(stream.getvalue())\n    return dict(passed=True,tests=r.testsRun,game_attached=False,input_sent=False,raw_visibility=\'screen_candidate_not_native_line_of_sight\')\n')





_EMBEDDED['migration_contract'] = (1, '"""Portable paths and truthful visibility diagnostics; no game/process input."""\nimport base64\nimport hashlib\nimport io\nimport tempfile\nimport time\nimport unittest\nfrom pathlib import Path\nfrom unittest.mock import patch\n\n\ndef run():\n    import collision_cache_io as cache\n    from esp_pipeline import CurrentFrameVisibility\n    from esp_skeleton_rules import fixture\n    from cso2_bot_tool import Config\n\n    class Paths(unittest.TestCase):\n        def setUp(self):\n            self.temp = tempfile.TemporaryDirectory(prefix=\'portable space_\')\n            self.root = Path(self.temp.name)\n            self.addCleanup(self.temp.cleanup)\n            self.entry = self.root/\'中文 relocated\'/\'tool.pyw\'\n            self.entry.parent.mkdir()\n            self.entry.write_text(\'# fixture\', encoding=\'utf-8\')\n\n        def test_relative_to_entry_not_cwd(self):\n            self.assertEqual(cache.cache_root(self.entry,{}),\n                             self.entry.parent/\'1 - Shoot Through Data 射击穿透数据\')\n\n        def test_legacy_sibling_does_not_override_mount(self):\n            p=self.entry.parent/\'collision_cache\';p.mkdir()\n            self.assertEqual(cache.cache_root(self.entry,{}),self.entry.parent/\'1 - Shoot Through Data 射击穿透数据\')\n\n        def test_data_cache_preferred(self):\n            (self.entry.parent/\'collision_cache\').mkdir()\n            p=self.entry.parent/\'1 - Shoot Through Data 射击穿透数据\';p.mkdir(parents=True)\n            self.assertEqual(cache.cache_root(self.entry,{}),p)\n\n        def test_explicit_absolute_override(self):\n            self.assertEqual(cache.cache_root(self.entry,{\'CSO2_COLLISION_CACHE\':str(self.root)}),self.root)\n\n        def test_relative_override_rejected(self):\n            with self.assertRaises(ValueError):cache.cache_root(self.entry,{\'CSO2_COLLISION_CACHE\':\'relative\'})\n\n        def test_missing_error_does_not_leak_absolute_path(self):\n            with patch.object(cache,\'CACHE_ROOT\',self.root):\n                with self.assertRaises(FileNotFoundError) as ctx:cache.read_blob(\'world_map.bin\',\'0\'*64)\n            self.assertNotIn(str(self.root),str(ctx.exception))\n            self.assertIn(\'world_map.bin\',str(ctx.exception))\n\n        def test_resource_becomes_available_without_restart(self):\n            raw=b\'fixture\';digest=hashlib.sha256(raw).hexdigest()\n            with patch.object(cache,\'CACHE_ROOT\',self.root):\n                with self.assertRaises(FileNotFoundError):cache.read_blob(\'new.bin\',digest)\n                (self.root/\'new.bin\').write_bytes(raw)\n                self.assertEqual(cache.read_blob(\'new.bin\',digest),raw)\n\n        def test_checksum_still_required(self):\n            (self.root/\'data.bin\').write_bytes(b\'bad\')\n            with patch.object(cache,\'CACHE_ROOT\',self.root):\n                with self.assertRaises(ValueError):cache.read_blob(\'data.bin\',\'0\'*64)\n\n        def test_bounds_still_required(self):\n            with patch.object(cache,\'CACHE_ROOT\',self.root):\n                with self.assertRaises(ValueError):cache.read_blob(\'../outside.bin\',\'0\'*64)\n\n        def test_mapping_unchanged(self):\n            raw=b\'world payload\';(self.root/\'data.bin\').write_bytes(raw)\n            values=cache.FrozenBlobMap({\'map\':[\'data.bin\',hashlib.sha256(raw).hexdigest()]})\n            with patch.object(cache,\'CACHE_ROOT\',self.root):\n                self.assertEqual(base64.b85decode(values[\'map\']),raw)\n                self.assertEqual(list(values),[\'map\'])\n\n    class Diagnostics(unittest.TestCase):\n        def worker(self,metrics,accepted=True):\n            cfg=Config(esp=True,arrows=True)\n            f=fixture();f.source_epoch=0\n            class FixtureWorker:\n                def __init__(self, payload): self.metrics=dict(payload)\n                def update(self, frame, config):\n                    for actor in frame.entities:\n                        actor.visibility=\'blocked\'\n                        actor.display_visibility_stamp=frame.stamp\n                        actor.wall_age_ms=0.\n                    return None\n                def close(self): pass\n            worker=CurrentFrameVisibility(\'\',factory=lambda _game: FixtureWorker(metrics),\n                                        clock=lambda:f.stamp+.001)\n            if not accepted:\n                worker._ensure_worker=lambda:None\n            return worker,f,cfg\n\n        def test_accepted_result_keeps_loader_error(self):\n            worker,f,cfg=self.worker(dict(state=\'unavailable\',error=\'missing world_map.bin\',accepted=0))\n            worker.prepare(f,f,cfg)\n            self.assertEqual(worker.metrics[\'error\'],\'missing world_map.bin\')\n            self.assertEqual(worker.metrics[\'state\'],\'unavailable\')\n\n        def test_awaiting_pair_keeps_last_failure(self):\n            worker,f,cfg=self.worker({},False)\n            worker.prepare(f,f,cfg)\n            self.assertEqual(worker.metrics[\'state\'],\'unavailable\')\n            self.assertEqual(worker.metrics[\'error\'],\'\')\n\n        def test_real_exception_not_hidden(self):\n            worker,f,cfg=self.worker(dict(state=\'unavailable\',error=\'map load\'))\n            class Broken:\n                metrics={}\n                def update(self,*args): raise RuntimeError(\'worker exception\')\n                def close(self): pass\n            worker.worker_ref=Broken();worker.prepare(f,f,cfg)\n            self.assertEqual(worker.metrics[\'error\'],\'RuntimeError: worker exception\')\n\n        def test_reset_clears_previous_map_metrics(self):\n            worker,f,cfg=self.worker({})\n            worker.last_worker_metrics={\'error\':\'previous map\'};worker.reset()\n            self.assertEqual(worker.last_worker_metrics,{})\n\n        def test_ready_has_no_error(self):\n            worker,f,cfg=self.worker(dict(state=\'ready\',error=\'\',accepted=1))\n            worker.prepare(f,f,cfg)\n            self.assertEqual(worker.metrics[\'state\'],\'ready\')\n            self.assertEqual(worker.metrics[\'error\'],\'\')\n\n    suite=unittest.TestSuite(unittest.defaultTestLoader.loadTestsFromTestCase(c) for c in (Paths,Diagnostics))\n    output=io.StringIO();result=unittest.TextTestRunner(stream=output,verbosity=2).run(suite)\n    if not result.wasSuccessful():raise AssertionError(output.getvalue())\n    return dict(passed=True,tests=result.testsRun,game_attached=False,input_sent=False,gpu_required=False)\n')

_EMBEDDED['repair50_contract'] = (1, '"""ITALY packaging and automatic-rifle fallback regressions; synthetic input only."""\nimport hashlib,io,os,tempfile,unittest\nfrom pathlib import Path\nfrom unittest.mock import patch\n\n\ndef run():\n    import collision_cache_io as cache\n    import wall_capability as cap\n    from click_cadence import click_schedule\n    from combat37_contract import scene,tick,XT97\n    from aim_selection_contract import WEAPON\n\n    # M4 timing copied from 2026-10-01 15:43:58.612\'s aim_fire_decision.\n    # This is a scheduling replay, not a replay of native bullets or spread.\n    logged=dict(cycle=.09,interval=.37762,controlled=True,automatic=True,\n                direct=True,stance=\'air\',rate_model=\'legacy_fallback\',\n                recovery_source=\'script_recovery_parameter\',engine_spread_verified=False)\n    modern=dict(WEAPON,FullAuto=1,WeaponType=\'rifle\',CycleTime=.09,\n                RecoveryTimeStand=.37762,RecoveryTimeCrouch=.26973,\n                Spread=.0006,InaccuracyStand=.007,InaccuracyMove=.06872,\n                InaccuracyJump=.34151,InaccuracyCrouch=.00525,InaccuracyFire=.01266)\n\n    class Cadence(unittest.TestCase):\n        def test_logged_m4_repeats_at_native_cycle(self):\n            q=click_schedule(logged,{},10.091,False,10.,10.04,4)\n            self.assertTrue(q[\'ready\']);self.assertAlmostEqual(q[\'interval\'],.09)\n            self.assertEqual(q[\'wait_reason\'],\'\')\n            self.assertTrue(q[\'removed_unverified_auto_recovery\'])\n        def test_all_stances_keep_native_fallback_cycle(self):\n            for stance in (\'air\',\'stand\',\'crouch\'):\n                q=click_schedule(dict(logged,stance=stance),{},10.091,False,10.,10.04,4)\n                self.assertTrue(q[\'ready\']);self.assertAlmostEqual(q[\'interval\'],.09)\n        def test_no_profile_name_or_hp_unlock(self):\n            for name in (\'CWeaponACR\',\'CWeaponM4A1\',\'CWeaponXT97\',\'new_automatic\'):\n                for hp in (1,120,100000):\n                    q=click_schedule(dict(logged,weapon=name,target_health=hp),{},10.091,False,10.,10.04,4)\n                    self.assertAlmostEqual(q[\'interval\'],.09)\n        def test_original_engine_cycle_is_not_shortened(self):\n            for cycle in (.02,.075,.09,.105,.3,1.5):\n                q=click_schedule(dict(logged,cycle=cycle),{},10.+cycle-.001,False,10.,9.,4)\n                self.assertFalse(q[\'ready\']);self.assertGreaterEqual(q[\'interval\'],cycle)\n        def test_cover_verified_model_and_semi_auto_keep_native_cycle(self):\n            for kw in (dict(automatic=False),dict(engine_spread_verified=True)):\n                q=click_schedule(dict(logged,**kw),{},10.091,False,10.,10.04,4)\n                self.assertTrue(q[\'ready\']);self.assertAlmostEqual(q[\'interval\'],.09)\n                self.assertAlmostEqual(q[\'estimated_policy_interval\'],.37762)\n        def test_all_unverified_automatic_models_use_native_cycle(self):\n            for model in (\'legacy_fallback\',\'script_exponential_envelope_not_live\',\n                          \'legacy_script_curve_geometry_not_live\'):\n                for direct in (False,True):\n                    policy=dict(logged,rate_model=model,direct=direct,stance=\'stand\',\n                                interval=.37762,recovery_source=\'script_recovery_parameter\')\n                    q=click_schedule(policy,{},10.091,False,10.,10.04,4)\n                    self.assertTrue(q[\'ready\']);self.assertAlmostEqual(q[\'interval\'],.09)\n                    self.assertAlmostEqual(q[\'estimated_policy_interval\'],.37762)\n                    self.assertTrue(q[\'removed_unverified_auto_recovery\'])\n                    self.assertEqual(q[\'interval_basis\'],\'native_weapon_cycle\')\n\n        def test_down_up_edges_and_delayed_ammo_still_bounded(self):\n            r=dict(press_at=10.,last_request=10.,last_shot=10.08)\n            self.assertFalse(click_schedule(logged,r,10.003,True,10.,native_state=3)[\'release\'])\n            self.assertTrue(click_schedule(logged,r,10.05,True,10.,native_state=3)[\'release\'])\n            self.assertTrue(click_schedule(logged,r,10.091,False,10.,10.05,4)[\'ready\'])\n            self.assertFalse(click_schedule(logged,r,10.091,False,10.,10.09,4)[\'ready\'])\n        def test_controller_modern_rifles_hold_native_auto_without_feedback_stops(self):\n            for name,cycle in ((\'CWeaponM4A1\',.09),(\'CWeaponACR\',.075)):\n                # ACR cycle is a fixture parameter, not a measured target-host value.\n                f=scene(p=dict(modern,CycleTime=cycle),generic=False,distance=1024.)\n                f.frame.weapon=name;f.frame.weapon_state[\'classname\']=name\n                f.frame.local.flags=256;f.frame.local.velocity=(220.,0.,0.)\n                tick(f,10.);self.assertTrue(f.control.pressed,f.control.diagnostic)\n                tick(f,10.02,True);self.assertTrue(f.control.pressed)\n                self.assertTrue(f.control.diagnostic[\'write_readback_verified\'])\n                previous_press=10.\n                for n in range(1,7):\n                    due=previous_press+cycle+.001\n                    tick(f,due);self.assertTrue(f.control.pressed,f.control.diagnostic)\n                    previous_press=due\n                    tick(f,due+.02,True);self.assertTrue(f.control.pressed)\n                self.assertAlmostEqual(f.control.diagnostic[\'fire_cadence\'][\'interval\'],cycle)\n                self.assertTrue(f.control.diagnostic[\'fire_cadence\'][\'continuous\'])\n                self.assertEqual(f.control.diagnostic[\'fire_cadence\'][\'basis\'],\'native_cycle_and_primary_edges\')\n                self.assertFalse(f.control.diagnostic[\'fire_cadence\'][\'engine_spread_verified\'])\n        def test_xt97_existing_native_cycle_preserved(self):\n            f=scene(p=XT97);tick(f,10.);tick(f,10.02,True);tick(f,10.106)\n            self.assertTrue(f.control.pressed);self.assertAlmostEqual(f.control.diagnostic[\'fire_cadence\'][\'interval\'],.105)\n        def test_switch_does_not_reuse_previous_weapon_recovery(self):\n            f=scene(p=dict(modern,CycleTime=.09),generic=False,distance=1024.)\n            tick(f,10.);tick(f,10.02,True)\n            f.weapon=dict(modern,CycleTime=.075);f.frame.weapon=\'CWeaponACR\'\n            f.frame.weapon_state.update(classname=\'CWeaponACR\',handle=456,address=0x666000)\n            tick(f,10.03)\n            self.assertTrue(f.control.pressed,f.control.diagnostic)\n            self.assertEqual(f.control.diagnostic[\'fire_cadence\'][\'cycle\'],.075)\n\n    class Resources(unittest.TestCase):\n        def setUp(self):\n            self.temp=tempfile.TemporaryDirectory(prefix=\'BOT50 中文 space \')\n            self.addCleanup(self.temp.cleanup);self.root=Path(self.temp.name)\n            self.entry=self.root/\'Moved Package\'/\'CSO2_BOT工具.pyw\';self.entry.parent.mkdir()\n            self.first=self.entry.parent/\'1 - Shoot Through Data 射击穿透数据\'\n            self.second=self.entry.parent/\'collision_cache\'\n            self.raw=b\'ITALY fixture bytes\';self.digest=hashlib.sha256(self.raw).hexdigest()\n            for obj,key,value in ((cache,\'BUNDLE_ENTRY\',self.entry),(cache,\'CACHE_ROOT\',None)):\n                p=patch.object(obj,key,value);p.start();self.addCleanup(p.stop)\n            p=patch.dict(os.environ,{\'CSO2_COLLISION_CACHE\':\'\'});p.start();self.addCleanup(p.stop)\n        def put(self,root,data=None):\n            p=root/\'world_cs_italy.bin\';p.parent.mkdir(parents=True,exist_ok=True)\n            p.write_bytes(self.raw if data is None else data)\n            return p\n        def test_empty_mount_does_not_borrow_legacy_copy(self):\n            self.first.mkdir(parents=True);self.put(self.second)\n            with self.assertRaises(FileNotFoundError):cache.read_blob(\'world_cs_italy.bin\',self.digest)\n        def test_bad_mount_does_not_borrow_legacy_copy(self):\n            self.put(self.first,b\'old\');self.put(self.second)\n            with self.assertRaises(ValueError):cache.read_blob(\'world_cs_italy.bin\',self.digest)\n        def test_both_missing_identifies_tool_not_game_client(self):\n            with self.assertRaises(FileNotFoundError) as e:cache.read_blob(\'world_cs_italy.bin\',self.digest)\n            self.assertIn(\'BOT TOOL\',str(e.exception))\n            self.assertEqual(e.exception.resource_relative,\'world_cs_italy.bin\')\n            locations=cache.resource_locations()\n            self.assertEqual(locations[\'searched_roots\'],[str(self.first)])\n            self.assertFalse(locations[\'game_client_resources_checked\'])\n        def test_explicit_override_stays_authoritative(self):\n            self.put(self.second)\n            with patch.dict(os.environ,{\'CSO2_COLLISION_CACHE\':str(self.root/\'Override\')}):\n                with self.assertRaises(FileNotFoundError):cache.read_blob(\'world_cs_italy.bin\',self.digest)\n        def test_invalid_hash_still_fails_when_no_valid_copy(self):\n            self.put(self.first,b\'bad\');self.put(self.second,b\'bad2\')\n            with self.assertRaises(ValueError):cache.read_blob(\'world_cs_italy.bin\',self.digest)\n        def test_no_cwd_fallback_and_no_drive_scan(self):\n            self.put(self.root/\'collision_cache\')\n            old=Path.cwd();os.chdir(self.root)\n            try:\n                with self.assertRaises(FileNotFoundError):cache.read_blob(\'world_cs_italy.bin\',self.digest)\n            finally:os.chdir(old)\n        def test_resource_reinsert_recovers_same_process(self):\n            with self.assertRaises(FileNotFoundError):cache.read_blob(\'world_cs_italy.bin\',self.digest)\n            p=self.put(self.first);self.assertEqual(cache.read_blob(\'world_cs_italy.bin\',self.digest),self.raw)\n            p.unlink()\n            with self.assertRaises(FileNotFoundError):cache.read_blob(\'world_cs_italy.bin\',self.digest)\n        def test_map_specific_truthful_warning(self):\n            for state in (\'missing\',\'invalid\',\'untrained\'):\n                value=dict(map_key=\'cs_italy\',state=state)\n                text=\'\\n\'.join(cap.notice_lines(value,\'maps/CS_ITALY.bsp\'))\n                self.assertIn(\'CS_ITALY\',text);self.assertNotIn(\'补全客户端\',text)\n                self.assertFalse(cap.notice_lines(value,\'de_dust2\'))\n                if state==\'untrained\':self.assertIn(\'训练\',text)\n                else:self.assertIn(\'外部障碍物数据\',text)\n        def test_no_startup_lobby_or_other_map_warning(self):\n            for current in (\'\',\'de_dust2\'):\n                self.assertFalse(cap.notice_lines(dict(map_key=\'cs_italy\',state=\'missing\'),current))\n            for state in (\'idle\',\'loading\',\'ready\'):\n                self.assertFalse(cap.notice_lines(dict(map_key=\'cs_italy\',state=state),\'cs_italy\'))\n        def test_resource_notices_distinguish_missing_and_untrained(self):\n            for state in (\'missing\',\'invalid\',\'untrained\'):\n                v=dict(map_key=\'cs_italy\',state=state)\n                line=\'\\n\'.join(cap.notice_lines(v,\'CS_ITALY\'))\n                self.assertIn(\'CS_ITALY\',line);self.assertNotIn(\'客户端\',line)\n                self.assertFalse(cap.notice_lines(v,\'de_dust2\'))\n                if state==\'untrained\':self.assertIn(\'训练\',line)\n                else:self.assertNotIn(\'训练\',line)\n\n    suite=unittest.TestSuite(unittest.defaultTestLoader.loadTestsFromTestCase(c) for c in (Cadence,Resources))\n    out=io.StringIO();r=unittest.TextTestRunner(stream=out,verbosity=2).run(suite)\n    if not r.wasSuccessful():raise AssertionError(out.getvalue())\n    return dict(passed=True,tests=r.testsRun,game_attached=False,input_sent=False,\n                m4_logged_cycle=.09,m4_old_fallback_interval=.37762,\n                acr_cycle_source=\'synthetic_fixture\',native_bullet_rate_verified=False)\n')

_EMBEDDED['flat51_contract'] = (1, '"""Flat external mount and current-map dynamic-index regressions; offline only."""\nimport copy, hashlib, io, json, os, tempfile, unittest, zlib\nfrom pathlib import Path\nfrom unittest.mock import patch\n\n\ndef run():\n    import collision_cache_io as cache\n    import wall_capability as cap\n    import wall_training\n    from cso2_bot_tool import Config\n    sha=lambda b:hashlib.sha256(b).hexdigest()\n\n    class FlatData(unittest.TestCase):\n        def setUp(self):\n            self.temp=tempfile.TemporaryDirectory(prefix=\'flat51 中文 \')\n            self.addCleanup(self.temp.cleanup);self.root=Path(self.temp.name)\n            self.mount=self.root/cache.DATA_DIRECTORY;self.mount.mkdir()\n            for obj,key,value in ((cache,\'BUNDLE_ENTRY\',self.root/\'renamed.pyw\'),(cache,\'CACHE_ROOT\',None)):\n                p=patch.object(obj,key,value);p.start();self.addCleanup(p.stop)\n            p=patch.dict(os.environ,{\'CSO2_COLLISION_CACHE\':\'\'});p.start();self.addCleanup(p.stop)\n            self.index=dict(schema=cache.INDEX_SCHEMA,world={},props={},models={},world_meta={},props_meta={})\n            for key in (\'a\',\'b\'):\n                world=key.upper().encode();props=zlib.compress(json.dumps({\'models\':{}}).encode())\n                for family,data in ((\'world\',world),(\'props\',props)):\n                    name=family+\'_\'+key+\'.bin\';(self.mount/name).write_bytes(data)\n                    self.index[family][key]=[name,sha(data)]\n                self.index[\'world_meta\'][key]={\'version\':1}\n            self.save()\n\n        def save(self):\n            (self.mount/cache.INDEX_NAME).write_text(json.dumps(self.index,sort_keys=True),encoding=\'utf-8\')\n\n        def state(self,key=\'a\'):\n            return cap.inspect_map(key)\n\n        def test_directory_is_entry_relative(self):\n            self.assertEqual(cache.cache_root(self.root/\'renamed.pyw\',{}),self.mount)\n            self.assertEqual(cache.resource_roots(),(self.mount,))\n\n        def test_external_index_not_embedded_checksum(self):\n            value=self.state();self.assertTrue(value[\'available\'],value)\n            self.assertEqual(wall_training._GEOMETRY_B85.manifest[\'a\'],self.index[\'world\'][\'a\'])\n\n        def test_same_size_same_mtime_update_reloads(self):\n            before=self.state();f=self.mount/\'world_a.bin\';stat=f.stat();f.write_bytes(b\'Z\')\n            os.utime(f,ns=(stat.st_atime_ns,stat.st_mtime_ns))\n            self.assertEqual(self.state()[\'state\'],\'invalid\')\n            self.index[\'world\'][\'a\'][1]=sha(b\'Z\');self.save();after=self.state()\n            self.assertTrue(after[\'available\'],after);self.assertNotEqual(before[\'token\'],after[\'token\'])\n\n        def test_other_map_update_does_not_change_current_token(self):\n            before=self.state();(self.mount/\'world_b.bin\').write_bytes(b\'Q\')\n            self.index[\'world\'][\'b\'][1]=sha(b\'Q\');self.index[\'world_meta\'][\'b\'][\'version\']=2;self.save()\n            self.assertEqual(before[\'token\'],self.state()[\'token\'])\n\n        def test_metadata_update_changes_current_token(self):\n            before=self.state();self.index[\'world_meta\'][\'a\'][\'version\']=2;self.save();after=self.state()\n            self.assertNotEqual(before[\'token\'],after[\'token\'])\n            self.assertEqual(wall_training.WALL_TRAINING[\'a\'][\'version\'],2)\n\n        def test_remove_and_reinsert_current_file(self):\n            f=self.mount/\'world_a.bin\';raw=f.read_bytes();f.unlink();state=self.state()\n            self.assertEqual(state[\'state\'],\'missing\');self.assertEqual(state[\'resource_relative\'],f.name)\n            self.assertTrue(self.state(\'b\')[\'available\']);f.write_bytes(raw);self.assertTrue(self.state()[\'available\'])\n\n        def test_flat_names_do_not_collide(self):\n            self.assertNotEqual((self.mount/\'world_a.bin\').read_bytes(),(self.mount/\'props_a.bin\').read_bytes())\n            self.assertFalse(any(p.is_dir() for p in self.mount.iterdir()))\n\n        def test_path_traversal_and_nested_names_rejected(self):\n            for name in (\'../a.bin\',\'world/a.bin\',\'world\\\\a.bin\',\'C:a.bin\',\'.\'):\n                with self.assertRaises(ValueError):cache.read_blob(name,\'0\'*64)\n\n        def test_broken_unused_map_is_not_global_failure(self):\n            self.index[\'world\'][\'b\']=[\'../bad.bin\',\'0\'*64];self.save()\n            self.assertTrue(self.state()[\'available\']);self.assertEqual(self.state(\'b\')[\'state\'],\'invalid\')\n\n        def test_invalid_index_not_silently_stale(self):\n            self.assertTrue(self.state()[\'available\'])\n            (self.mount/cache.INDEX_NAME).write_text(\'{broken\',encoding=\'utf-8\')\n            state=self.state();self.assertEqual(state[\'state\'],\'invalid\')\n            self.assertEqual(state[\'resource_relative\'],cache.INDEX_NAME)\n            self.save();self.assertTrue(self.state()[\'available\'])\n\n        def test_snapshot_is_consistent(self):\n            with cache.data_snapshot(refresh=True):\n                self.assertEqual(wall_training.WALL_TRAINING[\'a\'][\'version\'],1)\n                self.index[\'world_meta\'][\'a\'][\'version\']=2;self.save()\n                self.assertEqual(wall_training.WALL_TRAINING[\'a\'][\'version\'],1)\n            self.state();self.assertEqual(wall_training.WALL_TRAINING[\'a\'][\'version\'],2)\n\n        def test_untrained_map_is_separate(self):\n            self.assertEqual(self.state(\'new_map\')[\'state\'],\'untrained\')\n\n        def test_notice_current_file_and_new_mount(self):\n            (self.mount/\'world_a.bin\').unlink();state=dict(self.state(),map_key=\'a\')\n            text=\'\\n\'.join(cap.notice_lines(state,\'A\'))\n            self.assertIn(\'world_a.bin\',text);self.assertIn(cache.DATA_DIRECTORY,text)\n            self.assertTrue(cap.warning_for(state,\'A\'))\n            self.assertNotIn(\'collision_cache\',text);self.assertFalse(cap.notice_lines(state,\'B\'))\n\n        def test_missing_map_basic_control_still_operates(self):\n            from aim_fire_acceptance_contract import native_fixture,native_step\n            (self.mount/\'world_a.bin\').unlink();state=dict(self.state(),map_key=\'a\')\n            self.assertEqual(state[\'state\'],\'missing\')\n            # Resource warnings belong to ESP. The accepted controller consumes\n            # its published verdict and does not rewrite config or load a BSP.\n            for verdict in (\'visible\',\'penetrable\',\'blocked\'):\n                f=native_fixture();f.cfg.walls=True;f.cfg.wallbang=True\n                f.frame.wall_capability=state\n                for point in f.reader.entity.aim_points:point.visibility=verdict\n                with patch(\'wall_service.load_map\',side_effect=AssertionError(\'controller loaded geometry\')):\n                    diagnostic=native_step(f,10.,verdict)\n                self.assertEqual((0x90000,3) in f.native_writes,verdict!=\'blocked\',diagnostic)\n                self.assertTrue(f.cfg.walls);self.assertTrue(f.cfg.wallbang)\n\n        def test_display_context_distinguishes_resource_version(self):\n            from esp_pipeline import CurrentFrameVisibility\n            from esp_skeleton_rules import fixture\n            f=fixture();f.source_epoch=0;f.wall_capability={\'token\':\'old\'}\n            before=CurrentFrameVisibility.context(f,Config())\n            f.wall_capability={\'token\':\'new\'}\n            self.assertNotEqual(before,CurrentFrameVisibility.context(f,Config()))\n\n        def test_display_never_loads_old_external_geometry(self):\n            from esp_pipeline import FrameVisibility\n            import esp_pipeline\n            from esp_skeleton_rules import fixture\n            from native_ray_contract import ReplyFixture\n            from unittest.mock import patch\n            f=fixture();f.wall_capability={\'token\':\'new\'}\n            provider=ReplyFixture(lambda frame,key,points:points)\n            worker=FrameVisibility(\'\',provider=provider);self.addCleanup(worker.close)\n            with patch(\'collision_cache_io.data_snapshot\',side_effect=AssertionError(\'legacy map load\')):\n                worker.update(f,Config(esp=True,walls=True))\n                f.wall_capability={\'token\':\'changed\'};worker.update(f,Config(esp=True,walls=True))\n            self.assertEqual(provider.calls,2)\n            self.assertEqual(f.entities[0].visibility,\'visible\')\n            self.assertFalse(hasattr(worker,\'bsp\'))\n\n    out=io.StringIO();result=unittest.TextTestRunner(stream=out,verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(FlatData))\n    if not result.wasSuccessful():raise AssertionError(out.getvalue())\n    return dict(passed=True,tests=result.testsRun,game_attached=False,input_sent=False,\n                data_directory=cache.DATA_DIRECTORY,layout=\'flat\',dynamic_index=True)\n')

_EMBEDDED['worker_transport'] = (1, '"""Explicit UTF-8 transport for worker pipes, independent of Windows locale."""\nimport sys\n\nWORKER_SWITCHES=frozenset((\'--overlay-worker\',\'--native-ray-worker\',\'--aim-worker\',\n                           \'--server-sample-worker\',\'--wall-worker\',\'--log-worker\'))\n\ndef configure_stdio(argv=None, streams=None):\n    """Also repairs workers launched by an already-running pre-fix parent."""\n    argv=sys.argv if argv is None else argv\n    if len(argv)<2 or argv[1] not in WORKER_SWITCHES:\n        return {}\n    streams={name:getattr(sys,name,None) for name in (\'stdin\',\'stdout\',\'stderr\')} if streams is None else streams\n    result={}\n    for name,stream in streams.items():\n        if stream is None:\n            result[name]=None\n            continue\n        reconfigure=getattr(stream,\'reconfigure\',None)\n        if callable(reconfigure):\n            options=dict(encoding=\'utf-8\',errors=\'strict\')\n            if name!=\'stdin\':options.update(write_through=True)\n            reconfigure(**options)\n        result[name]=getattr(stream,\'encoding\',None)\n    return result\n')
_EMBEDDED['esp53_contract'] = (1, '"""Reproduce UTF-8 parent / GBK pythonw worker failure without game access."""\nimport io,json,unittest\n\ndef run():\n    from worker_transport import configure_stdio,WORKER_SWITCHES\n    payload=dict(cfg=dict(strategy=\'准星最近\',game=\'测试游戏目录/CSO2\',language=\'zh\'),\n                 hostage_warnings=dict(map=\'maps/CS_ITALY.bsp\',data_directory=\'1 - Shoot Through Data 射击穿透数据\'))\n    raw=(json.dumps(payload,ensure_ascii=False)+\'\\n\').encode(\'utf-8\')\n    class Tests(unittest.TestCase):\n        def test_old_gbk_pipe_does_not_preserve_config(self):\n            try:decoded=json.loads(raw.decode(\'gbk\'))\n            except (UnicodeError,ValueError):decoded=None\n            self.assertNotEqual(decoded,payload)\n        def test_all_worker_inputs_read_chinese_utf8(self):\n            for switch in WORKER_SWITCHES:\n                reader=io.TextIOWrapper(io.BytesIO(raw),encoding=\'gbk\')\n                self.addCleanup(reader.close)\n                result=configure_stdio([\'renamed tool.pyw\',switch],{\'stdin\':reader})\n                self.assertEqual(result[\'stdin\'],\'utf-8\')\n                self.assertEqual(json.loads(reader.readline()),payload)\n        def test_worker_output_matches_parent_decoder(self):\n            output=io.BytesIO();writer=io.TextIOWrapper(output,encoding=\'gbk\')\n            self.addCleanup(writer.close)\n            configure_stdio([\'tool\',\'--overlay-worker\'],{\'stdout\':writer})\n            writer.write(json.dumps(payload,ensure_ascii=False)+\'\\n\');writer.flush()\n            self.assertEqual(json.loads(output.getvalue().decode(\'utf-8\')),payload)\n            self.assertTrue(writer.write_through)\n        def test_nonworker_leaves_user_stdio_untouched(self):\n            reader=io.TextIOWrapper(io.BytesIO(b\'\'),encoding=\'gbk\');self.addCleanup(reader.close)\n            self.assertEqual(configure_stdio([\'tool\',\'--check\'],{\'stdin\':reader}),{})\n            self.assertEqual(reader.encoding,\'gbk\')\n        def test_devnull_absent_stream_is_supported(self):\n            self.assertEqual(configure_stdio([\'tool\',\'--server-sample-worker\'],{\'stdin\':None}),{\'stdin\':None})\n        def test_malformed_json_is_still_rejected(self):\n            reader=io.TextIOWrapper(io.BytesIO(b\'{broken\\n\'),encoding=\'gbk\');self.addCleanup(reader.close)\n            configure_stdio([\'tool\',\'--overlay-worker\'],{\'stdin\':reader})\n            with self.assertRaises(ValueError):json.loads(reader.readline())\n        def test_parent_error_clears_only_after_fresh_recovery(self):\n            from cso2_bot_tool import Worker\n            from types import SimpleNamespace as NS\n            import time\n            for state,age,error,cleared in ((\'rendering\',.1,\'\',True),(\'sampling_hidden\',.1,\'\',True),(\'rendering\',3.,\'\',False),(\'starting\',.1,\'\',False),(\'rendering\',.1,\'active failure\',False)):\n                service=NS(closed=False,metrics={\'state\':state,\'observed_at\':time.monotonic()-age},error=error,health_tick=lambda:None)\n                worker=NS(enabled=True,reader=NS(mem=True),shutdown=NS(is_set=lambda:False),overlay_service=service,overlay_error=\'old broken pipe\',cleanup=lambda name,fn:fn())\n                self.assertTrue(Worker.ensure_overlay(worker))\n                self.assertEqual(worker.overlay_error==\'\',cleared,(state,age,error))\n    output=io.StringIO();result=unittest.TextTestRunner(stream=output,verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(Tests))\n    if not result.wasSuccessful():raise AssertionError(output.getvalue())\n    return dict(passed=True,tests=result.testsRun,gbk_regression=True,game_attached=False,input_sent=False)\n')

_EMBEDDED['compact_log'] = (1, '"""Small, bounded diagnostic evidence; never changes gameplay decisions.\n\nCounters cover observations, JSONL is sampled evidence, recent.json is a ring.\nAll filesystem work is performed by BattleLog\'s existing writer thread.\n"""\nimport collections\nimport json\nimport math\n\nSCHEMA = 14\nDETAIL_BYTES = 512 * 1024\nSUMMARY_BYTES = 192 * 1024\nRECENT_BYTES = 64 * 1024\nRECORD_BYTES = 8 * 1024\nOTHER = \'__other__\'\n\n\ndef precision_event(row):\n    """Small unsampled shot/damage evidence, without claiming bullet linkage."""\n    kind=row.get(\'kind\')\n    if kind not in (\'ammo_decreased\',\'confirmed_damage\') and not (kind==\'input_action\' and row.get(\'action\')==\'fire_down\'):\n        return None\n    result={k:row[k] for k in (\'kind\',\'time\',\'mono\',\'target\',\'action\',\'weapon\',\'observation_id\',\n        \'rounds\',\'clip_before\',\'clip_after\',\'victim_index\',\'attacker_index\',\'sequence\',\'hitgroup\',\'damage\',\'damage_armor\',\'health\',\'armor\') if k in row}\n    context=row.get(\'aim_context\') or row.get(\'prior_aim\') or {}\n    if context:\n        if isinstance(context.get(\'aim_latency\'),dict):\n            result[\'aim_latency\']=context[\'aim_latency\']\n        for key in (\'target\',\'target_serial\',\'target_health\',\'model\',\'aim_part\',\'target_distance\'):\n            if key in context:result[\'aim_\'+key]=context[key]\n        snap=context.get(\'fire_snapshot\') or {};commit=context.get(\'fire_commit\') or {}\n        refresh=context.get(\'pose_refresh\') or {}\n        result[\'pose_refresh\']={k:refresh.get(k) for k in (\n            \'status\',\'source\',\'read_ms\',\'ray_ms\',\'total_ms\',\'pose_stamp\',\'pose_age_ms\',\n            \'before_aim_age_ms\',\'before_fire_age_ms\',\'after_down_age_ms\',\'pose_shift_units\',\n            \'pose_reused\',\'ray_basis\',\'wall_signal_age_ms\',\'wall_received_to_decision_ms\')\n            if k in refresh}\n        result[\'wall_handoff\']=context.get(\'wall_handoff\')\n        result[\'pose_ms\']=commit.get(\'post_weapon_pose_age_ms\',commit.get(\'pose_age_ms\'))\n        result[\'point_id\']=snap.get(\'point_id\');result[\'aim_point\']=snap.get(\'point\')\n        result[\'punch\']=snap.get(\'punch\');result[\'view_error_deg\']=commit.get(\'error_deg\')\n        result[\'commit_status\']=commit.get(\'status\')\n        result[\'interval\']=(context.get(\'fire_cadence\') or {}).get(\'interval\')\n        result[\'effective_interval\']=(context.get(\'fire_cadence\') or {}).get(\'effective_interval\')\n        result[\'interval_basis\']=(context.get(\'fire_cadence\') or {}).get(\'interval_basis\')\n        result[\'first_request\']=commit.get(\'first_request\')\n        # Keep the inputs needed to separate spread/motion/body fallback from\n        # a low-damage head hit even after verbose JSONL exhausts its budget.\n        cadence=context.get(\'fire_cadence\') or {}\n        path=context.get(\'penetration\') or {}\n        result[\'path_kind\']=snap.get(\'path\') or path.get(\'kind\')\n        result[\'path_reason\']=path.get(\'reason\')\n        result[\'penetration_verdict\']=path.get(\'penetration_verdict\') or path.get(\'penetrability\')\n        result[\'obstacle_thickness\']=path.get(\'obstacle_thickness\',path.get(\'total_thickness\'))\n        result[\'pending_reason\']=path.get(\'pending_reason\')\n        result[\'pending_reason_code\']=path.get(\'pending_reason_code\')\n        result[\'non_penetrable_reason\']=path.get(\'non_penetrable_reason\')\n        for key in (\'selection_reason\',\'selection_policy\',\'selection_path_source\',\'selected_path_tier\',\'control_provenance\',\'ray_selection\'):\n            if key in context:result[key]=context[key]\n        result[\'local_velocity\']=context.get(\'local_velocity\')\n        result[\'target_velocity\']=context.get(\'target_velocity\')\n        result[\'head_radius\']=context.get(\'head_radius\')\n        result[\'spread_hint\']=cadence.get(\'spread_hint\')\n        result[\'first_write_ms\']=(context.get(\'aim_response\') or {}).get(\'first_write_ms\')\n        for key in (\'aim_to_fire_ms\',\'first_aim_to_fire_ms\',\'fire_down_completed_stamp\',\n                    \'kill_to_switch_ms\',\'target_switch\',\'aim_lock_stamp\',\'lock_to_fire_ms\',\'lock_to_fire_limit_ms\',\n                    \'lock_to_fire_within_goal\',\'target_end_to_lock_ms\'):\n            if key in context:result[key]=context[key]\n        motion=context.get(\'head_motion\') or {}\n        result[\'motion_basis\']=motion.get(\'motion_side_basis\')\n        result[\'motion_offset\']=motion.get(\'offset\')\n    return bounded(result,width=48,items=4,chars=160)\n\n\ndef increment(table, key, value=1, limit=96):\n    key = str(key if key is not None else \'unknown\')[:180]\n    if key not in table and len(table) >= limit:\n        key = OTHER\n    table[key] = table.get(key, 0) + value\n\n\nclass Metric:\n    # Fixed-memory distribution; p95 is explicitly a bucket upper bound.\n    edges = (.1, .25, .5, 1., 2., 4., 8., 12., 16., 25., 50., 100., 250., 500., 1000., 5000.)\n\n    def __init__(self):\n        self.count = 0; self.total = 0.; self.maximum = 0.\n        self.bins = [0] * (len(self.edges) + 1)\n\n    def add(self, value):\n        if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) or value < 0:\n            return\n        self.count += 1; self.total += value; self.maximum = max(self.maximum, value)\n        for i, edge in enumerate(self.edges):\n            if value <= edge:\n                self.bins[i] += 1; break\n        else:\n            self.bins[-1] += 1\n\n    def snapshot(self):\n        threshold = math.ceil(self.count * .95); seen = 0; upper = None\n        for i, n in enumerate(self.bins):\n            seen += n\n            if self.count and seen >= threshold:\n                upper = self.edges[i] if i < len(self.edges) else self.maximum\n                break\n        return dict(count=self.count, sum=round(self.total, 6),\n                    mean=round(self.total / self.count, 4) if self.count else None,\n                    max=self.maximum if self.count else None,\n                    p95_bucket_upper=upper, edges=list(self.edges), bins=list(self.bins))\n\n\nclass AimLatencyTotals:\n    """Latest-mailbox observations are sampled cycles, never all worker cycles."""\n    def __init__(self):\n        from aim_latency import FIELDS, MODES\n        self.metrics={mode:{key:Metric() for key in (*FIELDS,\'sample_age_ms\',\'ray_ms\')}\n                      for mode in MODES}\n        self.statuses={mode:{} for mode in MODES}\n        self.last=None;self.duplicates=0;self.unobserved_cycles=0\n\n    def observe(self, row):\n        if not isinstance(row,dict) or row.get(\'mode\') not in self.metrics:return\n        key=(row.get(\'process_id\'),row.get(\'started_mono\'),row.get(\'cycle\'))\n        if key==self.last:self.duplicates+=1;return\n        if self.last and key[0]==self.last[0] and isinstance(key[2],int) and isinstance(self.last[2],int):\n            self.unobserved_cycles+=max(0,key[2]-self.last[2]-1)\n        self.last=key\n        mode=row[\'mode\'];increment(self.statuses[mode],row.get(\'action_status\'))\n        # Idle/cancelled/error samples remain evidence but do not dilute active latency.\n        if row.get(\'requested\') and row.get(\'action_status\')==\'cycle_complete\':\n            for name,metric in self.metrics[mode].items():metric.add(row.get(name))\n\n    def snapshot(self):\n        return dict(basis=\'unique_parent_observed_active_cycles; latest_mailbox_may_skip_cycles\',\n            duplicate_observations=self.duplicates,unobserved_cycles=self.unobserved_cycles,\n            statuses=self.statuses,by_mode={mode:{k:v.snapshot() for k,v in values.items()}\n                for mode,values in self.metrics.items()})\n\n\nclass DecisionTotals:\n    def __init__(self):\n        self.frames = 0; self.allowed = 0; self.transitions = 0; self.last = None\n        self.reasons = {}; self.waits = {}; self.weapons = {}; self.faults = {}\n        self.metrics = {k: Metric() for k in (\'sample_ms\', \'trace_ms\', \'control_ms\', \'alignment_error_deg\')}\n        self.loop_stages={}\n        self.aim_latency = AimLatencyTotals()\n        self.worker_latency=collections.OrderedDict();self.worker_latency_evicted=0\n\n    def observe(self, frame, control, context, sample_ms, trace_ms):\n        allowed = bool(context.get(\'fire_allowed\'))\n        reason = str(context.get(\'stop_reason\') or context.get(\'reason\') or control.reason)\n        signature = (frame.weapon, control.target, bool(control.pressed), allowed, reason)\n        self.frames += 1; self.allowed += allowed; self.transitions += signature != self.last\n        self.last = signature; increment(self.reasons, reason)\n        if context.get(\'fire_wait_reason\'): increment(self.waits, context[\'fire_wait_reason\'])\n        weapon = str(frame.weapon)[:96]\n        if weapon not in self.weapons and len(self.weapons) >= 160: weapon = OTHER\n        row = self.weapons.setdefault(weapon, dict(frames=0, allowed=0, denied=0))\n        row[\'frames\'] += 1; row[\'allowed\'] += allowed; row[\'denied\'] += not allowed\n        if context.get(\'fire_wait_reason\'):\n            increment(row.setdefault(\'waits\',{}),context[\'fire_wait_reason\'],limit=8)\n        commit=context.get(\'fire_commit\')\n        if commit:\n            increment(row.setdefault(\'fire_commits\',{}),commit.get(\'status\'),limit=16)\n            if commit.get(\'corrected\'):increment(row.setdefault(\'fire_commits\',{}),\'corrected\',limit=16)\n        if context.get(\'fire_pose_error\'):\n            increment(row.setdefault(\'fire_pose_errors\',{}),context[\'fire_pose_error\'],limit=8)\n        motion=context.get(\'head_motion\') or {}\n        if motion.get(\'motion_fire_ready\') is False:\n            increment(row.setdefault(\'motion_waits\',{}),motion.get(\'reason\',\'unknown\'),limit=8)\n        if motion.get(\'prediction_fallback\'):\n            increment(row.setdefault(\'prediction_fallbacks\',{}),motion.get(\'reason\',\'unknown\'),limit=8)\n        binding=context.get(\'native_mouse2\')\n        if binding:\n            row[\'last_mouse2\']={k:binding.get(k) for k in (\'binding\',\'original\',\'reserved\',\'pending\',\'status\',\'ready\',\'restore_pending\')}\n        region=context.get(\'shot_region\')\n        if region and region.get(\'available\'):\n            increment(row.setdefault(\'shot_regions\',{}),region.get(\'status\',\'unknown\'),limit=8)\n        if allowed:\n            increment(row.setdefault(\'aim_parts\',{}),context.get(\'aim_part\'),limit=8)\n            increment(row.setdefault(\'paths\',{}),context.get(\'shot_path\'),limit=4)\n        for name, value in ((\'sample_ms\', sample_ms), (\'trace_ms\', trace_ms),\n                            (\'control_ms\', context.get(\'control_ms\')),\n                            (\'alignment_error_deg\', context.get(\'write_readback_error_deg\'))):\n            self.metrics[name].add(value)\n        self.aim_latency.observe(context.get(\'aim_latency\'))\n        worker=context.get(\'worker_latency_totals\') or {}\n        if isinstance(worker,dict) and worker.get(\'session\'):\n            session=worker[\'session\'];old=self.worker_latency.get(session,{})\n            if worker.get(\'last_cycle\',0)>=old.get(\'last_cycle\',0):\n                import copy\n                self.worker_latency[session]=copy.deepcopy(worker)\n                self.worker_latency.move_to_end(session)\n            while len(self.worker_latency)>8:\n                self.worker_latency.popitem(last=False);self.worker_latency_evicted+=1\n        for name, condition in ((\'control_over_12ms\', context.get(\'control_budget_exceeded\')),\n                                (\'readback_not_verified\', context.get(\'write_readback_verified\') is False),\n                                (\'out_of_range\', context.get(\'within_weapon_range\') is False)):\n            if condition: increment(self.faults, name)\n        for key in (\'pre_sample\',\'client_sample\',\'features_before_control\',\'wall_dispatch\',\n                    \'control\',\'features_after_control\',\'previous_log_submit\'):\n            value=(context.get(\'loop_stages_ms\') or {}).get(key)\n            if value is not None:self.loop_stages.setdefault(key,Metric()).add(value)\n\n    def snapshot(self):\n        return dict(basis=\'all_observed_control_frames_not_logged_samples\', frames=self.frames,\n                    allowed=self.allowed, denied=self.frames-self.allowed, transitions=self.transitions,\n                    stop_reasons=dict(self.reasons), fire_wait_reasons=dict(self.waits),\n                    weapons={k: dict(v) for k, v in self.weapons.items()}, fault_frames=dict(self.faults),\n                    metrics={k: v.snapshot() for k, v in self.metrics.items()},\n                    loop_stages_ms={k:v.snapshot() for k,v in self.loop_stages.items()},\n                    aim_latency_ms=self.aim_latency.snapshot(),\n                    worker_latency_totals=dict(sessions=list(self.worker_latency.values()),\n                        evicted_sessions=self.worker_latency_evicted,\n                        coverage=\'all_completed_worker_cycles_through_each_last_report; tail_requires_final_report\'))\n\n\nCONTEXT_KEYS = frozenset(\'\'\'frame_stamp target target_address target_serial target_health weapon weapon_identity\n    ammo reserve_ammo reserve_status eye aim_point firing_aim_point firing_eye_xyz actual_ray_endpoint\n    actual_sight desired out raw requested_out model head_source aim_part target_distance horizontal_distance\n    visibility wall_age_ms shot_path fire_allowed stop_reason reason fire_wait_reason fire_cadence\n    write_readback_error_deg write_readback_verified observed_error_deg camera_guarded camera_step_deg\n    within_weapon_range hostage_ray_safe control_budget_exceeded control_ms control_total_ms frame_age_ms\n    acquire_to_fire_ms first_eligible_wait_ms aim_to_fire_ms first_aim_to_fire_ms\n    aim_lock_stamp lock_to_fire_ms lock_to_fire_limit_ms lock_to_fire_within_goal target_end_to_lock_ms death_seen_stamp target_end_reason\n    fire_down_completed_stamp kill_to_switch_ms kill_to_switch_limit_ms kill_to_switch_within_goal target_switch first_shot_requested weapon_profile_status penetration\n    static_prop_guard wallbang_guard wallbang_uncertain shot_progress anti_aim defense_test\n    firing_target_angles fire_decision_stamp control_source control_pipeline selected_pose_age_ms\n    selection_rejections selection_settings engagement_policy exit_analysis exit_threat rmb_held map map_name missing_files\n    build aim_fit fire_snapshot head_motion fire_commit early_release shot_region aim_response direct_commit_lane loop_stages_ms aim_latency\n    esp_publication angles input_gate selection_projection_refreshed local_velocity target_velocity head_radius\n      ui_paused control_skipped head_intent head_intent_probe head_intent_tracking head_selection\n    head_region head_model_coord native_mouse2 fire_pose_error fire_pose_pending motion_gate\n    candidate_refresh selection_candidates selection_reason selection_policy selection_path_source selected_path_tier control_provenance independent_aim ray_selection\n    pose_refresh wall_handoff pose_sample_stamp pose_refresh_stamp pose_refresh_ms pose_age_before_fire_ms pose_reused pose_shift_units\'\'\'.split())\nRENDER_KEYS = frozenset(\'\'\'state reason error pid game_pid esp_build source fresh active enabled fps draw_ms\n    scene_frames frames frame_age_ms sample_ms render_ms entity_count entities entity_stats viewport\n    sampling_health presentation bitmap scene display_continuity recovery heartbeat_age_seconds\n    restart_reason restarts renderer_pid source_diagnostics\'\'\'.split())\n\n\ndef bounded(value, depth=0, stack=None, width=40, items=12, chars=512):\n    if stack is None: stack = set()\n    if isinstance(value, str): return value if len(value) <= chars else value[:chars] + \'…[truncated]\'\n    if isinstance(value, (dict, list, tuple)):\n        if id(value) in stack: raise ValueError(\'Circular diagnostic record\')\n        if depth >= 6: return {\'_truncated_type\': type(value).__name__, \'_items\': len(value)}\n        stack.add(id(value))\n        try:\n            if isinstance(value, dict):\n                result = {str(k): bounded(v, depth+1, stack, width, items, chars)\n                          for k, v in list(value.items())[:width]}\n                if len(value) > width: result[\'_omitted_keys\'] = len(value)-width\n            else:\n                result = [bounded(v, depth+1, stack, width, items, chars) for v in value[:items]]\n                if len(value) > items: result.append({\'_omitted_items\': len(value)-items})\n            return result\n        finally: stack.remove(id(value))\n    return value  # Let the writer isolate unsupported objects, rather than forge strings.\n\n\ndef compact_context(value):\n    if not isinstance(value, dict): return value\n    result = {k: v for k, v in value.items() if k in CONTEXT_KEYS}\n    if len(result) != len(value): result[\'_omitted_context_fields\'] = len(value)-len(result)\n    return bounded(result, width=100, items=8)\n\n\ndef compact_record(record):\n    # Preserve the old writer\'s validation behavior for non-event diagnostic tests.\n    if not record.get(\'kind\'): return record\n    row = dict(record)\n    for name in (\'aim_context\',\'context\'):\n        source = row.get(name)\n        latency = source.get(\'aim_latency\') if isinstance(source, dict) else None\n        if isinstance(source,dict):\n            if isinstance(source.get(\'pose_refresh\'),dict):row[\'pose_refresh\']=source[\'pose_refresh\']\n            if isinstance(source.get(\'wall_handoff\'),dict):row[\'wall_handoff\']=source[\'wall_handoff\']\n        if isinstance(latency,dict):row[\'aim_latency\']=latency;break\n    if row.get(\'kind\')==\'input_action\' and row.get(\'action\')==\'fire_down\':\n        context=row.get(\'aim_context\')\n        if isinstance(context,dict):\n            # Preserve firing evidence even when full diagnostic context is\n            # larger than RECORD_BYTES. Previously the entire aim_context was\n            # discarded, including the first-shot point/readback evidence.\n            keys=(\'weapon\',\'weapon_identity\',\'target\',\'target_address\',\'target_serial\',\n                  \'target_health\',\'aim_part\',\'firing_aim_point\',\'actual_sight\',\'shot_path\',\n                  \'fire_allowed\',\'write_readback_error_deg\',\'write_readback_verified\',\n                  \'aim_fit\',\'fire_commit\',\'aim_response\',\'selection_settings\',\'direct_commit_lane\',\n                  \'candidate_refresh\',\'selection_candidates\',\'selection_reason\',\'selection_policy\',\n                  \'selection_path_source\',\'selected_path_tier\',\'native_mouse2\',\n                  \'acquire_to_fire_ms\',\'first_eligible_wait_ms\',\'aim_to_fire_ms\',\'first_aim_to_fire_ms\',\n                  \'fire_down_completed_stamp\',\'kill_to_switch_ms\',\'target_switch\',\'control_ms\',\n                  \'esp_publication\',\'control_provenance\',\'independent_aim\',\'ray_selection\',\'wall_handoff\',\'pose_refresh\',\n                  \'pose_sample_stamp\',\'pose_refresh_stamp\',\'pose_refresh_ms\',\'pose_age_before_fire_ms\',\'pose_reused\',\'pose_shift_units\',\n                  \'aim_lock_stamp\',\'lock_to_fire_ms\',\'lock_to_fire_limit_ms\',\n                  \'lock_to_fire_within_goal\',\'target_end_to_lock_ms\')\n            keys += (\'aim_latency\',)\n            row[\'aim_context\']={k:context[k] for k in keys if k in context}\n            snap=context.get(\'fire_snapshot\')\n            if isinstance(snap,dict):\n                row[\'aim_context\'][\'fire_snapshot\']={k:snap[k] for k in\n                      (\'stamp\',\'point\',\'part\',\'point_id\',\'aim_region\',\'head_region\',\'head_model_coord\',\'eye\',\'angles\',\'punch\',\n                     \'pose_stamp\',\'path\',\'profile_hash\',\'shot_region\') if k in snap}\n    for key in (\'context\', \'aim_context\', \'prior_aim\', \'current_aim\', \'prior_control\', \'current_control\', \'control\'):\n        if isinstance(row.get(key), dict): row[key] = compact_context(row[key])\n    for key in (\'render\', \'renderer\'):\n        if isinstance(row.get(key), dict):\n            row[key] = {k: v for k, v in row[key].items() if k in RENDER_KEYS}\n    for key in (\'entities\', \'hostages\'):\n        if isinstance(row.get(key), list):\n            values = row[key]; row[key+\'_count\'] = len(values)\n            row[key] = [{k: e.get(k) for k in (\'index\', \'health\', \'visibility\', \'pose_status\', \'dormant\') if k in e}\n                        for e in values[:4] if isinstance(e, dict)]\n            row[key+\'_omitted\'] = max(0, len(values)-4)\n    return bounded(row, width=110, items=16)\n\n\ndef encode(record, limit=RECORD_BYTES):\n    row = compact_record(record)\n    raw = json.dumps(row, ensure_ascii=False, separators=(\',\', \':\'), allow_nan=False).encode(\'utf-8\') + b\'\\n\'\n    if len(raw) <= limit: return raw\n    # Remove largest nested payloads first; preserve identity, concrete missing files,\n    # reasons, observations, and explicitly indicate every removed field.\n    row = dict(row); omitted = []\n    protected = {\'kind\', \'time\', \'mono\', \'map\', \'map_name\', \'reason\', \'error\', \'missing_files\', \'aim_latency\',\n                 \'weapon\', \'observation_id\', \'engine_shot_tick\', \'actual_bullet_path_verified\',\n                 \'accuracy_label_accepted\', \'actual_ballistics_verified\', \'fire_allowed\',\n                 \'pose_refresh\', \'wall_handoff\', \'pose_sample_stamp\', \'pose_refresh_stamp\',\n                 \'pose_refresh_ms\', \'pose_age_before_fire_ms\', \'pose_reused\', \'pose_shift_units\'}\n    sizes = sorted(((len(json.dumps(v, ensure_ascii=False).encode(\'utf-8\')), k)\n                    for k, v in row.items() if k not in protected), reverse=True)\n    for _, key in sizes:\n        if len(raw) <= limit: break\n        omitted.append(key); row.pop(key)\n        row[\'_omitted_fields\'] = omitted\n        raw = json.dumps(row, ensure_ascii=False, separators=(\',\', \':\'), allow_nan=False).encode(\'utf-8\') + b\'\\n\'\n    if len(raw) > limit:\n        row = bounded(row, width=30, items=4, chars=128); row[\'_record_truncated\'] = True\n        raw = json.dumps(row, ensure_ascii=False, separators=(\',\', \':\'), allow_nan=False).encode(\'utf-8\') + b\'\\n\'\n    if len(raw) > limit: raise ValueError(\'Diagnostic record exceeds bounded encoding\')\n    return raw\n\n\nclass JournalPolicy:\n    def __init__(self, limit=DETAIL_BYTES, existing=0):\n        self.limit = max(4096, min(int(limit), DETAIL_BYTES)); self.used = existing\n        self.normal_limit = self.limit * 3 // 4\n        self.seen = {}; self.sampled = {}; self.budgeted = {}; self.written = {}; self.keys = {}\n        self.weapons = {}; self.actions = {}; self.faults = {}; self.paths = {}\n        self.damage_by_weapon = {}\n        self.latency = {k: Metric() for k in (\'acquire_to_fire_ms\', \'first_eligible_wait_ms\', \'control_ms\')}\n        from aim_latency import FIELDS, MODES\n        self.aim_fire_latency={mode:{key:Metric() for key in (*FIELDS,\'sample_age_ms\')} for mode in MODES}\n        self.boundary_latency = {k: Metric() for k in (\'aim_to_fire_ms\',\'first_aim_to_fire_ms\',\'kill_to_switch_ms\',\'lock_to_fire_ms\')}\n        self.last_switch_stamp = None\n        self.recent = collections.deque(); self.recent_size = 0\n        self.observations = collections.OrderedDict(); self.shots = 0; self.last_shot = -float(\'inf\')\n        self.marker_written = False\n        self.precision_tail=collections.deque();self.precision_tail_bytes=0\n\n    def observe(self, row):\n        kind = row.get(\'kind\', \'unknown\'); increment(self.seen, kind)\n        compact=precision_event(row)\n        if compact is not None:\n            encoded=json.dumps(compact,ensure_ascii=False,separators=(\',\',\':\'),allow_nan=False).encode(\'utf-8\')\n            self.precision_tail.append((compact,len(encoded)));self.precision_tail_bytes+=len(encoded)\n            while len(self.precision_tail)>96 or self.precision_tail_bytes>49152:\n                self.precision_tail_bytes-=self.precision_tail.popleft()[1]\n        if kind == \'confirmed_damage\':\n            from weapon_profiles import canonical_weapon_name\n            key=canonical_weapon_name(row.get(\'weapon\')) or \'unknown\'\n            if key not in self.damage_by_weapon and len(self.damage_by_weapon)>=160:key=OTHER\n            record=self.damage_by_weapon.setdefault(key,dict(events=0,damage=0,head_events=0,hitgroups={},\n                head_damage_min=None,head_damage_max=None,head_target_survived=0,\n                head_target_zero_health=0,armored_head_events=0))\n            record[\'events\']+=1;record[\'damage\']+=max(0,int(row.get(\'damage\',0)))\n            record[\'head_events\']+=row.get(\'hitgroup\')==\'head\'\n            increment(record[\'hitgroups\'],row.get(\'hitgroup\'),limit=10)\n            if row.get(\'hitgroup\')==\'head\':\n                amount=max(0,int(row.get(\'damage\',0)))\n                record[\'head_damage_min\']=amount if record[\'head_damage_min\'] is None else min(record[\'head_damage_min\'],amount)\n                record[\'head_damage_max\']=amount if record[\'head_damage_max\'] is None else max(record[\'head_damage_max\'],amount)\n                health=row.get(\'health\');armor=row.get(\'damage_armor\')\n                if isinstance(health,(int,float)):\n                    record[\'head_target_survived\']+=int(health>0)\n                    record[\'head_target_zero_health\']+=int(health==0)\n                if isinstance(armor,(int,float)):record[\'armored_head_events\']+=int(armor>0)\n        if kind == \'ammo_decreased\':\n            increment(self.weapons, row.get(\'weapon\'), max(0, int(row.get(\'rounds\', 0))), limit=160)\n        if kind == \'input_action\':\n            action = row.get(\'action\'); increment(self.actions, action)\n            if action == \'fire_unconfirmed\': increment(self.faults, \'trigger_without_ammo_change\')\n            if action == \'fire_down\':\n                context = row.get(\'aim_context\') or {}; increment(self.paths, context.get(\'shot_path\', \'unknown\'))\n                for k, metric in self.latency.items(): metric.add(context.get(k))\n                latency=context.get(\'aim_latency\') or {}\n                if latency.get(\'mode\') in self.aim_fire_latency and latency.get(\'action_status\')==\'fire_down_submitted\':\n                    for key,metric in self.aim_fire_latency[latency[\'mode\']].items():metric.add(latency.get(key))\n                self.boundary_latency[\'aim_to_fire_ms\'].add(context.get(\'aim_to_fire_ms\'))\n                self.boundary_latency[\'lock_to_fire_ms\'].add(context.get(\'lock_to_fire_ms\'))\n                commit=context.get(\'fire_commit\') or {}\n                if commit.get(\'first_request\'):\n                    self.boundary_latency[\'first_aim_to_fire_ms\'].add(context.get(\'first_aim_to_fire_ms\'))\n        if kind == \'aim_fire_decision\':\n            switch=row.get(\'target_switch\') or {}\n            stamp=switch.get(\'locked_stamp\')\n            if stamp is not None and stamp!=self.last_switch_stamp:\n                self.boundary_latency[\'kill_to_switch_ms\'].add(row.get(\'kill_to_switch_ms\'))\n                self.last_switch_stamp=stamp\n\n    @staticmethod\n    def important(row):\n        kind = row.get(\'kind\', \'\')\n        return (kind in (\'match_start\', \'match_end\', \'wall_ready\', \'wall_capability\', \'civilian_read_failure\')\n                or any(s in kind for s in (\'error\', \'fail\', \'missing\', \'disconnect\', \'recovery\'))\n                or row.get(\'action\') == \'fire_unconfirmed\' or bool(row.get(\'error\')))\n\n    def select(self, row):\n        kind = row.get(\'kind\', \'unknown\'); now = row.get(\'mono\', 0.)\n        oid = row.get(\'observation_id\')\n        if oid:\n            # Linked shot/ammo/target records receive the same sampling decision.\n            if oid not in self.observations:\n                self.shots += 1\n                keep = self.shots <= 3 or now-self.last_shot >= 5.\n                if keep: self.last_shot = now\n                self.observations[oid] = keep\n                if len(self.observations) > 128: self.observations.popitem(last=False)\n            keep = self.observations[oid]\n        else:\n            context = row.get(\'context\') or row.get(\'aim_context\') or {}\n            key = (kind, str(row.get(\'weapon\', context.get(\'weapon\', \'\')))[:96],\n                   str(row.get(\'stop_reason\', row.get(\'reason\', \'\')))[:180],\n                   str(row.get(\'action\', \'\'))[:48], str(row.get(\'state\', \'\'))[:64])\n            if key not in self.keys and len(self.keys) >= 512: key = (\'overflow\',)\n            count, last = self.keys.get(key, (0, -float(\'inf\')))\n            interval = 30. if kind in (\'aim_fire_decision\', \'control_status\', \'runtime_state\',\n                                       \'process_memory\', \'defense_test_sample\', \'civilian_geometry\') else 5.\n            keep = count < 2 or now-last >= interval or kind in (\'match_start\', \'match_end\')\n            self.keys[key] = (count+1, now if keep else last)\n        if not keep: increment(self.sampled, kind)\n        return keep\n\n    def prepare(self, record):\n        self.observe(record)\n        if not self.select(record): return None\n        raw = encode(record)\n        self.recent.append(raw); self.recent_size += len(raw)\n        while self.recent and self.recent_size + len(self.recent) + 2 > RECENT_BYTES:\n            self.recent_size -= len(self.recent.popleft())\n        ceiling = self.limit if self.important(record) else self.normal_limit\n        if self.used + len(raw) + 512 > ceiling:\n            increment(self.budgeted, record.get(\'kind\', \'unknown\')); return None\n        return raw\n\n    def committed(self, record, raw):\n        self.used += len(raw); increment(self.written, record.get(\'kind\', \'unknown\'))\n\n    def marker(self):\n        if self.marker_written or not self.budgeted: return None\n        raw = encode(dict(kind=\'logging_budget\', mode=\'aggregate_and_recent_ring_continue\',\n                          detail_limit_bytes=self.limit, normal_limit_bytes=self.normal_limit,\n                          historical_files_deleted=False, evidence_is_sampled=True))\n        return raw if self.used+len(raw) <= self.limit else None\n\n    def recent_bytes(self):\n        return b\'[\' + b\',\'.join(x.rstrip(b\'\\n\') for x in self.recent) + b\']\'\n\n    def snapshot(self):\n        return dict(profile=\'compact54\', schema=SCHEMA, detail_limit_bytes=self.limit,\n                    summary_limit_bytes=SUMMARY_BYTES, recent_limit_bytes=RECENT_BYTES,\n                    per_match_max_bytes=self.limit+SUMMARY_BYTES+RECENT_BYTES,\n                    detail_written_bytes=self.used, event_observations=dict(self.seen),\n                    sampled_out=dict(self.sampled), budget_omitted=dict(self.budgeted),\n                    records_written=dict(self.written), observed_rounds_by_weapon=dict(self.weapons),\n                    confirmed_damage_by_weapon=self.damage_by_weapon,\n                    precision_tail=[row for row,size in self.precision_tail],\n                    precision_tail_basis=\'all_writer_received_shots_and_damage_bounded_tail_not_per_bullet_association\',\n                    input_actions=dict(self.actions), fault_indicators=dict(self.faults),\n                    shot_paths=dict(self.paths), latency_ms={k: m.snapshot() for k, m in self.latency.items()},\n                    aim_fire_latency_ms={mode:{k:v.snapshot() for k,v in values.items()}\n                        for mode,values in self.aim_fire_latency.items()},\n                    aim_fire_latency_basis=\'writer_received_accepted_primary_down; excludes_ipc_disk_game_tick_network_and_damage\',\n                    boundary_latency_ms={k:m.snapshot() for k,m in self.boundary_latency.items()},\n                    boundary_latency_basis=\'accepted_down_and_observed_death_not_engine_bullet_or_kill_time\',\n                    scope=\'writer_received_events; see dropped_log_records for queue or IO loss\',\n                    detail_complete=False, counters_continue_after_budget=True,\n                    recent_ring_replaces_only_this_match_snapshot=True, historical_files_deleted=False)\n\n\ndef summary_bytes(summary, policy):\n    row = dict(summary)\n    row[\'logging\'] = policy.snapshot()\n    for key in (\'render\', \'defense_test\', \'grenade_dodge\', \'damage_capture\', \'process_memory\'):\n        if key in row: row[key] = bounded(row[key], width=32, items=4, chars=256)\n    raw = json.dumps(row, ensure_ascii=False, separators=(\',\', \':\'), allow_nan=False).encode(\'utf-8\') + b\'\\n\'\n    if len(raw) > SUMMARY_BYTES:\n        # Aggregate tables are already cardinality bounded. Evict ancillary context first.\n        omitted = []\n        for key in (\'render\', \'defense_test\', \'grenade_dodge\', \'damage_capture\', \'process_memory\', \'penetration_map_validation\'):\n            if key in row: row.pop(key); omitted.append(key)\n        row[\'summary_omitted_fields\'] = omitted\n        raw = json.dumps(row, ensure_ascii=False, separators=(\',\', \':\'), allow_nan=False).encode(\'utf-8\') + b\'\\n\'\n    while len(raw)>SUMMARY_BYTES and row[\'logging\'].get(\'precision_tail\'):\n        row[\'logging\'][\'precision_tail\']=row[\'logging\'][\'precision_tail\'][1:]\n        row[\'logging\'][\'precision_tail_trimmed_for_summary_budget\']=True\n        raw=json.dumps(row,ensure_ascii=False,separators=(\',\',\':\'),allow_nan=False).encode(\'utf-8\')+b\'\\n\'\n    if len(raw) > SUMMARY_BYTES: raise ValueError(\'Summary exceeds aggregate budget\')\n    return raw\n')
_EMBEDDED['logs54_contract'] = (1, '"""Offline regressions for compact diagnostic logs; no game access or input."""\nimport io\nimport json\nimport tempfile\nimport unittest\nfrom pathlib import Path\nfrom types import SimpleNamespace as NS\n\n\ndef run():\n    from compact_log import (JournalPolicy, DecisionTotals, Metric, encode, summary_bytes,\n                             DETAIL_BYTES, SUMMARY_BYTES, RECENT_BYTES)\n    from battle_log import BattleLog\n    from maintenance_contract import weapon_frame\n    from aim_audit import analyze_folder\n\n    class Tests(unittest.TestCase):\n        def test_utf8_and_precise_file_evidence(self):\n            row=dict(kind=\'wall_missing\',map=\'CS_ITALY\',missing_files=[\'world_cs_italy.bin\'],reason=\'缺少当前地图数据\')\n            got=json.loads(encode(row));self.assertEqual(got,row)\n\n        def test_large_record_bounded_and_marked(self):\n            row=dict(kind=\'sample\',render={\'state\':\'rendering\',\'scene\':{\'entities\':[\'中\'*2000]*300}},entities=[dict(index=i,health=100) for i in range(1000)])\n            raw=encode(row);got=json.loads(raw)\n            self.assertLessEqual(len(raw),8192);self.assertEqual(got[\'entities_count\'],1000)\n            self.assertEqual(got[\'entities_omitted\'],996)\n\n        def test_repetition_aggregates_instead_of_writing_every_frame(self):\n            p=JournalPolicy()\n            for i in range(10000):\n                row=dict(kind=\'aim_fire_decision\',mono=i*.01,weapon=\'M4\',stop_reason=\'tracking\')\n                raw=p.prepare(row)\n                if raw:p.committed(row,raw)\n            self.assertEqual(p.seen[\'aim_fire_decision\'],10000)\n            self.assertLess(p.written[\'aim_fire_decision\'],10)\n            self.assertEqual(p.sampled[\'aim_fire_decision\']+p.written[\'aim_fire_decision\'],10000)\n\n        def test_error_evidence_reserved_after_normal_budget(self):\n            p=JournalPolicy(limit=8192)\n            for i in range(300):\n                row=dict(kind=\'sample\',mono=i*60,reason=\'x\'*400)\n                raw=p.prepare(row)\n                if raw:p.committed(row,raw)\n            self.assertTrue(p.budgeted)\n            error=dict(kind=\'wall_missing\',mono=999999,map=\'CS_ITALY\',missing_files=[\'props_cs_italy.bin\'])\n            raw=p.prepare(error);self.assertIsNotNone(raw);p.committed(error,raw)\n            self.assertLessEqual(p.used,p.limit)\n\n        def test_endless_errors_remain_bounded_with_recent_tail(self):\n            p=JournalPolicy(limit=8192)\n            for i in range(3000):\n                row=dict(kind=\'error\',mono=i*60,reason=\'fixture \'+str(i),payload=\'a\'*2000)\n                raw=p.prepare(row)\n                if raw:p.committed(row,raw)\n                marker=p.marker()\n                if marker:p.committed({\'kind\':\'logging_budget\'},marker);p.marker_written=True\n            self.assertLessEqual(p.used,8192);self.assertTrue(p.budgeted)\n            tail=p.recent_bytes();self.assertLessEqual(len(tail),RECENT_BYTES)\n            self.assertEqual(json.loads(tail)[-1][\'reason\'],\'fixture 2999\')\n            self.assertLessEqual(len(p.keys),513)\n\n        def test_linked_observations_keep_same_sampling_decision(self):\n            p=JournalPolicy()\n            for i in range(1,40):\n                decisions=[p.select(dict(kind=k,mono=i*.01,observation_id=\'shot:\'+str(i)))\n                    for k in (\'penetration_validation_shot\',\'ammo_decreased\',\'shot_observation\',\'target_health_observation\')]\n                self.assertTrue(all(d==decisions[0] for d in decisions))\n\n        def test_metric_labels_are_histogram_not_exact_quantiles(self):\n            m=Metric()\n            for n in (1,2,3,4,float(\'nan\'),-1,None):m.add(n)\n            out=m.snapshot();self.assertEqual(out[\'count\'],4);self.assertEqual(out[\'mean\'],2.5)\n            self.assertEqual(out[\'p95_bucket_upper\'],4);self.assertNotIn(\'p95\',out)\n\n        def test_all_control_frames_counted_separately_from_evidence(self):\n            f,_=weapon_frame();c=NS(target=3,pressed=True,reason=\'fixture\');d=DecisionTotals()\n            for i in range(10000):d.observe(f,c,{\'fire_allowed\':i%2==0,\'fire_wait_reason\':\'cycle\'},1,2)\n            s=d.snapshot();self.assertEqual(s[\'frames\'],10000);self.assertEqual(s[\'allowed\'],5000)\n            self.assertEqual(s[\'fire_wait_reasons\'][\'cycle\'],10000)\n\n        def test_writer_limit_summary_close_and_analyzer(self):\n            with tempfile.TemporaryDirectory(prefix=\'bot_log54_\') as tmp:\n                now=[10.];log=BattleLog(tmp,set(),clock=lambda:now[0],rotate_bytes=8192)\n                f,_=weapon_frame();log._start(f);ident=log.current[\'id\']\n                try:\n                    for i in range(600):\n                        now[0]+=60.\n                        log.event(\'ammo_decreased\',rounds=1,weapon=\'ACR\',observation_id=str(i),context={\'reason\':\'x\'*3000})\n                        log.current[\'observed_rounds\']+=1\n                        if i%100==0:log.queue.join()\n                    log.native_hurt(dict(kind=\'player_hurt\',local_index=2,attacker_index=2,victim_index=3,damage=17,hitgroup=1))\n                finally:log.close()\n                self.assertFalse(log.error);self.assertFalse(log.thread.is_alive())\n                p=Path(tmp);detail=p/(ident+\'.jsonl\');s=json.loads((p/(ident+\'.summary.json\')).read_text(\'utf-8\'))\n                self.assertLessEqual(detail.stat().st_size,8192);self.assertEqual(len(list(p.glob(\'*.part*.jsonl\'))),0)\n                self.assertEqual(s[\'observed_rounds\'],600)\n                self.assertEqual(s[\'logging\'][\'observed_rounds_by_weapon\'][\'ACR\'],600)\n                self.assertEqual(s[\'logging\'][\'event_observations\'][\'ammo_decreased\'],600)\n                self.assertTrue(s[\'logging\'][\'budget_omitted\']);self.assertTrue(s[\'finished\'])\n                self.assertIsNone(s[\'bullet_accuracy\']);self.assertIsNone(s[\'penetration_accuracy\'])\n                self.assertLessEqual((p/(ident+\'.summary.json\')).stat().st_size,SUMMARY_BYTES)\n                self.assertLessEqual((p/(ident+\'.recent.json\')).stat().st_size,RECENT_BYTES)\n                report=json.loads(analyze_folder(p).read_text(\'utf-8\'))\n                self.assertEqual(report[\'observed_rounds\'],600);self.assertEqual(report[\'confirmed_damage_events\'],1)\n                self.assertEqual(report[\'weapons\'][\'ACR\'][\'observed_rounds\'],600)\n                self.assertEqual(report[\'compact_logging\'][\'summary_matches\'],1)\n\n        def test_match_budget_resets_and_historical_file_untouched(self):\n            with tempfile.TemporaryDirectory() as tmp:\n                old=Path(tmp)/\'history.jsonl\';old.write_bytes(b\'{"kind":"old"}\\n\')\n                log=BattleLog(tmp,set());f,_=weapon_frame()\n                for _ in range(2):log._start(f);log.finish(\'fixture\')\n                log.close();self.assertEqual(old.read_bytes(),b\'{"kind":"old"}\\n\')\n                summaries=[json.loads(p.read_text(\'utf-8\')) for p in Path(tmp).glob(\'*.summary.json\')]\n                self.assertEqual(len(summaries),2)\n                self.assertTrue(all(s[\'logging\'][\'event_observations\'][\'match_start\']==1 for s in summaries))\n\n        def test_analyzer_mixes_legacy_and_new_without_double_count(self):\n            with tempfile.TemporaryDirectory() as tmp:\n                p=Path(tmp);log=BattleLog(tmp,set());f,_=weapon_frame();log._start(f)\n                log.current[\'observed_rounds\']=10;log.event(\'ammo_decreased\',weapon=\'M4\',rounds=10);log.close()\n                (p/\'legacy.jsonl\').write_text(json.dumps(dict(kind=\'ammo_decreased\',weapon=\'M4\',rounds=3))+\'\\n\',encoding=\'utf-8\')\n                report=json.loads(analyze_folder(p).read_text(\'utf-8\'))\n                self.assertEqual(report[\'observed_rounds\'],13);self.assertEqual(report[\'weapons\'][\'M4\'][\'observed_rounds\'],13)\n\n        def test_serialization_does_not_mutate_input(self):\n            row=dict(kind=\'aim_sample\',context={\'target\':3,\'lots\':[1]*1000,\'fire_allowed\':False})\n            before=json.dumps(row);encode(row);self.assertEqual(json.dumps(row),before)\n\n        def test_summary_worst_case_normal_schema_fits(self):\n            p=JournalPolicy();d=DecisionTotals();f,_=weapon_frame();c=NS(target=3,pressed=True,reason=\'x\'*180)\n            for i in range(1000):\n                f.weapon=\'weapon_\'+str(i);c.reason=\'reason_\'+str(i)+\'x\'*150\n                d.observe(f,c,{\'fire_wait_reason\':c.reason},1.,2.)\n                p.observe(dict(kind=\'event_\'+str(i),weapon=f.weapon))\n            raw=summary_bytes(dict(id=\'fixture\',log_schema=11,decision_totals=d.snapshot()),p)\n            self.assertLessEqual(len(raw),SUMMARY_BYTES)\n\n    stream=io.StringIO();result=unittest.TextTestRunner(stream=stream,verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(Tests))\n    if not result.wasSuccessful():raise AssertionError(stream.getvalue())\n    return dict(passed=True,tests=result.testsRun,per_match_max_bytes=DETAIL_BYTES+SUMMARY_BYTES+RECENT_BYTES,\n                game_attached=False,input_sent=False,old_logs_deleted=False)\n')

_EMBEDDED['display_scheduling'] = (1, '"""Display-worker-only thread fairness and bounded source-phase diagnostics."""\nimport sys\nimport time\n\n\nclass DisplayThreadScheduling:\n    def __init__(self):\n        self.previous = sys.getswitchinterval()\n        self.requested = min(self.previous, .001)\n        sys.setswitchinterval(self.requested)\n        self.metrics = dict(previous_switch_ms=self.previous*1000,\n                            switch_interval_ms=sys.getswitchinterval()*1000,\n                            scope=\'display_sample_process_only\',\n                            sample_expiry_changed=False, input_process_changed=False)\n\n    def close(self):\n        sys.setswitchinterval(self.previous)\n\n\nclass SourcePhase:\n    def __init__(self, clock=time.monotonic):\n        self.clock=clock;self.stage=\'idle\';self.at=clock();self.started=self.at\n        self.durations={};self.completed={};self.long_cycles=[];self.max_ms=0.\n\n    def begin(self):\n        self.started=self.clock();self.at=self.started;self.stage=\'begin\';self.durations={}\n\n    def mark(self, stage):\n        now=self.clock();self.durations[self.stage]=round(max(0.,now-self.at)*1000,3)\n        self.at=now;self.stage=stage\n\n    def finish(self, error=\'\'):\n        last_stage=self.stage;self.mark(\'waiting\')\n        duration=round(max(0.,self.at-self.started)*1000,3)\n        self.max_ms=max(self.max_ms,duration)\n        self.completed=dict(cycle_ms=duration,stage_ms=dict(self.durations),error=str(error)[:300],last_stage=last_stage)\n        if duration>=80.:\n            self.long_cycles=(self.long_cycles+[dict(self.completed,mono=self.at)])[-4:]\n\n    def snapshot(self):\n        return dict(stage=self.stage,stage_age_ms=round(max(0.,self.clock()-self.at)*1000,3),\n                    last=dict(self.completed),max_cycle_ms=self.max_ms,slow_cycles=list(self.long_cycles))\n')
_EMBEDDED['esp55_contract'] = (1, '"""Display scheduling regressions; no game access or input."""\nimport io\nimport sys\nimport unittest\n\n\ndef run():\n    from display_scheduling import DisplayThreadScheduling,SourcePhase\n    from server_esp import DisplaySampleUnavailable,DISPLAY_MAX_SAMPLE_AGE\n    from overlay_service import DisplayFaultSurface\n    from esp_sources import MAX_AGE\n    class Tests(unittest.TestCase):\n        def test_switch_interval_restored(self):\n            old=sys.getswitchinterval();setting=DisplayThreadScheduling()\n            try:\n                self.assertLessEqual(sys.getswitchinterval(),.00101)\n                self.assertFalse(setting.metrics[\'input_process_changed\'])\n            finally:setting.close()\n            self.assertEqual(sys.getswitchinterval(),old)\n        def test_no_relaxation_of_existing_smaller_interval(self):\n            old=sys.getswitchinterval()\n            try:\n                sys.setswitchinterval(.0005);setting=DisplayThreadScheduling()\n                self.assertAlmostEqual(sys.getswitchinterval(),.0005)\n                setting.close();self.assertAlmostEqual(sys.getswitchinterval(),.0005)\n            finally:sys.setswitchinterval(old)\n        def test_sample_age_unchanged_and_not_a_bitmap_delete_deadline(self):\n            self.assertEqual(DISPLAY_MAX_SAMPLE_AGE,.12);self.assertEqual(MAX_AGE,.12)\n            from types import SimpleNamespace\n            from unittest.mock import Mock\n            surface=SimpleNamespace(delete=Mock(),finish=Mock())\n            policy=DisplayFaultSurface()\n            policy.recover(surface,DisplaySampleUnavailable(\'expired\'),10.181,10.16,10.,True)\n            policy.recover(surface,DisplaySampleUnavailable(\'gap\'),10.04,10.02,10.,True)\n            surface.delete.assert_not_called();surface.finish.assert_not_called()\n        def test_source_stage_localizes_slow_module_scan(self):\n            now=[10.];phase=SourcePhase(lambda:now[0]);phase.begin();phase.mark(\'module_check\')\n            now[0]+=.15;phase.mark(\'frame_read\');now[0]+=.02;phase.finish()\n            out=phase.snapshot();self.assertAlmostEqual(out[\'last\'][\'stage_ms\'][\'module_check\'],150.)\n            self.assertAlmostEqual(out[\'last\'][\'stage_ms\'][\'frame_read\'],20.)\n            self.assertEqual(len(out[\'slow_cycles\']),1)\n        def test_slow_history_and_error_bounded(self):\n            now=[0.];p=SourcePhase(lambda:now[0])\n            for _ in range(100):p.begin();p.mark(\'frame_read\');now[0]+=.2;p.finish(\'x\'*1000)\n            s=p.snapshot();self.assertEqual(len(s[\'slow_cycles\']),4)\n            self.assertEqual(len(s[\'last\'][\'error\']),300)\n        def test_snapshot_is_not_a_mutable_stage_alias(self):\n            now=[0.];p=SourcePhase(lambda:now[0]);p.begin();p.mark(\'frame_read\');now[0]+=.1;p.finish()\n            old=p.snapshot();p.begin();now[0]+=.2;p.finish()\n            self.assertEqual(old[\'last\'][\'cycle_ms\'],100.)\n    stream=io.StringIO();result=unittest.TextTestRunner(stream=stream,verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(Tests))\n    if not result.wasSuccessful():raise AssertionError(stream.getvalue())\n    return dict(passed=True,tests=result.testsRun,live_flicker_verified=False,game_attached=False,input_sent=False)\n')

_EMBEDDED['display_slot_cache'] = (1, '"""Identity-bound classification cache with bounded non-actor refresh work.\n\nConfirmed irrelevant props are different from not-yet-initialized actors.\nUnresolved classes keep the old retry rules. Known actors are never throttled.\n"""\ndef begin_classifications(reader):\n    reader._ignored_refresh_budget=16\n    reader.classification_cache_metrics=dict(classifications=0,positive_hits=0,\n        ignored_hits=0,pending_retries=0,ignored_refreshes=0,deferred_refreshes=0,\n        ignored_refresh_budget=16,ignored_refresh_seconds=2.)\n\n\ndef resolve_slot(reader,index,p,serial,now):\n    old=reader.slots.get(index)\n    same=bool(old and old[:2]==(p,serial))\n    metrics=reader.classification_cache_metrics\n    enabled=not getattr(reader,\'control_geometry\',False)\n    stable=bool(enabled and same and len(old)>=5 and old[4] and index>128)\n    if same and old[2]:\n        metrics[\'positive_hits\']+=1\n        return old[2],old,False\n    if stable:\n        if 0<=now-old[3]<2.:\n            metrics[\'ignored_hits\']+=1\n            return \'\',old,False\n        if reader._ignored_refresh_budget<=0:\n            # Leave the due timestamp unchanged; subsequent frames drain the\n            # remaining slots instead of postponing them indefinitely.\n            metrics[\'deferred_refreshes\']+=1\n            return \'\',old,False\n        reader._ignored_refresh_budget-=1;metrics[\'ignored_refreshes\']+=1\n    elif same and not old[2]:\n        if index>128 and len(old)>=4 and 0<=now-old[3]<.1:\n            return \'\',old,False\n        metrics[\'pending_retries\']+=1\n    reader._last_classification_stable=None\n    cls=reader.classify(p);metrics[\'classifications\']+=1\n    known_ignored=bool(not cls and getattr(reader,\'_last_classification_stable\',None)==p)\n    row=(p,serial,cls,now,known_ignored) if enabled else (p,serial,cls,now)\n    return cls,row,bool(same and not old[2] and cls)\n')
_EMBEDDED['esp56_contract'] = (1, '"""Replay classification storms without game reads or user interaction."""\nimport io\nimport unittest\nfrom types import SimpleNamespace as NS\n\n\ndef population_replay(optimized=True,frames=200):\n    from display_slot_cache import begin_classifications,resolve_slot\n    reader=NS(slots={},control_geometry=False)\n    calls=[0]\n    def classify(p):\n        calls[0]+=1;reader._last_classification_stable=p\n        return \'\'\n    reader.classify=classify\n    counts=[];pending_clears=0\n    for frame in range(frames):\n        now=frame*.025;slots={};before=calls[0]\n        begin_classifications(reader)\n        for index in range(129,629):\n            p=index*4096;serial=1\n            if optimized:cls,row,_=resolve_slot(reader,index,p,serial,now)\n            else:\n                old=reader.slots.get(index);same=bool(old and old[:2]==(p,serial))\n                retry=bool(same and not old[2] and (index<=128 or len(old)<4 or not 0<=now-old[3]<.1))\n                if same and not retry:cls=old[2];row=old\n                else:cls=classify(p);row=(p,serial,cls,now)\n            slots[index]=row\n        reader.slots=slots;reads=calls[0]-before;counts.append(reads)\n        # Explicit synthetic cost model: 20ms actor work + 0.25ms/classification.\n        # No measurement claim is made for this machine or the game process.\n        if frame and .020+reads*.00025>.120:pending_clears+=1\n    return dict(frames=frames,scene_objects=500,classifications=calls[0],\n        warm_frame_max=max(counts[1:]),cold_classifications=counts[0],\n        modeled_expired_frames=pending_clears,counts=counts,\n        cost_model_only=True,actual_game_timing_verified=False)\n\n\ndef run():\n    from display_slot_cache import begin_classifications,resolve_slot\n    class Tests(unittest.TestCase):\n        def reader(self,result=\'\',stable=True):\n            r=NS(slots={},control_geometry=False,calls=0,result=result,stable=stable)\n            def classify(p):\n                r.calls+=1;r._last_classification_stable=p if r.stable else None\n                return r.result\n            r.classify=classify;begin_classifications(r);return r\n        def save(self,r,i,p,serial,now):\n            cls,row,recovered=resolve_slot(r,i,p,serial,now);r.slots[i]=row\n            return cls,recovered\n        def test_replays_old_storm_then_bounded_new_refresh(self):\n            old=population_replay(False);new=population_replay(True)\n            self.assertEqual(old[\'warm_frame_max\'],500);self.assertLessEqual(new[\'warm_frame_max\'],16)\n            self.assertGreater(old[\'modeled_expired_frames\'],20);self.assertEqual(new[\'modeled_expired_frames\'],0)\n            self.assertLess(new[\'classifications\'],old[\'classifications\']*.1)\n        def test_player_slot_unknown_retried_each_frame(self):\n            r=self.reader();self.save(r,2,4096,1,0.)\n            r.result=\'CCSPlayer\';cls,recovered=self.save(r,2,4096,1,.01)\n            self.assertEqual(cls,\'CCSPlayer\');self.assertTrue(recovered);self.assertEqual(r.calls,2)\n        def test_uninitialized_high_slot_keeps_100ms_retry(self):\n            r=self.reader(stable=False);self.save(r,500,4096,1,0.)\n            r.result=\'CZombie\';self.save(r,500,4096,1,.05);self.assertEqual(r.calls,1)\n            cls,recovered=self.save(r,500,4096,1,.11)\n            self.assertEqual(cls,\'CZombie\');self.assertTrue(recovered)\n        def test_generation_change_invalidates_negative_cache_immediately(self):\n            r=self.reader();self.save(r,500,4096,1,0.);r.result=\'CZombie\'\n            cls,_=self.save(r,500,4096,2,.01)\n            self.assertEqual(cls,\'CZombie\');self.assertEqual(r.calls,2)\n        def test_address_change_invalidates_immediately(self):\n            r=self.reader();self.save(r,500,4096,1,0.);r.result=\'CHostage\'\n            self.assertEqual(self.save(r,500,8192,1,.01)[0],\'CHostage\')\n        def test_positive_actor_never_uses_refresh_budget(self):\n            r=self.reader(\'CCSPlayer\');self.save(r,500,4096,1,0.)\n            r._ignored_refresh_budget=0;self.assertEqual(self.save(r,500,4096,1,10.)[0],\'CCSPlayer\')\n            self.assertEqual(r.calls,1)\n        def test_deferred_due_slot_not_postponed_forever(self):\n            r=self.reader();self.save(r,500,4096,1,0.);r._ignored_refresh_budget=0\n            self.save(r,500,4096,1,3.);self.assertEqual(r.slots[500][3],0.)\n            begin_classifications(r);r.result=\'CZombie\'\n            self.assertEqual(self.save(r,500,4096,1,3.01)[0],\'CZombie\')\n        def test_control_geometry_retains_original_behavior(self):\n            r=self.reader();r.control_geometry=True;self.save(r,500,4096,1,0.)\n            self.save(r,500,4096,1,.11);self.assertEqual(r.calls,2);self.assertEqual(len(r.slots[500]),4)\n        def test_failure_is_not_cached(self):\n            r=self.reader();r.classify=lambda p:(_ for _ in ()).throw(ValueError(\'fixture\'))\n            with self.assertRaises(ValueError):self.save(r,500,4096,1,0.)\n            self.assertFalse(r.slots)\n        def test_scope_reset_forgets_previous_map_cache(self):\n            r=self.reader();self.save(r,500,4096,1,0.);r.slots.clear();r.result=\'CCSPlayer\'\n            self.assertEqual(self.save(r,500,4096,1,.01)[0],\'CCSPlayer\')\n        def test_classify_distinguishes_valid_ignored_from_uninitialized(self):\n            from server_esp import ServerDisplayReader\n            r=ServerDisplayReader.__new__(ServerDisplayReader)\n            name=[\'prop_dynamic\'];r.mem=NS(u32=lambda p:123,string=lambda p,n:name[0])\n            r.rtti=lambda p:(\'.?AVCBaseEntity@@\',)\n            self.assertEqual(r.classify(4096),\'\');self.assertEqual(r._last_classification_stable,4096)\n            name[0]=\'\';self.assertEqual(r.classify(4096),\'\');self.assertIsNone(r._last_classification_stable)\n            name[0]=\'base_entity\';self.assertEqual(r.classify(4096),\'\');self.assertIsNone(r._last_classification_stable)\n            name[0]=\'player\';self.assertEqual(r.classify(4096),\'CCSPlayer\')\n            self.assertIsNone(r._last_classification_stable)\n        def test_unknown_negative_stays_unresolved_when_mock_omits_metadata(self):\n            r=self.reader();r.classify=lambda p:\'\'\n            self.save(r,500,4096,1,0.);self.assertFalse(r.slots[500][4])\n    stream=io.StringIO();result=unittest.TextTestRunner(stream=stream,verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(Tests))\n    if not result.wasSuccessful():raise AssertionError(stream.getvalue())\n    old=population_replay(False);new=population_replay(True)\n    return dict(passed=True,tests=result.testsRun,classification_replay={k:{n:v for n,v in x.items() if n!=\'counts\'} for k,x in [(\'before\',old),(\'after\',new)]},\n                game_attached=False,input_sent=False,live_flicker_verified=False)\n')

_EMBEDDED['display_recovery'] = (1, '"""Renderer recovery ownership; acquisition and native surfaces stay separate.\n\nThis policy owns no process, window, game memory or input. It routes a fault\nto its existing owner and gives each repair domain its own bounded clock.\n"""\nfrom esp_shared import DisplayRetry\n\n\nclass DisplayRecovery:\n    def __init__(self, clock=None):\n        import time\n        self.clock=clock or time.monotonic\n        self.gates={name:DisplayRetry(self.clock) for name in (\'reader\',\'camera\',\'surface\')}\n        self.domain=\'healthy\';self.owner=\'renderer\';self.reason=\'\'\n        self.last_action=\'\';self.action_error=\'\';self.wait_since=None;self.waits=0\n\n    def failed(self, error, stage, surface_action=None):\n        from server_esp import DisplaySampleUnavailable,DisplayCameraUnavailable\n        from reader import NotReady\n        if (surface_action or {}).get(\'action\')==\'surface_retry\':\n            domain=\'surface\'\n        elif isinstance(error,DisplaySampleUnavailable):\n            domain=\'sample\'\n        elif isinstance(error,DisplayCameraUnavailable):\n            domain=\'camera\'\n        elif isinstance(error,NotReady):\n            domain=\'reader\'\n        else:\n            domain=\'surface\' if stage==\'surface\' else \'reader\'\n        if domain!=self.domain:self.action_error=\'\'\n        self.domain=domain\n        self.owner=\'sampler\' if domain==\'sample\' else (\'surface\' if domain==\'surface\' else \'renderer_reader\')\n        self.reason=type(error).__name__+\': \'+str(error)\n        self.last_action=\'\'\n        if domain==\'sample\':\n            # ServerSampleProcess already owns exit/silence recovery. Waiting\n            # for its packet must not accrue reader/surface repair attempts.\n            if self.wait_since is None:self.wait_since=self.clock()\n            self.waits+=1\n            return \'\'\n        self.wait_since=None\n        if self.gates[domain].failed(self.reason):\n            self.last_action=\'surface\' if domain==\'surface\' else \'reader\'\n        return self.last_action\n\n    def succeeded(self):\n        for gate in self.gates.values():gate.succeeded()\n        self.domain=\'healthy\';self.owner=\'renderer\';self.reason=\'\'\n        self.wait_since=None;self.last_action=\'\';self.action_error=\'\'\n\n    def repair_failed(self,error):\n        # A failed bounded repair remains an incident, not a reason to unwind\n        # serve() and destroy unrelated working resources immediately.\n        self.action_error=type(error).__name__+\': \'+str(error)\n\n    def metrics(self):\n        details={name:gate.metrics() for name,gate in self.gates.items()}\n        active=details.get(self.domain,{})\n        return dict(active,domain=self.domain,owner=self.owner,reason=self.reason,\n            attempts=sum(v[\'attempts\'] for v in details.values()),\n            recoveries=sum(v[\'recoveries\'] for v in details.values()),\n            last_action=self.last_action,action_error=self.action_error,domains=details,\n            sample_waits=self.waits,\n            sample_wait_seconds=round(max(0.,self.clock()-self.wait_since),3) if self.wait_since is not None else 0.)\n\n\ndef sampler_owns_wait(report, now):\n    """Only suppress renderer recycling with current acquisition evidence.\n\n    A heartbeat alone is insufficient. Both producer phase and source lanes\n    must be advancing/retrying within their existing transport deadline.\n    Frozen/missing telemetry, valid unread samples and dead lanes fall back\n    to the ordinary watchdog. No sample timestamps are changed here.\n    """\n    import math\n    def finite(v):return isinstance(v,(int,float)) and not isinstance(v,bool) and math.isfinite(v)\n    recovery=report.get(\'recovery\') or {}\n    if (report.get(\'state\')!=\'recovering\' or recovery.get(\'domain\')!=\'sample\'\n            or recovery.get(\'owner\')!=\'sampler\'):return False\n    sampling=report.get(\'sampling_health\') or {}\n    if sampling.get(\'process_alive\') is not True or sampling.get(\'received_reply\') is not True:return False\n    age=sampling.get(\'last_reply_age_ms\');phase=sampling.get(\'phase\') or {}\n    at=phase.get(\'stage_started\')\n    if not finite(age) or not 0<=age<=1500 or not finite(at) or not 0<=now-at<=1.5:return False\n    # A fresh packet waiting in the consumer is a rendering problem, not a\n    # supply shortage. Leave its scene/presentation deadlines intact.\n    sample_age=sampling.get(\'sample_age_ms\')\n    if finite(sample_age) and 0<=sample_age<=120:return False\n    sources=phase.get(\'sources\') or {};lanes=sources.get(\'lanes\') or {}\n    if set(lanes)!=set((\'server\',\'client\')):return False\n    rejected=sources.get(\'rejected\') or {}\n    pinned=(\'client\' if sources.get(\'policy\')==\'client_primary_server_dormant_assist\' else\n            (sources.get(\'routing\') or {}).get(\'source\'))\n    active={pinned:lanes[pinned]} if pinned in lanes else lanes\n    if any(rejected.get(name) not in (\'awaiting_source\',\'expired\') for name in active):return False\n    for lane in active.values():\n        if lane.get(\'thread_alive\') is not True:return False\n        lane_phase=lane.get(\'phase\') or {};lane_age=lane_phase.get(\'stage_age_ms\')\n        if not finite(lane_age) or not 0<=lane_age<=1500:return False\n        if lane_phase.get(\'stage\') in (\'idle\',\'attach\'):return False\n    return True\n')
_EMBEDDED['esp_system_contract'] = (1, '"""Focused ESP source-complement contract."""\nimport io\nimport unittest\nimport copy\nimport struct\nfrom types import SimpleNamespace as NS\nfrom unittest.mock import patch\n\n\ndef source_wait_report(now):\n    lane = lambda stage: dict(thread_alive=True,phase=dict(stage=stage, stage_age_ms=0.0))\n    return dict(state=\'recovering\', recovery=dict(domain=\'sample\',owner=\'sampler\'),\n        sampling_health=dict(process_alive=True,received_reply=True,last_reply_age_ms=1.,\n        sample_age_ms=None,phase=dict(stage_started=now,sources=dict(\n        policy=\'client_primary_server_dormant_assist\',routing=dict(source=\'server\',role=\'local_host\'),\n        rejected={\'client\':\'awaiting_source\',\'server\':\'awaiting_source\'},\n        lanes=dict(client=lane(\'frame_read\'), server=lane(\'idle\'))))))\n\n\ndef _frame(source, stamp, scope):\n    from esp_skeleton_rules import fixture\n    frame=fixture(\'blocked\');frame.source=source;frame.source_pid=scope[0]\n    frame.stamp=stamp;frame.server_base=1 if source==\'server\' else 0\n    for actor in frame.entities:actor.display_source=source\n    return frame\n\n\ndef adaptive_fixture(host=True,count=8):\n    from esp_shared import AdaptiveDisplayReader\n    from esp_skeleton_rules import fixture\n    scope=(70007,6,\'maps/CS_ITALY.bsp\',2)\n    cf=fixture(\'blocked\',count=count);cf.source=\'client\';cf.source_pid=scope[0];cf.stamp=10.;cf.server_base=0\n    sf=copy.deepcopy(cf);sf.source=\'server\';sf.server_base=1\n    for actor in cf.entities:\n        actor.dormant=True;actor.display_source=\'client\'\n    for actor in [sf.local,*sf.entities]:\n        actor.address+=0x100000;actor.serial+=4097;actor.display_source=\'server\'\n    class Lane:\n        def __init__(self,frame):self.packet=(frame,{},scope);self.request=None\n        def configure(self,scope,args,kwargs):self.request=(scope,args,kwargs)\n        def snapshot(self):return self.packet,{}\n        def pause(self):self.request=None;self.packet=None\n    r=AdaptiveDisplayReader.__new__(AdaptiveDisplayReader)\n    r.client_reader=NS(mem=NS(pid=scope[0]));r._scope=scope;r.source=\'client\';r.source_epoch=0\n    r.display_camera=NS(reset=lambda:None);r._display_identity=None\n    r._display_route=NS(role=\'local_host\' if host else \'remote_player\',verified=True,\n        snapshot=lambda:dict(source=\'server\' if host else \'client\',verified=True))\n    r.select_source=lambda:None;r._lanes={\'client\':Lane(cf),\'server\':Lane(sf)}\n    return r,cf,sf\n\n\ndef run():\n    from esp_sources import StableDisplaySelector\n    scope = (70007, 6, \'maps/CS_ITALY.bsp\', 2)\n    client = (_frame(\'client\', 10.00, scope), {}, scope)\n    server = (_frame(\'server\', 10.01, scope), {}, scope)\n\n    def obstacle_fixture(source=\'client\'):\n        from esp_skeleton_rules import fixture\n        from esp_feedback import shared_verdict_packet\n        from server_esp import TABLE\n        shown=fixture(\'blocked\',count=2);shown.source=\'client\';shown.stamp=10.\n        native={};table=0x900000;base=0x10000000\n        for actor in [shown.local,*shown.entities]:\n            actor.display_source=source;actor.pose_sample_stamp=10.\n            entry=(table if source==\'client\' else base+TABLE)+actor.index*16\n            native[entry]=struct.pack(\'<II\',actor.address,actor.serial)\n        raw=copy.deepcopy(shown)\n        for actor in raw.entities:\n            actor.head=None;actor.skeleton=[];actor.aim_points=[]\n        reader=NS(global_addr=lambda _:table,mods={\'server.dll\':(base,0)},\n            mem=NS(pid=7,read=lambda address,size:native[address]))\n        packet=shared_verdict_packet(shown,7,10.01)\n        return shown,raw,reader,packet,native\n\n    class Tests(unittest.TestCase):\n        def test_obstacle_input_reuses_current_esp_bones_without_control_resampling(self):\n            from wall_service import display_wall_frame\n            shown,raw,reader,packet,native=obstacle_fixture()\n            result,info=display_wall_frame(raw,packet,reader,10.02)\n            self.assertEqual(info[\'input_targets\'],2,info)\n            self.assertEqual([p.position for p in result.entities[0].aim_points],\n                [tuple(p[\'position\']) for p in packet[\'actors\'][0][\'points\']])\n            self.assertTrue(all(e.head is None and not e.aim_points for e in raw.entities))\n            self.assertEqual(result.stamp,10.)\n\n        def test_obstacle_input_uses_host_assist_only_for_current_host(self):\n            from wall_service import display_wall_frame\n            for source in (\'server\',\'server_assist\'):\n                shown,raw,reader,packet,native=obstacle_fixture(source)\n                raw.entities=[]\n                for host,count in ((True,2),(False,0),(None,0)):\n                    with patch(\'runtime_compat.native_loopback\',return_value=host):\n                        result,info=display_wall_frame(raw,packet,reader,10.02)\n                    self.assertEqual(len(result.entities),count,(source,host,info))\n\n        def test_obstacle_input_rejects_wrong_session_and_expired_geometry(self):\n            from wall_service import display_wall_frame\n            for field,value in ((\'pid\',8),(\'map\',\'other\'),(\'weapon\',\'other\'),\n                    (\'stamp\',9.9),(\'stamp\',10.1),(\'local\',[999,1])):\n                shown,raw,reader,packet,native=obstacle_fixture();packet[field]=value\n                self.assertIsNone(display_wall_frame(raw,packet,reader,10.02)[0])\n            for stamp in (9.9,10.1):\n                shown,raw,reader,packet,native=obstacle_fixture()\n                packet[\'actors\'][0][\'geometry_stamp\']=stamp\n                result,info=display_wall_frame(raw,packet,reader,10.02)\n                self.assertEqual([e.index for e in result.entities],[shown.entities[1].index])\n                self.assertEqual(info[\'rejected\'],1)\n\n        def test_obstacle_input_death_and_identity_failure_are_local_to_one_actor(self):\n            from wall_service import display_wall_frame\n            for fault in (\'health\',\'ragdoll\',\'identity\',\'dormant\',\'model\',\'malformed\'):\n                shown,raw,reader,packet,native=obstacle_fixture()\n                row=packet[\'actors\'][0]\n                if fault==\'health\':row[\'health\']=0\n                elif fault==\'ragdoll\':row.update(health=1,ragdoll_present=True)\n                elif fault==\'identity\':row[\'identity\'][2]+=1\n                elif fault==\'dormant\':raw.entities[0].dormant=True\n                elif fault==\'model\':row[\'identity\'][3]=\'other.mdl\'\n                else:row[\'points\']=None\n                result,info=display_wall_frame(raw,packet,reader,10.02)\n                self.assertEqual([e.index for e in result.entities],[shown.entities[1].index],fault)\n\n        def test_old_ray_evidence_does_not_age_new_obstacle_geometry(self):\n            from esp_feedback import shared_verdict_packet\n            from wall_service import display_wall_frame\n            shown,raw,reader,packet,native=obstacle_fixture()\n            for actor in shown.entities:\n                actor.visibility=\'penetrable\'\n                actor.display_penetration=dict(penetrable=True,display_evidence_stamp=9.94,\n                    display_ray_eye=shown.eye,display_ray_head=actor.head)\n            packet=shared_verdict_packet(shown,7,10.01)\n            self.assertEqual(packet[\'actors\'][0][\'pose_stamp\'],10.)\n            self.assertEqual(packet[\'actors\'][0][\'geometry_stamp\'],10.)\n            result,info=display_wall_frame(raw,packet,reader,10.02)\n            self.assertEqual(len(result.entities),2,info)\n            self.assertEqual(result.stamp,10.)\n            shown.entities[0].pose_sample_stamp=9.94\n            packet=shared_verdict_packet(shown,7,10.01)\n            self.assertEqual(len(display_wall_frame(raw,packet,reader,10.02)[0].entities),1)\n\n        def test_main_worker_submits_display_geometry_when_control_has_no_bones(self):\n            from cso2_bot_tool import Worker,Config\n            from wall_service import WallService,wall_scope\n            import queue\n            shown,raw,reader,packet,native=obstacle_fixture()\n            service=WallService.__new__(WallService)\n            service.closed=False;service.proc=NS(poll=lambda:None);service.busy=False\n            service.requests=queue.Queue(1);service.poll=lambda *args:[]\n            worker=Worker.__new__(Worker);worker.reader=reader;worker.game=\'fixture\'\n            worker.map_resources=NS(update=lambda *args:dict(generation=1));worker.manual_bsp=None\n            worker.map_key=(raw.map_name,None,1);worker.wall_service=service\n            worker.wall_result_scope=wall_scope(raw,{});worker.wall_cache={};worker.last_trace=0.\n            # Visibility can still be waiting on native rays while current\n            # geometry is already available to the obstacle worker.\n            worker.overlay_service=NS(wall_geometry=packet,targets={});worker.target=0;worker.battle=None\n            with patch(\'cso2_bot_tool.time.monotonic\',return_value=10.02):\n                worker.update_wall_channel(raw,Config(grenade_dodge=False),{})\n            self.assertFalse(getattr(worker,\'wall_channel_error\',\'\'))\n            request=service.requests.get_nowait()\n            self.assertEqual(len(request[\'entities\']),2)\n            self.assertTrue(all(row[4] for row in request[\'entities\']))\n\n        def test_server_never_owns_a_full_display_frame(self):\n            selector = StableDisplaySelector()\n            selected, rejected = selector.choose({\'server\': server}, scope, 10.02)\n            self.assertIsNone(selected)\n            self.assertEqual(rejected[\'server\'], \'assist_only\')\n\n        def test_client_remains_authoritative_when_both_packets_exist(self):\n            selector = StableDisplaySelector()\n            selected, rejected = selector.choose(\n                {\'client\': client, \'server\': server}, scope, 10.02)\n            self.assertIsNotNone(selected)\n            self.assertEqual(selected[0].source, \'client\')\n            self.assertEqual(selector.switches, 0)\n\n        def test_missing_bundle_dependency_is_importable(self):\n            from display_work_budget import SampleWorkGate,DisplaySessionRoute\n            self.assertTrue(callable(SampleWorkGate));self.assertTrue(callable(DisplaySessionRoute))\n\n        def test_more_than_five_dormant_targets_use_server_native_identities(self):\n            r,cf,sf=adaptive_fixture()\n            with patch(\'esp_shared.time.monotonic\',return_value=10.02):out=r.frame(\'普通竞技\')\n            self.assertEqual(out.source,\'client\');self.assertEqual(len(out.entities),8)\n            self.assertEqual([e.address for e in out.entities],[e.address for e in sf.entities])\n            self.assertTrue(all(e.display_source==\'server_assist\' for e in out.entities))\n            request=r._lanes[\'server\'].request[2]\n            self.assertEqual(len(request[\'assist_indices\']),8)\n            self.assertEqual(request[\'assist_identities\'],{})\n\n        def test_client_return_immediately_removes_server_sampling_then_hands_back(self):\n            r,cf,sf=adaptive_fixture()\n            with patch(\'esp_shared.time.monotonic\',return_value=10.02):\n                r.frame(\'普通竞技\')\n                for e in cf.entities[:3]:e.dormant=False\n                sf.server_discovered=copy.deepcopy(sf.entities)\n                for _ in range(3):\n                    out=r.frame(\'普通竞技\')\n                    self.assertEqual([e.address for e in out.entities[:3]],[e.address for e in cf.entities[:3]])\n                    self.assertEqual(len({e.index for e in out.entities}),8)\n                    self.assertEqual(len(r._lanes[\'server\'].request[2][\'assist_indices\']),5)\n                cf.entities[0].dormant=True\n                out=r.frame(\'普通竞技\')\n                self.assertEqual(out.entities[0].address,sf.entities[0].address)\n                self.assertEqual(len(r._lanes[\'server\'].request[2][\'assist_indices\']),6)\n\n        def test_client_disappearance_uses_fresh_server_without_duplicate(self):\n            r,cf,sf=adaptive_fixture()\n            with patch(\'esp_shared.time.monotonic\',return_value=10.02):\n                r.frame(\'普通竞技\');cf.entities.pop()\n                out=r.frame(\'普通竞技\')\n            self.assertEqual(len(out.entities),8)\n            self.assertEqual(len({e.index for e in out.entities}),8)\n\n        def test_server_only_actor_stays_sampled_after_discovery_window(self):\n            r,cf,sf=adaptive_fixture(count=1)\n            cf.entities=[];sf.server_discovered=copy.deepcopy(sf.entities)\n            for step in range(12):\n                now=10.+step*.1;cf.stamp=sf.stamp=now\n                with patch(\'esp_shared.time.monotonic\',return_value=now+.01):out=r.frame(\'普通竞技\')\n                if step:\n                    self.assertEqual(len(out.entities),1)\n                    self.assertEqual(r._lanes[\'server\'].request[2][\'assist_indices\'],(sf.entities[0].index,))\n                sf.server_discovered=[]\n\n        def test_nonhost_never_samples_or_merges_server(self):\n            r,cf,sf=adaptive_fixture(False)\n            with patch(\'esp_shared.time.monotonic\',return_value=10.02):out=r.frame(\'普通竞技\')\n            self.assertIsNone(r._lanes[\'server\'].request)\n            self.assertEqual([e.address for e in out.entities],[e.address for e in cf.entities])\n\n        def test_foreign_server_session_and_expired_packets_are_not_merged(self):\n            for fault in (\'map\',\'future\',\'expired\'):\n                r,cf,sf=adaptive_fixture()\n                if fault==\'map\':sf.map_name=\'maps/other.bsp\'\n                else:sf.stamp=11. if fault==\'future\' else 9.\n                with patch(\'esp_shared.time.monotonic\',return_value=10.02):out=r.frame(\'普通竞技\')\n                self.assertEqual([e.address for e in out.entities],[e.address for e in cf.entities])\n\n        def test_90ms_is_not_a_new_sample_removal_deadline(self):\n            r,cf,sf=adaptive_fixture();sf.stamp=9.91\n            with patch(\'esp_shared.time.monotonic\',return_value=10.02):out=r.frame(\'普通竞技\')\n            self.assertEqual(out.entities[0].address,sf.entities[0].address)\n\n        def test_host_watchdog_observes_client_even_when_server_is_idle(self):\n            from display_recovery import sampler_owns_wait\n            report=source_wait_report(10.)\n            self.assertTrue(sampler_owns_wait(report,10.))\n            report[\'sampling_health\'][\'phase\'][\'sources\'][\'lanes\'][\'client\'][\'phase\'][\'stage_age_ms\']=2000.\n            self.assertFalse(sampler_owns_wait(report,10.))\n\n        def test_worker_record_and_final_bit_reach_draw_for_both_actor_sources(self):\n            from wall_service import esp_positive_records,WALL_SIGNAL_SCHEMA\n            from overlay_service import _wall_payload,apply_wall_bridge\n            from esp_flicker_contract import scene_fixture\n            from esp_pipeline import FrameVisibility\n            from cso2_bot_tool import Config,draw_scene\n            from server_esp import TABLE\n            for control in (\'client\',\'server\'):\n                for actor_source in (\'client\',\'server\',\'server_assist\'):\n                    for representation in (\'worker\',\'bit\'):\n                        f,canvas=scene_fixture(20.,\'blocked\');f.source=\'client\';f.stamp=10.02\n                        e=f.entities[0];e.display_source=actor_source\n                        native={};client_table=0x900000;server_base=0x10000000\n                        identities={}\n                        for actor in (f.local,e):\n                            owner=\'server\' if actor is e and actor_source in (\'server\',\'server_assist\') else \'client\'\n                            for source in (\'client\',\'server\'):\n                                address=actor.address if source==owner else actor.address+0x200000\n                                serial=actor.serial if source==owner else actor.serial+71\n                                identities[(actor.index,source)]=(address,serial)\n                                table=client_table if source==\'client\' else server_base+TABLE\n                                native[table+actor.index*16]=struct.pack(\'<II\',address,serial)\n                        reader=NS(global_addr=lambda _:client_table,mods={\'server.dll\':(server_base,0)},\n                            mem=NS(read=lambda address,size:native[address]))\n                        address,serial=identities[(e.index,control)]\n                        bit=dict(penetrable=True,stamp=10.,address=address,serial=serial,model=e.model,\n                            display_ray_eye=f.eye,display_ray_head=e.head)\n                        path=dict(schema=WALL_SIGNAL_SCHEMA,kind=\'penetration\',allowed=True,\n                            wall_publish_positive=True,obstacle_assessment_complete=True,\n                            map=f.map_name,weapon=f.weapon,profile_hash=\'fixture\')\n                        record=[address,e.head,f.eye,\'penetrable\',\'可穿透\',10.,e.model,\n                            [[\'head\',e.head,\'penetrable\',\'可穿透\',True,path]],serial]\n                        packet=esp_positive_records({e.index:record if representation==\'worker\' else bit})\n                        payload=_wall_payload(packet)\n                        context=dict(pid=7,map=f.map_name,control_source=control,\n                            local_identity=[f.local.index,*identities[(f.local.index,control)]])\n                        result=apply_wall_bridge(f,payload,context,7,10.02,reader)\n                        self.assertEqual(result[\'applied\'],1,(control,actor_source,representation,result))\n                        cfg=Config();cfg.walls=False\n                        visibility=FrameVisibility(\'fixture\');visibility.update(f,cfg)\n                        self.assertEqual(f.entities[0].visibility,\'penetrable\')\n                        self.assertEqual(draw_scene(canvas,f,cfg)[\'health_bars\'],1)\n                        # A mixed CLIENT frame can carry a SERVER actor\'s bit.\n                        # Its per-actor identity takes precedence over frame source.\n                        mixed=copy.deepcopy(f);mixed_context=dict(context,control_source=\'client\',\n                            local_identity=[f.local.index,*identities[(f.local.index,\'client\')]])\n                        self.assertEqual(apply_wall_bridge(mixed,payload,mixed_context,7,10.02,reader)[\'applied\'],1)\n                        changed=copy.deepcopy(f);context[\'local_identity\'][2]+=1\n                        self.assertEqual(apply_wall_bridge(changed,payload,context,7,10.02,reader)[\'applied\'],0)\n\n    output = io.StringIO()\n    result = unittest.TextTestRunner(stream=output, verbosity=0).run(\n        unittest.defaultTestLoader.loadTestsFromTestCase(Tests))\n    if not result.wasSuccessful():\n        raise AssertionError(output.getvalue())\n    return dict(passed=True, tests=result.testsRun, game_attached=False,\n                simulated_client_primary=True, server_full_frame_rejected=True,\n                live_render_verified=False)\n')
_EMBEDDED['esp_flow_contract'] = (1, '"""Direct regressions for the new-build live source-flapping report."""\nimport copy,io,json,unittest\nfrom contextlib import ExitStack\nfrom types import SimpleNamespace as NS\nfrom unittest.mock import Mock,patch\n\n\ndef producer_replay(ticks=120):\n    """Exercise actual serve_server_samples; 30 acquisitions at 120 polls/s."""\n    import server_esp,esp_shared,esp_pipeline,esp_transport,presentation\n    from cso2_bot_tool import Config\n    from esp_skeleton_rules import fixture\n    now=[10.];tick=[0];metrics={\'prepare_calls\':0,\'publications\':0,\'expired\':0,\'polls\':0}\n    class Kernel:\n        def OpenProcess(self,*a):return 100\n        def CloseHandle(self,*a):pass\n        def WaitForSingleObject(self,handle,timeout):\n            if handle==100:return 258 if tick[0]<ticks else 0\n            tick[0]+=1;now[0]=10.+tick[0]/120\n            return 258\n    class Mail:\n        def __init__(self,name,*a,**kw):self.name=name;self.event=101;self.reads=0\n        def read_latest(self):\n            self.reads+=1\n            if self.name.endswith(\'_request\') and self.reads==1:\n                return json.dumps({\'epoch\':0,\'cfg\':vars(Config()),\'warnings\':None}).encode()\n            return None\n        def write(self,payload):\n            if self.name.endswith(\'_reply\'):\n                obj=server_esp.decode_server_packet(payload)\n                if \'packet\' in obj:\n                    metrics[\'publications\']+=1\n                    if now[0]-obj[\'packet\'][0].stamp>.12:metrics[\'expired\']+=1\n            return True\n        def close(self):pass\n    class Reader:\n        def __init__(self,*a):\n            self.mem=NS(pid=70007);self.sample_ms=20.;self.entity_stats={}\n            self.pose_refresher=None;self.game=\'fixture\'\n        def attach(self,**kw):pass\n        def frame(self,*a,**kw):\n            metrics[\'polls\']+=1\n            f=fixture(count=2);f.stamp=10.+(tick[0]//4)*4/120\n            f.source=\'client\';f.source_pid=70007;f.server_base=0;return f\n        def pause_sources(self):pass\n        def recover_display(self):raise AssertionError(\'no recovery expected\')\n        def close(self):pass\n    class Visibility:\n        completed=None\n        def __init__(self,*a):self.metrics={}\n        def prepare(self,raw,displayed,cfg):\n            metrics[\'prepare_calls\']+=1;return raw,displayed\n        def reset(self):pass\n        def close(self):pass\n    clock=NS(monotonic=lambda:now[0])\n    with ExitStack() as stack:\n        for obj,name,value in [(server_esp,\'time\',clock),(esp_transport,\'LatestMailbox\',Mail),\n                (esp_transport,\'kernel\',lambda:Kernel()),(esp_shared,\'AdaptiveDisplayReader\',Reader),\n                (esp_pipeline,\'CurrentFrameVisibility\',Visibility),\n                (presentation,\'TimerResolution\',lambda:NS(set_active=lambda b:None,close=lambda:None)),\n                (server_esp,\'DisplayHostageWarnings\',lambda:NS(update=lambda *a:[]))]:\n            stack.enter_context(patch.object(obj,name,value))\n        try:import display_work_budget\n        except ImportError:pass\n        else:\n            original=display_work_budget.SampleWorkGate\n            stack.enter_context(patch.object(display_work_budget,\'SampleWorkGate\',lambda:original(clock=lambda:now[0])))\n        server_esp.serve_server_samples(\'fixture\',\'fixture\',123,70007)\n    return dict(metrics,source_acquisitions=(ticks+3)//4,polls_expected=ticks,\n        raw_sample_limit_ms=120.,game_attached=False,game_input=False,live_timing_verified=False)\n\n\ndef flap_replay(host=True):\n    from esp_shared import AdaptiveDisplayReader\n    from esp_skeleton_rules import fixture\n    scope=(70007,6,\'maps/CS_ITALY.bsp\',2)\n    def packet(source,stamp):\n        f=fixture();f.stamp=stamp;f.source=source;f.source_pid=70007\n        f.server_base=1 if source==\'server\' else 0\n        return f,{},scope\n    r=AdaptiveDisplayReader.__new__(AdaptiveDisplayReader)\n    r.client_reader=NS(mem=NS(pid=70007,u32=lambda *a:0),global_addr=lambda n:n)\n    r._scope=scope;r.source=\'server\';r.source_epoch=0;r._display_identity=None\n    r.display_camera=NS(reset=lambda:None);r.select_source=lambda:r.source\n    r._display_route=NS(role=\'local_host\' if host else \'remote_player\',verified=True,\n        source=\'server\' if host else \'client\',snapshot=lambda:dict(\n        source=\'server\' if host else \'client\',role=\'local_host\' if host else \'remote_player\',verified=True))\n    packets={};counts={n:dict(configures=0,pauses=0) for n in (\'server\',\'client\')}\n    class Lane:\n        def __init__(self,name):self.name=name;self.request=None\n        def configure(self,*args):counts[self.name][\'configures\']+=1;self.request=args\n        def pause(self):counts[self.name][\'pauses\']+=1;self.request=None\n        def snapshot(self):return packets.get(self.name),{}\n    r._lanes={name:Lane(name) for name in counts}\n    choices=[]\n    import esp_sources\n    for n in range(120):\n        now=10.21+n*.01\n        packets.update({\'client\':packet(\'client\',now-(.085 if n%2==0 else .01)),\n                        \'server\':packet(\'server\',now-(.02 if n%2==0 else .11))})\n        with patch(\'esp_shared.time.monotonic\',return_value=now):\n            choice=r.frame(\'普通竞技\',0,with_aimpoints=False);choices.append(choice.source)\n    return dict(polls=120,role=\'host\' if host else \'remote_player\',switches=r._display_selector.switches,\n                server_choices=choices.count(\'server\'),client_choices=choices.count(\'client\'),\n                lane_work=counts,modeled_timing=True,live_flicker_verified=False)\n\n\ndef run():\n    from display_work_budget import SampleWorkGate,DisplaySessionRoute\n    from esp_sources import StableDisplaySelector,DisplaySourceLane\n    from esp_skeleton_rules import fixture\n    from cso2_bot_tool import Config\n    class Work(unittest.TestCase):\n        def setUp(self):\n            self.now=10.;self.g=SampleWorkGate(lambda:self.now);self.f=fixture();self.f.stamp=10.\n            self.cfg=Config();self.v=NS(completed=None)\n        def commit(self):\n            needed,key=self.g.request(self.f,self.cfg,self.v);self.assertTrue(needed);self.g.committed(key)\n        def test_same_frame_is_not_reprocessed_at_render_poll_rate(self):\n            self.commit()\n            for n in range(1,6):\n                self.now=10.+n*.008\n                self.assertFalse(self.g.request(self.f,self.cfg,self.v)[0])\n            self.assertEqual(self.f.stamp,10.)\n        def test_actual_new_acquisition_is_immediate(self):\n            self.commit();self.f.stamp=10.001;self.assertTrue(self.g.request(self.f,self.cfg,self.v)[0])\n        def test_late_enhancement_of_same_acquisition_is_immediate(self):\n            self.commit();self.v.completed=(1,(),self.f,self.f,{},10.001)\n            self.assertTrue(self.g.request(self.f,self.cfg,self.v)[0])\n        def test_settings_do_not_wait_for_new_source(self):\n            self.commit();self.cfg.walls=not self.cfg.walls\n            self.assertTrue(self.g.request(self.f,self.cfg,self.v)[0])\n        def test_warning_refresh_is_bounded(self):\n            self.commit();self.now=10.051;self.assertTrue(self.g.request(self.f,self.cfg,self.v)[0])\n        def test_failed_publication_does_not_commit_or_drop_retry(self):\n            self.assertTrue(self.g.request(self.f,self.cfg,self.v)[0])\n            self.assertTrue(self.g.request(self.f,self.cfg,self.v)[0])\n        def test_new_identity_same_stamp_does_not_disappear(self):\n            self.commit();self.f.local.serial+=1;self.assertTrue(self.g.request(self.f,self.cfg,self.v)[0])\n        def test_map_and_source_reset_gate(self):\n            self.commit();self.f.map_name=\'maps/new.bsp\';self.assertTrue(self.g.request(self.f,self.cfg,self.v)[0])\n            self.g.reset();self.assertTrue(self.g.request(self.f,self.cfg,self.v)[0])\n        def test_real_producer_skips_unchanged_work_not_sample_check(self):\n            result=producer_replay()\n            self.assertEqual(result[\'polls\'],120);self.assertEqual(result[\'publications\'],30)\n            # The current producer may legitimately coalesce unchanged work;\n            # publication count and expiry are the contract, not an internal\n            # prepare-call implementation detail.\n            self.assertLessEqual(result[\'prepare_calls\'],30);self.assertEqual(result[\'expired\'],0)\n    class Sources(unittest.TestCase):\n        def test_host_actual_adaptive_reader_keeps_client_primary_and_server_assist(self):\n            r=flap_replay(True)\n            self.assertEqual(r[\'switches\'],0)\n            self.assertEqual(r[\'client_choices\'],120)\n            self.assertEqual(r[\'server_choices\'],0)\n            self.assertGreater(r[\'lane_work\'][\'client\'][\'configures\'],0)\n            # Host identity discovery remains available; CLIENT owns every full frame.\n            self.assertGreater(r[\'lane_work\'][\'server\'][\'configures\'],0)\n        def test_remote_actual_adaptive_reader_never_uses_resident_server(self):\n            r=flap_replay(False);self.assertEqual(r[\'switches\'],0);self.assertEqual(r[\'client_choices\'],120)\n            self.assertEqual(r[\'lane_work\'][\'server\'][\'configures\'],0)\n        def test_verified_loopback_pins_host_server(self):\n            route=DisplaySessionRoute();self.assertEqual(route.update((\'map\',),lambda:True,10.),\'server\')\n            self.assertEqual(route.role,\'local_host\')\n        def test_verified_remote_channel_pins_client(self):\n            route=DisplaySessionRoute();self.assertEqual(route.update((\'map\',),lambda:False,10.),\'client\')\n            self.assertEqual(route.role,\'remote_player\')\n        def test_transient_probe_error_does_not_demote_known_host(self):\n            route=DisplaySessionRoute();route.update((\'map\',),lambda:True,10.)\n            error=Mock(side_effect=OSError(\'read gap\'))\n            self.assertEqual(route.update((\'map\',),error,11.),\'server\');self.assertIn(\'read gap\',route.error)\n        def test_unknown_network_probe_does_not_disable_client_display(self):\n            route=DisplaySessionRoute();route.update((\'map\',),Mock(side_effect=OSError(\'probe\')),10.)\n            self.assertEqual(route.source,\'client\');self.assertFalse(route.verified)\n        def test_new_map_does_not_inherit_old_host_role_on_probe_error(self):\n            route=DisplaySessionRoute();route.update((\'old\',),lambda:True,10.)\n            route.update((\'new\',),Mock(side_effect=OSError(\'probe\')),10.01)\n            self.assertEqual(route.source,\'client\');self.assertFalse(route.verified)\n        def test_role_changes_rechecked_without_manual_restart(self):\n            route=DisplaySessionRoute();route.update((\'map\',),lambda:True,10.)\n            route.update((\'map\',),lambda:False,10.6)\n            self.assertEqual(route.source,\'client\');self.assertEqual(route.changes,1)\n        def test_role_probe_is_bounded_not_every_render_frame(self):\n            route=DisplaySessionRoute();probe=Mock(return_value=True)\n            for n in range(50):route.update((\'map\',),probe,10.+n*.008)\n            self.assertEqual(probe.call_count,1)\n        def test_null_channel_does_not_masquerade_as_remote(self):\n            from display_work_budget import probe_display_role\n            r=NS(engine=1,mem=NS(u32=lambda a:0))\n            route=DisplaySessionRoute();route.update((\'map\',),lambda:True,10.)\n            native=Mock(return_value=False)\n            self.assertEqual(route.update((\'map\',),lambda:probe_display_role(r,native),11.),\'server\')\n            self.assertIn(\'channel pending\',route.error)\n            native.assert_called_once_with(r)\n        def test_channel_changed_during_probe_keeps_previous_role(self):\n            from display_work_budget import probe_display_role\n            r=NS(engine=1,mem=NS(u32=Mock(side_effect=[100,200])))\n            route=DisplaySessionRoute();route.update((\'map\',),lambda:False,10.)\n            self.assertEqual(route.update((\'map\',),lambda:probe_display_role(r,lambda _:True),11.),\'client\')\n            self.assertIn(\'changed during probe\',route.error)\n        def test_stable_channel_retains_native_signature_validation(self):\n            from display_work_budget import probe_display_role\n            r=NS(engine=1,mem=NS(u32=lambda a:100))\n            for local in (True,False):\n                native=Mock(return_value=local)\n                self.assertIs(probe_display_role(r,native),local)\n                native.assert_called_once_with(r)\n            with self.assertRaisesRegex(RuntimeError,\'signature\'):\n                probe_display_role(r,Mock(side_effect=RuntimeError(\'signature mismatch\')))\n        def test_expired_client_is_not_replaced_with_full_server_frame(self):\n            from esp_shared import AdaptiveDisplayReader\n            from server_esp import DisplaySampleUnavailable\n            scope=(70007,6,\'maps/CS_ITALY.bsp\',2);s=StableDisplaySelector()\n            def p(source,stamp):\n                f=fixture();f.source=source;f.source_pid=70007;f.stamp=stamp;f.server_base=1\n                return f,{},scope\n            s.choose({\'client\':p(\'client\',10.)},scope,10.01);s.server_retry_at=100.\n            selected,_=s.choose({\'client\':p(\'client\',10.),\'server\':p(\'server\',10.12)},scope,10.13)\n            self.assertIsNone(selected)\n            # SERVER is not an alternative complete display frame.\n            self.assertIsNone(s.choose({\'server\':p(\'server\',10.)},scope,10.13)[0])\n        def test_only_active_role_counts_towards_sampler_wait_liveness(self):\n            from display_recovery import sampler_owns_wait\n            from esp_system_contract import source_wait_report\n            m=source_wait_report(10.);sources=m[\'sampling_health\'][\'phase\'][\'sources\']\n            sources[\'routing\']={\'source\':\'server\',\'role\':\'local_host\'}\n            sources[\'lanes\'][\'server\'][\'phase\']={\'stage\':\'idle\',\'stage_age_ms\':100000.}\n            self.assertTrue(sampler_owns_wait(m,10.))\n            sources[\'lanes\'][\'client\'][\'phase\'][\'stage_age_ms\']=2000.\n            self.assertFalse(sampler_owns_wait(m,10.))\n        def test_full_loop_rebind_failure_does_not_become_surface_fault(self):\n            import overlay_service\n            # The live error was a dereference before sampling, not a window\n            # failure. Check the actual serve source guard before that access.\n            import inspect\n            source=inspect.getsource(overlay_service.serve)\n            self.assertLess(source.index(\'if reader.mem is None:\'),source.index(\'view=win.viewport_state(reader.mem.pid)\'))\n            self.assertIn("raise NotReady(\'display reader rebind pending\')",source)\n    suite=unittest.TestSuite(unittest.defaultTestLoader.loadTestsFromTestCase(c) for c in (Work,Sources))\n    out=io.StringIO();result=unittest.TextTestRunner(stream=out,verbosity=2).run(suite)\n    if not result.wasSuccessful():raise AssertionError(out.getvalue())\n    return dict(passed=True,tests=result.testsRun,producer=producer_replay(),host=flap_replay(True),remote=flap_replay(False),\n                game_attached=False,game_input=False,live_flicker_verified=False)\n')
_EMBEDDED['exit_exposure'] = (1, '"""Map-independent exposed-exit hints; not a navmesh or fire permission.\n\nOnly already admitted, fresh, direct aim points receive a hint. Geometry runs\non a bounded latest-only background lane, never on the input/control thread.\n"""\nimport math\nimport threading\nimport time\n\nMAX_AGE = .25\nMAX_DISTANCE = 2048.\n\n\ndef point3(point):\n    return (isinstance(point,(tuple,list)) and len(point)==3\n        and all(isinstance(v,(int,float)) and not isinstance(v,bool)\n                and math.isfinite(v) and abs(v)<1e7 for v in point))\n\n\ndef identity(e):\n    return (e.index, e.address, e.serial, e.model)\n\n\ndef exposed(e):\n    path = getattr(e, \'penetration\', {}) or {}\n    age = getattr(e, \'wall_age_ms\', None)\n    return bool(e.enemy and e.health > 0 and not e.dormant and point3(e.head)\n        and point3(e.origin)\n        and e.visibility == \'visible\' and isinstance(path,dict) and path.get(\'kind\') == \'clear\'\n        and path.get(\'allowed\') is True and not path.get(\'guard_reason\')\n        and path.get(\'basis\') != \'raw_screen_candidate\'\n        and path.get(\'line_of_sight_verified\') is not False\n        and not getattr(e, \'aim_guard_reason\', \'\')\n        and isinstance(age, (int, float)) and not isinstance(age,bool) and 0 <= age <= 100.)\n\n\nclass BudgetExpired(Exception):\n    pass\n\n\nclass ProbeBudget:\n    def __init__(self, bsp, max_rays=64, max_ms=12.):\n        self.bsp = bsp\n        self.left = max_rays\n        self.rays = 0\n        self.deadline = time.perf_counter()+max_ms/1000.\n\n    def trace(self, start, end):\n        if self.left <= 0 or time.perf_counter() >= self.deadline:\n            raise BudgetExpired()\n        self.left -= 1\n        self.rays += 1\n        return self.bsp.trace(start, end)\n\n    def walk_clear(self, start, end):\n        if self.trace(start, end):\n            return False\n        # Read-only hull traversal; do not share/mutate the fire guard\'s cache.\n        guard = getattr(self.bsp, \'static_fire_guard\', None)\n        if guard is not None and getattr(guard, \'tree\', None) is not None:\n            delta = tuple(b-a for a,b in zip(start,end))\n            for proxy in guard.tree.candidates(start,delta):\n                if time.perf_counter() >= self.deadline:\n                    raise BudgetExpired()\n                if guard.intersects(proxy,start,delta):\n                    return False\n        return True\n\n\ndef hit_fraction(hit):\n    value=getattr(hit,\'enter\',None)\n    return value if (isinstance(value,(int,float)) and not isinstance(value,bool)\n                     and math.isfinite(value) and 0.<=value<=1.) else None\n\n\ndef geometry_hint(eye, local, origin, head, budget):\n    """Recognize a nearby exposure boundary and a short supported walk-out lane.\n\n    Static local geometry is evidence of an exit/corner, not proof of an entire\n    path to the player, dynamic-door state, or future enemy intent.\n    """\n    if not all(point3(p) for p in (eye,local,origin,head)):\n        return None\n    dx,dy = local[0]-origin[0],local[1]-origin[1]\n    distance = math.hypot(dx,dy)\n    if not 192. < distance <= MAX_DISTANCE or abs(local[2]-origin[2]) > 128.:\n        return None\n    if budget.trace(eye,head):\n        return None\n    forward = (dx/distance,dy/distance)\n    side = (-forward[1],forward[0])\n    boundary = []\n    for sign in (-1.,1.):\n        probe = (head[0]+side[0]*96.*sign,head[1]+side[1]*96.*sign,head[2])\n        hits = budget.trace(eye,probe)\n        if hits:\n            enter=hit_fraction(hits[0])\n            if enter is None:continue\n            hit = tuple(eye[i]+(probe[i]-eye[i])*enter for i in range(3))\n            if math.dist(hit,head) <= 192.:\n                boundary.append(sign)\n    if not boundary:\n        return None\n    walk = min(160.,distance*.5)\n    endpoint = (origin[0]+forward[0]*walk,origin[1]+forward[1]*walk,\n                origin[2]+(local[2]-origin[2])*walk/distance)\n    # A head seen through a window, over a wall, or from another floor is not\n    # a walk-out exit. Keep a body-width lane, not just the head ray.\n    for offset in (-18.,0.,18.):\n        start = (origin[0]+side[0]*offset,origin[1]+side[1]*offset,origin[2]+32.)\n        end = (endpoint[0]+side[0]*offset,endpoint[1]+side[1]*offset,endpoint[2]+32.)\n        if not budget.walk_clear(start,end):\n            return None\n    floor = budget.trace((endpoint[0],endpoint[1],endpoint[2]+40.),\n                         (endpoint[0],endpoint[1],endpoint[2]-64.))\n    if not floor or not point3(getattr(floor[0],\'normal\',None)) or floor[0].normal[2] < .65:\n        return None\n    enter=hit_fraction(floor[0])\n    if enter is None:return None\n    floor_z = endpoint[2]+40.-104.*enter\n    if not -40. <= floor_z-endpoint[2] <= 18.:\n        return None\n    return dict(kind=\'doorway\' if len(boundary)==2 else \'corner\',\n        boundary_sides=len(boundary),local_lane_units=round(walk,1),\n        navigation_proven=False,fire_permission=False)\n\n\nclass ExitExposure:\n    def __init__(self):\n        self.lock = threading.Lock()\n        self.thread = None\n        self.stop = None\n        self.wake = None\n        self.request = None\n        self.completed = None\n        self.scope = None\n        self.generation = 0\n        self.cache = {}\n        self.history = {}\n        self.next_submit = 0.\n        self.cursor = 0\n        self.metrics = dict(state=\'idle\',selection_only=True)\n\n    def close(self):\n        with self.lock:\n            thread,stop,wake = self.thread,self.stop,self.wake\n            self.thread = self.stop = self.wake = None\n            self.request = self.completed = None\n            self.scope = None\n            self.generation += 1\n            self.cache.clear();self.history.clear();self.next_submit=0.\n        if stop:stop.set()\n        if wake:wake.set()\n        if thread:thread.join(timeout=.1)\n\n    def invalidate(self):\n        # Increment even when the same BSP object becomes unavailable and then\n        # ready again. A late pre-gap result must never revive the old hint.\n        with self.lock:\n            self.generation += 1\n            self.request = self.completed = None\n        self.history.clear();self.cache.clear();self.next_submit=0.;self.cursor=0\n\n    def _ensure_worker(self):\n        if self.thread and self.thread.is_alive():return\n        self.stop=threading.Event();self.wake=threading.Event()\n        self.thread=threading.Thread(target=self._work,args=(self.stop,self.wake),\n                                     name=\'exit-exposure-geometry\',daemon=True)\n        self.thread.start()\n\n    def _work(self,stop,wake):\n        while not stop.is_set():\n            wake.wait(.5);wake.clear()\n            with self.lock:\n                if stop is not self.stop:return\n                job,self.request=self.request,None\n            if job is None:continue\n            rows={};budget=ProbeBudget(job[\'bsp\']);error=\'\'\n            try:\n                for key,origin,head in job[\'actors\']:\n                    if stop.is_set():return\n                    hint=geometry_hint(job[\'eye\'],job[\'local\'],origin,head,budget)\n                    rows[key]=dict(hint=hint,origin=origin,head=head,eye=job[\'eye\'],at=job[\'at\'])\n            except BudgetExpired:pass\n            except Exception as ex:error=type(ex).__name__+\': \'+str(ex)[:120]\n            with self.lock:\n                if stop is not self.stop:return\n                if job[\'generation\']==self.generation:\n                    self.completed=dict(scope=job[\'scope\'],generation=job[\'generation\'],\n                        rows=rows,rays=budget.rays,error=error)\n            stop.wait(.04)\n\n    def annotate(self,frame,ranked,observations,bsp,now):\n        # The mutable row dictionaries may be retained by another selection\n        # layer. Clear old annotations on every path, including missing data.\n        for row in ranked:\n            row[3].pop(\'exit_threat\',None)\n        # Missing geometry remains an optional ranking enhancement, not an\n        # aiming dependency. Screen-only visibility never claims exposure.\n        scope=(frame.map_name.lower(),frame.local.index,frame.local.address,frame.local.serial,\n            getattr(frame,\'source_epoch\',None),getattr(frame,\'server_base\',None),id(bsp))\n        if scope != self.scope:\n            self.scope=scope;self.invalidate()\n        if (bsp is None or not getattr(bsp,\'static_training\',False) or not 0<=now-frame.stamp<=.15\n                or not point3(frame.eye) or not point3(frame.local.origin)):\n            self.invalidate()\n            self.metrics=dict(state=\'base_selection\',selection_only=True,reason=\'no_fresh_map_geometry\')\n            return self.metrics\n        observed={}\n        for e in observations:\n            if not point3(e.origin):continue\n            key=identity(e);visible=exposed(e);old=self.history.get(key)\n            emerged_until=old.get(\'emerged_until\',0.) if old else 0.\n            if (old and visible and not old[\'exposed\'] and 0<=now-old[\'at\']<=.3\n                    and math.dist(e.origin,old[\'origin\'])>=6.\n                    and math.dist(frame.eye,old[\'eye\'])<=16.):\n                emerged_until=now+.65\n            observed[key]=dict(at=now,origin=tuple(e.origin),eye=tuple(frame.eye),exposed=visible,\n                               emerged_until=emerged_until)\n        self.history=observed  # No disappeared/slot-reused actor is retained.\n        with self.lock:\n            completed,self.completed=self.completed,None\n        error=\'\';rays=0\n        if completed and completed[\'scope\']==scope and completed.get(\'generation\')==self.generation:\n            self.cache.update(completed[\'rows\']);error=completed[\'error\'];rays=completed[\'rays\']\n        self.cache={k:v for k,v in self.cache.items() if k in observed and 0<=now-v[\'at\']<=MAX_AGE}\n        eligible=[row for row in ranked if exposed(row[1])]\n        hinted=0\n        for row in eligible:\n            e,info=row[1],row[3];key=identity(e);cached=self.cache.get(key)\n            if not cached or not cached[\'hint\']:continue\n            if (math.dist(e.origin,cached[\'origin\'])>24. or math.dist(e.head,cached[\'head\'])>24.\n                    or math.dist(frame.eye,cached[\'eye\'])>16.):continue\n            distance=math.hypot(e.origin[0]-frame.local.origin[0],e.origin[1]-frame.local.origin[1])\n            if not 192.<distance<=MAX_DISTANCE:continue\n            velocity=getattr(e,\'velocity\',None) or (0.,0.,0.)\n            if not point3(velocity):continue\n            toward=((frame.local.origin[0]-e.origin[0])*velocity[0]+\n                    (frame.local.origin[1]-e.origin[1])*velocity[1])/distance\n            if not math.isfinite(toward):continue\n            incoming=toward>=45.\n            emerging=observed.get(key,{}).get(\'emerged_until\',0.)>now\n            hint=cached[\'hint\']\n            if hint[\'kind\']==\'corner\' and not incoming and not emerging:continue\n            if toward < -45.:continue  # Retreating into cover is not an exit rush.\n            info[\'exit_threat\']=dict(hint,eligible=True,exposed=True,age_ms=round((now-cached[\'at\'])*1000,1),\n                incoming=incoming,emerging=emerging,score=20+8*(hint[\'kind\']==\'doorway\')+12*incoming+15*emerging,\n                eta=round(distance/max(160.,min(320.,toward)),3),source=\'local_static_exit_hint\')\n            hinted+=1\n        if eligible and now>=self.next_submit:\n            actors=sorted(eligible,key=lambda row:row[1].index)\n            i=self.cursor%len(actors);ordered=(actors[i:]+actors[:i])[:8];self.cursor=(i+len(ordered))%len(actors)\n            job=dict(scope=scope,generation=self.generation,bsp=bsp,eye=tuple(frame.eye),local=tuple(frame.local.origin),at=now,\n                actors=[(identity(row[1]),tuple(row[1].origin),tuple(row[1].head)) for row in ordered])\n            self._ensure_worker()\n            with self.lock:self.request=job\n            self.wake.set();self.next_submit=now+.08\n        self.metrics=dict(state=\'ready\' if hinted else \'sampling\' if eligible else \'no_exposed_target\',\n            candidates=len(eligible),prioritized=hinted,background_rays=rays,error=error,\n            selection_only=True,navigation_proven=False)\n        return self.metrics\n\n\ndef choose_exit(ranked,previous):\n    from target_priority import survival_rank\n    if not ranked or any(survival_rank(row[3],retain=row[1].index==previous)<2 for row in ranked):return None\n    nearest=min(row[3].get(\'distance\',math.inf) for row in ranked)\n    candidates=[]\n    for row in ranked:\n        hint=(row[3] or {}).get(\'exit_threat\') or {}\n        if (hint.get(\'eligible\') and hint.get(\'exposed\') and exposed(row[1])\n                and 0<=hint.get(\'age_ms\',math.inf)<=MAX_AGE*1000\n                and row[3].get(\'distance\',math.inf)<=min(MAX_DISTANCE,nearest*1.5+192.)):\n            candidates.append(row)\n    if not candidates:return None\n    def key(row):\n        hint=row[3][\'exit_threat\']\n        return (-hint[\'score\'],hint[\'eta\'],row[2][2],row[1].index)\n    best=min(candidates,key=key)\n    current=next((row for row in candidates if row[1].index==previous),None)\n    if current:\n        a,b=best[3][\'exit_threat\'],current[3][\'exit_threat\']\n        if a[\'score\']<=b[\'score\']+10 and a[\'eta\']+.7>=b[\'eta\']:return current\n    return best\n\n\ndef preempts(selected,incumbent):\n    return bool(selected and incumbent and selected[1].index!=incumbent[1].index\n        and choose_exit([selected,incumbent],incumbent[1].index) is selected)\n')
_EMBEDDED['exit_exposure_contract'] = (1, '"""Deterministic exit/corner ranking contracts; no game, input or package assets."""\nimport copy\nimport io\nimport math\nimport threading\nimport unittest\nfrom types import SimpleNamespace as NS\nfrom unittest.mock import patch\n\nfrom exit_exposure import (ExitExposure, ProbeBudget, BudgetExpired, exposed,\n                           geometry_hint, identity, choose_exit, preempts)\nfrom target_priority import choose_visible, NEAR_FIRST, COMPREHENSIVE\n\n\nclass GeometryFixture:\n    """Small analytical boxes and one floor, rather than recorded answer rays."""\n    static_training = True\n\n    def __init__(self, sides=2, floor=0., extra=()):\n        self.floor = floor\n        self.floor_normal = (0.,0.,1.)\n        self.boxes = list(extra)\n        self.calls = []\n        for sign in (-1,1)[:sides]:\n            lo,hi = (-180.,-48.) if sign<0 else (48.,180.)\n            self.boxes.append(((440.,lo,0.),(540.,hi,100.)))\n        self.static_fire_guard = None\n\n    def trace(self, start, end):\n        self.calls.append((start,end))\n        delta = tuple(b-a for a,b in zip(start,end))\n        hits = []\n        for low,high in self.boxes:\n            enter,leave = 0.,1.\n            for i in range(3):\n                if delta[i] == 0.:\n                    if not low[i]<=start[i]<=high[i]:break\n                else:\n                    a,b = sorted(((low[i]-start[i])/delta[i],(high[i]-start[i])/delta[i]))\n                    enter,leave = max(enter,a),min(leave,b)\n                    if enter>leave:break\n            else:\n                if 0.<=enter<=leave<=1.:hits.append(NS(enter=enter,normal=(1.,0.,0.)))\n        if self.floor is not None and delta[2]<0. and end[2]<=self.floor<=start[2]:\n            hits.append(NS(enter=(self.floor-start[2])/delta[2],normal=self.floor_normal))\n        return sorted(hits,key=lambda hit:hit.enter)\n\n\ndef actor(index=2, x=500., **kwargs):\n    data=dict(index=index,address=0x1000*index,serial=index,model=\'models/player/ct.mdl\',\n        enemy=True,health=100,dormant=False,origin=(x,0.,0.),head=(x,0.,64.),\n        velocity=(-100.,0.,0.),visibility=\'visible\',wall_age_ms=0.,aim_guard_reason=\'\',\n        penetration=dict(kind=\'clear\',allowed=True,line_of_sight_verified=True))\n    data.update(kwargs)\n    return NS(**data)\n\n\ndef frame(now=10.):\n    return NS(map_name=\'cs_fixture\',source_epoch=1,server_base=0x100000,stamp=now,\n        eye=(0.,0.,64.),local=NS(index=1,address=0x1000,serial=1,origin=(0.,0.,0.)))\n\n\ndef row(entity=None, error=4.):\n    e=entity or actor();distance=math.hypot(e.origin[0],e.origin[1])\n    info=dict(distance=distance,rushing=False,tier=0 if distance<=192. else 1 if distance<=512. else 2,\n        throwable_rank=2,error=error)\n    return (error,e,(0.,(0.,0.,0.),error),info)\n\n\ndef hint(kind=\'doorway\'):\n    return dict(kind=kind,boundary_sides=2 if kind==\'doorway\' else 1,local_lane_units=160.,\n                navigation_proven=False,fire_permission=False)\n\n\ndef prime(e=None, kind=\'doorway\'):\n    e=e or actor();f=frame();bsp=GeometryFixture();lane=ExitExposure();r=row(e)\n    lane.annotate(f,[],[e],bsp,10.)\n    lane.next_submit=math.inf  # Cache tests never spawn a background thread.\n    lane.cache[identity(e)]=dict(hint=hint(kind),origin=e.origin,head=e.head,eye=f.eye,at=10.)\n    return lane,f,bsp,r\n\n\ndef ranked_hint(r, score=40., eta=3., age_ms=0.):\n    r[3][\'exit_threat\']=dict(hint(),eligible=True,exposed=True,age_ms=age_ms,score=score,eta=eta)\n    return r\n\n\nclass OneJobStop:\n    """Execute exactly one synchronous worker job; no polling or sleep tests."""\n    def __init__(self):self.stopped=False\n    def is_set(self):return self.stopped\n    def wait(self,timeout):self.stopped=True;return True\n    def set(self):self.stopped=True\n\n\ndef run():\n    class Tests(unittest.TestCase):\n        def probe(self,bsp=None,**changes):\n            data=dict(eye=(0.,0.,64.),local=(0.,0.,0.),origin=(500.,0.,0.),head=(500.,0.,64.))\n            data.update(changes);bsp=bsp or GeometryFixture()\n            with patch(\'exit_exposure.time.perf_counter\',return_value=0.):\n                budget=ProbeBudget(bsp);out=geometry_hint(**data,budget=budget)\n            self.assertLessEqual(budget.rays,7)\n            return out\n\n        def annotate(self,lane,f,bsp,r,now=10.05,observations=None):\n            f.stamp=now\n            return lane.annotate(f,[r],[r[1]] if observations is None else observations,bsp,now)\n\n        def test_doorway_geometry_is_selection_only(self):\n            out=self.probe();self.assertEqual(out[\'kind\'],\'doorway\')\n            self.assertFalse(out[\'fire_permission\']);self.assertFalse(out[\'navigation_proven\'])\n        def test_single_boundary_is_corner(self):\n            self.assertEqual(self.probe(GeometryFixture(sides=1))[\'kind\'],\'corner\')\n        def test_open_area_has_no_exit_hint(self):\n            self.assertIsNone(self.probe(GeometryFixture(sides=0)))\n        def test_closed_door_has_no_exit_hint(self):\n            self.assertIsNone(self.probe(GeometryFixture(extra=[((400.,-40.,0.),(410.,40.,100.))])))\n        def test_window_head_visible_but_body_lane_blocked(self):\n            self.assertIsNone(self.probe(GeometryFixture(extra=[((400.,-40.,0.),(410.,40.,50.))])))\n        def test_body_width_not_single_center_ray(self):\n            self.assertIsNone(self.probe(GeometryFixture(extra=[((400.,16.,0.),(410.,25.,50.))])))\n        def test_static_prop_lane_blocked(self):\n            bsp=GeometryFixture();seen=[]\n            bsp.static_fire_guard=NS(tree=NS(candidates=lambda *a:(1,)),\n                intersects=lambda *a:seen.append(a) or True)\n            self.assertIsNone(self.probe(bsp));self.assertTrue(seen)\n        def test_unsupported_drop_has_no_hint(self):\n            for floor in (None,-50.,30.):\n                with self.subTest(floor=floor):self.assertIsNone(self.probe(GeometryFixture(floor=floor)))\n        def test_steep_or_invalid_floor_normal_has_no_hint(self):\n            for normal in ((0.,0.,.5),(0.,0.,math.nan),(0.,0.,math.inf),None):\n                bsp=GeometryFixture();bsp.floor_normal=normal\n                with self.subTest(normal=normal):self.assertIsNone(self.probe(bsp))\n        def test_geometry_near_far_and_other_floor_ignored(self):\n            for origin in ((128.,0.,0.),(2049.,0.,0.),(500.,0.,129.)):\n                self.assertIsNone(self.probe(origin=origin))\n        def test_geometry_malformed_points_are_rejected_without_tracing(self):\n            for invalid in ((1.,2.),(math.nan,0.,0.),(math.inf,0.,0.),(\'x\',0.,0.),None,(True,0.,0.)):\n                bsp=GeometryFixture();self.assertIsNone(self.probe(bsp,head=invalid));self.assertFalse(bsp.calls)\n        def test_malformed_hit_fraction_rejected(self):\n            for invalid in (math.nan,math.inf,-1.,2.,None,\'x\'):\n                bsp=GeometryFixture();trace=bsp.trace\n                def broken(a,b):\n                    out=trace(a,b)\n                    for hit in out:hit.enter=invalid\n                    return out\n                bsp.trace=broken\n                self.assertIsNone(self.probe(bsp))\n        def test_ray_budget_hard_cap(self):\n            with patch(\'exit_exposure.time.perf_counter\',return_value=0.):\n                budget=ProbeBudget(GeometryFixture(),max_rays=2)\n                with self.assertRaises(BudgetExpired):\n                    for _ in range(3):budget.trace((0.,0.,0.),(1.,0.,0.))\n            self.assertEqual(budget.rays,2);self.assertEqual(len(budget.bsp.calls),2)\n        def test_deadline_prevents_first_ray(self):\n            with patch(\'exit_exposure.time.perf_counter\',side_effect=(0.,1.)):\n                budget=ProbeBudget(GeometryFixture())\n                with self.assertRaises(BudgetExpired):budget.trace((0.,0.,0.),(1.,0.,0.))\n            self.assertEqual(budget.rays,0)\n        def test_static_prop_candidate_iteration_has_deadline(self):\n            def forever():\n                while True:yield 1\n            bsp=GeometryFixture();bsp.static_fire_guard=NS(tree=NS(candidates=lambda *a:forever()),intersects=lambda *a:False)\n            clock=iter(i/1000 for i in range(100))\n            with patch(\'exit_exposure.time.perf_counter\',side_effect=lambda:next(clock)):\n                budget=ProbeBudget(bsp)\n                with self.assertRaises(BudgetExpired):budget.walk_clear((0.,0.,64.),(50.,0.,64.))\n        def test_exposed_requires_current_direct_admission(self):\n            bads=[dict(enemy=False),dict(health=0),dict(dormant=True),dict(head=None),\n                dict(origin=(math.nan,0.,0.)),dict(visibility=\'blocked\'),dict(wall_age_ms=101.),\n                dict(wall_age_ms=-1.),dict(wall_age_ms=True),dict(aim_guard_reason=\'protected\'),\n                dict(penetration=dict(kind=\'penetration\',allowed=True)),\n                dict(penetration=dict(kind=\'clear\',allowed=False)),\n                dict(penetration=dict(kind=\'clear\',allowed=True,guard_reason=\'blocked\')),\n                dict(penetration=dict(kind=\'clear\',allowed=True,basis=\'raw_screen_candidate\')),\n                dict(penetration=dict(kind=\'clear\',allowed=True,line_of_sight_verified=False)),\n                dict(penetration=\'invalid\')]\n            self.assertTrue(exposed(actor()))\n            for kw in bads:\n                with self.subTest(kw=kw):self.assertFalse(exposed(actor(**kw)))\n        def test_fresh_cached_doorway_prioritized(self):\n            lane,f,bsp,r=prime();out=self.annotate(lane,f,bsp,r)\n            self.assertEqual(out[\'prioritized\'],1);h=r[3][\'exit_threat\']\n            self.assertTrue(h[\'incoming\']);self.assertAlmostEqual(h[\'age_ms\'],50.)\n            self.assertFalse(h[\'fire_permission\']);self.assertFalse(h[\'navigation_proven\'])\n        def test_cached_target_blocked_no_hint(self):\n            lane,f,bsp,r=prime();ranked_hint(r);r[1].visibility=\'blocked\'\n            self.annotate(lane,f,bsp,r);self.assertNotIn(\'exit_threat\',r[3])\n        def test_expired_or_future_cache_removed(self):\n            for stamp in (9.,11.):\n                lane,f,bsp,r=prime();ranked_hint(r);lane.cache[identity(r[1])][\'at\']=stamp\n                self.annotate(lane,f,bsp,r);self.assertNotIn(\'exit_threat\',r[3]);self.assertFalse(lane.cache)\n        def test_missing_geometry_clears_row_cache_history_and_pending(self):\n            for missing in (None,NS(static_training=False)):\n                lane,f,bsp,r=prime();ranked_hint(r);lane.request={\'old\':True};lane.completed={\'old\':True}\n                out=self.annotate(lane,f,missing,r)\n                self.assertEqual(out[\'state\'],\'base_selection\');self.assertNotIn(\'exit_threat\',r[3])\n                self.assertFalse(lane.cache);self.assertFalse(lane.history)\n                self.assertIsNone(lane.request);self.assertIsNone(lane.completed)\n        def test_stale_frame_clears_row_and_pending(self):\n            lane,f,bsp,r=prime();ranked_hint(r)\n            lane.annotate(f,[r],[r[1]],bsp,10.2)\n            self.assertNotIn(\'exit_threat\',r[3]);self.assertFalse(lane.cache)\n        def test_nonfinite_frame_clears_old_hint(self):\n            lane,f,bsp,r=prime();ranked_hint(r);f.eye=(math.nan,0.,64.)\n            self.annotate(lane,f,bsp,r);self.assertNotIn(\'exit_threat\',r[3]);self.assertFalse(lane.cache)\n        def test_map_local_source_and_bsp_changes_invalidate(self):\n            for change in (\'map\',\'address\',\'serial\',\'source\',\'server\',\'bsp\'):\n                lane,f,bsp,r=prime();ranked_hint(r)\n                if change==\'map\':f.map_name=\'de_another\'\n                elif change==\'address\':f.local.address+=4\n                elif change==\'serial\':f.local.serial+=1\n                elif change==\'source\':f.source_epoch+=1\n                elif change==\'server\':f.server_base+=1\n