_EMBEDDED['local_controls'] = (1, '"""Camera shortcut only. Jump input belongs exclusively to bhop_service."""\nimport time\nfrom camera_commands import CameraCommands\n\n\nclass LocalControls:\n    def __init__(self, windows, clock=time.monotonic, camera=None):\n        self.win=windows; self.clock=clock; self.reader=None\n        self.h_down=False; self.focused=False\n        self.camera=camera or CameraCommands(windows,clock); self.thirdperson=False\n        self.status=\'H 视角：等待游戏前台\'\n\n    def toggle_camera(self, distance):\n        self.reader.require_feature(\'thirdperson_key\')\n        self.camera.bind(self.reader)\n        self.thirdperson=self.camera.toggle(distance)\n        self.status=\'已提交游戏原生第三人称命令\' if self.thirdperson else \'已提交游戏原生第一人称命令\'\n\n    def step_camera(self, reader, frame, cfg):\n        self.reader=reader\n        if not cfg.thirdperson_key:return\n        foreground=bool(self.win.foreground(reader.mem.pid)); h=self.win.down(0x48)\n        try:menu=reader.game_ui_visible() if foreground else True\n        except Exception:menu=True\n        if not foreground or menu:\n            if menu and foreground:self.status=\'游戏菜单中：视角快捷键暂停\'\n            self.h_down=h; self.focused=False; return\n        if self.clock()-frame.stamp>.15:\n            self.h_down=h; return\n        if not self.focused:\n            self.h_down=h; self.focused=True; self.status=\'H 原生视角：游戏前台\'\n        if h and not self.h_down:\n            try:self.toggle_camera(cfg.thirdperson_distance)\n            except Exception as ex:self.status=\'原生视角：\'+str(ex)\n        self.h_down=h\n        if self.camera.reader:\n            try:\n                error=self.camera.update(cfg.thirdperson_distance)\n                if error:self.status=error\n            except Exception as ex:self.status=\'原生视角：\'+str(ex)\n\n    def close(self):\n        try:self.camera.close()\n        finally:self.reader=None; self.focused=False\n')





