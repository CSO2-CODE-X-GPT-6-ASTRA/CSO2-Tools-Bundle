th is not None and health>0))\n            data[\'direct_head_classification\']=dict(direct=direct,first_request=first_request,\n                outcome=\'first_request_head_kill\' if first_request and group==\'head\' and health==0 else\n                        \'first_request_head_survived\' if first_request and group==\'head\' and health is not None and health>0 else\n                        \'direct_head_hit\' if direct and group==\'head\' else\n                        \'body_hit\' if group not in (\'head\',\'generic\',\'unknown\') else \'other\',\n                basis=\'unique_prior_ammo_context; first_request is engagement-level, not engine bullet id\')\n        self.db.execute(\'INSERT INTO events VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)\',\n            (key,match,kind,weapon,mono,row.get(\'time\'),target,model,distance,rounds,group,amount,\n             health,armor,shot_id,association,encoded(data)))\n        self._add(weapon,build,counts)\n        if model:self._add(weapon,build,counts,model,distance)\n\n    def quality(self,match,summary):\n        with self.db:\n            self.db.execute(\'UPDATE sessions SET dropped=?,sink_dropped=?,finished=? WHERE id=?\',\n                (positive(summary.get(\'dropped_log_records\')),positive(summary.get(\'damage_log_dropped_records\')),\n                 int(bool(summary.get(\'finished\'))),match))\n            scope=summary.get(\'logger_id\') or match\n            archive=summary.get(\'weapon_accuracy_archive\') or {}\n            self.db.execute(\'\'\'INSERT INTO quality VALUES(?,?,?,?,?,?,?) ON CONFLICT(scope) DO UPDATE SET\n                dropped=MAX(dropped,excluded.dropped),sink_dropped=MAX(sink_dropped,excluded.sink_dropped),\n                archive_failures=MAX(archive_failures,excluded.archive_failures),\n                last_error=CASE WHEN excluded.last_error!=\'\' THEN excluded.last_error ELSE last_error END\'\'\',\n                (scope,positive(summary.get(\'dropped_log_records\')),positive(summary.get(\'damage_log_dropped_records\')),\n                 positive(archive.get(\'failed_operations\')),0,0,archive.get(\'last_error\',\'\')))\n            transport=summary.get(\'log_process\') or {}\n            if transport:\n                self.db.execute(\'\'\'INSERT INTO quality VALUES(?,?,?,?,?,?,?) ON CONFLICT(scope) DO UPDATE SET\n                    transport_dropped=MAX(transport_dropped,excluded.transport_dropped),\n                    transport_lost=MAX(transport_lost,excluded.transport_lost)\'\'\',\n                    (\'transport:\' + str(transport.get(\'transport_id\') or scope),0,0,0,\n                     positive(transport.get(\'dropped_messages\')),positive(transport.get(\'unacknowledged_on_exit\')),\'\'))\n        self.changed=True;self.export(force=bool(summary.get(\'finished\')))\n\n    @staticmethod\n    def metrics(counts):\n        out=dict(counts);known=counts.get(\'head_events\',0)+counts.get(\'body_events\',0)\n        out[\'head_percent_of_known_damage\']=round(100*counts.get(\'head_events\',0)/known,4) if known else None\n        total=counts.get(\'damage_events\',0)\n        out[\'head_percent_of_all_damage\']=round(100*counts.get(\'head_events\',0)/total,4) if total else None\n        attempts=counts.get(\'direct_head_first_request_attempts\',0)\n        kills=counts.get(\'direct_head_first_request_kills\',0)\n        # The former quotient discarded all unassociated rounds from its\n        # denominator. Keep it only as a explicitly conditional damage share.\n        out[\'first_request_head_zero_health_share_of_linked_damage\']=round(100*kills/attempts,4) if attempts else None\n        out[\'direct_head_first_request_kill_rate\']=None\n        out[\'direct_head_first_request_kill_rate_basis\']=\'unverified_engine_bullet_id; conditional_damage_share_is_not_first_shot_success\'\n        observed=counts.get(\'precision_first_observations_v2\',0)\n        linked=counts.get(\'precision_first_linked_v2\',0)\n        out[\'precision_first_unknown_observations_v2\']=max(0,observed-linked)\n        out[\'precision_first_context_head_zero_health_percent_v2\']=(\n            round(100*counts.get(\'precision_first_head_zero_health_v2\',0)/observed,4) if observed else None)\n        out[\'precision_first_context_basis_v2\']=\'all_v2_first_request_round_observations; unique_temporal_context_not_verified_bullet_link; unlinked_outcomes_unknown\'\n        def evidence_counts(prefix,subtract_first=False):\n            fields=(\'observations\',\'linked\',\'head_hits\',\'body_hits\',\'head_zero_health\',\'head_survived\')\n            row={name:counts.get(prefix+name+\'_v2\',0) for name in fields}\n            if subtract_first:\n                row={name:max(0,value-counts.get(\'precision_first_\'+name+\'_v2\',0)) for name,value in row.items()}\n            row[\'unknown\']=max(0,row[\'observations\']-row[\'linked\'])\n            return row\n        out[\'precision_first_evidence_v2\']=evidence_counts(\'precision_first_\')\n        out[\'precision_followup_evidence_v2\']=evidence_counts(\'precision_\',True)\n        out[\'bullet_hit_rate\']=None\n        return out\n\n    def snapshot(self):\n        weapons={};versions=[]\n        for weapon,build,raw in self.db.execute(\'SELECT weapon,build,counters FROM totals ORDER BY weapon,build\'):\n            counts=json.loads(raw);total=weapons.setdefault(weapon,{k:0 for k in COUNTERS})\n            for k,v in counts.items():total[k]=total.get(k,0)+v\n            versions.append(dict(weapon=weapon,build=build,**self.metrics(counts)))\n        models=[dict(weapon=w,build=b,sampled_model=m,distance_band=band,**self.metrics(json.loads(c)))\n                for w,b,m,band,c in self.db.execute(\'SELECT * FROM model_totals ORDER BY weapon,model,band\')]\n        matches=self.db.execute(\'SELECT COUNT(*) FROM sessions\').fetchone()[0]\n        gaps=self.db.execute(\'\'\'SELECT COALESCE(SUM(dropped),0),COALESCE(SUM(sink_dropped),0),\n            COALESCE(SUM(archive_failures),0),COALESCE(SUM(transport_dropped),0),COALESCE(SUM(transport_lost),0) FROM quality\'\'\').fetchone()\n        return dict(schema=2,updated=time.strftime(\'%Y-%m-%d %H:%M:%S\'),goal_head_percent=99.9,\n            rate_basis=\'head_share_of_confirmed_known_hitgroup_damage_not_per_bullet_probability\',\n            direct_head_kill_metric=\'首发直视头部且该次确认伤害将目标生命归零；身体命中、穿透、爆头未死分开统计\',\n            observed_rounds_basis=\'ammo_decrements_including_manual_or_unattributed_rounds\',\n            missing_feedback_policy=\'unknown_not_proven_miss\',model_basis=\'sampled_aim_target_temporal_association\',\n            weapons={k:self.metrics(v) for k,v in weapons.items()},by_build=versions,by_model_distance=models,\n            source_quality=dict(matches=matches,diagnostic_queue_dropped=gaps[0],damage_sink_dropped=gaps[1],\n                archive_failed_operations=gaps[2],transport_dropped_messages=gaps[3],transport_unacknowledged=gaps[4],\n                sink_drop_basis=\'sum_of_logger_maxima_lower_bound_if_sink_recreated\',\n                errors=[r[0] for r in self.db.execute("SELECT last_error FROM quality WHERE last_error!=\'\'")]),\n            archive_bytes=sum(p.stat().st_size for p in self.root.glob(\'weapon_accuracy.sqlite3*\') if p.is_file()),\n            live_bullet_link_verified=False,goal_verified=False)\n\n    def export(self,force=False):\n        if not self.changed or (not force and self.clock()-self.last_export<10):return\n        raw=json.dumps(self.snapshot(),ensure_ascii=False,indent=2).encode(\'utf8\')\n        temp=self.root/(\'summary.json.\'+str(os.getpid())+\'.\'+str(id(self))+\'.tmp\')\n        temp.write_bytes(raw);os.replace(temp,self.root/\'summary.json\')\n        self.last_export=self.clock();self.changed=False\n    def close(self):\n        if self.closed:return\n        try:self.export(force=True);self.db.execute(\'PRAGMA wal_checkpoint(TRUNCATE)\')\n        finally:self.db.close();self.closed=True\n')
