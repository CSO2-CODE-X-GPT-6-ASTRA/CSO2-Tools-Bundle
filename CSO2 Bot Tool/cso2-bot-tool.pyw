anged\'\n                    else \'rmb_reservation_pending\')\n        else:return True\n        self.fire_guard=dict(allowed=False,reason=reason)\n        return False\n\n    def set_guarded(self, before_write):return self.set(True,before_write)\n\n    def set(self, down, before_write=None):\n        with self._lock:\n            r=self.reader\n            if not r or not r.mem:return False\n            if not r.mem.alive():self.active=False;return not down\n            if not down:return self._release()\n            r.require_feature(\'fire\')\n            if not self._input_ready() or not self.verify_fire_weapon() or not self.verify_hostage_sight():\n                if self.active:self._release()\n                return False\n            if before_write is not None:\n                if not before_write() or not self.verify_fire_weapon():return False\n                final_check=getattr(before_write,\'after_weapon_check\',None)\n                if callable(final_check) and not final_check():return False\n            # Recheck binding/RMB after aim and weapon reads, at the input edge.\n            if not self._input_ready() or not self.verify_hostage_sight():return False\n            r.mem.allow_write()\n            input_check=getattr(before_write,\'before_input_check\',None)\n            if callable(input_check) and not input_check():\n                self.fire_guard=dict(allowed=False,reason=\'force_fire_cancelled\')\n                return False\n            r.mem.write(self.primary,struct.pack(\'<I\',3))\n            self.active=True;return True\n\n    def maintain(self):\n        with self._lock:\n            if not self.active:return False\n            if not self.reader or not self.reader.mem:return False\n            if not self._input_ready() or not self.verify_fire_weapon() or not self.verify_hostage_sight():\n                self._release();return False\n            return True\n\n    def secondary(self, suppress):\n        with self._lock:\n            b=self.aim_binding;r=self.reader\n            if not suppress:self.secondary_owned=False;return\n            if not r or not r.mem or not b.modified or not b.check_reserved(r):return\n            if not r.mem.alive() or not self.win.foreground(r.mem.pid):return\n            if r.mem.u32(self.secondary_address)&3:\n                r.mem.allow_write();r.mem.write(self.secondary_address,struct.pack(\'<I\',4))\n            self.secondary_owned=True\n\n    def state(self):\n        with self._lock:\n            return self.reader.mem.u32(self.primary) if self.reader and self.reader.mem else None\n\n    def diagnostics(self):\n        with self._lock:\n            intervals=sorted(self._intervals.copy())\n            metrics=dict(self.monitor_metrics)\n            if intervals:\n                metrics.update(interval_p50_ms=intervals[len(intervals)//2],\n                               interval_p95_ms=intervals[min(len(intervals)-1,int(len(intervals)*.95))],\n                               interval_p99_ms=intervals[min(len(intervals)-1,int(len(intervals)*.99))])\n            return dict(native_mouse2=self.aim_binding.snapshot(),weapon_monitor=metrics,\n                        hostage_fire_guard=dict(self.hostage_guard),\n                        active_weapon=self.weapon_snapshot(),primary_owned=self.active)\n\n    def close(self):\n        self.stop_monitor()\n        with self._lock:\n            if self.active and not self._release():raise RuntimeError(\'开火释放未确认\')\n            if self.aim_binding.close() is False:\n                raise RuntimeError(\'原生右键绑定恢复等待中：\'+self.aim_binding.status)\n            self.reader=None;self.active=False;self.verified=False;self.secondary_owned=False\n            self.expected_weapon=None;self._weapon=None;self._sample_identity=None;self._weapon_reader=None\n            self._hostage_frame=None;self._hostage_weapon={};self.hostage_guard={}\n')
_EMBEDDED['aim_fire_commit'] = ('2026.10.07-aim-private-reader-evidence', '"""Commit the selected current sample with native input and view readback."""\nimport math\nimport struct\nfrom geometry import finite, aim_angles, angle_error, view_direction, add, sub, length, wrap\nfrom aim_tracking_private import aim_tolerance\nfrom aim_decision import state,MAX_TARGET_AGE\nfrom aim_geometry import hostage_ray_status,hostage_is_nearby,protect_hostages\nfrom dataclasses import replace\n\n\ndef same_native_sight(first, second):\n    try:\n        return finite(tuple(first)+tuple(second)) and struct.pack(\'<3f\', *first) == struct.pack(\'<3f\', *second)\n    except (TypeError, ValueError, OverflowError, struct.error):\n        return False\n\n\ndef read_sight(reader, frame, scale):\n    view = reader.mem.vec(reader.global_addr(\'view_angles\'))\n    punch = reader.mem.vec(frame.local.address+0xfd8)\n    if not finite(tuple(view)+tuple(punch)):\n        return None\n    return view, punch, (view[0]+punch[0]*2*scale, wrap(view[1]+punch[1]*2*scale), 0.)\n\n\ndef center_current_punch(control,reader,frame,target,scale,sampled,stage):\n    """One bounded recoil update; never chase another view writer or loop."""\n    d=control.diagnostic\n    if frame.control_provenance.get(\'owner\')!=\'aim_process\':return sampled\n    view,punch,sight=sampled;goal=aim_angles(frame.eye,target.head)\n    error=angle_error(sight,goal)\n    written=d.get(\'commit_written_angles\',d.get(\'written_angles\'))\n    if (written is None or not .005<error<=1.\n            or angle_error(view,written)>.01):return sampled\n    if not control.input_ready(reader) or not control.identity_current(reader,frame,target):return None\n    began=control.clock()\n    corrected=(max(-89.,min(89.,goal[0]-punch[0]*2*scale)),\n               wrap(goal[1]-punch[1]*2*scale),0.)\n    reader.set_angles(corrected)\n    d[\'commit_written_angles\']=corrected\n    result=read_sight(reader,frame,scale)\n    row=dict(stage=stage,before_error_deg=error,angles=corrected,\n        after_error_deg=angle_error(result[2],goal) if result else None,\n        elapsed_ms=max(0.,control.clock()-began)*1000,attempts=1,\n        basis=\'fresh_punch_same_selected_point\')\n    d.setdefault(\'recoil_recentering\',[]).append(row)\n    motion=d.get(\'motion_compensation\')\n    if isinstance(motion,dict):motion.setdefault(\'recoil_recentering\',[]).append(row)\n    return result\n\n\ndef hostage_status_for_sight(frame,sight,weapon,now):\n    if not protect_hostages(frame.mode):return \'\',0,[]\n    protected=[h for h in frame.protected if hostage_is_nearby(frame.eye,h)]\n    endpoint=add(frame.eye,view_direction(sight))\n    intersections=[]\n    reason=hostage_ray_status(replace(frame,protected=protected),endpoint,weapon,\n        now=now,diagnostic=intersections)\n    return reason,len(protected),intersections\n\n\ndef check_hostage_sight(control, frame, sight, weapon, stage):\n    """Check the read-back firing direction, including held automatic fire.\n\n    Uses this acquisition\'s local geometry only: no RPC or bone scan at the\n    input boundary. Keep the user\'s 15 m scope and test full weapon range.\n    """\n    began=control.clock()\n    reason,count,intersections=hostage_status_for_sight(frame,sight,weapon,control.clock())\n    info=dict(stage=stage,allowed=not bool(reason),reason=reason,checked=count,\n        radius_m=15.,eye=tuple(frame.eye),sight=tuple(sight),intersections=intersections,\n        elapsed_ms=max(0.,control.clock()-began)*1000)\n    d=control.diagnostic\n    d.setdefault(\'hostage_fire_checks\',[]).append(info)\n    d[\'hostage_fire_guard\']=info\n    if reason:\n        control.reason=reason\n        d.update(fire_allowed=False,stop_reason=reason)\n    return not reason\n\n\ndef confirm(control, reader, frame, target, cfg, weapon, wall_service, scale, path):\n    began = control.clock()\n    d = control.diagnostic\n    independent=frame.control_provenance.get(\'owner\')==\'aim_process\'\n    refresh= d.get(\'pose_refresh\') or {}\n    refresh_status=refresh.get(\'status\')\n    info = dict(allowed=False, status=\'checking\', basis=\'independent_current_point\' if independent else \'esp_published_point\',\n                corrected=False, pose_reused=bool(refresh.get(\'pose_reused\',True)),\n                pose_refresh_ms=refresh.get(\'total_ms\'), pose_shift_units=refresh.get(\'pose_shift_units\'),\n                pose_wait_ms=0.)\n    d[\'fire_commit\'] = info\n\n    def stop(reason):\n        info.update(status=reason, elapsed_ms=max(0., control.clock()-began)*1000)\n        d.update(fire_allowed=False, stop_reason=reason)\n        control.reason = reason\n        return False\n\n    if not control.input_ready(reader) or not control.identity_current(reader, frame, target):\n        return stop(\'input_or_identity_changed\')\n    if independent:\n        if refresh_status!=\'refreshed\' or refresh.get(\'pose_stamp\')!=target.pose_sample_stamp:\n            return stop(\'independent_pose_refresh_missing\')\n    if state(target.visibility) == \'blocked\' and not cfg.tab_force_fire:\n        return stop(\'esp_blocked\')\n    stamp = target.pose_sample_stamp or frame.stamp\n    age = control.clock()-stamp\n    info.update(pose_age_ms=age*1000, pose_age_limit_ms=MAX_TARGET_AGE*1000.)\n    if not 0 <= age <= MAX_TARGET_AGE:\n        return stop(\'esp_pose_expired\')\n    sampled = read_sight(reader, frame, scale)\n    if sampled is not None:\n        sampled=center_current_punch(control,reader,frame,target,scale,sampled,\'commit\')\n    if sampled is None:\n        return stop(\'invalid_view\')\n    view, punch, sight = sampled\n    distance = length(sub(target.head, frame.eye))\n    if not 0 < distance <= float((weapon or {}).get(\'Range\', 8192.)):\n        return stop(\'outside_weapon_range\')\n    error = angle_error(sight, aim_angles(frame.eye, target.head))\n    if error >= aim_tolerance(frame.eye, target):\n        return stop(\'sight_outside_published_hitbox\')\n    endpoint = add(frame.eye, tuple(v*distance for v in view_direction(sight)))\n    if not check_hostage_sight(control,frame,sight,weapon,\'commit\'):\n        return stop(control.reason)\n    info.update(allowed=True, status=\'ready\', elapsed_ms=max(0., control.clock()-began)*1000)\n    d.update(actual_sight=sight, readback_angles=view, firing_punch=punch,\n             actual_ray_endpoint=endpoint, firing_aim_point=target.head,\n             write_readback_verified=True, write_readback_error_deg=error,\n             fire_basis=\'independent_point_native_readback\' if independent else \'esp_point_native_readback\', shot_path=path.get(\'kind\'), penetration=path)\n    old = d.get(\'fire_snapshot\') or {}\n    d[\'fire_snapshot\'] = dict(old, stamp=control.clock(), point=tuple(target.head),\n                             point_id=target.aim_id, part=target.aim_part,\n                             pose_stamp=stamp, eye=tuple(frame.eye), angles=tuple(view),\n                             punch=tuple(punch), path=path.get(\'kind\'), fire_commit=dict(info))\n    return True\n\n\ndef confirm_after_weapon(control, reader, frame, target, scale, weapon=None):\n    """Check actual DOWN after the weapon read, without another pose/wall scan."""\n    d = control.diagnostic\n    info = d.get(\'fire_commit\') or {}\n    snap = d.get(\'fire_snapshot\') or {}\n\n    def stop(reason):\n        info.update(allowed=False, status=reason, post_weapon_verified=False)\n        d.update(fire_allowed=False, stop_reason=reason)\n        control.reason = reason\n        return False\n\n    if not info.get(\'allowed\') or not snap:\n        return stop(\'final_snapshot_missing\')\n    if not control.input_ready(reader) or not control.identity_current(reader, frame, target):\n        return stop(\'identity_changed_after_weapon\')\n    age = control.clock()-snap.get(\'pose_stamp\', -math.inf)\n    info[\'post_weapon_pose_age_ms\'] = age*1000\n    if not 0 <= age <= MAX_TARGET_AGE:\n        return stop(\'esp_pose_expired_after_weapon\')\n    sampled = read_sight(reader, frame, scale)\n    if sampled is not None:\n        sampled=center_current_punch(control,reader,frame,target,scale,sampled,\'after_weapon\')\n    if sampled is None:\n        return stop(\'invalid_view_after_weapon\')\n    view, punch, sight = sampled\n    info[\'post_weapon_sight_drift_deg\'] = angle_error(sight, d.get(\'actual_sight\', sight))\n    if angle_error(sight, aim_angles(frame.eye, target.head)) >= aim_tolerance(frame.eye, target):\n        return stop(\'sight_outside_published_hitbox_after_weapon\')\n    if not check_hostage_sight(control,frame,sight,weapon,\'after_weapon\'):\n        return stop(control.reason)\n    distance=length(sub(target.head,frame.eye))\n    d.update(actual_sight=sight,readback_angles=view,firing_punch=punch,\n        actual_ray_endpoint=add(frame.eye,tuple(v*distance for v in view_direction(sight))))\n    snap.update(angles=tuple(view),punch=tuple(punch))\n    checked=control.clock()\n    before_age=(checked-snap[\'pose_stamp\'])*1000\n    if not 0<=before_age<=MAX_TARGET_AGE*1000:\n        return stop(\'esp_pose_expired_after_sight\')\n    info.update(before_fire_age_ms=before_age,before_fire_checked_stamp=checked)\n    refresh=d.get(\'pose_refresh\')\n    if isinstance(refresh,dict):\n        refresh.update(before_fire_age_ms=before_age,before_fire_checked_stamp=checked)\n        d[\'pose_age_before_fire_ms\']=before_age\n    info[\'post_weapon_verified\'] = True\n    info[\'pose_reused\']=bool((d.get(\'pose_refresh\') or {}).get(\'pose_reused\',True))\n    snap[\'fire_commit\'] = dict(info)\n    return True\n')
_EMBEDDED['aim_geometry'] = ('2026.10.07-aim-private-reader-evidence', '\n"""Private aim samples and ghost-mode civilian ray exclusion."""\nfrom dataclasses import dataclass,replace,field\nimport math,struct\nfrom geometry import add,sub,length,finite,box_ray,box_ray_interval\n\n\ndef protect_hostages(mode):\n    return mode in (\'stealth\',\'幽灵模式\',\'幽灵模式（按阵营）\')\n\n\n@dataclass\nclass AimPoint:\n    key:str\n    part:str\n    position:tuple\n    radius:float\n    priority:int\n    visibility:str=\'blocked\'\n    wall_text:str=\'遮挡\'\n    wall_age_ms:float|None=None\n    wall_head_shift:float|None=None\n    wall_eye_shift:float|None=None\n    penetrable:bool=False\n    penetration:dict=field(default_factory=dict)\n    head_region:str=\'center\'\n    model_local:tuple|None=None\n\n\ndef head_region_label(key):\n    """Stable model-relative label for the sampled skull coordinate."""\n    if not isinstance(key,str) or \':eye:\' not in key:return \'center\'\n    try:n=int(key.rsplit(\':\',1)[-1])\n    except (TypeError,ValueError):return \'center\'\n    return {0:\'eye_center\',1:\'eye_right\',2:\'eye_left\',3:\'eye_upper\',4:\'eye_lower\',\n            5:\'eye_upper_right\',6:\'eye_upper_left\',7:\'eye_lower_right\',8:\'eye_lower_left\'}.get(n,\'eye_ring\')\n\n\n@dataclass\nclass ProtectedEntity:\n    index:int\n    address:int\n    bounds:tuple|None\n    dormant:bool=False\n    hitboxes:tuple=()\n    sampled_at:float|None=None\n\n\n@dataclass(frozen=True)\nclass PoseHitbox:\n    bounds:tuple\n    origin:tuple\n    inverse:tuple\n    scales:tuple\n    group:int=-1\n\n    def intersects(self,start,delta,margin=0.):\n        return self.intersection(start,delta,margin) is not None\n\n    def intersection(self,start,delta,margin=0.):\n        relative=sub(start,self.origin)\n        local_start=tuple(sum(a*b for a,b in zip(row,relative)) for row in self.inverse)\n        local_delta=tuple(sum(a*b for a,b in zip(row,delta)) for row in self.inverse)\n        low,high=self.bounds\n        expanded=(tuple(low[i]-margin/self.scales[i] for i in range(3)),\n                  tuple(high[i]+margin/self.scales[i] for i in range(3)))\n        return box_ray_interval(expanded,local_start,local_delta)\n\n\ndef pose_transform(blob,bone,origin,factor,cache):\n    """Share only this pose\'s corrected basis between samples and hitboxes."""\n    key=(bone,factor)\n    if key not in cache:\n        from scale_geometry import visual_matrix\n        matrix=visual_matrix(struct.unpack_from(\'<12f\',blob,bone*48),origin,factor)\n        a,b,c,tx,d,e,f,ty,g,h,i,tz=matrix\n        scales=(math.sqrt(a*a+d*d+g*g),math.sqrt(b*b+e*e+h*h),math.sqrt(c*c+f*f+i*i))\n        sx,sy,sz=scales\n        orthogonal=(min(scales)>0 and abs(a*b+d*e+g*h)<1e-3*sx*sy\n                    and abs(a*c+d*f+g*i)<1e-3*sx*sz and abs(b*c+e*f+h*i)<1e-3*sy*sz)\n        cache[key]=(matrix,scales,orthogonal)\n    return cache[key]\n\n\ndef world_hitboxes(boxes,blob,origin,geometry_scale=1.,visual_factor=1.,head_visual_factor=None,*,pose_cache=None):\n    """Keep bone-local boxes oriented; an incomplete pose uses collision fallback."""\n    result=[];transforms={} if pose_cache is None else pose_cache\n    for bone,group,bounds in boxes:\n        if bone<0 or (bone+1)*48>len(blob) or len(bounds)!=6 or not finite(bounds):return ()\n        if not all(.01<bounds[i+3]-bounds[i]<4096 for i in range(3)):return ()\n        factor=head_visual_factor if group==1 and head_visual_factor is not None else visual_factor\n        matrix,scales,orthogonal=pose_transform(blob,bone,origin,factor,transforms)\n        axes=[tuple(matrix[j*4+i] for j in range(3)) for i in range(3)]\n        position=(matrix[3],matrix[7],matrix[11])\n        from scale_geometry import point_valid\n        if not finite(matrix) or min(scales)<=0 or not point_valid(position,origin,geometry_scale):return ()\n        if any(abs(sum(a*b for a,b in zip(axes[i],axes[j])))>1e-3*scales[i]*scales[j]\n               for i in range(3) for j in range(i)):return ()\n        inverse=tuple(tuple(v/(scales[i]**2) for v in axis) for i,axis in enumerate(axes))\n        result.append(PoseHitbox((tuple(bounds[:3]),tuple(bounds[3:])),position,inverse,scales,group))\n    return tuple(result)\n\n\ndef hitbox_envelope(boxes):\n    """World envelope computed once per pose for the cheap rejection pass."""\n    low=[float(\'inf\')]*3;high=[-float(\'inf\')]*3\n    for box in boxes:\n        a,b=box.bounds;center=tuple((a[i]+b[i])*.5 for i in range(3));half=tuple((b[i]-a[i])*.5 for i in range(3))\n        axes=tuple(tuple(v*box.scales[i]**2 for v in row) for i,row in enumerate(box.inverse))\n        for j in range(3):\n            middle=box.origin[j]+sum(axes[i][j]*center[i] for i in range(3))\n            extent=sum(abs(axes[i][j])*half[i] for i in range(3))\n            low[j]=min(low[j],middle-extent,box.origin[j]);high[j]=max(high[j],middle+extent,box.origin[j])\n    return tuple(low),tuple(high)\n\n\nHOSTAGE_MAX_ENVELOPE_SPAN=256.\nHOSTAGE_MAX_RAY_MARGIN=4.\n# Source world units are inches.  The aim/fire hostage guard is intentionally\n# local: a hostage more than 15 metres from the player\'s eye is outside this\n# expensive protection path, while nearby hostages retain exact OBB checks.\nSOURCE_UNITS_PER_METER=1./.0254\nHOSTAGE_CHECK_DISTANCE=15.*SOURCE_UNITS_PER_METER\n\n\ndef hostage_check_distance(eye, hostage):\n    """Return the shortest eye-to-volume distance in Source units."""\n    bounds=getattr(hostage,\'bounds\',None)\n    if bounds is None:\n        boxes=getattr(hostage,\'hitboxes\',()) or ()\n        if boxes: bounds=bounded_hostage_envelope(boxes)\n    if bounds is None:return 0.\n    try:\n        low,high=bounds;distance=0.\n        for i in range(3):\n            if eye[i]<low[i]:distance+=(low[i]-eye[i])**2\n            elif eye[i]>high[i]:distance+=(eye[i]-high[i])**2\n        return math.sqrt(distance)\n    except (TypeError,ValueError,IndexError,OverflowError):\n        return 0.\n\n\nd