_EMBEDDED['target_rules'] = (1, '\n\n"""Model hitbox selection and explicit player/PVE classification."""\n\nimport math\n\nimport re\n\n\n\nPVE_MODE = \'PVE / 大灾变 / 洛奇（敌对AI）\'\n\nFFA_MODE = \'个人战（所有其他玩家）\'\n\nPLAYER_CLASSES = {\'ccsplayer\', \'c_csplayer\'}\n\nNPC_CLASSES = {\n\n    \'ccso2monster\', \'ccso2mob_human\', \'ccso2mob_zombie\',\n\n    \'ccso2mob_zombie_special_dione\', \'ccso2mob_zombie_special_halley\',\n\n    \'ccso2mob_zombie_special_oberon\', \'ccso2mob_zombie_special_phobos\',\n\n    \'ccso2mob_zombie_zs_boss\', \'ccso2mob_machine_turret_minigun\',\n\n    \'ccso2mob_machine_uh60mod\',\n\n}\n\n\n\ndef entity_kind(name):\n\n    name=name.lower()\n\n    return \'player\' if name in PLAYER_CLASSES else (\'npc\' if name in NPC_CLASSES else \'\')\n\n\n\n\n\ndef target_is_active(entity):\n\n    if entity.dormant or entity.health<=0:return False\n\n    if entity.health==1 and entity.ragdoll_present is True:return False\n\n    return entity.reported_alive or (entity.health==1 and entity.pose_confirmed)\n\n\n\ndef is_enemy(name, team, local_team, mode, override=0):\n\n    kind=entity_kind(name)\n\n    if not kind:return False\n\n    if override:return team==override\n\n    pve=mode in (PVE_MODE, \'生化打僵尸（NPC）\')\n\n    if kind==\'player\':\n\n        if mode==FFA_MODE:return team>=2 and local_team>=2\n\n        return not pve and team>=2 and local_team>=2 and team!=local_team\n\n    # An explicit co-op rule permits unassigned combat NPCs. Props, civilians,\n\n    # generic CAI_BaseNPCs, projectile/vehicle chunks are not in the allowlist.\n\n    return team!=local_team and (team>=2 or (pve and team in (0,1)))\n\n\n\nHEAD_NAME = re.compile(r\'(?:(?:cso2_bipm|cso2_bip|cso2_bipz_[a-z0-9]+|valvebiped\\.bip01|bip0*1|cso2|sk)[ ._])?head[0-9]*$\')\n\n\n\ndef choose_head(names, parents, boxes):\n\n    """Return (bone, local_center), provenance and valid hitbox bones.\n\n\n\n    Generic hitgroups need a complete anatomical head->neck chain. Never\n\n    infer a head from height, a decorative substring, or an entity origin.\n\n    """\n\n    names=[n.lower() for n in names];native=[];anatomical=[];hit_bones=set();groups=set()\n\n    for bone,group,bounds in boxes:\n\n        if not 0<=bone<len(names) or len(bounds)!=6 or not all(math.isfinite(x) for x in bounds):continue\n\n        extent=[bounds[i+3]-bounds[i] for i in range(3)]\n\n        if not all(0<x<4096 for x in extent):continue\n\n        hit_bones.add(bone);groups.add(group)\n\n        center=tuple((bounds[i]+bounds[i+3])*.5 for i in range(3))\n\n        parent=parents[bone]\n\n        exact=bool(HEAD_NAME.fullmatch(names[bone]))\n\n        normal=exact and 0<=parent<len(names) and \'neck\' in names[parent]\n\n        skull=(names[bone]==\'head neck upper\' and 0<=parent<len(names)\n\n               and HEAD_NAME.fullmatch(names[parent]) and 0<=parents[parent]<len(names)\n\n               and \'neck\' in names[parents[parent]])\n\n        volume=math.prod(extent)\n\n        if group==0 and (normal or skull):anatomical.append((volume,bone,center))\n\n        if group==1:\n\n            # Prefer a skull to the neck when the author assigned both group 1.\n\n            token=bool(re.search(r\'(?:^|[ ._])head\\d*$\',names[bone]))\n\n            native.append((token,volume,bone,center))\n\n    if native:\n\n        _,_,bone,center=max(native)\n\n        return (bone,center),\'head_hitgroup\',hit_bones\n\n    if len(anatomical)==1:\n\n        _,bone,center=anatomical[0]\n\n        return (bone,center),\'anatomical_generic\',hit_bones\n\n    reason=\'ambiguous_head_boxes\' if len(anatomical)>1 else (\'no_head_hitbox\' if hit_bones else \'no_hitboxes\')\n\n    return None,reason,hit_bones\n\n')





