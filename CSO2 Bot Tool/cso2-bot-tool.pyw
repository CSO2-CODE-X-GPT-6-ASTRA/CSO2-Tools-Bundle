        self.assertEqual(result[\'prepare_calls\'],0)\n            self.assertEqual(result[\'expired\'],0)\n\n        def test_confirmed_death_and_new_map_remove_old_actor_capabilities(self):\n            from esp_skeleton_rules import fixture\n            policy=DisplayFaultSurface();f=fixture();policy.validate(f);policy.submitted(f)\n            e=f.entities[0];e.skeleton=[];e.health=0\n            policy.validate(f);policy.submitted(f);self.assertFalse(policy.rigs)\n            f=fixture();policy.validate(f);policy.submitted(f)\n            f.map_name=\'maps/other.bsp\';f.entities[0].skeleton=[]\n            policy.validate(f);self.assertFalse(policy.rigs)\n\n        def test_entity_read_gap_waits_but_verified_despawn_removes_marker(self):\n            from esp_skeleton_rules import fixture\n            from esp_sources import copy_frame\n            policy=DisplayFaultSurface();f=fixture(count=3);policy.validate(f);policy.submitted(f)\n            missing=copy_frame(f);missing.entities=missing.entities[:2]\n            with self.assertRaises(DisplaySampleUnavailable):\n                policy.validate(missing,dict(errors=[dict(index=f.entities[2].index)]))\n            policy.validate(missing,dict(chain_complete=True,errors=[]));policy.submitted(missing)\n            self.assertEqual(len(policy.rigs),2)\n\n        def test_healthy_empty_current_scene_is_committed_and_other_models_do_not_inherit_old_pose(self):\n            from esp_skeleton_rules import fixture\n            policy=DisplayFaultSurface();f=fixture();policy.validate(f);policy.submitted(f)\n            f.entities[0].model=\'new/rig.mdl\';f.entities[0].skeleton=[]\n            policy.validate(f);policy.submitted(f);self.assertFalse(policy.rigs)\n            f.entities=[];policy.validate(f,dict(chain_complete=True));policy.submitted(f)\n            self.assertEqual(policy.snapshot()[\'complete_frames\'],3)\n\n        def test_actor_without_native_bones_keeps_its_marker_on_single_read_gap(self):\n      