ocity,remaining,radius,self.gravity*world_gravity,\n                       self.elasticity,\'client\',\'first_seen_native_fuse_estimate\',model),\'\'\n\n    def scan(self):\n        r=self.reader;m=r.mem;now=self.clock();started=time.perf_counter()\n        signon=m.i32(r.global_addr(\'signon\'))\n        scope=(m.pid,m.string(r.global_addr(\'level_name\'),160),m.i32(r.global_addr(\'local_index\')))\n        if scope!=self.scope or signon!=6:\n            self.first_seen.clear();self.scope=scope\n        if signon!=6:raise RuntimeError(\'等待当前客户端手雷数据\')\n        gravity=struct.unpack(\'<f\',m.read(m.u32(self.gravity_var+28)+48,4))[0]\n        if not math.isfinite(gravity) or not 0<gravity<=4000:raise ValueError(\'客户端同步重力数值异常\')\n        rows=[(i,p,serial) for i,(p,serial,kind) in r.slot_cache.items() if kind==\'grenade\']\n        result=[];rejections={};errors=[]\n        for index,address,serial in rows:\n            try:\n                grenade,reason=self.read(index,address,serial,now,gravity)\n                if grenade:result.append(grenade)\n                else:rejections[reason]=rejections.get(reason,0)+1\n            except Exception as ex:\n                rejections[\'read_error\']=rejections.get(\'read_error\',0)+1\n                if len(errors)<4:errors.append(f\'#{index} {type(ex).__name__}: {str(ex)[:120]}\')\n        current=(m.pid,m.string(r.global_addr(\'level_name\'),160),m.i32(r.global_addr(\'local_index\')))\n        if m.i32(r.global_addr(\'signon\'))!=6 or current!=scope:\n            self.first_seen.clear();self.metrics=dict(source=\'client\',valid=0,reason=\'session_changed\')\n            raise RuntimeError(\'客户端连接或地图已变化，已清除旧手雷样本\')\n        alive={g.key for g in result}\n        self.first_seen={k:v for k,v in self.first_seen.items() if k in alive}\n        self.metrics=dict(source=\'client\',recognized=len(rows),valid=len(result),errors=errors,\n            rejection_reasons=rejections,timer_basis=\'first_seen_native_fuse_estimate\',timer_exact=False,\n            native_fuse_seconds=self.fuse,world_gravity=gravity,\n            estimated_fuse_elapsed=sum(now-self.first_seen[g.key]>=self.fuse for g in result),\n            observed_projectiles=[dict(key=g.key,origin=g.origin,velocity=g.velocity,radius=g.radius,\n                model=g.model,remaining_estimate=g.remaining) for g in result[:8]],\n            scan_build=\'2026.10.05-remote-he-1\',sample_ms=round((time.perf_counter()-started)*1000,3))\n        self.status=(\'客户端手雷采样：\'+errors[0]) if errors else \'\'\n        return result\n\n\ndef grenade_reader(reader,current=None):\n    from runtime_compat import native_loopback\n    kind=HostGrenades if native_loopback(reader) else ClientGrenades\n    return current if isinstance(current,kind) and current.reader is reader else kind(reader)\n\n\nclass HostGrenades:\n    def __init__(self,reader):\n        from server_visibility import local_connection\n        if not local_connection(reader):raise RuntimeError(\'躲雷只支持本地主机\')\n        self.reader=reader;server=reader.mods.get(\'server.dll\')\n        spec=_BUNDLE_DATA[\'logging_profile.json\']\n        if not server or not server_compatible(reader):\n            raise RuntimeError(\'躲雷主机版本未验证\')\n        self.base=server[0];m=reader.mem;s=self.base\n        self.scan_time=0.;self.slots={};self.projectiles=[]\n        for rva,name,offset in ((0x9c1f74,\'m_flDetonateTime\',0x498),(0x9c1f40,\'m_DmgRadius\',0x490),\n                                (0x9aaa58,\'m_flElasticity\',0x278),(0x9c0834,\'m_flGravity\',0x270)):\n            if m.string(m.u32(s+rva),64)!=name or m.u32(s+rva+4)!=offset:\n                raise RuntimeError(\'手雷字段签名不匹配：\'+name)\n        if m.read(s+0x485e89,7)!=b\'\\x83\\xb9\'+struct.pack(\'<I\',s+0xa5fa44)+b\'\\0\':\n            raise RuntimeError(\'服务器实体列表签名不匹配\')\n        if m.string(m.u32(s+0xa0aeec),64)!=\'sv_gravity\':raise RuntimeError(\'重力变量未验证\')\n        # This CS HE implementation leaves CBaseGrenade::m_flDetonateTime\n    