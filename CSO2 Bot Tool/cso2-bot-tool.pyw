 self.epoch=epoch;self.started=self.clock();self.at=self.started\n        self.stage=\'between_cycles\';self.durations={};self.context={}\n        self.mark(\'frame_read\')\n\n    def mark(self,stage,**context):\n        now=self.clock()\n        if self.stage!=\'between_cycles\':\n            self.durations[self.stage]=round(max(0.,now-self.at)*1000,3)\n        self.stage=stage;self.at=now;self.context.update(context)\n        self._write()\n\n    def _write(self):\n        if self.mailbox is None:return\n        import json\n        try:\n            event=dict(epoch=self.epoch,pid=self.pid,stage=self.stage,stage_started=self.at,\n                cycle_started=self.started,sequence=self.sequence,stage_ms=dict(self.durations),\n                max_cycle_ms=self.max_cycle_ms,overruns=self.overruns,\n                slow_cycles=list(self.slow_cycles),**self.context)\n            if not self.mailbox.write(json.dumps(event,separators=(\',\',\':\')).encode(\'utf-8\')):\n                self.write_failures+=1\n        except (OSError,ValueError,RuntimeError):self.write_failures+=1\n\n    def finish(self,sequence,error=\'\'):\n        now=self.clock();self.durations[self.stage]=round(max(0.,now-self.at)*1000,3)\n        elapsed=round(max(0.,now-self.started)*1000,3)\n        self.sequence=sequence;self.max_cycle_ms=max(self.max_cycle_ms,elapsed)\n        if elapsed>DISPLAY_MAX_SAMPLE_AGE*1000:\n            self.overruns+=1\n            self.slow_cycles.append(dict(sequence=sequence,elapsed_ms=elapsed,\n                stage_ms=dict(self.durations),weapon=self.context.get(\'weapon\',\'\'),error=error))\n            self.slow_cycles=self.slow_cycles[-4:]\n        self.stage=\'error\' if error else \'waiting\';self.at=now\n        self.context.update(last_error=error,cycle_ms=elapsed);self._write()\n\n\nclass ServerSampleProcess:\n    def __init__(self,reader,visibility=None,warnings=None):\n        import os,sys,subprocess,uuid\n        from esp_transport import LatestMailbox\n        self.reader=reader;self.latest=None;self.epoch=0;self.desired=None;self.sent=None\n        self.error=\'\';self.closed=False;self.last_start=time.monotonic()\n        self.last_reply=self.last_start;self.received_reply=False;self.active_since=self.last_start\n        self.hard_error=\'\';self.retained_deliveries=0\n        self.tag=\'Local\\\\CSO2_SAMPLE_\'+str(os.getpid())+\'_\'+uuid.uuid4().hex\n        self.requests=self.replies=self.progress=None;self.last_progress={}\n        try:\n            self.requests=LatestMailbox(self.tag+\'_request\',create=True)\n            self.replies=LatestMailbox(self.tag+\'_reply\',create=True)\n            try:self.progress=LatestMailbox(self.tag+\'_progress\',create=True)\n            except (OSError,RuntimeError,ValueError):pass  # Diagnostics are optional.\n            self.proc=subprocess.Popen([sys.executable,\'-X\',\'utf8\',\'-u\',str(BUNDLE_ENTRY),\'--server-sample-worker\',\n                str(reader.game),self.tag,str(os.getpid()),str(reader.mem.pid)],\n                stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,\n                creationflags=subprocess.CREATE_NO_WINDOW)\n        except Exception:\n            for mailbox in (self.requests,self.replies,self.progress):\n                if mailbox is not None:mailbox.close()\n            raise\n\n    def _flush(self):\n        import json\n        if self.desired!=self.sent and self.requests.write(json.dumps(self.desired,separators=(\',\',\':\')).encode(\'utf-8\')):\n            self.sent=self.desired\n\n    def configure(self,cfg,warnings=None):\n        if self.desired is None or self.desired.get(\'cfg\') is None:\n            # A deliberately paused sampler is not a failed sampler. Give a\n            # resumed request its own warm deadline without faking a reply.\n            self.active_since=time.monotonic()\n        self.desired={\'epoch\':self.epoch,\'cfg\':vars(cfg),\'warnings\':warnings}\n        self._flush()\n\n    def pause(self):\n        if self.desired is not None and self.desired.get(\'cfg\') is not None:\n            self.epoch+=1;self.latest=None\n        self.error=\'\';self.hard_error=\'\'\n        self.desired={\'epoch\':self.epoch,\'cfg\':None};self._flush()\n\n    def take(self,max_age=DISPLAY_MAX_SAMPLE_AGE):\n        self._flush()\n        payload=self.replies.read_latest()\n        if payload is not None:self.last_reply=time.monotonic();self.received_reply=True\n        silence_limit=1.5 if self.received_reply else 30.\n        silent=(self.desired is not None and self.desired.get(\'cfg\') is not None and\n                time.monotonic()-max(self.last_reply,getattr(self,\'active_since\',0.))>silence_limit)\n        if self.proc.poll() is not None or silent:\n            self.latest=None\n            reason=f\'显示采样进程连续{silence_limit:g}秒未回复\' if silent else \'SERVER sample process exited: \'+str(self.proc.returncode)\n            if time.monotonic()-self.last_start>=.25:\n                desired=self.desired;epoch=self.epoch+1;reader=self.reader\n                self.close();self.__init__(reader);self.epoch=epoch\n                if desired is not None:\n                    self.desired=dict(desired,epoch=epoch);self._flush()\n            raise DisplaySampleUnavailable(reason)\n        if payload is not None:\n            event=decode_server_packet(payload)\n            if event.get(\'epoch\')==self.epoch and event.get(\'pid\')==self.reader.mem.pid:\n                packet=None;retained=False\n                if \'error\' in event:\n                    self.error=event[\'error\']\n                    if not event.get(\'transient\',False):\n                        self.latest=None;self.hard_error=self.error\n                        raise NotReady(self.error)\n                    blob=event.get(\'retained_success\')\n                    if blob is not None:\n                        if not isinstance(blob,bytes):raise ValueError(\'Invalid retained display payload\')\n                        good=decode_server_packet(blob)\n                        if (not isinstance(good,dict) or \'error\' in good or\n                                good.get(\'epoch\')!=self.epoch or good.get(\'pid\')!=self.reader.mem.pid):\n                            raise ValueError(\'Invalid retained display packet\')\n                        packet=good[\'packet\'];retained=True\n                        if packet[2][\'sequence\']!=event.get(\'retained_sequence\'):\n                            raise ValueError(\'Retained display sequence mismatch\')\n                else:\n                    packet=event[\'packet\'];self.error=\'\'\n                if packet is not None:\n                    sources=[getattr(part,\'source\',\'\') for part in packet[:2]]\n                    if sources[0] not in (\'server\',\'client\') or sources[0]!=sources[1]:\n                        self.latest=None\n                        raise ValueError(\'Display snapshot source mismatch\')\n                    # Both retained and ordinary packets pass the same unchanged\n                    # freshness gate. Never renew a retained sample\'s timestamp.\n                    if not retained or self.latest is None or packet[2][\'sequence\']>self.latest[2][\'sequence\']:\n                        self.latest=packet\n                        if retained:self.retained_deliveries=getattr(self,\'retained_deliveries\',0)+1\n                    self.hard_error=\'\'\n        if self.latest is None and getattr(self,\'hard_error\',\'\'):\n            raise NotReady(self.hard_error)\n        if self.latest is None or not 0<=time.monotonic()-self.latest[0].stamp<=max_age:\n            raise DisplaySampleUnavailable(self.error or \'SERVER ESP awaiting fresh process sample\')\n        return self.latest\n\n    def status(self):\n        """Report transport and phase ages, even while take() rejects stale data."""\n        import json\n        now=time.monotonic();error=\'\'\n        try:\n            mailbox=getattr(self,\'progress\',None)\n            payload=mailbox.read_latest() if mailbox is not None else None\n            if payload is not None:\n                event=json.loads(payload)\n                if event.get(\'epoch\')==self.epoch and event.get(\'pid\')==self.reader.mem.pid:\n                    stamp=event.get(\'stage_started\')\n                    if (not isinstance(stamp,(int,float)) or not math.isfinite(stamp)\n                            or not isinstance(event.get(\'stage\'),str)):\n                        raise ValueError(\'Invalid sample progress record\')\n                    self.last_progress=event\n        except (OSError,ValueError,RuntimeError,AttributeError) as ex:error=str(ex)\n        progress=dict(getattr(self,\'last_progress\',{}))\n        if progress.get(\'epoch\')!=self.epoch:progress={}\n        if progress:\n            progress[\'stage_age_ms\']=round(max(0.,now-progress[\'stage_started\'])*1000,3)\n        packet=self.latest\n        return dict(sampler_pid=getattr(self.proc,\'pid\',None),process_alive=self.proc.poll() is None,\n            sequence=packet[2][\'sequence\'] if packet else None,\n            sample_age_ms=round((now-packet[0].stamp)*1000,3) if packet else None,\n            last_reply_age_ms=round(max(0.,now-self.last_reply)*1000,3),\n            reply_deadline_ms=(1500. if self.received_reply else 30000.),\n            received_reply=self.received_reply,phase=progress,telemetry_error=error)\n\n    def close(self):\n        if self.closed:return\n        self.closed=True\n        self.desired={\'epoch\':self.epoch,\'close\':True};self._flush()\n        try:self.proc.wait(timeout=1.)\n        except Exception:\n            self.proc.terminate()\n            try:self.proc.wait(timeout=.5)\n            except Exception:\n                self.proc.kill()\n                try:self.proc.wait(timeout=.5)\n                except Exception:pass\n        self.requests.close();self.replies.close()\n        if getattr(self,\'progress\',None) is not None:self.progress.close()\n\n\ndef serve_server_samples(game,tag,parent_pid,game_pid):\n    import json,pickle\n    from esp_transport import LatestMailbox,kernel\n    from cso2_bot_tool import Config\n    from presentation import TimerResolution\n    requests=replies=parent=progress_mailbox=None;reader=None;k=kernel();timer=TimerResolution()\n    try:\n        requests=LatestMailbox(tag+\'_request\');replies=LatestMailbox(tag+\'_reply\')\n        try:progress_mailbox=LatestMailbox(tag+\'_progress\')\n        except (OSError,RuntimeError,ValueError):pass\n        progress=SampleProgress(progress_mailbox,int(game_pid));progress.mark(\'reader_attach\')\n        parent=k.OpenProcess(0x100000,False,int(parent_pid))\n        if not parent:return\n        from esp_shared import AdaptiveDisplayReader,DisplayRetry\n        reader=AdaptiveDisplayReader(game);reader.attach(pid=int(game_pid))\n        progress.mark(\'reader_attached\',attach_timing=dict(getattr(reader,\'attach_timing\',{})))\n        if reader.mem.pid!=int(game_pid):raise NotReady(\'SERVER sample PID mismatch\')\n        warnings=DisplayHostageWarnings()\n        from esp_sources import copy_frame\n        cfg=None;epoch=0;warning_state=None;sequence=0;failures=0;errors={};last_error=0.\n        publication=SamplePublication(replies,int(game_pid))\n        from display_work_budget import SampleWorkGate\n        work_gate=SampleWorkGate()\n        recovery=DisplayRetry()\n        while k.WaitForSingleObject(parent,0)==258:\n            started=time.monotonic();request=requests.read_latest()\n            if request is not None:\n                command=json.loads(request)\n                if command.get(\'close\'):break\n                if command[\'epoch\']!=epoch:\n                    publication.reset();work_gate.reset()\n                from overlay_service import decode_config\n                epoch=command[\'epoch\'];cfg=decode_config(command[\'cfg\']) if command.get(\'cfg\') is not None else None\n                warning_state=command.get(\'warnings\')\n            if cfg is None:\n                progress.epoch=epoch;progress.mark(\'paused\')\n                timer.set_active(False);publication.reset();work_gate.reset()\n                reader.pause_sources()\n                if reader.pose_refresher:reader.pose_refresher.pause()\n                k.WaitForSingleObject(requests.event,25);continue\n            timer.set_active(True)\n            progress.begin(epoch)\n            try:\n                raw=reader.frame(cfg.mode,cfg.enemy_team,with_hazards=cfg.esp_grenades,\n                    with_aimpoints=False,observe_inactive=True,include_allies=cfg.allies)\n                cfg=__import__(\'mode_ally_policy\').apply(raw,cfg)\n                raw.server_base=getattr(raw,\'server_base\',0)\n                selected_at=time.monotonic()\n                needed,work_key=work_gate.request(raw,cfg,None)\n                if not needed:\n                    progress.mark(\'await_new_acquisition\',work_budget=work_gate.metrics())\n                    progress.finish(sequence)\n                    k.WaitForSingleObject(requests.event,sampler_rest_ms(time.monotonic()-started))\n                    continue\n                displayed=copy_frame(raw);vis_ms=0.\n                # Acquisition publishes measured poses only. The renderer owns\n                # the one current-camera ray pass and the targeting verdict.\n                for snapshot in (raw,displayed):\n                    for actor in snapshot.entities:\n                        actor.visibility=\'blocked\';actor.wall_age_ms=None\n                        actor.display_visibility_stamp=0.;actor.esp_visible_points=()\n                        actor.display_penetration={};actor.penetration={};actor.wall_penetrable=False\n                progress.mark(\'hostage_warnings\')\n                displayed.hostage_warnings=warnings.update(reader,raw,warning_state) if cfg.esp else []\n                sequence+=1\n                diagnostics=dict(sequence=sequence,read_ms=reader.sample_ms,visibility_ms=vis_ms,\n                    entities=dict(reader.entity_stats),visibility=dict(owner=\'renderer\',rays=0,current_ray_in_sampler=False),\n                    pose_bridges=0,failures=failures,error_counts=dict(errors),\n                    transport=\'separate_process_latest\',sampler_pid=__import__(\'os\').getpid(),\n                    recovery=recovery.metrics(),\n                    attach_timing=dict(getattr(reader,\'attach_timing\',{})),\n                    retained_error_publications=publication.retained_errors,\n                    expired_publications=publication.expired_publications,\n                    source_age_at_selection_ms=max(0.,selected_at-raw.stamp)*1000,\n                    postprocess_ms=max(0.,time.monotonic()-selected_at)*1000,\n                    sample_age_before_publish_ms=max(0.,time.monotonic()-raw.stamp)*1000,\n                    cycle_work_ms=round((time.monotonic()-started)*1000,3),work_budget=work_gate.metrics())\n                progress.mark(\'publication\')\n                publication.success(epoch,(raw,displayed,diagnostics))\n                work_gate.committed(work_key)\n                recovery.succeeded()\n                progress.finish(sequence)\n            except Exception as ex:\n                failures+=1;reason=str(ex);errors[reason]=errors.get(reason,0)+1\n                # Preserve actual rejection/age evidence separately from the\n                # stable error string. A completed expired lane is not startup.\n                if isinstance(ex,DisplaySampleUnavailable):\n                    progress.context[\'sources\']=dict(getattr(reader,\'source_status\',{}))\n                progress.finish(sequence,reason)\n                if len(errors)>24:errors.pop(next(iter(errors)))\n                if started-last_error>=.05:\n                    publication.error(epoch,reason,isinstance(ex,(DisplayCameraUnavailable,DisplaySampleUnavailable)));last_error=started\n                elif not isinstance(ex,(DisplayCameraUnavailable,DisplaySampleUnavailable)):\n                    # Hard errors invalidate retained packets even while\n                    # their diagnostic messages are being rate limited.\n                    publication.reset()\n                if recovery.failed(reason) and not isinstance(ex,DisplaySampleUnavailable):\n                    progress.mark(\'reader_recovery\')\n                    # Release/rebind our own display resources on sustained\n                    # failure. A healthy empty scene never reaches this path.\n                    try:\n                        reader.recover_display()\n                        if reader.mem.pid!=int(game_pid):raise NotReady(\'显示恢复进程身份已变化\')\n                        publication.reset();work_gate.reset()\n                    except Exception as retry_error:\n                        publication.error(epoch,\'显示自动恢复：\'+str(retry_error),False)\n            # No catch-up loop after an overrun. Rendering cadence is unchanged.\n            k.WaitForSingleObject(requests.event,sampler_rest_ms(time.monotonic()-started))\n    finally:\n        timer.close()\n        if reader:reader.close()\n        if requests:requests.close()\n        if replies:replies.close()\n        if progress_mailbox:progress_mailbox.close()\n        if parent:k.CloseHandle(parent)\n\n\ndef latch_server_positions(reader,frame):\n    """Refresh actual server translation immediately before projection.\n\n    Only display copies move; no guessed velocity/predicted head reaches aiming.\n    Entity generation, life state and model identity are checked again here.\n    """\n    import copy\n    started=time.monotonic();m=reader.mem;base=getattr(frame,\'server_base\',0)\n    metrics=dict(refreshed=0,rejected=0,errors=0,max_shift_units=0.,read_ms=0.,dropped=[],read_fallbacks=[])\n    if not base:return frame,metrics\n    local=frame.local;table=base+TABLE\n    local_identity=struct.pack(\'<II\',local.address,local.serial)\n    if m.read(table+local.index*16,8)!=local_identity:raise NotReady(\'SERVER render local identity changed\')\n    result=copy.copy(frame);result.local=copy.copy(local);actors=[]\n    def rejected(raw,reason,**details):\n        metrics[\'rejected\']+=1\n        if len(metrics[\'dropped\'])<128:\n            metrics[\'dropped\'].append(dict(index=raw.index,address=raw.address,serial=raw.serial,reason=reason,\n                hp=raw.health,reported_alive=raw.reported_alive,ragdoll=raw.ragdoll_present,model=raw.model,**details))\n    for raw in (local,*frame.entities):\n        if raw is not local and (raw.health<=0 or (raw.health==1 and raw.ragdoll_present is True)):\n            rejected(raw,\'dead_sample\' if raw.health<=0 else \'ragdoll_sample\');continue\n        entry=table+raw.index*16;identity=struct.pack(\'<II\',raw.address,raw.serial)\n        try:\n            if m.read(entry,8)!=identity:rejected(raw,\'identity_before_latch\');continue\n            # One contiguous read covers health/life, team, origin, velocity,\n            # active hitbox set and model wrapper.\n            data=m.read(raw.address+0xf4,0x478-0xf4)\n            hp=struct.unpack_from(\'<i\',data,0)[0];life=data[4]\n            origin=struct.unpack_from(\'<3f\',data,0x28c-0xf4)\n            velocity=struct.unpack_from(\'<3f\',data,0x298-0xf4)\n            model=(struct.unpack_from(\'<I\',data,0x474-0xf4)[0],struct.unpack_from(\'<i\',data,0x378-0xf4)[0])\n            if not finite(origin+velocity) or max(map(abs,origin))>131072 or not 0<=hp<100000000:\n                rejected(raw,\'invalid_latch_values\',current_hp=hp,current_life=life,\n                         current_origin=tuple(v if math.isfinite(v) else None for v in origin),\n                         current_velocity=tuple(v if math.isfinite(v) else None for v in velocity),\n                         finite_position=finite(origin),finite_velocity=finite(velocity)