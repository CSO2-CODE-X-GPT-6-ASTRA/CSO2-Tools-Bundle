l native probes finish.\n        # Scheduling uses cached points only for order; native rig/trace still\n        # determines every published endpoint.\n        for row in sorted(payload[\'entities\'],key=probe_rank):\n            key=identity(row);removed=ready.pop(key,None) is not None\n            # Model-local definitions survive a stale Python rig. The native\n            # probe refreshes matrices and tests current points before publish.\n            points=[dict(p) for p in row.get(\'native_samples\',())]\n            points.sort(key=lambda p:(p[\'part\']!=\'head\',not p[\'key\'].endswith(\':c\'),p.get(\'priority\',0),p[\'key\']))\n            if not points:\n                if removed:publish_ready()\n                continue\n            compact={k:row[k] for k in (\'target\',\'target_entity_address\',\'serial\',\'team\',\'health\',\n                \'sample_wall_ms\',\'wrapper\',\'studio\',\'hitbox_set\',\'model_bones\',\'native_origin\',\'pose_envelope\') if k in row}\n            compact[\'protected_volumes\']=row.get(\'protected_volumes\',[])\n            compact[\'native_boxes\']=row.get(\'native_boxes\',[])\n            answer=ask(compact,points);metrics[\'points\']+=answer.get(\'points_tested\',len(points))\n            resolved=answer.get(\'resolved\')\n            if not resolved:\n                if removed:publish_ready()\n                continue\n            point=resolved[\'sample\'];hit=resolved[\'hit\'];clip=resolved[\'clipped\']\n            sample_wall=answer.get(\'sample_wall_ms\',row[\'sample_wall_ms\'])\n            compact.pop(\'native_boxes\',None)\n            ready[key]=dict(compact,position=point[\'position\'],part=point[\'part\'],point_key=point[\'key\'],\n                sample_wall_ms=sample_wall,native_clear=True,native_sample_wall_ms=sample_wall,\n                verified_wall_ms=answer[\'verified_wall_ms\'],\n                probe_eye=answer[\'probe_eye\'],\n                selection_hitboxes=answer.get(\'selection_hitboxes\',row.get(\'selection_hitboxes\',[])),\n                point_source=\'current_pose_unobstructed_ray\',\n                trace_fraction=hit[\'fraction\'],trace_entity=hit[\'hit_entity\'],trace_hitgroup=hit[\'hitgroup\'],\n                clip_fraction=clip[\'fraction\'],clip_entity=clip[\'hit_entity\'],clip_hitgroup=clip[\'hitgroup\'],\n                trace_endpoint_clear=hit[\'fraction\']==1 and hit[\'hit_entity\']==\'0x0\')\n            publish_ready()\n        return snapshot()\n\n\nclass ClientPoseFeed:\n    """Bounded bone reads; cached poses retain their original sample time."""\n    def __init__(self):\n        self.scope=None;self.poses={};self.attempts={};self.metrics={}\n\n    def sample(self,reader,frame,request,clock):\n        scope=(reader.mem.pid,frame.map_name,frame.local.index,frame.local.address,frame.local.serial)\n        if scope!=self.scope:\n            self.scope=scope;self.poses.clear();self.attempts.clear()\n        actors=[a for a in frame.entities if a.enemy and target_is_active(a)\n                and a.index!=frame.local.index and (a.team!=frame.local.team or frame.free_for_all)\n                and (request[\'aim_npcs\'] or entity_kind(a.classname)!=\'npc\')]\n        identity=lambda a:(a.index,a.address,a.serial,a.team,a.model)\n        active={identity(a):a for a in actors}\n        self.poses={k:v for k,v in self.poses.items() if k in active}\n        self.attempts={k:v for k,v in self.attempts.items() if k in active}\n        pitch,yaw=map(math.radians,frame.angles[:2])\n        direction=(math.cos(pitch)*math.cos(yaw),math.cos(pitch)*math.sin(yaw),-math.sin(pitch))\n        def rank(a):\n            # Bounds/origin only schedule reads; they never become shot endpoints.\n            bounds=a.pose_bounds\n            point=tuple((bounds[0][i]+bounds[1][i])*.5 for i in range(3)) if bounds else a.origin\n            delta=sub(point,frame.eye);distance=length(delta)\n            along=sum(x*y for x,y in zip(delta,direction))\n            ray_distance=length(tuple(v-max(0.,along)*direction[i] for i,v in enumerate(delta)))\n            return (along<=0,ray_distance,distance,a.index)\n        ordered=sorted(actors,key=rank);began=clock();order=[]\n        if ordered:\n            order.append(ordered[0])\n        order.extend(sorted((a for a in ordered if a not in order),\n                            key=lambda a:(self.attempts.get(identity(a),-math.inf),rank(a))))\n        errors={};reads=0;refreshed=set()\n        for actor in order:\n            if reads>=CLIENT_POSE_LIMIT or (reads and clock()-began>=CLIENT_POSE_BUDGET):break\n            key=identity(actor);self.attempts[key]=clock();reads+=1\n            try:\n                current=reader.read_entity(actor.index,actor.address,with_bones=True,with_aimpoints=True,\n                    with_inventory=False,observe_inactive=True,\n                    control_context=(frame.local.team,frame.mode,request[\'enemy_team\'],frame.free_for_all))\n                if current is None or identity(current)!=key:\n                    self.poses.pop(key,None);errors[\'identity_changed\']=errors.get(\'identity_changed\',0)+1;continue\n                current.enemy=is_enemy(current.classname,current.team,frame.local.team,frame.mode,request[\'enemy_team\'])\n                if not request[\'enemy_team\'] and current.owner_team==frame.local.team:current.enemy=False\n                if frame.free_for_all and entity_kind(current.classname)==\'player\' and current.team>=2:current.enemy=True\n                self.poses[key]=current;refreshed.add(key)\n            except (RuntimeError,OSError,ValueError,struct.error) as error:\n                self.poses.pop(key,None);name=str(error);errors[name]=errors.get(name,0)+1\n        now=clock();result=[];expired=0\n        for key,actor in active.items():\n            pose=self.poses.get(key)\n            if pose is None:continue\n            if not 0<=now-pose.pose_sample_stamp<=.180:\n                self.poses.pop(key,None);expired+=1;continue\n            value=copy.copy(pose)\n            # Preserve pose time/coordinates, but use the latest life and origin.\n            if key not in refreshed:\n                value.health=actor.health;value.dormant=actor.dormant\n                value.reported_alive=actor.reported_alive;value.origin=actor.origin\n            if target_is_active(value):result.append(value)\n        self.metrics=dict(eligible=len(actors),bone_reads=reads,retained=len(result),expired=expired,\n                          errors=errors,bone_ms=round((now-began)*1000,3))\n        sampled=copy.copy(frame);sampled.entities=result\n        return sampled\n\nHASHES={\n    \'server.dll\':\'fd566dd57795ea6839fece87cd59e0175da364d1774ec6123a5f288b6e77fec2\',\n    \'engine.dll\':\'3a348976bf5e1d814d9fa6e5ad857298f7fb900094b4f5b84b60176656f22f5c\',\n    \'client.dll\':\'93fdee4c4d09d0fd79468de3384abc3a92a757864fd37d4ad6de25d8a371bc06\'}\n\n\ndef pose_envelope(header,scale=1.):\n    """Model-local yaw-independent envelope, including scaled animation slack."""\n    scale=max(1.,float(scale))\n    bounds=struct.unpack_from(\'<12f\',header,104)\n    boxes=[(bounds[i:i+3],bounds[i+3:i+6]) for i in (0,6)]\n    valid=[(lo,hi) for lo,hi in boxes if finite(lo+hi)\n           and all(lo[i]<=hi[i] for i in range(3))\n           and all(abs(v)<4096 for v in lo+hi)]\n    if not valid:raise ValueError(\'magic_model_envelope_invalid\')\n    horizontal=max((max(abs(lo[0]),abs(hi[0]))**2+max(abs(lo[1]),abs(hi[1]))**2)**.5 for lo,hi in valid)\n    radius=(max(48.,horizontal)+64.)*scale\n    low=(min(-32.,min(lo[2] for lo,hi in valid))-64.)*scale\n    high=(max(96.,max(hi[2] for lo,hi in valid))+64.)*scale\n    return [[-radius,-radius,low],[radius,radius,high]]\n\n\ndef pose_check(origin,positions,envelope):\n    positions=[tuple(p) for p in positions if len(p)==3 and finite(p)]\n    if not finite(origin) or not positions:return dict(mismatch=False,valid=0,total=0)\n    low,high=envelope\n    distances=[length(tuple(max(low[i]-(p[i]-origin[i]),0.,(p[i]-origin[i])-high[i])\n                            for i in range(3))) for p in positions]\n    inside=sum(d<=.01 for d in distances)\n    return dict(mismatch=inside==0,valid=inside,total=len(positions),\n                min_outside=round(min(distances),3),max_offset=round(max(length(sub(p,origin)) for p in positions),3),\n                origin=list(origin),sample=list(positions[0]),envelope=envelope)\n\n\ndef matrix_cloud(blob,count,offset=0):\n    """Inspect raw matrices before the general reader filters distant points.\n\n    Use the median rig scale, so a single corrupt matrix cannot enlarge the\n    envelope enough to hide a stale rig. The point filter handles outliers.\n    """\n    positions=[];scales=[]\n    for i in range(count):\n        matrix=struct.unpack_from(\'<12f\',blob,offset+i*48)\n        if not finite(matrix):continue\n        axes=[sum(matrix[row*4+axis]**2 for row in range(3))**.5 for axis in range(3)]\n        if min(axes)<=1e-4:continue\n        positions.append((matrix[3],matrix[7],matrix[11]));scales.extend(axes)\n    return positions,max(1.,sorted(scales)[len(scales)//2]) if scales else 1.\n\n\ndef point_current(point,origin,envelope):\n    return pose_check(origin,[point],envelope)[\'valid\']==1\n\n\nclass MagicTargetReader(ClientControlReader):\n    def read_entity(self,index,address,*args,**kwargs):\n        # Preserve the raw mismatch diagnostic even when the shared reader\n        # subsequently rejects the geometry. This dictionary lives one read.\n        if not hasattr(self,\'_magic_reads\'):self._magic_reads={}\n        self._magic_reads.pop(address,None)\n        try:\n            actor=super().read_entity(index,address,*args,**kwargs)\n            observation=self._magic_reads.get(address)\n            if actor is not None and observation:actor.__dict__.update(observation)\n            return actor\n        finally:self._magic_reads.pop(address,None)\n\n    def bones(self,p,origin,entity_data=None,metadata=None,*args,**kwargs):\n        if metadata is None:return super().bones(p,origin,entity_data,metadata,*args,**kwargs)\n        data=entity_data;mem=self.mem\n        wrapper=struct.unpack_from(\'<I\',data,0x918)[0] if data else mem.u32(p+0x918)\n        cache=struct.unpack_from(\'<I\',data,0x8d0)[0] if data else mem.u32(p+0x8d0)\n        if not wrapper or not cache:return super().bones(p,origin,entity_data,metadata,*args,**kwargs)\n        studio=mem.u32(wrapper);header=mem.read(studio,180);count=struct.unpack_from(\'<i\',header,156)[0]\n        if not 1<=count<=256:return super().bones(p,origin,entity_data,metadata,*args,**kwargs)\n        blob=mem.read(cache,count*48)\n        sampled_at=time.monotonic()\n        if mem.u32(p+0x918)!=wrapper or mem.u32(wrapper)!=studio or mem.u32(p+0x8d0)!=cache:\n            raise ValueError(\'magic_client_pose_changed\')\n        positions,observed=matrix_cloud(blob,count)\n        supplied=metadata.get(\'_scale_info\',{})\n        scale=max(observed,supplied.get(\'maximum\',1.),metadata.get(\'_geometry_scale\',1.),\n                  metadata.get(\'geometry_body_scale\',1.),metadata.get(\'geometry_head_scale\',1.))\n        envelope=pose_envelope(header,scale)\n        observation=dict(magic_pose=pose_check(origin,positions,envelope),magic_envelope=envelope,\n                         pose_sample_stamp=sampled_at)\n        metadata.update(observation)\n        if hasattr(self,\'_magic_reads\'):self._magic_reads[p]=observation\n        metadata[\'_bone_snapshot\']=blob\n        try:result=super().bones(p,origin,entity_data,metadata,*args,**kwargs)\n        finally:metadata.pop(\'_bone_snapshot\',None)\n        # Geometry and mismatch checks consume the same one-read matrices.\n        # The command callback only consumes prepared coordinates and hitboxes.\n        active=mem.i32(p+0x5e0)\n        set_count,set_offset=struct.unpack_from(\'<ii\',header,172)\n        set_header=mem.read(studio+set_offset+active*12,12) if 0<=active<set_count<=64 else b\'\'\n        model=getattr(self,\'model_cache\',{}).get((studio,header,active,set_header))\n        if model and len(model)>8:\n            samples=[]\n            for key,part,bone,local,radius,priority in model[7]:\n                if not 0<=bone<count or not finite(local):continue\n                box=int(key.split(\':\',1)[0])\n                samples.append(dict(key=f\'{active}:{key}\',part=part,bone=bone,local=list(local),\n                    radius=radius,priority=priority,hitgroup=model[8][box][1],\n                    factor=metadata.get(\'geometry_head_scale_applied\' if part==\'head\' else \'geometry_scale_applied\',1.)))\n            if (mem.u32(p+0x918)==wrapper and mem.u32(wrapper)==studio\n                    and mem.i32(p+0x5e0)==active and mem.read(studio,180)==header):\n                geometry=dict(native_samples=samples,wrapper=hex(wrapper),studio=hex(studio),\n                    hitbox_set=active,model_bones=count,\n                    native_boxes=[dict(bone=b,group=g,bounds=[list(v[:3]),list(v[3:])],\n                        factor=metadata.get(\'geometry_head_scale_applied\' if g==1 else \'geometry_scale_applied\',1.))\n                        for b,g,v in model[8]],\n                    body_scale=metadata.get(\'geometry_body_scale\',1.),\n                    head_scale=metadata.get(\'geometry_head_scale\',1.))\n                observation[\'magic_native_geometry\']=geometry\n                metadata[\'magic_native_geometry\']=geometry\n        return result\n\n\ndef target_feed(frame,diagnostic,now,aim_npcs=True,role=\'client\'):\n    """Publish identities and all current points; native callbacks select foes."""\n    rows=[]\n    for actor in frame.entities:\n        if (not actor.enemy or not target_is_active(actor) or actor.index==frame.local.index\n                or (actor.team==frame.local.team and not frame.free_for_all)\n                or not aim_npcs and entity_kind(actor.classname)==\'npc\'):continue\n        stamp=actor.pose_sample_stamp\n        if not isinstance(stamp,(int,float)) or not 0<=now-stamp<=.180:continue\n        points=[]\n        if role==\'client\':\n            envelope=getattr(actor,\'magic_envelope\',None)\n            points=[p for p in candidate_points(actor) if not getattr(actor,\'magic_pose\',{}).get(\'mismatch\')\n                    and len(p.position)==3 and finite(p.position)\n                    and (envelope is None or point_current(p.position,actor.origin,envelope))\n                    and (not protect_hostages(frame.mode) or hostage_ray_clear(frame,p.position,now=now))]\n            points.sort(key=lambda p:(p.part!=\'head\',p.priority,p.key))\n            if not points and not getattr(actor,\'magic_native_geometry\',{}).get(\'native_samples\'):continue\n        point=points[0] if points else None\n        row=dict(target=actor.index,client_address=actor.address,client_serial=actor.serial,\n                 serial=actor.serial,target_entity_address=hex(actor.address),team=actor.team,\n                 health=actor.health,position=list(point.position) if point else None,pose_stamp=stamp,\n                 geometry_verified=bool(points),point_source=\'client_live_hitboxes\' if points else \'model_definitions_pending_native_pose\',\n                 part=point.part if point else \'\',point_key=point.key if point else \'\',\n                 model=actor.model,classname=actor.classname,native_origin=list(actor.origin),\n                 pose_envelope=getattr(actor,\'magic_envelope\',None),\n                 samples=[dict(position=list(p.position),part=p.part,key=p.key,priority=p.priority) for p in points])\n        if role==\'client\':\n            row.update(getattr(actor,\'magic_native_geometry\',{}))\n            row[\'selection_hitboxes\']=[dict(bounds=box.bounds,origin=box.origin,inverse=box.inverse)\n                for box in getattr(actor,\'aim_hitboxes\',())]\n        rows.append(row)\n    return rows,None\n\n\ndef choose_role(requested,loopback):\n    if loopback is not True and loopback is not False:return None\n    if loopback is True and requested[0]:return \'host\'\n    return \'client\' if requested[1] else None\n\n\ndef status_text(status,requested):\n    if status.get(\'state\') in (\'draining\',\'cleanup_retry\'):return \'魔法子弹：正在停止并恢复方向\'\n    if not any(requested):return \'魔法子弹：关闭\'\n    if status.get(\'active\'):\n        role=\'房主\' if status.get(\'role\')==\'host\' else \'非房主\'\n        if status.get(\'published_targets\',0):return f\'{role}魔法子弹：已开启\'\n        if status.get(\'geometry_rejected\',0):return f\'{role}魔法子弹：等待当前原生命中盒\'\n        return f\'{role}魔法子弹：等待当前有效目标\'\n    return \'魔法子弹：\'+(status.get(\'error\') or \'等待当前对局\')\n\n\ndef build_source(role,config):\n    from magic_bullet_sources import SERVER,CLIENT\n    return (SERVER if role==\'host\' else CLIENT).replace(\'__CONFIG__\',json.dumps(config))\n\n\ndef load_frida():\n    from frida_owner import load_runtime\n    return load_runtime()\n\n\nclass MagicBulletService:\n    def __init__(self,windows=None,clock=time.monotonic):\n        self.win=windows;self.clock=clock;self._lock=threading.Lock();self._wake=threading.Event()\n        self._latest=None;self._revision=0;self._thread=None;self._closing=False\n        self._reader=None;self._session=None;self._script=None;self._frida=None;self._scope=None\n        self._ready=threading.Event();self._role=None;self._draining=False;self._loaded=False\n        self._load_attempted=False\n        self._geometry=None;self._generation=None\n        self._retry_at=0.;self._last_poll=0.;self._processed=-1;self._log_path=None\n        # Native callbacks are high frequency. Keep telemetry off the firing\n        # path: rows are queued and written in bounded batches by the owner\n        # thread instead of opening the log once per callback row.\n        self._event_buffer=[];self._event_flush_at=0.;self._event_flush_rows=128\n        self._event_retry_at=0.;self._event_limit=8192;self._event_dropped=0\n        self._status=dict(state=\'disabled\',active=False,live_confirmation=False)\n        self._pose_skips={};self._feed_summary=None;self._feed_log_at=0.\n        self._client_feed=ClientPoseFeed()\n        self._shot_feed=ClientShotFeed();self._shot_log_at=-math.inf\n        self._client_due=0.;self._population=None;self._population_at=-math.inf\n        self._population_policy=None\n        self._publication_rejection=None;self._publication_log_at=-math.inf\n\n    def _status_update(self,**values):\n        with self._lock:self._status.update(values)\n\n    def diagnostics(self):\n        with self._lock:return copy.deepcopy(self._status)\n\n    def submit(self,reader,frame,cfg,diagnostic,paused=False):\n        requested=(bool(cfg.host_magic_bullet),bool(cfg.client_magic_bullet))\n        if not any(requested):self.pause();return\n        now=self.clock()\n        try:\n            context_lease=CLIENT_CONTROL_LEASE if requested[1] else .150\n            active=(not paused and frame.local.health>0 and 0<=now-frame.stamp<=context_lease\n                    and self.win.foreground(reader.mem.pid) and not reader.game_ui_visible())\n            if not active:self.pause();return\n            request=dict(pid=reader.mem.pid,game=str(reader.game),map=frame.map_name,\n                local=dict(index=frame.local.index,address=frame.local.address,serial=frame.local.serial,team=frame.local.team),\n                eye=list(frame.eye),punch=list(frame.punch),weapon=frame.weapon,ammo=frame.ammo,\n                requested=requested,stamp=now,control_frame_stamp=frame.stamp,aim_npcs=bool(cfg.aim_npcs),\n                mode=frame.mode,enemy_team=cfg.enemy_team)\n        except Exception as error:\n            self.pause();self._status_update(error=str(error));return\n        with self._lock:\n            self._latest=request;self._revision+=1;self._closing=False\n            if self._thread is None or not self._thread.is_alive():\n                # Keep the interpreter/session until native callbacks and\n                # the remote direction restoration have drained on exit.\n                self._thread=threading.Thread(target=self._run,name=\'magic-bullet-native-owner\',daemon=False)\n                self._thread.start()\n        self._wake.set()\n\n    def pause(self):\n        with self._lock:self._latest=None;self._revision+=1\n        self._wake.set()\n\n    def close(self):\n        with self._lock:self._latest=None;self._revision+=1;self._closing=True;thread=self._thread\n        self._wake.set()\n        if thread and thread is not threading.current_thread():thread.join(.6)\n        return not thread or not thread.is_alive()\n\n    def _call(self,fn,timeout=1.):\n        token=self._frida.Cancellable();timer=threading.Timer(timeout,token.cancel);timer.daemon=True;timer.start()\n        try:\n            with token:return fn()\n        finally:timer.cancel()\n\n    def _event(self,kind,**data):\n        if self._log_path is None:\n            from reader import HERE\n            self._log_path=HERE/\'magic_bullet_events.jsonl\'\n        record=dict(kind=kind,wall_time_ms=int(time.time()*1000),**data)\n        if len(self._event_buffer)>=self._event_limit:\n            del self._event_buffer[:self._event_flush_rows]\n            self._event_dropped+=self._event_flush_rows\n            self._status_update(log_dropped=self._event_dropped)\n        self._event_buffer.append(record)\n        now=self.clock()\n        if len(self._event_buffer)>=self._event_flush_rows or now-self._event_flush_at>=.25:\n            self._flush_events()\n\n    def _flush_events(self,force=False):\n        if not self._event_buffer:return\n        now=self.clock()\n        if not force and now<self._event_retry_at:return\n        if not force and len(self._event_buffer)<self._event_flush_rows and now-self._event_flush_at<.25:return\n        batch=self._event_buffer[:];del self._event_buffer[:]\n        try:\n            self._log_path.parent.mkdir(exist_ok=True)\n            if self._log_path.exists() and self._log_path.stat().st_size>8*1024*1024:\n                self._log_path.replace(self._log_path.with_name(\'magic_bullet_events.previous.jsonl\'))\n            payload=\'\'.join(json.dumps(row,ensure_ascii=False,separators=(\',\',\':\'))+\'\\n\' for row in batch)\n            with self._log_path.open(\'a\',encoding=\'utf-8\') as f:f.write(payload)\n            self._event_flush_at=now;self._event_retry_at=0.\n        except OSError as error:\n            # Preserve rows for the next retry; dropping telemetry must never\n            # block or alter the native fire path.\n            self._event_buffer[0:0]=batch;self._event_retry_at=now+1.\n            self._status_update(log_error=str(error))\n\n    def _message(self,message,data):\n        if message.get(\'type\')==\'send\' and message.get(\'payload\',{}).get(\'type\')==\'ready\':self._ready.set()\n        elif message.get(\'type\')==\'error\':\n            self._status_update(error=message.get(\'stack\',message.get(\'description\',\'hook_error\')))\n\n    def _native(self):\n        r=self._reader;m=r.mem;e=r.engine\n        channel=m.u32(e+0x8d21a0);signon=m.i32(e+0x8d22c4)\n        level=m.string(e+0x8d2334,160).replace(\'\\\\\',\'/\')\n        from runtime_compat import native_loopback\n        return dict(channel=hex(channel),signon=signon,map=level,loopback=native_loopback(r),\n                    connected=bool(channel and signon==6 and level))\n\n    def _attach(self,request):\n        self._reader=MagicTargetReader(Path(request[\'game\']));self._reader.attach(pid=request[\'pid\'])\n        native=self._native()\n        if not native[\'connected\'] or native[\'map\']!=request[\'map\']:raise RuntimeError(\'magic_native_session_pending\')\n        self._role=choose_role(request[\'requested\'],native[\'loopback\'])\n        detected=\'host\' if native[\'loopback\'] is True else \'client\' if native[\'loopback\'] is False else \'pending\'\n        self._status_update(detected_role=detected)\n        if self._role is None:\n            raise RuntimeError(\'当前为房主对局，请勾选房主魔法子弹\' if detected==\'host\' else\n                               \'当前为非房主对局，请勾选非房主魔法子弹\')\n        names=(\'engine.dll\',\'server.dll\') if self._role==\'host\' else (\'engine.dll\',\'client.dll\')\n        for name in names:\n            mod=self._reader.mods.get(name)\n            if not mod or hashlib.sha256(Path(mod[2]).read_bytes()).hexdigest()!=HASHES[name]:\n                raise RuntimeError(\'magic_build_mismatch:\'+name)\n        self._frida=load_frida();self._ready.clear()\n        self._session=self._call(lambda:self._frida.attach(request[\'pid\']),3.)\n        self._generation=uuid.uuid4().hex\n        config=dict(enableWrite=True,mapName=request[\'map\'],loopback=native[\'loopback\'],staleMs=180,leaseMs=1200,maxRows=2048,\n                    headApproach=16,entityEntries=hex(self._reader.global_addr(\'entity_entries\')),\n                    viewAngles=hex(self._reader.global_addr(\'view_angles\')),nearbyDegrees=12,\n                    feedbackMs=1500,packetSignature=\'b80c000000e8967b3e00\',\n                    nativeCache=True,weaponTelemetry=self._reader.fields_available(\'m_hActiveWeapon\',\'m_iClip1\'),\n                    generation=self._generation)\n        source=build_source(self._role,config)\n        source_hash=hashlib.sha256(source.encode(\'utf-8\')).hexdigest()\n        self._script=self._session.create_script(source,cleanup=\'magic\');self._script.on(\'message\',self._message)\n        # Cancellation ends the wait, not necessarily the target\'s load.\n        # Retain ownership and request native drain even after a load timeout.\n        self._load_attempted=True\n        self._call(self._script.load,3.);self._loaded=True\n        if not self._ready.wait(1.):raise RuntimeError(\'magic_hook_handshake_timeout\')\n        # Revalidate with the installed native adapter; attachment is readiness,\n        # not evidence of damage or a reason to alter normal shooting.\n        state=self._call(self._script.exports_sync.state)\n        if (not state[\'connected\'] or state[\'map\']!=request[\'map\'] or\n                choose_role(request[\'requested\'],state[\'loopback\'])!=self._role):\n            raise RuntimeError(\'magic_session_changed_during_attach\')\n        self._scope=(request[\'pid\'],request[\'map\'],state[\'channel\'],request[\'local\'][\'index\'],request[\'local\'][\'serial\'],state[\'loopback\'])\n        self._draining=False;self._processed=-1\n        self._status_update(state=\'ready\',active=True,role=self._role,pid=request[\'pid\'],error=\'\',\n                            input_or_binding_changes=False,disk_dll_patch=False)\n        self._event(\'hook_ready\',role=self._role,pid=request[\'pid\'],scope=self._scope,generation=self._generation,\n                    source_sha256=source_hash,shot_log_schema=2 if self._role==\'client\' else 1,\n                    build=\'2026.10.07-magic-probe-ray-priority\',\n                    client_final_ray_observed=False,client_spread_observed=False)\n\n    def _host_geometry(self,mapped,item):\n        """Publish SERVER model-local definitions, not a background pose cache.\n\n        The native firing thread prepares and projects the current cache. A\n        missing background cache must not remove an otherwise valid identity.\n        """\n        from server_esp import ServerDisplayReader\n        if self._geometry is None:\n            r=self._reader;s=ServerDisplayReader(r.game)\n            s.mods=dict(r.mods);s.mem=r.mem;s.client=r.client;s.engine=r.engine\n            s.resolved=dict(r.resolved);s.bind();s.control_geometry=True\n            self._geometry=s\n        s=self._geometry;m=s.mem;address=int(mapped[\'address\'],16)\n        before=m.read(s.base+0xa5fa44+mapped[\'index\']*16,8)\n        if before!=struct.pack(\'<II\',address,mapped[\'serial\']):return None\n        data=m.read(address,0x2144 if item[\'classname\']==\'CCSPlayer\' else 0x478)\n        origin=struct.unpack_from(\'<3f\',data,0x28c)\n        wrapper=struct.unpack_from(\'<I\',data,0x474)[0];active=struct.unpack_from(\'<i\',data,0x378)[0]\n        if not wrapper or not finite(origin):return None\n        studio=m.u32(wrapper);model=s.model(studio,active)\n        if not 1<=model[0]<=128:return None\n        if model[3].replace(\'\\\\\',\'/\').lower().removeprefix(\'models/\')!=item[\'model\'].replace(\'\\\\\',\'/\').lower().removeprefix(\'models/\'):\n            return None\n        from scale_geometry import server_scale_info\n        scale=server_scale_info(data,getattr(s,\'scale_fields_verified\',False))[\'maximum\']\n        envelope=pose_envelope(m.read(studio,180),scale)\n        samples=[]\n        for key,part,bone,local,radius,priority in model[6]:\n            if not 0<=bone<model[0] or not finite(local):continue\n            samples.append(dict(key=f\'{active}:{key}\',part=part,bone=bone,local=list(local),\n                                radius=radius,priority=priority))\n        if (not samples or m.read(s.base+0xa5fa44+mapped[\'index\']*16,8)!=before\n                or m.u32(address+0x474)!=wrapper or m.u32(wrapper)!=studio\n                or m.i32(address+0x378)!=active or m.read(address+0x28c,12)!=data[0x28c:0x298]):return None\n        samples.sort(key=lambda p:(p[\'part\']!=\'head\',\n                                   not p[\'key\'].endswith(\':c\'),p[\'priority\']))\n        return dict(position=None,native_samples=samples,native_origin=list(origin),\n                    wrapper=hex(wrapper),studio=hex(studio),hitbox_set=active,model_bones=model[0],\n                    head_source=\'server_native_hitbox\',point_source=\'server_model_definitions\',\n                    pose_stamp=self.clock(),pose_envelope=envelope,geometry_verified=False)\n\n    def _pose_state(self,source,identity,check):\n        key=(source,identity[\'index\'],identity[\'address\'],identity[\'serial\']);now=self.clock()\n        previous=self._pose_skips.get(key)\n        if check.get(\'mismatch\'):\n            if previous is None or now-previous>=2.:\n                self._pose_skips[key]=now\n                self._event(\'pose_mismatch_skip\',source=source,identity=identity,pose=check)\n        elif previous is not None and check.get(\'valid\',0)>0:\n            self._pose_skips.pop(key,None)\n            self._event(\'pose_mismatch_recovered\',source=source,identity=identity,pose=check)\n        if len(self._pose_skips)>512:self._pose_skips={k:v for k,v in self._pose_skips.items() if now-v<30.}\n\n    def _collect(self,request):\n        began=self.clock();cached=self._population\n        # Reuse only population metadata between scans. Selected actors are\n        # read again below, with original pose times and live native identity,\n        # life/model checks. Local view/weapon state is refreshed EVERY round.\n        reuse=(self._role==\'client\' and cached is not None\n               and 0<=began-self._population_at<CLIENT_POPULATION_INTERVAL\n               and not protect_hostages(cached.mode) and cached.mode==request[\'mode\']\n               and self._population_policy==(request[\'enemy_team\'],request[\'aim_npcs\']))\n        frame=self._reader.frame(request[\'mode\'],request[\'enemy_team\'],with_bones=False,\n                                 with_aimpoints=False,observe_inactive=True,local_only=reuse)\n        scope=(frame.map_name,frame.local.index,frame.local.address,frame.local.serial)\n        expected=(request[\'map\'],request[\'local\'][\'index\'],request[\'local\'][\'address\'],request[\'local\'][\'serial\'])\n        if scope!=expected:\n            raise RuntimeError(\'magic_sample_scope_changed\')\n        if reuse and (frame.map_name,frame.local.index,frame.local.address,frame.local.serial,\n                      frame.local.team,frame.mode,frame.free_for_all)!=(cached.map_name,cached.local.index,\n                      cached.local.address,cached.local.serial,cached.local.team,cached.mode,cached.free_for_all):\n            self._population=None\n            return self._collect(request)\n        if reuse:\n            frame=copy.copy(frame);frame.entities=cached.entities\n        elif self._role==\'client\':\n            self._population=copy.copy(frame);self._population_at=self.clock()\n            self._population_policy=(request[\'enemy_team\'],request[\'aim_npcs\'])\n        population_ms=round((self.clock()-began)*1000,3)\n        if self._role==\'client\':\n            frame=self._client_feed.sample(self._reader,frame,request,self.clock)\n            self._client_feed.metrics.update(population_ms=population_ms,population_reused=reuse)\n            for actor in frame.entities:\n                check=getattr(actor,\'magic_pose\',{})\n                self._pose_state(\'client\',dict(index=actor.index,address=hex(actor.address),serial=actor.serial),check)\n        rows,_=target_feed(frame,{},self.clock(),request[\'aim_npcs\'],self._role)\n        return frame,rows\n\n    def _map_host(self,identity):\n        m=self._reader.mem;s=self._reader.mods[\'server.dll\'][0]\n        entry=s+0xa5fa44+identity[\'index\']*16;before=m.read(entry,8)\n        address,serial=struct.unpack(\'<II\',before)\n        if not address or serial&0x3ff!=identity[\'serial\']&0x3ff:return None\n        if m.i32(address+0xf4)<=0 or m.read(address+0xf8,1)!=b\'\\0\':return None\n        team=m.read(address+0x201,1)[0]\n        if team!=identity[\'team\'] or m.read(entry,8)!=before:return None\n        return dict(index=identity[\'index\'],address=hex(address),serial=serial,team=team)\n\n    def _payload(self,request,native):\n        if (request[\'pid\']!=self._reader.mem.pid or not native[\'connected\'] or\n                request[\'map\']!=native[\'map\'] or choose_role(request[\'requested\'],native[\'loopback\'])!=self._role):\n            raise RuntimeError(\'magic_native_scope_changed\')\n        began=self.clock();sampled,items=self._collect(request)\n        local=dict(request[\'local\']);rows=[];geometry_rejected=0;rejections={}\n        def reject(reason):rejections[reason]=rejections.get(reason,0)+1\n        # Check CLIENT identity before translating any SERVER serial. The two\n        # pointer domains are never interchangeable, even for the same index.\n        entry=self._reader.global_addr(\'entity_entries\')+local[\'index\']*16\n        if self._reader.mem.read(entry,8)!=struct.pack(\'<II\',local[\'address\'],local[\'serial\']):\n            raise RuntimeError(\'magic_local_identity_changed\')\n        if self._role==\'host\':\n            local=self._map_host(local)\n            if local is None:raise RuntimeError(\'magic_server_local_identity_pending\')\n        else:local[\'address\']=hex(local[\'address\'])\n        for item in items:\n            try:\n                if not 0<=self.clock()-item[\'pose_stamp\']<=.180:reject(\'sample_expired\');continue\n                index=item[\'target\'];entry=self._reader.global_addr(\'entity_entries\')+index*16\n                if self._reader.mem.read(entry,8)!=struct.pack(\'<II\',item[\'client_address\'],item[\'client_serial\']):reject(\'client_identity_changed\');continue\n                row=dict(item)\n                if self._role==\'host\':\n                    mapped=self._map_host(dict(index=index,address=item[\'client_address\'],serial=item[\'client_serial\'],team=item[\'team\']))\n                    if mapped is None:reject(\'server_identity_pending\');continue\n                    row.update(serial=mapped[\'serial\'],target_entity_address=mapped[\'address\'])\n                    try:geometry=self._host_geometry(mapped,item)\n                    except (RuntimeError,OSError,ValueError,struct.error) as error:\n                        geometry_rejected+=1;reject(str(error));self._status_update(geometry_error=str(error));continue\n                    if geometry is None:ge