al(event[\'direct_head_classification\'][\'outcome\'],\'first_request_head_kill\')\n    finally:a.close()\n  def test_close_flushes_readable_summary(self):\n   with tempfile.TemporaryDirectory() as tmp:\n    a=AccuracyLedger(tmp);a.record(\'m\',shot());a.close()\n    s=json.loads((Path(tmp)/\'summary.json\').read_text(\'utf8\'))\n    self.assertEqual(s[\'weapons\'][\'usp\'][\'rounds\'],1)\n    self.assertEqual(s[\'weapons\'][\'usp\'][\'observations_without_unique_damage_link\'],1)\n    self.assertIsNone(s[\'weapons\'][\'usp\'][\'head_percent_of_known_damage\'])\n  def test_unlinked_first_round_remains_in_observation_denominator(self):\n   with tempfile.TemporaryDirectory() as tmp:\n    a=AccuracyLedger(tmp)\n    for n in (1,2):\n     q=shot(n,t=10.+n)\n     q[\'prior_aim\'].update(fire_snapshot={\'path\':\'clear\',\'part\':\'head\'},fire_commit={\'first_request\':True})\n     a.record(\'m\',q)\n    a.record(\'m\',damage(2,t=12.01,amount=120,health=0))\n    a.record(\'m\',damage(3,t=12.02,amount=120,health=0))\n    a.close()\n    # Exercise serialization as well as the in-memory counters. Two damage\n    # records associated with one round never create two successful rounds.\n    s=json.loads((Path(tmp)/\'summary.json\').read_text(\'utf8\'))[\'weapons\'][\'usp\']\n    self.assertEqual(s[\'precision_first_observations_v2\'],2)\n    self.assertEqual(s[\'precision_first_linked_v2\'],1)\n    self.assertEqual(s[\'precision_first_unknown_observations_v2\'],1)\n    self.assertEqual(s[\'precision_first_head_zero_health_v2\'],1)\n    self.assertEqual(s[\'precision_first_context_head_zero_health_percent_v2\'],50.)\n    self.assertIsNone(s[\'direct_head_first_request_kill_rate\'])\n    self.assertIsNone(s[\'bullet_hit_rate\'])\n  def test_legacy_conditional_share_is_not_a_shot_success_rate(self):\n   s=AccuracyLedger.metrics(dict(direct_head_first_request_attempts=10,direct_head_first_request_kills=10))\n   self.assertEqual(s[\'first_request_head_zero_health_share_of_linked_damage\'],100.)\n   self.assertIsNone(s[\'direct_head_first_request_kill_rate\'])\n   self.assertIsNone(s[\'precision_first_context_head_zero_health_percent_v2\'])\n  def test_followups_keep_head_body_survival_and_unknown_separate(self):\n   with tempfile.TemporaryDirectory() as tmp:\n    a=AccuracyLedger(tmp)\n    for n,(first,group,health) in enumerate(((True,\'head\',0),(False,\'head\',2),(False,\'chest\',76),(False,None,None)),1):\n     q=shot(n,t=10.+n)\n     q[\'prior_aim\'].update(fire_snapshot={\'path\':\'clear\',\'part\':\'head\'},fire_commit={\'first_request\':first})\n     a.record(\'m\',q)\n     if group:a.record(\'m\',damage(n,t=10.+n+.01,group=group,health=health))\n    a.close()\n    s=json.loads((Path(tmp)/\'summary.json\').read_text(\'utf8\'))[\'weapons\'][\'usp\']\n    self.assertEqual(s[\'precision_first_evidence_v2\'][\'head_zero_health\'],1)\n    self.assertEqual(s[\'precision_followup_evidence_v2\'],\n        dict(observations=3,linked=2,head_hits=1,body_hits=1,head_zero_health=0,head_survived=1,unknown=1))\n  def test_archive_keeps_actual_timing_and_motion_attribution_fields(self):\n   from weapon_accuracy import compact_context\n   q=shot();q[\'prior_aim\'].update(\n    fire_decision_stamp=9.99,firing_punch=(1.,0.,0.),firing_eye_xyz=(0.,0.,64.),\n    fire_cadence=dict(interval=.28045,effective_interval=.28045,configured_interval=.28045,\n                     interval_basis=\'configured_precision_recovery_small_head\',recovery_reference_at=9.7,next_press_at=9.98045),\n    head_motion=dict(active=False,prediction_fallback=True,reason=\'prediction_consistency_low\'),\n    fire_snapshot=dict(stamp=10.,pose_stamp=9.998,eye=(0.,0.,64.),angles=(0.,0.,0.),punch=(1.,0.,0.)))\n   ctx=compact_context(q)\n   self.assertEqual(ctx[\'fire_cadence\'][\'effective_interval\'],.28045)\n   self.assertEqual(ctx[\'fire_snapshot\'][\'stamp\'],10.)\n   self.assertEqual(ctx[\'firing_punch\'],[1.,0.,0.])\n   self.assertTrue(ctx[\'head_motion\'][\'prediction_fallback\'])\n  def test_burst_and_rapid_fire_remain_ambiguous(self):\n   with tempfile.TemporaryDirectory() as tmp:\n    a=AccuracyLedger(tmp)\n    try:\n     a.record(\'m\',shot(rounds=2));a.record(\'m\',damage())\n     a.record(\'m\',shot(2,11.));a.record(\'m\',shot(3,11.1));a.record(\'m\',damage(2,11.15))\n     self.assertEqual(a.snapshot()[\'weapons\'][\'usp\'][\'ambiguous_events\'],2)\n     self.assertEqual(a.db.execute(\'SELECT COUNT(*) FROM events WHERE shot_id IS NOT NULL\').fetchone()[0],0)\n    finally:a.close()\n  def test_weapon_victim_and_session_mismatches_do_not_associate(self):\n   for field in (\'weapon\',\'victim\',\'session\'):\n    with tempfile.TemporaryDirectory() as tmp:\n     a=AccuracyLedger(tmp)\n     try:\n      a.record(\'m\',shot());d=damage(weapon=\'m4a1\' if field==\'weapon\' else \'usp\',target=8 if field==\'victim\' else 7)\n      a.record(\'other\' if field==\'session\' else \'m\',d)\n      got=a.db.execute("SELECT association,model FROM events WHERE kind=\'confirmed_damage\'").fetchone()\n      self.assertEqual(got,(\'none\',None))\n     finally:a.close()\n  def test_pellet_or_penetration_damage_does_not_invent_hit_probability(self):\n   with tempfile.TemporaryDirectory() as tmp:\n    a=AccuracyLedger(tmp)\n    try:\n     a.record(\'m\',shot(weapon=\'m3\'));a.record(\'m\',damage(weapon=\'m3\'))\n     a.record(\'m\',damage(2,10.06,weapon=\'m3\',group=\'chest\'))\n     s=a.snapshot()[\'weapons\'][\'m3\'];self.assertEqual(s[\'rounds\'],1);self.assertEqual(s[\'damage_events\'],2)\n     self.assertEqual(s[\'head_percent_of_known_damage\'],50);self.assertIsNone(s[\'bullet_hit_rate\'])\n    finally:a.close()\n  def test_generic_and_unknown_do_not_lower_known_head_share(self):\n   with tempfile.TemporaryDirectory() as tmp:\n    a=AccuracyLedger(tmp)\n    try:\n     for n,group in enumerate((\'head\',\'head\',\'chest\',\'generic\',\'unknown\')):a.record(\'m\',damage(n,t=n,group=group))\n     s=a.snapshot()[\'weapons\'][\'usp\'];self.assertAlmostEqual(s[\'head_percent_of_known_damage\'],66.6667)\n     self.assertEqual(s[\'generic_events\'],1);self.assertEqual(s[\'unknown_events\'],1)\n    finally:a.close()\n  def test_sampled_models_and_versions_remain_separate(self):\n   with tempfile.TemporaryDirectory() as tmp:\n    a=AccuracyLedger(tmp)\n    try:\n     a.record(\'m\',shot());a.record(\'m\',damage())\n     second=shot(2,11.);second[\'prior_aim\'].update(model=\'player/ct_test/ct_test.mdl\',build=\'fixture2\',target_distance=1200.)\n     a.record(\'m\',second);a.record(\'m\',damage(2,11.1,amount=80))\n     rows=a.snapshot()[\'by_model_distance\'];self.assertEqual(len(rows),2)\n     self.assertEqual({r[\'distance_band\'] for r in rows},{\'256-511\',\'1024-2047\'})\n    finally:a.close()\n  def test_evidence_continues_after_match_budget_exhaustion(self):\n   with tempfile.TemporaryDirectory() as tmp:\n    log=BattleLog(tmp,set(),rotate_bytes=4096);f,_=weapon_frame();log._start(f);match=log.current[\'id\']\n    try:\n     for n in range(250):\n      log.event(\'ammo_decreased\',**{k:v for k,v in shot(n,t=10.+n).items() if k!=\'kind\'})\n      log.event(\'confirmed_damage\',**{k:v for k,v in damage(n,t=10.+n+.05).items() if k!=\'kind\'})\n     log.queue.join()\n    finally:log.close()\n    self.assertFalse(log.accuracy_error,log.accuracy_error)\n    db=sqlite3.connect(Path(tmp)/\'weapon_accuracy\'/\'weapon_accuracy.sqlite3\')\n    try:self.assertEqual(db.execute(\'SELECT COUNT(*) FROM events\').fetchone()[0],500)\n    finally:db.close()\n    self.assertLessEqual((Path(tmp)/(match+\'.jsonl\')).stat().st_size,4096)\n    summary=json.loads((Path(tmp)/\'weapon_accuracy\'/\'summary.json\').read_text(\'utf8\'))\n    self.assertEqual(summary[\'weapons\'][\'usp\'][\'rounds\'],250)\n  def test_quality_gaps_are_visible(self):\n   with tempfile.TemporaryDirectory() as tmp:\n    a=AccuracyLedger(tmp)\n    try:\n     a.record(\'m\',shot());a.quality(\'m\',dict(dropped_log_records=3,damage_log_dropped_records=2,finished=True))\n     self.assertEqual(a.snapshot()[\'source_quality\'][\'diagnostic_queue_dropped\'],3)\n     self.assertEqual(a.snapshot()[\'source_quality\'][\'damage_sink_dropped\'],2)\n    finally:a.close()\n  def test_lifetime_quality_counters_are_not_counted_twice_across_matches(self):\n   with tempfile.TemporaryDirectory() as tmp:\n    a=AccuracyLedger(tmp)\n    try:\n     for m in (\'one\',\'two\'):\n      a.record(m,shot())\n      a.quality(m,dict(logger_id=\'one_logger\',dropped_log_records=3,damage_log_dropped_records=2,\n       weapon_accuracy_archive=dict(failed_operations=1,last_error=\'fixture io error\'),\n       log_process=dict(transport_id=\'one_parent\',dropped_messages=4,unacknowledged_on_exit=5)))\n     s=a.snapshot()[\'source_quality\']\n     self.assertEqual((s[\'diagnostic_queue_dropped\'],s[\'damage_sink_dropped\'],s[\'archive_failed_operations\'],\n                      s[\'transport_dropped_messages\'],s[\'transport_unacknowledged\']),(3,2,1,4,5))\n     self.assertEqual(s[\'errors\'],[\'fixture io error\'])\n    finally:a.close()\n  def test_unlinked_count_only_decrements_once_per_ammo_observation(self):\n   with tempfile.TemporaryDirectory() as tmp:\n    a=AccuracyLedger(tmp)\n    try:\n     a.record(\'m\',shot());a.record(\'m\',damage());a.record(\'m\',damage(2,t=10.06))\n     a.record(\'m\',shot(2,t=11.))\n     self.assertEqual(a.snapshot()[\'weapons\'][\'usp\'][\'observations_without_unique_damage_link\'],1)\n     queries=[];a.db.set_trace_callback(queries.append);a.snapshot()\n     self.assertFalse(any(\'FROM events\' in q for q in queries))\n    finally:a.close()\n  def test_full_profile_and_old_percentage_denominator_are_preserved(self):\n   with tempfile.TemporaryDirectory() as tmp:\n    a=AccuracyLedger(tmp)\n    try:\n     profile={str(i):i for i in range(80)}\n     a.record(\'m\',dict(kind=\'weapon_profile\',weapon=\'usp\',parameters=profile))\n     self.assertEqual(json.loads(a.db.execute(\'SELECT parameters FROM profiles\').fetchone()[0]),profile)\n     a.record(\'m\',shot());a.record(\'m\',damage());a.record(\'m\',damage(2,group=\'generic\'))\n     s=a.snapshot()[\'weapons\'][\'usp\']\n     self.assertEqual(s[\'head_percent_of_known_damage\'],100)\n     self.assertEqual(s[\'head_percent_of_all_damage\'],50)\n     data=json.loads(a.db.execute("SELECT data FROM events WHERE kind=\'ammo_decreased\'").fetchone()[0])\n     self.assertTrue(data[\'script_profile_hash\'])\n    finally:a.close()\n  def test_archive_write_failure_survives_later_success(self):\n   with tempfile.TemporaryDirectory() as tmp:\n    log=BattleLog(tmp,set());f,_=weapon_frame();log._start(f);log.queue.join()\n    original=AccuracyLedger.record\n    def fail(a,match,row):\n     if row.get(\'kind\')==\'ammo_decreased\':raise OSError(\'fixture disk error\')\n     return original(a,match,row)\n    try:\n     with patch.object(AccuracyLedger,\'record\',fail):\n      log.event(\'ammo_decreased\',**{k:v for k,v in shot().items() if k!=\'kind\'});log.queue.join()\n     log.event(\'confirmed_damage\',**{k:v for k,v in damage().items() if k!=\'kind\'});log.queue.join()\n     self.assertFalse(log.accuracy_error)\n     self.assertEqual(log.accuracy_failures,1);self.assertIn(\'fixture disk error\',log.accuracy_last_error)\n    finally:log.close()\n    s=json.loads((Path(tmp)/\'weapon_accuracy\'/\'summary.json\').read_text(\'utf8\'))\n    self.assertEqual(s[\'source_quality\'][\'archive_failed_operations\'],1)\n    self.assertTrue(s[\'source_quality\'][\'errors\'])\n out=io.StringIO();r=unittest.TextTestRunner(stream=out,verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(Tests))\n if not r.wasSuccessful():raise AssertionError(out.getvalue())\n return dict(passed=True,tests=r.testsRun,game_attached=False,game_input=False,\n             persistent_sqlite=True,live_bullet_hit_rate_verified=False)\n')

_EMBEDDED['precision_timing_contract'] = (1, '"""Weapon-specific cycle and input-edge regressions; no live accuracy claim."""\nimport io,math,unittest\n\ndef run():\n from click_cadence import click_schedule\n def policy(**kw):\n  p=dict(cycle=.15,interval=.28045,controlled=True,direct=True,eligible_geometry=True,automatic=False,\n   head_recovery_hold=True,policy=\'precision\',burst_limit=1);p.update(kw);return p\n class Tests(unittest.TestCase):\n  def test_pistol_recovery_estimate_does_not_delay_input(self):\n   q=click_schedule(policy(controlled=False,direct_precision_hold=True),\n       dict(last_request=10.,last_shot=10.02),10.20,False,10.)\n   self.assertTrue(q[\'ready\'])\n   self.assertAlmostEqual(q[\'effective_interval\'],.15)\n   self.assertEqual(q[\'interval\'],q[\'effective_interval\'])\n   self.assertAlmostEqual(q[\'next_press_at\'],10.15)\n   self.assertAlmostEqual(q[\'configured_interval\'],.28045)\n   self.assertTrue(q[\'removed_estimated_recovery\'])\n\n  def test_geometry_discount_is_bounded_and_preserves_native_floor(self):\n   from weapon_cadence import WeaponCadence\n   from types import SimpleNamespace as NS\n   from combat36_contract import USP\n   cadence=WeaponCadence()\n   cadence.current=(\'fixture\',)\n   cadence.records[cadence.current]=dict(identity_verified=True,last_shot=None,\n       sequence_shots=0,shots_in_press=0,last_request=None)\n   frame=NS(eye=(0.,0.,64.),local=NS(flags=1,velocity=(0.,0.,0.)))\n   target=NS(head=(400.,0.,64.),health=100,head_radius=5.4,visibility=\'visible\',\n       aim_part=\'head\',model=\'fixture\',aim_points_validated=True)\n   low_increment=dict(USP,InaccuracyFire=.0001)\n   result=cadence.assess(low_increment,frame,target,dict(kind=\'clear\',allowed=True),10.,-math.inf,\n                         alignment_error=0.)\n   self.assertGreaterEqual(result[\'interval\'],result[\'cycle\'])\n   self.assertLessEqual(result[\'interval\'],result[\'recovery\'])\n   self.assertTrue(result[\'direct_precision_hold\'])\n   self.assertGreater(result[\'precision_geometry_discount\'],0.)\n   self.assertLess(result[\'interval\'],result[\'recovery\'])\n   target.head_radius=3.\n   small=cadence.assess(low_increment,frame,target,dict(kind=\'clear\',allowed=True),10.,-math.inf,\n                        alignment_error=0.)\n   self.assertEqual(small[\'precision_geometry_discount\'],0.)\n   self.assertAlmostEqual(small[\'estimated_policy_interval\'],small[\'recovery\'])\n   self.assertAlmostEqual(small[\'interval\'],small[\'cycle\'])\n   target.head_radius=5.4\n   tight_model=cadence.assess(USP,frame,target,dict(kind=\'clear\',allowed=True),10.,-math.inf,\n                              alignment_error=0.)\n   self.assertAlmostEqual(tight_model[\'estimated_policy_interval\'],tight_model[\'recovery\'])\n   self.assertAlmostEqual(tight_model[\'interval\'],tight_model[\'cycle\'])\n\n  def test_switching_target_keeps_tracking_and_weapon_specific_cycle(self):\n   from head_motion_contract import native_motion_scene,move_pose\n   from combat36_contract import USP\n   from combat37_contract import XT97\n   for profile in (USP,XT97):\n    f=native_motion_scene(profile,velocity=(0.,0.,0.))\n    f.advance(10.);self.assertTrue(f.control.pressed)\n    move_pose(f,(550.,0.,64.),10.02);f.advance(10.02,True)\n    f.reader.entity.serial+=1\n    for portion in (.25,.5,.75):\n     t=10.+profile[\'CycleTime\']*portion\n     move_pose(f,(550.,(t-10.)*100.,64.),t)\n     before=len(f.reader.writes);d=f.advance(t)\n     self.assertGreater(len(f.reader.writes),before)\n     self.assertFalse(f.control.pressed,d)\n    t=10.+profile[\'CycleTime\']+.001\n    move_pose(f,(550.,(t-10.)*100.,64.),t);d=f.advance(t)\n    self.assertTrue(f.control.pressed,d)\n    self.assertEqual([v for a,v in f.native_writes if a==0x90000],[3,4,3])\n\n  def test_delayed_ammo_observation_does_not_add_a_second_cycle(self):\n   r=dict(last_request=10.,last_shot=10.05,press_at=10.,shots_in_press=1)\n   early=click_schedule(policy(),r,10.149,False,10.,10.055)\n   due=click_schedule(policy(),r,10.151,False,10.,10.055)\n   self.assertFalse(early[\'ready\']);self.assertTrue(due[\'ready\'])\n   self.assertAlmostEqual(early[\'wait_ms\'],1.);self.assertFalse(early[\'observation_recovery_hold\'])\n  def test_all_weapon_families_use_own_cycle_not_estimated_recovery(self):\n   for family,cycle in [(\'pistol\',.15),(\'rifle\',.08),(\'smg\',.065),(\'machinegun\',.1),(\'sniper\',1.),(\'shotgun\',.8)]:\n    for delay in (.001,.025,.050,.10):\n     for flag in (\'head_recovery_hold\',\'direct_precision_hold\'):\n      p=policy(weapon_type=family,cycle=cycle,interval=max(cycle,.28),automatic=family in (\'rifle\',\'smg\',\'machinegun\'))\n      p[\'head_recovery_hold\']=False;p[flag]=True\n      r=dict(last_request=10.,last_shot=10.+delay)\n      q=click_schedule(p,r,10.+cycle+.001,False,10.)\n      self.assertTrue(q[\'ready\'],(family,delay,flag))\n      self.assertAlmostEqual(q[\'effective_interval\'],cycle)\n      self.assertEqual(q[\'interval_basis\'],\'native_weapon_cycle\')\n  def test_native_cycle_only_policy_is_unchanged(self):\n   q=click_schedule(policy(head_recovery_hold=False),dict(last_shot=10.05),10.15,False,10.)\n   self.assertTrue(q[\'ready\']);self.assertFalse(q[\'observation_recovery_hold\'])\n  def test_no_observation_does_not_invent_first_shot_delay(self):\n   q=click_schedule(policy(),{},10.,False,-math.inf)\n   self.assertTrue(q[\'ready\']);self.assertIsNone(q[\'recovery_reference_at\'])\n  def test_invalid_or_future_observation_not_used(self):\n   for t in (float(\'nan\'),float(\'inf\'),10.9,-1.,True,\'10\'):\n    q=click_schedule(policy(),dict(last_shot=t),10.28045,False,10.)\n    self.assertTrue(q[\'ready\']);self.assertFalse(q[\'observation_recovery_hold\'])\n  def test_newer_request_still_wins(self):\n   q=click_schedule(policy(),dict(last_shot=9.9),10.28045,False,10.)\n   self.assertTrue(q[\'ready\']);self.assertEqual(q[\'recovery_reference_at\'],10.)\n  def test_release_edge_still_required(self):\n   q=click_schedule(policy(),dict(last_shot=10.05),10.33045,False,10.,10.330)\n   self.assertFalse(q[\'ready\']);self.assertGreater(q[\'next_press_at\'],10.333)\n  def test_actual_clip_confirmation_still_releases_owned_press(self):\n   q=click_schedule(policy(),dict(last_request=10.,last_shot=10.03,press_at=10.,shots_in_press=1),10.031,True,10.)\n   self.assertTrue(q[\'release\']);self.assertFalse(q[\'ready\']);self.assertEqual(q[\'release_reason\'],\'clip_confirmed\')\n output=io.StringIO();r=unittest.TextTestRunner(stream=output,verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(Tests))\n if not r.wasSuccessful():raise AssertionError(output.getvalue())\n return dict(passed=True,tests=r.testsRun,family_delay_flag_cases=48,game_attached=False,game_input=False,live_accuracy_verified=False)\n')

_EMBEDDED['head_intent_contract'] = (1, '"""Head intent at actor selection, pose refresh and DOWN; mocked input only."""\nimport copy,io,unittest\nfrom dataclasses import replace\nfrom unittest.mock import patch\nfrom combat37_contract import scene,tick,USP\nimport aim_points\nfrom aim_points import requires_head_intent\nfrom geometry import aim_angles,angle_error\n\n\ndef pending_scene(state=\'unknown\',distance=128.,generic=False):\n    f=scene(p=USP,generic=generic,distance=distance);refresh=f.wall.refresh_target\n    mode=[state]\n    def update(frame,e,weapon,*args,**kw):\n        refresh(frame,e,weapon,*args,**kw)\n        for p in e.aim_points:\n            if p.part==\'head\' and mode[0]!=\'clear\':\n                p.visibility=mode[0];p.penetration={};p.penetrable=False\n                if mode[0]==\'blocked\':p.penetration=dict(kind=\'blocked\',allowed=False)\n    f.wall.refresh_target=update;f.mode=mode;update(f.frame,f.reader.entity,f.weapon)\n    return f\n\n\ndef run():\n    class Tests(unittest.TestCase):\n        def test_body_only_exposure_still_fires_separately(self):\n            for state in (\'unknown\',\'blocked\'):\n                f=pending_scene(state);d=tick(f,10.)\n                self.assertEqual(f.control.target,2);self.assertIn(True,f.inputs.events)\n                self.assertNotEqual(d[\'aim_part\'],\'head\');self.assertTrue(d[\'head_intent\'][\'body_fire\'])\n\n        def test_visible_head_replaces_body_on_next_pose(self):\n            f=pending_scene();tick(f,10.);self.assertTrue(f.control.pressed);f.mode[0]=\'clear\'\n            f.wall.refresh_target(f.frame,f.reader.entity,f.weapon)\n            d=tick(f,10.01);self.assertEqual(d[\'aim_part\'],\'head\')\n            self.assertLess(angle_error(f.reader.angles,aim_angles(f.frame.eye,f.reader.entity.head)),1e-6)\n\n        def test_missing_head_preserves_body(self):\n            f=pending_scene();f.reader.entity.aim_points=[p for p in f.reader.entity.aim_points if p.part!=\'head\']\n            d=tick(f,10.);self.assertEqual(f.control.target,2)\n            self.assertIn(True,f.inputs.events);self.assertNotEqual(d[\'aim_part\'],\'head\')\n\n        def test_visible_actor_beats_wall_enemy(self):\n            f=pending_scene(distance=800.);hidden=copy.deepcopy(f.reader.entity)\n            hidden.index=3;hidden.serial=3;hidden.address=0x30000\n            for p in hidden.aim_points:\n                p.visibility=\'blocked\';p.penetrable=True;p.penetration=dict(kind=\'penetration\',allowed=True)\n            f.frame.entities.append(hidden);f.cfg.strategy=\'准星最近\'\n            d=tick(f,10.);self.assertEqual(f.control.target,2,d);self.assertIn(True,f.inputs.events)\n\n        def test_direct_head_edge_is_hard_priority_over_body_and_wall(self):\n            f=pending_scene(\'clear\',distance=550.);e=f.reader.entity\n            for p in e.aim_points:\n                if p.part==\'head\':\n                    p.visibility=\'visible\';p.penetration={\'kind\':\'clear\',\'allowed\':True}\n                else:\n                    p.visibility=\'visible\';p.penetration={\'kind\':\'clear\',\'allowed\':True}\n            hidden=copy.deepcopy(e);hidden.index=3;hidden.serial=3;hidden.address=0x30000\n            for p in hidden.aim_points:\n                p.visibility=\'blocked\';p.penetration={\'kind\':\'penetration\',\'allowed\':True}\n            f.frame.entities.append(hidden)\n            selected=aim_points.select_aim_view(f.frame,e,USP,10.,allow_penetration=True)\n            self.assertEqual(selected.aim_part,\'head\',selected)\n            self.assertEqual(selected.visibility,\'visible\',selected)\n            self.assertNotIn(selected.aim_id,(\'\',None))\n\n        def test_stationary_direct_body_is_fallback_only_without_head(self):\n            f=pending_scene(\'blocked\',distance=550.);e=f.reader.entity;e.velocity=(0.,0.,0.)\n            for p in e.aim_points:\n                if p.part!=\'head\':\n                    p.visibility=\'visible\';p.penetration={\'kind\':\'clear\',\'allowed\':True}\n            selected=aim_points.select_aim_view(f.frame,e,USP,10.,allow_penetration=True)\n            self.assertNotEqual(selected.aim_part,\'head\',selected)\n            self.assertEqual(selected.visibility,\'visible\',selected)\n\n        def test_head_edge_beats_body_even_when_center_is_blocked(self):\n            f=pending_scene(\'blocked\',distance=550.);e=f.reader.entity\n            heads=[p for p in e.aim_points if p.part==\'head\']\n            self.assertTrue(heads)\n            heads[0].visibility=\'visible\';heads[0].penetration={\'kind\':\'clear\',\'allowed\':True}\n            for p in e.aim_points:\n                if p.part!=\'head\':\n                    p.visibility=\'visible\';p.penetration={\'kind\':\'clear\',\'allowed\':True}\n            selected=aim_points.select_aim_view(f.frame,e,USP,10.,allow_penetration=True)\n            self.assertEqual(selected.aim_part,\'head\',selected)\n\n        def test_head_only_helper_preserves_real_path(self):\n            f=pending_scene(\'blocked\');e=f.reader.entity\n            admission=aim_points.select_aim_view(f.frame,e,USP,10.,allow_penetration=True,require_safe=False)\n            self.assertNotEqual(admission.aim_part,\'head\');self.assertEqual(admission.visibility,\'visible\')\n            h=aim_points.select_aim_view(f.frame,e,USP,10.,head_only=True,require_safe=False)\n            self.assertEqual(h.aim_part,\'head\');self.assertEqual(h.visibility,\'blocked\')\n            self.assertFalse(h.penetration[\'allowed\'])\n\n        def test_generic_and_high_threat_body_remain_supported(self):\n            for model in (\'fixture.mdl\',\'player/tr_qipao01/tr_qipao01.mdl\',\'player/tr_san/tr_san.mdl\'):\n                f=pending_scene(generic=True);f.reader.entity.model=model\n                d=tick(f,10.);self.assertIn(True,f.inputs.events,d);self.assertNotEqual(d[\'aim_part\'],\'head\')\n\n        def test_progress_reaim_normal_old_body_returns_