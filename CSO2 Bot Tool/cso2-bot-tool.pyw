_EMBEDDED['summon_ui'] = (1, '"""Single-key window summon control. Only observes the chosen key and modifiers."""\nimport time\nfrom floating_window import FloatingWindow\nfrom shortcut_conflicts import conflicts\nimport tkinter as tk\nfrom tkinter import ttk\n\nKEY_NAMES={0x08:\'Backspace\',0x09:\'Tab\',0x0d:\'Enter\',0x1b:\'Esc\',0x20:\'Space\',\n    0x21:\'PageUp\',0x22:\'PageDown\',0x23:\'End\',0x24:\'Home\',0x25:\'Left\',0x26:\'Up\',\n    0x27:\'Right\',0x28:\'Down\',0x2d:\'Insert\',0x2e:\'Delete\',\n    0x6a:\'Num*\',0x6b:\'Num+\',0x6d:\'Num-\',0x6e:\'Num.\',0x6f:\'Num/\',\n    0xba:\';\',0xbb:\'=\',0xbc:\',\',0xbd:\'-\',0xbe:\'.\',0xbf:\'/\',0xc0:\'`\',0xdb:\'[\',0xdc:\'\\\\\',0xdd:\']\',0xde:"\'"}\nKEY_NAMES.update({k:chr(k) for k in range(0x30,0x3a)})\nKEY_NAMES.update({k:chr(k) for k in range(0x41,0x5b)})\nKEY_NAMES.update({0x60+i:\'Num\'+str(i) for i in range(10)})\nKEY_NAMES.update({0x70+i:\'F\'+str(i+1) for i in range(24)})\nMODIFIERS=(0x10,0x11,0x12,0x5b,0x5c)\nDEFAULT_KEY=0x75\n\n\ndef key_code(name):\n    if not isinstance(name,str):return DEFAULT_KEY\n    return next((code for code,label in KEY_NAMES.items() if label.casefold()==name.casefold()),DEFAULT_KEY)\n\n\nclass KeyEdge:\n    def __init__(self,down,key=DEFAULT_KEY):\n        self.down=down;self.key=key;self.was_down=bool(down(key))\n    def set_key(self,key):\n        self.key=key;self.was_down=bool(self.down(key))\n    def poll(self,blocked=False):\n        pressed=bool(self.down(self.key));edge=pressed and not self.was_down;self.was_down=pressed\n        return edge and not blocked and not any(self.down(k) for k in MODIFIERS)\n\n\ndef saved_key(settings):\n    value=settings.get(\'summon_key\',\'F6\')\n    if settings.get(\'summon_key_schema\',0)<2 and value==\'Enter\':value=\'F6\'\n    return KEY_NAMES[key_code(value)]\n\n\nclass SummonControl(ttk.Frame):\n    def __init__(self,parent,root,i18n,down,on_summon,on_topmost,on_change,feedback,game_path=lambda:\'\'):\n        super().__init__(parent)\n        self.root=root;self.i18n=i18n;self.on_summon=on_summon;self.on_topmost=on_topmost\n        self.on_change=on_change;self.feedback=feedback;self.game_path=game_path\n        self.edge=KeyEdge(down);self.job=None;self.closed=False;self.recording=False;self.record_until=0.;self.held=set()\n        self.key_text=tk.StringVar(master=root,value=\'F6\');self.display=i18n.var(\'F6\');self.topmost=tk.BooleanVar(master=root,value=False)\n        ttk.Label(self,textvariable=i18n.var(\'快捷键呼出：\')).pack(side=\'left\',padx=(8,0))\n        self.entry=ttk.Button(self,textvariable=self.display,width=10,command=self.begin_capture)\n        self.entry.pack(side=\'left\',padx=(3,0));self.entry.bind(\'<KeyPress>\',self.capture)\n        self.entry.bind(\'<<Paste>>\',lambda _:\'break\')\n        self.button=ttk.Button(self,text=\'▾\',width=2,command=self.toggle_menu);self.button.pack(side=\'left\')\n        self.popup=None;self.popup_window=None;self.binding_conflicts=[]\n        i18n.refreshers.append(self.refresh)\n    def refresh(self):\n        if self.popup is not None:self.topcheck.configure(text=self.i18n.t(\'置顶\'))\n    def toggle_menu(self):\n        if self.popup is not None:self.close_menu();return\n        self.cancel_capture();self.popup=tk.Toplevel(self.root);self.popup.withdraw();self.popup.overrideredirect(True)\n        self.popup.configure(bg=\'#29517a\')\n        self.topcheck=ttk.Checkbutton(self.popup,text=self.i18n.t(\'置顶\'),variable=self.topmost,command=self.choose_topmost)\n        self.topcheck.pack(padx=1,pady=1,ipadx=14,ipady=4)\n        self.popup.update_idletasks();self.popup.geometry(\'+%d+%d\'%(self.button.winfo_rootx()-105,self.button.winfo_rooty()+self.button.winfo_height()))\n        self.popup_window=FloatingWindow(self.popup);self.popup_window.show()\n    def choose_topmost(self):\n        self.on_topmost(self.topmost.get());self.close_menu()\n    def close_menu(self):\n        if self.popup is not None:\n            self.popup_window.close();self.popup.destroy();self.popup=None;self.popup_window=None\n    def set_key(self,name):\n        key=key_code(name);self.edge.set_key(key);self.key_text.set(KEY_NAMES[key]);self.display.set(KEY_NAMES[key])\n        self.binding_conflicts=[]\n    def check_binding(self):\n        self.binding_conflicts=conflicts(self.edge.key,self.game_path())\n        if self.binding_conflicts:\n            self.feedback(self.i18n.t(\'快捷键冲突：\')+\' / \'.join(self.i18n.t(x) for x in self.binding_conflicts))\n    def begin_capture(self):\n        if self.recording:self.cancel_capture();return\n        self.close_menu();self.recording=True;self.record_until=time.monotonic()+10\n        self.held={k for k in KEY_NAMES if self.edge.down(k)}\n        self.display.set(\'请按一个键\');self.entry.focus_set()\n        self.feedback(\'请按一个键，10 秒内有效；再次点击取消\')\n        self.start()\n    def cancel_capture(self):\n        self.recording=False;self.display.set(self.key_text.get())\n        self.edge.set_key(key_code(self.key_text.get()))\n    def accept_key(self,code):\n        reasons=conflicts(code,self.game_path())\n        if reasons:\n            self.feedback(self.i18n.t(\'快捷键冲突：\')+\' / \'.join(self.i18n.t(x) for x in reasons));return\n        self.set_key(KEY_NAMES[code]);self.recording=False;self.on_change()\n        self.feedback(\'呼出快捷键已保存；未发现已知冲突\')\n    def capture(self,event):\n        if not self.recording:return None\n        code=int(event.keycode)\n        if code not in KEY_NAMES or event.state&0x0d or any(self.edge.down(k) for k in MODIFIERS):\n            self.feedback(\'请只按一个键，不使用组合键\');return \'break\'\n        if code not in self.held:self.accept_key(code)\n        self.held.add(code)\n        return \'break\'\n    def start(self):\n        if not self.closed and self.job is None:self.job=self.root.after(20,self.poll)\n    def poll(self):\n        self.job=None\n        if self.closed:return\n        try:\n            if self.recording:\n                held={k for k in KEY_NAMES if self.edge.down(k)};fresh=held-self.held;self.held=held\n                if time.monotonic()>=self.record_until:self.cancel_capture()\n                elif fresh:\n                    if len(held)==1 and not any(self.edge.down(k) for k in MODIFIERS):self.accept_key(next(iter(fresh)))\n                    else:self.feedback(\'请只按一个键，不使用组合键\')\n                self.edge.poll(blocked=True)\n                return\n            focused=self.root.focus_displayof()\n            editing=isinstance(focused,(tk.Entry,ttk.Entry,tk.Text,ttk.Combobox,ttk.Spinbox))\n            if self.edge.poll(blocked=editing or bool(self.binding_conflicts) or self.root.grab_current() is not None):\n                self.close_menu();self.on_summon()\n        finally:self.start()\n    def close(self):\n        self.closed=True;self.close_menu()\n        if self.job is not None:self.root.after_cancel(self.job);self.job=None\n')
_EMBEDDED['summon_contract'] = (1, '"""Shortcut edge/rebinding and window state contracts. No game I/O."""\nimport io\nimport unittest\nfrom types import SimpleNamespace as NS\nfrom unittest.mock import Mock,patch\n\n\ndef run():\n    from summon_ui import KeyEdge,key_code,SummonControl,saved_key\n    import cso2_bot_tool as tool\n    class Tests(unittest.TestCase):\n        def test_duplicate_launch_detects_loaded_version_not_just_filename(self):\n            import time\n            name=\'Local\\\\BOT_BUILD_TEST_\'+str(time.time_ns())\n            owner=tool.ToolInstance(name,build_id=\'a\');same=other=None\n            try:\n                same=tool.ToolInstance(name,build_id=\'a\');other=tool.ToolInstance(name,build_id=\'b\')\n                self.assertTrue(same.matching_build());self.assertFalse(other.matching_build())\n                self.assertTrue(other.wake_existing());self.assertFalse(other.acquired)\n            finally:\n                if same:same.close()\n                if other:other.close()\n                owner.close()\n            fresh=tool.ToolInstance(name,build_id=\'b\')\n            try:self.assertTrue(fresh.acquired);self.assertTrue(fresh.matching_build())\n            finally:fresh.close()\n        def pause_fixture(self,visible=True,pointer_game=False,pressed=False):\n            import threading\n            pause=threading.Event();pause.set()\n            view=NS(summon_visible=True,worker=NS(ui_pause=pause,reader=NS(mem=NS(pid=123))),\n                floating_window=NS(visible=lambda:visible,pointer_on_game=Mock(return_value=pointer_game)),\n                win=NS(down=lambda k:pressed),cursor_lock=NS(suspend=Mock()),\n                summon_control=NS(close_menu=Mock()),set_topmost=Mock(),\n                root=NS(iconify=Mock()),refresh_cursor_lock=Mock())\n            return view\n        def test_hidden_native_window_clears_pause_even_without_tk_unmap(self):\n            view=self.pause_fixture(visible=False)\n            tool.App.sync_summon_pause(view)\n            self.assertFalse(view.worker.ui_pause.is_set());self.assertFalse(view.summon_visible)\n            view.cursor_lock.suspend.assert_called_once_with(False)\n        def test_stale_pause_without_summoned_window_clears(self):\n            view=self.pause_fixture();view.summon_visible=False\n            tool.App.sync_summon_pause(view);self.assertFalse(view.worker.ui_pause.is_set())\n        def test_game_click_folds_panel_and_restores_control(self):\n            view=self.pause_fixture(pointer_game=True,pressed=True)\n            tool.App.sync_summon_pause(view)\n            self.assertFalse(view.worker.ui_pause.is_set());self.assertFalse(view.summon_visible)\n            view.set_topmost.assert_called_once_with(False);view.root.iconify.assert_called_once()\n        def test_clicking_panel_or_another_app_never_resumes_fire(self):\n            view=self.pause_fixture(pointer_game=False,pressed=True)\n            tool.App.sync_summon_pause(view)\n            self.assertTrue(view.worker.ui_pause.is_set());view.root.iconify.assert_not_called()\n        def test_just_hovering_game_keeps_menu_pause(self):\n            view=self.pause_fixture(pointer_game=True,pressed=False)\n            tool.App.sync_summon_pause(view);self.assertTrue(view.worker.ui_pause.is_set())\n            view.floating_window.pointer_on_game.assert_not_called()\n        def test_pause_replaces_previous_match_diagnostics_and_rearms(self):\n            from combat37_contract import scene,tick\n            f=scene(generic=False,distance=550.)\n            tick(f,10.);self.assertTrue(f.control.pressed)\n            f.control.diagnostic.update(frame_stamp=1.,fire_pose_point=(1.,2.,3.),\n                stop_reason=\'本地角色未存活，停止辅助控制\')\n            f.control.pause_frame(f.frame,\'悬浮菜单操作中，收起菜单后恢复辅助\',ui_paused=True)\n            d=f.control.diagnostic\n            self.assertEqual(d[\'frame_stamp\'],f.frame.stamp);self.assertTrue(d[\'ui_paused\'])\n            self.assertNotIn(\'fire_pose_point\',d);self.assertFalse(f.control.pressed)\n            self.assertFalse(f.control.input_armed)\n            tick(f,10.01);self.assertFalse(f.control.pressed)\n            original=f.control.win.down;f.control.win.down=lambda key:False\n            tick(f,10.02);self.assertTrue(f.control.input_armed)\n            f.control.win.down=original;tick(f,10.2);self.assertTrue(f.control.pressed)\n        def test_held_key_summons_once_until_release(self):\n            down=set();edge=KeyEdge(lambda key:key in down,key=13)\n            down.add(13);self.assertTrue(edge.poll());self.assertFalse(edge.poll())\n            down.clear();self.assertFalse(edge.poll());down.add(13);self.assertTrue(edge.poll())\n        def test_startup_held_key_waits_for_fresh_press(self):\n            down={13};edge=KeyEdge(lambda key:key in down,key=13)\n            self.assertFalse(edge.poll());down.clear();edge.poll();down.add(13);self.assertTrue(edge.poll())\n        def test_modifier_combo_does_not_summon_after_modifier_release(self):\n            down=set();edge=KeyEdge(lambda key:key in down,key=13)\n            down.update((13,0x11));self.assertFalse(edge.poll());down.remove(0x11);self.assertFalse(edge.poll())\n            down.clear();edge.poll();down.add(13);self.assertTrue(edge.poll())\n        def test_typing_does_not_queue_summon_for_focus_change(self):\n            down=set();edge=KeyEdge(lambda key:key in down,key=13)\n            down.add(13);self.assertFalse(edge.poll(blocked=True));self.assertFalse(edge.poll(blocked=False))\n        def test_rebind_drops_old_key_and_does_not_trigger_held_new_key(self):\n            down=set();edge=KeyEdge(lambda key:key in down,key=13);down.add(0x41);edge.set_key(0x41)\n            self.assertFalse(edge.poll());down.clear();edge.poll();down.add(13);self.assertFalse(edge.poll())\n            down.add(0x41);self.assertTrue(edge.poll())\n        def test_settings_accept_single_keys_and_reject_combinations(self):\n            for name,code in ((\'Enter\',13),(\'A\',65),(\'F10\',121),(\'Num0\',96),(\'Space\',32),(\'F8\',119)):\n                self.assertEqual(key_code(name),code)\n            for name in (\'Ctrl+A\',\'ABC\',None,[],123,\'\'):\n                self.assertEqual(key_code(name),117)\n        def test_capture_rejects_combo_and_accepts_f8(self):\n            view=NS(recording=True,held=set(),edge=NS(down=lambda _:False),feedback=Mock(),accept_key=Mock())\n            for event in (NS(keycode=65,state=4),NS(keycode=0x11,state=0)):\n                self.assertEqual(SummonControl.capture(view,event),\'break\')\n            view.accept_key.assert_not_called()\n            SummonControl.capture(view,NS(keycode=0x77,state=0));view.accept_key.assert_called_once_with(0x77)\n        def test_summon_toggles_visible_topmost_then_hidden_then_visible(self):\n            view=NS(floating_window=NS(show=Mock()),always_on_top=False,\n                summon_control=NS(topmost=Mock(),close_menu=Mock()),save=Mock(),set_topmost=Mock(),\n                cursor_lock=NS(suspend=Mock()),worker=NS(ui_pause=Mock()),refresh_cursor_lock=Mock(),\n                root=NS(winfo_ismapped=lambda:True,state=lambda:\'normal\',iconify=Mock()))\n            tool.App.summon_window(view);self.assertTrue(view.summon_visible)\n            tool.App.summon_window(view);self.assertFalse(view.summon_visible)\n            view.cursor_lock.suspend.assert_called_with(False);view.worker.ui_pause.clear.assert_called_once()\n            view.set_topmost.assert_called_once_with(False);view.root.iconify.assert_called_once()\n            tool.App.summon_window(view);self.assertTrue(view.summon_visible)\n            self.assertEqual(view.floating_window.show.call_count,2)\n            view.cursor_lock.suspend.assert_called_with(True);self.assertEqual(view.worker.ui_pause.set.call_count,2)\n            view.summon_control.topmost.set.assert_called_with(True)\n        def test_minimized_floating_window_is_restored_on_next_press(self):\n            view=NS(summon_visible=True,floating_window=NS(show=Mock()),always_on_top=True,\n                summon_control=NS(topmost=Mock(),close_menu=Mock()),save=Mock(),set_topmost=Mock(),\n                cursor_lock=NS(suspend=Mock()),worker=NS(ui_pause=Mock()),refresh_cursor_lock=Mock(),\n                root=NS(winfo_ismapped=lambda:False,state=lambda:\'iconic\',iconify=Mock()))\n            tool.App.summon_window(view);view.floating_window.show.assert_called_once()\n            view.root.iconify.assert_not_called();self.assertTrue(view.summon_visible)\n        def test_shutdown_cancels_pending_listener(self):\n            view=NS(closed=False,job=\'timer\',close_menu=Mock(),root=NS(after_cancel=Mock()))\n            SummonControl.close(view);self.assertTrue(view.closed);self.assertIsNone(view.job)\n            view.root.after_cancel.assert_called_once_with(\'timer\')\n        def test_repeat_launch_show_never_toggles_visible_window_off(self):\n            view=NS(summon_visible=True,floating_window=NS(show=Mock()),always_on_top=True,\n                summon_control=NS(topmost=Mock(),close_menu=Mock()),save=Mock(),set_topmost=Mock(),\n                cursor_lock=NS(suspend=Mock()),worker=NS(ui_pause=Mock()),refresh_cursor_lock=Mock(),\n                root=NS(winfo_ismapped=lambda:True,state=lambda:\'normal\',iconify=Mock()))\n            for _ in range(3):tool.App.summon_window(view,force_show=True)\n            self.assertTrue(view.summon_visible);view.root.iconify.assert_not_called()\n            self.assertEqual(view.floating_window.show.call_count,3)\n            view.cursor_lock.suspend.assert_called_with(True);view.worker.ui_pause.clear.assert_not_called()\n        def test_repeat_launch_signals_owner_and_releases_handles(self):\n            import time\n            name=\'Local\\\\BOT_INSTANCE_TEST_\'+str(time.time_ns())\n            owner=tool.ToolInstance(name);duplicate=None\n            try:\n                self.assertTrue(owner.acquired)\n                duplicate=tool.ToolInstance(name);self.assertFalse(duplicate.acquired)\n                self.assertTrue(duplicate.wake_existing())\n                duplicate.close();duplicate.close()\n                self.assertEqual(owner.api.WaitForSingleObject(owner.event,0),0)\n                self.assertEqual(owner.api.WaitForSingleObject(owner.event,0),258)\n            finally:\n                if duplicate:duplicate.close()\n                owner.close()\n            restarted=tool.ToolInstance(name)\n            try:self.assertTrue(restarted.acquired)\n            finally:restarted.close()\n        def test_queued_wake_before_tk_ready_is_served_once(self):\n            import time\n            owner=tool.ToolInstance(\'Local\\\\BOT_QUEUED_WAKE_\'+str(time.time_ns()))\n            root=NS(after=Mock(return_value=\'timer\'),after_cancel=Mock());show=Mock()\n            try:\n                owner.api.SetEvent(owner.event);owner.listen(root,show)\n                show.assert_called_once();root.after.assert_called_once()\n                self.assertEqual(owner.api.WaitForSingleObject(owner.event,0),258)\n            finally:owner.close()\n            root.after_cancel.assert_called_once_with(\'timer\')\n        def test_f6_default_and_settings_migration(self):\n            self.assertEqual(KeyEdge(lambda _:False).key,117)\n            for d,want in (({},\'F6\'),({\'summon_key\':\'Enter\'},\'F6\'),({\'summon_key\':\'F9\'},\'F9\'),\n                           ({\'summon_key\':\'Enter\',\'summon_key_schema\':2},\'Enter\')):\n                self.assertEqual(saved_key(d),want)\n        def test_internal_conflict_and_f8_release(self):\n            from shortcut_conflicts import conflicts\n            self.assertTrue(conflicts(0x48,probe=lambda _:\'\'));self.assertTrue(conflicts(0x20,probe=lambda _:\'\'))\n            self.assertFalse(conflicts(0x77,probe=lambda _:\'\'));self.assertFalse(conflicts(0x75,probe=lambda _:\'\'))\n        def test_system_conflict_is_preserved(self):\n            from shortcut_conflicts import conflicts\n            self.assertEqual(conflicts(0x75,probe=lambda _:\'occupied\'),[\'occupied\'])\n        def test_readable_game_and_reshade_bindings(self):\n            import tempfile\n            from pathlib import Path\n            from shortcut_conflicts import file_bindings\n            with tempfile.TemporaryDirectory() as path:\n                root=Path(path);(root/\'custom\'/\'cfg\').mkdir(parents=True);(root/\'Bin\').mkdir()\n                (root/\'custom\'/\'cfg\'/\'config.cfg\').write_text(\'bind "F9" "screenshot"\\n// bind "F6" "quit"\',\'utf-8\')\n                (root/\'Bin\'/\'ReShade.ini\').write_text(\'[INPUT]\\nKeyOverlay=36,0,0,0\\nKeyReload=117,1,0,0\',\'utf-8\')\n                bindings=file_bindings(root);self.assertIn(120,bindings);self.assertIn(36,bindings);self.assertNotIn(117,bindings)\n        def test_recording_conflict_keeps_previous_binding(self):\n            view=NS(game_path=lambda:\'\',feedback=Mock(),i18n=NS(t=lambda x:x),set_key=Mock(),on_change=Mock(),recording=True)\n            with patch(\'summon_ui.conflicts\',return_value=[\'occupied\']):SummonControl.accept_key(view,120)\n            view.set_key.assert_not_called();view.on_change.assert_not_called();self.assertTrue(view.recording)\n        def test_capture_requires_explicit_edit_mode(self):\n            view=NS(recording=False,accept_key=Mock())\n            self.assertIsNone(SummonControl.capture(view,NS(keycode=65,state=0)));view.accept_key.assert_not_called()\n        def test_cancel_restores_label_and_disarms_held_key(self):\n            view=NS(recording=True,display=Mock(),key_text=NS(get=lambda:\'F9\'),edge=Mock())\n            SummonControl.cancel_capture(view);self.assertFalse(view.recording)\n            view.display.set.assert_called_once_with(\'F9\');view.edge.set_key.assert_called_once_with(120)\n        def test_floating_suspension_preserves_cursor_preference(self):\n            import threading\n            from cursor_lock import CursorCenterLock\n            for enabled in (True,False):\n                view=NS(enabled=enabled,suspended=False,_guard=threading.RLock(),_release=Mock())\n                CursorCenterLock.suspend(view,True);CursorCenterLock.step(view)\n                self.assertEqual(view.enabled,enabled);self.assertTrue(view.suspended)\n                self.assertGreaterEqual(view._release.call_count,1)\n                CursorCenterLock.suspend(view,False);self.assertEqual(view.enabled,enabled);self.assertFalse(view.suspended)\n    output=io.StringIO();result=unittest.TextTestRunner(stream=output,verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(Tests))\n    if not result.wasSuccessful():raise AssertionError(output.getvalue())\n    return dict(passed=True,tests=result.testsRun,game_attached=False,game_input=False)\n')

_EMBEDDED['floating_window'] = (1, '"""Non-activating Tk window presentation. No game window modifications."""\nimport ctypes as C\nfrom ctypes import wintypes as W\n\n\nclass FloatingWindow:\n    def __init__(self,root):\n        self.root=root;self.hwnd=None;self.old_proc=None;self.callback=None;self.old_style=None\n        self.api=C.WinDLL(\'user32\',use_last_error=True)\n        api=self.api;pointer=C.c_ssize_t\n        api.GetAncestor.argtypes=[W.HWND,W.UINT];api.GetAncestor.restype=W.HWND\n        api.GetForegroundWindow.restype=W.HWND\n        api.IsWindow.argtypes=[W.HWND];api.IsWindow.restype=W.BOOL\n        self.get_long=api.GetWindowLongPtrW if C.sizeof(C.c_void_p)==8 else api.GetWindowLongW\n        self.set_long=api.SetWindowLongPtrW if C.sizeof(C.c_void_p)==8 else api.SetWindowLongW\n        self.get_long.argtypes=[W.HWND,C.c_int];self.get_long.restype=pointer\n        self.set_long.argtypes=[W.HWND,C.c_int,pointer];self.set_long.restype=pointer\n        api.CallWindowProcW.argtypes=[C.c_void_p,W.HWND,W.UINT,W.WPARAM,W.LPARAM];api.CallWindowProcW.restype=pointer\n        api.SetWindowPos.argtypes=[W.HWND,W.HWND,C.c_int,C.c_int,C.c_int,C.c_int,W.UINT];api.SetWindowPos.restype=W.BOOL\n        api.ShowWindow.argtypes=[W.HWND,C.c_int];api.ShowWindow.restype=W.BOOL\n        api.IsWindowVisible.argtypes=[W.HWND];api.IsWindowVisible.restype=W.BOOL\n        api.IsIconic.argtypes=[W.HWND];api.IsIconic.restype=W.BOOL\n        api.GetCursorPos.argtypes=[C.POINTER(W.POINT)];api.GetCursorPos.restype=W.BOOL\n        api.WindowFromPoint.argtypes=[W.POINT];api.WindowFromPoint.restype=W.HWND\n    def visible(self):\n        hwnd=self.hwnd\n        return bool(hwnd and self.api.IsWindow(hwnd) and self.api.IsWindowVisible(hwnd)\n                    and not self.api.IsIconic(hwnd))\n    def pointer_on_game(self,windows,pid):\n        foreground=windows.foreground(pid)\n        if not foreground:return False\n        point=W.POINT()\n        if not self.api.GetCursorPos(C.byref(point)):return False\n        hit=self.api.WindowFromPoint(point)\n        return bool(hit and self.api.GetAncestor(hit,2)==self.api.GetAncestor(foreground,2))\n    def wrapper(self):\n        self.root.update_idletasks()\n        return self.api.GetAncestor(self.root.winfo_id(),2)\n    def prepare(self):\n        hwnd=self.wrapper()\n        if hwnd==self.hwnd:return hwnd\n        self.close();self.hwnd=hwnd;self.old_style=self.get_long(hwnd,-20)\n        self.set_long(hwnd,-20,self.old_style|0x08000000)  # WS_EX_NOACTIVATE\n        callback_type=C.WINFUNCTYPE(C.c_ssize_t,W.HWND,W.UINT,W.WPARAM,W.LPARAM)\n        def procedure(window,message,wparam,lparam):\n            if message==0x21:return 3  # WM_MOUSEACTIVATE / MA_NOACTIVATE\n            return self.api.CallWindowProcW(self.old_proc,window,message,wparam,lparam)\n        self.callback=callback_type(procedure)\n        self.old_proc=self.set_long(hwnd,-4,C.cast(self.callback,C.c_void_p).value)\n        return hwnd\n    def set_topmost(self,enabled):\n        hwnd=self.wrapper()\n        self.root.attributes(\'-topmost\',bool(enabled))\n        self.api.SetWindowPos(hwnd,W.HWND(-1 if enabled else -2),0,0,0,0,0x13)\n    def show(self):\n        hwnd=self.prepare();before=self.api.GetForegroundWindow()\n        self.api.ShowWindow(hwnd,4)  # SW_SHOWNOACTIVATE restores without focus\n        self.set_topmost(True)\n        self.api.SetWindowPos(hwnd,W.HWND(-1),0,0,0,0,0x53)\n        return dict(foreground_before=before,foreground_after=self.api.GetForegroundWindow(),window=hwnd)\n    def close(self):\n        if self.hwnd and self.api.IsWindow(self.hwnd):\n            if self.old_proc:self.set_long(self.hwnd,-4,self.old_proc)\n            if self.old_style is not None:self.set_long(self.hwnd,-20,self.old_style)\n        self.hwnd=None;self.old_proc=None;self.callback=None;self.old_style=None\n')
_EMBEDDED['shortcut_conflicts'] = (1, '"""Bounded on-demand checks; registered hotkeys and readable local bindings."""\nimport configparser\nimport ctypes as C\nfrom ctypes import wintypes as W\nfrom pathlib import Path\nimport re\n\n\ndef system_conflict(key):\n    api=C.WinDLL(\'user32\',use_last_error=True)\n    api.RegisterHotKey.argtypes=[W.HWND,C.c_int,W.UINT,W.UINT];api.RegisterHotKey.restype=W.BOOL\n    api.UnregisterHotKey.argtypes=[W.HWND,C.c_int];api.UnregisterHotKey.restype=W.BOOL\n    if key==0x7b:return \'系统保留 F12\'\n    # A short-lived dedicated window avoids colliding with a thread\'s hotkey IDs.\n    api.CreateWindowExW.argtypes=[W.DWORD,W.LPCWSTR,W.LPCWSTR,W.DWORD,C.c_int,C.c_int,C.c_int,C.c_int,W.HWND,W.HMENU,W.HINSTANCE,C.c_void_p]\n    api.CreateWindowExW.restype=W.HWND;api.DestroyWindow.argtypes=[W.HWND]\n    hwnd=api.CreateWindowExW(0,\'STATIC\',\'\',0,0,0,0,0,W.HWND(-3),None,None,None)\n    if not hwnd:return \'系统热键检测未完成\'\n    try:\n        if api.RegisterHotKey(hwnd,1,0x4000,key):\n            api.UnregisterHotKey(hwnd,1);return \'\'\n        return \'已被其他程序注册\' if C.get_last_error()==1409 else \'系统热键检测未完成\'\n    finally:api.DestroyWindow(hwnd)\n\n\ndef file_bindings(game):\n    from summon_ui import KEY_NAMES\n    found={}\n    if not game:return found\n    root=Path(game)\n    paths=(root/\'custom\'/\'cfg\'/\'config.cfg\',root/\'custom\'/\'cfg\'/\'autoexec.cfg\',\n           root/\'cfg\'/\'config.cfg\',root/\'cfg\'/\'autoexec.cfg\',root/\'Bin\'/\'ReShade.ini\')\n    aliases={\'return\':\'Enter\',\'escape\':\'Esc\',\'pgup\':\'PageUp\',\'pgdn\':\'PageDown\',\'space\':\'Space\'}\n    for path in paths:\n        try:\n            if not path.is_file() or path.stat().st_size>262144:continue\n            text=path.read_text(\'utf-8-sig\',errors=\'replace\')\n            if path.suffix.lower()==\'.ini\':\n                cfg=configparser.ConfigParser(interpolation=None,strict=False);cfg.read_string(text)\n                for name,value in cfg.items(\'INPUT\') if cfg.has_section(\'INPUT\') else ():\n                    if not name.startswith(\'key\'):continue\n                    parts=[int(x.strip()) for x in value.split(\',\')]\n                    if len(parts)>=4 and parts[0] in KEY_NAMES and not any(parts[1:]):\n                        found.setdefault(parts[0],[]).append(\'ReShade / \'+name)\n            else:\n                for line in text.splitlines():\n                    match=re.match(r\'\\s*bind\\s+"?([^"\\s]+)"?\\s+"?([^"\\r\\n]+)\',line.split(\'//\',1)[0],re.I)\n                    if not match:continue\n                    name,command=match.groups();name=aliases.get(name.casefold(),name)\n                    code=next((k for k,v in KEY_NAMES.items() if v.casefold()==name.casefold()),None)\n                    if code is not None and command.strip():found.setdefault(code,[]).append(path.name+\' / \'+command.strip())\n        except (OSError,ValueError,configparser.Error):continue\n    return found\n\n\ndef conflicts(key,game=\'\',probe=system_conflict):\n    reasons=[]\n    if key==0x48:reasons.append(\'工具：H 切换视角\')\n    if key==0x20:reasons.append(\'工具：Space 连跳\')\n    if key in (0x0d,0x1b,0x09):reasons.append(\'游戏：聊天 / 菜单 / 计分板常用键\')\n    reasons.extend(file_bindings(game).get(key,()))\n    reason=probe(key)\n    if reason:reasons.append(reason)\n    return reasons\n')


_EMBEDDED['white_map'] = (1, '"""Per-entry material checks, bounded visual evidence, verified native repair."""\nimport ctypes as C\nfrom ctypes import wintypes as W\nimport json\nimport math\nfrom pathlib import Path\nimport struct\nimport threading\nimport time\nfrom types import SimpleNamespace\n\n\ndef pixel_evidence(bgra,width,height):\n    if len(bgra)!=width*height*4 or width<16 or height<16:raise ValueError(\'pixel dimensions\')\n    white=0;edges=0;valid_edges=0;tiles=[0]*12;counts=[0]*12\n    luminance=[]\n    for y in range(height):\n        for x in range(width):\n            at=(y*width+x)*4;b,g,r=bgra[at:at+3];light=(r+g+b)/3\n            pale=min(r,g,b)>=190 and max(r,g,b)-min(r,g,b)<=18\n            white+=int(pale);tile=min(2,y*3//height)*4+min(3,x*4//width)\n            tiles[tile]+=int(pale);counts[tile]+=1;luminance.append(light)\n            if x:\n                edges+=int(abs(light-luminance[-2])>=12);valid_edges+=1\n    ratio=white/(width*height);edge_ratio=edges/max(1,valid_edges)\n    coverage=sum(v/max(1,n)>=.7 for v,n in zip(tiles,counts))\n    # Blank/flash/loading frames have little scene structure. Their colour alone\n    # is not evidence of missing materials. A naturally pale scene is still only\n    # a suspicion, never a confirmed shader failure.\n    suspect=ratio>=.84 and coverage>=10 and .01<=edge_ratio<=.35\n    return dict(pale_ratio=round(ratio,4),structured_edges=round(edge_ratio,4),pale_tiles=coverage,\n                suspect=suspect,flat_white=ratio>.95 and edge_ratio<.01,capture=\'GDI client region\')\n\n\ndef capture_client(hwnd):\n    """Downsample the visible middle of a foreground client; no files or screenshots."""\n    u=C.WinDLL(\'user32\',use_last_error=True);g=C.WinDLL(\'gdi32\',use_last_error=True)\n    u.GetForegroundWindow.restype=W.HWND\n    u.GetClientRect.argtypes=[W.HWND,C.POINTER(W.RECT)];u.ClientToScreen.argtypes=[W.HWND,C.POINTER(W.POINT)]\n    u.GetDC.argtypes=[W.HWND];u.GetDC.restype=W.HDC;u.Release