group].values():\n                    metric[\'mean\']=metric[\'sum\']/metric[\'count\'] if metric[\'count\'] else None\n        return dict(basis=\'every_worker_cycle_through_last_cycle; excludes_inflight_and_after_last_report\',\n            session=self.session,process_id=os.getpid(),started_mono=self.started,\n            completed_mono=self.completed,last_cycle=self.last_cycle,cycles=self.cycles,\n            bundle_sha256=self.bundle_sha256,by_mode=rows)\n\n\nclass ControlLoop:\n    """One fresh acquisition -> native rays -> Controller -> EngineAttack."""\n    def __init__(self, reader, windows, controller, visibility, catalog, clock=time.monotonic):\n        self.reader = reader; self.win = windows; self.control = controller\n        self.trigger = controller.trigger; self.visibility = visibility; self.catalog = catalog\n        self.clock = clock; self.frame = None; self.metrics = {}; self.geometry = {}; self.cycle = 0\n        self.latency_totals=WorkerLatencyTotals(clock)\n        from types import SimpleNamespace\n        self.toggle = SimpleNamespace(force_fire_active=False, force_fire_scope=None)\n        self._force_policy_lock = threading.RLock()\n        self._force_enabled = False\n        self.control.pose_refresh = self.visibility.refresh_target\n        self.wall_provider=None\n        self._force_allowed = lambda: False\n        self._force_monitor = None\n        self._follow_target = None\n        self._follow_config = None\n        self._full_finished = 0.\n        self._last_aim_write = None\n        self._last_aim_identity = None\n        self._last_visibility = None\n        self.follow_period = 1./240.\n        self.population_period = .050\n\n    def following(self, cfg):\n        return bool(self._follow_target and self._follow_config == cfg\n            and self._last_visibility==\'visible\'\n            and self.win.down(2) and (cfg.aim or self.toggle.force_fire_active)\n            and self.win.foreground(self.reader.mem.pid)\n            and 0 <= self.clock()-self._full_finished < self.population_period)\n\n    def configure_force_input(self, cfg, allowed):\n        """Publish the cheap policy state before any potentially blocking read."""\n        enabled = bool(getattr(cfg, \'tab_force_fire\', False))\n        with self._force_policy_lock:\n            self._force_enabled = enabled\n            self._force_allowed = allowed if callable(allowed) else lambda: bool(allowed)\n        if not enabled or not self._force_allowed():\n            self.cancel_force(\'T强制模式门禁关闭\')\n\n    def _force_policy_snapshot(self):\n        with self._force_policy_lock:\n            return self._force_enabled, self._force_allowed\n\n    def handle_force_fire_edge(self):\n        """Apply a T rising edge without waiting for the acquisition loop."""\n        observed = self.clock()\n        enabled, allowed = self._force_policy_snapshot()\n        if self.toggle.force_fire_active:\n            self.cancel_force(\'按T取消强制瞄准开火\', observed)\n            return False\n        if not enabled or not allowed() or not self.win.foreground(self.reader.mem.pid):return False\n        if self.reader.game_ui_visible():return False\n        with self._force_policy_lock:\n            if not self._force_enabled or not self._force_allowed():return False\n            self.toggle.force_fire_active = True\n            self.trigger.tab_force = True\n            self.control.force_input_observed = observed\n            self.control.force_first_aim_pending = True\n            self.control.force_first_down_pending = True\n        self.record_force_input(True, observed)\n        return True\n\n    def record_force_input(self, active, observed, reason=\'T强制瞄准开火\'):\n        completed = self.clock()\n        event = dict(active=active, observed_mono=observed, completed_mono=completed,\n            response_ms=max(0., completed-observed)*1000, basis=\'key_observed_to_toggle_or_primary_up\')\n        self.control.diagnostic[\'t_input\'] = event\n        self.control.actions.append(dict(action=\'t_force_toggle\', mono=completed,\n            target=self.control.target, reason=reason, t_input=event))\n\n    def cancel_force(self, reason, observed=None):\n        with self._force_policy_lock:\n            was_active = self.toggle.force_fire_active\n            self.toggle.force_fire_active = False\n            self.trigger.tab_force = False\n            # Publish the barrier before a new acquisition can begin.\n            if was_active:self.control.force_cancel_requested = True\n        if was_active:\n            began = self.clock() if observed is None else observed\n            self.control.request_force_cancel(reason)\n            self.record_force_input(False, began, reason)\n\n    def force_config(self, frame, cfg):\n        scope = (self.reader.mem.pid, frame.map_name, frame.local.address,\n                 frame.local.serial, getattr(frame, \'source_epoch\', None))\n        enabled, allowed = self._force_policy_snapshot()\n        paused = (not enabled or not allowed() or not self.win.foreground(self.reader.mem.pid)\n                  or self.reader.game_ui_visible() or frame.local.health <= 0)\n        if paused or (self.toggle.force_fire_scope is not None and self.toggle.force_fire_scope != scope):\n            self.cancel_force(\'T强制模式场景或输入门禁变化\')\n        self.toggle.force_fire_scope = scope\n        return replace(cfg, tab_force_fire=self.toggle.force_fire_active)\n\n    def start_input_monitor(self):\n        if self._force_monitor is None:\n            self._force_monitor = ForceFireInputMonitor(self)\n        self._force_monitor.start()\n\n    def stop_input_monitor(self):\n        if self._force_monitor is not None:\n            self._force_monitor.stop()\n            self._force_monitor = None\n\n    def pause(self):\n        self.cancel_force(\'暂停 T 强制模式\')\n        self.control.release(); self.trigger.pause_aim()\n        self.geometry = {}; self.frame = None\n        self._follow_target =