_EMBEDDED['dodge_service'] = ('2026.10.07-aim-private-reader-evidence', '"""HE sampling, planning and WASD ownership in one independent interpreter."""\nimport json\nimport os\nfrom pathlib import Path\nimport subprocess\nimport sys\nimport threading\nimport time\nimport uuid\n\n\nclass DodgeSettings:\n    """Settings-only IPC, also readable by the release watchdog."""\n    def __init__(self, mailbox, permitted):\n        self.mailbox = mailbox; self.permitted = permitted\n        self.lock = threading.Lock(); self.value = {}; self.revision = 0\n\n    def snapshot(self):\n        with self.lock:\n            raw = self.mailbox.read_latest()\n            if raw is not None:\n                value = json.loads(raw)\n                if (type(value.get(\'enabled\')) is not bool or\n                        type(value.get(\'ghost_only\')) is not bool):\n                    raise ValueError(\'躲雷设置格式无效\')\n                if value != self.value: self.value = value; self.revision += 1\n            return dict(self.value), self.revision\n\n    def allowed(self, revision=None):\n        value, current = self.snapshot()\n        return bool(value.get(\'enabled\') and self.permitted()\n                    and (revision is None or revision == current))\n\n\nclass DodgeScene:\n    """Own map geometry; disk reads never run in a sample/decision cycle."""\n    def __init__(self, game, loader=None):\n        from wall_service import load_map\n        self.game = game; self.loader = loader or load_map\n        self.key = None; self.scene = None; self.error = \'\'; self.next_retry = 0.\n        self.loading = False; self.closed = False; self.lock = threading.Lock()\n\n    def get(self, map_name, manual=None):\n        key = (map_name, manual)\n        with self.lock:\n            if key != self.key:\n                self.key = key; self.scene = None; self.error = \'\'; self.next_retry = 0.\n            if not self.closed and self.scene is None and not self.loading and time.monotonic() >= self.next_retry:\n                self.loading = True\n                threading.Thread(target=self._load, args=(key,), name=\'dodge-map-loader\', daemon=True).start()\n            return self.scene\n\n    def _load(self, key):\n        scene = None; error = \'\'\n        try: scene = self.loader(self.game, *key)\n        except Exception as ex: error = type(ex).__name__+\': \'+str(ex)\n        with self.lock:\n            if not self.closed and self.key == key:\n                self.scene = scene; self.error = error; self.next_retry = time.monotonic()+2.\n            self.loading = False\n\n    def close(self):\n        with self.lock: self.closed = True; self.scene = None\n\n\nclass DodgeLoop:\n    def __init__(self, reader, windows, controls, settings, scene, clock=time.monotonic):\n        self.reader = reader; self.win = windows; self.controls = controls\n        self.settings = settings; self.scene = scene; self.clock = clock\n        self.frame = None; self.revision = None; self.metrics = {}; self.cycle = 0\n        self.last_cycle_trace = -100.\n        self.controls.permitted = self.can_write\n        self.controls.direction_permitted = self.escape_allowed\n\n    def escape_allowed(self, frame, keys):\n        return (frame is self.frame and self.can_write()\n                and self.reader.escape_allowed(frame, keys))\n\n    def can_write(self):\n        try:\n            if self.frame is None or not self.settings.allowed(self.revision): return False\n            cfg, _ = self.settings.snapshot()\n            if cfg.get(\'ghost_only\', True) and self.frame.native_mode_id != 4: return False\n            # Final native state verification is shared by submit and watchdog.\n            return self.reader.validate(self.frame)\n        except Exception: return False\n\n    def pause(self, reason):\n        self.frame = None\n        self.controls.release(); self.controls.status = \'躲雷：\'+reason\n\n    def tick(self):\n        from grenade_dodge import dodge_payload, plan_ghost_dodge\n        started = self.clock(); detected = decided = started\n        self.cycle += 1; stage = \'detection\'; error = \'\'; frame = None\n        sampled = planned = False; pause_reason = \'\'\n        def pause(reason):\n            nonlocal detected, decided, stage, pause_reason\n            # Releasing WASD is an action, including early and failed cycles.\n            at = self.clock()\n            if stage == \'detection\': detected = decided = at\n            elif stage == \'decision\': decided = at\n            stage = \'action\'; pause_reason = reason\n            self.pause(reason)\n        try:\n            cfg, revision = self.settings.snapshot()\n            if not self.settings.allowed(revision): pause(\'关闭或暂停\'); return\n            if not self.win.foreground(self.reader.mem.pid) or self.reader.game_ui_visible():\n                pause(\'失焦或菜单打开\'); return\n            frame = self.reader.local_frame()\n            if cfg.get(\'ghost_only\', True) and frame.native_mode_id != 4:\n                pause(\'仅限幽灵模式，当前模式不执行\'); return\n            if not (frame.local.flags or 0) & 1: pause(\'当前未着地\'); return\n            self.reader.sample_hazards(frame)\n            self.frame = frame; self.revision = revision\n            detected = self.clock(); stage = \'decision\'; sampled = True\n            bsp = self.scene.get(frame.map_name, cfg.get(\'manual_bsp\'))\n            plan = None\n            if bsp is not None and frame.grenades:\n                # All evidence comes from this interpreter\'s current HE sample.\n                # Enemy origins are sampled here independently of ESP/aim.\n                payload = dodge_payload(frame, {})\n                plan = plan_ghost_dodge(bsp, payload[\'actor\'], payload[\'grenades\'], [], frame.stamp)\n            decided = self.clock(); stage = \'action\'; planned = True\n            if not self.can_write(): pause(\'提交前设置或角色状态变化\'); return\n            self.controls.step(self.reader, frame, True, plan, bsp)\n            if bsp is None:\n                self.controls.status = \'躲雷：等待当前地图障碍物数据\'\n                if self.scene.error: self.controls.status += \' · \'+self.scene.error\n        except Exception as ex:\n            error = type(ex).__name__+\': \'+str(ex)\n            pause(error)\n        finally:\n            finished = self.clock()\n            if stage == \'detection\': detected = decided = finished\n            elif stage == \'decision\': decided = finished\n            self.metrics = dict(owner=\'dodge_process\', cycle=self.cycle, pid=os.getpid(),\n                component_build=\'2026.10.07-dodge-away-from-enemies\',\n                sample_source=\'own_memory_reader\', parent_frame_consumed=False,\n                detection_ms=max(0.,detected-started)*1000,\n                decision_ms=max(0.,decided-detected)*1000,\n                action_ms=max(0.,finished-decided)*1000, total_ms=max(0.,finished-started)*1000,\n                error=error, native_mode_id=getattr(frame,\'native_mode_id\',None),\n                detection_completed=sampled, decision_completed=planned,\n                pause_reason=pause_reason, status=self.controls.status,\n                enemy_sample=dict(getattr(frame,\'dodge_enemy_diagnostics\',{})),\n                controls=dict(self.controls.metrics))\n            if finished-self.last_cycle_trace >= .1:\n                self.controls._trace(\'independent_cycle\', finished, force=True, **self.metrics)\n                self.last_cycle_trace = finished\n\n\ndef serve_dodge_worker(game, game_pid, parent_pid, tag):\n    from bhop_service import Signals, Lifetime\n    from esp_transport import LatestMailbox\n    from presentation import TimerResolution\n    from cso2_bot_tool import Windows\n    from dodge_reader import DodgeReader\n    from grenade_dodge import DodgeControls\n    from grenade_exit import install\n    install()\n    lifetime = signals = commands = replies = reader = controls = scene = None\n    timer = TimerResolution(); driver = None\n    try:\n        lifetime = Lifetime(parent_pid, game_pid); signals = Signals(tag)\n        commands = LatestMailbox(tag+\'_settings\'); replies = LatestMailbox(tag+\'_status\')\n        settings = DodgeSettings(commands, lambda: lifetime.alive() and\n            signals.is_set(\'enabled\') and not signals.is_set(\'stop\'))\n        reader = DodgeReader(game); reader.attach(int(game_pid))\n        windows = Windows(); controls = DodgeControls(windows)\n        scene = DodgeScene(game); driver = DodgeLoop(reader, windows, controls, settings, scene)\n        timer.set_active(True); reported = 0.\n        while lifetime.alive() and not signals.is_set(\'stop\'):\n            began = time.monotonic(); driver.tick()\n            now = time.monotonic()\n            if now-reported >= .02:\n                replies.write(json.dumps(dict(pid=os.getpid(), observed_at=now,\n                    status=controls.status, owned=controls.owned, metrics=driver.metrics),\n                    ensure_ascii=True).encode(\'utf8\')); reported = now\n            if not reader.mem.alive(): break\n            signals.wait(max(.001, .008-(time.monotonic()-began)))\n    finally:\n        # Never kill a live WASD owner. Keep retrying UP if an individual write\n        # fails; the parent waits for this process before starting a replacement.\n        if driver: driver.frame = None\n        if controls:\n            while reader and reader.mem and reader.mem.alive():\n                try: controls.release(); break\n                except Exception: time.sleep(.02)\n            controls.shutdown()\n        if scene: scene.close()\n        if reader: reader.close()\n        timer.close()\n        for item in (replies, commands, signals, lifetime):\n            if item: item.close()\n\n\nclass DodgeService:\n    """Parent sends settings/lifecycle only; never reads HE or writes WASD."""\n    def __init__(self, requested):\n        self.requested = requested; self.thread = None; self.proc = None; self.signals = None\n        self.stopped = threading.Event(); self.lock = threading.Lock(); self.forced_pause = False\n        self.latest = {}; self.error = \'\'; self.status = \'躲雷：独立进程等待连接\'; self.metrics = {}\n        self.next_supervisor = 0.\n\n    def start(self, game, pid):\n        if self.thread and self.thread.is_alive(): return\n        if time.monotonic() < self.next_supervisor: return\n        self.game = str(game); self.pid = int(pid); self.stopped.clear(); self.forced_pause = False\n        self.thread = threading.Thread(target=self._watch, name=\'dodge-process-supervisor\', daemon=True)\n        self.thread.start()\n\n    def release(self):\n        with self.lock:\n            self.forced_pause = True\n            if self.signals: self.signals.set(\'enabled\', False)\n\n    def resume(self):\n        with self.lock: self.forced_pause = False\n\n    def poll(self):\n        report = self.latest; age = time.monotonic()-report.get(\'observed_at\',0.)\n        self.status = (report.get(\'status\',\'躲雷：等待独立进程采样\') if age <= .5 else\n                       \'躲雷：\'+(self.error or \'独立进程等待状态\'))\n        self.metrics = dict(report.get(\'metrics\',{}), process_pid=report.get(\'pid\'),\n                            status_age_ms=age*1000 if report else None, status=self.status)\n        return self.metrics\n\n    def _watch(self):\n        from bhop_service import Signals, Lifetime\n        from esp_transport import LatestMailbox\n        entry = globals().get(\'BUNDLE_ENTRY\') or Path(sys.argv[0]).resolve()\n        lifetime = signals = settings = replies = log = None\n        try:\n            lifetime = Lifetime(os.getpid(), self.pid)\n            tag = \'Local\\\\CSO2_DODGE_\'+str(os.getpid())+\'_\'+uuid.uuid4().hex\n            signals = Signals(tag, create=True)\n            with self.lock: self.signals = signals\n            settings = LatestMailbox(tag+\'_settings\', create=True)\n            replies = LatestMailbox(tag+\'_status\', create=True)\n            path = entry.parent/\'CSO2_BOT_Tool\'/\'dodge_worker.log\'\n            path.parent.mkdir(parents=True, exist_ok=True); log = path.open(\'ab\', buffering=0)\n            last_payload = None; next_start = 0.\n            while lifetime.alive():\n                config, permitted = self.requested()\n                if self.stopped.is_set():\n                    signals.set(\'enabled\', False); signals.set(\'stop\')\n                    if self.proc is None: break\n                payload = json.dumps(config, sort_keys=True).encode(\'utf8\')\n                if payload != last_payload:\n                    signals.set(\'enabled\', False)\n                    if settings.write(payload): last_payload = payload\n                with self.lock:\n                    signals.set(\'enabled\', bool(permitted and config[\'enabled\'] and\n                        payload == last_payload and not self.forced_pause and not self.stopped.is_set()))\n                if self.proc is None and not self.stopped.is_set() and time.monotonic() >= next_start:\n                    try:\n                        self.proc = subprocess.Popen([sys.executable, \'-X\', \'utf8\', \'-u\', str(entry),\n                            \'--dodge-worker\', self.game, str(self.pid), str(os.getpid()), tag],\n                            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=log,\n                            creationflags=subprocess.CREATE_NO_WINDOW)\n                    except OSError as ex:\n                        self.error = \'独立躲雷启动失败，将自动重试：\'+str(ex)\n                        next_start = time.monotonic()+1.\n                raw = replies.read_latest()\n                if raw is not None:\n                    report = json.loads(raw)\n                    if self.proc and report.get(\'pid\') == self.proc.pid:\n                        self.latest = report; self.error = report.get(\'metrics\',{}).get(\'error\',\'\')\n                if self.proc is not None and self.proc.poll() is not None:\n                    code = self.proc.returncode; self.proc = None; self.latest = {}\n                    if self.stopped.is_set(): break\n                    self.error = \'独立躲雷退出，将自动重建：\'+str(code)\n                    next_start = time.monotonic()+1.; last_payload = None\n                time.sleep(.01)\n        except Exception as ex: self.error = type(ex).__name__+\': \'+str(ex)\n        finally:\n            self.next_supervisor = time.monotonic()+1.\n            if signals: signals.set(\'enabled\', False); signals.set(\'stop\')\n            if self.proc: self.proc.wait(); self.proc = None\n            with self.lock:\n                self.signals = None\n                if signals: signals.close()\n            for item in (settings, replies, lifetime, log):\n                if item: item.close()\n\n    def close(self):\n        self.release(); self.stopped.set()\n        if self.thread and self.thread.is_alive():\n            self.thread.join(1.)\n            if self.thread.is_alive(): raise RuntimeError(\'独立躲雷正在释放 WASD\')\n        self.thread = None; self.latest = {}; self.metrics = {}; self.status = \'躲雷：停止\'\n\n    shutdown = close\n')
_EMBEDDED['aim_scope_input'] = (1, '"""T input regressions: production listener/Controller/EngineAttack, offline I/O."""\nimport threading\nimport time\nfrom dataclasses import replace\nfrom unittest.mock import patch\nfrom aim_scope_fixture import Fixture\n\n\ndef force_input():\n    from aim_service import ForceFireInputMonitor\n    results={}\n    with Fixture(force=True) as f:\n        f.ready();f.tick()\n        monitor=ForceFireInputMonitor(f.loop)\n        monitor.held=True\n        for _ in range(8):monitor.poll_once()\n        assert f.loop.toggle.force_fire_active,\'held T toggled repeatedly\'\n        f.inputs.keys.discard(0x54);monitor.poll_once()\n        f.inputs.keys.add(0x54);monitor.poll_once()\n        assert not f.loop.toggle.force_fire_active and not f.trigger.active\n        assert (0x90000,4) in f.native_writes,\'T cancellation missing real UP\'\n        before=f.native_writes.count((0x90000,3))\n        assert not f.control.button(True,\'late cancelled DOWN\')\n        assert f.native_writes.count((0x90000,3))==before\n        f.inputs.keys.discard(0x54);monitor.poll_once()\n        f.inputs.keys.add(0x54);monitor.poll_once()\n        assert f.loop.toggle.force_fire_active and f.control.force_cancel_requested\n        f._unused=None\n        # Resume only with a new acquisition. Use this same edge owner.\n        f.loop._force_monitor=monitor\n        f.tick()\n        assert f.control.pressed,\'fresh acquisition failed to recover after off/on\'\n        f.loop._force_monitor=None\n        events=[a for a in f.control.drain_actions()+f.actions if a[\'action\']==\'t_force_toggle\']\n        assert events and all(a[\'t_input\'][\'response_ms\']>=0 for a in events)\n        results[\'hold_cancel_reenable\']=True\n    # Cancellation during aiming and at the final native input boundary.\n    for boundary in (\'aim_write\',\'final_input\'):\n        with Fixture(force=True) as f:\n            f.ready();fired=[]\n            def cancel():\n                if fired:return\n                fired.append(True);f.loop.handle_force_fire_edge()\n            if boundary==\'aim_write\':\n                f.io_hook=lambda event:cancel() if event==\'aim_write\' else None\n            else:\n                f.reader.mem.allow_write=lambda:cancel() if f.control.diagnostic.get(\'fire_commit\',{}).get(\'post_weapon_verified\') else None\n            f.tick()\n            assert fired and not f.control.pressed and (0x90000,3) not in f.native_writes,boundary\n            f.io_hook=None;f.reader.mem.allow_write=lambda:None\n            f.inputs.keys.discard(0x54);f.tick()\n            assert f.control.pressed,\'ordinary RMB failed to recover\'\n        results[boundary+\'_cancelled\']=True\n    # A genuinely blocked bone read is still pending when T is applied.\n    with Fixture(force=True) as f:\n        f.ready();f.tick();f.inputs.keys.discard(0x54)\n        entered=threading.Event();unblock=threading.Event();applied=threading.Event();errors=[]\n        original=f.loop.handle_force_fire_edge\n        def edge():\n            try:return original()\n            finally:applied.set()\n        f.loop.handle_force_fire_edge=edge\n        def stall(event):\n            if event==\'bones\':\n                entered.set()\n                if not unblock.wait(2.):raise AssertionError(\'fixture release timeout\')\n        f.io_hook=stall\n        def cycle():\n            try:f.tick()\n            except Exception as ex:errors.append(repr(ex))\n        f.loop.start_input_monitor()\n        thread=threading.Thread(target=cycle)\n        try:\n            thread.start();assert entered.wait(1.)\n            start=time.perf_counter();f.inputs.keys.add(0x54)\n            assert applied.wait(.5),\'T cancellation waited for blocked bones\'\n            elapsed=(time.perf_counter()-start)*1000\n            assert thread.is_alive() and not f.trigger.active and not f.control.pressed\n            assert f.native_writes[-1]==(0x90000,4),\'cancel did not write primary UP while bones blocked\'\n            before=f.native_writes.count((0x90000,3))\n        finally:\n            unblock.set();thread.join(2.);f.loop.stop_input_monitor();f.io_hook=None\n        assert not thread.is_alive() and not errors,errors\n        assert f.native_writes.count((0x90000,3))==before,\'stale cycle fired after cancellation\'\n        results[\'blocked_bones_cancel_wall_ms\']=elapsed\n        results[\'timing_is_offline_only\']=True\n    # Paused, focus and menu edges cannot arm a latent force toggle.\n    for gate in (\'paused\',\'focus\',\'menu\',\'disabled\'):\n        with Fixture(force=True) as f:\n            f.loop.configure_force_input(f.cfg,gate!=\'paused\')\n            if gate==\'focus\':f.inputs.focus=False\n            if gate==\'menu\':f.menu=True\n            if gate==\'disabled\':f.loop.configure_force_input(replace(f.cfg,tab_force_fire=False),True)\n            monitor=ForceFireInputMonitor(f.loop)\n            f.inputs.keys.add(0x54);monitor.poll_once()\n            assert not f.loop.toggle.force_fire_active,gate\n            f.inputs.focus=True;f.menu=False;f.loop.configure_force_input(f.cfg,True)\n            monitor.poll_once();assert not f.loop.toggle.force_fire_active,\'held resume toggled T\'\n            f.inputs.keys.discard(0x54);monitor.poll_once();f.inputs.keys.add(0x54);monitor.poll_once()\n            assert f.loop.toggle.force_fire_active,\'fresh edge not accepted after recovery\'\n    results[\'pause_focus_menu_held_resume\']=True\n    return results\n')
_EMBEDDED['aim_scope_geometry'] = (1, '"""Dense geometry reproduction for the dedicated independent aim check only."""\nimport copy\nimport math\nimport random\nimport time\nfrom dataclasses import replace\nfrom unittest.mock import patch\nfrom aim_scope_fixture import Fixture\n\n\ndef populate(f, far=False, blocking=False, varied_radii=False):\n    from aim_points import AimPoint,PoseHitbox,ProtectedEntity\n    from reader import Entity\n    basis=((1.,0.,0.),(0.,1.,0.),(0.,0.,1.))\n    original=f.actors[0];actors=[]\n    for i in range(20):\n        actor=copy.deepcopy(original);actor.index=i+2;actor.serial=i+2;actor.address=0x20000+i*0x1000\n        actor.origin=(150.+i*20.,i*12.,0.);actor.head=(*actor.origin[:2],64.)\n        actor.aim_points=[AimPoint(\'head\' if j==0 else str(j),\'head\' if j<9 else \'torso\',\n            (actor.head[0],actor.head[1]+(j%5)*.1,actor.head[2]-(j//9)*2.),3.,j,\'visible\') for j in range(48)]\n        if varied_radii:\n            actor.aim_points=[replace(p,radius=.5+((i*48+j)%79)/20.) for j,p in enumerate(actor.aim_points)]\n        actors.append(actor)\n    f.actors=actors;f.cfg=replace(f.cfg,mode=\'幽灵模式（按阵营）\')\n    guards=[];hostages=[]\n    for i in range(4):\n        origin=(100.+i*60.,1800. if far else -240.,0.)\n        boxes=tuple(PoseHitbox(((-4.,-3.,-3.),(4.,3.,3.)),\n            (origin[0]+(j%3)*3.,origin[1]+(j%2)*3.,4.+j*3.),basis,(1.,1.,1.),j) for j in range(20))\n        bounds=((origin[0]-8.,origin[1]-8.,0.),(origin[0]+16.,origin[1]+12.,68.))\n        guards.append(ProtectedEntity(80+i,0xA0000+i*0x1000,bounds,False,boxes,f.now))\n        hostages.append(Entity(80+i,0xA0000+i*0x1000,\'CHostage\',-1,100,origin))\n    if blocking:\n        assert not far\n        for h in guards:\n            h.bounds=((45.,-5.,30.),(65.,5.,90.))\n            h.hitboxes=tuple(replace(b,origin=(55.,0.,b.origin[2])) for b in h.hitboxes)\n    f.geometry_guards=guards;f.geometry_hostages=hostages;f.geometry_measurements=[]\n    original_frame=f.reader.frame;original_visibility=f.visibility.update\n    def frame(*args,**kwargs):\n        from aim_points import filter_hostage_aim_points\n        result=original_frame(*args,**kwargs)\n        result.protected=copy.deepcopy(f.geometry_guards);result.hostages=copy.deepcopy(f.geometry_hostages)\n        for h in result.protected:h.sampled_at=result.stamp\n        started=time.perf_counter()\n        if not kwargs.get(\'defer_hostage_filter\',False):filter_hostage_aim_points(result)\n        cost=time.perf_counter()-started;f.now+=cost\n        f.geometry_measurements.append(dict(filter_ms=cost*1000))\n        return result\n    def visibility(*args,**kwargs):\n        started=time.perf_counter()\n        try:return original_visibility(*args,**kwargs)\n        finally:\n            cost=time.perf_counter()-started;f.now+=cost\n            f.geometry_measurements[-1][\'visibility_cpu_ms\']=cost*1000\n    f.reader.frame=frame;f.visibility.update=visibility\n\n\ndef dense_run(force=False, far=False, blocking=False, varied_radii=False):\n    with Fixture(force=force) as f:\n        populate(f,far,blocking,varied_radii);f.ready();f.tick()\n        before=f.native_writes.count((0x90000,3))\n        f.ammo-=1;f.now+=.012;f.tick()\n        row=copy.deepcopy(f.control.diagnostic[\'aim_latency\'])\n        pressed=f.control.pressed;reason=f.control.reason\n        selected=f.control.target;filtered=f.loop.frame.hostage_aim_filter[\'filtered\']\n        f.inputs.keys.discard(2);f.tick()\n        return dict(force=force,far=far,blocking=blocking,varied_radii=varied_radii,measurements=f.geometry_measurements,\n            selected=selected,filtered=filtered,\n            latency=row,down=before,continued=pressed,reason=reason,\n            released=(0x90000,4) in f.native_writes and not f.control.pressed,\n            mode=\'simulated_io_measured_geometry_cpu\',actors=20,points_per_actor=48,hostages=4,boxes_per_hostage=20)\n\n\ndef geometry_equivalence():\n    from aim_points import (AimPoint,PoseHitbox,ProtectedEntity,_hostage_point_intersection,\n                            hostage_candidates_for_points,hostage_safe_points,HOSTAGE_CHECK_DISTANCE,hostage_is_nearby)\n    from geometry import box_ray_interval\n    rng=random.Random(7141515);cases=hits=0\n    def exact(eye,point,h,margin,reach):\n        delta=tuple(point[i]-eye[i] for i in range(3));distance=math.dist(point,eye)\n        delta=tuple(v*max(distance,reach)/distance for v in delta)\n        if h.hitboxes and not h.dormant:\n            values=[x[0] for box in h.hitboxes if (x:=box.intersection(eye,delta,margin)) is not None]\n            return min(values) if values else None\n        if h.bounds is None:return None\n        b=(tuple(v-margin for v in h.bounds[0]),tuple(v+margin for v in h.bounds[1]))\n        entry=box_ray_interval(b,eye,delta)\n        return None if entry is None else entry[0]\n    for scene in range(50):\n        boxes=[]\n        for i in range(5):\n            angle=rng.uniform(-math.pi,math.pi);c=math.cos(angle);s=math.sin(angle)\n            scales=tuple(rng.uniform(.3,3.) for _ in range(3))\n            # Include slightly non-orthogonal native matrices; a shortcut may\n            # never shrink the exact volume, even at large world coordinates.\n            inv=((c/scales[0],s/scales[0],.0001),(-s/scales[1],c/scales[1],0.),(0.,0.,1./scales[2]))\n            origin=(rng.uniform(40.,450.),rng.uniform(-140.,140.),rng.uniform(20.,100.))\n            boxes.append(PoseHitbox(((-9.,-5.,-6.),(9.,5.,6.)),origin,inv,scales))\n        h=ProtectedEntity(80,0x80000,((0.,0.,0.),(1.,1.,1.)),False,tuple(boxes))\n        eye=(rng.uniform(-20.,20.),rng.uniform(-20.,20.),64.)\n        points=[AimPoint(str(i),\'head\',b.origin,rng.uniform(.5,10.),i) for i,b in enumerate(boxes)]\n        points.extend(AimPoint(str(i+5),\'body\',(rng.uniform(100.,800.),rng.uniform(-600.,600.),rng.uniform(-100.,200.)),3.,i) for i in range(20))\n        possible=hostage_candidates_for_points(eye,points,(h,),8192.)\n        any_hit=False;expected_safe=[]\n        for p in points:\n            margin=max(.15,min(3.,p.radius*.35));expected=exact(eye,p.position,h,margin,8192.)\n            got=_hostage_point_intersection(eye,p.position,h,margin)\n            assert (got is None)==(expected is None),(scene,p,got,expected)\n            if got is not None:\n                assert math.isclose(got,expected,abs_tol=1e-12);hits+=1;any_hit=True\n            else:expected_safe.append(p)\n            early=_hostage_point_intersection(eye,p.position,h,margin,first_hit=True)\n            assert (early is None)==(expected is None),\'first intersection changed eligibility\'\n            cases+=1\n        assert not any_hit or h in possible,\'packet rejection lost exact intersection\'\n        assert hostage_safe_points(eye,points,(h,),8192.)==expected_safe,\'batch changed exact eligibility\'\n        # Pose replacement invalidates the cached envelope.\n        h.hitboxes=tuple(replace(b,origin=(b.origin[0],b.origin[1]+900.,b.origin[2])) for b in boxes)\n        for p in points[:5]:\n            assert _hostage_point_intersection(eye,p.position,h,1.)==exact(eye,p.position,h,1.,8192.)\n    basis=((1.,0.,0.),(0.,1.,0.),(0.,0.,1.))\n    h=ProtectedEntity(80,0x80000,((50.,1.,63.),(60.,3.,65.)),False,\n        (PoseHitbox(((-5.,-1.,-1.),(5.,1.,1.)),(55.,2.,64.),basis,(1.,1.,1.)),))\n    # Closed boundary with a nonzero margin, and dormant collision fallback.\n    for dormant in (False,True):\n        h.dormant=dormant\n        for y in (-.00001,0.,.00001,4.):\n            eye=(0.,y,64.);p=(100.,y,64.)\n            assert _hostage_point_intersection(eye,p,h,1.)==exact(eye,p,h,1.,8192.)\n    h.bounds=((HOSTAGE_CHECK_DISTANCE,-1.,63.),(HOSTAGE_CHECK_DISTANCE+5.,1.,65.))\n    assert hostage_is_nearby((0.,0.,64.),h),\'15 m inclusive boundary\'\n    assert not hostage_is_nearby((-.01,0.,64.),h),\'15 m outside boundary\'\n    assert hostage_is_nearby((.01,0.,64.),h),\'15 m inside boundary\'\n    return dict(comparisons=cases,exact_hits=hits,rotated_scaled_and_sheared=True,\n                pose_cache_invalidated=True,grazing_and_dormant=True,boundary_15m=True)\n\n\ndef local_hostage_control():\n    from aim_points import ProtectedEntity,HOSTAGE_CHECK_DISTANCE,hostage_candidates_for_points,PoseHitbox\n    results=[]\n    for force in (False,True):\n        with Fixture(force=force) as f:\n            populate(f);f.actors=f.actors[:1]\n            f.actors[0].aim_points=f.actors[0].aim_points[:1]\n            h=ProtectedEntity(80,0x80000,((75.,-5.,60.),(85.,5.,68.)))\n            f.geometry_guards=[h];f.rays.blocked.add(2);f.wall=f.obstacle(f.actors[0])\n            f.ready();f.tick()\n            assert not f.control.pressed and f.control.target==0,\'wall bridge reintroduced hostage-blocked point\'\n            # Same ray but outside the explicitly requested local radius.\n            h.bounds=((HOSTAGE_CHECK_DISTANCE+.01,-5.,60.),(HOSTAGE_CHECK_DISTANCE+10.,5.,68.))\n            f.now+=.02;f.tick()\n            assert f.control.pressed,\'distant hostage still disables local guard\'\n            # Crossing into the radius resumes protection on the next frame.\n            h.bounds=((HOSTAGE_CHECK_DISTANCE,-5.,60.),(HOSTAGE_CHECK_DISTANCE+10.,5.,68.))\n            f.now+=.02;f.tick()\n            assert not f.control.pressed,\'nearby hostage failed to re-enter guard\'\n            # A latest camera/eye change is used before filtering the bones.\n            f.local.origin=(0.,30.,0.);f.now+=.02;f.tick()\n            assert f.control.pressed,\'current eye did not restore an unobstructed point\'\n            f.inputs.keys.discard(2);f.tick()\n            assert not f.control.pressed and (0x90000,4) in f.native_writes\n            results.append(dict(force=force,wall_cannot_reintroduce=True,boundary_recovered=True,current_eye=True))\n    # An off-ray dense scene must not walk any exact OBBs in visibility prep.\n    with Fixture() as f:\n        populate(f)\n        frame=f.reader.frame(f.cfg.mode,0,False,with_bones=True,with_aimpoints=True,defer_hostage_filter=True)\n        with patch.object(PoseHitbox,\'intersection\',side_effect=AssertionError(\'off-ray exact OBB work\')):\n            f.visibility.update(f.reader,frame,f.cfg,{})\n        assert len(f.rays.requests[-1])==20\n    return dict(modes=results,off_ray_exact_obb_calls=0)\n\n\ndef dense_geometry():\n    result=[dense_run(force,far,blocking,varied) for force in (False,True)\n            for far,blocking,varied in ((False,False,False),(True,False,False),(False,True,False),(False,True,True))]\n    for row in result:\n        assert row[\'down\']>0 and row[\'continued\'] and row[\'released\'],row\n        if row[\'blocking\']:\n            # Actor #2 is the direct protected corridor. Other actors may\n            # retain a safe bone when a larger point margin changes the\n            # first eligible sample; the important invariant is that the\n            # blocked actor is filtered and a safe actor still fires.\n            assert row[\'filtered\']>0 and row[\'selected\'] != 2,row\n    return result\n')
_EMBEDDED['aim_latency'] = (1, '"""Monotonic measurements only; these values never gate input or targeting."""\nimport os\nimport time\n\nFIELDS = (\'detection_ms\', \'decision_ms\', \'action_ms\', \'total_ms\')\nMODES = (\'rmb_aim_fire\', \'t_force_fire\')\n\n\nclass AimLatency:\n    def __init__(self, sequence, clock=time.monotonic):\n        self.clock = clock\n        self.started = clock()\n        self.detected = None\n        self.acting = None\n        self.mode = \'rmb_aim_fire\'\n        self.sequence = sequence\n        self.sample_stamp = None\n\n    def detection_done(self):\n        self.detected = self.clock()\n\n    def begin_action(self):\n        if self.detected is not None and self.acting is None:\n            self.acting = self.clock()\n\n    def snapshot(self, status, *, now=None, target=0, requested=False):\n        end = self.clock() if now is None else now\n        detected = self.detected if self.detected is not None else end\n        acting = self.acting if self.acting is not None else end\n        return dict(mode=self.mode, process_id=os.getpid(), cycle=self.sequence,\n            started_mono=self.started, completed_mono=end,\n            detection_ms=(detected-self.started)*1000,\n            decision_ms=(acting-detected)*1000, action_ms=(end-acting)*1000,\n            total_ms=(end-self.started)*1000, action_status=status,\n            action_started=self.acting is not None, detection_complete=self.detected is not None,\n            requested=bool(requested), target=target,\n            sample_age_ms=(end-self.sample_stamp)*1000 if self.sample_stamp is not None else None,\n            basis=\'sample_start_to_control_return\' if status == \'cycle_complete\' else status)\n\n\ndef begin_action(control):\n    timer = getattr(control, \'aim_latency_timer\', None)\n    if timer is not None:\n        timer.begin_action()\n')
_EMBEDDED['aim_scope_fixture'] = (1, '"""Offline I/O fixture for the independent aim path; no legacy test imports.\n\nOnly native memory, key state, ray RPC and command queue I/O are simulated.\nControlLoop, ControlVisibility, Controller, fire_commit and EngineAttack run\ntheir production implementations. The background sampler is stepped manually.\n"""\nimport copy\nimport re\nimport struct\nfrom dataclasses import replace\nfrom unittest.mock import patch\n\n\nclass Inputs:\n    def __init__(self, fixture):\n        self.fixture=fixture;self.keys=set();self.focus=True;self.switches=[]\n\n    def down(self, key):return key in self.keys\n    def foreground(self, pid):return self.focus\n\n    def press(self, key):\n        if key==2 and key not in self.keys:\n            binding=self.fixture.binding\n            if binding in (\'slot3\',\'lastinv\',\'+quickknife\'):self.switches.append(binding)\n        self.keys.add(key)\n\n    def mouse_button(self, down):raise AssertionError(\'unexpected synthetic mouse path\')\n\n\nclass Commands:\n    def __init__(self, fixture):self.f=fixture;self.queue=[];self.sent=[]\n    def bind(self, *args, **kwargs):pass\n    def poll(self):return not self.queue\n    def close(self):pass\n    def enqueue(self, command, foreground=True):\n        if foreground and not self.f.inputs.focus:return False\n        assert re.fullmatch(r\'bind "MOUSE2" "[^"\\\\]*"\',command),command\n        self.queue.append(command);self.sent.append(command);return True\n    def execute(self):\n        for command in self.queue:self.f.binding=command.split(\'"\')[3]\n        self.queue.clear()\n\n\nclass Memory:\n    pid=999999\n    def __init__(self, fixture):self.f=fixture;self.states={}\n    def alive(self):return self.f.alive\n    def allow_write(self):pass\n    def read(self, address, size):\n        f=self.f;f.charge(\'memory_read\',.00002)\n        for off,op in ((0xe58ed,b\'\\x8b\\x04\\xc5\'),(0xe5753,b\'\\x8b\\x34\\xed\')):\n            if address==0x10000000+off and size==7:\n                return op+struct.pack(\'<I\',0x10000000+0xaeb8a0)\n        if address==f.local.address+0x97 and size==1:return b\'\\0\'\n        for actor in (f.local,*f.actors):\n            if address==0x50000+actor.index*16 and size==8:\n                return struct.pack(\'<II\',actor.address,actor.serial+(actor.index in f.bad_identity))\n        raise AssertionError((\'unexpected memory read\',hex(address),size))\n    def u32(self, address):\n        f=self.f;f.charge(\'memory_u32\',.00002)\n        if address==0x10000000+0xaeb8a0+108*8:return 0x30000000\n        for i in (107,108,109):\n            if address==0x20000000+0x47150+i*4:return 0x30000000+i*32\n        if address==0x80004:return f.local.address\n        if address==f.local.address+0xf0c:return f.handle\n        if address in (0x90000,0x90004):return self.states.get(address,0)\n        raise AssertionError((\'unexpected u32\',hex(address)))\n    def i32(self, address):\n        f=self.f;f.charge(\'memory_i32\',.00002)\n        if address==0x80000:return f.signon\n        for actor in (f.local,*f.actors):\n            if address==actor.address+0x98:return actor.health\n        if address==f.weapon_address+0xa30:return f.ammo\n        raise AssertionError((\'unexpected i32\',hex(address)))\n    def string(self, address, size):\n        self.f.charge(\'memory_string\',.00002)\n        if address==0x30000000:return self.f.binding\n        return {0x30000000+i*32:v for i,v in ((107,\'MOUSE1\'),(108,\'MOUSE2\'),(109,\'MOUSE3\'))}[address]\n    def vec(self, address):\n        f=self.f;f.charge(\'memory_vec\',.00004)\n        if address==0x70000:\n            return (float(\'nan\'),0.,0.) if f.bad_readback else f.angles\n        if address==f.local.address+0xfd8:return f.punch\n        if address==f.local.address+0x18c:return (0.,0.,64.)\n        if address==f.local.address+0x300:return f.local.origin\n        raise AssertionError((\'unexpected vec\',hex(address)))\n    def write(self, address, data):\n        f=self.f;f.charge(\'input_write\',.00003)\n        value=struct.unpack(\'<I\',data)[0]\n        assert address in (0x90000,0x90004),(address,value)\n        self.states[address]=value;f.native_writes.append((address,value))\n\n\nclass ReaderIO:\n    def __init__(self, fixture):\n        self.f=fixture;self.mem=Memory(fixture);self.engine=0x10000000\n        self.mods={\'inputsystem.dll\':(0x20000000,0,\'\')}\n        self.resolved={\'attack\':0x90000-8,\'attack2\':0x90004-8};self.field_ok={}\n    def global_addr(self, key):\n        return dict(entity_entries=0x50000,view_angles=0x70000,signon=0x80000,local_player=0x80004)[key]\n    def target_entry(self, index):return 0x50000+index*16\n    def fields_available(self, *args):return True\n    def require_feature(self, feature):pass\n    def game_ui_visible(self):return self.f.menu\n    def handle_entity(self, handle):return self.f.weapon_address if handle==self.f.handle and handle else 0\n    def classname(self, address):return self.f.weapon_name\n    def control_identity(self, frame):\n        from reader import Reader\n        return Reader.control_identity(self,frame)\n    def control_weapon(self, frame):\n        from reader import Reader\n        return Reader.control_weapon(self,frame)\n    def control_selection_view(self, frame):\n        self.control_identity(frame)\n        self.f.charge(\'camera\',.0002)\n        return replace(frame,angles=self.f.angles,eye=tuple(a+b for a,b in\n            zip(self.f.local.origin,(0.,0.,64.))),punch=self.f.punch)\n    def set_angles(self, angles):\n        self.f.charge(\'aim_write\',.0001);self.f.angles=tuple(angles)\n        self.f.angle_writes.append(tuple(angles))\n\n    def read_aim_entity(self,index,address,point_key):\n        """Independent selected-target read used by the production refresh."""\n        from reader import NotReady\n        f=self.f; began=f.now; f.samples.append(dict(with_bones=True,with_aimpoints=True,refresh=True))\n        f.charge(\'bones_refresh\',getattr(f,\'refresh_cost\',.0004))\n        if f.fail_sample:raise NotReady(\'fixture_transient_pose_refresh\')\n        if f.io_hook:f.io_hook(\'read_aim_entity\')\n        actor=next((a for a in f.actors if a.index==index and a.address==address),None)\n        if actor is None:return None\n        fresh=copy.deepcopy(actor);fresh.pose_sample_stamp=began\n        return fresh\n    def frame(self, mode, team, hazards, **kwargs):\n        from reader import Frame,NotReady\n        from weapon_input_guard import read_weapon_state\n        f=self.f;began=f.now;f.samples.append(dict(kwargs))\n        assert kwargs[\'with_bones\'] and kwargs[\'with_aimpoints\']\n        f.charge(\'bones\',f.bone_cost)\n        if f.fail_sample:raise NotReady(\'fixture_transient_pose_read\')\n        actors=copy.deepcopy(f.actors)\n        for actor in actors:\n            actor.pose_sample_stamp=f.pose_stamp if f.pose_stamp is not None else began\n        frame=Frame(began,copy.deepcopy(f.local),(0.,0.,64.),f.angles,f.punch,\n            (1.,)*16,actors,f.map_name,f.weapon_name,f.ammo,0,mode)\n        frame.weapon_state=read_weapon_state(self,f.local.address)\n        frame.source=\'client\'\n        return frame\n\n\nclass Rays:\n    def __init__(self, fixture):self.f=fixture;self.requests=[];self.blocked=set();self.bad_reply=False\n    def trace(self, frame, rows):\n        self.f.charge(\'ray\',self.f.ray_cost);self.requests.append(copy.deepcopy(rows))\n        result=[(key,origin,frame.eye,frame.stamp,\n            \'blocked\' if key[0] in self.blocked else \'visible\',\n            [] if key[0] in self.blocked else points) for key,origin,points in rows]\n        if self.bad_reply and result:result[0]=(*result[0][:3],frame.stamp-1.,*result[0][4:])\n        return result,dict(native_rays=len(rows))\n    def close(self):pass\n\n\nclass Fixture:\n    def __init__(self, *, binding=\'\', force=False):\n        from aim_points import AimPoint\n        from reader import Entity\n        from aim_service import ControlLoop,ControlVisibility\n        from cso2_bot_tool import Config,Controller\n        from engine_attack import EngineAttack\n        self.now=10.;self.costs={};self.binding=binding;self.alive=True;self.menu=False\n        self.bone_cost=.002;self.refresh_cost=.0004;self.ray_cost=.0006;self.io_hook=None\n        self.signon=6;self.handle=123;self.weapon_address=0x555000;self.weapon_name=\'ak47\';self.ammo=30\n        self.local=Entity(1,0x10000,\'CCSPlayer\',2,100,(0.,0.,0.),serial=1,velocity=(0.,0.,0.),flags=1)\n        head=(150.,0.,64.)\n        self.actors=[Entity(2,0x20000,\'CCSPlayer\',3,100,(150.,0.,0.),serial=2,\n            enemy=True,head=head,head_radius=3.,model=\'fixture.mdl\',head_bone=\'head\',\n            head_source=\'head_hitgroup\',velocity=(0.,100.,0.),flags=1,\n            aim_points=[AimPoint(\'head\',\'head\',head,3.,0,\'visible\')],aim_points_validated=True)]\n        self.map_name=\'cs_italy\';self.angles=(0.,0.,0.);self.punch=(0.,0.,0.)\n        self.pose_stamp=None;self.bad_identity=set();self.bad_readback=False;self.fail_sample=False\n        self.native_writes=[];self.angle_writes=[];self.samples=[];self.actions=[]\n        self.inputs=Inputs(self);self.reader=ReaderIO(self);self.commands=Commands(self)\n        self.trigger=EngineAttack(self.inputs)\n        # No OS monitor threads in this fixture. poll_weapon/service_pending_release\n        # are called explicitly by tests; the input owner logic remains production.\n        self.trigger.start_monitor=lambda:None\n        self.trigger.aim_binding.commands=self.commands;self.trigger.aim_binding.clock=lambda:self.now\n        self.control=Controller(self.inputs,clock=lambda:self.now,trigger=self.trigger)\n        self.rays=Rays(self);self.visibility=ControlVisibility(\'\',self.rays,lambda:self.now)\n        self.weapon=dict(Penetration=2,Damage=40,Range=8192,RangeModifier=.98,\n            primary_ammo=\'762mm\',WeaponType=\'rifle\',FullAuto=1,CycleTime=.1,\n            profile_source=\'script_default_unverified_variant\')\n        self.cfg=Config(aim=True,fire=True,screen_acquire=False,fov=90.,walls=True,tab_force_fire=force)\n        self.loop=ControlLoop(self.reader,self.inputs,self.control,self.visibility,\n            type(\'Catalog\',(),{\'get\':lambda _,name:self.weapon})(),lambda:self.now)\n        self.wall={}\n\n    def charge(self, name, cost):\n        self.now+=cost;self.costs[name]=self.costs.get(name,0.)+cost\n        if self.io_hook:self.io_hook(name)\n\n    def __enter__(self):return self\n    def __exit__(self, *args):self.close()\n\n    def tick(self, *, allowed=lambda:True):\n        with patch(\'time.monotonic\',side_effect=lambda:self.now):\n            try:self.loop.tick(self.cfg,self.wall,allowed)\n            finally:self.actions.extend(self.control.drain_actions())\n        return self.control.diagnostic\n\n    def ready(self):\n        self.inputs.keys.discard(2);self.tick();self.commands.execute();self.tick()\n        assert self.trigger.aim_binding.check_reserved(self.reader)\n        self.inputs.press(2)\n        if self.cfg.tab_force_fire:self.inputs.press(0x54)\n\n    def move(self, actor, position, velocity=(0.,100.,0.)):\n        actor.head=tuple(position);actor.origin=(position[0],position[1],position[2]-64.)\n        actor.velocity=velocity\n        actor.aim_points=[replace(p,position=tuple(position)) for p in actor.aim_points]\n\n    def obstacle(self, actor):\n        return dict(signals={str(actor.index):dict(penetrable=True,address=actor.address,serial=actor.serial,\n            model=actor.model,display_evidence_stamp=self.now,display_point_key=\'head\',\n            display_ray_eye=(0.,0.,64.),display_ray_head=actor.head)},\n            context=dict(pid=self.reader.mem.pid,map=self.map_name,weapon=self.weapon_name,\n            local_identity=[self.local.index,self.local.address,self.local.serial],control_source=\'client\'))\n\n    def close(self):\n        self.inputs.keys.clear()\n        with patch(\'time.monotonic\',side_effect=lambda:self.now):\n            self.loop.pause()\n            try:self.trigger.close()\n            except RuntimeError:\n                self.commands.execute();self.trigger.close()\n')
_EMBEDDED['aim_service'] = ('2026.10.07-rmb-current-ray-preparation', '"""Independent control interpreter: native samples, rays and the sole attack owner."""\nimport collections\nimport json\nimport math\nimport os\nimport subprocess\nimport sys\nimport threading\nimport time\nimport uuid\nfrom dataclasses import asdict, replace\n\n\nclass ControlVisibility:\n    """Classify this acquisition only; renderer packets never enter this path."""\n    def __init__(self, game, provider=None, clock=time.monotonic):\n        from aim_native_ray import NativeRayService\n        self.native = provider if provider is not None else NativeRayService(game, first_visible=True)\n        self.clock = clock\n        self.metrics = {}\n        self.motion = None\n\n    def refresh_target(self, reader, frame, target, cfg, wall=None):\n        """Read the selected CLIENT pose again immediately before aiming.\n\n        The frame sample is used for ranking only.  This second read is the\n        firing sample; a missing point or a failed current ray rejects the\n        shot instead of falling back to the ranked frame\'s coordinates.\n        """\n        from dataclasses import replace\n        from aim_geometry import select_aim_view\n        from aim_decision import public_path, MAX_TARGET_AGE, signal_for\n        from geometry import finite\n        from target_rules import target_is_active\n        from aim_reader import MemoryError, NotReady\n        began = self.clock()\n        info = dict(status=\'started\', read_ms=0., ray_ms=0., pose_reused=True,\n                    initial_stamp=target.pose_sample_stamp, read_started=began,\n                    source=\'client_cache_read\', engine_pose_age_known=False)\n        try:\n            fresh = reader.read_aim_entity(target.index, target.address, target.aim_id)\n        except (MemoryError, NotReady, ValueError, OSError, TypeError) as ex:\n            info.update(status=\'read_error\', error=str(ex), total_ms=(self.clock()-began)*1000)\n            return None, info\n        info[\'read_ms\'] = max(0., self.clock()-began)*1000\n        if fresh is None:\n            info.update(status=\'missing\')\n            info[\'total_ms\'] = max(0., self.clock()-began)*1000\n            return None, info\n        same_identity=(fresh.index==target.index and fresh.address==target.address\n                       and fresh.serial==target.serial and fresh.model==target.model)\n        if (not same_identity or fresh.classname!=target.classname or\n                fresh.team!=target.team or fresh.owner_team!=target.owner_team or\n                not target_is_active(fresh) or not finite(fresh.origin)):\n            info.update(status=\'identity_or_lifecycle_changed\')\n            info[\'total_ms\'] = max(0., self.clock()-began)*1000\n            return None, info\n        point=next((p for p in fresh.aim_points if p.key==target.aim_id),None)\n        try:\n            radius=float(point.radius) if point is not None else 0.\n            position=tuple(float(v) for v in point.position) if point is not None else ()\n        except (TypeError,ValueError,OverflowError): radius=0.;position=()\n        if (point is None or point.part!=target.aim_part or len(position)!=3 or\n                not finite(position) or not math.isfinite(radius) or radius<=0):\n            info.update(status=\'point_missing\')\n            info[\'total_ms\'] = max(0., self.clock()-began)*1000\n            return None, info\n        if target.visibility not in (\'visible\',\'penetrable\',\'blocked\'):\n            info.update(status=\'path_invalid\')\n            info[\'total_ms\'] = max(0., self.clock()-began)*1000\n            return None, info\n        verdict=target.visibility\n        if (type(fresh.pose_sample_stamp) not in (int,float) or\n                not began<=fresh.pose_sample_stamp<=self.clock() or\n                self.clock()-fresh.pose_sample_stamp>MAX_TARGET_AGE):\n            info.update(status=\'refresh_stamp_invalid\',total_ms=(self.clock()-began)*1000)\n            return None,info\n        fresh.enemy=target.enemy\n        fresh.aim_points=[replace(point,position=position,radius=radius)];fresh.aim_points_validated=True\n        point=fresh.aim_points[0]\n        if verdict==\'penetrable\' and not cfg.tab_force_fire:\n            packet=wall() if callable(wall) else wall or {}\n            signal,reason=signal_for(reader,frame,fresh,packet if cfg.walls else {},self.clock())\n            if signal is None:\n                info[\'wall_reject_reason\']=reason\n                info.update(status=\'wall_revoked\',total_ms=(self.clock()-began)*1000)\n                return None,info\n            info.update(wall_signal_age_ms=signal.get(\'age_ms\'),\n                wall_validation=\'identity_and_revocation_only\',secondary_penetration_checks=0)\n        sampled_point=tuple(point.position);old_eye=tuple(frame.eye)\n        if self.motion is not None:\n            try:\n                current=reader.control_motion_view(frame)\n            except (MemoryError, NotReady, ValueError, OSError, TypeError) as ex:\n                info.update(status=\'motion_camera_unavailable\',error=str(ex),total_ms=(self.clock()-began)*1000)\n                return None,info\n            # Same private frame and ray endpoint through selection, readback and DOWN.\n            frame.eye=current.eye;frame.angles=current.angles;frame.punch=current.punch\n            frame.local=current.local;frame.control_provenance=current.control_provenance\n            position,motion=self.motion.predict(frame,fresh,point,self.clock(),\n                \'t_force\' if cfg.tab_force_fire else verdict)\n            info[\'motion_compensation\']=motion\n            point=replace(point,position=position);fresh.aim_points=[point]\n        moved=(tuple(point.position)!=tuple(target.head) or tuple(fresh.origin)!=tuple(target.origin)\n               or tuple(frame.eye)!=old_eye)\n        ray_required=bool(frame.control_provenance.get(\'follow_ray_required\'))\n        if not cfg.tab_force_fire and verdict != \'penetrable\' and (moved or ray_required):\n            ray_started=self.clock()\n            key=(fresh.index,fresh.address,fresh.serial,fresh.model)\n            rows=[(key,fresh.origin,[tuple(point.position)])]\n            result,_=self.native.trace(frame,rows)\n            info[\'ray_ms\']=max(0.,self.clock()-ray_started)*1000\n            valid=(len(result)==1 and tuple(result[0][0])==key and\n                   tuple(result[0][1])==tuple(fresh.origin) and\n                   tuple(result[0][2])==tuple(frame.eye) and result[0][3]==frame.stamp and\n                   result[0][4] in (\'visible\',\'blocked\') and\n                   (result[0][4]==\'visible\')==bool(result[0][5]) and\n                   all(tuple(p)==tuple(point.position) for p in result[0][5]))\n            if not valid:\n                info.update(status=\'ray_reply_mismatch\')\n                info[\'total_ms\']=max(0.,self.clock()-began)*1000\n                return None,info\n            verdict=result[0][4]\n            if verdict==\'blocked\' and target.visibility==\'visible\' and not cfg.tab_force_fire:\n                info.update(status=\'current_ray_blocked\')\n                info[\'total_ms\']=max(0.,self.clock()-began)*1000\n                return None,info\n            if verdict not in (\'visible\',\'blocked\'):\n                info.update(status=\'ray_invalid\')\n                info[\'total_ms\']=max(0.,self.clock()-began)*1000\n                return None,info\n        for candidate in fresh.aim_points:\n            candidate.visibility=verdict if candidate.key==point.key else \'blocked\'\n            candidate.penetrable=verdict==\'penetrable\' if candidate.key==point.key else False\n            candidate.penetration=public_path(candidate.visibility,\n                allow_blocked=bool(cfg.tab_force_fire))\n        selected=select_aim_view(frame,fresh,getattr(self,\'weapon\',{}),self.clock(),point.key,\n            require_safe=True,allow_blocked=bool(cfg.tab_force_fire))\n        if selected is None:\n            info.update(status=\'current_point_unsafe\',total_ms=(self.clock()-began)*1000)\n            return None,info\n        if not 0<=self.clock()-selected.pose_sample_stamp<=MAX_TARGET_AGE:\n            info.update(status=\'refresh_expired\',total_ms=(self.clock()-began)*1000)\n            return None,info\n        info.update(status=\'refreshed\',pose_reused=False,pose_stamp=selected.pose_sample_stamp,\n                    ranked_point=tuple(target.head),refreshed_point=sampled_point,\n                    final_aim_ray_point=tuple(point.position),\n                    pose_cache_evidence=dict(getattr(selected,\'pose_cache_evidence\',{})),\n                    pose_age_ms=max(0.,self.clock()-selected.pose_sample_stamp)*1000,\n                    pose_shift_units=math.dist(tuple(target.head),sampled_point),\n                    total_ms=max(0.,self.clock()-began)*1000,\n                    ray_basis=\'t_force_visibility_bypass\' if cfg.tab_force_fire else\n                        \'producer_positive_bit\' if verdict==\'penetrable\' else\n                        \'refreshed_point_ray\' if moved or ray_required else \'same_cycle_same_endpoint\')\n        return selected, info\n\n    def update(self, reader, frame, cfg, wall, follow=False):\n        from aim_geometry import (candidate_points, head_point_key, protect_hostages,\n                                hostage_is_nearby,hostage_safe_points)\n        from aim_decision import public_path, apply_positive_signals\n        from target_rules import target_is_active, entity_kind\n        from geometry import finite\n        rows = []; actors = {}; now = self.clock()\n        protected=tuple(frame.protected)\n        # Independent control applies the user\'s local 15 m policy after the\n        # latest camera read. Keep far volumes in the snapshot: the player can\n        # cross 15 m while automatic input is held and the next scan is running.\n        nearby=[h for h in protected if hostage_is_nearby(frame.eye,h)] if protect_hostages(frame.mode) else []\n        if not protect_hostages(frame.mode):frame.protected=[]\n        hostage_ms=0.;filtered=0\n        for actor in frame.entities:\n            actor.visibility = \'blocked\'; actor.display_penetration = {}\n            actor.esp_visible_points = (); actor.display_visibility_stamp = 0.\n            actor.wall_penetrable = False; actor.penetration = {}\n            for point in actor.aim_points:\n                point.visibility = \'blocked\'; point.penetrable = False; point.penetration = {}\n            if (not actor.enemy or not target_is_active(actor)\n                    or (not cfg.aim_npcs and entity_kind(actor.classname) == \'npc\')): continue\n            points = sorted(candidate_points(actor),\n                key=lambda p: (p.part != \'head\', *head_point_key(frame.eye, p, {},spread_hint=None)))\n            if protect_hostages(frame.mode):\n                guard_started=self.clock()\n                before=len(points)\n                reach=float(getattr(self,\'weapon\',{}).get(\'Range\',8192.))\n                points=hostage_safe_points(frame.eye,points,nearby,reach)\n                filtered+=before-len(points);hostage_ms+=(self.clock()-guard_started)*1000\n                # Wall results cannot reintroduce a point rejected by the\n                # current camera\'s hostage corridor.\n                actor.aim_points=points;actor.aim_points_validated=True\n                if not points:actor.head=None\n            positions = list(dict.fromkeys(tuple(p.position) for p in points if finite(p.position)))\n            if not positions: continue\n            key = (actor.index, actor.address, actor.serial, actor.model)\n            actors[key] = actor; rows.append([key, actor.origin, positions])\n        # Apply the producer\'s current positive bit before constructing the\n        # native batch. A valid