       from server_visibility import local_connection\n        if not local_connection(self.reader):raise RuntimeError(\'联机服务器未提供本地主机手雷数据\')\n        started=time.perf_counter();now=time.monotonic();m=self.reader.mem;s=self.base\n        changed=invalid=0\n        if now-self.scan_time>=.04:\n            rows,issue=self.active_entries();slots={};projectiles=[];classes={};unresolved=0;errors=[]\n            if issue:errors.append(issue)\n            for index,p,serial in rows:\n                previous=self.slots.get(index)\n                try:\n                    if previous and previous[:2]==(p,serial) and len(previous)>=5 and (previous[2] or now-previous[3]<.10):\n                        is_he,name,checked=previous[2],previous[4],previous[3]\n                    else:is_he,name=self.classify(p);checked=now\n                    if is_he is None:unresolved+=1;continue\n                    slots[index]=(p,serial,is_he,checked,name)\n                    if \'projectile\' in name:classes[name]=classes.get(name,0)+1\n                    if is_he:projectiles.append((index,p,serial))\n                except Exception as ex:\n                    if len(errors)<4:errors.append(f\'#{index} 分类：{type(ex).__name__}: {str(ex)[:120]}\')\n                    unresolved+=1\n            if issue:\n                # A concurrent unlink must not erase other known live flights.\n                # The full pointer/serial pair is checked below, never replayed.\n                known={index for index,p,serial in projectiles}\n                projectiles.extend(row for row in self.projectiles if row[0] not in known)\n            self.slots=slots;self.projectiles=projectiles\n            self.scan_time=now-(.032 if issue else 0.)\n            self.scan_classes=classes;self.unresolved=unresolved;self.scan_errors=errors\n        errors=list(getattr(self,\'scan_errors\',[]));result=[];rejections={};rejected_samples=[]\n        for index,p,serial in self.projectiles:\n            entry=s+0xa5