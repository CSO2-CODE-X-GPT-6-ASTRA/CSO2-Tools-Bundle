_EMBEDDED['process_response_contract'] = (1, '"""Process lifecycle, observation parity, bounded transport and trace freshness."""\nimport copy,io,json,os,queue,tempfile,time,unittest\nfrom pathlib import Path\nfrom types import SimpleNamespace as NS\nfrom unittest.mock import patch\n\ndef run():\n    from log_process import (LogProcess,snapshot_frame,encode_packet,read_packet,write_packet,\n                             MAX_BYTES,MAX_PACKET,FRAME_LIMIT,QUEUE_LIMIT)\n    from maintenance_contract import weapon_frame\n    from cso2_bot_tool import Config\n    from wall_service import WallService\n    from compact_log import DETAIL_BYTES,SUMMARY_BYTES,RECENT_BYTES,DecisionTotals\n    def control(actions=()):\n        rows=list(actions)\n        def drain():result=list(rows);rows.clear();return result\n        return NS(target=3,pressed=False,reason=\'fixture\',diagnostic={},drain_actions=drain)\n    def wait_for(predicate,timeout=8.):\n        end=time.monotonic()+timeout\n        while time.monotonic()<end:\n            if predicate():return\n            time.sleep(.01)\n        raise AssertionError(\'Timed out waiting for child process\')\n    def captured():\n        with patch(\'threading.Thread.start\'):\n            return LogProcess(\'.\',(),entry=BUNDLE_ENTRY)\n    def wall():\n        w=WallService.__new__(WallService);w.events=queue.Queue();w.requests=queue.Queue(1)\n        w.closed=False;w.busy=True;w.proc=NS(poll=lambda:None);w.ready=True\n        w.pending_since=time.monotonic();w.latest_pending=None;w.pending_replaced=0\n        w.pending_expired=0;w.submit_dropped=0;w.failures=0;w.next_retry=0.\n        return w\n\n    class Tests(unittest.TestCase):\n        def test_snapshot_excludes_handles_and_large_aim_geometry(self):\n            f,e=weapon_frame();f.mem=object();e.handle=object();e.aim_points=[object()]*100\n            out=snapshot_frame(f)\n            self.assertFalse(hasattr(out,\'mem\'));self.assertFalse(hasattr(out.entities[0],\'aim_points\'))\n            self.assertEqual(out.local.serial,f.local.serial)\n            self.assertEqual(len(out.entities[0].skeleton),len(e.skeleton))\n\n        def test_snapshot_is_frozen_before_background_transport(self):\n            log=captured();f,e=weapon_frame();c=control();c.diagnostic={\'value\':[1]}\n            log.frame(f,c,1.,2.,Config(),{\'Damage\':30})\n            c.diagnostic[\'value\'][0]=900;e.health=0;f.weapon_state[\'handle\']=999\n            message=read_packet(io.BytesIO(log._items[0][1]));snap,ctrl,*_=message[\'args\']\n            self.assertEqual(ctrl.diagnostic[\'value\'],[1]);self.assertNotEqual(snap.entities[0].health,0)\n            self.assertNotEqual(snap.weapon_state[\'handle\'],999)\n\n        def test_backpressure_reserves_room_for_native_damage_and_actions(self):\n            log=captured()\n            for i in range(FRAME_LIMIT):self.assertTrue(log._send(\'event\',(\'x\',{})))\n            self.assertFalse(log._send(\'event\',(\'extra\',{})))\n            self.assertTrue(log._send(\'native\',([dict(kind=\'player_hurt\')],),True))\n            f,e=weapon_frame();log.frame(f,control([dict(action=\'fire_down\')]),1.,2.,Config())\n            message=read_packet(io.BytesIO(log._items[-1][1]));self.assertEqual(message[\'op\'],\'actions\')\n            self.assertEqual(message[\'args\'][0][0][\'action\'],\'fire_down\')\n            self.assertLessEqual(log._bytes,MAX_BYTES);self.assertLessEqual(len(log._items),QUEUE_LIMIT)\n\n        def test_packet_byte_limit_and_encode_errors_are_reported(self):\n            log=captured()\n            for i in range(12):log._send(\'event\',(\'fixture\',{\'x\':\'a\'*(MAX_PACKET-10000)}),True)\n            self.assertLessEqual(log._bytes,MAX_BYTES);self.assertGreater(log.dropped,0)\n            self.assertFalse(log._send(\'event\',(\'large\',{\'x\':\'a\'*(MAX_PACKET+1)})))\n            self.assertGreater(log.serialization_failures,0)\n\n        def test_decoder_rejects_unexpected_classes_and_truncated_packet(self):\n            for packet in (encode_packet({\'x\':Path(\'.\')}),b\'\\xff\\xff\\xff\\xff\',b\'\\x05\\x00\\x00\\x00ab\'):\n                with self.assertRaises((ValueError,EOFError)):read_packet(io.BytesIO(packet))\n\n        def test_short_pipe_writes_preserve_complete_message(self):\n            class Short:\n                def __init__(self):self.data=bytearray()\n                def write(self,data):self.data.extend(data[:7]);return min(7,len(data))\n                def flush(self):pass\n            stream=Short();write_packet(stream,encode_packet({\'map\':\'意大利\'}))\n            self.assertEqual(read_packet(io.BytesIO(stream.data)),{\'map\':\'意大利\'})\n\n        def test_real_child_observation_damage_and_shutdown(self):\n            with tempfile.TemporaryDirectory(prefix=\'bot_process_\') as tmp:\n                log=LogProcess(tmp,(),entry=BUNDLE_ENTRY);f,e=weapon_frame();cfg=Config()\n                f.map_name=\'maps/CS_ITALY.bsp\';f.weapon=\'CWeaponUSP\';f.weapon_state[\'classname\']=f.weapon\n                try:\n                    log.frame(f,control([dict(action=\'fire_down\')]),1.,2.,cfg,{\'Damage\':28})\n                    g=copy.deepcopy(f);g.stamp+=.02;g.ammo-=1\n                    log.frame(g,control(),1.,2.,cfg,{\'Damage\':28})\n                    log.native([dict(kind=\'player_hurt\',local_index=f.local.index,\n                        attacker_index=f.local.index,victim_index=3,damage=49,health=51,hitgroup=1,\n                        weapon=\'usp\',armor=0,tick=99)])\n                    wait_for(lambda:log.current is not None)\n                    self.assertNotEqual(log.proc.pid,os.getpid())\n                finally:log.close()\n                self.assertFalse(log.thread.is_alive());self.assertFalse(log.error,log.error)\n                files=list(Path(tmp).glob(\'*.summary.json\'));self.assertEqual(len(files),1)\n                s=json.loads(files[0].read_text(\'utf-8\'));self.assertTrue(s[\'finished\'])\n                self.assertEqual(s[\'fire_requests\'],1);self.assertEqual(s[\'observed_rounds\'],1)\n                self.assertEqual(s[\'confirmed_damage_events\'],1);self.assertEqual(s[\'confirmed_head_damage_events\'],1)\n                self.assertEqual(s[\'log_process\'][\'backend\'],\'independent_process\')\n                self.assertEqual(s[\'log_process\'][\'dropped_messages\'],0)\n                self.assertLessEqual(s[\'logging\'][\'per_match_max_bytes\'],DETAIL_BYTES+SUMMARY_BYTES+RECENT_BYTES)\n\n        def test_real_child_preserves_map_and_weapon_boundaries(self):\n            with tempfile.TemporaryDirectory(prefix=\'bot_log_scope_\') as tmp:\n                log=LogProcess(tmp,(),entry=BUNDLE_ENTRY);f,e=weapon_frame();cfg=Config()\n                try:\n                    log.frame(f,control(),1.,2.,cfg)\n                    f=copy.deepcopy(f);f.ammo=2;f.stamp+=.02;f.weapon_state[\'handle\']+=1\n                    log.frame(f,control(),1.,2.,cfg)\n                    f=copy.deepcopy(f);f.ammo=1;f.stamp+=.02;f.map_name=\'maps/DE_STORAGE.bsp\'\n                    log.frame(f,control(),1.,2.,cfg)\n                finally:log.close()\n                self.assertFalse(log.error,log.error)\n                rows=[json.loads(p.read_text(\'utf-8\')) for p in Path(tmp).glob(\'*.summary.json\')]\n                self.assertEqual(len(rows),2);self.assertEqual(sum(s[\'observed_rounds\'] for s in rows),0)\n                self.assertTrue(all(s[\'finished\'] for s in rows))\n\n        def test_child_exit_restarts_without_control_wait(self):\n            with tempfile.TemporaryDirectory(prefix=\'bot_log_restart_\') as tmp:\n                log=LogProcess(tmp,(),entry=BUNDLE_ENTRY)\n                try:\n                    wait_for(lambda:log.child_status.get(\'pid\'))\n                    first=log.proc.pid;log.proc.kill()\n                    wait_for(lambda:log.child_status.get(\'pid\') not in (None,first))\n                    f,e=weapon_frame();log.frame(f,control(),1.,2.,Config())\n                    wait_for(lambda:log.current is not None)\n                    self.assertGreaterEqual(log.restarts,1)\n                finally:log.close()\n                self.assertFalse(log.thread.is_alive());self.assertIsNone(log.proc)\n\n        def test_stalled_pipe_is_killed_by_independent_watchdog(self):\n            with tempfile.TemporaryDirectory(prefix=\'bot_log_stall_\') as tmp:\n                entry=Path(tmp)/\'stalled.py\';entry.write_text(\'import time\\ntime.sleep(60)\\n\',\'utf-8\')\n                log=LogProcess(tmp,(),entry=entry)\n                try:\n                    wait_for(lambda:log.proc is not None);first=log.proc\n                    start=time.monotonic()\n                    for _ in range(20):log.event(\'fixture\',data=\'x\'*100000)\n                    self.assertLess(time.monotonic()-start,1.)\n                    log.last_reply=time.monotonic()-6.\n                    wait_for(lambda:first.poll() is not None,2.)\n                finally:\n                    log._stop.set()\n                    if log.proc:log.proc.kill()\n                    log.close()\n                self.assertFalse(log.thread.is_alive())\n\n        def test_latest_wall_snapshot_replaces_pending_then_dispatches(self):\n            w=wall();f,e=weapon_frame();f.stamp=time.monotonic()\n            self.assertTrue(w.submit(f.eye,[e],{},f,False))\n            f.stamp=time.monotonic();self.assertTrue(w.submit(f.eye,[e],{},f,False))\n            self.assertEqual(w.pending_replaced,1);self.assertTrue(w.requests.empty())\n            expected=w.latest_pending[\'stamp\'];w.events.put({\'results\':[]});w.poll()\n            self.assertTrue(w.busy);self.assertIsNone(w.latest_pending)\n            self.assertEqual(w.requests.get_nowait()[\'stamp\'],expected)\n\n        def test_stale_wall_pending_never_reaches_worker(self):\n            w=wall();w.latest_pending={\'stamp\':time.monotonic()-.2};w.events.put({\'results\':[]})\n            w.poll();self.assertTrue(w.requests.empty());self.assertEqual(w.pending_expired,1)\n\n        def test_weapon_switch_discards_old_pending_and_response(self):\n            w=wall();f,e=weapon_frame();f.stamp=time.monotonic()\n            w.submit(f.eye,[e],{\'profile_hash\':\'a\'},f,False)\n            old=w.latest_pending[\'scope\'];f.weapon_state[\'handle\']+=1\n            w.events.put({\'results\':[[\'old\']], \'scope\':old})\n            self.assertEqual(w.poll(f,{\'profile_hash\':\'a\'}),[])\n            self.assertTrue(w.requests.empty());self.assertEqual(w.pending_expired,1)\n\n        def test_profile_change_discards_old_wall_response(self):\n            from wall_service import wall_scope\n            w=wall();f,e=weapon_frame()\n            w.events.put({\'results\':[[\'old\']], \'scope\':wall_scope(f,{\'profile_hash\':\'a\'})})\n            self.assertEqual(w.poll(f,{\'profile_hash\':\'b\'}),[])\n\n        def test_retiring_wall_process_discards_pending(self):\n            w=wall();w.latest_pending={\'stamp\':time.monotonic()};w.proc=None\n            w._retire();self.assertIsNone(w.latest_pending);self.assertFalse(w.ready)\n\n        def test_slow_nearest_blocked_probe_yields_next_tick(self):\n            from combat37_contract import scene\n            from combat36_contract import USP\n            from dataclasses import replace\n            from aim_points import AimPoint\n            f=scene(p=USP,generic=False,distance=550.);e=f.reader.entity\n            for i in (3,4):\n                f.frame.entities.append(replace(e,index=i,address=i*0x10000,\n                    head=(550.,float(i),64.),aim_points=[AimPoint(\'head\',\'head\',(550.,float(i),64.),3.,0)]))\n            w=WallService.__new__(WallService);w.fast_bsp=NS();calls=[]\n            def slow(frame,entity,*args,**kwargs):\n                calls.append(entity.index)\n                for point in entity.aim_points:\n                    point.visibility=\'blocked\';point.penetration=dict(kind=\'blocked\',allowed=False)\n                time.sleep(.006);return 1\n            w.refresh_target=slow;w.refresh_candidates(f.frame,f.cfg,f.weapon)\n            first=calls[-1];self.assertTrue(w.fast_starved)\n            w.refresh_candidates(f.frame,f.cfg,f.weapon)\n            self.assertNotEqual(calls[-1],first)\n\n        def test_visible_nearest_does_not_activate_starvation_rotation(self):\n            from combat37_contract import scene\n            from combat36_contract import USP\n            from dataclasses import replace\n            f=scene(p=USP,generic=False,distance=550.);e=f.reader.entity\n            f.frame.entities.extend(replace(e,index=i,address=i*0x10000,head=(550.,float(i),64.)) for i in (3,4))\n            w=WallService.__new__(WallService);w.fast_bsp=NS()\n            def clear(frame,entity,*args,**kwargs):\n                for point in entity.aim_points:\n                    point.visibility=\'visible\';point.penetration=dict(kind=\'clear\',allowed=True)\n                return 1\n            w.refresh_target=clear;w.refresh_candidates(f.frame,f.cfg,f.weapon)\n            self.assertTrue(w.fast_metrics[\'direct_found\']);self.assertFalse(w.fast_starved)\n\n        def test_stage_metrics_separate_async_trace_from_control(self):\n            f,e=weapon_frame();c=control();d=DecisionTotals()\n            d.observe(f,c,{\'loop_stages_ms\':{\'client_sample\':20.,\'wall_dispatch\':.2,\'control\':4.}},20.,18.)\n            s=d.snapshot();self.assertEqual(s[\'loop_stages_ms\'][\'wall_dispatch\'][\'mean\'],.2)\n            self.assertEqual(s[\'loop_stages_ms\'][\'control\'][\'mean\'],4.)\n            self.assertEqual(s[\'metrics\'][\'trace_ms\'][\'mean\'],18.)\n\n        def test_worker_transport_and_existing_cpu_plan_cover_log_process(self):\n            from worker_transport import WORKER_SWITCHES\n            from cpu_partition import SWITCHES,ROLES\n            self.assertIn(\'--log-worker\',WORKER_SWITCHES)\n            self.assertEqual(SWITCHES[\'--log-worker\'],\'esp_wall\')\n            self.assertEqual(len(ROLES),5)\n\n    output=io.StringIO();result=unittest.TextTestRunner(stream=output,verbosity=2).run(\n        unittest.defaultTestLoader.loadTestsFromTestCase(Tests))\n    if not result.wasSuccessful():raise AssertionError(output.getvalue())\n    return dict(passed=True,tests=result.testsRun,real_child_processes=True,\n                game_attached=False,game_input=False,live_latency_verified=False)\n')

_EMBEDDED['model_support'] = (1, '"""Structural model capability; no character-name allowlist or guessed aim point."""\nimport math\nimport struct\n\n\nclass UnsupportedModel(ValueError):\n    pass\n\n\ndef studio_header(header):\n    if len(header) < 180:\n        raise ValueError(\'studio header incomplete\')\n    if header[:4] == b\'\\0\'*4:\n        raise ValueError(\'studio header not ready\')\n    if header[:4] != b\'IDST\':\n        raise UnsupportedModel(\'studio format not supported\')\n    version = struct.unpack_from(\'<i\', header, 4)[0]\n    if version == 0:\n        raise ValueError(\'studio version not ready\')\n    if version not in range(44, 50):\n        raise UnsupportedModel(\'studio version not supported: \' + str(version))\n    return header[12:76].split(b\'\\0\')[0].decode(\'utf-8\', \'replace\')\n\n\ndef validate_rig(parents, boxes):\n    count = len(parents)\n    done = set()\n    for bone, parent in enumerate(parents):\n        if not -1 <= parent < count or parent == bone:\n            raise ValueError(\'bone parent invalid\')\n        path = set()\n        i = bone\n        while i >= 0 and i not in done:\n            if i in path:\n                raise ValueError(\'bone hierarchy cycle\')\n            path.add(i)\n            i = parents[i]\n            if not -1 <= i < count:\n                raise ValueError(\'bone parent invalid\')\n        done.update(path)\n    for bone, group, bounds in boxes:\n        if (not 0 <= bone < count or len(bounds) != 6\n                or not all(math.isfinite(v) for v in bounds)\n                or any(bounds[i] > bounds[i+3] for i in range(3))):\n            raise ValueError(\'hitbox values invalid\')\n\n\ndef adapt_hitboxes(parents, boxes):\n    """Isolate inverted legacy boxes when a complete native head box survives.\n\n    Never reorder corners or expand boxes: that would invent hittable space.\n    Invalid bone references, nonfinite data and hierarchy errors remain fatal.\n    """\n    validate_rig(parents, [])\n    for bone, group, bounds in boxes:\n        if not 0 <= bone < len(parents) or len(bounds) != 6 or not all(math.isfinite(v) for v in bounds):\n            raise ValueError(\'hitbox values invalid\')\n    inverted = any(any(bounds[i] > bounds[i+3] for i in range(3)) for _, _, bounds in boxes)\n    if not inverted:\n        validate_rig(parents, boxes)\n        return boxes, 0\n    usable = [(bone, group, bounds) for bone, group, bounds in boxes\n              if all(.02 < bounds[i+3]-bounds[i] < 4096 for i in range(3))]\n    if not any(group == 1 for _, group, _ in usable):\n        raise ValueError(\'hitbox values invalid\')\n    validate_rig(parents, usable)\n    return usable, len(boxes)-len(usable)\n\n\ndef inspect_mdl(raw):\n    """Check the same studio format used by both readers, including body-only rigs."""\n    def block(offset, size):\n        if offset < 0 or size < 0 or offset + size > len(raw):\n            raise ValueError(\'model data truncated\')\n        return raw[offset:offset+size]\n    try:\n        name = studio_header(block(0, 180))\n        count, offset = struct.unpack_from(\'<ii\', raw, 156)\n        sets, start = struct.unpack_from(\'<ii\', raw, 172)\n        if count == 0 and 0 <= sets <= 64 and len(raw) >= 240:\n            bodyparts = struct.unpack_from(\'<i\', raw, 232)[0]\n            empty_sets = not sets or (start >= 180 and all(\n                struct.unpack(\'<iii\', block(start+i*12,12))[1] == 0 for i in range(sets)))\n            if bodyparts == 0 and empty_sets:\n                return dict(state=\'auxiliary\', model=name, reason=\'animation_library\')\n        if not 1 <= count <= 256 or not 180 <= offset <= 16*1024*1024:\n            raise UnsupportedModel(\'bone layout not supported\')\n        if not 0 <= sets <= 64 or (sets and start < 180):\n            raise UnsupportedModel(\'hitbox layout not supported\')\n        data = block(offset, count*216)\n        parents = []\n        for i in range(count):\n            name_offset, parent = struct.unpack_from(\'<ii\', data, i*216)\n            if not 0 < name_offset < 16*1024*1024:\n                raise ValueError(\'bone name offset invalid\')\n            at = offset+i*216+name_offset\n            if not block(at, 1) or raw.find(b\'\\0\', at, min(len(raw), at+96)) < 0:\n                raise ValueError(\'bone name incomplete\')\n            parents.append(parent)\n        box_count = 0; discarded = 0\n        for active in range(sets):\n            base = start+active*12\n            _, n, off = struct.unpack(\'<iii\', block(base, 12))\n            if not 0 <= n <= 256 or (n and off < 12):\n                raise UnsupportedModel(\'hitbox set not supported\')\n            data = block(base+off, n*68) if n else b\'\'\n            boxes = [(*struct.unpack_from(\'<ii\', data, i*68),\n                      struct.unpack_from(\'<6f\', data, i*68+8)) for i in range(n)]\n            boxes, omitted = adapt_hitboxes(parents, boxes)\n            discarded += omitted\n            box_count += len(boxes)\n        validate_rig(parents, [])\n        return dict(state=\'supported\', model=name, bones=count, hitboxes=box_count,\n                    discarded_hitboxes=discarded,\n                    precision=\'native_hitboxes_filtered\' if discarded else (\'native_hitboxes\' if box_count else \'skeleton_only\'))\n    except UnsupportedModel as exc:\n        return dict(state=\'unsupported\', reason=str(exc))\n    except (ValueError, struct.error) as exc:\n        return dict(state=\'invalid\', reason=str(exc))\n\n\ndef entity_status(entity):\n    return (getattr(entity, \'pose_diagnostic\', None) or {}).get(\'model_support\', \'\')\n')
_EMBEDDED['resource_catalog'] = (1, '"""Optional client asset inventory. Runs off the UI/control loops; never gates startup."""\nimport csv\nimport io\nimport json\nimport math\nimport os\nimport struct\nimport threading\nimport time\nfrom pathlib import Path\nfrom model_support import inspect_mdl\n\n\ndef asset_key(name):\n    name = str(name).replace(\'\\\\\', \'/\').lower().lstrip(\'/\')\n    if name.startswith(\'cstrike/\'):\n        name = name[8:]\n    if \':\' in name or \'..\' in name.split(\'/\'):\n        raise ValueError(\'asset path invalid\')\n    return name\n\n\ndef wanted(name):\n    return ((name.startswith(\'maps/\') and name.endswith(\'.bsp\')) or\n            (name.startswith(\'models/player/\') and name.endswith(\'.mdl\')) or\n            name == \'scripts/characters.csv\')\n\n\ndef character_paths(raw):\n    lines = raw.decode(\'utf-8-sig\').splitlines()\n    start = next((i for i, line in enumerate(lines) if line.startswith(\'resname,classid,\')), None)\n    if start is None:\n        raise ValueError(\'character table header not recognized\')\n    paths = {}\n    for row in csv.DictReader(io.StringIO(\'\\n\'.join(lines[start:]))):\n        name = row.get(\'worldmodel\') or \'\'\n        if not name.strip():\n            continue\n        key = asset_key(name.strip())\n        if key.startswith(\'models/player/\') and key.endswith(\'.mdl\'):\n            paths[key] = row.get(\'resname\') or Path(key).stem\n    return paths\n\n\nclass AssetScanner:\n    def __init__(self):\n        self.headers = {}\n        self.models = {}\n\n    def inventory(self, game, cancelled):\n        from pkg_assets import read_header\n        entries = {}\n        issues = []\n        present = set()\n        for path in sorted((game/\'Data\').glob(\'*.pkg\')):\n            if cancelled():\n                return {}, [], True\n            key = str(path)\n            present.add(key)\n            try:\n                stat = path.stat()\n                stamp = (stat.st_size, stat.st_mtime_ns, stat.st_ctime_ns)\n                old = self.headers.get(key)\n                if old and old[0] == stamp:\n                    records = old[1]\n                else:\n                    _, rows = read_header(path)\n                    records = {asset_key(r[\'name\']): r for r in rows if wanted(asset_key(r[\'name\']))}\n                    self.headers[key] = (stamp, records)\n                for name, record in records.items():\n                    entries[name] = (\'package\', record)\n            except (OSError, ValueError, struct.error, UnicodeError) as exc:\n                self.headers.pop(key, None)\n                issues.append(dict(kind=\'package\', state=\'unreadable\', name=path.name, file=path.name, reason=str(exc)))\n            time.sleep(0)  # Yield between archives; never monopolize startup.\n        self.headers = {k: v for k, v in self.headers.items() if k in present}\n        # Loose custom assets override packaged defaults, like the client mount.\n        for base in (game/\'Data/cstrike\', game/\'cstrike\', game, game/\'custom\'):\n            for folder, suffix in ((\'maps\', \'*.bsp\'), (\'models/player\', \'*.mdl\'), (\'scripts\', \'characters.csv\')):\n                for path in sorted((base/folder).rglob(suffix)):\n                    if cancelled():\n                        return {}, [], True\n                    entries[asset_key(path.relative_to(base).as_posix())] = (\'file\', path)\n        return entries, issues, False\n\n    def read(self, game, entry):\n        from pkg_assets import extract\n        kind, value = entry\n        size = value.stat().st_size if kind == \'file\' else value[\'size\']\n        if size > 32*1024*1024:\n            raise ValueError(\'model or character table exceeds scan size limit\')\n        return value.read_bytes() if kind == \'file\' else extract(game, value)\n\n    def scan(self, game, cancelled=lambda: False):\n        from collision_cache_io import data_snapshot\n        from wall_capability import inspect_map\n        game = Path(game).resolve()\n        began = time.monotonic()\n        report = dict(game=str(game), state=\'ready\', maps={}, models={}, issues=[],\n                      game_attached=False, game_input=False)\n        if not game.is_dir():\n            report[\'state\'] = \'directory_missing\'\n            return report\n        entries, issues, stopped = self.inventory(game, cancelled)\n        if stopped:\n            return None\n        report[\'issues\'].extend(issues)\n        maps = sorted({Path(k).stem for k in entries if k.startswith(\'maps/\')})\n        # Pin the external index, but each installed map keeps its own result.\n        try:\n            with data_snapshot(refresh=True):\n                for name in maps:\n                    if cancelled():\n                        return None\n                    state = inspect_map(name)\n                    report[\'maps\'][name] = state\n                    if not state[\'available\']:\n                        report[\'issues\'].append(dict(kind=\'map\', name=name, state=state[\'state\'],\n                            file=state.get(\'resource_relative\', \'\'), reason=state.get(\'error\', \'\')))\n                    time.sleep(0)\n        except (OSError, ValueError, TypeError, KeyError) as exc:\n            for name in maps:\n                report[\'maps\'][name] = dict(state=\'invalid\', available=False)\n            report[\'issues\'].append(dict(kind=\'wall_index\', state=\'invalid\', name=\'wall_data_index.json\',\n                                         file=\'wall_data_index.json\', reason=str(exc)))\n        paths = {}\n        if \'scripts/characters.csv\' in entries:\n            try:\n                paths = character_paths(self.read(game, entries[\'scripts/characters.csv\']))\n            except (OSError, ValueError, KeyError, UnicodeError) as exc:\n                report[\'issues\'].append(dict(kind=\'catalog\', state=\'invalid\', name=\'characters.csv\',\n                    file=\'scripts/characters.csv\', reason=str(exc)))\n        declared = set(paths)\n        report[\'auxiliary_models\'] = 0\n        # New models need no hard-coded name registration. Ignore first-person hands.\n        for key in entries:\n            if key.startswith(\'models/player/\') and key.endswith(\'.mdl\') and not any(\n                    part in (\'hand\', \'hands\', \'arms\') for part in key.split(\'/\')):\n                paths.setdefault(key, Path(key).stem)\n        used = set()\n        for key, name in sorted(paths.items()):\n            if cancelled():\n                return None\n            state = dict(state=\'unverified\' if issues else \'missing\', reason=\'referenced model not found\')\n            if key in entries:\n                try:\n                    import hashlib\n                    raw = self.read(game, entries[key])\n                    digest = hashlib.sha256(raw).hexdigest()\n                    used.add(digest)\n                    state = self.models.get(digest)\n                    if state is None:\n                        state = inspect_mdl(raw)\n                        self.models[digest] = state\n                except (OSError, ValueError, KeyError, struct.error) as exc:\n                    state = dict(state=\'unverified\', reason=str(exc))\n            if state[\'state\'] == \'auxiliary\' and key not in declared:\n                report[\'auxiliary_models\'] += 1\n                continue\n            if state[\'state\'] == \'auxiliary\':\n                state = dict(state=\'unsupported\',reason=\'character references an animation library\')\n            report[\'models\'][key] = dict(state, name=name)\n            if state[\'state\'] != \'supported\':\n                report[\'issues\'].append(dict(kind=\'model\', name=name, file=key, **state))\n            time.sleep(0)\n        self.models = {k: v for k, v in self.models.items() if k in used}\n        report[\'partial\'] = bool(issues)\n        report[\'elapsed_ms\'] = round((time.monotonic()-began)*1000, 1)\n        return report\n\n\nclass ClientResources:\n    """One background inventory with epoch rejection, periodic hotplug and bounded storage."""\n    def __init__(self, probe=None, interval=30., report_path=None):\n        self.probe = probe or AssetScanner().scan\n        self.interval = interval\n        self.report_path = Path(report_path) if report_path else None\n        self.lock = threading.Lock()\n        self.epoch = 0\n        self.game = \'\'\n        self.closed = False\n        self.running = False\n        self.next_at = 0.\n        self.result = dict(state=\'idle\', maps={}, models={}, issues=[])\n\n    def update(self, game, force=False):\n        # Path normalization only; no filesystem I/O on the Tk thread.\n        game = os.path.abspath(str(game)) if str(game).strip() else \'\'\n        job = None\n        with self.lock:\n            if os.path.normcase(game) != os.path.normcase(self.game) or force:\n                self.game = game\n                self.epoch += 1\n                self.next_at = 0.\n                self.result = dict(game=game, state=\'scanning\', maps={}, models={}, issues=[])\n            if game and not self.closed and not self.running and time.monotonic() >= self.next_at:\n                self.running = True\n                self.next_at = time.monotonic()+self.interval\n                job = (self.epoch, game)\n            result = self.result\n        if job:\n            try:\n                threading.Thread(target=self._run, args=job, name=\'CSO2-client-resources\', daemon=True).start()\n            except RuntimeError as exc:\n                with self.lock:\n                    self.running = False\n                    self.result = dict(game=game,state=\'scan_error\',error=str(exc),maps={},models={},issues=[])\n        return result\n\n    def _run(self, epoch, game):\n        cancelled = lambda: self.closed or epoch != self.epoch\n        try:\n            result = self.probe(game, cancelled)\n        except Exception as exc:\n            result = dict(game=game, state=\'scan_error\', error=str(exc), maps={}, models={}, issues=[])\n        with self.lock:\n            if cancelled() or result is None:\n                self.running = False\n                return\n            self.result = result\n        # A single replaceable report; disk I/O never holds the UI snapshot lock.\n        if self.report_path:\n            temp = self.report_path.with_suffix(\'.tmp\')\n            try:\n                self.report_path.parent.mkdir(parents=True, exist_ok=True)\n                temp.write_text(json.dumps(result, ensure_ascii=False, indent=2), encoding=\'utf-8\')\n                if not cancelled():os.replace(temp, self.report_path)\n            except OSError:\n                pass\n        with self.lock:\n            self.running = False\n\n    def close(self):\n        with self.lock:\n            self.closed = True\n            self.epoch += 1\n\n\ndef board_lines(report, language=\'zh\'):\n    """Show concrete map/model issues only; healthy or incomplete scans stay quiet."""\n    en = language == \'en\'\n    state = report.get(\'state\', \'idle\')\n    if state != \'ready\':\n        return ()\n    maps, models = report[\'maps\'], report[\'models\']\n    lines = []\n\n    def short_name(value):\n        # Display asset names, never archive names, absolute paths or raw errors.\n        value = str(value or \'\').replace(\'\\\\\', \'/\').rstrip(\'/\').rsplit(\'/\', 1)[-1]\n        if value.lower().endswith((\'.mdl\', \'.bsp\')):\n            value = value.rsplit(\'.\', 1)[0]\n        return \' \'.join(value.split())\n\n    map_states = {\'missing\': (\'外置墙体数据缺失\', \'external wall data missing\'),\n                  \'invalid\': (\'外置墙体数据待修复\', \'external wall data needs repair\'),\n                  \'untrained\': (\'静态墙体未支持\', \'static walls unsupported\'),\n                  \'unsupported\': (\'静态墙体未支持\', \'static walls unsupported\')}\n    model_states = {\'missing\': (\'模型缺失\', \'model missing\'),\n                    \'invalid\': (\'模型结构待适配\', \'model structure needs adaptation\'),\n                    \'unsupported\': (\'模型结构未支持\', \'model structure unsupported\')}\n    for name, item in sorted(maps.items()):\n        if not item.get(\'available\', False) and item.get(\'state\') in map_states:\n            status = map_states[item[\'state\']][en]\n            lines.append((\'Map: \' if en else \'地图：\') + short_name(name) + \' · \' + status)\n    for key, item in sorted(models.items()):\n        if item.get(\'state\') not in model_states:\n            continue\n        model = short_name(key)\n        character = short_name(item.get(\'name\'))\n        name = (character + \' (\' + model + \')\') if character and character.casefold() != model.casefold() else model\n        status = model_states[item[\'state\']][en]\n        if item.get(\'state\') == \'invalid\' and item.get(\'reason\') == \'hitbox values invalid\':\n            status = (\'命中框数据待适配\', \'hitbox data needs adaptation\')[en]\n        lines.append((\'Character model: \' if en else \'人物模型：\') + name + \' · \' + status)\n    # Progress, counts, scan coverage and unknown states remain in the report.\n    # No affirmative all-supported claim is made for an incomplete inventory.\n    return tuple(lines)\n\n\ndef support_lines(report, language=\'zh\'):\n    """The opt-in support view includes counts and named asset issues."""\n    en = language == \'en\'\n    state = report.get(\'state\', \'idle\')\n    if state in (\'idle\', \'scanning\'):\n        return (\'Scanning maps and character models…\' if en else \'正在扫描地图和人物模型…\',)\n    if state != \'ready\':\n        return (\'Resource scan pending; details are in the scan report.\' if en else\n                \'资源扫描待完成；详细原因见扫描报告。\',)\n    maps, models = report[\'maps\'], report[\'models\']\n    good_maps = sum(bool(item.get(\'available\')) for item in maps.values())\n    good_models = sum(item.get(\'state\') == \'supported\' for item in models.values())\n    def rate(count, total):\n        return f\'{count}/{total} ({100*count/total:.1f}%)\' if total else (\'No entries identified\' if en else \'尚未识别到项目\')\n    lines = [(\'Map wall data: \' if en else \'地图墙体支持率：\')+rate(good_maps,len(maps)),\n             (\'Character model structure: \' if en else \'人物模型结构支持率：\')+rate(good_models,len(models))]\n    lines.extend(board_lines(report, language))\n    if report.get(\'partial\') or any(item.get(\'state\') == \'unverified\' for item in models.values()):\n        lines.append(\'Based on identified assets; scan coverage is incomplete.\' if en else\n                     \'支持率按已识别项目统计；扫描覆盖尚未完整。\')\n    return tuple(lines)\n\n\nclass ResourceSupportView:\n    """Manual display or one ten-second notice per newly missing asset."""\n    def __init__(self, clock=time.monotonic):\n        self.clock = clock\n        self.manual = False\n        self.deadline = 0.\n        self.report = None\n        self.game = None\n        self.missing = set()\n\n    def set_manual(self, enabled):\n        self.manual = bool(enabled)\n        # A deliberate click owns the view from this point. Unchecking closes it.\n        self.deadline = 0.\n\n    def update(self, report):\n        now = self.clock()\n        if report is not self.report:\n            self.report = report\n            game = os.path.normcase(str(report.get(\'game\', \'\')))\n            if game != self.game:\n                self.game = game\n                self.missing = set()\n                self.deadline = 0.\n            if report.get(\'state\') == \'ready\':\n                missing = {(\'map\', key) for key, item in report.get(\'maps\', {}).items()\n                           if item.get(\'state\') == \'missing\' and not item.get(\'available\')}\n                missing.update((\'model\', key) for key, item in report.get(\'models\', {}).items()\n                               if item.get(\'state\') == \'missing\')\n                if missing - self.missing and not self.manual:\n                    self.deadline = now + 10.\n                elif not missing:\n                    self.deadline = 0.\n                self.missing = missing\n        remaining = max(0, math.ceil(self.deadline-now)) if not self.manual else 0\n        return dict(visible=self.manual or remaining > 0, manual=self.manual, remaining=remaining)\n\n\ndef support_countdown(state, language=\'zh\'):\n    if not state.get(\'visible\') or state.get(\'manual\'):\n        return \'\'\n    seconds = state[\'remaining\']\n    return (f\'Closes in {seconds} seconds · Check the box to keep showing.\' if language == \'en\' else\n            f\'倒计时：{seconds} 秒后关闭 · 手动勾选可持续展示\')\n')
_EMBEDDED['resource_sets_contract'] = (1, '"""Subset/superset inventories, model isolation, UI notices and hotplug. No game I/O."""\nimport copy\nimport hashlib\nimport io\nimport json\nimport os\nimport struct\nimport tempfile\nimport threading\nimport time\nimport unittest\nimport zlib\nfrom pathlib import Path\nfrom types import SimpleNamespace as NS\nfrom unittest.mock import patch\n\n\ndef mdl(version=48, boxes=2, body_only=False):\n    raw=bytearray(1024)\n    raw[:4]=b\'IDST\';struct.pack_into(\'<i\',raw,4,version)\n    raw[12:30]=b\'player/new_one.mdl\\0\'\n    struct.pack_into(\'<ii\',raw,156,2,180)\n    struct.pack_into(\'<ii\',raw,172,1,640)\n    for i,(name,parent) in enumerate(((\'head\',1),(\'neck\',-1))):\n        at=180+i*216;pos=900+i*20\n        struct.pack_into(\'<ii\',raw,at,pos-at,parent)\n        struct.pack_into(\'<I\',raw,at+160,0x100)\n        raw[pos:pos+len(name)+1]=name.encode()+b\'\\0\'\n    struct.pack_into(\'<iii\',raw,640,0,boxes,12)\n    for i in range(boxes):\n        at=652+i*68;struct.pack_into(\'<ii6f\',raw,at,i,2 if body_only else i+1,-3,-3,-3,3,3,3)\n    return raw\n\n\ndef client_fixture(raw=None):\n    from reader import Reader,MemoryError\n    r=Reader(\'fixture\');r.classname=lambda _: \'CCSPlayer\';r.handle_entity=lambda _:0\n    r.fields_available=lambda *names: names==(\'bones\',)\n    r.table_cache={(0,\'scale_fields\'):{\'m_flModelScale\':0x600}}\n    entity=bytearray(0x1a10);struct.pack_into(\'<i\',entity,0x98,100);struct.pack_into(\'<i\',entity,0xa0,2)\n    struct.pack_into(\'<3f\',entity,0x300,550,0,0);struct.pack_into(\'<3f\',entity,0x3d0,550,0,0)\n    struct.pack_into(\'<f\',entity,0x600,1.)\n    struct.pack_into(\'<I\',entity,0x918,0x2000)\n    struct.pack_into(\'<I\',entity,0x8d0,0x4000);struct.pack_into(\'<i\',entity,0x8dc,2)\n    model=raw if raw is not None else mdl()\n    matrices=b\'\'.join(struct.pack(\'<12f\',1,0,0,550,0,1,0,0,0,0,1,z) for z in (64,44))\n    def read(at,n):\n        blocks={0x1000:entity,0x3000:model,0x4000:matrices}\n        for base,data in blocks.items():\n            if base<=at and at+n<=base+len(data):return bytes(data[at-base:at-base+n])\n        raise MemoryError(\'fixture missing bytes\')\n    def string(at,n):\n        return bytes(model[at-0x3000:at-0x3000+n]).split(b\'\\0\')[0].decode()\n    r.mem=NS(read=read,string=string,u32=lambda at:0x3000 if at==0x2000 else 0)\n    return r,entity,model\n\n\ndef wait_for(predicate):\n    deadline=time.monotonic()+3\n    while not predicate():\n        if time.monotonic()>deadline:raise AssertionError(\'background job timeout\')\n        time.sleep(.005)\n\n\ndef run():\n    import collision_cache_io as cache\n    from resource_catalog import AssetScanner,ClientResources,board_lines,support_lines,ResourceSupportView,support_countdown\n    from model_support import inspect_mdl,entity_status,adapt_hitboxes\n    from wall_capability import effective_walls,inspect_map,notice_lines\n    from cso2_bot_tool import Config\n\n    class Tests(unittest.TestCase):\n        def setUp(self):\n            t=tempfile.TemporaryDirectory(prefix=\'resource sets 中文 \');self.addCleanup(t.cleanup)\n            self.root=Path(t.name);self.game=self.root/\'client\';self.game.mkdir()\n            self.mount=self.root/\'walls\';self.mount.mkdir();self.scanner=AssetScanner()\n            p=patch.object(cache,\'CACHE_ROOT\',self.mount);p.start();self.addCleanup(p.stop)\n            self.index=dict(schema=cache.INDEX_SCHEMA,world={},props={},models={},world_meta={},props_meta={})\n            self.wall(\'a\');self.wall(\'b\');self.asset(\'maps/a.bsp\',b\'fixture\')\n        def asset(self,name,raw):\n            p=self.game/\'custom\'/name;p.parent.mkdir(parents=True,exist_ok=True);p.write_bytes(raw);return p\n        def wall(self,name):\n            for family,raw in ((\'world\',name.encode()),(\'props\',zlib.compress(b\'{"models":{}}\'))):\n                filename=family+\'_\'+name+\'.bin\';(self.mount/filename).write_bytes(raw)\n                self.index[family][name]=[filename,hashlib.sha256(raw).hexdigest()]\n            (self.mount/cache.INDEX_NAME).write_text(json.dumps(self.index),\'utf-8\')\n        def scan(self):return self.scanner.scan(self.game)\n\n        def test_subset_only_installed_maps_are_reported(self):\n            (self.mount/\'world_b.bin\').unlink();r=self.scan()\n            self.assertEqual(set(r[\'maps\']),{\'a\'});self.assertTrue(r[\'maps\'][\'a\'][\'available\'])\n            self.assertFalse(r[\'issues\'])\n        def test_empty_client_does_not_require_full_collection(self):\n            (self.game/\'custom/maps/a.bsp\').unlink();r=self.scan()\n            self.assertFalse(r[\'maps\']);self.assertFalse(r[\'models\']);self.assertFalse(r[\'issues\'])\n        def test_superset_new_map_uses_new_external_index(self):\n            self.asset(\'maps/new_map.bsp\',b\'new\');self.wall(\'new_map\')\n            r=self.scan();self.assertTrue(r[\'maps\'][\'new_map\'][\'available\'])\n        def test_unknown_map_reports_unsupported_without_poisoning_a(self):\n            self.asset(\'maps/new_map.bsp\',b\'new\');r=self.scan()\n            self.assertTrue(r[\'maps\'][\'a\'][\'available\']);self.assertEqual(r[\'maps\'][\'new_map\'][\'state\'],\'untrained\')\n            text=\'\\n\'.join(board_lines(r));self.assertIn(\'new_map\',text);self.assertIn(\'静态墙体未支持\',text)\n        def test_current_missing_file_degrades_only_walls_and_recovers(self):\n            path=self.mount/\'world_a.bin\';raw=path.read_bytes();path.unlink()\n            r=self.scan();self.assertEqual(r[\'issues\'][0][\'file\'],\'world_a.bin\')\n            cfg=Config(walls=True,wallbang=True,aim=True,fire=True)\n            effective=effective_walls(cfg,r[\'maps\'][\'a\']);self.assertTrue(effective.aim and effective.fire)\n            self.assertFalse(effective.walls or effective.wallbang);self.assertTrue(cfg.walls and cfg.wallbang)\n            path.write_bytes(raw);self.assertTrue(self.scan()[\'maps\'][\'a\'][\'available\'])\n        def test_unknown_model_name_is_supported_by_its_structure(self):\n            self.asset(\'models/player/brand_new/brand_new.mdl\',mdl());r=self.scan()\n            self.assertEqual(r[\'models\'][\'models/player/brand_new/brand_new.mdl\'][\'state\'],\'supported\')\n        def test_missing_referenced_character_does_not_poison_present(self):\n            self.asset(\'models/player/good/good.mdl\',mdl())\n            self.asset(\'scripts/characters.csv\',b\'resname,classid,worldmodel\\nmissing,99,models/player/missing/missing.mdl\\n\')\n            r=self.scan();self.assertEqual(r[\'models\'][\'models/player/good/good.mdl\'][\'state\'],\'supported\')\n            self.assertEqual(r[\'models\'][\'models/player/missing/missing.mdl\'][\'state\'],\'missing\')\n        def test_unreadable_package_is_partial_not_false_missing(self):\n            self.asset(\'scripts/characters.csv\',b\'resname,classid,worldmodel\\nmaybe,99,models/player/maybe/maybe.mdl\\n\')\n            p=self.game/\'Data\';p.mkdir();(p/\'unknown.pkg\').write_bytes(b\'unknown format\')\n            r=self.scan();self.assertTrue(r[\'partial\'])\n            self.assertEqual(r[\'models\'][\'models/player/maybe/maybe.mdl\'][\'state\'],\'unverified\')\n            self.assertTrue(r[\'maps\'][\'a\'][\'available\'])\n        def test_extra_unknown_format_is_labeled_and_other_model_works(self):\n            self.asset(\'models/player/bad/bad.mdl\',mdl(99));self.asset(\'models/player/good/good.mdl\',mdl())\n            r=self.scan();self.assertEqual(r[\'models\'][\'models/player/bad/bad.mdl\'][\'state\'],\'unsupported\')\n            self.assertEqual(r[\'models\'][\'models/player/good/good.mdl\'][\'state\'],\'supported\')\n        def test_invalid_file_can_be_replaced_same_size_and_time(self):\n            p=self.asset(\'models/player/new/new.mdl\',mdl(99));old=p.stat();self.scan()\n            p.write_bytes(mdl());os.utime(p,ns=(old.st_atime_ns,old.st_mtime_ns))\n            self.assertEqual(self.scan()[\'models\'][\'models/player/new/new.mdl\'][\'state\'],\'supported\')\n        def test_body_only_model_not_mislabeled_unsupported(self):\n            self.assertEqual(inspect_mdl(mdl(body_only=True))[\'state\'],\'supported\')\n        def test_animation_library_not_counted_as_failed_character(self):\n            raw=mdl(boxes=0);struct.pack_into(\'<ii\',raw,156,0,664)\n            self.asset(\'models/player/anim.mdl\',raw);r=self.scan()\n            self.assertEqual(r[\'auxiliary_models\'],1);self.assertFalse(r[\'issues\'])\n        def test_malformed_model_is_local_issue(self):\n            raw=mdl();struct.pack_into(\'<i\',raw,652,99)\n            self.assertEqual(inspect_mdl(raw)[\'state\'],\'invalid\')\n            self.asset(\'models/player/bad.mdl\',raw);self.asset(\'models/player/good.mdl\',mdl())\n            r=self.scan();self.assertEqual(r[\'models\'][\'models/player/good.mdl\'][\'state\'],\'supported\')\n        def test_client_empty_hitbox_set_is_retried(self):\n            r,data,raw=client_fixture(mdl(boxes=0));meta={}\n            self.assertIsNone(r.bones(0x1000,(550.,0.,0.),data,meta)[0]);self.assertFalse(r.model_cache)\n            raw[:]=mdl();meta={};head,rig=r.bones(0x1000,(550.,0.,0.),data,meta)\n            self.assertIsNotNone(head);self.assertTrue(rig);self.assertTrue(r.model_cache)\n        def test_client_changed_header_cannot_reuse_old_model_definitions(self):\n            r,data,raw=client_fixture();r.bones(0x1000,(550.,0.,0.),data,{})\n            struct.pack_into(\'<i\',raw,652+4,2);struct.pack_into(\'<i\',raw,8,7)\n            head,_=r.bones(0x1000,(550.,0.,0.),data,{})\n            self.assertIsNone(head)\n        def test_single_unsupported_client_entity_preserves_next_entity(self):\n            r,data,raw=client_fixture(mdl(99));bad=r.read_entity(3,0x1000)\n            self.assertEqual(entity_status(bad),\'unsupported\');self.assertIsNone(bad.head);self.assertFalse(bad.aim_points)\n            raw[:]=mdl(