           self.pose_retry_after[(index,p)]=now+.1\n                            entry=self.global_addr(\'entity_entries\')+index*16\n                            expected=self.mem.read(entry,8)\n                            if struct.unpack(\'<II\',expected)[0]==p:\n                                current=self.read_entity(index,p,with_bones,with_aimpoints,observe_inactive,with_inventory,bone_limit,False,aim_key,control_context)\n                                if self.mem.read(entry,8)!=expected:return None\n                                if current is not None:\n                                    diagnostic=dict(e.pose_diagnostic,retry=True,recovered=current.head is not None)\n                                    if current.pose_diagnostic:diagnostic[\'after\']=current.pose_diagnostic\n                                    current.pose_diagnostic=diagnostic\n                                return current\n            except (MemoryError,ValueError,struct.error) as ex:\n                e.head=None;e.skeleton=[];e.aim_points=[];e.aim_hitboxes=()\n                e.head_source=\'model_unavailable\'\n                e.model=meta.get(\'model\',e.model)\n                e.pose_diagnostic=dict(model_support=\'unsupported\' if isinstance(ex,UnsupportedModel) else \'pending\',reason=str(ex))\n        return e\n    def local_health_observation(self):\n        """Read health even on death, without requiring a live render frame."""\n        m=self.mem\n        if not m or not m.alive() or m.i32(self.global_addr(\'signon\'))!=6:return None\n        stamp=time.monotonic();index=m.i32(self.global_addr(\'local_index\'))+1\n        if not 1<=index<=128:return None\n        address=m.u32(self.global_addr(\'local_player\'))\n        if not address or address!=self.entity_address(index):return None\n        name=self.classname(address)\n        if entity_kind(name)!=\'player\':return None\n        data=m.read(address,0x1798);life=data[0x97]\n        health=struct.unpack_from(\'<i\',data,0x98)[0];team=struct.unpack_from(\'<i\',data,0xa0)[0]\n        if life not in (0,1,2) or not -100000000<health<100000000 or not 0<=team<256:return None\n        if health<0 and life==0:return None\n        if (m.i32(self.global_addr(\'signon\'))!=6 or m.i32(self.global_addr(\'local_index\'))+1!=index\n                or m.u32(self.global_addr(\'local_player\'))!=address or self.entity_address(index)!=address):return None\n        local=Entity(index,address,name,team,max(0,health),(0,0,0),\n                     zombie_class=struct.unpack_from(\'<i\',data,0x1794)[0])\n        map_name=m.string(self.global_addr(\'level_name\'),160).replace(\'\\\\\',\'/\')\n        return local,map_name,stamp,life!=0\n\n    def frame(self,mode=\'普通竞技\',enemy_team=0,with_hazards=False,with_aimpoints=True,observe_inactive=False,include_allies=False,detail_distance=None,local_only=False,control_only=False,with_bones=True,defer_hostage_filter=False,follow_target=None):\n        started=time.monotonic()\n        m=self.mem\n        if not m or not m.alive():raise NotReady(\'游戏进程未运行\')\n        signon=m.i32(self.global_addr(\'signon\'))\n        self.session_state={\'signon\':signon,\'observed_at\':started,\'stage\':\'sampling\' if signon==6 else \'waiting\'}\n        if signon!=6:\n            self.entity_scan=[];self.slot_cache.clear();self.last_scan=0;self.entity_stats={}\n            self.pose_activity.tracks.clear()\n            self.throw_states.clear()\n            if signon==0:raise NotReady(\'已检测到游戏进程，尚未连接服务器（状态 0）\')\n            raise NotReady(\'地图正在载入，等待角色生成（状态 5）\' if signon==5 else f\'游戏连接状态 {signon}，等待地图数据\')\n        index=m.i32(self.global_addr(\'local_index\'))+1\n        if not 1<=index<=128:raise NotReady(\'本地角色索引尚未就绪\')\n        lp=m.u32(self.global_addr(\'local_player\'))\n        if not lp or lp!=self.entity_address(index):raise NotReady(\'本地角色与实体列表尚未同步\')\n        local=self.read_entity(index,lp,False,with_inventory=with_aimpoints)\n        if local is None:raise NotRe