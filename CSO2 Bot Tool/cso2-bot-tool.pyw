       # A changed map/local session must reacquire the population. The\n            # small follow frame is never promoted across that boundary.\n            if follow_target is not None and self.frame is not None:\n                def scope(f):return (f.map_name,f.source_epoch,f.local.address,f.local.serial,f.mode)\n                if scope(frame)!=scope(self.frame):\n                    self._follow_target=None\n                    self.control.release()\n                    follow_target=None\n                    sample_options.pop(\'follow_target\',None)\n                    frame=self.reader.frame(cfg.mode,cfg.enemy_team,False,**sample_options)\n            timer.sample_stamp = frame.stamp\n            frame.source_pid = self.reader.mem.pid\n            frame = self.trigger.current_weapon(frame, self.reader)\n            frame.source_pid = self.reader.mem.pid\n            cfg = auto_ally_config(frame, cfg)\n            requested_cfg = cfg\n            cfg = self.force_config(frame, cfg)\n            timer.mode = \'t_force_fire\' if cfg.tab_force_fire else \'rmb_aim_fire\'\n            requested = bool(self.win.down(2) and (cfg.aim or cfg.tab_force_fire))\n            self.trigger.configure_aim(self.reader, bool(cfg.aim or cfg.tab_force_fire))\n            if not allowed():\n                status = \'cancelled\'; self.pause(); return\n            # The view used by tracing is part of the current detection phase.\n            frame = self.reader.control_selection_view(frame)\n            frame.source_pid = self.reader.mem.pid\n            weapon = self.catalog.get(frame.weapon)\n            self.trigger.prepare_hostage_guard(frame,weapon)\n            timer.detection_done()\n            self.visibility.weapon = weapon or {}\n            cfg = self.force_config(frame, requested_cfg)\n            timer.mode = \'t_force_fire\' if cfg.tab_force_fire else \'rmb_aim_fire\'\n            requested = bool(self.win.down(2) and (cfg.aim or cfg.tab_force_fire))\n            # A signal arriving during bones/camera acquisition belongs to\n            # this decision, not only the next worker tick.\n            wall={} if cfg.tab_force_fire else self.wall_provider() if callable(self.wall_provider) else wall\n            frame = self.visibility.update(self.reader, frame, cfg, wall,follow=follow_target is not None)\n            frame.control_provenance[\'acquisition\']=\'follow_target\' if follow_target else \'population\'\n            if follow_target is not None and not cfg.tab_force_fire and any(\n                    e.visibility==\'penetrable\' for e in frame.entities):\n                # A downgraded lock cannot outrank visible actors absent from\n                # this partial frame. Reacquire the population before firing.\n                status=\'follow_path_changed\';self.control.release();return\n            self.trigger.prepare_hostage_guard(frame,weapon)\n            traced = self.clock()\n            if not allowed():\n                status = \'cancelled\'; self.pause(); return\n            cfg = self.force_config(frame, requested_cfg)\n            timer.mode = \'t_force_fire\' if cfg.tab_force_fire else \'rmb_aim_fire\'\n            if self.control.force_cancel_requested:\n                status = \'cancelled\'; self.control.release(); return\n            self.control.observe_lifecycle(frame, self.reader)\n            self.control.step(self.reader, frame, cfg, weapon, self.wall_provider or wall)\n            d=self.control.diagnostic\n            actor=next((e for e in frame.entities if e.index==self.control.target),None)\n            if actor is not None and d.get(\'aim_write_stamp\') is not None and self.win.down(2):\n                self._follow_target=(actor.index,actor.address,actor.serial,actor.model,d[\'aim_point_id\'])\n                self._follow_config=requested_policy\n                self._last_visibility=d.get(\'visibility\')\n            else:self._follow_target=None\n            if follow_target is None:self._full_finished=self.clock()\n            status = \'cycle_complete\'\n        finally:\n            ended = self.clock()\n            if status!=\'cycle_complete\':self._follow_target=None\n            latency = timer.snapshot(status, now=ended, target=self.control.target, requested=requested)\n            written=self.control.diagnostic.get(\'aim_write_stamp\')\n            identity=(self.control.target,self.control.diagnostic.get(\'target_serial\'))\n            interval=((written-self._last_aim_write)*1000 if written is not None\n                and self._last_aim_write is not None and self._last_aim_identity==identity else None)\n            if written is not None:self._last_aim_write=written;self._last_aim_identity=identity\n            elif not requested:self._last_aim_write=self._last_aim_identity=None\n            latency.update(acquisition=\'follow_target\' if follow_target else \'population\',\n                follow_target=follow_target,aim_write_interval_ms=interval,\n                scheduled_follow_period_ms=self.follow_period*1000,\n                population_refresh_period_ms=self.population_period*1000)\n            latency.update(fire_down=self.control.diagnostic.get(\'fire_down_completed_stamp\') is not None,\n                aim_written=self.control.diagnostic.get(\'aim_write_stamp\') is not None,\n                pressed=bool(self.control.pressed), reason=self.control.reason,\n                ray_ms=(traced-timer.detected)*1000 if traced is not None else None)\n            self.control.diagnostic[\'aim_latency\'] = latency\n            self.latency_totals.observe(latency)\n            self.control.aim_latency_timer = None\n        self.frame = frame\n        self.metrics = dict(sample_ms=latency[\'detection_ms\'], ray_ms=latency[\'ray_ms\'],\n            control_ms=(ended-traced)*1000, cycle_ms=latency[\'total_ms\'],\n            sample_to_control_ms=(ended-frame.stamp)*1000,\n            visibility=dict(self.visibility.metrics), esp_consumed=False, process_id=os.getpid())\n        self.control.diagnostic.update(control_provenance=dict(frame.control_provenance),\n            independent_aim=dict(self.metrics), esp_pose_consumed=False,\n            tab_force_fire_active=self.toggle.force_fire_active)\n        from ghost_hostage_notice import guard_state\n        self.control.diagnostic[\'ghost_hostage_protection\']=guard_state(frame,self.reader.mem.pid,self.clock())\n        # Telemetry serialization and geometry publication are outside the measured chain.\n        # Do not replace the obstacle producer\'s population input with a\n        # one-actor packet. Keep its original timestamps until the next full\n        # acquisition; follow poses remain private to aim.\n        if follow_target is None:\n            self.geometry = shared_geometry_packet(frame, self.reader.mem.pid, self.clock(), \'aim_geometry\')\n\n\nclass ForceFireInputMonitor:\n    """Poll only the T edge; no entity, ray, disk or GIL-heavy work occurs here."""\n    PERIOD = .001\n\n    def __init__(self, loop):\n        self.loop = loop\n        self.stop_event = threading.Event()\n        self.thread = None\n        self.held = False\n\n    def start(self):\n        if self.thread is not None and self.thread.is_alive():\n            return\n        try:\n            self.held = bool(self.loop.win.down(0x54))\n        except Exception:\n            self.held = True\n        self.stop_event.clear()\n        self.thread = threading.Thread(target=self._run, name=\'t-force-input-listener\', daemon=True)\n        self.thread.start()\n\n    def _run(self):\n        while not self.stop_event.is_set():\n            try:\n                self.poll_once()\n            except Exception as error:\n                self.loop.control.diagnostic[\'t_input_listener_error\'] = str(error)\n            self.stop_event.wait(self.PERIOD)\n\n    def poll_once(self):\n        held = bool(self.loop.win.down(0x54))\n        edge = held and not self.held\n        self.held = held\n        if edge:self.loop.handle_force_fire_edge()\n        enabled, allowed = self.loop._force_policy_snapshot()\n        if self.loop.toggle.force_fire_active and (not enabled or not allowed()\n                or not self.loop.win.foreground(self.loop.reader.mem.pid)):\n            self.loop.cancel_force(\'T强制模式失焦或暂停\')\n        # Retry a failed UP without requiring another key edge or bone scan.\n        if self.loop.control.force_cancel_requested:\n            self.loop.control.request_force_cancel()\n\n    def stop(self):\n        self.stop_event.set()\n        if self.thread is not None and self.thread is not threading.current_thread():\n            self.thread.join(.25)\n        self.thread = None\n\n\nclass GatedWindows:\n    """Check process lifetime and pause again at every actual input boundary."""\n    def __init__(self, windows, permitted): self.windows=windows; self.permitted=permitted\n    def down(self, key):\n        # Binding restoration must see the physical button, even when paused.\n        return self.windows.down(key)\n    def foreground(self, pid):\n        return bool(self.permitted() and self.windows.foreground(pid))\n    def __getattr__(self, name): return getattr(self.windows, name)\n\n\ndef serve_aim_worker(game, game_pid, parent_pid, tag):\n    from bhop_service import Signals, Lifetime\n    from esp_transport import LatestMailbox, DeadlineWaiter\n    from presentation import TimerResolution\n    from aim_runtime import Controller, Windows\n    from aim_client_control import AimClientControlReader\n    from aim_engine_attack import EngineAttack\n    from aim_runtime import decode_config\n    from weapon_profiles import WeaponCatalog\n    from aim_recoil_policy import install\n    install()\n    lifetime=signals=commands=replies=walls=reader=visibility=catalog=driver=trigger=None\n    timer=TimerResolution(); waiter=DeadlineWaiter(144); stopped=threading.Event()\n    settings=None; wall={}; actions=collections.deque(maxlen=4096); action_seq=0; acknowledged=0\n    last_report=0.; state=\'starting\'; error=\'\'; cfg=None; motion_log=None\n    try:\n        lifetime=Lifetime(parent_pid,game_pid); signals=Signals(tag)\n        commands=LatestMailbox(tag+\'_settings\'); replies=LatestMailbox(tag+\'_status\')\n        walls=LatestMailbox(tag+\'_walls\')\n        reader=AimClientControlReader(game); reader.attach(int(game_pid))\n        windows=GatedWindows(Windows(),lambda: lifetime.alive()\n                            and signals.is_set(\'enabled\') and not signals.is_set(\'stop\'))\n        trigger=EngineAttack(windows); controller=Controller(windows,trigger=trigger)\n        visibility=ControlVisibility(game); catalog=WeaponCatalog(game)\n        from aim_motion_compensation import MotionCompensator\n        from aim_motion_log import MotionLog\n        controller.motion=visibility.motion=MotionCompensator()\n        motion_log=MotionLog(\'aim\',game_pid,entry=BUNDLE_ENTRY)\n        driver=ControlLoop(reader,windows,controller,visibility,catalog)\n        import hashlib\n        driver.latency_totals.bundle_sha256=hashlib.sha256(BUNDLE_ENTRY.read_bytes()).hexdigest()\n        def read_wall():\n            nonlocal wall\n            payload=walls.read_latest()\n            if payload is not None:wall=json.loads(payload)\n            return wall\n        driver.wall_provider=read_wall\n        driver.start_input_monitor()\n        timer.set_active(True)\n        while lifetime.alive():\n            started=time.monotonic()\n            payload=commands.read_latest()\n            if payload is not None:\n                settings=json.loads(payload); cfg=decode_config(settings[\'cfg\'])\n                acknowledged=max(acknowledged,int(settings.get(\'action_ack\',0)))\n            while actions and actions[0][\'sequence\']<=acknowledged: actions.popleft()\n            wall=read_wall()\n            stopping=signals.is_set(\'stop\')\n            allowed=lambda: bool(cfg is not None and lifetime.alive()\n                and signals.is_set(\'enabled\') and not signals.is_set(\'stop\'))\n            try:\n                if stopping:\n                    driver.configure_force_input(type(\'ForceCfg\', (), {\'tab_force_fire\': False})(), False)\n                    driver.pause(); trigger.close(); state=\'stopped\'; error=\'\'\n                elif not allowed():\n                    driver.configure_force_input(type(\'ForceCfg\', (), {\'tab_force_fire\': False})(), False)\n                    driver.pause(); state=\'paused\'; error=\'\'\n                else:\n                    driver.tick(cfg,wall,allowed)\n                    state=\'running\' if allowed() else \'paused\'; error=\'\'\n            except Exception as ex:\n                error=type(ex).__name__+\': \'+str(ex); state=\'restoring\' if stopping else \'waiting\'\n                try: driver.pause()\n                except Exception as cleanup: error+=\'; release: \'+str(cleanup)\n            if motion_log:\n                motion_log.cycle(controller,driver.cycle,state,error)\n            for action in controller.drain_actions():\n                if motion_log:motion_log.emit(\'input_action\',action)\n                action_seq+=1; actions.append(dict(sequence=action_seq,value=action))\n            if motion_log:controller.diagnostic[\'motion_log\']=motion_log.metrics()\n            now=time.monotonic()\n            if now-last_report>=.01 or state in (\'paused\',\'stopped\',\'restoring\'):\n                report=dict(state=state,error=error,pid=os.getpid(),game_pid=game_pid,observed_at=now,\n                    target=controller.target,pressed=controller.pressed,reason=controller.reason,\n                    diagnostic=dict(controller.diagnostic),trigger=trigger.diagnostics(),\n                    worker_latency_totals=driver.latency_totals.snapshot(),\n                    metrics=driver.metrics,geometry=driver.geometry,actions=list(actions))\n                replies.write(json.dumps(report,ensure_ascii=True).encode(\'utf8\'));last_report=now\n            if state==\'stopped\':break\n            if not reader.mem.alive():break\n            if state in (\'waiting\',\'paused\',\'restoring\'):stopped.wait(.02)\n            else:\n                waiter.period=driver.follow_period if cfg is not None and driver.following(cfg) else 1./144.\n                waiter.wait(started,stopped)\n    finally:\n        if driver:\n            driver.stop_input_monitor()\n        # Do not discard a still-live binding owner simply because RMB is held.\n        # Restoration may need the next release or the engine command readback.\n        if trigger:\n            while reader and reader.mem and reader.mem.alive():\n                try:\n                    if driver:driver.pause()\n                    trigger.close();break\n                except Exception:time.sleep(.025)\n        if motion_log:motion_log.close()\n        if visibility:visibility.close()\n        if reader:reader.close()\n        waiter.close();timer.close()\n        for obj in (commands,replies,walls,signals,lifetime):\n            if obj:obj.close()\n\n\nclass RemoteControl:\n    """UI/log mirror only. No input or entity sampling happens in the parent."""\n    def __init__(self, service):\n        self.service=service;self.target=0;self.pressed=False;self.reason=\'独立瞄准等待连接\'\n        self.diagnostic={};self.input_armed=False;self.actions=collections.deque(maxlen=4096)\n        self.ammo_last=None;self.ammo_at=0.;self.last_weapon=\'\'\n        self.last_weapon_identity=None;self.last_fire=-100.;self.last_release=-100.\n    def drain_actions(self):\n        result=list(self.actions);self.actions.clear();return result\n    def release(self, **kwargs): self.service.pause()\n    def service_fire_release(self, *args): return False\n    def pause_frame(self, frame, reason, **kwargs): self.reason=reason;self.service.pause()\n\n\nclass RemoteTrigger:\n    def __init__(self, service): self.service=service;self.tab_force=False\n    def pause_aim(self): self.service.pause()\n    def close(self): self.service.close()\n    def diagnostics(self): return dict(self.service.latest.get(\'trigger\',{}))\n\n\nclass AimService:\n    """Independent supervisor; settings/one-bit walls in, telemetry out."""\n    def __init__(self, requested):\n        self.requested=requested;self.proc=None;self.thread=None;self.signals=None\n        self.stopped=threading.Event();self.forced_pause=True;self.latest={};self.error=\'\'\n        self.lock=threading.Lock();self.wall={};self.wall_revision=0;self.action_ack=0\n        self.wall_wake=threading.Event()\n        self.control=RemoteControl(self);self.trigger=RemoteTrigger(self)\n        self.geometry={};self.scope={};self.wall_revisions={}\n\n    def start(self, game, pid):\n        if self.thread and self.thread.is_alive():return\n        self.game=str(game);self.pid=int(pid);self.stopped.clear();self.forced_pause=False\n        self.thread=threading.Thread(target=self._watch,name=\'aim-process-supervisor\',daemon=True)\n        self.thread.start()\n\n    def pause(self):\n        with self.lock:\n            self.forced_pause=True\n            if self.signals:self.signals.set(\'enabled\',False)\n            self.wall_wake.set()\n\n    def resume(self):\n        with self.lock:self.forced_pause=False;self.wall_wake.set()\n\n    def set_scope(self, context):\n        from aim_obstacle_io import obstacle_scope\n        with self.lock:\n            if obstacle_scope(context)!=obstacle_scope(self.scope):\n                self.wall_revisions={};self.wall=dict(signals={},context=dict(context));self.wall_revision+=1\n                self.wall_wake.set()\n            self.scope=dict(context)\n\n    def submit_wall(self, signals, context):\n        from aim_obstacle_io import merge_obstacle_signals, obstacle_scope\n        with self.lock:\n            if obstacle_scope(self.scope)!=obstacle_scope(context):return False\n            previous=self.wall.get(\'signals\',{})\n            merged,revisions=merge_obstacle_signals(previous,self.wall_revisions,signals,context)\n            self.wall_revisions=revisions;self.wall=dict(signals=merged,context=dict(context))\n            self.wall_revision+=1\n            self.wall_wake.set()\n        return True\n\n    def poll(self):\n        value=self.latest\n        self.control.target=value.get(\'target\',0);self.control.pressed=value.get(\'pressed\',False)\n        self.control.reason=value.get(\'reason\') or self.error or \'独立瞄准等待采样\'\n        self.control.diagnostic=dict(value.get(\'diagnostic\',{}))\n        self.control.diagnostic[\'worker_latency_totals\']=value.get(\'worker_latency_totals\',{})\n        self.control.diagnostic[\'aim_process\']=dict(state=value.get(\'state\',\'starting\'),\n            pid=value.get(\'pid\'),error=self.error or value.get(\'error\',\'\'),\n            age_ms=(time.monotonic()-value[\'observed_at\'])*1000 if value.get(\'observed_at\') else None)\n        return self.control.target\n\n    def _watch(self):\n        from bhop_service import Signals, Lifetime\n        from esp_transport import LatestMailbox\n        # The embedded importer injects BUNDLE_ENTRY when this module is\n        # loaded from the formal bundle.  Keep a source-file fallback for\n        # contract runners and direct module tests.\n        bundle_entry = globals().get(\'BUNDLE_ENTRY\')\n        if bundle_entry is None:\n            from pathlib import Path\n            bundle_entry = Path(sys.argv[0]).resolve()\n        boxes=[];log=None;lifetime=None;signals=None\n        try:\n            lifetime=Lifetime(os.getpid(),self.pid)\n            tag=\'Local\\\\CSO2_AIM_\'+str(os.getpid())+\'_\'+uuid.uuid4().hex\n            signals=Signals(tag,create=True)\n            with self.lock:self.signals=signals\n            settings=LatestMailbox(tag+\'_settings\',create=True);boxes.append(settings)\n            replies=LatestMailbox(tag+\'_status\',create=True);boxes.append(replies)\n            walls=LatestMailbox(tag+\'_walls\',create=True);boxes.append(walls)\n            log_path=bundle_entry.parent/\'CSO2_BOT_Tool\'/\'aim_worker.log\'\n            log_path.parent.mkdir(exist_ok=True,parents=True);log=log_path.open(\'ab\',buffering=0)\n            last_settings=None;last_wall=-1;next_start=0.\n            while lifetime.alive():\n                # Clear before reading revisions so a later update wakes this wait.\n                self.wall_wake.clear()\n                cfg,permitted=self.requested()\n                if self.stopped.is_set():\n                    signals.set(\'enabled\',False);signals.set(\'stop\')\n                    if self.proc is None:break\n                if cfg is None:\n                    self.wall_wake.wait(.01);continue\n                with self.lock:\n                    enabled=bool(permitted and not self.forced_pause and not self.stopped.is_set())\n                    signals.set(\'enabled\',enabled)\n                payload=json.dumps(dict(cfg=asdict(cfg),action_ack=self.action_ack),sort_keys=True).encode(\'utf8\')\n                if payload!=last_settings and settings.write(payload):last_settings=payload\n                with self.lock:wall=self.wall;revision=self.wall_revision\n                if revision!=last_wall and walls.write(json.dumps(wall).encode(\'utf8\')):last_wall=revision\n                if self.proc is None and not self.stopped.is_set() and time.monotonic()>=next_start:\n                    self.proc=subprocess.Popen([sys.executable,\'-X\',\'utf8\',\'-u\',str(bundle_entry),\n                        \'--aim-worker\',self.game,str(self.pid),str(os.getpid()),tag],\n                        stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=log,\n                        creationflags=subprocess.CREATE_NO_WINDOW)\n                raw=replies.read_latest()\n                if raw is not None:\n                    report=json.loads(raw)\n                    if self.proc and report.get(\'pid\')==self.proc.pid:\n                        self.latest=report;self.geometry=report.get(\'geometry\',{});self.error=report.get(\'error\',\'\')\n                        for event in report.get(\'actions\',[]):\n                            if event[\'sequence\']>self.action_ack:\n                                self.control.actions.append(event[\'value\']);self.action_ack=event[\'sequence\']\n                if self.proc is not None and self.proc.poll() is not None:\n                    code=self.proc.returncode;self.proc=None;self.latest={};self.geometry={}\n                    if self.stopped.is_set():break\n                    self.error=\'独立瞄准退出，等待重建：\'+str(code);next_start=time.monotonic()+1.\n                    self.action_ack=0;last_settings=None;last_wall=-1\n                if self.stopped.is_set() and self.proc is None:break\n                self.wall_wake.wait(.01)\n        except Exception as ex:\n            self.error=type(ex).__name__+\': \'+str(ex)\n        finally:\n            if signals:\n                signals.set(\'enabled\',False);signals.set(\'stop\')\n            if self.proc:\n                # The child owns its release/restoration even if supervision fails.\n                self.proc.wait()\n                self.proc=None\n            with self.lock:\n                self.signals=None\n                if signals:signals.close()\n            for box in boxes:box.close()\n            if lifetime:lifetime.close()\n            if log:log.close()\n\n    def close(self):\n        self.pause();self.stopped.set();self.wall_wake.set()\n        if self.thread and self.thread.is_alive():\n            self.thread.join(1.)\n            if self.thread.is_alive():raise RuntimeError(\'独立瞄准正在释放开火和恢复右键绑定\')\n        self.thread=None;self.latest={};self.geometry={};self.control.pressed=False;self.control.target=0\n')
_EMBEDDED['independent_aim_contract'] = (1, '"""Independent aim/fire gates: production decisions and input, simulated I/O.\n\nNo legacy contract is imported or run. Synthetic clock costs verify accounting\nonly: they are not performance measurements or live accuracy evidence.\n"""\nimport collections\nimport copy\nimport json\nimport linecache\nimport math\nimport sys\nimport traceback\nfrom dataclasses import replace\nfrom unittest.mock import patch\nfrom aim_scope_fixture import Fixture\nfrom aim_latency import FIELDS\n\n\ndef expect(value, message):\n    if not value:raise AssertionError(message)\n\n\ndef source(name):\n    return \'\'.join(linecache.getlines(str(BUNDLE_ENTRY)+\'::\'+name))\n\n\ndef latency_valid(row, mode, status):\n    expect(row[\'mode\']==mode and row[\'action_status\']==status, (\'latency identity\',row))\n    expect(all(type(row[k]) in (int,float) and math.isfinite(row[k]) and row[k]>=0\n               for k in FIELDS), (\'latency values\',row))\n    expect(math.isclose(sum(row[k] for k in FIELDS[:3]),row[\'total_ms\'],abs_tol=1e-8), \'phase sum\')\n    expect(math.isclose((row[\'completed_mono\']-row[\'started_mono\'])*1000,row[\'total_ms\'],abs_tol=1e-8), \'total boundary\')\n\n\ndef down_count(f):return f.native_writes.count((0x90000,3))\n\n\ndef shot(f):\n    f.ready();f.tick()\n    rows=[a for a in f.actions if a[\'action\']==\'fire_down\']\n    expect(rows and down_count(f), (\'missing real primary DOWN\',f.control.reason,f.control.diagnostic))\n    expect(rows[-1][\'aim_context\'][\'fire_commit\'][\'post_weapon_verified\'], \'final weapon/view check bypassed\')\n    return rows[-1]\n\n\ndef timing():\n    examples={}\n    for force,mode in ((False,\'rmb_aim_fire\'),(True,\'t_force_fire\')):\n        with Fixture(force=force) as f:\n            action=shot(f);row=action[\'aim_context\'][\'aim_latency\'];cycle=f.control.diagnostic[\'aim_latency\']\n            latency_valid(row,mode,\'fire_down_submitted\');latency_valid(cycle,mode,\'cycle_complete\')\n            expect(row[\'detection_ms\']>=2. and row[\'decision_ms\']>=.6 and row[\'action_ms\']>0, \'nonzero I/O costs missing\')\n            expect(cycle[\'total_ms\']>row[\'total_ms\'], \'shot incorrectly measured at end of cycle\')\n            expect(row is not cycle and 0<=row[\'sample_age_ms\']<row[\'total_ms\'], \'fresh shot sample age\')\n            frozen=copy.deepcopy(row)\n            f.ammo-=1;f.now+=.012;f.tick()\n            expect(row==frozen, \'later cycle mutated accepted shot\')\n            expect(f.trigger.active and f.control.pressed, \'fullauto lost continuity after ammo decrease\')\n            f.inputs.keys.discard(2);f.tick()\n            expect((0x90000,4) in f.native_writes and not f.control.pressed, \'primary UP missing\')\n            up=[a for a in f.actions if a[\'action\']==\'fire_up\'][-1]\n            expect(\'aim_latency\' not in up.get(\'aim_context\',{}), \'between-cycle UP reused prior shot timing\')\n            examples[mode]={k:row[k] for k in (*FIELDS,\'sample_age_ms\')}\n        # Change only simulated I/O costs, proving each cost lands in its own\n        # phase rather than reporting a fabricated fixed duration.\n        with Fixture(force=force) as f:\n            f.bone_cost=.006;f.ray_cost=.0036\n            row=shot(f)[\'aim_context\'][\'aim_latency\']\n            expect(math.isclose(row[\'detection_ms\']-examples[mode][\'detection_ms\'],4.,abs_tol=1e-6), \'detection accounting\')\n            expect(math.isclose(row[\'decision_ms\']-examples[mode][\'decision_ms\'],3.,abs_tol=1e-6), \'ray accounting\')\n    return dict(simulated_costs_only=examples)\n\n\ndef selection():\n    from geometry import aim_angles\n    results=[]\n    for force in (False,True):\n        for penetrable in (False,True):\n            with Fixture(force=force) as f:\n                far=f.actors[0];f.move(far,(500.,0.,64.))\n                near=copy.deepcopy(far);near.index=3;near.address=0x30000;near.serial=3\n                f.move(near,(200.,0.,64.));f.actors=[far,near]\n                if penetrable:\n                    f.rays.blocked.add(3);f.wall=f.obstacle(near)\n                shot(f)\n                expect(f.control.target==3, (\'near same ray\',force,penetrable))\n                if penetrable:expect(f.control.diagnostic[\'visibility\']==\'penetrable\',\'positive obstacle input not used\')\n                f.move(near,(60.,70.,64.));f.angles=(0.,0.,0.);f.tick()\n                expect(f.control.target==2, \'lateral close actor stole sight line\')\n                f.angles=aim_angles((0.,0.,64.),near.head);f.tick()\n                expect(f.control.target==3, \'camera re-lock ignored\')\n                near.health=0;f.angles=(0.,0.,0.);f.tick()\n                expect(f.control.target==2, \'dead near actor retained\')\n                results.append(dict(force=force,penetrable=penetrable,near_then_far_then_relock=True))\n    return results\n\n\ndef moving_targets():\n    from geometry import aim_angles,angle_error\n    counts={}\n    for force in (False,True):\n        with Fixture(force=force) as f:\n            shot(f);actor=f.actors[0]\n            for name,position,velocity,flags in (\n                (\'static\',(150.,0.,64.),(0.,0.,0.),1),\n                (\'lateral\',(150.,7.,64.),(0.,350.,0.),1),\n                (\'reverse\',(150.,-7.,64.),(0.,-350.,0.),1),\n                (\'jump\',(150.,-3.,72.),(0.,200.,200.),0),\n                (\'missing_velocity\',(150.,4.,64.),None,1)):\n                f.move(actor,position,velocity);actor.flags=flags;f.ammo-=1;f.now+=.01\n                f.tick()\n                expect(f.control.pressed, (name,\'fire stalled\',f.control.reason))\n                expect(angle_error(f.angles,aim_angles((0.,0.,64.),position))<1e-5,(name,\'aim trails old pose\'))\n                current=next(e for e in f.loop.frame.entities if e.index==actor.index)\n                expect(tuple(current.head)==position,(name,\'stale point\'))\n                expect(tuple(f.rays.requests[-1][0][2][0])==position,(name,\'stale ray endpoint\'))\n            # Repeated timestamps do not create a permanent wait. Once the\n            # timestamp is actually expired the unchanged freshness guard wins.\n            f.pose_stamp=f.now\n            for _ in range(3):f.now+=.005;f.tick();expect(f.control.pressed,\'duplicate stamp permanent wait\')\n            f.pose_stamp=f.now-1.;f.tick();expect(not f.control.pressed,\'expired pose fired\')\n            f.pose_stamp=None;f.now+=.04;f.tick();expect(f.control.pressed,\'fresh pose did not recover\')\n            counts[str(force)]=dict(samples=len(f.samples),current_pose_followed=True,expiry_recovered=True)\n    return counts\n\n\ndef guards_and_recovery():\n    from reader import NotReady\n    from aim_service import GatedWindows\n    results=[]\n    for name in (\'identity\',\'empty_clip\',\'invalid_weapon\',\'readback\',\'focus\',\'menu\',\'sample\',\'ray\',\'signon\'):\n        with Fixture() as f:\n            shot(f);before=down_count(f)\n            if name==\'identity\':f.bad_identity.add(2)\n            elif name==\'empty_clip\':f.ammo=0\n            elif name==\'invalid_weapon\':f.handle=0\n            elif name==\'readback\':f.bad_readback=True\n            elif name==\'focus\':f.inputs.focus=False\n            elif name==\'menu\':f.menu=True\n            elif name==\'sample\':f.fail_sample=True\n            elif name==\'ray\':f.rays.bad_reply=True\n            elif name==\'signon\':f.signon=5\n            f.now+=.04\n            failed=False\n            try:f.tick()\n            except (NotReady,ValueError):failed=True;f.loop.pause()\n            expect(not f.control.pressed and down_count(f)==before,(name,\'guard did not release or suppress DOWN\'))\n            if name in (\'sample\',\'ray\',\'signon\'):\n                expect(failed and f.control.diagnostic[\'aim_latency\'][\'action_status\']==\'error\',(name,\'error timing lost\'))\n            f.bad_identity.clear();f.ammo=20;f.handle=123;f.bad_readback=False;f.inputs.focus=True\n            f.menu=False;f.fail_sample=False;f.rays.bad_reply=False;f.signon=6;f.now+=.04\n            f.tick();expect(f.control.pressed,(name,\'did not recover\',f.control.reason))\n            results.append(name)\n    # A weapon switch during the angle-write boundary must be caught by the\n    # production Reader/EngineAttack checks, not by a mock returning success.\n    with Fixture() as f:\n        f.ready()\n        f.io_hook=lambda event:setattr(f,\'handle\',124) if event==\'aim_write\' else None\n        try:f.tick()\n        except NotReady:f.loop.pause()\n        expect(down_count(f)==0,\'weapon changed after sampling was accepted\')\n        f.io_hook=None;f.now+=.04;f.tick();expect(down_count(f)==1,\'new weapon identity did not recover\')\n    with Fixture() as f:\n        f.ready();f.tick(allowed=lambda:False)\n        row=f.control.diagnostic[\'aim_latency\']\n        expect(row[\'action_status\']==\'cancelled\' and not row[\'action_started\'] and down_count(f)==0,\'cancelled cycle fired\')\n        gate=GatedWindows(f.inputs,lambda:False)\n        expect(gate.down(2) and not gate.foreground(f.reader.mem.pid),\'pause must gate foreground while preserving physical RMB\')\n    return dict(recovered=results,weapon_race_rejected=True,cancellation=True)\n\n\ndef bindings():\n    for original in (\'slot3\',\'lastinv\',\'+quickknife\'):\n        with Fixture(binding=original) as f:\n            # It was already held before startup. No command may mutate the\n            # native binding until a physical release has been observed.\n            f.inputs.keys.add(2);f.tick()\n            expect(not f.commands.sent and down_count(f)==0,\'held-start binding mutation/fire\')\n            f.ready();f.tick()\n            for _ in range(3):\n                f.inputs.keys.discard(2);f.tick();f.now+=.02;f.inputs.press(2);f.tick()\n            expect(not f.inputs.switches and down_count(f)>0,(original,\'RMB switched weapon\'))\n            # Disabling while held must release input and defer restoration.\n            f.cfg=replace(f.cfg,aim=False,fire=False);f.loop.pause();f.tick()\n            expect(not f.control.pressed and f.binding==\'\',\'disable restored held RMB\')\n            f.cfg=replace(f.cfg,aim=True,fire=True);f.tick()\n            expect(not f.inputs.switches and f.binding==\'\',\'held-resume bypassed release gate\')\n            f.inputs.keys.discard(2);f.tick();f.inputs.press(2);f.tick()\n            expect(f.control.pressed,\'released resume cannot fire\')\n            f.loop.pause();expect(not f.control.pressed,\'pause retained fire\')\n            f.inputs.keys.discard(2);f.tick();f.inputs.press(2);f.tick()\n            f.map_name=\'de_dust2\';f.now+=.04;f.tick()\n            f.weapon_address+=0x100;f.handle+=1;f.now+=.04;f.tick()\n            expect(not f.inputs.switches,\'map/weapon change caused native switch\')\n        expect(f.binding==original and not f.trigger.active,\'normal exit restore/release\')\n        expect(all(c in (\'bind "MOUSE2" ""\',\'bind "MOUSE2" "\'+original+\'"\') for c in f.commands.sent),\'tool emitted switch command\')\n    with Fixture(binding=\'slot3\') as f:\n        shot(f);f.binding=\'lastinv\';f.loop.pause()\n    expect(f.binding==\'lastinv\',\'cleanup clobbered user binding edit\')\n    with Fixture(binding=\'+quickknife\') as f:\n        shot(f);f.fail_sample=True\n        try:f.tick()\n        except RuntimeError:f.loop.pause()\n        expect(not f.control.pressed,\'exception cleanup retained primary\')\n    expect(f.binding==\'+quickknife\',\'exception cleanup restore\')\n    return dict(bindings=[\'slot3\',\'lastinv\',\'+quickknife\'],held_start_and_resume=True,user_edit_preserved=True)\n\n\ndef cadence():\n    counts={}\n    for fullauto in (0,1):\n        with Fixture() as f:\n            f.weapon[\'FullAuto\']=fullauto\n            if not fullauto:f.weapon_name=\'deagle\';f.weapon[\'WeaponType\']=\'pistol\'\n            shot(f)\n            f.ammo-=1;f.now+=.012;f.tick()\n            if fullauto:expect(f.control.pressed,\'fullauto stopped on ammo confirmation\')\n            else:\n                expect((0x90000,4) in f.native_writes,\'semi-auto did not release\')\n                for _ in range(15):\n                    f.now+=.02;f.tick()\n                    if down_count(f)>1:break\n                expect(down_count(f)>1,\'semi-auto never submitted subsequent DOWN\')\n            # The real read-only weapon sampler marks the held input for\n            # release; the same-thread input owner executes that release.\n            f.ammo=0\n            with patch(\'time.monotonic\',side_effect=lambda:f.now):\n                f.trigger.poll_weapon();f.trigger.service_pending_release()\n            expect(not f.trigger.active,\'weapon monitor empty-clip release failed\')\n            counts[str(fullauto)]=down_count(f)\n    return counts\n\n\ndef obstacles():\n    from aim_service import AimService\n    from cso2_bot_tool import Worker\n    from types import SimpleNamespace\n    with Fixture() as f:\n        actor=f.actors[0];packet=f.obstacle(actor);service=AimService(lambda:(None,False))\n        service.set_scope(packet[\'context\']);delivered=[]\n        w=Worker.__new__(Worker);w.aim_service=service\n        w.overlay_service=SimpleNamespace(submit_wall=lambda s,c:delivered.append((s,c)) or True)\n        w.post=lambda *args:None\n        expect(w.route_wall_signal(packet[\'signals\'],packet[\'context\']),\'wall fanout rejected\')\n        expect(delivered and service.wall[\'signals\'],\'both subscribers not delivered\')\n        f.wall=service.wall;f.rays.blocked.add(actor.index);shot(f)\n        expect(f.control.diagnostic[\'visibility\']==\'penetrable\',\'blocked native ray did not consume positive wall bit\')\n        # Match the current bone identity while using current coordinates.\n        f.move(actor,(150.,4.,64.));f.tick()\n        expect(tuple(f.control.diagnostic[\'firing_aim_point\'])==actor.head,\'wall bridge reused producer old XYZ\')\n        for field,value in ((\'address\',0xBAD),(\'serial\',999),(\'model\',\'other.mdl\')):\n            f.wall=copy.deepcopy(packet);f.wall[\'signals\'][str(actor.index)][field]=value\n            f.tick();expect(f.control.target==0 and not f.control.pressed,(field,\'mismatched wall identity admitted\'))\n        # Producer revocation removes eligibility on the next independent cycle.\n        revoke=dict(packet[\'context\'],result_started_at=f.now,assessed=[(actor.index,actor.address,actor.serial,actor.model)])\n        expect(service.submit_wall({},revoke),\'wall revocation rejected\')\n        f.wall=service.wall;f.tick();expect(f.control.target==0,\'revoked wall bit still selected\')\n        expect(not service.submit_wall(packet[\'signals\'],dict(packet[\'context\'],map=\'other_map\')),\'foreign wall scope accepted\')\n        # A failed ESP subscriber cannot suppress the independent subscriber.\n        w.overlay_service=SimpleNamespace(submit_wall=lambda *args:(_ for _ in ()).throw(RuntimeError(\'offline\')))\n        fresh=dict(packet[\'context\'],result_started_at=f.now+1)\n        expect(w.route_wall_signal(packet[\'signals\'],fresh) and service.wall[\'signals\'],\'ESP failure coupled to aim\')\n    return dict(dual_delivery=True,current_bone_xyz=True,identity_and_revocation=True)\n\n\ndef logs():\n    from aim_service import AimService\n    from battle_log import BattleLog\n    from compact_log import AimLatencyTotals,DecisionTotals,JournalPolicy,encode,compact_record\n    totals=AimLatencyTotals();policy=JournalPolicy();events=[]\n    for force,mode in ((False,\'rmb_aim_fire\'),(True,\'t_force_fire\')):\n        with Fixture(force=force) as f:\n            action=shot(f)\n            service=AimService(lambda:(None,False))\n            service.latest=json.loads(json.dumps(dict(state=\'running\',pid=1234,observed_at=f.now,\n                target=f.control.target,pressed=f.control.pressed,diagnostic=f.control.diagnostic,\n                worker_latency_totals=f.loop.latency_totals.snapshot())))\n            service.poll();remote=service.control\n            remote.actions.extend(json.loads(json.dumps([action])))\n            log=BattleLog.__new__(BattleLog);log.clock=lambda:f.now;log.current={\'fire_requests\':0}\n            log.decision_totals=DecisionTotals();log.last_decision_signature=None;log.last_decision_log=0\n            log.accepted_fire_requests=collections.deque(maxlen=32)\n            log.event=lambda kind,**kw:events.append(dict(kind=kind,**kw))\n            log.actions(remote);log.aim_fire_decision(f.loop.frame,remote,remote.diagnostic,1.,2.)\n            expect(events[-1][\'aim_latency\']==f.control.diagnostic[\'aim_latency\'],\'BattleLog decision dropped latency\')\n            expect(events[-1][\'pose_refresh\']==f.control.diagnostic[\'pose_refresh\'],\'BattleLog lost pose refresh\')\n            expect(events[-1][\'wall_handoff\']==f.control.diagnostic[\'wall_handoff\'],\'BattleLog lost wall handoff\')\n            expect(log.decision_totals.snapshot()[\'worker_latency_totals\'][\'sessions\'][0][\'cycles\']==f.loop.cycle,\n                   \'BattleLog lost worker cycle totals\')\n            accepted=events[-2];expect(accepted[\'action\']==\'fire_down\',\'BattleLog action missing\')\n            policy.observe(accepted)\n            policy.observe(dict(kind=\'input_action\',action=\'fire_up\',aim_context=accepted[\'aim_context\']))\n            packed=json.loads(encode(dict(accepted,extra=[\'x\'*2000]*30),limit=1800))\n            expect(packed[\'aim_latency\']==accepted[\'aim_context\'][\'aim_latency\'],\'bounded log lost shot timing\')\n            expect(packed[\'pose_refresh\']==accepted[\'aim_context\'][\'pose_refresh\'],\'bounded log lost refresh timing\')\n            expect(packed[\'wall_handoff\']==accepted[\'aim_context\'][\'wall_handoff\'],\'bounded log lost handoff timing\')\n            cycle=copy.deepcopy(events[-1][\'aim_latency\']);cycle[\'process_id\']=100+int(force)\n            totals.observe(cycle);totals.observe(cycle)\n            gap=dict(cycle,cycle=cycle[\'cycle\']+3,started_mono=cycle[\'started_mono\']+1)\n            totals.observe(gap)\n            for i,status in enumerate((\'error\',\'cancelled\',\'cycle_complete\')):\n                totals.observe(dict(gap,cycle=gap[\'cycle\']+i+1,started_mono=gap[\'started_mono\']+i+1,\n                                    action_status=status,requested=False))\n            expect(totals.snapshot()[\'by_mode\'][mode][\'total_ms\'][\'count\']==2,\'idle/errors/repeats diluted active metrics\')\n            expect(policy.snapshot()[\'aim_fire_latency_ms\'][mode][\'total_ms\'][\'count\']==1,\'UP counted as DOWN timing\')\n            log.aim_fire_decision(f.loop.frame,remote,remote.diagnostic,1.,2.)\n            expect(log.decision_totals.snapshot()[\'aim_latency_ms\'][\'duplicate_observations\']==1,\'repeated parent cycle double-counted\')\n    report=totals.snapshot()\n    expect(report[\'duplicate_observations\']==2 and report[\'unobserved_cycles\']==4,\'mailbox coverage not explicit\')\n    expect(compact_record(dict(kind=\'diagnostic\',context=\'text\'))[\'context\']==\'text\',\'non-dict context compatibility\')\n    expect(len(policy.snapshot()[\'precision_tail\'])==2,\'accepted-shot evidence missing\')\n    for row in policy.snapshot()[\'precision_tail\']:\n        expect(row[\'pose_refresh\'][\'status\']==\'refreshed\' and\n               row[\'pose_refresh\'][\'before_fire_age_ms\']<row[\'pose_refresh\'][\'after_down_age_ms\'],\n               \'precision ring lost freshness boundaries\')\n    return dict(modes=list(report[\'by_mode\']),duplicates=2,unobserved_cycles=4,phase_fields_survive_json_and_bounded_logs=True)\n\n\ndef acquisition():\n    with Fixture() as f:\n        shot(f);f.tick()\n        expect(all(s[\'with_bones\'] and s[\'with_aimpoints\'] for s in f.samples),\'sampler depends on ESP pose\')\n        expect(f.loop.metrics[\'esp_consumed\'] is False and f.control.diagnostic[\'esp_pose_consumed\'] is False,\'incorrect data provenance\')\n        f.rays.bad_reply=True\n        try:f.tick()\n        except ValueError as ex:expect(\'acquisition_mismatch\' in str(ex),\'unexpected ray rejection\')\n        else:raise AssertionError(\'foreign ray timestamp accepted\')\n        f.loop.pause();f.rays.bad_reply=False;f.now+=.03;f.tick()\n        expect(f.control.pressed,\'ray error did not recover\')\n    worker=source(\'aim_service\')\n    expect(\'subprocess.Popen\' in worker and "\'--aim-worker\'" in worker and \'CREATE_NO_WINDOW\' in worker,\'independent Python process launch missing\')\n    expect(\'consume_target\' not in worker and \'consume_display\' not in worker,\'ESP packet consumer entered control worker\')\n    legacy=[n for n in sys.modules if n.endswith(\'_contract\') and n!=\'independent_aim_contract\']\n    expect(not legacy,(\'legacy checks were imported\',legacy))\n    return dict(current_bones=True,ray_identity_checked=True,esp_consume_forbidden=True,legacy_checks_imported=False)\n\n\ndef run():\n    from aim_scope_sampling import body_sampling\n    from aim_scope_input import force_input\n    from aim_scope_freshness import run as freshness_run\n    from aim_scope_wall_activation import run as wall_activation_run\n    from aim_scope_geometry import geometry_equivalence,local_hostage_control,dense_geometry\n    checks={}\n    for fn in (timing,selection,moving_targets,guards_and_recovery,bindings,cadence,obstacles,logs,\n               geometry_equivalence,local_hostage_control,dense_geometry,acquisition,force_input,body_sampling):\n        try:checks[fn.__name__]=dict(passed=True,evidence=fn())\n        except Exception:checks[fn.__name__]=dict(passed=False,error=traceback.format_exc())\n    try:checks[\'freshness\']=freshness_run()\n    except Exception:\n        checks[\'freshness\']={\'passed\':False,\'error\':traceback.format_exc()}\n    try:checks[\'wall_activation\']=wall_activation_run()\n    except Exception:\n        checks[\'wall_activation\']={\'passed\':False,\'error\':traceback.format_exc()}\n    return dict(passed=all(row[\'passed\'] for row in checks.values()),scope=\'independent_aim_fire_only\',\n        simulated=True,game_attached=False,live_confirmation=False,checks=checks)\n')
_EMBEDDED['experimental_aim'] = (1, '\n"""Small runtime aim/fire policy.\n\nOnly two operational path classes exist here: ``clear`` and ``penetration``.\nEverything else is an obstruction and is never converted into permission by\nthe controller.  The ESP can still render its own three display classes.\n"""\nfrom dataclasses import replace\nimport math\n\n\nWEAPON_PROFILES = {\n    \'ak47\': {\'pitch_bias\': 0.012, \'yaw_bias\': -0.004},\n    \'m4a1\': {\'pitch_bias\': 0.009, \'yaw_bias\': 0.002},\n    \'m4a1_silencer\': {\'pitch_bias\': 0.008, \'yaw_bias\': 0.001},\n    \'famas\': {\'pitch_bias\': 0.011, \'yaw_bias\': -0.002},\n    \'galil\': {\'pitch_bias\': 0.013, \'yaw_bias\': -0.003},\n    \'aug\': {\'pitch_bias\': 0.008, \'yaw_bias\': 0.001},\n    \'sg552\': {\'pitch_bias\': 0.009, \'yaw_bias\': -0.001},\n    \'scar20\': {\'pitch_bias\': 0.006, \'yaw_bias\': 0.001},\n    \'g3sg1\': {\'pitch_bias\': 0.006, \'yaw_bias\': -0.001},\n    \'mp5navy\': {\'pitch_bias\': 0.006, \'yaw_bias\': 0.001},\n    \'p90\': {\'pitch_bias\': 0.005, \'yaw_bias\': 0.001},\n    \'ump45\': {\'pitch_bias\': 0.008, \'yaw_bias\': -0.002},\n    \'default\': {\'pitch_bias\': 0.0, \'yaw_bias\': 0.0},\n}\n\n\ndef _weapon_key(name):\n    try:\n        from weapon_profiles import canonical_weapon_name\n        return canonical_weapon_name(name)\n    except (ImportError, AttributeError, TypeError, ValueError):\n        return str(name or \'\').lower().replace(\'cweapon\', \'\')\n\n\ndef weapon_profile(name):\n    return WEAPON_PROFILES.get(_weapon_key(name), WEAPON_PROFILES[\'default\'])\n\n\ndef install_recoil_policy(aim_tracking_module):\n    """Preserve measured recoil and expose movement telemetry for contracts."""\n    original_update = aim_tracking_module.AimTracker.update\n    if getattr(original_update, \'_measured_recoil_policy\', False):\n        return\n\n    def update(self, frame, target, smoothing, recoil_scale):\n        result = original_update(self, frame, target, smoothing, recoil_scale)\n        profile = weapon_profile(getattr(frame, \'weapon\', \'\'))\n        shots = max(0, min(8, int(getattr(frame, \'shots\', 0) or 0)))\n        punch = tuple(float(v) for v in getattr(frame, \'punch\', (0., 0., 0.)))\n        motion = result.get(\'motion_response\', {})\n        result[\'experimental_recoil\'] = {\n            \'profile\': _weapon_key(getattr(frame, \'weapon\', \'\')) or \'default\',\n            \'shots\': shots,\n            \'measured_punch\': punch,\n            \'bias\': (0.0, 0.0, 0.0),\n            \'configured_bias\': (profile[\'pitch_bias\'] * shots / 8.0,\n                                profile[\'yaw_bias\'] * shots / 8.0, 0.0),\n            \'bias_applied\': False,\n            \'movement_aim\': {\n                \'forced\': bool(motion.get(\'forced\')),\n                \'speed\': 0.0,\n                \'target_speed\': motion.get(\'target_speed\', 0.0),\n                \'pose_shift\': motion.get(\'pose_shift\', 0.0),\n                \'reasons\': motion.get(\'reasons\', []),\n                \'requested_smoothing\': smoothing,\n                \'applied_smoothing\': motion.get(\'applied_smoothing\', smoothing),\n                \'threshold\': 20.0,\n            },\n            \'algorithm\': \'measured_punch_observed_target_motion_v3\',\n        }\n        return result\n\n    update._measured_recoil_policy = True\n    aim_tracking_module.AimTracker.update = update\n\n\ndef install():\n    import aim_tracking\n    install_recoil_policy(aim_tracking)\n')
_EMBEDDED['esp_pipeline'] = (1, '\n"""Display-only acquisition and visibility; never authorizes aim or fire.\n\n The public state space is deliberately closed: ``visible``, ``blocked`` and\n``penetrable``.  Missing transport or geometry is a blocked display result,\nnever a fourth state that consumers can interpret differently.\n"""\nimport collections,json,math,os,struct,subprocess,sys,threading,time\nfrom dataclasses import replace\nfrom pathlib import Path\nfrom reader import MemoryError\nfrom geometry import finite,length,sub,box_ray,hull_intervals\nfrom target_rules import entity_kind\n\n\n\n\n# LEGACY ESP geometry disabled by request; reference comments only.\n# def load_display_map(game,map_name):\n#     """ESP reads neutral collision geometry independently of weapon classifiers."""\n#     from collision_cache_io import data_snapshot\n#     from geometry import BSP,StaticGeometry\n#     with data_snapshot(refresh=True):\n#         bsp=BSP.from_training(map_name)\n#         bsp.static_geometry=StaticGeometry.for_map(map_name)\n#         bsp._esp_visibility_only=True\n#         return bsp\n# \n# \n\ndef display_alive(entity):\n    if entity.health<=0:return False\n    if entity.health==1 and entity.ragdoll_present is True:return False\n    return bool(entity.reported_alive or entity.pose_confirmed )\n\n\n\n\ndef identity(entity):return (entity.index,entity.address,entity.serial,entity.model)\n\nVISIBLE=\'visible\'\nPENETRABLE=\'penetrable\'\nBLOCKED=\'blocked\'\n\n\ndef observer_display_actor(frame,entity):\n    """Observer has no combat team; include active teams in display only.\n\n    Do not rewrite entity.enemy or the shared targeting rules. Team zero is\n    an uninitialized/unassigned player and is deliberately not an observer.\n    """\n    return (frame.local.team==1 and entity.team>=2\n            and entity_kind(entity.classname)==\'player\'\n            and entity.index!=frame.local.index)\n\n\ndef combat_display_actor(entity):\n    """Accept only pl