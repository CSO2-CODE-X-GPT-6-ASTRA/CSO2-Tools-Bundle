lasticity_out_of_range\':\'弹性异常\',\n                \'world_gravity_out_of_range\':\'世界重力异常\',\'velocity_out_of_range\':\'速度异常\'}\n            detail=\'、\'.join(f\'{reasons.get(k,k)} {v}\' for k,v in rejections.items())\n            self.status=f\'识别到 {len(self.projectiles)} 枚高爆，暂无可用轨迹：{detail}\'\n        return result\n\n    def read_host(self,index,p,server_serial):\n        m=self.reader.mem;s=self.base\n        self.last_read_diagnostic={}\n        data=m.read(p,0x4cc)\n        origin=struct.unpack_from(\'<3f\',data,0x28c);velocity=struct.unpack_from(\'<3f\',data,0x298)\n        think=struct.unpack_from(\'<I\',data,0x10)[0]\n        detonate_time=struct.unpack_from(\'<f\',data,0x4c8)[0]\n        curtime=struct.unpack(\'<f\',m.read(m.u32(s+0xa54e60)+12,4))[0]\n        remaining=detonate_time-curtime\n        radius=struct.unpack_from(\'<f\',data,0x490)[0]\n        gravity=struct.unpack_from(\'<f\',data,0x270)[0]\n        elasticity=struct.unpack_from(\'<f\',data,0x278)[0]\n        world_gravity=struct.unpack(\'<f\',m.read(m.u32(s+0xa0aee0+28)+48,4))[0]\n        speed=length(velocity)\n        sample=dict(think_rva=hex(think-s),timer_offset=\'0x4c8\',\n            detonate_time=detonate_time,curtime=curtime,remaining=remaining,\n            legacy_detonate_time=struct.unpack_from(\'<f\',data,0x498)[0],\n            radius=radius,gravity=gravity,elasticity=elasticity,world_gravity=world_gravity,speed=speed)\n        def reject(reason):\n            # Keep diagnostics JSON-safe even when a field contains NaN/Inf.\n            self.last_read_diagnostic=dict(reason=reason,**{k:(v if not isinstance(v,float) or math.isfinite(v) else str(v)) for k,v in sample.items()})\n            return None\n        if think!=s+0x5078c0:return reject(\'unsupported_think\')\n        if not finite(origin+velocity+(detonate_time,curtime,remaining,radius,gravity,elasticity,world_gravity)):\n            return reject(\'nonfinite\')\n        if detonate_time<=0:return reject(\'timer_unset\')\n        if remaining<=0:return reject(\'timer_expired\')\n        if remaining>5:return reject(\'timer_out_of_range\')\n        if not 0<radius<=4096:return reject(\'radius_out_of_range\')\n        if not 0<=gravity<=4:return reject(\'gravity_out_of_range\')\n        if not 0<=elasticity<=1:return reject(\'elasticity_out_of_range\')\n        if not 0<world_gravity<=4000:return reject(\'world_gravity_out_of_range\')\n        if speed>6000:return reject(\'velocity_out_of_range\')\n        return Grenade(f\'{index}:{p}:{server_serial}\',origin,velocity,remaining,radius,\n                       (gravity or 1.)*world_gravity,elasticity)\n\n\ndef predict_blast(bsp,g):\n    position=tuple(g[\'origin\']);velocity=tuple(g[\'velocity\']);remaining=min(3.,g[\'remaining\'])\n    # Re-sample the real projectile each request. Static-brush reflection is\n    # approximate; dynamic props and player collisions are not in this BSP.\n    while remaining>1e-5:\n        dt=min(.05,remaining);remaining-=dt\n        end=add(position,(velocity[0]*dt,velocity[1]*dt,velocity[2]*dt-.5*g[\'gravity\']*dt*dt))\n        velocity=(velocity[0],velocity[1],velocity[2]-g[\'gravity\']*dt)\n        hits=bsp.trace(position,end)\n        if hits:\n            hit=hits[0];normal=hit.normal\n            if length(normal)<.9:return position\n            position=add(add(position,tuple(v*max(0,hit.enter-.002) for v in sub(end,position))),tuple(v*.6 for v in normal))\n            into=dot(velocity,normal)\n            velocity=tuple((velocity[i]-2*into*normal[i])*g[\'elasticity\'] for i in range(3))\n            if normal[2]>.7 and length(velocity)<40:return position\n        else:position=end\n    return position\n\n\ndef movement_clear(bsp,start,end):\n    # Sweep the player\'s footprint at ankle and chest heights, then require\n    # ground under the endpoint so an escape is not a step off a ledge.\n    for z in (6,36,64):\n        for x,y in ((-16,-16),(-16,16),(16,-16),(16,16)):\n            if bsp.trace(add(start,(x,y,z)),add(end,(x,y,z))):return False\n    floor=bsp.trace(add(end,(0,0,18)),add(end,(0,0,-40)))\n    return bool(floor and floor[0].normal[2]>.65)\n\n\ndef plan_dodge(bsp,actor,grenades,stamp):\n    result=dict(stamp=stamp,origin=actor[\'origin\'],direction=None,grenade_keys=[],threats=[],\n                dodge_enemies=actor.get(\'dodge_enemies\',()))\n    if not actor.get(\'grounded\') or not grenades:return result\n    grenades=sorted(grenades,key=lambda g:length(sub(g[\'origin\'],actor[\'origin\'])))[:8]\n    blasts=[(g,predict_blast(bsp,g)) for g in grenades]\n    result[\'grenade_keys\']=[g[\'key\'] for g,_ in blasts]\n    origin=actor[\'origin\'];speed=max(50.,min(320.,actor.get(\'speed\',250.)))\n    danger=[]\n    for g,point in blasts:\n        radius=g[\'radius\']+40\n        projected=add(origin,tuple(v*min(.35,g[\'remaining\']) for v in actor.get(\'velocity\',(0,0,0))))\n        if min(length(sub(origin,point)),length(sub(projected,point)))<radius:\n            danger.append((g,point,radius))\n    if not danger:return result\n    result[\'threats\']=[dict(key=g[\'key\'],blast=point,remaining=g[\'remaining\'],radius=radius) for g,point,radius in danger]\n    horizon=max(.06,min(.35,min(g[\'remaining\'] for g,_,_ in danger)))\n    distance=speed*horizon\n    def clearance(point):return min(length(sub(point,blast))-radius for g,blast,radius in danger)\n    baseline=clearance(origin);best=baseline+2.;candidates=[]\n    for i in range(8):\n        angle=i*math.pi/4;direction=(math.cos(angle),math.sin(angle),0.)\n        from dodge_enemy_policy import away_from_enemies\n        if not away_from_enemies(origin,direction,result[\'dodge_enemies\']):continue\n        end=add(origin,tuple(v*distance for v in direction))\n        score=clearance(end)\n        if score>baseline and movement_clear(bsp,origin,end):\n            candidates.append((score,direction))\n    candidates.sort(key=lambda item:item[0],reverse=True)\n    if candidates:\n        result[\'direction\']=candidates[0][1]\n        result[\'direction_candidates\']=[direction for _,direction in candidates]\n    return result\n\n\nclass DodgeControls:\n    BUTTONS=((0x57,0x8e5524,0xecd350),(0x53,0x8e54e4,0xecd344),\n             (0x41,0x8e5414,0xecd35c),(0x44,0x8e53b4,0xecd368))\n    def __init__(self,windows,clock=time.monotonic,watchdog=True):\n        self.win=windows;self.clock=clock;self.reader=None;self.owned=False;self.lock=threading.RLock()\n        self.heartbeat=0.;self.started=0.;self.pause_until=0.;self.status=\'躲雷：关闭\';self.metrics={}\n        self.permitted=lambda:True\n        self.last_origin=None;self.last_progress_at=0.;self.last_direction=None\n        self.progress_heading_stable=True\n        self.blocked_headings=[];self.replan_count=0;self.last_stuck_reason=\'\'\n        self.input_axis_flip=False;self.reverse_motion_samples=0\n        try:self.trace_path=str(BUNDLE_ENTRY.parent/\'logs\'/\'grenade_dodge.jsonl\')\n        except Exception:self.trace_path=str(Path(__file__).resolve().parent/\'logs\'/\'grenade_dodge.jsonl\')\n        self.trace_last=0.;self.trace_dropped=0.;self.trace_queue=queue.Queue(maxsize=512)\n        self.trace_inactive=None;self.trace_inactive_at=-100.;self.input_states=[]\n        self.trace_stop=threading.Event();self.trace_thread=threading.Thread(target=self._trace_writer,daemon=True)\n        self.trace_thread.start()\n        self.stop=threading.Event();self.thread=None\n        if watchdog:\n            self.thread=threading.Thread(target=self._watch,daemon=True);self.thread.start()\n        self._trace(\'logger_ready\',force=True,log_path=self.trace_path)\n\n    @staticmethod\n    def _trace_value(value):\n        if isinstance(value,dict):return {str(k):DodgeControls._trace_value(v) for k,v in value.items()}\n        if isinstance(value,(list,tuple)):return [DodgeControls._trace_value(v) for v in value]\n        if dataclasses.is_dataclass(value):return DodgeControls._trace_value(dataclasses.asdict(value))\n        if isinstance(value,Path):return str(value)\n        if isinstance(value,float) and not math.isfinite(value):return str(value)\n        return value\n\n    def _trace(self,event,now=None,force=False,**data):\n        now=self.clock() if now is None else now\n        if event==\'inactive\':\n            reason=data.get(\'reason\')\n            if reason==self.trace_inactive and now-self.trace_inactive_at<.25:return\n            self.trace_inactive=reason;self.trace_inactive_at=now\n        else:self.trace_inactive=None\n        if not force and now-self.trace_last<.05:return\n        self.trace_last=now\n        record=dict(wall_time=time.strftime(\'%Y-%m-%d %H:%M:%S\'),mono=round(now,6),event=event,\n                    build=\'2026.10.01-dodge35\')\n        record.update(self._trace_value(data))\n        try:self.trace_queue.put_nowait(record)\n        except queue.Full:self.trace_dropped+=1\n\n    def _trace_writer(self):\n        path=Path(self.trace_path);stream=None;written=0\n        try:\n            path.parent.mkdir(parents=True,exist_ok=True)\n            while not self.trace_stop.is_set() or not self.trace_queue.empty():\n                try:record=self.trace_queue.get(timeout=.2)\n                except queue.Empty:continue\n                if record is None:continue\n                if stream is None:\n                    if path.exists() and path.stat().st_size>8*1024*1024:\n                        old=path.with_name(path.stem+\'.previous.jsonl\')\n                        try:path.replace(old)\n                        except OSError:pass\n                    stream=path.open(\'a\',encoding=\'utf-8\');written=0\n                stream.write(json.dumps(record,ensure_ascii=False,separators=(\',\',\':\'))+\'\\n\');written+=1\n                if written>=32:stream.flush();written=0\n        except Exception:pass\n        finally:\n            if stream:\n                try:stream.flush();stream.close()\n                except OSError:pass\n\n    def bind(self,reader):\n        if self.reader is reader:return\n        if self.reader is not None:\n            # A new reader means a reconnect; do not carry a learned axis\n            # inversion from the previous process/module binding.\n            self.input_axis_flip=False;self.reverse_motion_samples=0\n        self.release();m=reader.mem;c=reader.client\n        for key,rva,address in self.BUTTONS:\n            if m.read(c+rva,5)!=b\'\\xb9\'+struct.pack(\'<I\',c+address):raise RuntimeError(\'移动按键签名不匹配\')\n        self.reader=reader\n\n    def _write(self,keys,release=False,frame=None):\n        if not self.reader or not self.reader.mem or not self.reader.mem.alive():self.owned=False;return\n        if not release:self.reader.require_feature(\'grenade_dodge\')\n        m=self.reader.mem;foreground=bool(self.win.foreground(m.pid));m.allow_write();errors=[];states=[]\n        if release and foreground:\n            try:foreground=not self.reader.game_ui_visible()\n            except Exception:foreground=False\n        if not release and (not foreground or self.reader.game_ui_visible() or not self.permitted()):\n            raise RuntimeError(\'移动提交门禁已关闭\')\n        gate=getattr(self,\'direction_permitted\',None)\n        if not release and gate is not None and not gate(frame,keys):\n            raise RuntimeError(\'当前WASD方向朝向敌人或提交状态变化\')\n        for key,_,address in self.BUTTONS:\n            held=(foreground and self.win.down(key)) if release else key in keys\n            try:\n                slot=self.reader.client+address+8;state=m.u32(slot)\n                if not release and held and (not self.win.foreground(m.pid) or self.reader.game_ui_visible() or not self.permitted()):\n                    raise RuntimeError(\'WASD DOWN 前模式或生命周期已变化\')\n                if bool(state&1)!=held:m.write(slot,struct.pack(\'<I\',3 if held else 4))\n                states.append(dict(key=key,requested=bool(held),before=state,readback=m.u32(slot)))\n            except Exception as ex:errors.append(f\'{chr(key)}: {ex}\')\n        self.input_states=states\n        if errors:raise RuntimeError(\'移动按键写入未完成；\'+ \'; \'.join(errors))\n\n    def release(self):\n        with self.lock:\n            if self.owned:self._write(set(),True)\n            self.owned=False;self.started=0.\n            self.last_origin=None;self.last_progress_at=0.;self.last_direction=None\n            self.progress_heading_stable=True\n            self.metrics={\'active\':False,\'replan_count\':self.replan_count,\'last_stuck_reason\':self.last_stuck_reason}\n\n    def _blocked(self,direction,now):\n        self.blocked_headings=[(item,until) for item,until in self.blocked_headings if until>now]\n        return any(dot(direction,item)>.78 for item,_ in self.blocked_headings)\n\n    def _remember_blocked(self,direction,now):\n        self.blocked_headings=[(item,until) for item,until in self.blocked_headings if until>now]\n        self.blocked_headings.append((tuple(direction),now+1.0))\n        self.blocked_headings=self.blocked_headings[-6:]\n\n    def _choose_direction(self,plan,now):\n        primary=tuple(plan.get(\'direction\') or ())\n        if len(primary)!=3 or not finite(primary):return None\n        candidates=[primary]\n        for value in plan.get(\'direction_candidates\',()):\n            try:value=tuple(float(v) for v in value)\n            except (TypeError,ValueError):continue\n            if len(value)==3 and finite(value) and length(value)>.5:candidates.append(value)\n        for value in candidates:\n            norm=length(value);value=tuple(v/norm for v in value)\n            if not self._blocked(value,now):return value\n        # No arbitrary sideways fallback: only the planner\'s tested routes\n        # may authorize movement when the previously used heading is blocked.\n        return None\n\n    @staticmethod\n    def _direction_safe(frame,plan,direction):\n        """Reject a first step that makes any active blast materially closer.\n\n        Check several points along the first movement window.  Checking only\n        the endpoint can accept a route that crosses the blast envelope before\n        reaching that endpoint (especially when the route starts beside a\n        doorway or wall).\n        """\n        from dodge_enemy_policy import away_from_enemies\n        enemies=(plan or {}).get(\'dodge_enemies\',getattr(frame,\'dodge_enemies\',()))\n        if not away_from_enemies(frame.local.origin,direction,enemies):return False\n        threats=(plan or {}).get(\'threats\',())\n        if not threats:return True\n        origin=tuple(frame.local.origin);speed=max(80.,float((plan or {}).get(\'motion_speed\') or 250.))\n        horizon=min(.28,max(.08,min(float(t.get(\'remaining\',.28)) for t in threats)))\n        for threat in threats:\n            blast=tuple(threat.get(\'blast\') or ())\n            if len(blast)!=3:continue\n            current=math.hypot(origin[0]-blast[0],origin[1]-blast[1])\n            radius=float(threat.get(\'radius\',0.))\n            # Within the active danger envelope, never accept even a small\n            # decrease in horizontal clearance. A small tolerance here can\n            # turn a doorway approach into a direct run at the grenade.\n            radial=(origin[0]-blast[0])*direction[0]+(origin[1]-blast[1])*direction[1]\n            if current<=radius+2.*speed*horizon and radial < -1e-7:\n                return False\n            for fraction in (.25,.5,.75,1.0):\n                distance=speed*horizon*fraction\n                projected=math.hypot(origin[0]+direction[0]*distance-blast[0],\n                                     origin[1]+direction[1]*distance-blast[1])\n                if (current>radius and projected<radius) or (current<=radius+2.*speed*horizon and projected < current):\n                    return False\n        return True\n\n    def _watch(self):\n        while not self.stop.wait(.04):\n            with self.lock:\n                try:\n                    if self.owned and (not self.permitted() or self.clock()-self.heartbeat>.12 or not self.reader or not self.reader.mem or\n                                       not self.win.foreground(self.reader.mem.pid) or self.reader.game_ui_visible()):\n                        self.release();self.status=\'躲雷：超时或失焦释放移动\'\n                except Exception as ex:\n                    # Keep ownership until release succeeds; retry all keys on\n                    # the next watchdog pass even if one memory write failed.\n                    self.status=\'躲雷：正在重试释放移动 · \'+str(ex)\n\n    def step(self,reader,frame,enabled,plan,bsp=None):\n        now=self.clock()\n        with self.lock:\n            self.heartbeat=now\n            def inactive(reason):\n                self.release();self.status=\'躲雷：\'+reason\n                self._trace(\'inactive\',now,force=reason not in (\'功能已关闭\',\'当前不在预测爆炸范围\'),\n                            reason=reason,local_xyz=getattr(frame.local,\'origin\',None),\n                            local_velocity=getattr(frame.local,\'velocity\',None),grenades=frame.grenades,\n                            grenade_xyz=[getattr(g,\'origin\',None) for g in frame.grenades],\n                            blast_xyz=[t.get(\'blast\') for t in (plan or {}).get(\'threats\',())],plan=plan or {})\n                self.metrics=dict(active=False,reason=reason,grenades=len(frame.grenades),\n                                  hazard_status=frame.hazard_status,local_flags=frame.local.flags,\n                                  projectile_scan=dict(getattr(frame,\'hazard_diagnostics\',{})),\n                                  plan_has_direction=bool(plan and plan.get(\'direction\')),\n                                  visible_he_approaches=sum(t.get(\'holding_he\',False) and t.get(\'visible\',False) for t in (plan or {}).get(\'approaches\',[])),\n                                  plan_age_ms=(now-plan[\'stamp\'])*1000 if plan else None,\n                                  threats=(plan or {}).get(\'threats\',[]),dodge_build=\'2026.10.01-dodge35\',\n                                  anticipation_stage=(plan or {}).get(\'stage\',\'\'),\n                                  approaches=len((plan or {}).get(\'approaches\',[])),native_mode_id=getattr(frame,\'native_mode_id\',0),\n                                  risk_model=(plan or {}).get(\'risk_model\'),risk_before=(plan or {}).get(\'risk_before\'),\n                                  risk_after=(plan or {}).get(\'risk_after\'),motion_speed=(plan or {}).get(\'motion_speed\'),\n                                  motion_source=(plan or {}).get(\'motion_source\'))\n            if not enabled:inactive(\'功能已关闭\');return\n            if not self.win.foreground(reader.mem.pid):inactive(\'游戏不在前台\');return\n            if reader.game_ui_visible():inactive(\'游戏菜单已打开\');return\n            if not 0<=now-frame.stamp<=.15:inactive(\'角色数据已过期\');return\n            if frame.local.health<=0 or not frame.local.reported_alive or not (frame.local.flags or 0)&1:\n                inactive(\'自己死亡或未着地\');return\n            live={g.key for g in frame.grenades}\n            threats={g[\'key\'] for g in (plan or {}).get(\'threats\',[]) if g.get(\'remaining\',0)>now-(plan or {}).get(\'stamp\',now)}\n            preemptive=ghost_plan_live(frame,plan)\n            ghost_context_valid=bool(not plan or not plan.get(\'anticipation\') or (\n                getattr(frame,\'native_mode_id\',0)==4 and plan.get(\'map_name\')==frame.map_name and\n                tuple(plan.get(\'local_identity\') or ())==(frame.local.index,frame.local.address,frame.local.serial)))\n            valid=bool(ghost_context_valid and ghost_mobility_live(frame,plan) and plan and plan.get(\'direction\') and len(plan[\'direction\'])==3 and 0<=now-plan[\'stamp\']<.12\n                       and finite(plan[\'direction\']) and .9<=length(plan[\'direction\'])<=1.1\n                       and length(sub(frame.local.origin,plan[\'origin\']))<48\n   