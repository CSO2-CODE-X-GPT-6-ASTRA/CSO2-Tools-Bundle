existing ray warning takes precedence.\n# ---------------------------------------------------------------------------\nWARNING_MAX_SCALE=1.6\nWARNING_MAX_PIXELS=64.0\nFAST_CLOSING_SPEED=120.0\nCLOSING_WARNING_RANGE=30./METERS_PER_UNIT\n\n\ndef fast_approaching(frame,entity,distance):\n    """Require enemy motion toward us and a shrinking horizontal separation."""\n    if (not entity.enemy or entity.dormant or entity.health<=0 or\n            not math.isfinite(distance) or not 1e-6<distance<=CLOSING_WARNING_RANGE):return False\n    velocity=entity.velocity;own=frame.local.velocity\n    if any(v is None or len(v)!=3 or not all(map(math.isfinite,v))\n           for v in (velocity,own,entity.origin,frame.local.origin)):return False\n    dx=entity.origin[0]-frame.local.origin[0];dy=entity.origin[1]-frame.local.origin[1]\n    horizontal=math.hypot(dx,dy)\n    if horizontal<=1e-6:return False\n    inward=-(velocity[0]*dx+velocity[1]*dy)/horizontal\n    closing=-((velocity[0]-own[0])*dx+(velocity[1]-own[1])*dy)/horizontal\n    return inward>=FAST_CLOSING_SPEED and closing>=FAST_CLOSING_SPEED\n\ndef rapid_approach(frame,entity,distance,ray_clear=False,on_screen=False):\n    """Offscreen warning needs the enemy eye-to-local-eye ray, not an exposed foot."""\n    stamp=getattr(entity,\'esp_reverse_sight_stamp\',None)\n    return bool(not on_screen and entity.enemy and ray_clear and\n                getattr(entity,\'esp_reverse_sight\',False) is True and\n                isinstance(stamp,(int,float)) and math.isfinite(stamp) and\n                0<=frame.stamp-stamp<=.09 and 1e-6<distance<=APPROACH_WARNING_RANGE)\n\n\ndef approach_warning_scale(frame,entity,distance,ray_clear=False):\n    """Only a freshly visible approaching enemy gets distance emphasis."""\n    age=getattr(entity,\'wall_age_ms\',None)\n    closing_warning=fast_approaching(frame,entity,distance)\n    fresh_clear=bool(ray_clear and entity.visibility==\'visible\' and age is not None and\n                     math.isfinite(age) and 0<=age<=180.)\n    if (not (closing_warning or fresh_clear) or\n            not entity.enemy or entity.dormant or entity.health<=0 or\n            not math.isfinite(distance) or distance<=0):\n        return 1.\n    velocity=entity.velocity;own=frame.local.velocity\n    if any(v is None or len(v)!=3 or not all(map(math.isfinite,v))\n           for v in (velocity,own,entity.origin,frame.local.origin)):return 1.\n    dx=entity.origin[0]-frame.local.origin[0];dy=entity.origin[1]-frame.local.origin[1]\n    horizontal=math.hypot(dx,dy)\n    if horizontal<=1e-6:return 1.\n    inward=-(velocity[0]*dx+velocity[1]*dy)/horizontal\n    closing=-((velocity[0]-own[0])*dx+(velocity[1]-own[1])*dy)/horizontal\n    if min(inward,closing)<=1.:return 1.\n    metres=max(0.,distance)*METERS_PER_UNIT\n    proximity=max(0.,min(1.,(30.-metres)/27.))\n    return min(WARNING_MAX_SCALE,1.+(WARNING_MAX_SCALE-1.)*proximity*proximity*(3.-2.*proximity))\n\n\ndef draw_approach_warning(canvas,x,y,width,height,throwable=False,points=None,yellow_only=False,scale=1.):\n    """Bounded solid triangle with an upright black mark entirely inside."""\n    red=\'#ff4c61\';yellow=APPROACH_WARNING_YELLOW\n    fill,outline=(red,yellow) if throwable else (yellow,red)\n    if yellow_only:fill,outline=yellow,\'#101820\'\n    scale=max(1.,min(WARNING_MAX_SCALE,scale)) if math.isfinite(scale) else 1.\n    if points is None:\n        x=max(22.,min(width-22.,x));y=max(60.,min(height-8.,y))\n        vertices=(x,y-6.,x-16.,y-38.,x+16.,y-38.)\n    else:\n        cx=sum(points[::2])/3.;cy=sum(points[1::2])/3.\n        vertices=tuple((cx+(v-cx)*1.75) if i%2==0 else (cy+(v-cy)*1.75) for i,v in enumerate(points))\n    cx=sum(vertices[::2])/3.;cy=sum(vertices[1::2])/3.\n    vertices=tuple((cx+(v-cx)*scale) if i%2==0 else (cy+(v-cy)*scale) for i,v in enumerate(vertices))\n    # Keep the complete enlarged triangle on screen, including its outline.\n    xs=vertices[::2];ys=vertices[1::2]\n    fit=min(1.,(WARNING_MAX_PIXELS-3.)/max(max(xs)-min(xs),max(ys)-min(ys),1.),\n            max(1.,width-8.)/max(max(xs)-min(xs),1.),\n            max(1.,height-8.)/max(max(ys)-min(ys),1.))\n    vertices=tuple((cx+(v-cx)*fit) if i%2==0 else (cy+(v-cy)*fit) for i,v in enumerate(vertices))\n    dx=max(4.-min(vertices[::2]),min(0.,width-4.-max(vertices[::2])))\n    dy=max(4.-min(vertices[1::2]),min(0.,height-4.-max(vertices[1::2])))\n    vertices=tuple(v+(dx if i%2==0 else dy) for i,v in enumerate(vertices))\n    # The incenter\'s inscribed circle gives a direction-independent interior.\n    a,b,c=[vertices[i:i+2] for i in (0,2,4)]\n    lengths=(math.dist(b,c),math.dist(a,c),math.dist(a,b));perimeter=sum(lengths)\n    if perimeter<=1e-6:return\n    mark_x=sum(p[0]*s for p,s in zip((a,b,c),lengths))/perimeter\n    mark_y=sum(p[1]*s for p,s in zip((a,b,c),lengths))/perimeter\n    twice_area=abs((b[0]-a[0])*(c[1]-a[1])-(b[1]-a[1])*(c[0]-a[0]))\n    radius=max(0.,twice_area/perimeter-2.)\n    canvas.create_polygon(*vertices,fill=fill,outline=outline,width=3)\n    if radius<1.:return\n    mark=\'#000000\';half=min(2.2,radius*.19)\n    # Filled shapes avoid generating an unbounded cache of fractional-width pens.\n    canvas.create_rectangle(mark_x-half,mark_y-radius*.78,mark_x+half,mark_y+radius*.10,fill=mark,outline=\'\')\n    dot=min(2.,radius*.21);dy=mark_y+radius*.58\n    canvas.create_oval(mark_x-dot,dy-dot,mark_x+dot,dy+dot,fill=mark,outline=\'\')\n\n\nclass DisplayAudit:\n    """Bounded render outcomes, including short drops between 1 Hz reports."""\n    def __init__(self):self.scope=None;self.previous={};self.events=[];self.sequence=0;self.switches=collections.Counter();self.last_switch={};self.previous_camera=None\n    def update(self,raw,current,scene,latch,now):\n        scope=(raw.map_name,getattr(raw,\'server_base\',0),raw.local.address,raw.local.serial)\n        if scope!=self.scope:self.previous={};self.events=[];self.scope=scope;self.switches.clear();self.last_switch.clear();self.previous_camera=None\n        # Keep projection evidence with each transition instead of trying to\n        # correlate a one-second status summary with a different camera frame.\n        matrix=current.matrix\n        camera=dict(stamp=current.stamp,eye=current.eye,angles=current.angles,\n                    projection_scale=(math.hypot(*matrix[:3]),math.hypot(*matrix[4:7])),\n                    local_origin=current.local.origin)\n        rendered={(i,p,s):layer for i,p,s,layer in scene.get(\'actor_layers\',())}\n        filtered={(row[\'index\'],row[\'address\'],row[\'serial\']):row for row in latch.get(\'dropped\',())}\n        drawn={(e.index,e.address,e.serial):e for e in current.entities}\n        states={}\n        for e in raw.entities:\n            key=(e.index,e.address,e.serial)\n            states[key]=dict(layer=rendered.get(key,filtered.get(key,{}).get(\'reason\',\'missing_before_draw\')),\n                hp=e.health,alive=e.reported_alive,ragdoll=e.ragdoll_present,\n                pose_confirmed=e.pose_confirmed,bones=len(e.skeleton),model=e.model,\n                pose_error=e.pose_diagnostic.get(\'reason\',\'\'),visibility=getattr(e,\'visibility\',\'blocked\'),\n                display_visibility=getattr(drawn.get(key),\'visibility\',None),\n                display_bones=len(drawn[key].skeleton) if key in drawn else 0,\n                sample_age_ms=max(0.,now-getattr(raw,\'stamp\',now))*1000)\n        marked={\'skeleton\',\'distance\',\'head\',\'edge_distance\',\'edge_head\',\'edge_warning\',\'edge_arrow\'}\n        for key in self.previous.keys()|states.keys():\n            old=self.previous.get(key);new=states.get(key)\n            before=old[\'layer\'] if old else \'absent\';after=new[\'layer\'] if new else \'absent\'\n            if before==after:continue\n            if before not in marked and after not in marked:continue\n            kind=\'layer_switch\' if before in marked and after in marked else \'appearance_or_drop\'\n            r