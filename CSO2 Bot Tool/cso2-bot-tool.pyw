_EMBEDDED['combat35_contract'] = (1, '"""Deterministic regressions for cadence, exit search and HE handoff; no live input."""\nimport io, math, threading, unittest\nfrom types import SimpleNamespace as NS\nfrom unittest.mock import patch\nfrom weapon_cadence import WeaponCadence, cadence_policy\nfrom penetration_exit import check_intervals, apply_exit_check\nfrom aim_selection_contract import fixture, step, WEAPON\nimport grenade_dodge as gd\nimport grenade_exit as ge\n\nUSP=dict(WEAPON,WeaponType=\'pistol\',FullAuto=0,CycleTime=.15,RecoveryTimeStand=.28045,\n         RecoveryTimeCrouch=.23371,InaccuracyFire=.03495)\n\ndef identity(f):\n    f.frame.weapon_state=dict(valid=True,local_address=f.frame.local.address,\n        classname=f.frame.weapon,handle=123,address=0x555000)\n\ndef piece(start,end,entry=77,exit=77,contents=1):\n    return dict(start=start,end=end,entry_material=entry,exit_material=exit,contents=contents)\n\ndef check(rows,power=35.,count=2,distance=1000.,prange=4000.):\n    return check_intervals(rows,distance,power,count,prange)\n\ndef dodge_fixture():\n    now=[10.];d=gd.DodgeControls.__new__(gd.DodgeControls)\n    d.clock=lambda:now[0];d.lock=threading.RLock();d.win=NS(foreground=lambda pid:True)\n    d.reader=None;d.owned=False;d.heartbeat=0.;d.started=0.;d.pause_until=0.;d.metrics={}\n    d.last_origin=None;d.last_progress_at=0.;d.last_direction=None;d.progress_heading_stable=True\n    d.blocked_headings=[];d.replan_count=0;d.last_stuck_reason=\'\';d.reverse_motion_samples=0\n    d.input_states=[];d.trace_path=\'fixture\';d._trace=lambda *a,**k:None\n    writes=[];d._write=lambda keys,release=False:writes.append((set(keys),release))\n    d.bind=lambda reader:None\n    reader=NS(mem=NS(pid=0),game_ui_visible=lambda:False)\n    local=NS(origin=(0.,0.,0.),velocity=(0.,0.,0.),health=100,reported_alive=True,flags=1,index=1,address=100,serial=1)\n    frame=NS(stamp=10.,local=local,angles=(0.,0.,0.),grenades=[NS(key=\'g\')],hazard_status=\'\',map_name=\'fixture\',native_mode_id=0)\n    plan=dict(stamp=10.,origin=local.origin,direction=(-1.,0.,0.),grenade_keys=[\'g\'],\n        threats=[dict(key=\'g\',blast=(100.,0.,0.),remaining=1.,radius=350.)],motion_speed=250.)\n    return NS(now=now,dodge=d,frame=frame,plan=plan,reader=reader,writes=writes)\n\ndef run():\n    class Tests(unittest.TestCase):\n        def test_usp_recovery_not_cycle(self):\n            p=cadence_policy(USP,1024.);self.assertAlmostEqual(p[\'interval\'],.28045);self.assertTrue(p[\'controlled\'])\n        def test_crouch_and_air_stance(self):\n            self.assertAlmostEqual(cadence_policy(USP,1024.,3)[\'interval\'],.23371)\n            self.assertAlmostEqual(cadence_policy(USP,1024.,2)[\'interval\'],.28045)\n        def test_near_only_direct_and_no_recovery(self):\n            self.assertFalse(cadence_policy(USP,100.,direct=True)[\'controlled\'])\n            self.assertTrue(cadence_policy(USP,100.,direct=False)[\'controlled\'])\n        def test_all_six_types_keep_cycles(self):\n            for kind in (\'pistol\',\'rifle\',\'submachinegun\',\'machinegun\',\'shotgun\',\'sniperrifle\'):\n                for auto in (0,1):\n                    p=cadence_policy(dict(USP,WeaponType=kind,FullAuto=auto),1024.)\n                    self.assertTrue(p[\'controlled\']);self.assertGreaterEqual(p[\'interval\'],p[\'cycle\'])\n                    self.assertFalse(p[\'engine_spread_verified\'])\n        def test_legacy_pauses_are_labelled_not_live(self):\n            for model in (\'pistol\',\'rifle\',\'machinegun\',\'submachinegun\',\'shotgun\',\'sniperrifle\'):\n                p=cadence_policy(dict(WEAPON,SpreadFunction=model),1024.)\n                self.assertEqual(p[\'recovery_source\'],\'legacy_burst_pause_estimate\')\n        def test_missing_accuracy_preserves_native(self):\n            self.assertFalse(cadence_policy(WEAPON,2048.)[\'controlled\'])\n        def test_non_firearms_and_projectiles_never_paced_as_guns(self):\n            for p in (None,dict(USP,WeaponType=\'knife\'),dict(USP,profile_status=\'projectile\')):\n                self.assertFalse(cadence_policy(p,1024.)[\'controlled\'])\n        def test_long_cycle_not_slowed_again(self):\n            p=cadence_policy(dict(USP,WeaponType=\'sniperrifle\',CycleTime=1.5),1024.)\n            self.assertFalse(p[\'controlled\']);self.assertEqual(p[\'interval\'],1.5)\n        def test_near_nan_not_exempt(self):\n            self.assertTrue(cadence_policy(USP,float(\'nan\'),direct=True)[\'controlled\'])\n        def test_far_small_and_moving_shorten_burst(self):\n            p=dict(USP,FullAuto=1,WeaponType=\'rifle\')\n            self.assertEqual(cadence_policy(p,400.,radius=20.)[\'burst_limit\'],3)\n            self.assertEqual(cadence_policy(p,400.,radius=20.,velocity=(100.,0.,0.))[\'burst_limit\'],1)\n            self.assertEqual(cadence_policy(p,400.,radius=1.)[\'burst_limit\'],1)\n        def test_first_shot_no_artificial_delay(self):\n            f=fixture(0,weapon=USP);identity(f);step(f)\n            self.assertTrue(f.control.pressed);self.assertTrue(f.control.diagnostic[\'fire_cadence\'][\'first_shot\'])\n        def test_controller_semi_retries_at_own_cycle_while_tracking(self):\n            f=fixture(0,weapon=USP);identity(f);step(f)\n            f.now[0]+=.05;f.frame.ammo-=1;step(f)\n            f.now[0]=10.1;step(f)\n            self.assertFalse(f.control.pressed);self.assertEqual(f.control.diagnostic[\'fire_wait_reason\'],\'weapon_cycle\')\n            self.assertTrue(f.control.diagnostic[\'write_readback_verified\'])\n            f.now[0]=10.151;step(f);self.assertTrue(f.control.pressed)\n        def test_controller_auto_burst_releases_on_consumption(self):\n            f=fixture(0,weapon=dict(USP,WeaponType=\'rifle\',FullAuto=1));identity(f);step(f)\n            f.now[0]+=.02;f.frame.ammo-=1;step(f)\n            self.assertFalse(f.control.pressed)\n            f.now[0]=10.31;step(f);self.assertTrue(f.control.pressed)\n        def test_controller_auto_near_keeps_repeated_clicks(self):\n            f=fixture(0,weapon=dict(USP,WeaponType=\'rifle\',FullAuto=1));identity(f)\n            f.frame.eye=(924.,0.,64.);f.frame.local.origin=(924.,0.,0.);step(f)\n            # maintenance38: explicit UP/DOWN replaces a permanently held key.\n            f.now[0]+=.02;f.frame.ammo-=1;step(f);self.assertFalse(f.control.pressed)\n            f.now[0]=10.151;step(f);self.assertTrue(f.control.pressed)\n        def test_no_ammo_feedback_has_pulse_cap(self):\n            f=fixture(0,weapon=dict(USP,FullAuto=1));identity(f);step(f)\n            f.now[0]+=.06;step(f);self.assertFalse(f.control.pressed)\n        def test_cooldown_survives_release_and_target_change(self):\n            f=fixture(0,weapon=USP);identity(f);step(f);f.control.release()\n            # Release and target reacquisition retain the weapon\'s native cycle.\n            f.reader.entity.index=3;f.reader.entity.serial=3\n            f.now[0]=10.1;step(f);self.assertFalse(f.control.pressed)\n            f.now[0]=10.151;step(f);self.assertTrue(f.control.pressed)\n        def test_reserve_reload_not_shots(self):\n            f=fixture(0);identity(f);c=WeaponCadence();c.observe(f.frame,10.)\n            f.frame.stamp=10.02;f.frame.ammo=40;c.observe(f.frame,10.02)\n            self.assertIsNone(c.records[c.current][\'last_shot\'])\n        def test_identity_change_does_not_miscount_ammo(self):\n            f=fixture(0);identity(f);c=WeaponCadence();c.observe(f.frame,10.)\n            f.frame.stamp=10.02;f.frame.ammo=1;f.frame.weapon_state[\'handle\']+=1;c.observe(f.frame,10.02)\n            self.assertIsNone(c.records[c.current][\'last_shot\'])\n        def test_map_and_clock_reset(self):\n            f=fixture(0);identity(f);c=WeaponCadence();c.observe(f.frame,10.);c.requested(10.)\n            f.frame.stamp=5.;c.observe(f.frame,5.);self.assertIsNone(c.records[c.current][\'last_request\'])\n            f.frame.map_name=\'new\';f.frame.stamp=5.02;c.observe(f.frame,5.02);self.assertEqual(len(c.records),1)\n        def test_stale_and_unverified_ammo_not_a_shot(self):\n            f=fixture(0);c=WeaponCadence();c.observe(f.frame,10.);f.frame.ammo-=1\n            f.frame.stamp=10.02;c.observe(f.frame,10.02);self.assertIsNone(c.records[c.current][\'last_shot\'])\n        def test_exit_empty_path(self):self.assertTrue(check([])[\'allowed\'])\n        def test_thick_center_blocks_but_edge_passes(self):\n            self.assertFalse(check([piece(20,116,87,87)])[\'allowed\'])\n            self.assertTrue(check([piece(20,40,87,87)])[\'allowed\'])\n        def test_mixed_exit_material_counts_gap(self):\n            p=check([piece(100,103.071361),piece(105.52654,118.428222,77,67)])\n            self.assertFalse(p[\'allowed\']);self.assertAlmostEqual(p[\'layers\'][0][\'thickness\'],18.428222)\n            self.assertEqual(p[\'layers\'][0][\'power_limit\'],17.5)\n        def test_large_empty_gap_splits_exit_layers(self):\n            p=check([piece(100,110,87,87),piece(123,133,87,87)],power=35.,count=2)\n            self.assertTrue(p[\'allowed\'],p)\n            self.assertEqual([(row[\'start\'],row[\'end\'],row[\'thickness\']) for row in p[\'layers\']],\n                             [(100,110,10),(123,133,10)])\n        def test_overlapping_and_adjacent_exit_solids_merge(self):\n            overlap=check([piece(100,120),piece(110,130)],power=35.,count=2)\n            self.assertTrue(overlap[\'allowed\'],overlap)\n            self.assertEqual(len(overlap[\'layers\']),1)\n            self.assertEqual(overlap[\'layers\'][0][\'thickness\'],30)\n            adjacent=check([piece(100,110),piece(110,120)],power=35.,count=2)\n            self.assertTrue(adjacent[\'allowed\'],adjacent)\n            self.assertEqual(len(adjacent[\'layers\']),1)\n            self.assertEqual(adjacent[\'layers\'][0][\'thickness\'],20)\n        def test_short_grazing_interval_keeps_material_and_thickness_checks(self):\n            p=check([piece(100,100.25,87,87)],power=35.,count=2)\n            self.assertTrue(p[\'allowed\'],p)\n            self.assertAlmostEqual(p[\'layers\'][0][\'thickness\'],.25)\n            self.assertEqual(p[\'layers\'][0][\'entry_material\'],87)\n            self.assertEqual(p[\'layers\'][0][\'exit_material\'],87)\n            self.assertFalse(check([piece(100,100.25,None,None)])[\'allowed\'])\n        def test_sixth_exit_query_144(self):\n            p=check([piece(10,140,87,87)],power=200)\n            self.assertTrue(p[\'allowed\']);self.assertEqual(len(p[\'layers\'][0][\'samples\']),6)\n            self.assertEqual(p[\'layers\'][0][\'samples\'][-1][\'distance\'],154.)\n        def test_exit_exhaustion(self):\n            self.assertEqual(check([piece(10,160)],power=200)[\'reason\'],\'exit_search_exhausted\')\n        def test_inside_unknown_and_target_inside(self):\n            self.assertFalse(check([piece(0,5)])[\'allowed\'])\n            self.assertFalse(check([piece(10,15,None,None)])[\'allowed\'])\n            self.assertFalse(check([piece(10,30)],distance=20.)[\'allowed\'])\n        def test_multiple_layers_remaining_budget(self):\n            self.assertFalse(check([piece(10,30),piece(100,120)])[\'allowed\'])\n            self.assertFalse(check([piece(10,20),piece(100,105)],count=1)[\'allowed\'])\n            self.assertTrue(check([piece(10,20),piece(100,105)])[\'allowed\'])\n        def test_penetration_range(self):self.assertFalse(check([piece(5001,5005)],distance=6000.)[\'allowed\'])\n        def test_rejection_never_promoted(self):\n            p=dict(kind=\'penetration\',allowed=False)\n            self.assertIs(apply_exit_check(p,None,None,(0,0,0),(100,0,0),WEAPON),p)\n        def test_clear_and_known_thin_preserved(self):\n            p=dict(kind=\'clear\',allowed=True)\n            self.assertIs(apply_exit_check(p,None,None,(0,0,0),(100,0,0),WEAPON),p)\n        def test_dodge_fresh_route_writes(self):\n            f=dodge_fixture();f.dodge.step(f.reader,f.frame,True,f.plan)\n            self.assertTrue(f.dodge.owned);self.assertEqual(f.writes[-1][0],{83})\n        def test_dodge_stale_foreground_and_death_still_stop(self):\n            for mode in (\'stale\',\'foreground\',\'death\',\'air\'):\n                f=dodge_fixture()\n                if mode==\'stale\':f.plan[\'stamp\']=9.8\n                if mode==\'foreground\':f.dodge.win.foreground=lambda pid:False\n                if mode==\'death\':f.frame.local.health=0\n                if mode==\'air\':f.frame.local.flags=0\n                f.dodge.step(f.reader,f.frame,True,f.plan);self.assertFalse(f.dodge.owned)\n        def test_dodge_rechecks_quantized_body_collision(self):\n            f=dodge_fixture()\n            with patch.object(gd,\'ghost_movement_clear\',return_value=False):f.dodge.step(f.reader,f.frame,True,f.plan,object())\n            self.assertFalse(f.dodge.owned)\n        def test_dodge_selects_safe_alternative(self):\n            f=dodge_fixture();f.plan[\'direction\']=(1.,0.,0.);f.plan[\'direction_candidates\']=[(-1.,0.,0.)]\n            f.dodge.step(f.reader,f.frame,True,f.plan);self.assertTrue(f.dodge.owned)\n        def test_momentum_does_not_blacklist_after_40ms(self):\n            f=dodge_fixture();f.dodge.step(f.reader,f.frame,True,f.plan)\n            f.now[0]+=.06;f.frame.stamp=f.now[0];f.plan[\'stamp\']=f.now[0]\n            f.frame.local.origin=(12.,0.,0.);f.frame.local.velocity=(200.,0.,0.)\n            f.dodge.step(f.reader,f.frame,True,f.plan);self.assertTrue(f.dodge.owned);self.assertEqual(f.dodge.blocked_headings,[])\n        def test_sustained_opposite_motion_still_stops(self):\n            f=dodge_fixture();f.dodge.step(f.reader,f.frame,True,f.plan)\n            f.now[0]+=.13;f.frame.stamp=f.now[0];f.plan[\'stamp\']=f.now[0]\n            f.frame.local.origin=(26.,0.,0.);f.frame.local.velocity=(200.,0.,0.)\n            f.dodge.step(f.reader,f.frame,True,f.plan);self.assertFalse(f.dodge.owned);self.assertTrue(f.dodge.blocked_headings)\n        def test_immediate_route_not_replaced_by_slow_grid(self):\n            f=dodge_fixture()\n            with patch.object(ge,\'_original\',return_value=f.plan),patch.object(ge,\'_route\',side_effect=AssertionError(\'grid called\')):\n                p=ge._wrapped_plan(None,{\'origin\':(0,0,0)},[{}],[],10.)\n            self.assertEqual(p[\'direction\'],(-1.,0.,0.));self.assertEqual(p[\'planner\'],\'immediate_hull_checked_route\')\n        def test_grid_deadline(self):\n            with patch.object(ge,\'_floor\',return_value=(0.,0.,0.)):\n                self.assertIsNone(ge._route(None,dict(origin=(0,0,0),grounded=True),[],deadline=-1.))\n        def test_reactive_dodge_does_not_pick_cross_blast_direction(self):\n            actor=dict(origin=(10.,0.,0.),velocity=(-220.,0.,0.),speed=250.,grounded=True,flags=1,yaw=0.)\n            grenade=dict(key=\'g\',origin=(0.,0.,0.),velocity=(0,0,0),remaining=1.,radius=350.,gravity=0.,elasticity=0.)\n            with patch.object(gd,\'predict_blast\',return_value=(0.,0.,0.)),patch.object(gd,\'_ghost_walk_route\',side_effect=lambda bsp,a,b:b):\n                p=gd._ghost_projectile_plan(None,actor,[grenade],10.)\n            self.assertIsNotNone(p[\'direction\']);self.assertGreaterEqual(p[\'direction\'][0],0.)\n    stream=io.StringIO();result=unittest.TextTestRunner(stream=stream,verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(Tests))\n    if not result.wasSuccessful():raise AssertionError(stream.getvalue())\n    return dict(passed=True,tests=result.testsRun,game_attached=False,input_sent=False,gpu_required=False,\n                bullet_accuracy_verified=False,live_dodge_verified=False)\n')

_EMBEDDED['penetration_exit']=(1, '"""Supplementary rejection-only exit-path check shared by display and control.\n\n24u samples through 144u follow the hash-checked server 0x55ffa0 loop.\nGeometry is decoded offline geometry, not live engine collision or damage.\n"""\nimport math,re,time\nfrom collections import OrderedDict\n\nSTEP=24.\nSAMPLE_LIMIT=144.\n# Offline traces can leave a small numerical seam between brushes that are\n# continuous in the native collision model.  Larger empty spans are separate\n# penetration layers and must not be charged as solid thickness.\nCONTINUITY_TOLERANCE=4.\nCONTENTS_MASK=0x200400b\nTRACE_MASK=0x4600400b\n\n\ndef check_intervals(pieces,distance,power,penetrations,penetration_range):\n    from ballistics import material_modifier_bounds\n    rows=sorted(pieces,key=lambda row:(row[\'start\'],row[\'end\']))\n    out=dict(allowed=False,layers=[],policy=\'sampled_exit_rejection_v1\',engine_collision_verified=False)\n    def reject(reason):out.update(reason=reason,remaining_power=power);return out\n    if not math.isfinite(distance) or distance<=0:return reject(\'invalid_exit_distance\')\n    for row in rows:\n        if not all(math.isfinite(row[k]) for k in (\'start\',\'end\')) or row[\'start\']<0 or row[\'end\']<=row[\'start\']:\n            return reject(\'invalid_exit_interval\')\n    cursor=-1e-6\n    for _ in range(17):\n        remaining=[r for r in rows if r[\'end\']>cursor+1e-5 and r[\'start\']<distance]\n        if not remaining:out.update(allowed=True,reason=\'exit_conditions_passed\',remaining_power=power);return out\n        first=remaining[0];entry=first[\'start\']\n        if entry<=cursor+1e-5:return reject(\'starts_inside_exit_geometry\')\n        if penetrations<=0:return reject(\'exit_penetration_count\')\n        if entry>penetration_range:return reject(\'exit_penetration_range\')\n        # Keep the 24u search semantics, but scope it to one continuous solid\n        # group.  The old global occupancy probe joined a second brush after\n        # a large empty gap and charged that gap as effective thickness.\n        layer_rows=[first];layer_end=first[\'end\']\n        for row in remaining[1:]:\n            if row[\'start\']>layer_end+CONTINUITY_TOLERANCE:break\n            layer_rows.append(row);layer_end=max(layer_end,row[\'end\'])\n        samples=[];sample=None\n        for step in range(1,7):\n            candidate=entry+step*STEP\n            occupied=any(r[\'start\']<=candidate<=r[\'end\'] and r.get(\'contents\',1)&CONTENTS_MASK for r in layer_rows)\n            samples.append(dict(distance=candidate,solid=occupied))\n            if not occupied:sample=candidate;break\n        if sample is None:return reject(\'exit_search_exhausted\')\n        # A contents probe may ignore a trace-only solid. A reverse trace\n        # starting inside it is not a valid outside-to-exit surface.\n        if any(r[\'start\']<=sample<=r[\'end\'] and r.get(\'contents\',1)&TRACE_MASK for r in layer_rows):\n            return reject(\'reverse_exit_starts_solid\')\n        crossed=[r for r in layer_rows if entry<r[\'end\']<=sample and r.get(\'contents\',1)&TRACE_MASK]\n        if not crossed:return reject(\'exit_surface_missing\')\n        last=max(crossed,key=lambda r:r[\'end\']);exit_at=last[\'end\']\n        if exit_at>=distance:return reject(\'target_before_exit\')\n        entry_code=first.get(\'entry_material\');exit_code=last.get(\'exit_material\')\n        lower,upper=material_modifier_bounds(entry_code,exit_code,first.get(\'contents\',1))\n        if lower is None or upper is None:return reject(\'exit_material_pending\')\n        thickness=exit_at-entry\n        modifier=lower\n        limit=power*modifier\n        layer=dict(start=entry,end=exit_at,thickness=thickness,entry_material=entry_code,\n                   exit_material=exit_code,power_limit=limit,\n                   material_modifier_lower=lower,material_modifier_upper=upper,\n                   material_state=(\'unknown_bounded\' if entry_code is None or exit_code is None else \'resolved\'),\n                   samples=samples)\n        out[\'layers\'].append(layer)\n        if thickness>power*upper+1e-5:return reject(\'exit_effective_thickness\')\n        if thickness>limit+1e-5:return reject(\'exit_material_pending\')\n        power-=thickness/modifier;penetrations-=1;cursor=exit_at\n        layer[\'remaining_power\']=power\n    return reject(\'exit_iteration_limit\')\n\n\ndef apply_exit_check(path,bsp,guard,start,end,weapon):\n    # A thin visible layer does not excuse a second solid in the exit search.\n    from ballistics import AMMO\n    if not path.get(\'allowed\') or path.get(\'kind\')!=\'penetration\':return path\n    began=time.perf_counter();result=dict(path)\n    if bsp is None:return result\n    try:\n        distance=math.dist(start,end)\n        if not distance>0:raise ValueError(\'zero ray\')\n        horizon=distance+SAMPLE_LIMIT+1.\n        delta=tuple((end[i]-start[i])*horizon/distance for i in range(3))\n        endpoint=tuple(start[i]+delta[i] for i in range(3))\n        cache=getattr(guard,\'_exit_checks\',None) if guard is not None else None\n        if cache is None and guard is not None:guard._exit_checks=cache=OrderedDict()\n        key=(id(bsp),tuple(start),tuple(end))\n        pieces=cache.get(key) if cache is not None else None\n        hit=pieces is not None\n        if pieces is None:\n            pieces=[];materials=getattr(bsp,\'surface_materials\',{})\n            from penetration_results import native_material\n            def code(value):\n                material=native_material(value) if value is not None else None\n                return ord(material[0][-1]) if material else None\n            for item in bsp.trace(start,endpoint):\n                if not item.contents&TRACE_MASK:continue\n                pieces.append(dict(start=item.enter*horizon,end=item.leave*horizon,contents=item.contents,\n                    entry_material=code(materials.get(item.texture)),\n                    exit_material=code(materials.get(getattr(item,\'exit_texture\',None) or item.texture))))\n            if guard is not None and guard.tree:\n                for proxy in guard.tree.candidates(start,delta):\n                    if proxy.hulls:\n                        intervals=guard.intervals(proxy,start,delta)\n                    else:\n                        from geometry import box_ray_interval\n                        interval=box_ray_interval(proxy.bounds,start,delta)\n                        intervals=[interval] if interval else []\n                    for a,b in intervals:\n                        if b>a:pieces.append(dict(start=a*horizon,end=b*horizon,contents=1,\n                            entry_material=proxy.material,exit_material=proxy.material))\n            if cache is not None:\n                cache[key]=pieces\n                while len(cache)>128:cache.popitem(last=False)\n        elif cache is not None:cache.move_to_end(key)\n        ammo=str((weapon or {}).get(\'primary_ammo\',\'\')).lower().removeprefix(\'bullet_player_\')\n        ammo=re.sub(r\'_(?:2|3_water|4_water|box|nato)$\',\'\',ammo)\n        power,prange=AMMO[ammo]\n        check=check_intervals(pieces,distance,power,int(weapon[\'Penetration\']),prange)\n        check.update(check_ms=(time.perf_counter()-began)*1000,cache_hit=hit)\n    except (ValueError,KeyError,TypeError,AttributeError,OverflowError) as exc:\n        check=dict(allowed=False,reason=\'exit_geometry_pending\',error=type(exc).__name__,policy=\'sampled_exit_rejection_v1\')\n    result[\'exit_check\']=check\n    if not check[\'allowed\']:\n        result.update(allowed=False,guard_reason=check[\'reason\'],reason=\'实际射线出口或有效厚度未通过复核\')\n    return result\n')

_EMBEDDED['weapon_cadence']=(1, '"""Per-weapon burst pacing. Script parameters are not live engine spread.\n\nCPU-only; never changes native fire mode, RNG, ammo or target selection.\nLegacy-model pauses are explicitly estimates, not verified recovery times.\n"""\nimport collections\nimport math\nfrom runtime_diagnostics import weapon_identity\nfrom weapon_profiles import is_firearm,weapon_cycle\n\n\ndef script_spread_hint(profile, flags=1, velocity=(0.,0.,0.)):\n    """A labelled script envelope, not engine RNG or an accuracy guarantee."""\n    profile=profile or {}\n    def value(key,default=0.):\n        v=profile.get(key,default)\n        return float(v) if type(v) in (int,float) and math.isfinite(v) and 0<=v<=10 else default\n    grounded=isinstance(flags,int) and bool(flags&1)\n    crouch=grounded and bool(flags&2)\n    speed=math.hypot(*velocity[:2]) if velocity and len(velocity)>=2 else 0.\n    if \'InaccuracyStand\' in profile:\n        key=\'InaccuracyJump\' if not grounded else \'InaccuracyMove\' if speed>80 else \'InaccuracyCrouch\' if crouch else \'InaccuracyStand\'\n        return max(.001,value(\'Spread\')+value(key,value(\'InaccuracyStand\')))\n    if profile.get(\'SpreadFunction\'):\n        key=\'JumpSpread\' if not grounded else \'RunSpread\' if speed>80 else \'DuckingSpread\' if crouch else \'DefaultSpread\'\n        return max(.001,value(key,value(\'DefaultSpread\',.01))*value(\'BaseAccuracy\',1.)+value(key+\'Offset\'))\n    return None\n\n\ndef recovery_weight(family_weight, fit, pressure, moving, airborne, distant, tiny, direct, aligned):\n    """Bounded, monotone HP/target-fit tradeoff; coefficients are policy, not physics."""\n    weight=family_weight+(1.-fit)*.45-pressure*fit*.25+(.15 if moving else 0.)\n    weight=max(0.,min(1.,weight))\n    if distant:weight=max(.85,weight)\n    if tiny:weight=max(.90,weight)\n    if not direct:weight=max(.90,weight)\n    if airborne or not aligned:weight=1.\n    return weight\n\n\ndef cadence_policy(profile, distance, flags=1, direct=False, radius=3., velocity=(0.,0.,0.),\n                   *,target_health=None,alignment_error=None):\n    profile = profile or {}\n    def number(name, default=0., maximum=10.):\n        value = profile.get(name, default)\n        return float(value) if type(value) in (int,float) and math.isfinite(value) and 0 <= value <= maximum else default\n    cycle = weapon_cycle(profile)\n    kind = profile.get(\'WeaponType\', \'unknown\')\n    automatic = bool(profile.get(\'FullAuto\', 0))\n    valid_distance = type(distance) in (int,float) and math.isfinite(distance) and distance >= 0\n    near = bool(direct and valid_distance and distance <= 192.)\n    grounded = isinstance(flags,int) and bool(flags & 1)\n    crouched = grounded and bool(flags & 2)\n    recovery = number(\'RecoveryTimeCrouch\' if crouched else \'RecoveryTimeStand\')\n    if recovery <= 0: recovery = max(number(\'RecoveryTimeStand\'),number(\'RecoveryTimeCrouch\'))\n    model = str(profile.get(\'SpreadFunction\') or (\'spread_fields\' if \'InaccuracyFire\' in profile else \'unknown\'))\n    source = \'script_recovery_parameter\' if recovery > 0 else \'not_available\'\n    # Do not invent a live spread value or apply a pistol formula to a rifle.\n    has_accuracy = recovery > 0 or model != \'unknown\'\n    if recovery <= 0 and model != \'unknown\':\n        recovery = max(.20, cycle * 2.)\n        source = \'legacy_burst_pause_estimate\'\n    speed = math.hypot(*velocity[:2]) if velocity and len(velocity) >= 2 else 0.\n    small = valid_distance and radius / max(1.,distance) < .006\n    precision = not valid_distance or distance > 768. or not grounded or speed > 80. or small\n    burst = 1 if precision or kind in (\'pistol\',\'sniperrifle\',\'sniper\',\'shotgun\') else 3\n    result = dict(weapon_type=kind,model=model,automatic=automatic,cycle=cycle,recovery=recovery,\n        interval=cycle if near or not has_accuracy else max(cycle,recovery),burst_limit=burst,\n        controlled=bool(is_firearm(profile) and has_accuracy and not near and recovery > cycle),\n        policy=\'near_survival_cycle\' if near else \'precision_burst\' if precision else \'bounded_burst\',\n        recovery_source=source,engine_spread_verified=False,profile_hash=profile.get(\'profile_hash\'),\n        stance=\'air\' if not grounded else \'crouch\' if crouched else \'stand\',moving=speed>80.,\n        target_angular_radius=math.atan2(max(0.,radius),max(1.,distance)) if valid_distance else None)\n    if not has_accuracy: result[\'policy\']=\'native_cycle_missing_accuracy\'\n    if not is_firearm(profile): result.update(controlled=False,policy=\'non_firearm\')\n    hp_valid=type(target_health) in (int,float) and math.isfinite(target_health) and target_health>0\n    error_valid=type(alignment_error) in (int,float) and math.isfinite(alignment_error) and alignment_error>=0\n    spread=script_spread_hint(profile,flags,velocity)\n    result.update(target_health=target_health if hp_valid else None,spread_hint=spread,\n                  health_basis=\'observed_entity_hp\',cadence_model=\'hp_fit_bounded_v2\',recovery_weight=1.)\n    # Missing HP/alignment preserves the historical precision policy. HP alone\n    # never grants fire permission; Controller has already verified the pose/ray.\n    if not (hp_valid and error_valid and valid_distance and spread and has_accuracy and is_firearm(profile)):\n        return result\n    angle=result[\'target_angular_radius\']\n    error=math.radians(alignment_error)\n    fit=max(0.,min(1.,(angle-error)/spread))\n    damage=profile.get(\'Damage\')\n    damage=float(damage) if type(damage) in (int,float) and math.isfinite(damage) and damage>0 else None\n    # Deliberately excludes armor, mode multipliers and head damage. This is an\n    # output-pressure index, not a predicted kill count or hit probability.\n    pressure=max(0.,min(1.,math.log2(max(1.,target_health/damage)/4.)/4.)) if damage else 0.\n    family={\'pistol\':.55,\'rifle\':.40,\'submachinegun\':.25,\'smg\':.25,\'machinegun\':.20,\n            \'shotgun\':.65,\'sniper\':.85,\'sniperrifle\':.85}.get(kind,1.)\n    aligned=error<=angle*.25\n    weight=recovery_weight(family,fit,pressure,speed>80,not grounded,distance>1536.,angle<.002,direct,aligned)\n    interval=cycle if near else cycle+(max(cycle,recovery)-cycle)*weight\n    limit=burst\n    if direct and grounded and speed<=80 and aligned and fit>=.75 and automatic and kind in (\'rifle\',\'smg\',\'submachinegun\',\'machinegun\'):\n        limit=min(8,3+int(5*pressure))\n        # HP cannot buy a longer burst than the model\'s angular budget. Modern\n        # scripts supply a per-shot increment; legacy curves remain estimates.\n        increment=number(\'InaccuracyFire\')\n        if increment>0:\n            limit=min(limit,max(1,1+int(max(0.,angle-error-spread)/increment)))\n        elif model in (\'rifle\',\'machinegun\',\'submachinegun\') and number(\'AccuracyDivisor\',maximum=1e6)>0:\n            for shots in range(2,limit+1):\n                estimate=min(number(\'MaxInaccuracy\',1.),shots**3/number(\'AccuracyDivisor\',maximum=1e6)+number(\'AccuracyOffset\'))\n                spread_n=number(\'DuckingSpread\' if crouched else \'DefaultSpread\')*estimate+number(\'DefaultSpreadOffset\')\n                if spread_n>angle-error:\n                    limit=shots-1;break\n    result.update(interval=interval,burst_limit=limit,recovery_weight=weight,target_fit=fit,\n                  hp_pressure=pressure,damage_basis=\'script_base_damage_not_kill_prediction\',\n                  alignment_margin_rad=max(0.,angle-error),\n                  policy=\'near_survival_cycle\' if near else \'hp_adaptive_burst\' if pressure>0 else \'adaptive_precision_burst\')\n    return result\n\n\nclass WeaponCadence:\n    def __init__(self):\n        self.records=collections.OrderedDict();self.context=None;self.current=None;self.last_policy={}\n\n    def observe(self,frame,now):\n        context=(frame.map_name,frame.local.index,frame.local.address,frame.local.serial)\n        if context != self.context or frame.local.health <= 0:\n            self.records.clear();self.context=context;self.last_policy={}\n        identity=weapon_identity(frame)\n        key=identity or (*context,frame.weapon,\'unverified\')\n        switched=key!=self.current\n        self.current=key\n        if switched:self.last_policy={}\n        if not math.isfinite(now) or not 0 <= now-frame.stamp <= .15:return\n        ammo=frame.ammo\n        if type(ammo) is not int or not 0 <= ammo < 10000:return\n        old=self.records.get(key)\n        reset_reason=\'observation_gap\' if old and not 0<=frame.stamp-old[\'sampled_at\']<=.3 else \'\'\n        reloaded=bool(old and ammo>old[\'ammo\'])\n        if old is None or now < old[\'observed_at\'] or reset_reason:\n            old=dict(ammo=ammo,observed_at=now,sampled_at=frame.stamp,last_shot=None,last_request=None,\n                     press_at=None,shots_in_press=0,sequence_shots=0,identity_verified=identity is not None,\n                     reset_reason=reset_reason)\n        elif switched or reloaded:\n            # Returning to the same weapon may retain real recoil history;\n            # it must never retain ownership of the old input pulse.\n            old.update(last_request=None,press_at=None,shots_in_press=0,\n                       reset_reason=\'reload\' if reloaded else \'weapon_changed\')\n        # Same entity, adjacent fresh frames only. Reload and reserve changes\n        # do not become shots; target changes do not clear recovery history.\n        if identity is not None and 0 < frame.stamp-old[\'sampled_at\'] <= .3 and 0 < old[\'ammo\']-ammo <= 32:\n            delta=old[\'ammo\']-ammo\n            old[\'last_shot\']=frame.stamp;old[\'shots_in_press\']+=delta\n            old[\'sequence_shots\']=min(128,old.get(\'sequence_shots\',0)+delta)\n        old.update(ammo=ammo,observed_at=now,sampled_at=frame.stamp)\n        self.records[key]=old;self.records.move_to_end(key)\n        while len(self.records)>32:self.records.popitem(last=False)\n\n    def requested(self,now):\n        record=self.records.get(self.current)\n        if record is not None:\n            record.update(last_request=now,press_at=now,shots_in_press=0)\n\n    def release_due(self,now,pressed,policy=None):\n        policy=self.last_policy if policy is None else policy\n        record=self.records.get(self.current)\n        if not pressed or not policy.get(\'controlled\') or not record or record[\'press_at\'] is None:return False\n        limit=policy[\'burst_limit\']\n        # Clip confirmation ends a pulse immediately; a time cap also prevents\n        # stale/no ammo feedback from creating an unlimited held burst.\n        return (record[\'shots_in_press\'] >= limit or\n                now-record[\'press_at\'] >= (limit-1)*policy[\'cycle\']+.055)\n\n    def assess(self,profile,frame,target,path,now,last_request,pressed=False,*,alignment_error=None,last_release=-math.inf,native_state=None):\n        from esp_targeting import selection_tier as path_tier\n        result=cadence_policy(profile,math.dist(target.head,frame.eye),frame.local.flags,\n            path_tier(target.visibility,path,True)==0,target.head_radius or 3.,frame.local.velocity,\n            target_health=target.health,alignment_error=alignment_error)\n        record=self.records.get(self.current) or {}\n        if (not pressed and record.get(\'last_shot\') is not None and\n                now-record[\'last_shot\']>=max(result[\'cycle\'],result[\'recovery\'])):\n            record[\'sequence_shots\']=0\n        # Evaluate this frame\'s direct path and angular geometry before any\n        # release. The previous frame\'s single-shot policy must not cut off a\n        # newly aligned larger/closer target.\n        from sustained_cadence import sustained_policy\n        result.update(direct=path_tier(target.visibility)<3,\n                      eligible_geometry=bool(is_firearm(profile) and alignment_error is not None and record.get(\'identity_verified\')))\n        result=sustained_policy(profile,result,alignment_error=alignment_error,\n                                shots_in_press=record.get(\'shots_in_press\',0) if pressed else 0,\n                                sequence_shots=record.get(\'sequence_shots\',0))\n        from high_threat_models import high_threat_cadence\n        result=high_threat_cadence(result,getattr(target,\'model\',\'\'),\n            aim_part=getattr(target,\'aim_part\',\'\'),\n            validated=bool(is_firearm(profile) and getattr(target,\'aim_points_validated\',False)),\n            alignment_error=alignment_error)\n        angle=result.get(\'target_angular_radius\');spread=result.get(\'spread_hint\')\n        from aim_points import requires_head_intent\n        native_head=bool(getattr(target,\'aim_part\',\'\')==\'head\' and requires_head_intent(target))\n        # Precision has priority over fire rate for every head-targeted weapon.\n        # Use the weapon\'s own configured recovery when its baseline envelope\n        # already exceeds the head margin; automatic weapons get no exemption.\n        # Waiting removes neither movement spread nor the baseline random cone.\n        # This is follow-up pacing, not a claim of 100% engine hit probability.\n        result[\'direct_precision_hold\']=bool(result.get(\'direct\') and result.get(\'eligible_geometry\')\n            and native_head\n            and angle and spread and spread>angle*.8\n            and result.get(\'recovery_source\')==\'script_recovery_parameter\')\n        if result[\'direct_precision_hold\']:\n            # The script recovery value is a conservative ceiling. Only an\n            # aligned, grounded direct head with a measured geometric fit may\n            # shorten it; the model is not a live engine spread measurement.\n            fit=result.get(\'target_fit\')\n            margin=result.get(\'alignment_margin_rad\'