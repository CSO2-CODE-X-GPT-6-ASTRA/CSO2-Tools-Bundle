_EMBEDDED['moving_fire_contract'] = (1, '"""Nonzero-cost native I/O and scheduling-gap movement fire regressions."""\nimport ast,inspect,struct,copy,math\nfrom dataclasses import replace\nfrom types import SimpleNamespace as NS\nfrom unittest.mock import patch\n\ndef native_fixture(velocity=(0.,100.,0.)):\n import right_click_contract\n from combat37_contract import scene,tick\n from combat36_contract import USP\n from engine_attack import EngineAttack\n tree=ast.parse(inspect.getsource(right_click_contract.run));parent=tree.body[0]\n fn=next(n for n in parent.body if isinstance(n,ast.FunctionDef) and n.name=="native_scene")\n env=dict(NS=NS,struct=struct,replace=replace,scene=scene,tick=tick,USP=USP,EngineAttack=EngineAttack)\n exec(compile(ast.Module(body=[fn],type_ignores=[]),"published_native_scene","exec"),env)\n f=env["native_scene"](velocity);f.weapon.update(CycleTime=.105,FullAuto=1)\n return f\n\ndef slow_scenario(direction=(0.,100.,0.),reported=True,period=.13,repeat_stamp=False,fault_once=False):\n f=native_fixture(direction if reported else None);actor=f.reader.entity\n initial=tuple(actor.head);reads={};edges=[];diags=[];samples=[]\n def charge(name,cost):\n  reads[name]=reads.get(name,0)+1;f.now[0]+=cost\n def position(stamp):return tuple(initial[i]+direction[i]*(stamp-10.) for i in range(3))\n def move(stamp):\n  xyz=position(stamp);actor.head=xyz;actor.origin=(xyz[0],xyz[1],xyz[2]-64.)\n  actor.velocity=direction if reported else None;actor.pose_sample_stamp=stamp\n  actor.flags=0 if abs(direction[2])>0 else 1\n  actor.aim_points=[replace(p,position=xyz) if p.part=="head" else p for p in actor.aim_points]\n old_read=f.reader.mem.read;old_vec=f.reader.mem.vec;old_u32=f.reader.mem.u32;old_i32=f.reader.mem.i32\n old_write=f.reader.mem.write;old_angles=f.reader.set_angles;old_entity=f.reader.read_entity\n f.reader.mem.read=lambda a,n:(charge("identity_memory",.00008),old_read(a,n))[1]\n f.reader.mem.vec=lambda a:(charge("view_memory",.00010),old_vec(a))[