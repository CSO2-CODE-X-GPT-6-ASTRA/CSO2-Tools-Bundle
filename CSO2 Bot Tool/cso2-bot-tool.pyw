\n                shot_paths=dict(paths),fault_indicators=dict(faults),fire_wait_reasons=dict(waits),latency_ms=timing,\n\n                first_shot_advantage_verified=False,\n\n                latency_note=\'检测到目标/具备开火条件至本工具请求开火的耗时；不是引擎实际开火时间，不证明比敌人先开枪。仅保留最近10000次请求的耗时样本。\',\n\n                aim_parts=dict(parts),reasons=dict(reasons.most_common(40)),weapons=weapons,scenarios=scenarios,recent_head_positions=list(heads))\n\n    report[\'compact_logging\']=dict(summary_matches=len(compact_summaries),skipped_sampled_detail_files=skipped_detail_files,\n        event_observations=dict(compact_events),sampled_out=dict(compact_sampled),budget_omitted=dict(compact_budgeted),\n        writer_loss_reported=sum(compact_loss_by_logger.values()),\n        unfinished_matches=sum(not s.get(\'finished\',False) for s in compact_summaries),\n        control_frame_stop_reasons=dict(compact_decisions),control_frame_wait_reasons=dict(compact_waits),\n        control_fault_frames=dict(compact_fault_frames),\n        count_basis=\'new matches from summaries; legacy matches from JSONL; never count recent rings twice\')\n    from compact_log import Metric\n    for key, summaries in compact_timing.items():\n        if not summaries:continue\n        legacy=Metric()\n        for value in latency[key]:legacy.add(value)\n        all_metrics=[legacy.snapshot()]+summaries\n        n=sum(m[\'count\'] for m in all_metrics);total=sum(m[\'sum\'] for m in all_metrics)\n        bins=[sum(m[\'bins\'][i] for m in all_metrics) for i in range(len(Metric.edges)+1)]\n        maximum=max((m[\'max\'] for m in all_metrics if m[\'count\']),default=None)\n        seen=0;upper=None\n        for i,num in enumerate(bins):\n            seen+=num\n            if n and seen>=math.ceil(n*.95):upper=Metric.edges[i] if i<len(Metric.edges) else maximum;break\n        report[\'latency_ms\'][key]=dict(samples=n,mean=total/n if n else None,max=maximum,\n            p95=None,p95_bucket_upper=upper,basis=\'new all received fire requests + legacy retained samples\')\n    if compact_summaries:\n        report[\'latency_note\']=\'新日志累计已接收的开火请求，p95_bucket_upper 为直方图区间上界；旧日志仍为最近采样。均非引擎实际开火时刻。\'\n    target=folder/\'瞄准分析.json\';temp=target.with_suffix(\'.tmp\')\n\n    temp.write_text(json.dumps(report,ensure_ascii=False,indent=2),encoding=\'utf-8\');os.replace(temp,target)\n\n    return target\n\n')



_EMBEDDED['ballistics']=(1, '"""Static-world penetration estimates, using ammo/material constants from this build.\n\nServer RVAs 0x55fa90 and 0x55fec0 supply the constants. Texture names are only\nmaterial estimates; props, armor, variant overrides and random spread are unknown.\nNo estimate constitutes engine-confirmed damage or a guaranteed kill.\n"""\nimport collections,math,re\nfrom pathlib import Path,PurePosixPath\n\nAMMO={\n    \'50ae\':(30.,1000.),\'762mm\':(39.,5000.),\'545mm\':(35.,4000.),\'556mm\':(35.,4000.),\n    \'338mag\':(45.,8000.),\'50beowulf\':(45.,8000.),\'9mm\':(21.,800.),\'45acp\':(15.,500.),\n    \'380acp\':(15.,500.),\'357sig\':(25.,800.),\'57mm\':(30.,2000.),\'58mm\':(30.,2000.),\n    \'46mm\':(30.,2000.),\'50bmg\':(60.,9500.),\'50railgun\':(60.,9500.),\n}\n\ndef material(texture):\n    from penetration_results import native_material\n    return native_material(texture)\n\n\ndef load_surface_materials(game,textures):\n    """Resolve local VMT surface properties during map load, never per aim tick."""\n    from pkg_assets import resource_index,extract\n    roots=[Path(game)/\'custom/materials\',Path(game)/\'Data/cstrike/materials\'];cache={};package_index=None\n    def read(name,seen):\n        nonlocal package_index\n        name=str(name).replace(\'\\\\\',\'/\').lower().removesuffix(\'.vmt\')\n        pure=PurePosixPath(name)\n        if pure.is_absolute() or \'..\' in pure.parts or \':\' in name or len(seen)>=4 or name in seen:return None\n        if name in cache:return cache[name]\n        result=None;found_file=False\n        for root in roots:\n            path=root/(name+\'.vmt\')\n            try:\n                if not path.is_file() or path.stat().st_size>262144:continue\n                text=re.sub(r\'//[^\\n]*\',\'\',path.read_text(encoding=\'utf-8\',errors=\'replace\'))\n            except OSError:continue\n            found_file=True\n            value=re.search(r\'"?\\$surfaceprop"?\\s+"?([a-zA-Z0-9_]+)\',text,re.I)\n            if value:result=value[1];break\n            include=re.search(r\'\\binclude"?\\s+"([^"\\n]+)"\',text,re.I)\n            if include:result=read(include[1],seen|{name})\n            break\n        if not found_file:\n            if package_index is None:\n                package_index,_=resource_index(game,Path(__file__).resolve().parent/\'cache/map-index\')\n            entry=package_index.get(\'cstrike/materials/\'+name+\'.vmt\')\n            if entry and 0<entry[\'size\']<=262144:\n                try:\n                    text=re.sub(r\'//[^\\n]*\',\'\',extract(game,entry).decode(\'utf-8\',errors=\'replace\'))\n                    value=re.search(r\'"?\\$surfaceprop"?\\s+"?([a-zA-Z0-9_]+)\',text,re.I)\n                    if value:result=value[1]\n                    else:\n                        include=re.search(r\'\\binclude"?\\s+"([^"\\n]+)"\',text,re.I)\n                        if include:result=read(include[1],seen|{name})\n                except (OSError,ValueError,KeyError):pass\n        cache[name]=result;return result\n    result={name:value for name in textures if (value:=read(name,set())) is not None}\n    # Some legacy CS16 maps ship texture names without matching VMT files.\n    # Use the bundled package snapshot for exact known names; never infer a\n    # material from a substring when neither source has an authoritative value.\n    try:\n        from surface_catalog import SURFACES\n        for name in textures:\n            key=str(name).replace(\'\\\\\',\'/\').lower()\n            if name not in result and key in SURFACES:result[name]=SURFACES[key]\n    except (ImportError,TypeError,ValueError):\n        pass\n    return result\n\ndef static_surface_materials(textures,map_name=\'\'):\n    """Use exact offline VMT properties; a texture\'s name is not its material."""\n    from penetration_results import native_texture_codes\n    native=native_texture_codes(map_name)\n    if native:\n        return {name:native[key] for name in textures\n                if (key:=str(name).replace(\'\\\\\',\'/\').lower()) in native}\n    from surface_catalog import SURFACES\n    from wall_training import MAP_SURFACE_MATERIALS\n    per_map=MAP_SURFACE_MATERIALS.get(str(map_name).lower(),{})\n    result={}\n    for name in textures:\n        key=str(name).replace(\'\\\\\',\'/\').lower()\n        value=per_map.get(name,per_map.get(key,SURFACES.get(key)))\n        if value:result[name]=value\n    return result\n\n\ndef penetration_modifier(entry_code,exit_code,contents=1):\n    from penetration_results import native_material\n    mat=native_material(entry_code) if type(entry_code) is int else None\n    if mat is None:return None\n    modifier=1. if contents&8 else mat[1]\n    if entry_code==exit_code and entry_code in (87,77):modifier*=2.\n    return modifier\n\n\ndef material_modifier_bounds(entry_code=None,exit_code=None,contents=1):\n    """Return conservative lower/upper modifiers for an exact or unknown pair.\n\n    A missing texture/material is bounded against the complete native material\n    table.  The lower bound is safe for a positive thickness-only result; the\n    upper bound is used only to prove that a thick unknown layer is impossible\n    for every candidate material.  A value between the bounds remains pending.\n    """\n    from penetration_results import native_material,native_material_codes\n    if type(contents) is not int or contents<0:return None,None\n    if any(code is not None and (type(code) is not int or native_material(code) is None)\n           for code in (entry_code,exit_code)):return None,None\n    codes=tuple(native_material_codes())\n    entries=(entry_code,) if type(entry_code) is int else codes\n    exits=(exit_code,) if type(exit_code) is int else codes\n    modifiers=[]\n    for entry in entries:\n        material=native_material(entry)\n        if material is None:continue\n        base=1. if contents&8 else float(material[1])\n        for leave in exits:\n            value=base*2. if entry==leave and entry in (77,87) else base\n            if math.isfinite(value) and value>0:modifiers.append(value)\n    if not modifiers:return None,None\n    return min(modifiers),max(modifiers)\n\n\ndef material_retention_lower(entry_code=None):\n    from penetration_results import native_material,native_material_codes\n    codes=(entry_code,) if type(entry_code) is int else native_material_codes()\n    values=[]\n    for code in codes:\n        value=native_material(code)\n        if value is not None and math.isfinite(float(value[2])) and float(value[2])>0:\n            values.append(float(value[2]))\n    return min(values) if values else .0\n\n\ndef assess_path(hits,weapon,distance,part=\'body\',surface_materials=None):\n    from penetration_results import finalize_verdict\n    result=dict(allowed=False,kind=\'blocked\',reason=\'\',estimated_damage=None,verified_damage=False,\n                model=\'native_constants_static_world_estimate\',material_source=\'unverified\',layers=[])\n    if not hits:\n        result.update(allowed=True,kind=\'clear\',reason=\'世界墙体无遮挡\');return finalize_verdict(result)\n    # Preserve measured ray thickness even when validation rejects before a\n    # normalized layer can be emitted (unknown VMT, malformed endpoints, or\n    # a budget overflow). This makes every negative verdict auditable.\n    observed=0.0\n    for hit in hits:\n        try:\n            value=float(hit.thickness)\n            if math.isfinite(value) and value>0:observed+=value\n        except (TypeError,ValueError,AttributeError):\n            continue\n    if observed>0:result[\'observed_thickness\']=round(observed,3)\n    def reject(reason):\n        result[\'reason\']=reason\n        return finalize_verdict(result)\n    try:\n        weapon=weapon or {};power_count=float(weapon.get(\'Penetration\',0));damage=float(weapon.get(\'Damage\',0))\n        reach=float(weapon.get(\'Range\',0));falloff=float(weapon.get(\'RangeModifier\',0))\n        if not all(math.isfinite(v) for v in (power_count,damage,reach,falloff,distance)):return reject(\'穿透参数无效\')\n        if not (0<power_count<=16 and power_count.is_integer() and damage>0 and reach>0 and 0<falloff<=1 and 0<distance<=reach):\n            return reject(\'武器参数不支持当前穿透射线\')\n        ammo=str(weapon.get(\'primary_ammo\',\'\')).lower().removeprefix(\'bullet_player_\')\n        ammo=re.sub(r\'_(?:2|3_water|4_water|box|nato)$\',\'\',ammo)\n        if ammo not in AMMO:return reject(\'弹种穿透参数未识别\')\n        result.update(weapon_profile_valid=True,weapon_penetration_limit=int(power_count),distance=distance,\n                      weapon_profile_source=weapon.get(\'profile_source\',\'provided_parameters\'))\n        power,penetration_range=AMMO[ammo];segments=[];unknown_material=False\n        result.update(native_ammo=ammo,initial_power=power)\n        for hit in hits:\n            start,end,thickness=float(hit.enter),float(hit.leave),float(hit.thickness)\n            if not all(math.isfinite(v) for v in (start,end,thickness)) or not 0<start<end<1 or thickness<=0:\n                return reject(\'射线起点或目标在墙内，或厚度无效\')\n            if abs(thickness-(end-start)*distance)>max(.5,thickness*.05):return reject(\'射线厚度与当前目标距离不匹配\')\n            # A texture name is not the engine\'s surface property.  Props and\n            # map-specific materials reuse names (notably Italy crates), so a\n            # texture substring alone must never authorize a shot through it.\n            prop=(surface_materials or {}).get(hit.texture)\n            mat=material(prop) if prop is not None else None\n            if mat is None:unknown_material=True\n            result[\'material_source\']=(\'thickness_only_conservative\' if unknown_material else\n                                       \'embedded_native_material_code\' if isinstance(prop,int) else\n                                       \'vmt_surfaceprop\')\n            entry_code=ord(mat[0][-1]) if mat is not None else None;exit_code=None\n            exit_prop=(surface_materials or {}).get(getattr(hit,\'exit_texture\',None))\n            exit_mat=material(exit_prop) if exit_prop is not None else None\n            if exit_mat is not None:exit_code=ord(exit_mat[0][-1])\n            else:unknown_material=True\n            if unknown_material:result[\'material_source\']=\'thickness_only_conservative\'\n            contents=getattr(hit,\'contents\',1)\n            lower,upper=material_modifier_bounds(entry_code,exit_code,contents)\n            if lower is None or upper is None:return reject(\'材质能力边界无法建立\')\n            base=lower\n            retained=material_retention_lower(entry_code)\n            kinds={mat[0]} if mat is not None else {\'unknown_material\'}\n            if exit_mat is not None:kinds.add(exit_mat[0])\n            if exit_mat is None:kinds.add(\'unknown_material\')\n            source=dict(start=start*distance,end=end*distance,entry_material=entry_code,\n                        exit_material=exit_code,contents=contents,\n                        material_state=\'unknown_bounded\' if \'unknown_material\' in kinds else \'resolved\')\n            segments.append([start*distance,end*distance,base,retained,kinds,entry_code,exit_code,contents,[source],lower,upper])\n        segments.sort(key=lambda s:s[0]);layers=[]\n        for layer in segments:\n            if layers and layer[0]<=layers[-1][1]+.01:\n                old=layers[-1]\n                if layer[1]>old[1]:old[1]=layer[1];old[6]=layer[6]\n                elif layer[1]==old[1] and layer[6]!=old[6]:old[6]=None\n                if layer[0]==old[0] and layer[5]!=old[5]:old[5]=None\n                old[2]=min(old[2],layer[2]);old[3]=min(old[3],layer[3]);old[4].update(layer[4]);old[7]&=layer[7]\n                old[8].extend(layer[8])\n                old[9]=min(old[9],layer[9]);old[10]=max(old[10],layer[10])\n            else:layers.append(layer)\n        if len(layers)>int(power_count):return reject(\'穿透层数超过武器上限\')\n        remaining_range=reach\n        for start,end,base,retained,kinds,entry_code,exit_code,contents,sources,lower,upper in layers:\n            # Only a proven uniform material pair earns the native bonus.\n            # Mixed overlapping solids retain their conservative base budget.\n            paired=penetration_modifier(entry_code,exit_code,contents) if \'unknown_material\' not in kinds and len(kinds)==1 else None\n            modifier=paired if paired is not None else lower\n            thickness=end-start\n            if start>penetration_range:return reject(\'墙体距离超过弹种穿透范围\')\n            if thickness>power*upper+1e-5:\n                if \'unknown_material\' in kinds:\n                    result.update(guard_reason=\'material_bound_exceeded\',material_bound_upper=power*upper)\n                    return reject(\'未知材质厚度超过所有候选穿透能力\')\n                return reject(\'墙体厚度超过剩余穿透能力\')\n            if thickness>power*modifier+1e-5:\n                if \'unknown_material\' in kinds:\n                    result.update(guard_reason=\'material_bound_pending\',material_bound_lower=power*modifier,\n                                  material_bound_upper=power*upper)\n                    return reject(\'未知材质下厚度处于穿透边界区间\')\n                return reject(\'墙体厚度超过剩余穿透能力\')\n            power=max(0.,power-thickness/modifier);damage*=retained\n            remaining_range=(remaining_range-end)*.5\n            if remaining_range<=0:return reject(\'穿透后的剩余射程不足\')\n            result[\'layers\'].append(dict(start=start,end=end,thickness=thickness,materials=sorted(kinds),\n                entry_material=entry_code,exit_material=exit_code,contents=contents,\n                penetration_modifier=modifier,material_modifier_lower=lower,\n                material_modifier_upper=upper,\n                material_state=\'unknown_bounded\' if \'unknown_material\' in kinds else \'resolved\',\n                material_bound_source=(\'native_material_table_lower_bound_v1\' if \'unknown_material\' in kinds else \'\'),\n                surface_segments=sources,remaining_power=power))\n        if distance-layers[-1][1]>remaining_range:return reject(\'目标超出穿透后的剩余射程\')\n        # Deliberately do not claim armored damage or a guaranteed number of shots.\n        damage*=falloff**(distance/500.)*{\'head\':4.,\'pelvis\':1.25,\'leg\':.75}.get(part,1.)\n        if damage<1:return reject(\'预计剩余伤害不足\')\n        result.update(allowed=True,kind=\'penetration\',estimated_damage=round(damage,3),\n                      reason=f\'可穿透（估算） · {len(layers)} 层 · 无护甲伤害约 {damage:.1f}\',remaining_power=power)\n        return finalize_verdict(result)\n    except (TypeError,ValueError,AttributeError,OverflowError):return reject(\'穿透数据不完整或无效\')\n\n\n\ndef point_reachable(point,allow_penetration=False):\n    from esp_targeting import point_reachable as published\n    return published(point)\n\n\ndef entity_reachable(entity,allow_penetration=False):\n    from esp_targeting import entity_reachable as published\n    return published(entity)\n\n\n\ndef thin_visible_path(path):\n    """Recognized glass/grate layers within one 32-unit total ray thickness."""\n    layers=path.get(\'layers\') or []\n    if not path.get(\'allowed\') or path.get(\'guard_reason\') or not layers:return False\n    try:\n        return (sum(layer[\'thickness\'] for layer in layers)<=32.\n                and all(0<layer[\'thickness\']<=32. and layer.get(\'materials\')\n                        and set(layer[\'materials\'])<={\'native_G\',\'native_Y\'} for layer in layers))\n    except (KeyError,TypeError,ValueError):return False\n\n\ndef path_tier(visibility,path=None,allow_penetration=True):\n    from esp_targeting import selection_tier\n    return selection_tier(visibility)\n\n\n\ndef fire_path_allowed(path,allow_penetration=True):\n    from esp_targeting import state\n    return isinstance(path,dict) and state(path.get(\'esp_verdict\'))!=\'blocked\'\n\n\ndef selection_tier(visibility,path=None,allow_penetration=True):\n    from esp_targeting 