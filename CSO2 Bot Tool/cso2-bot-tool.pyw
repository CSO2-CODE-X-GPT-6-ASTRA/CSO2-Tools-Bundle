rences,default=-math.inf)\n        result.update(ready=False,release=False,wait_ms=0.,observed_shot_at=observed,\n            state_reset_reason=record.get(\'reset_reason\',\'\'),\n            observed_burst_shots=record.get(\'shots_in_press\',0),identity_verified=record.get(\'identity_verified\',False),\n            basis=\'observed_clip_decrement_or_request_time\',first_shot=reference<0.,release_reason=\'\')\n        if is_firearm(profile):\n            from click_cadence import click_schedule\n            # Pacing/geometry still decides WHEN; this is the only owner of\n            # DOWN/UP edges. No old burst timer or ammo-arrival deadline wins.\n            result.update(click_schedule(result,record,now,pressed,last_request,last_release,native_state))\n        return result\n')

_EMBEDDED['combat36_contract'] = (1, '"""Health-aware cadence and penetration margin regression: no real input."""\nimport io,math,unittest\nfrom types import SimpleNamespace as NS\nfrom unittest.mock import patch\nfrom combat35_contract import USP as BASE_USP,identity,piece,check\nfrom aim_selection_contract import fixture,step,WEAPON,WallFixture\nfrom weapon_cadence import WeaponCadence,cadence_policy,script_spread_hint\nfrom penetration_margin import apply_margin_check,margin_endpoints\nfrom static_prop_guard import apply_fire_guard\nfrom ballistics import assess_path,thin_visible_path\nfrom penetration_results import gate_path\n\nUSP=dict(BASE_USP,Spread=.004,InaccuracyStand=.008,InaccuracyCrouch=.006,InaccuracyMove=.01724,InaccuracyJump=.28725)\n\ndef policy(hp=100,kind=\'rifle\',radius=20.,distance=400.,**kw):\n    return cadence_policy(dict(USP,WeaponType=kind,FullAuto=kind!=\'pistol\'),distance,\n        direct=True,radius=radius,target_health=hp,alignment_error=0.,**kw)\n\n\ndef run():\n    class Tests(unittest.TestCase):\n        def test_high_hp_faster_but_not_beyond_native(self):\n            for kind in (\'rifle\',\'machinegun\',\'submachinegun\',\'pistol\',\'shotgun\',\'sniperrifle\'):\n                ps=[policy(h,kind) for h in (20,100,500,2000,100000)]\n                self.assertTrue(all(a[\'interval\']>=b[\'interval\'] for a,b in zip(ps,ps[1:])))\n                self.assertLess(ps[-1][\'interval\'],ps[0][\'interval\'])\n                self.assertTrue(all(p[\'interval\']>=p[\'cycle\'] for p in ps))\n        def test_unknown_hp_preserves_precision(self):\n            for h in (None,0,-1,True,float(\'nan\'),float(\'inf\')):\n                p=policy(h);self.assertAlmostEqual(p[\'interval\'],p[\'recovery\'])\n        def test_boss_does_not_override_air_or_unaligned(self):\n            p=policy(100000,flags=0);self.assertEqual(p[\'recovery_weight\'],1.)\n            p=cadence_policy(USP,400,direct=True,radius=20,target_health=100000,alignment_error=2.)\n            self.assertEqual(p[\'recovery_weight\'],1.)\n        def test_far_tiny_stays_precise(self):\n            p=policy(100000,radius=1.,distance=4000.)\n            self.assertGreaterEqual(p[\'recovery_weight\'],.9);self.assertEqual(p[\'burst_limit\'],1)\n        def test_cover_never_uses_boss_fast_burst(self):\n            p=cadence_policy(USP,400,direct=False,radius=20,target_health=100000,alignment_error=0.)\n            self.assertGreaterEqual(p[\'recovery_weight\'],.9);self.assertEqual(p[\'burst_limit\'],1)\n        def test_auto_boss_bounded_not_permanent_spray(self):\n            p=policy(100000,radius=120.);self.assertEqual(p[\'burst_limit\'],8)\n            f=fixture(0);identity(f);c=WeaponCadence();c.observe(f.frame,10);c.requested(10)\n            self.assertTrue(c.release_due(12,True,p))\n        def test_semi_always_single(self):\n            self.assertEqual(policy(100000,\'pistol\')[\'burst_limit\'],1)\n        def test_health_does_not_bypass_per_shot_spread(self):\n            p=policy(100000);self.assertLess(p[\'burst_limit\'],8)\n        def test_legacy_divisor_not_filtered_as_recovery_time(self):\n            w=dict(WEAPON,SpreadFunction=\'rifle\',BaseAccuracy=.2,DefaultSpread=.015,\n                   AccuracyDivisor=240.,AccuracyOffset=.4,MaxInaccuracy=1.)\n            p=cadence_policy(w,768,direct=True,radius=3,target_health=100000,alignment_error=0.)\n            self.assertEqual(p[\'burst_limit\'],1)\n            p=cadence_policy(w,400,direct=True,radius=20,target_health=100000,alignment_error=0.)\n            self.assertEqual(p[\'burst_limit\'],8)\n        def test_native_70ms_cycle_preserved(self):\n            from weapon_profiles import weapon_cycle,trigger_due\n            w=dict(USP,CycleTime=.07,FullAuto=0)\n            self.assertEqual(weapon_cycle(w),.07)\n            self.assertEqual(cadence_policy(w,100,direct=True)[\'interval\'],.07)\n            self.assertTrue(trigger_due(w,.071,0,False,False))\n        def test_low_hp_never_increases_burst(self):\n            self.assertLessEqual(policy(10)[\'burst_limit\'],policy(100000)[\'burst_limit\'])\n        def test_current_hp_not_cached_across_target(self):\n            f=fixture(0,weapon=dict(USP,FullAuto=1,WeaponType=\'rifle\'));identity(f)\n            c=WeaponCadence();c.observe(f.frame,10);t=f.reader.entity;t.head_radius=20\n            t.head=(400,0,64);t.health=100000;t.visibility=\'visible\'\n            a=c.assess(f.weapon,f.frame,t,dict(kind=\'clear\',allowed=True),10,-1,alignment_error=0.)\n            t.health=20\n            b=c.assess(f.weapon,f.frame,t,dict(kind=\'clear\',allowed=True),10,-1,alignment_error=0.)\n            # maintenance37: geometric fit, not high HP, unlocks native cadence.\n            # Keep checking fresh HP rather than requiring an artificial pause.\n            self.assertEqual(a[\'target_health\'],100000);self.assertEqual(b[\'target_health\'],20)\n            self.assertEqual(b[\'interval\'],a[\'interval\']);self.assertFalse(b[\'fixed_hp_unlock\'])\n        def test_sample_time_does_not_add_control_latency(self):\n            f=fixture(0);identity(f);c=WeaponCadence();c.observe(f.frame,10)\n            f.frame.ammo-=1;f.frame.stamp=10.05;c.observe(f.frame,10.10)\n            self.assertEqual(c.records[c.current][\'last_shot\'],10.05)\n        def test_same_sample_and_reserve_not_double_counted(self):\n            f=fixture(0);identity(f);c=WeaponCadence();c.observe(f.frame,10)\n            f.frame.ammo-=1;c.observe(f.frame,10.01)\n            self.assertIsNone(c.records[c.current][\'last_shot\'])\n        def test_actual_controller_has_health_and_policy(self):\n            f=fixture(0,weapon=USP);identity(f);d=step(f)\n            self.assertEqual(d[\'fire_cadence\'][\'target_health\'],100)\n            self.assertIn(\'target_fit\',d[\'fire_cadence\']);self.assertTrue(f.control.pressed)\n        def test_health_never_bypasses_view_or_ammo(self):\n            for bad in (\'view\',\'ammo\'):\n                f=fixture(0,weapon=USP);f.reader.entity.health=100000\n                if bad==\'view\':f.reader.bad_readback=True\n                else:f.frame.ammo=0\n                d=step(f);self.assertFalse(f.control.pressed,d)\n        def test_legacy_and_modern_hints_labelled(self):\n            self.assertGreater(script_spread_hint(USP),0.)\n            self.assertIsNone(script_spread_hint({}))\n            self.assertGreater(script_spread_hint(dict(WEAPON,SpreadFunction=\'rifle\',BaseAccuracy=.2,DefaultSpread=.015)),0.)\n        def test_vertical_margin_has_four_finite_rays(self):\n            for end in ((0,0,100),(0,0,-100),(100,10,20)):\n                rows=margin_endpoints((0,0,0),end,.003)\n                self.assertEqual(len(rows),4);self.assertEqual(len(set(rows)),4)\n                self.assertTrue(all(all(math.isfinite(x) for x in row) for row in rows))\n        def test_margin_never_promotes_rejected(self):\n            p=dict(kind=\'penetration\',allowed=False)\n            self.assertIs(apply_margin_check(p,None,None,(),(),None,\'head\',\'\'),p)\n        def test_clear_path_does_not_trace_margin(self):\n            p=dict(kind=\'clear\',allowed=True)\n            self.assertIs(apply_margin_check(p,None,None,(),(),None,\'head\',\'\'),p)\n        def test_stable_wood_stays_allowed(self):\n            w=WallFixture(5);a=(0,0,0);b=(500,0,0)\n            p=gate_path(assess_path(w.trace(a,b),WEAPON,500,\'head\',{\'T\':87}),\'cs_italy\')\n            r=apply_fire_guard(p,w.fast_bsp.static_fire_guard,a,b,WEAPON,\'head\',\'cs_italy\',bsp=w.fast_bsp)\n            self.assertTrue(r[\'allowed\']);self.assertEqual(len(r[\'penetration_margin\'][\'samples\']),4)\n        def test_marginal_box_center_pass_neighbor_blocks(self):\n            w=WallFixture(5);a=(0,0,0);b=(500,0,0);original=w.trace\n            def trace(s,e):\n                w.thickness=80. if e[1]<0 else 5.\n                return original(s,e)\n            w.fast_bsp.trace=trace\n            p=gate_path(assess_path(original(a,b),WEAPON,500,\'head\',{\'T\':87}),\'cs_italy\')\n            r=apply_fire_guard(p,w.fast_bsp.static_fire_guard,a,b,WEAPON,\'head\',\'cs_italy\',bsp=w.fast_bsp)\n            self.assertFalse(r[\'allowed\']);self.assertEqual(r[\'guard_reason\'],\'penetration_margin_unstable\')\n        def test_margin_cache_weapon_change_invalidates(self):\n            w=WallFixture(5);a=(0,0,0);b=(500,0,0);g=w.fast_bsp.static_fire_guard\n            p=gate_path(assess_path(w.trace(a,b),WEAPON,500,\'head\',{\'T\':87}),\'cs_italy\')\n            first=apply_fire_guard(p,g,a,b,WEAPON,\'head\',\'cs_italy\',bsp=w.fast_bsp)\n            again=apply_fire_guard(p,g,a,b,WEAPON,\'head\',\'cs_italy\',bsp=w.fast_bsp)\n            other=apply_fire_guard(p,g,a,b,dict(WEAPON,Damage=41),\'head\',\'cs_italy\',bsp=w.fast_bsp)\n            self.assertFalse(first[\'penetration_margin\'][\'cache_hit\']);self.assertTrue(again[\'penetration_margin\'][\'cache_hit\'])\n            self.assertFalse(other[\'penetration_margin\'][\'cache_hit\'])\n        def test_reverse_contents_mask_difference(self):\n            p=check([piece(10,15),piece(20,60,contents=0x40000000)])\n            self.assertFalse(p[\'allowed\']);self.assertEqual(p[\'reason\'],\'reverse_exit_starts_solid\')\n        def test_thin_first_layer_does_not_skip_hidden_exit_solid(self):\n            from geometry import WallHit\n            from penetration_exit import apply_exit_check\n            p=dict(allowed=True,kind=\'penetration\',layers=[dict(thickness=3.,materials=[\'native_G\'])])\n            bsp=NS(surface_materials={\'g\':71,\'w\':87},trace=lambda a,b:[WallHit(10/645,13/645,3,\'g\',1),WallHit(15/645,150/645,135,\'w\',1)])\n            r=apply_exit_check(p,bsp,None,(0,0,0),(500,0,0),WEAPON)\n            self.assertFalse(r[\'allowed\']);self.assertFalse(thin_visible_path(r))\n    stream=io.StringIO();result=unittest.TextTestRunner(stream=stream,verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(Tests))\n    if not result.wasSuccessful():raise AssertionError(stream.getvalue())\n    return dict(passed=True,tests=result.testsRun,game_attached=False,input_sent=False,\n                engine_spread_verified=False,runtime_gpu_required=False)\n')

_EMBEDDED['penetration_margin'] = (1, '"""Bounded adjacent-ray rejection shared by ESP and fire.\n\nFour sampled rays are a margin heuristic, not a full cone proof or live bullet\nsimulation. They only reject; they never turn an earlier blocked path into fire.\n"""\nimport math,time\nfrom collections import OrderedDict\n\n\ndef margin_endpoints(start,end,slope):\n    distance=math.dist(start,end)\n    if not math.isfinite(distance) or distance<=0 or not math.isfinite(slope) or slope<=0:\n        raise ValueError(\'invalid_margin_ray\')\n    f=tuple((end[i]-start[i])/distance for i in range(3));h=math.hypot(*f[:2])\n    right=(-f[1]/h,f[0]/h,0.) if h>1e-8 else (1.,0.,0.)\n    up=(f[1]*right[2]-f[2]*right[1],f[2]*right[0]-f[0]*right[2],f[0]*right[1]-f[1]*right[0])\n    return [tuple(end[i]+sign*distance*slope*axis[i] for i in range(3))\n            for axis in (right,up) for sign in (-1.,1.)]\n\n\ndef apply_margin_check(path,bsp,guard,start,end,weapon,part,map_name):\n    from ballistics import assess_path,thin_visible_path\n    if not path.get(\'allowed\') or path.get(\'kind\')!=\'penetration\' or thin_visible_path(path):return path\n    from weapon_cadence import script_spread_hint\n    from penetration_results import gate_path\n    from static_prop_guard import apply_fire_guard\n    began=time.perf_counter();result=dict(path)\n    slope=max(.003,min(.012,script_spread_hint(weapon) or .003))\n    key=(id(bsp),tuple(start),tuple(end),part,map_name,slope,\n         tuple((k,(weapon or {}).get(k)) for k in (\'profile_hash\',\'profile_source\',\'Penetration\',\'Damage\',\'Range\',\'RangeModifier\',\'primary_ammo\')))\n    cache=getattr(guard,\'_margin_checks\',None) if guard is not None else None\n    if cache is None and guard is not None:guard._margin_checks=cache=OrderedDict()\n    cached=cache.get(key) if cache is not None else None\n    if cached is not None:\n        cache.move_to_end(key);check=dict(cached,cache_hit=True)\n    else:\n        check=dict(allowed=True,policy=\'adjacent_ray_margin_v1\',slope=slope,samples=[],cache_hit=False,\n                   engine_spread_verified=False,full_cone_verified=False)\n        try:\n            for endpoint in margin_endpoints(start,end,slope):\n                distance=math.dist(start,endpoint)\n                neighbor=gate_path(assess_path(bsp.trace(start,endpoint),weapon,distance,part,bsp.surface_materials),map_name)\n                neighbor=apply_fire_guard(neighbor,guard,start,endpoint,weapon,part,map_name,bsp=bsp,_margin=False)\n                check[\'samples\'].append(dict(endpoint=endpoint,allowed=bool(neighbor.get(\'allowed\')),\n                    kind=neighbor.get(\'kind\'),reason=neighbor.get(\'guard_reason\') or neighbor.get(\'reason\'),\n                    thickness=[l[\'thickness\'] for l in neighbor.get(\'layers\',[])],\n                    exit_reason=(neighbor.get(\'exit_check\') or {}).get(\'reason\')))\n                if not neighbor.get(\'allowed\'):check[\'allowed\']=False\n        except (ValueError,TypeError,AttributeError,KeyError,OverflowError) as exc:\n            check.update(allowed=False,error=type(exc).__name__)\n        if cache is not None:\n            cache[key]=check\n            while len(cache)>128:cache.popitem(last=False)\n    check=dict(check,check_ms=(time.perf_counter()-began)*1000)\n    result[\'penetration_margin\']=check\n    if not check[\'allowed\']:\n        result.update(allowed=False,guard_reason=\'penetration_margin_unstable\',reason=\'邻近射线厚度或出口条件不一致\')\n    return result\n')

_EMBEDDED['combat37_contract'] = (1, '"""Sustained native cadence / generic-hitgroup regressions; mocked input only."""\nimport io,math,unittest\nfrom dataclasses import replace\nfrom aim_selection_contract import fixture,step,WEAPON\nfrom combat35_contract import identity\nfrom combat36_contract import USP\nfrom aim_points import AimPoint,select_aim_view\nfrom weapon_cadence import WeaponCadence,cadence_policy\nfrom sustained_cadence import sustained_policy,earliest_gap\n\nXT97=dict(WEAPON,CycleTime=.105,Damage=33.,SpreadFunction=\'rifle\',BaseAccuracy=.2,\n    AccuracyDivisor=240.,AccuracyOffset=.4,MaxInaccuracy=1.,DefaultSpread=.015,\n    DefaultSpreadOffset=0.,RunSpread=.04,RunSpreadOffset=.005,\n    DuckingSpread=.011,DuckingSpreadOffset=0.,JumpSpread=.3,JumpSpreadOffset=.02)\n\ndef policy(p=XT97,distance=128.,radius=12.,hp=120,flags=1,direct=True,speed=0.,error=0.,**kw):\n    b=cadence_policy(p,distance,flags,direct,radius,(speed,0,0),target_health=hp,alignment_error=error)\n    b.update(direct=direct,eligible_geometry=True)\n    return sustained_policy(p,b,alignment_error=error,**kw)\n\ndef scene(p=XT97,generic=True,distance=128.):\n    f=fixture(0,weapon=p);identity(f);e=f.reader.entity\n    e.head=(distance,0.,64.);e.origin=(distance,0.,0.);e.health=120;e.head_radius=3.\n    e.head_source=\'anatomical_generic\' if generic else \'head_hitgroup\'\n    e.aim_points=[AimPoint(\'head\',\'head\',e.head,3.,0),\n                  AimPoint(\'torso\',\'torso\',(distance,0.,44.),12.,10),\n                  AimPoint(\'pelvis\',\'pelvis\',(distance,0.,30.),8.,20)]\n    f.wall.refresh_target(f.frame,e,p)\n    return f\n\ndef tick(f,when,shot=False):\n    f.now[0]=when;f.frame.angles=f.reader.angles\n    if shot:f.frame.ammo-=1;f.reader.entity.health-=1\n    return step(f)\n\ndef run():\n    class Tests(unittest.TestCase):\n        def test_native_without_high_hp_or_model_whitelist(self):\n            for hp in (1,20,120,100000):\n                q=policy(hp=hp);self.assertEqual(q[\'interval\'],.105)\n                self.assertTrue(q[\'continuous\']);self.assertIsNone(q[\'burst_limit\'])\n                self.assertFalse(q[\'engine_spread_verified\'])\n        def test_large_moving_target_native(self):\n            self.assertTrue(policy(speed=250)[\'continuous\'])\n        def test_far_tiny_or_first_spread_outside_keeps_fallback(self):\n            for d,r,s in ((4000,1,0),(500,3,250)):\n                q=policy(distance=d,radius=r,speed=s)\n                self.assertEqual(q[\'rate_model\'],\'legacy_fallback\');self.assertEqual(q[\'burst_limit\'],1)\n        def test_geometry_allows_followup_without_range_penalty(self):\n            q=policy(distance=800,radius=20)\n            self.assertTrue(q[\'continuous\']);self.assertEqual(q[\'interval\'],q[\'cycle\'])\n        def test_cover_air_missing_hp_and_alignment_keep_fallback(self):\n            for kw in (dict(direct=False),dict(flags=0),dict(hp=None),dict(error=30),dict(error=-1),dict(error=float(\'nan\'))):\n                self.assertEqual(policy(**kw)[\'rate_model\'],\'legacy_fallback\')\n        def test_missing_parameters_do_not_invent_curves(self):\n            self.assertEqual(policy(p=WEAPON)[\'rate_model\'],\'legacy_fallback\')\n        def test_modern_auto_and_semi(self):\n            q=policy(p=dict(USP,FullAuto=1));self.assertTrue(q[\'continuous\'])\n            q=policy(p=USP);self.assertFalse(q[\'continuous\']);self.assertEqual(q[\'burst_limit\'],1)\n        def test_gap_bounds_and_monotonic(self):\n            for budget in (0,.0001,.001,.01,.1):\n                g=earliest_gap(.1,.3,.04,budget);self.assertTrue(.1<=g<=.3)\n            self.assertGreaterEqual(earliest_gap(.1,.3,.04,.001),earliest_gap(.1,.3,.04,.01))\n        def test_sequence_does_not_reset_at_new_press(self):\n            q=policy(distance=500,radius=5.,sequence_shots=0)\n            hot=policy(distance=500,radius=5.,sequence_shots=10)\n            self.assertGreater(q[\'burst_limit\'],hot[\'burst_limit\'])\n        def test_generic_keeps_all_body_points_and_prefers_clear_head(self):\n            # A generic rig has no damage multiplier, but a published clear\n            # head point remains the most precise point.  Torso/pelvis/limb\n            # samples stay available as fallbacks when that point is covered.\n            for generic,part in ((True,\'head\'),(False,\'head\')):\n                f=scene(generic=generic);d=step(f)\n                self.assertEqual(d[\'aim_part\'],part);self.assertTrue(f.control.pressed)\n                self.assertEqual(f.frame.entities[0].head,(128,0,64))\n        def test_real_wall_probe_does_not_stop_at_generic_head(self):\n            from wall_service import WallService\n            from types import SimpleNamespace as NS\n            from static_prop_guard import StaticPropGuard\n            for generic,part in ((True,\'torso\'),(False,\'head\')):\n                f=scene(generic=generic);w=WallService.__new__(WallService)\n                w.fast_bsp=NS(trace=lambda a,b:[],surface_materials={},static_fire_guard=StaticPropGuard([],{}))\n                w.map_args=(\'\',f.frame.map_name,None)\n                w.refresh_target(f.frame,f.reader.entity,f.weapon,probe_only=True)\n                t=select_aim_view(f.frame,f.reader.entity,f.weapon,10,require_safe=False)\n                self.assertEqual(t.aim_part,part)\n        def test_native_twenty_shots_no_fixed_eight_round_cap(self):\n            f=scene();d=tick(f,10);self.assertTrue(d[\'fire_cadence\'][\'continuous_budget\'])\n            for i in range(1,21):\n                d=tick(f,10+(i-1)*.105+.02,True);self.assertFalse(f.control.pressed,(i,d))\n                d=tick(f,10+i*.105);self.assertTrue(f.control.pressed,(i,d))\n                self.assertFalse(d[\'fire_cadence\'][\'release\'])\n            self.assertEqual(f.inputs.events,[True]+[v for _ in range(20) for v in (False,True)])\n        def test_unconfirmed_click_is_bounded_and_retries(self):\n            for p in (XT97,USP):\n                f=scene(p=p);tick(f,10);d=tick(f,10.06)\n                self.assertFalse(f.control.pressed);self.assertTrue(d[\'fire_cadence\'][\'release\'])\n                d=tick(f,10+p[\'CycleTime\']+.001);self.assertTrue(f.control.pressed)\n        def test_no_feedback_watchdog_releases(self):\n            f=scene();tick(f,10);d=tick(f,10.28)\n            self.assertFalse(f.control.pressed);self.assertTrue(d[\'fire_cadence\'][\'release\'])\n        def test_current_far_geometry_releases_previous_continuous(self):\n            f=scene();tick(f,10);e=f.reader.entity\n            e.head=(2000.,0,64.);e.origin=(2000.,0,0.)\n            for p in e.aim_points:p.position=(2000.,0.,p.position[2]);p.radius=.5\n            d=tick(f,10.11,True);self.assertFalse(f.control.pressed)\n        def test_readback_fail_releases_immediately(self):\n            f=scene();tick(f,10);f.reader.bad_readback=True;tick(f,10.01)\n            self.assertFalse(f.control.pressed)\n        def test_empty_and_foreground_and_disabled_and_dead_release(self):\n            for bad in (\'ammo\',\'foreground\',\'fire\',\'dead\'):\n                f=scene();tick(f,10)\n                if bad==\'ammo\':f.frame.ammo=0\n                elif bad==\'foreground\':f.inputs.active=False\n                elif bad==\'fire\':f.cfg.fire=False\n                else:f.reader.entity.health=0\n                tick(f,10.01);self.assertFalse(f.control.pressed,bad)\n        def test_new_thick_cover_stops_sustained(self):\n            f=scene();tick(f,10);f.wall.thickness=100.\n            f.wall.refresh_target(f.frame,f.reader.entity,f.weapon)\n            tick(f,10.01);self.assertFalse(f.control.pressed)\n        def test_visible_head_before_blocked_generic_body(self):\n            f=scene();e=f.reader.entity\n            for p in e.aim_points:\n                if p.part!=\'head\':p.visibility=\'blocked\';p.penetration={\'kind\':\'blocked\',\'allowed\':False}\n            t=select_aim_view(f.frame,e,f.weapon,10,require_safe=False)\n            self.assertEqual(t.aim_part,\'head\')\n        def test_generic_part_stability_small_radius_difference(self):\n            f=scene();e=f.reader.entity;e.aim_points[2].radius=11.5\n            t=select_aim_view(f.frame,e,f.weapon,10,\'pelvis\',require_safe=False)\n            self.assertEqual(t.aim_part,\'head\')\n        def test_nonproductive_generic_recheck_keeps_body_options(self):\n            f=scene();g=f.control.shot_progress;e=f.reader.entity\n            g.records[g.key(f.frame,e)]={\'failures\':1}\n            self.assertIs(g.head_view(f.frame,e),e)\n        def test_half_auto_confirmed_shot_releases_before_followup(self):\n            f=scene(p=USP);tick(f,10);d=tick(f,10.02,True)\n            self.assertFalse(f.control.pressed)\n            tick(f,10.19);self.assertTrue(f.control.pressed)\n        def test_target_release_does_not_erase_history(self):\n            f=scene();c=f.control.cadence;tick(f,10);tick(f,10.105,True)\n            c.requested(10.11);self.assertEqual(c.records[c.current][\'sequence_shots\'],1)\n        def test_hot_weapon_after_switch_and_reload_not_new_shots(self):\n            f=scene();c=WeaponCadence();c.observe(f.frame,10);c.requested(10)\n            f.frame.ammo-=1;f.frame.stamp=10.1;c.observe(f.frame,10.1);key=c.current\n            f.frame.weapon_state[\'handle\']+=1;f.frame.stamp=10.12;c.observe(f.frame,10.12)\n            f.frame.weapon_state[\'handle\']-=1;f.frame.ammo=30;f.frame.stamp=10.14;c.observe(f.frame,10.14)\n            self.assertEqual(c.current,key);self.assertEqual(c.records[key][\'sequence_shots\'],1)\n        def test_unverified_identity_no_continuous_upgrade(self):\n            f=scene();f.frame.weapon_state={};d=step(f)\n            self.assertEqual(d[\'fire_cadence\'][\'rate_model\'],\'legacy_fallback\')\n    stream=io.StringIO();r=unittest.TextTestRunner(stream=stream,verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(Tests))\n    if not r.wasSuccessful():raise AssertionError(stream.getvalue())\n    return dict(passed=True,tests=r.testsRun,game_attached=False,input_sent=False,\n                engine_spread_verified=False,runtime_gpu_required=False)\n')

_EMBEDDED['sustained_cadence'] = (1, '"""Earliest model-feasible follow-up; no model-name/HP unlock, no GPU dependency.\n\nScript envelopes are estimates. This module does not certify engine spread,\nhit probability, armor damage, or a kill. Controller\'s live gates still win.\n"""\nimport math\n\n\ndef number(p,key,default=None,maximum=1e6):\n    v=p.get(key,default)\n    return float(v) if type(v) in (int,float) and math.isfinite(v) and 0<=v<=maximum else default\n\n\ndef earliest_gap(cycle,recovery,increment,budget):\n    """Steady exponentially recovered shot increment, bounded by native cycle.\n\nRecoveryTime represents a decade in this explicitly labelled local model.\nThis is a policy model, not proof of the particular binary\'s recovery curve.\n"""\n    if increment<=0:return cycle\n    if budget<=0:return max(cycle,recovery)\n    return max(cycle,min(max(cycle,recovery),recovery*math.log10(1.+increment/budget)))\n\n\ndef sustained_policy(profile,base,*,alignment_error,shots_in_press=0,sequence_shots=0):\n    """Replace fixed per-family pauses only for fresh direct aligned targets."""\n    p=profile or {};out=dict(base);out[\'rate_model\']=\'legacy_fallback\'\n    if (not base.get(\'direct\') or not base.get(\'eligible_geometry\') or\n            base.get(\'stance\')==\'air\' or base.get(\'target_health\') is None):return out\n    cycle=base[\'cycle\'];recovery=max(cycle,base[\'recovery\'])\n    angle=base.get(\'target_angular_radius\')\n    if (angle is None or type(alignment_error) not in (int,float) or\n            not math.isfinite(alignment_error) or alignment_error<0):return out\n    error=math.radians(alignment_error)\n    budget=angle*.90-error\n    if budget<=0:return out\n    kind=base[\'weapon_type\'];automatic=base[\'automatic\']\n    moving=base[\'moving\'];crouched=base[\'stance\']==\'crouch\'\n    current=base.get(\'spread_hint\');model=base.get(\'model\')\n    if current is None or current>budget:return out\n    # A brief button release/target switch does not restore first-shot accuracy.\n    # The caller retains ammo-confirmed history until a full recovery window.\n    previous=max(0,min(128,int(sequence_shots))-max(0,int(shots_in_press)))\n    limit=1;unbounded=False;gap=base[\'interval\'];basis=\'\'\n    if model in (\'rifle\',\'machinegun\',\'submachinegun\') and \'InaccuracyStand\' not in p:\n        key=\'RunSpread\' if moving else \'DuckingSpread\' if crouched else \'DefaultSpread\'\n        scale=number(p,key);offset=number(p,key+\'Offset\',0.)\n        divisor=number(p,\'AccuracyDivisor\');ceiling=number(p,\'MaxInaccuracy\');accuracy_offset=number(p,\'AccuracyOffset\');base_accuracy=number(p,\'BaseAccuracy\')\n        if None in (scale,divisor,ceiling,accuracy_offset,base_accuracy) or divisor<=0 or scale<=0:return out\n        full=scale*max(ceiling,base_accuracy)+offset\n        first=scale*base_accuracy+offset\n        if full<=budget:\n            unbounded=True;gap=cycle;limit=None\n        else:\n            # Count only ammo-confirmed rounds; a target switch does not erase\n            # the weapon\'s shot history. Saturation permits continuous native fire.\n            limit=0\n            for n in range(1,65):\n                shot=previous+n\n                accuracy=base_accuracy if shot==1 else min(ceiling,shot**3/divisor+accuracy_offset)\n                if scale*accuracy+offset>budget:break\n                limit=n\n            limit=max(1,limit)\n            allowable=max(0.,budget-first)\n            increment=max(0.,scale*max(0.,min(ceiling,8./divisor+accuracy_offset)-base_accuracy))\n            gap=earliest_gap(cycle,recovery,increment,allowable)\n        basis=\'legacy_script_curve_geometry_not_live\'\n    elif \'InaccuracyStand\' in p:\n        increment=number(p,\'InaccuracyFire\')\n        if increment is None:return out\n        gap=earliest_gap(cycle,recovery,increment,max(0.,budget-current))\n        ratio=10.**(-cycle/recovery)\n        steady=current+increment*ratio/max(1e-12,1.-ratio)\n        if steady<=budget:unbounded=True;limit=None;gap=cycle\n        else:\n            residual=increment*ratio*(1.-ratio**previous)/max(1e-12,1.-ratio)\n            limit=0\n            for n in range(1,65):\n                if current+residual>budget:break\n                limit=n;residual=(residual+increment)*ratio\n            limit=max(1,limit)\n        basis=\'script_exponential_envelope_not_live\'\n    elif model in (\'pistol\',\'shotgun\',\'sniperrifle\'):\n        key=\'RunSpread\' if moving else \'DuckingSpread\' if crouched else \'DefaultSpread\'\n        scale=number(p,key);offset=number(p,key+\'Offset\',0.)\n        if scale is None:return out\n        # No rifle cubic curve is borrowed for other families. A conservative\n        # script envelope handles these legacy variants; absent bounds retain\n        # the previous policy, never a invented universal fire interval.\n        if model==\'pistol\':\n            lo=p.get(\'PistolAccuracyMin\');hi=p.get(\'PistolAccuracyMax\');initial=p.get(\'BaseAccuracy\')\n            if not all(type(v) in (int,float) and math.isfinite(v) and -2<=v<=2 for v in (lo,hi,initial)) or lo>hi:return out\n            multiplier=max(*(abs(v) for v in (lo,hi,initial)),*(abs(1.-v) for v in (lo,hi,initial)))\n        else:\n            multiplier=max(1.,number(p,\'BaseAccuracy\',1.),number(p,\'MaxInaccuracy\',1.))\n        full=scale*multiplier+offset\n        if full>budget:return out\n        gap=cycle;unbounded=True;limit=None\n        basis=\'legacy_\'+model+\'_bounded_envelope_not_live\'\n    else:return out\n    # No name or health threshold is required. A live final ray gate precedes\n    # this decision, including ammo, foreground, pose, cover, and protected actors.\n    out.update(interval=gap,burst_limit=limit if automatic else 1,\n        controlled=not (automatic and unbounded),continuous=bool(automatic and unbounded),\n        policy=\'native_sustained\' if automatic and unbounded else \'earliest_model_followup\',\n        rate_model=basis,projected_budget_rad=budget,estimate_within_target=current<=budget,\n        fixed_hp_unlock=False,fixed_range_pause=False,engine_spread_verified=False,\n        sequence_shots=sequence_shots,sequence_before_press=previous)\n    return out\n')

_EMBEDDED['click_cadence'] = (1, '"""One coherent DOWN/UP schedule for every firearm; no timer thread or GPU.\n\nNative key-state consumption is an input acknowledgement, not proof of a shot.\nAmmo observations may arrive after a command. They confirm the shot and release\nthe current pulse. Every firearm uses its own native cycle as the earliest\nretry bound; estimated spread recovery is diagnostic, not an input deadline.\n"""\nimport math\n\ndef click_schedule(policy,record,now,pressed,last_request,last_release=-math.inf,native_state=None):\n    cycle=policy[\'cycle\']\n    configured_interval=max(cycle,policy[\'interval\'])\n    interval=cycle\n    estimated_recovery_bypassed=configured_interval>cycle+1e-9\n    requested=record.get(\'last_request\')\n    request=max(last_request,requested if requested is not None else -math.inf)\n    native_valid=type(native_state) is int and 0<=native_state<=7\n    down_ack=native_valid and not (native_state&2)\n    up_latched=native_valid and bool(native_state&4) and not pressed\n    down_limit=min(.050,max(.025,cycle*.45))\n    press_at=record.get(\'press_at\')\n    press_at=request if press_at is None else press_at\n    press_age=max(0.,now-press_at)\n    ammo_ack=record.get(\'shots_in_press\',0)>0\n    # Consuming an input impulse can precede native weapon readiness by a tick.\n    # Do not mistake that acknowledgement for a bullet: allow the bounded\n    # pulse to reach that tick, or release early on actual clip confirmation.\n    release=bool(pressed and (ammo_ack or press_age>=down_limit))\n    release_gap=.004\n    recovery_reference=request\n    due=max(recovery_reference+interval,last_release+release_gap)\n    wait=max(0.,due-now)\n    # EngineAttack writes 4 for UP. The engine may retain that released state\n    # indefinitely, so the elapsed release gap, not clearing bit 4, owns the\n    # next DOWN edge.\n    ready=bool(not pressed and wait<=1e-9)\n    return dict(output_mode=\'paced_click\',ready=ready,release=release,\n        rate_policy=policy.get(\'policy\'),model_burst_limit=policy.get(\'burst_limit\'),\n        continuous_budget=bool(policy.get(\'continuous\')),continuous=False,burst_limit=1,\n        policy=\'paced_click_native\',\n        removed_fixed_recovery_guess=estimated_recovery_bypassed,\n        removed_unverified_auto_recovery=bool(estimated_recovery_bypassed and policy.get(\'automatic\')),\n        removed_unverified_direct_recovery=bool(estimated_recovery_bypassed and policy.get(\'direct\')),\n        removed_estimated_recovery=estimated_recovery_bypassed,\n        estimated_policy_interval=policy.get(\'interval\'),\n        interval_basis=\'native_weapon_cycle\',\n        # Both interval fields describe the real scheduler. Keep the script\n        # policy separately so a diagnostic never hides a bypassed deadline.\n        interval=interval,effective_interval=interval,configured_interval=configured_interval,\n        next_press_at=due,wait_ms=wait*1000,\n        press_timeout_ms=down_limit*1000,release_gap_ms=release_gap*1000,\n        native_state=native_state if native_valid else None,\n        native_press_consumed=down_ack,native_release_latched=up_latched,\n        release_reason=\'clip_confirmed\' if release and ammo_ack else \'bounded_press_timeout\' if release else \'\',\n        wait_reason=\'click_press_pending\' if pressed and not release else\n            \'click_release_edge\' if release else\n            \'weapon_cycle\' if wait>0 else \'\',\n        recovery_reference_at=recovery_reference if math.isfinite(recovery_reference) else None,\n        observation_recovery_hold=False,\n        timing_basis=\'accepted_press_deadline_not_delayed_ammo_observation\')\n')

_EMBEDDED['combat38_contract'] = (1, '"""Controller pulse edges and refresh-before-priority regressions, no game input."""\nimport copy,io,math,struct,unittest\nfrom dataclasses import replace\nfrom types import SimpleNamespace as NS\nfrom unittest.mock import patch\nfrom combat37_contract import scene,tick,XT97\nfrom combat36_contract import USP\nfrom click_cadence import click_schedule\nfrom aim_selection_contract import ReaderFixture,MemoryFixture,step\nfrom target_priority import choose_visible,NEAR_FIRST,COMPREHENSIVE\nfrom wall_service import WallService\nfrom static_prop_guard import StaticPropGuard\n\ndef base(**kw):\n    p=dict(cycle=.1,interval=.1,controlled=False,continuous=True,burst_limit=None,policy=\'native_sustained\')\n    p.update(kw);return p\n\ndef multi_scene(automatic=True):\n    f=scene(p=dict(XT97,FullAuto=automatic),generic=False,distance=500.)\n    hidden=f.reader.entity;visible=copy.deepcopy(hidden)\n    visible.index=3;visible.address=0x30000;visible.serial=3\n    visible.head=(300.,70.,64.);visible.origin=(300.,70.,0.)\n    for p in visible.aim_points:p.position=(300.,70.,p.position[2]);p.visibility=\'unknown\';p.penetration={}\n    f.frame.entities=[hidden,visible]\n    class Memory(MemoryFixture):\n        def read(self,address,size):\n            for e in (hidden,visible):\n                if address==0x50000+e.index*16 and size==8:return struct.pack(\'<II\',e.address,e.serial)\n            return super().read(address,size)\n    class Reader(ReaderFixture):\n        def read_entity(self,index,address,with_inventory=False):return copy.deepcopy(hidden if index==2 else visible)\n    f.reader=Reader(hidden);f.reader.mem=Memory(f.reader)\n    f.frame.matrix=(0.,1.,0.,0.,0.,0.,1.,-64.,0.,0.,0.,0.,1.,0.,0.,0.)\n    f.wall=WallService.__new__(WallService);f.wall.fast_cursor=0\n    f.wall.map_args=(\'\',f.frame.map_name,None)\n    from geometry import WallHit\n    def trace(a,b,**kw):\n        if b[0]>490.:\n            d=math.dist(a,b);return [WallHit(128/d,133/d,5,\'T\',1)]\n        return []\n    f.wall.fast_bsp=NS(trace=trace,surface_materials={\'T\':87},\n                       static_fire_guard=StaticPropGuard([],{}),\n                       native_complete=True,incomplete=False)\n    # Keep the deterministic fixture\'s ten-second control clock while\n    # presenting a fresh wall sample to the production selector.\n    _refresh=f.wall.refresh_target\n    def refresh(frame,entity,weapon,*args,**kwargs):\n        result=_refresh(frame,entity,weapon,*args,**kwargs)\n        entity.wall_age_ms=0.;entity.wall_eye_shift=0.;entity.wall_head_shift=0.\n        for point in entity.aim_points:\n            point.wall_age_ms=0.;point.wall_eye_shift=0.;point.wall_head_shift=0.\n        return result\n    f.wall.refresh_target=refresh\n    f.wall.refresh_target(f.frame,hidden,f.weapon)\n    # This rival is an explicitly native-complete direct sample. Empty or\n    # incomplete BSP evidence is pending in production, never clear.\n    clear_path=dict(kind=\'clear\',allowed=True,collision_complete=True,\n                    obstacle_assessment_complete=True,requires_native_trace=False,\n                    penetration_verdict=\'penetrable\',penetrability=\'penetrable\')\n    for point in visible.aim_points:\n        point.visibility=\'visible\';point.penetration=dict(clear_path);point.penetrable=False\n    visible.visibility=\'visible\';visible.penetration=dict(clear_path);visible.wall_age_ms=0.\n    f.control.sync_weapon(f.frame,10.);f.control.cadence.observe(f.frame,10.)\n    f.control.target=2;f.control.button(True,\'fixture old wallbang\');f.control.cadence.requested(10.)\n    f.control.engagement=dict(key=(f.frame.map_name,f.frame.local.address,f.frame.local.serial,\n        hidden.index,hidden.address,hidden.serial,f.frame.weapon),first_fire=9.9,written_view=f.frame.angles)\n    f.visible=visible;return f\n\ndef run():\n    class Tests(unittest.TestCase):\n        def test_ammo_arrival_is_not_second_cycle(self):\n            p=base();r=dict(last_request=10.,press_at=10.,shots_in_press=1,last_shot=10.08)\n            q=click_schedule(p,r,10.101,False,10.,10.02,0)\n            self.assertTrue(q[\'ready\']);self.assertAlmostEqual(q[\'next_press_at\'],10.1)\n        def test_native_consumption_is_not_a_confirmed_shot(self):\n            for w in (XT97,USP):\n                q=click_schedule(base(cycle=w[\'CycleTime\']),dict(press_at=10.,last_request=10.),10.005,True,10.,native_state=1)\n                self.assertFalse(q[\'release\']);self.assertTrue(q[\'native_press_consumed\'])\n                q=click_schedule(base(cycle=w[\'CycleTime\']),dict(press_at=10.,last_request=10.,shots_in_press=1),10.005,True,10.,native_state=1)\n                self.assertTrue(q[\'release\']);self.assertEqual(q[\'release_reason\'],\'clip_confirmed\')\n        def test_unconsumed_native_down_not_released_early(self):\n            q=click_schedule(base(),dict(press_at=10.),10.003,True,10.,native_state=3)\n            self.assertFalse(q[\'release\'])\n        def test_missing_feedback_click_timeout_then_retry(self):\n            r=dict(last_request=10.,press_at=10.)\n            q=click_schedule(base(),r,10.051,True,10.,native_state=3);self.assertTrue(q[\'release\'])\n            q=click_schedule(base(),r,10.101,False,10.,10.051,0);self.assertTrue(q[\'ready\'])\n        def test_up_has_separate_edge_and_native_ack(self):\n            r=dict(last_request=10.,press_at=10.)\n            self.assertFalse(click_schedule(base(),r,10.101,False,10.,10.100,0)[\'ready\'])\n            self.assertFalse(click_schedule(base(),r,10.103,False,10.,10.1,4)[\'ready\'])\n            held_up=click_schedule(base(),r,10.110,False,10.,10.1,4)\n            self.assertTrue(held_up[\'ready\'])\n            self.assertTrue(held_up[\'native_release_latched\'])\n            self.assertTrue(click_schedule(base(),r,10.110,False,10.,10.1,0)[\'ready\'])\n        def test_latched_up_does_not_stall_first_or_followup_press(self):\n            r={}\n            self.assertTrue(click_schedule(base(),r,10.,False,-100.,-100.,4)[\'ready\'])\n            r=dict(last_request=10.,press_at=10.)\n            self.assertTrue(click_schedule(base(),r,10.101,False,10.,10.05,4)[\'ready\'])\n        def test_controller_repeats_with_native_up_latched(self):\n            class LatchedTrigger:\n                def __init__(self):self.events=[];self.active=False\n                def prepare_frame(self,frame):pass\n                def bind(self,reader):pass\n                def secondary(self,suppress):pass\n                def state(self):return 3 if self.active else 4\n                def set(self,down):\n                    self.active=down;self.events.append(down);return True\n                def maintain(self):return True\n            f=scene();f.control.trigger=LatchedTrigger()\n            tick(f,10.);self.assertEqual(f.control.trigger.events,[True])\n            tick(f,10.06);self.assertEqual(f.control.trigger.events,[True,False])\n            tick(f,10.106);self.assertEqual(f.control.trigger.events,[True,False,True])\n            self.assertTrue(f.control.pressed)\n        def test_estimated_precision_pause_does_not_delay_next_press(self):\n            q=click_schedule(base(controlled=True,interval=.25),{},10.11,False,10.)\n            self.assertTrue(q[\'ready\']);self.assertEqual(q[\'policy\'],\'paced_click_native\')\n            self.assertEqual(q[\'estimated_policy_interval\'],.25)\n        def test_guessed_legacy_delay_not_throttle_direct(self):\n            p=base(controlled=True,interval=.21,rate_model=\'legacy_fallback\',direct=True,stance=\'stand\',recovery_source=\'legacy_burst_pause_estimate\')\n            self.assertEqual(click_schedule(p,{},10.11,False,10.)[\'interval\'],.1)\n            for kw in (dict(direct=False),dict(stance=\'air\'),dict(recovery_source=\'script_recovery_parameter\')):\n                self.assertEqual(click_schedule(dict(p,**kw),{},10.11,False,10.)[\'interval\'],.1)\n        def test_all_automatic_modes_output_edges(self):\n            for w in (XT97,dict(XT97,FullAuto=0),USP):\n                f=scene(p=w);tick(f,10);self.assertTrue(f.control.pressed)\n                tick(f,10.02,True);self.assertFalse(f.control.pressed)\n                q=f.control.diagnostic[\'fire_cadence\'];self.assertEqual(q[\'output_mode\'],\'paced_click\')\n                tick(f,10+w[\'CycleTime\']+.001);self.assertTrue(f.control.pressed)\n                self.assertEqual(f.inputs.events,[True,False,True])\n        def test_wallbang_cannot_hold_off_new_visible_rival(self):\n            for automatic in (False,True):\n                for strategy in (\'准星最近\',NEAR_FIRST,COMPREHENSIVE):\n                    f=multi_scene(automatic);f.cfg.strategy=strategy;d=step(f)\n                    self.assertTrue(d[\'candidate_refresh\'][\'while_pressed\'])\n                    self.assertIn(3,d[\'candidate_refresh\'][\'targets\'])\n                    self.assertEqual(f.control.target,3,(automatic,strategy,d))\n                    self.assertEqual(d[\'selected_path_tier\'],0)\n        def test_visible_class_survives_all_secondary_scores(self):\n            for strategy in (\'准星最近\',NEAR_FIRST,COMPREHENSIVE):\n                from target_priority import threat_info\n                f=multi_scene();f.wall.refresh_target(f.frame,f.visible,f.weapon)\n                rows=[]\n                for e in f.frame.entities:\n                    info=threat_info(f.frame,e);rows.append((0.,e,(0.,(0.,0.,0.),0. if e.index==2 else 40.),info))\n                self.assertEqual(choose_visible(rows,2,strategy,True)[1].index,3)\n        def test_engagement_does_not_override_direct_upgrade(self):\n            f=multi_scene(False);step(f)\n            self.assertNotEqual(f.control.diagnostic.get(\'selection_reason\'),\'semi_auto_keep_live_identity\')\n            self.assertEqual(f.control.target,3)\n        def test_fresh_downgrade_cannot_fire_over_clear_candidate(self):\n            f=multi_scene();hidden=f.frame.entities[0]\n            # Keep the stale clear actor nearer, so the new near-first policy\n            # actually reaches the fresh downgrade guard being tested.\n            v=f.visible;v.head=(600.,70.,64.);v.origin=(600.,70.,0.)\n            v.aim_points=[replace(p,position=(600.,70.,p.position[2])) for p in v.aim_points]\n            trace=f.wall.fast_bsp.trace\n            f.wall.fast_bsp.trace=lambda a,b,**kw:trace(a,b,**kw) if abs(b[1])<1. else []\n            original=f.wall.refresh_target\n            def refresh(frame,e,weapon,*args,**kw):\n                n=original(frame,e,weapon,*args,**kw)\n                if not kw.get(\'confirm\'):\n                    for p in e.aim_points:\n                        p.visibility=\'visible\';p.penetration=dict(kind=\'clear\',allowed=True)\n                    e.visibility=\'visible\';e.penetration=dict(kind=\'clear\',allowed=True)\n                return n\n            f.wall.refresh_target=refresh\n            d=step(f)\n            self.assertFalse(f.control.pressed)\n            self.assertEqual(d[\'selection_reason\'],\'fresh_path_downgrade_visible_barrier\')\n        def test_engine_maintain_does_not_reassert_held_down(self):\n            from engine_attack import EngineAttack\n            calls=[];e=EngineAttack(NS(foreground=lambda p:True));e.active=True\n            e.reader=NS(mem=NS(pid=1,write=lambda *x:calls.append(x)),require_feature=lambda *a:None)\n            e.verify_fire_weapon=lambda:True\n            self.assertTrue(e.maintain());self.assertFalse(calls)\n    stream=io.StringIO();r=unittest.TextTestRunner(stream=stream,verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(Tests))\n    if not r.wasSuccessful():raise AssertionError(stream.getvalue())\n    return dict(passed=True,tests=r.testsRun,game_attached=False,input_sent=False,\n                runtime_gpu_required=False,actual_bullet_accuracy_verified=False)\n')

