_EMBEDDED['penetration_validation_log'] = (1, '"""Two passive feedback triggers using existing log-worker snapshots only.\n\nCoordinates come from the last sample before observed ammunition consumption,\nnot an exact engine firing tick. Geometry reconstruction is offline.\n"""\nimport math\n\nLOG_NAME = \'真实环境穿透验证.jsonl\'\nWINDOW_SECONDS = .5\nMAX_PENDING = 64\n\n\ndef _point(value):\n    if not isinstance(value, (tuple, list)) or len(value) != 3:\n        return None\n    try:\n        point = tuple(float(v) for v in value)\n    except (ValueError, TypeError, OverflowError):\n        return None\n    return point if all(math.isfinite(v) for v in point) else None\n\n\ndef _health(value):\n    return value if type(value) is int and value >= 0 else None\n\n\ndef _identity(actor):\n    return tuple(getattr(actor, key, None) for key in (\'index\', \'address\', \'serial\'))\n\n\ndef _scope(frame):\n    return (frame.map_name, *_identity(frame.local))\n\n\ndef shot_mode(context):\n    """Read only existing ESP state and the existing T-force flag."""\n    path = context.get(\'penetration\') or {}\n    if not isinstance(path, dict) or context.get(\'fire_allowed\') is not True:\n        return None\n    state = path.get(\'esp_verdict\') or context.get(\'visibility\') or path.get(\'kind\')\n    if context.get(\'tab_force_fire_active\') and state == \'blocked\':\n        return \'t_forced\'\n    if state in (\'penetrable\', \'penetration\') and path.get(\'allowed\') is True:\n        return \'predicted_penetrable\'\n    return None\n\n\nclass RealPenetrationLog:\n    def __init__(self, emit, clock):\n        self.emit, self.clock = emit, clock\n        self.shots = {}\n        self.scope = None\n        self.emitted = self.dropped = 0\n\n    def _record(self, shot, trigger, health_after, evidence):\n        row = dict(shot[\'row\'], trigger=trigger,\n                   health_before=shot[\'health\'], health_after=health_after,\n                   evidence=evidence)\n        try:\n            if self.emit(LOG_NAME, row) is False:\n                self.dropped += 1\n            else:\n                self.emitted += 1\n        except Exception:\n            self.dropped += 1\n\n    def observe_shot(self, *, shot_id, observed_at, rounds, frame, target,\n                     context, observation_id=None, wall_time=None):\n        mode = shot_mode(context)\n        if mode is None or rounds <= 0 or target is None:\n            return False\n        local_position = _point(getattr(frame.local, \'origin\', None))\n        enemy_position = _point(getattr(target, \'origin\', None))\n        identity = _identity(target)\n        if (local_position is None or enemy_position is None or not frame.map_name\n                or any(v is None for v in identity)):\n            return False\n        if context.get(\'target_serial\') not in (None, identity[2]):\n            return False\n        scope = _scope(frame)\n        if self.scope != scope:\n            self.close()\n            self.scope = scope\n        self.shots[shot_id] = dict(\n            mode=mode, identity=identity, health=_health(getattr(target, \'health\', None)),\n            observed_at=observed_at, sample_at=None, latest_health=None,\n            row=dict(time=wall_time, observation_id=observation_id, map=frame.map_name,\n                     local_position=local_position, enemy_position=enemy_position,\n                     weapon=getattr(frame, \'weapon\', None), rounds=rounds,\n                     sample_time=frame.stamp, shot_observed_at=observed_at))\n        if len(self.shots) > MAX_PENDING:\n            self.shots.pop(next(iter(self.shots)))\n            self.dropped += 1\n        return True\n\n    def refresh(self, frame):\n        """Watch pending targets\' HP in the already received frame; no game IO."""\n        scope = _scope(frame)\n        if scope != self.scope:\n            self.close()\n            self.scope = scope\n        if not self.shots:\n            return\n        actors = {e.index: e for e in frame.entities}\n        damaged = {}\n        for key, shot in list(self.shots.items()):\n            actor = actors.get(shot[\'identity\'][0])\n            if actor is None or _identity(actor) != shot[\'identity\']:\n                self.shots.pop(key, None)\n                continue\n            health = _health(getattr(actor, \'health\', None))\n            if health is None or shot[\'health\'] is None or health > shot[\'health\']:\n                self.shots.pop(key, None)\n                continue\n            if frame.stamp < shot[\'observed_at\']:\n                continue\n            shot[\'sample_at\'], shot[\'latest_health\'] = frame.stamp, health\n            if health < shot[\'health\']:\n                self.shots.pop(key, None)\n                if shot[\'mode\'] == \'t_forced\' and frame.stamp-shot[\'observed_at\'] <= WINDOW_SECONDS+.2:\n                    # A single HP decrement cannot establish multiple shots.\n                    damaged[shot[\'identity\']] = (shot, health)\n        for shot, health in damaged.values():\n            self._record(shot, \'T强制遮挡射击后掉血\', health, \'target_health_decreased\')\n\n    def damage(self, *, shot_id, record, now=None):\n        """Already-associated local damage never creates a third trigger."""\n        shot = self.shots.get(shot_id)\n        now = self.clock() if now is None else now\n        if shot is None or not 0 <= now-shot[\'observed_at\'] <= WINDOW_SECONDS:\n            return False\n        if (record.get(\'attacker_index\') != self.scope[1]\n                or record.get(\'victim_index\') != shot[\'identity\'][0]\n                or not isinstance(record.get(\'damage\'), (int, float))\n                or record[\'damage\'] <= 0):\n            return False\n        self.shots.pop(shot_id, None)\n        if shot[\'mode\'] == \'t_forced\':\n            self._record(shot, \'T强制遮挡射击后掉血\', _health(record.get(\'health\')),\n                         \'local_player_hurt_event\')\n        return True\n\n    def expire(self, now=None):\n        now = self.clock() if now is None else now\n        for key, shot in list(self.shots.items()):\n            deadline = shot[\'observed_at\']+WINDOW_SECONDS\n            if now < deadline:\n                continue\n            sample = shot[\'sample_at\']\n            # Allow the sampled frame to catch up with the packet\'s clock.\n            if (sample is None or sample < deadline) and now <= deadline+.2:\n                continue\n            self.shots.pop(key, None)\n            if (shot[\'mode\'] == \'predicted_penetrable\' and shot[\'health\'] is not None\n                    and shot[\'health\'] > 0 and shot[\'latest_health\'] == shot[\'health\']\n                    and sample is not None and sample >= deadline\n                    and 0 <= now-sample <= .2):\n                self._record(shot, \'标记可穿透射击后未掉血\', shot[\'latest_health\'],\n                             \'health_unchanged_for_0.5s\')\n\n    def close(self):\n        self.shots.clear()\n        self.scope = None\n')
_EMBEDDED['battle_log'] = (1, '\n"""Bounded asynchronous JSONL logging and automatic per-match summaries."""\nimport collections,datetime,json,os,queue,re,threading,time,math,statistics\nfrom pathlib import Path\nimport uuid\nfrom penetration_validation_log import RealPenetrationLog, LOG_NAME\nfrom compact_log import JournalPolicy,DecisionTotals,DETAIL_BYTES,SCHEMA,summary_bytes,encode,increment\nfrom runtime_diagnostics import observed_ammo_drop,weapon_identity,accuracy_profile\n\nIDENT=r\'"(?P<{p}_name>[^"\\r\\n]*?)<(?P<{p}_id>\\d+)><[^>]*><(?P<{p}_team>[^>]*)>"\'\nDAMAGE=re.compile(IDENT.format(p=\'attacker\')+r\' attacked \'+IDENT.format(p=\'victim\')+r\' with "(?P<weapon>[^"]+)"(?P<detail>.*)\')\nKILL=re.compile(IDENT.format(p=\'attacker\')+r\' killed \'+IDENT.format(p=\'victim\')+r\' with "(?P<weapon>[^"]+)"(?P<detail>.*)\')\n\ndef resolve_local_names(game,entry):\n    """Read only identity fields from configs belonging to this game install."""\n    game=Path(game).resolve();entry=Path(entry)\n    names=set()\n    for path in (game/\'LocalCSO2/local_config.json\',entry.parent/\'CSO2本地玩/local_config.json\'):\n        try:\n            config=json.loads(path.read_text(encoding=\'utf-8-sig\'))\n            if config.get(\'game_root\') and Path(config[\'game_root\']).resolve()!=game:continue\n            account=config.get(\'account\',{})\n            names.update(str(account[key]).strip() for key in (\'nickname\',\'username\',\'name\') if account.get(key))\n        except (OSError,ValueError,TypeError):pass\n    try:\n        with (game/\'Bin/cso2_report_log.txt\').open(\'rb\') as fp:\n            fp.seek(0,2);size=fp.tell();fp.seek(max(0,size-131072));tail=fp.read()\n        matches=re.findall(rb\'my nickname - ([^\\r\\n]+)\',tail)\n        if matches:\n            raw=matches[-1]\n            try:name=raw.decode(\'utf-8\')\n            except UnicodeError:name=raw.decode(\'gb18030\',errors=\'replace\')\n            if name.strip():names.add(name.strip())\n    except OSError:pass\n    return names\n\ndef parse_damage(line):\n    for kind,pattern in [(\'damage\',DAMAGE),(\'kill\',KILL)]:\n        m=pattern.search(line)\n        if m:\n            result=m.groupdict();detail=result.pop(\'detail\');result[\'kind\']=kind\n            result.update(dict(re.findall(r\'\\((\\w+) "([^"\\r\\n]*)"\\)\',detail)))\n            result[\'head\']=received_hitgroup(result)==\'head\' if kind==\'damage\' else \'(headshot)\' in detail\n            return result\n    return None\n\ndef received_hitgroup(evidence):\n    """Preserve unknown hitgroups instead of counting them as body hits."""\n    raw=str(evidence.get(\'hitgroup\',\'\')).strip().casefold().replace(\'_\',\' \')\n    numeric={\'0\':\'generic\',\'1\':\'head\',\'2\':\'chest\',\'3\':\'stomach\',\n             \'4\':\'left arm\',\'5\':\'right arm\',\'6\':\'left leg\',\'7\':\'right leg\',\'10\':\'gear\'}\n    raw=numeric.get(raw,raw)\n    return raw if raw in {*numeric.values(),\'generic\',\'body\'} else \'unknown\'\n\n\nclass BattleLog:\n    def __init__(self,folder,local_names,clock=time.monotonic,rotate_bytes=DETAIL_BYTES):\n        self.folder=Path(folder);self.folder.mkdir(parents=True,exist_ok=True)\n        self.local_names={str(n).casefold() for n in local_names if n}\n        self.queue=queue.Queue(4096);self.dropped=0;self.error=\'\';self.current=None\n        self.serialization_failures=0;self.written_records=0;self.last_write=None\n        self.accuracy_error=\'\';self.accuracy_records=0;self.accuracy_failures=0;self.accuracy_last_error=\'\'\n        self.event_sequence=0\n        self._closed=False;self.logger_id=uuid.uuid4().hex\n        self.thread=threading.Thread(target=self._writer,daemon=True)\n        self.last_sample=0;self.last_summary=0;self.last_frame=None;self.last_target=0;self.last_press=False\n        self.costs=collections.deque(maxlen=3600);self.sink_available=False;self.sink_error=\'尚未连接伤害日志\'\n        self.unready_since=0\n        self.clock=clock;self.rotate_bytes=max(4096,min(int(rotate_bytes),DETAIL_BYTES));self.render_metrics={};self.memory_health={}\n        self.last_aim_sample=0.;self.last_aim_context={};self.weapon_profiles={}\n        self.accepted_fire_requests=collections.deque(maxlen=32)\n        self.last_decision_log=0.;self.last_decision_signature=None\n        self.last_health=None\n        self.sink_dropped=0;self.last_defense_sample=-float(\'inf\')\n        self.native_hurt_authoritative=False;self.sink_diagnostics={}\n        self.last_health_gap_event=-float(\'inf\')\n        self.first_damage={};self.kill_times=collections.deque(maxlen=5000);self.ttk=collections.deque(maxlen=5000)\n        self.real_penetration=RealPenetrationLog(self._put,self.clock)\n        self.thread.start()\n    def _writer(self):\n        handles={}; policies={}\n        accuracy=None;accuracy_retry=0.\n        def atomic(path,raw):\n            temp=path.with_suffix(path.suffix+\'.tmp\')\n            temp.write_bytes(raw);os.replace(temp,path)\n        try:\n            while True:\n                item=self.queue.get()\n                try:\n                    if item is None:break\n                    name,record=item\n                    if record is None:\n                        handle=handles.pop(name,None)\n                        if handle:handle.close()\n                        policies.pop(name,None);continue\n                    path=self.folder/name; policy=None; recent=None\n                    # Archive original evidence before per-match sampling and\n                    # byte budgets. Only this writer thread touches the DB.\n                    if name != LOG_NAME and (name.endswith(\'.jsonl\') or name.endswith(\'.summary.json\')):\n                        try:\n                            if accuracy is None and self.clock()>=accuracy_retry:\n                                from weapon_accuracy import AccuracyLedger\n                                accuracy=AccuracyLedger(self.folder/\'weapon_accuracy\')\n                            if accuracy is not None:\n                                if name.endswith(\'.summary.json\'):\n                                    record[\'weapon_accuracy_archive\']=self.accuracy_health()\n                                    accuracy.quality(record[\'id\'],record)\n                                else:accuracy.record(name[:-6],record)\n                                self.accuracy_records+=1;self.accuracy_error=\'\'\n                            elif record.get(\'kind\') in (\'ammo_decreased\',\'confirmed_damage\',\'weapon_profile\',\'match_start\',\'match_end\'):\n                                self.accuracy_failures+=1\n                        except Exception as ex:\n                            self.accuracy_error=type(ex).__name__+\': \'+str(ex)\n                            self.accuracy_failures+=1;self.accuracy_last_error=self.accuracy_error\n                            accuracy_retry=self.clock()+5.\n                    try:\n                        if name == LOG_NAME:\n                            # Independent long-term evidence: no sampling, truncation or match budget.\n                            encoded=(json.dumps(record,ensure_ascii=False,allow_nan=False,separators=(\',\',\':\'))+\'\\n\').encode(\'utf-8\')\n                        elif name.endswith(\'.json\'):\n                            policy=policies.get(str(record.get(\'id\',\'\'))+\'.jsonl\')\n                            if policy is not None and record.get(\'log_schema\')==SCHEMA:\n                                encoded=summary_bytes(record,policy)\n                                if name.endswith(\'.summary.json\'):recent=policy.recent_bytes()\n                            else:encoded=(json.dumps(record,ensure_ascii=False,separators=(\',\',\':\'))+\'\\n\').encode(\'utf-8\')\n                        else:\n                            if name not in policies:\n                                policies[name]=JournalPolicy(self.rotate_bytes,path.stat().st_size if path.exists() else 0)\n                            policy=policies[name];encoded=policy.prepare(record)\n                            if encoded is None:\n                                marker=policy.marker()\n                                if marker is None:continue\n                                encoded=marker;record={\'kind\':\'logging_budget\'}\n                    except Exception as ex:\n                        self.serialization_failures+=1;self.dropped+=1\n                        self.error=\'serialize \'+type(ex).__name__+\': \'+str(ex);continue\n                    for attempt in range(3):\n                        try:\n                            if name.endswith(\'.json\'):\n                                atomic(path,encoded)\n                                if recent is not None:atomic(self.folder/(record[\'id\']+\'.recent.json\'),recent)\n                            else:\n                                if name not in handles:handles[name]=path.open(\'ab\',buffering=0)\n                                handle=handles[name];start=handle.tell()\n                                try:\n                                    if handle.write(encoded)!=len(encoded):raise OSError(\'short diagnostic write\')\n                                except Exception:\n                                    handle.seek(start);handle.truncate();raise\n                                if policy is not None:\n                                    policy.committed(record,encoded)\n                                    if record.get(\'kind\')==\'logging_budget\':policy.marker_written=True\n                            self.written_records+=1;self.last_write=self.clock();break\n                        except Exception as ex:\n                            self.error=f\'{type(ex).__name__}: {ex}\'\n                            handle=handles.pop(name,None)\n                            if handle:\n                                try:handle.close()\n                                except OSError:pass\n                            if attempt<2:time.sleep(.05*(attempt+1))\n                            else:self.dropped+=1\n                except Exception as ex:\n                    self.error=\'record \'+type(ex).__name__+\': \'+str(ex);self.dropped+=1\n                finally:self.queue.task_done()\n        finally:\n            if accuracy is not None:\n                try:accuracy.close()\n                except Exception as ex:self.accuracy_error=\'close \'+str(ex)\n            for handle in handles.values():\n                try:handle.close()\n                except OSError:pass\n    def _put(self,name,record):\n        if self._closed:self.dropped+=1;return False\n        try:self.queue.put_nowait((name,record));return True\n        except queue.Full:self.dropped+=1;return False\n    def event(self,kind,**details):\n        if not self.current:return\n        self.event_sequence+=1\n        record=dict(time=getattr(self,\'event_wall_time\',None) or datetime.datetime.now().astimezone().isoformat(timespec=\'milliseconds\'),mono=self.clock(),kind=kind,\n                    event_id=self.logger_id+\':\'+str(self.event_sequence))\n        record.update(details);self._put(self.current[\'id\']+\'.jsonl\',record)\n    def _start(self,frame):\n        self.real_penetration.close()\n        ident=datetime.datetime.now().strftime(\'%Y%m%d_%H%M%S_%f\')+\'_\'+re.sub(r\'[^a-zA-Z0-9_-]\',\'_\',Path(frame.map_name).stem)\n        ident+=\'_\'+uuid.uuid4().hex[:12]\n        self.current={\'id\':ident,\'map\':frame.map_name,\'started\':datetime.datetime.now().astimezone().isoformat(),\'duration_seconds\':0,\'fire_requests\':0,\'observed_rounds\':0,\'confirmed_damage_events\':0,\'confirmed_head_damage_events\':0,\'confirmed_kills\':0,\'confirmed_headshot_kills\':0,\'target_switches\':0,\'stop_reason_samples\':{},\'finished\':False}\n        self.decision_totals=DecisionTotals();self.last_detail_sample=-float(\'inf\')\n        self.last_sample=-float(\'inf\');self.last_summary=-float(\'inf\')\n        self.started=self.clock();self.last_frame=None;self.costs.clear();self.last_target=0;self.last_press=False\n        self.last_aim_sample=0.;self.last_aim_context={};self.weapon_profiles={}\n        self.accepted_fire_requests=collections.deque(maxlen=32)\n        self.last_decision_log=0.;self.last_decision_signature=None\n        self.last_health=None\n        self.last_health_gap_event=-float(\'inf\')\n        self.current.update(observed_health_loss_events=0,observed_health_lost=0,\n                            received_attack_events=0,attack_score=0,attack_contexts={},\n                            health_loss_contexts={},health_observation_gaps=0,confirmed_damage_total=0)\n        self.current.update(received_head_damage_events=0,received_known_hitgroup_events=0,\n                            received_unknown_hitgroup_events=0,received_hitgroups={},\n                            received_death_events=0,received_headshot_deaths=0,\n                            received_attacks_by_anti_aim_state={},received_head_hits_by_anti_aim_state={},\n                            anti_aim_state_samples={})\n        self.current.update(native_hurt_events=0,unmatched_native_hurt_events=0,\n            received_head_damage_total=0,received_confirmed_damage_total=0)\n        self.last_defense_sample=-float(\'inf\')\n        self.first_damage.clear();self.kill_times.clear();self.ttk.clear()\n        self.penetration_shots=[];self.penetration_sequence=0\n        self.penetration_scope=None\n        self.current[\'penetration_validation_shots\']=0\n        self.current[\'penetration_validation_damage_associations\']=0\n        self.current[\'penetration_validation_feedback_timeouts\']=0\n        self.current[\'bundle_revision\']=globals().get(\'BUNDLE_REVISION\',\'unknown\')\n        from cso2_bot_tool import BUILD\n        self.current[\'build\']=BUILD\n        self.event(\'match_start\',build=BUILD,bundle_revision=self.current[\'bundle_revision\'],map=frame.map_name,log_schema=SCHEMA,damage_log_available=self.sink_available,damage_log_error=self.sink_error,\n                   local_identity_known=bool(self.local_names))\n        from penetration_results import map_validation\n        validation=map_validation(frame.map_name)\n        self.current[\'penetration_map_validation\']=validation\n        self.event(\'penetration_map_validation\',**validation)\n    def native(self,lines):\n        for line in lines:\n            if isinstance(line,dict):\n                self.native_hurt_authoritative=True\n                if line.get(\'kind\')==\'player_hurt\':self.native_hurt(line)\n                continue\n            self.event(\'game_log\',line=line)\n            if any(token in line for token in (\'World triggered "Round_Start"\',\'World triggered "Restart_Round"\')):\n                self.last_health=None;self.last_frame=None;self.first_damage.clear()\n                self.real_penetration.close()\n            if \'World triggered "Round_End"\' in line or \'World triggered "Game_Over"\' in line:self.summarize()\n            damage=parse_damage(line)\n            if not damage or not self.current:continue\n            if damage[\'kind\']==\'damage\' and self.native_hurt_authoritative:continue\n            if damage[\'attacker_id\']==damage[\'victim_id\']:continue\n            if damage[\'kind\']==\'damage\' and damage[\'victim_name\'].casefold() in self.local_names:\n                self.observe_attack(\'native_attacked\',damage)\n            if damage[\'kind\']==\'kill\' and damage[\'victim_name\'].casefold() in self.local_names:\n                self.current[\'received_death_events\']+=1\n                self.current[\'received_headshot_deaths\']+=int(damage[\'head\'])\n                self.event(\'local_killed\',evidence=damage,headshot=damage[\'head\'],\n                           score_delta=0,**self.defense_context(),\n                           note=\'确认本人被击杀；击杀不再重复计入受击次数\')\n            if damage[\'attacker_name\'].casefold() not in self.local_names:continue\n            self.event(\'confirmed_\'+damage[\'kind\'],**{k:v for k,v in damage.items() if k!=\'kind\'})\n            if damage[\'kind\']==\'damage\':\n                self.current[\'confirmed_damage_events\']+=1\n                self.current[\'confirmed_head_damage_events\']+=int(damage[\'head\'])\n                now=self.clock();self.first_damage={k:v for k,v in self.first_damage.items() if now-v<60}\n                self.first_damage.setdefault(damage[\'victim_id\'],now)\n                try:self.current[\'confirmed_damage_total\']+=max(0,int(damage.get(\'damage\',0)))\n                except (TypeError,ValueError):pass\n            else:\n                self.current[\'confirmed_kills\']+=1\n                self.current[\'confirmed_headshot_kills\']+=int(damage[\'head\'])\n                now=self.clock();first=self.first_damage.pop(damage[\'victim_id\'],None)\n                interval=now-self.kill_times[-1] if self.kill_times else None;self.kill_times.append(now)\n                elapsed=(now-first)*1000 if first is not None and 0<=now-first<60 else None\n                if elapsed is not None:self.ttk.append(elapsed)\n                self.event(\'kill_timing\',victim_id=damage[\'victim_id\'],first_damage_to_kill_ms=elapsed,\n                           previous_kill_interval_seconds=interval,source=\'native_confirmed_events\')\n    def native_hurt(self,record):\n        if not self.current:return\n        self.current[\'native_hurt_events\']+=1\n        self.event(\'native_player_hurt\',**{k:v for k,v in record.items() if k!=\'kind\'})\n        local=record.get(\'local_index\',0);victim=record.get(\'victim_index\',0);attacker=record.get(\'attacker_index\',0)\n        if not local:\n            self.current[\'unmatched_native_hurt_events\']+=1;return\n        # Keep environment and self-damage raw, without scoring it as another player\'s attack.\n        if not attacker or attacker<0 or attacker==victim:return\n        group=received_hitgroup(record);damage=dict(record,kind=\'damage\',hitgroup=group,head=group==\'head\',\n            attacker_id=attacker,victim_id=victim,identity_basis=\'event_entindex_at_capture\')\n        if victim==local:\n            self.observe_attack(\'server_player_hurt\',damage)\n            amount=max(0,record.get(\'damage\',0));self.current[\'received_confirmed_damage_total\']+=amount\n            if group==\'head\':self.current[\'received_head_damage_total\']+=amount\n        if attacker==local:\n            self.current[\'confirmed_damage_events\']+=1\n            self.current[\'confirmed_head_damage_events\']+=int(group==\'head\')\n            self.current[\'confirmed_damage_total\']+=max(0,record.get(\'damage\',0))\n            self.event(\'confirmed_damage\',**{k:v for k,v in damage.items() if k!=\'kind\'})\n            self.first_damage.setdefault(str(victim),self.clock())\n            self.penetration_damage(record)\n\n    def penetration_damage(self,record):\n        now=self.clock()\n        candidates=[s for s in getattr(self,\'penetration_shots\',[]) if not s.get(\'damage_seen\')\n                    and s[\'local_index\']==record.get(\'local_index\') and s[\'target\']==record.get(\'victim_index\')\n                    and 0<=now-s[\'observed_at\']<=.5]\n        shot=candidates[0] if len(candidates)==1 and candidates[0][\'rounds\']==1 else None\n        if shot is not None:\n            shot[\'damage_seen\']=True\n            self.current[\'penetration_validation_damage_associations\']+=1\n            self.real_penetration.damage(shot_id=shot[\'id\'],record=record,now=now)\n        self.event(\'penetration_validation_damage\',shot_id=shot[\'id\'] if shot else None,\n                   state=\'single_context_association\' if shot else \'ambiguous_or_missing_shot_context\',\n                   candidate_shot_ids=[s[\'id\'] for s in candidates],damage=record.get(\'damage\'),\n                   victim=record.get(\'victim_index\'),hitgroup=record.get(\'hitgroup\'),\n                   event_tick=record.get(\'tick\'),actual_bullet_path_verified=False,\n                   predicted_validation=shot[\'path\'].get(\'penetration_validation\') if shot else None,\n                   predicted_damage=shot[\'path\'].get(\'estimated_damage\') if shot else None,\n                   target_health_before=shot.get(\'target_health_before\') if shot else None,\n                   target_health_after_observed=shot.get(\'target_health_after\') if shot else None,\n                   forced_tab_mode=bool(shot and shot.get(\'tab_force_fire_active\')),\n                   penetration_proven=False,accuracy_label_accepted=False)\n\n    def penetration_observe(self,frame,context,rounds=0,observation_id=None):\n        now=self.clock()\n        self.real_penetration.refresh(frame)\n        self.real_penetration.expire(now)\n        scope=(frame.map_name,frame.local.index,frame.local.address,getattr(frame.local,\'serial\',None))\n        if getattr(self,\'penetration_scope\',None)!=scope:\n            self.penetration_shots=[];self.penetration_scope=scope\n        keep=[]\n        for shot in self.penetration_shots:\n            if now-shot[\'observed_at\']>.5:\n                if not shot.get(\'damage_seen\'):\n                    self.current[\'penetration_validation_feedback_timeouts\']+=1\n                    self.event(\'penetration_validation_feedback\',shot_id=shot[\'id\'],state=\'no_matched_damage_in_window\',\n                               predicted_kind=shot[\'path\'].get(\'kind\'),actual_blockage_proven=False,\n                               accuracy_label_accepted=False)\n            else:keep.append(shot)\n        self.penetration_shots=keep\n        if rounds<=0:return\n        prior=self.last_aim_context or {}\n        fire_path=prior.get(\'penetration\') or {}\n        path=prior.get(\'penetration_observation\') or fire_path\n        target_index=int(prior.get(\'target\') or self.last_target or 0)\n        before_actor=next((e for e in getattr(self.last_frame,\'entities\',())\n                           if e.index==target_index),None)\n        after_actor=next((e for e in getattr(frame,\'entities\',())\n                          if e.index==target_index),None)\n        layers=path.get(\'layers\') if isinstance(path,dict) else None\n        if isinstance(layers,list):layers=layers[:16]\n        self.penetration_sequence+=1\n        row=dict(id=self.penetration_sequence,observed_at=now,rounds=rounds,map=frame.map_name,\n                 observation_id=observation_id,weapon_identity=weapon_identity(frame),\n                  local_index=frame.local.index,target=target_index,target_serial=prior.get(\'target_serial\'),\n                  weapon=frame.weapon,eye=prior.get(\'eye\'),sampled_eye=frame.eye,\n                  aim_point=prior.get(\'firing_aim_point\') or prior.get(\'aim_point\'),\n                  ray_start_xyz=prior.get(\'penetration_observation_ray_start\') or prior.get(\'eye\'),\n                  ray_end_xyz=prior.get(\'penetration_observation_ray_end\') or prior.get(\'firing_aim_point\') or prior.get(\'aim_point\'),\n                  forced_aim_part=\'head\' if prior.get(\'tab_force_fire_active\') else prior.get(\'aim_part\'),\n                  tab_force_fire_active=bool(prior.get(\'tab_force_fire_active\')),\n                  prior_context_age_ms=(frame.stamp-prior[\'frame_stamp\'])*1000 if \'frame_stamp\' in prior else None,\n                  visibility=prior.get(\'visibility\'),wall_age_ms=prior.get(\'wall_age_ms\'),\n                  actual_sight=prior.get(\'actual_sight\'),fire_allowed=prior.get(\'fire_allowed\',False),\n                  target_health_before=before_actor.health if before_actor else prior.get(\'target_health\'),\n                  target_health_after=after_actor.health if after_actor else None,\n                  target_health_delta=((before_actor.health-after_actor.health)\n                                       if before_actor and after_actor and\n                                          isinstance(before_actor.health,(int,float)) and\n                                          isinstance(after_actor.health,(int,float)) else None),\n                  path={k:path.get(k) for k in (\'kind\',\'allowed\',\'material_source\',\'estimated_damage\',\'verified_damage\',\n                       \'guard_reason\',\'training_result_hash\',\'penetration_validation\',\'policy_version\',\'remaining_power\',\n                       \'penetration_verdict\',\'penetrability\',\'obstacle_thickness\',\'total_thickness\',\n                       \'pending_reason\',\'pending_reason_code\',\'non_penetrable_reason\',\n                       \'non_penetrable_reason_code\',\'penetration_reason\',\'observed_thickness\')},\n                  actual_bullet_path_verified=False,accuracy_label_accepted=False)\n        row[\'path\'][\'layers\']=layers or []\n        row[\'path\'][\'exit_check\']=path.get(\'exit_check\') if isinstance(path,dict) else None\n        row[\'fire_path_kind\']=fire_path.get(\'kind\') if isinstance(fire_path,dict) else None\n        row[\'observed_wall_path\']=bool(isinstance(path,dict) and path.get(\'kind\')==\'penetration\')\n        self.penetration_shots.append(row)\n        if len(self.penetration_shots)>32:self.penetration_shots.pop(0)\n        self.current[\'penetration_validation_shots\']+=rounds\n        self.event(\'penetration_validation_shot\',**row)\n        # Reuse the pre-consumption snapshot; never read game memory or geometry here.\n        previous=self.last_frame\n        if (previous is not None and before_actor is not None and after_actor is not None\n                and previous.map_name==frame.map_name\n                and (before_actor.index,before_actor.address,before_actor.serial)==\n                    (after_actor.index,after_actor.address,after_actor.serial)):\n            self.real_penetration.observe_shot(shot_id=row[\'id\'],observed_at=frame.stamp,\n                rounds=rounds,frame=previous,target=before_actor,context=prior,\n                observation_id=observation_id,wall_time=getattr(self,\'event_wall_time\',None)\n                    or datetime.datetime.now().astimezone().isoformat(timespec=\'milliseconds\'))\n            self.real_penetration.refresh(frame)\n\n    def defense_context(self):\n        prior=self.last_health or {}\n        context=prior.get(\'context\',self.last_aim_context)\n        aa=dict(context.get(\'anti_aim\',{}))\n        stamp=aa.get(\'observed_at\')\n        age=max(0.,(self.clock()-stamp)*1000) if isinstance(stamp,(int,float)) else None\n        if age is None or age>250:state=\'unknown\'\n        elif aa.get(\'requested\') is False:state=\'disabled\'\n        elif aa.get(\'capability_available\') is False:state=\'unavailable\'\n        elif aa.get(\'active\') is True:state=\'active_observed\'\n        else:state=\'inactive_observed\'\n        return dict(anti_aim=aa,anti_aim_observed_state=state,anti_aim_context_age_ms=age,\n                    defense_test=context.get(\'defense_test\',{}),\n                    anti_aim_state_basis=\'latest_control_sample_when_log_polled\',\n                    anti_aim_hit_time_verified=False)\n\n    def observe_attack(self,source,evidence):\n        if not self.current:return\n        self.current[\'received_attack_events\']+=1;self.current[\'attack_score\']-=1\n        group=received_hitgroup(evidence);head=group==\'head\';defense=self.defense_context()\n        self.current[\'received_head_damage_events\']+=int(head)\n        self.current[\'received_known_hitgroup_events\']+=int(group!=\'unknown\')\n        self.current[\'received_unknown_hitgroup_events\']+=int(group==\'unknown\')\n        groups=self.current[\'received_hitgroups\'];groups[group]=groups.get(group,0)+1\n        state=defense[\'anti_aim_observed_state\']\n        for key,increment in ((\'received_attacks_by_anti_aim_state\',1),(\'received_head_hits_by_anti_aim_state\',int(head))):\n            counts=self.current[key];counts[state]=counts.get(state,0)+increment\n        prior=self.last_health or {}\n        context=prior.get(\'context\',self.last_aim_context)\n        category=\'firing\' if prior.get(\'pressed\',self.last_press) else \'tracking\' if context.get(\'target\') else \'no_target\'\n        counts=self.current[\'attack_contexts\'];counts[category]=counts.get(category,0)+1\n        self.event(\'local_attacked\',source=source,evidence=evidence,hitgroup=group,head=head if group!=\'unknown\' else None,\n                   **defense,score_delta=-1,\n                   score_total=self.current[\'attack_score\'],control=context,render=self.render_metrics,\n                   reason=prior.get(\'reason\',\'\'),trigger_was_held=prior.get(\'pressed\',self.last_press),\n                   context_age_ms=max(0,(self.clock()-prior[\'stamp\'])*1000) if \'stamp\' in prior else None,\n                   note=\'每个确认受击事件扣1分；不要求HP下降；掉血和击杀日志不再重复扣分\')\n    def frame(self,frame,control,sample_ms,trace_ms,cfg,weapon=None):\n        self.unready_since=0\n        if self.current and self.current[\'map\']!=frame.map_name:self.finish(\'map_changed\')\n        if self.current is None:self._start(frame)\n        context=dict(getattr(control,\'diagnostic\',{}))\n        self.penetration_observe(frame,context)\n        if context.get(\'build\'):self.current[\'build\']=context[\'build\']\n        velocity=getattr(frame.local,\'velocity\',None)\n        speed=math.sqrt(sum(v*v for v in velocity)) if velocity is not None and len(velocity)==3 and all(math.isfinite(v) for v in velocity) else None\n        context[\'defense_test\']=dict(frame_stamp=frame.stamp,local_index=frame.local.index,\n            local_team=frame.local.team,health=frame.local.health,local_velocity=velocity,\n            speed_units_per_second=speed,stationary_observed=speed<1. if speed is not None else None,\n            grounded=None if getattr(frame.local,\'flags\',None) is None else bool(frame.local.flags&1),\n            settings={key:getattr(cfg,key,None) for key in (\'anti_aim\',\'anti_aim_mode\',\'anti_aim_pitch\',\n                \'anti_aim_jitter\',\'anti_aim_period\',\'aim\',\'fire\',\'grenade_dodge\',\'bhop\',\'lock_hp\',\'lock_hp_once\',\'locked_hp\')})\n        self.observe_health(frame.local,frame.map_name,frame.stamp,context,control.reason,control.pressed)\n        if self.clock()-self.last_defense_sample>=1.:\n            defense=self.defense_context();state=defense[\'anti_aim_observed_state\']\n            counts=self.current[\'anti_aim_state_samples\'];counts[state]=counts.get(state,0)+1\n            self.event(\'defense_test_sample\',**defense,damage_log_available=self.sink_available,\n                       damage_log_error=self.sink_error,damage_log_dropped_records=self.sink_dropped)\n            self.last_defense_sample=self.clock()\n        if frame.weapon not in self.weapon_profiles or self.weapon_profiles[frame.weapon]!=weapon:\n            self.weapon_profiles[frame.weapon]=weapon\n            self.event(\'weapon_profile\',weapon=frame.weapon,parameters=weapon,\n                       note=\'脚本默认参数；未确认当前皮肤覆盖值和引擎实际散布，不代表命中概率\')\n        previous=self.last_frame\n        count=observed_ammo_drop(previous,frame)\n        if count:\n            self.current[\'observed_rounds\']+=count\n            observation_id=self.current[\'id\']+\':ammo:\'+str(self.current[\'observed_rounds\'])\n            request_evidence=self.ammo_request_context(frame,count)\n            self.penetration_observe(frame,context,count,observation_id)\n            self.event(\'ammo_decreased\',rounds=count,weapon=frame.weapon,ammo=frame.ammo,target=control.target,\n                       damage_log_available=self.sink_available,damage_log_error=self.sink_error,\n                       observation_id=observation_id,clip_before=previous.ammo,clip_after=frame.ammo,\n                       weapon_identity=weapon_identity(frame),\n                       reserve_ammo=(getattr(frame,\'weapon_state\',{}) or {}).get(\'reserve_ammo\'),\n                       sample_interval=[previous.stamp,frame.stamp],engine_shot_tick=None,\n                       prior_aim=self.last_aim_context,current_aim=context,\n                       accepted_fire_request=request_evidence,\n                       prior_context_age_ms=(frame.stamp-self.last_aim_context[\'frame_stamp\'])*1000 if \'frame_stamp\' in self.last_aim_context else None,\n                       trigger_was_held=self.last_press,\n                       note=\'弹量变化只证明射击；前后采样不能代替引擎射击射线或伤害确认\')\n            pitch=math.radians(frame.angles[0]+frame.punch[0]*2);yaw=math.radians(frame.angles[1]+frame.punch[1]*2)\n            direction=(math.cos(pitch)*math.cos(yaw),math.cos(pitch)*math.sin(yaw),-math.sin(pitch))\n            self.event(\'shot_observation\',rounds=count,source=\'ammo_delta_and_sampled_view\',eye=frame.eye,\n                       observation_id=observation_id,sample_basis=\'post_decrement_observation_not_fire_tick\',\n                       weapon_identity=weapon_identity(frame),\n                       before_fire_context={key:self.last_aim_context.get(key) for key in\n                           (\'frame_stamp\',\'fire_decision_stamp\',\'target\',\'target_address\',\'target_serial\',\n                            \'firing_aim_point\',\'write_readback_error_deg\',\'actual_sight\',\'weapon_identity\',\'fire_snapshot\',\'aim_fit\')},\n                       accuracy=accuracy_profile(weapon),\n                       sight_direction=direction,aim_point=context.get(\'aim_point\'),target=control.target,\n                       angular_error=context.get(\'observed_error_deg\'),visibility=context.get(\'visibility\'),\n                       wall_age_ms=context.get(\'wall_age_ms\'),local_velocity=frame.local.velocity,local_flags=frame.local.flags,\n                       actual_bullet_path=None,spread_seed=None,note=\'视线射线估计；不是引擎实际弹道，不能据此记命中\')\n            prior_target=next((e for e in previous.entities if e.index==self.last_target),None)\n            current_target=next((e for e in frame.entities if prior_target and (e.index,e.address,e.serial)==(prior_target.index,prior_target.address,prior_target.serial)),None)\n            self.event(\'target_health_observation\',rounds=count,target=self.last_target,\n                       observation_id=observation_id,\n                       health_before=prior_target.health if prior_target else None,\n                       health_after=current_target.health if current_target else None,\n                       head_before=prior_target.head if prior_target else None,head_after=current_target.head if current_target else None,\n                       confirmed_local_hit=False,note=\'目标血量变化可能来自其他攻击者；不计作本人的确认命中\')\n        if control.target!=self.last_target:\n            self.current[\'target_switches\']+=int(bool(control.target))\n            self.event(\'target_changed\',previous=self.last_target,target=control.target,reason=control.reason)\n        # Capture every pulse, even if it begins and ends between sample records.\n        self.actions(control)\n        now=self.clock();self.costs.append(sample_ms)\n        self.aim_fire_decision(frame,control,context,sample_ms,trace_ms,now)\n        if control.target and now-self.last_aim_sample>=15.:\n            self.event(\'aim_sample\',context=context,trigger_held=control.pressed,reason=control.reason)\n            self.last_aim_sample=now\n        civilian_errors=getattr(frame,\'protected_errors\',[])\n        civilian_key=(frame.map_name,frame.local.address,frame.local.serial,frame.protected_complete,\n            tuple((e.get(\'index\'),e.get(\'address\'),e.get(\'serial\'),e.get(\'stage\'),e.get(\'error\')) for e in civilian_errors))\n        if civilian_key!=getattr(self,\'last_civilian_key\',None):\n            if civilian_errors or not frame.protected_complete:\n                self.event(\'civilian_read_failure\',errors=civilian_errors,complete=frame.protected_complete,\n                    failure_policy=\'skip_unreadable\',frame_stamp=frame.stamp)\n            self.last_civilian_key=civilian_key\n        if now-self.last_sample>=1:\n            reasons=self.current[\'stop_reason_samples\'];increment(reasons,control.reason)\n            self.last_sample=now\n        if now-self.last_detail_sample>=15. and getattr(frame,\'log_detail_sample\',True):\n            self.event(\'civilian_geometry\',complete=frame.protected_complete,failure_policy=\'skip_unreadable\',\n                errors=getattr(frame,\'protected_errors\',[]),eye=frame.eye,frame_stamp=frame.stamp,\n                hostages=[dict(index=p.index,bounds=p.bounds,dormant=p.dormant,sampled_at=p.sampled_at,\n                    hitboxes=[dict(bounds=b.bounds,origin=b.origin,inverse=b.inverse,scales=b.scales) for b in p.hitboxes]) for p in frame.protected])\n            self.event(\'control_status\',context=context,reason=control.reason)\n            self.event(\'sample\',sample_ms=round(sample_ms,3),trace_ms=round(trace_ms,3),target=control.target,reason=control.reason,ammo=frame.ammo,weapon=frame.weapon,angles=frame.angles,punch=frame.punch,eye=frame.eye,aim=cfg.aim,fire=cfg.fire,mode=frame.mode,native_mode_id=frame.native_mode_id,free_for_all=frame.free_for_all,render=self.render_metrics,entities=[{\'index\':e.index,\'team\':e.team,\'enemy\':e.enemy,\'health\':e.health,\'head\':e.head,\'visibility\':e.visibility,\'class\':e.classname,\'model\':e.model,\'head_source\':e.head_source,\'head_bone\':e.head_bone,\'dormant\':e.dormant,\'origin\':e.origin,\'skeleton_segments\':len(e.skeleton),\'serial\':e.serial,\'can_throw\':e.can_throw,\'throwable_source\':e.throwable_source,\'pose_status\':e.pose_status,\'pose_confirmed\':e.pose_confirmed,\'pose_evidence\':e.pose_evidence,\'ragdoll_present\':e.ragdoll_present,\'pose_diagnostic\':getattr(e,\'pose_diagnostic\',{})} for e in frame.entities])\n            self.last_detail_sample=now\n        self.last_frame=frame;self.last_target=control.target;self.last_press=control.pressed;self.last_aim_context=context\n        if now-self.last_summary>=15:self.summarize();self.last_summary=now\n    def observe_health(self,local,map_name,stamp,context=None,reason=\'\',pressed=False,dead=False):\n        if not self.current or self.current[\'map\']!=map_name:return\n        health=local.health\n        if not isinstance(health,int) or not 0<=health<100000000:return\n        key=(map_name,local.index,local.address,local.classname,local.team,local.zombie_class)\n        current=dict(key=key,health=health,stamp=stamp,dead=dead or health==0,\n                     context=dict(context or {}),reason=reason,pressed=bool(pressed))\n        previous=self.last_health;self.last_health=current\n        if previous is None or previous[\'key\']!=key or previous[\'dead\']:return\n        gap=stamp-previous[\'stamp\']\n        if not 0<=gap<=.5:\n            self.current[\'health_observation_gaps\']+=1\n            if stamp-self.last_health_gap_event>=15:\n                self.event(\'health_baseline_reset\',gap_seconds=gap,health=health,note=\'采样中断，重新建立基线，不推算掉血\')\n                self.last_health_gap_event=stamp\n            return\n        lost=previous[\'health\']-health\n        if lost<=0:return\n        self.current[\'observed_health_loss_events\']+=1\n        self.current[\'observed_health_lost\']+=lost\n        prior=previous[\'context\']\n        category=(\'firing\' if previous[\'pressed\'] else \'tracking\' if prior.get(\'target\') else \'no_target\')\n        counters=self.current[\'health_loss_contexts\'];counters[category]=counters.get(category,0)+lost\n        self.event(\'local_health_lost\',before=previous[\'health\'],after=health,lost_hp=lost,\n                   score_delta=0,score_total=self.current[\'attack_score\'],fatal=current[\'dead\'],\n                   sample_gap_ms=round(gap*1000,3),prior_control=prior,current_control=current[\'context\'],\n                   prior_reason=previous[\'reason\'],current_reason=reason,trigger_was_held=previous[\'pressed\'],\n                   render=self.render_metrics,cause=\'unconfirmed\',\n                   note=\'实际生命值下降，仅作辅助记录；不按HP扣分，不据此认定受到攻击\')\n    def unready(self,reason,signon):\n        if signon==6:return  # Death/spectating does not end the match.\n        if not self.unready_since:self.unready_since=self.clock()\n        if self.clock()-self.unready_since>=2:self.finish(reason)\n    def actions(self,control):\n        for action in control.drain_actions():\n            self.event(\'input_action\',**action)\n            if self.current and action.get(\'action\')==\'fire_down\':\n                self.current[\'fire_requests\']+=1\n                from weapon_accuracy import compact_context\n                context=compact_context({\'prior_aim\':action.get(\'aim_context\') or {}})\n                self.accepted_fire_requests.append(dict(request_id=self.current[\'fire_requests\'],\n                    mono=action.get(\'mono\'),context=context))\n\n    def ammo_request_context(self,frame,count):\n        """Preserve an accepted DOWN snapshot, separate from last-frame aim.\n\n        This is a bounded request association, not an engine bullet ID. The\n        current frame\'s later control actions are added only AFTER ammo logging.\n        """\n        key=weapon_identity(frame);requests=getattr(self,\'accepted_fire_requests\',())\n        valid=[r for r in requests if type(r.get(\'mono\')) in (int,float) and\n               math.isfinite(r[\'mono\']) and 0<=frame.stamp-r[\'mono\']<=.5]\n        candidates=[r for r in valid if key and tuple(r[\'context\'].get(\'weapon_identity\') or ())==tuple(key)]\n        # A request already covered by this clip observation cannot later be\n        # reused as a new first shot. Ambiguous and multi-round cases stay so.\n        used={id(r) for r in candidates}\n        self.accepted_fire_requests=collections.deque((r for r in valid if id(r) not in used),maxlen