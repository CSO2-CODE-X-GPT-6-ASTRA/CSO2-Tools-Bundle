onotonic()-started)*1000\n        frame=Frame(started,local,eye,angles,punch,matrix,entities,name,weapon,ammo,m.i32(lp+0x1638),mode,protected,protected_complete,grenades,hazard_status)\n        frame.weapon_state=weapon_state\n        frame.native_mode_id=native_mode;frame.free_for_all=free_for_all\n        frame.hazard_diagnostics=dict(getattr(self.hazard_reader,\'metrics\',{})) if with_hazards else {}\n        frame.protected_errors=protected_errors\n        # Independent aim owns this geometry and per-point protection.\n        if not defer_hostage_filter:\n            frame.hostage_aim_filter=filter_hostage_aim_points(frame)\n        # Never retain a previous map\'s civilian population.\n        frame.hostages=hostages if protect else []\n        frame.hostage_geometry=\'client_protected_volume\' if protect else \'\'\n        frame.hostage_scope=(name,local.index,local.serial,native_mode) if protect else None\n        # A partial aim frame says nothing about unseen actors. Preserve their\n        # bounded activity history until the next full population acquisition;\n        # never transplant it across maps, slot reuse or a stale interval.\n        retained={}\n        if follow_target is not None and self.pose_activity.map_name==frame.map_name:\n            seen={e.index for e in entities}\n            retained={key:value for key,value in self.pose_activity.tracks.items()\n                if key[0] not in seen and self.slot_cache.get(key[0],())[:2]==key[1:3]\n                and 0<=started-value[\'stamp\']<=.5}\n        self.pose_activity.update(frame)\n        self.pose_activity.tracks.update(retained)\n        self.entity_stats.update(hp1=sum(e.health==1 for e in entities),\n                                hp1_active=sum(e.pose_confirmed for e in entities),\n                                ragdoll_excluded=sum(e.ragdoll_present is True for e in entities))\n        self.session_state.update(stage=\'ready\',map=name,local_index=index)\n        return frame\n    def set_angles(self,angles):\n        self.require_feature(\'view_control\')\n        if not finite(angles) or not -89<=angles[0]<=89 or not -180<=angles[1]<=180:raise MemoryError(\'拒绝无效视角\')\n        self.mem.allow_write()\n        self.mem.write(self.global_addr(\'view_angles\'),struct.pack(\'<3f\',*angles))\n    def control_identity(self,frame):\n        """Do not carry an old local actor across respawn, slot reuse or map exit."""\n        m=self.mem;p=frame.local.address\n        if not m or not m.alive():raise NotReady(\'游戏进程未运行\')\n        if (m.i32(self.global_addr(\'signon\'))!=6 or m.u32(self.global_addr(\'local_player\'))!=p or\n                struct.unpack(\'<II\',m.read(self.global_addr(\'entity_entries\')+frame.local.index*16,8))!=(p,frame.local.serial)):\n            raise NotReady(\'本地角色变化，等待当前视角\')\n        if m.read(p+0x97,1)!=b\'\\0\' or m.i32(p+0x98)<=0:\n            raise NotReady(\'本地角色未存活，停止辅助控制\')\n    def control_view(self,frame):\n        """Refresh the moving camera after selecting/resampling a target."""\n        self.control_identity(frame);m=self.mem;p=frame.local.address\n        offset=m.vec(p+0x18c);origin=m.vec(p+0x300)\n        angles=m.vec(self.global_addr(\'view_angles\'));punch=m.vec(p+0xfd8) if self.fields_available(\'m_Local\',\'m_vecPunchAngle\') else (0.,0.,0.)\n        if (not finite(offset+origin+angles+punch) or not eye_offset_valid(offset,client_scale(self,p)) or\n                not -90<=angles[0]<=90 or m.u32(self.global_addr(\'local_player\'))!=p):\n            raise NotReady(\'当前视角数据待更新\')\n        self.control_identity(frame)\n        return replace(frame,eye=add(origin,offset),angles=angles,punch=punch)\n    def control_motion_view(self,frame):\n        """Private final camera sample for relative-motion prediction."""\n        self.control_identity(frame);m=self.mem;p=frame.local.address\n        began=time.monotonic()\n        offset=m.vec(p+0x18c);origin=m.vec(p+0x300)\n        velocity=m.vec(p+0x198)\n        eye_stamp=time.monotonic()\n        angles=m.vec(self.global_addr(\'view_angles\'))\n        punch=m.vec(p+0xfd8) if self.fields_available(\'m_Local\',\'m_vecPunchAngle\') else (0.,0.,0.)\n        if (not finite(offset+origin+angles+punch) or\n                not eye_offset_valid(offset,client_scale(self,p)) or not -90<=angles[0]<=90):\n            raise NotReady(\'运动补偿当前视角待更新\')\n        self.control_identity(frame)\n        # Invalid velocity disables prediction; it does not invalidate a valid camera.\n        return replace(frame,eye=add(origin,offset),angles=angles,punch=punch,\n            local=replace(frame.local,origin=origin,velocity=velocity),\n            control_provenance=dict(frame.control_provenance,motion_eye_stamp=eye_stamp,\n                motion_eye_read_ms=(eye_stamp-began)*1000))\n\n    def control_selection_view(self,frame):\n        """Refresh admission projection with the camera used for ranking.\n\n        control_view is also called at fire boundaries, where no screen test\n        runs. Read the render matrix once here rather than on every readback.\n        Preserve the original entity timestamp and all identity checks.\n        """\n        current=self.control_view(frame)\n        matrix=self.camera_matrix()\n        self.control_identity(current)\n        return replace(current,matrix=matrix)\n    def control_weapon(self,frame):\n        """Keep final clip telemetry and input expectations on one weapon entity."""\n        from aim_weapon_input_guard import read_weapon_state\n        from runtime_diagnostics import weapon_identity\n        self.control_identity(frame)\n        state=read_weapon_state(self,frame.local.address)\n        current=replace(frame,weapon=state[\'classname\'],ammo=state[\'ammo\'],weapon_state=state)\n        if not weapon_identity(frame) or weapon_identity(current)!=weapon_identity(frame):\n            raise NotReady(\'开火前武器实体变化，重新采样\')\n        self.control_identity(current)\n        return current\n    def di