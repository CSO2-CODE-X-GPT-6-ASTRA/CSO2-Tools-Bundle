_EMBEDDED['rmb_weapon_contract']=(1, '"""Actual input-owner regression, with simulated process memory and native binds."""\nimport io\nimport copy\nimport struct\nimport unittest\nimport threading\nfrom unittest.mock import patch\nfrom moving_fire_contract import native_fixture\nfrom aim_fire_acceptance_contract import native_step\nfrom aim_fire_cleanup_contract import binding_fixture\n\n\ndef weapon_fixture(primary_class=None):\n    f = native_fixture((0., 0., 0.))\n    r = f.reader\n    if primary_class:\n        f.frame.weapon=primary_class;f.frame.local.weapon=primary_class\n        f.frame.weapon_state[\'classname\']=primary_class\n    old_u32, old_i32 = r.mem.u32, r.mem.i32\n    active = dict(handle=123, address=0x555000, classname=f.frame.weapon, ammo=30)\n    slots = {123:(0x555000, f.frame.weapon), 124:(0x556000, \'CWeaponUSP\')}\n    native = dict(binding=\'\', secondary=0)\n    r.engine = 0x10000000\n    def u32(address):\n        if address == f.frame.local.address + 0xf0c:return active[\'handle\']\n        if address == r.engine+0xaeb8a0+108*8:return 0x30000000\n        return old_u32(address)\n    def i32(address):\n        if address in (0x555000+0xa30, 0x556000+0xa30):return active[\'ammo\']\n        return old_i32(address)\n    r.mem.u32, r.mem.i32 = u32, i32\n    r.mem.string = lambda address, size:native[\'binding\'] if address==0x30000000 else \'\'\n    r.handle_entity = lambda handle:slots.get(handle,(0,\'\'))[0]\n    r.classname = lambda address:next((name for ptr,name in slots.values() if ptr==address),\'\')\n    b = f.control.trigger.aim_binding\n    b.reader=r;b.ready=True;b.reservation_confirmed=True;b.source_was_empty=True;b.last_observed=\'\'\n    if hasattr(f.control.trigger,\'_weapon_reader\'):\n        # Native fixture installs its simulated entity map after binding.\n        f.control.trigger._weapon_reader=copy.copy(r)\n    def select(handle, ammo):\n        active.update(handle=handle,address=slots[handle][0],classname=slots[handle][1],ammo=ammo)\n    f.active_weapon, f.native_binding, f.select_weapon = active, native, select\n    return f\n\n\ndef run():\n    class Tests(unittest.TestCase):\n        def test_primary_empty_then_manual_pistol_only_pistol_fires(self):\n            from weapon_input_guard import read_weapon_state\n            f=weapon_fixture(\'CWeaponM4A1\');f.select_weapon(123,0);f.frame.ammo=0\n            with patch(\'weapon_input_guard.time.monotonic\',side_effect=lambda:f.now[0]):\n                native_step(f,10.);self.assertNotIn((0x90000,3),f.native_writes)\n                f.select_weapon(124,12)\n                s=read_weapon_state(f.reader,f.frame.local.address)\n                f.frame.weapon=s[\'classname\'];f.frame.ammo=s[\'ammo\'];f.frame.weapon_state=s\n                d=native_step(f,10.008)\n                self.assertTrue(f.control.pressed,d)\n                for i in range(1,6):\n                    f.active_weapon[\'ammo\']-=1;f.frame.ammo=f.active_weapon[\'ammo\']\n                    d=native_step(f,10.008+i*.008);self.assertTrue(f.control.pressed,d)\n            self.assertEqual(f.active_weapon[\'handle\'],124)\n            self.assertTrue(all(address==0x90000 for address,value in f.native_writes))\n\n        def test_final_down_reads_actual_native_binding(self):\n            f=weapon_fixture();f.native_binding[\'binding\']=\'lastinv\'\n            with patch(\'weapon_input_guard.time.monotonic\',side_effect=lambda:f.now[0]):\n                d=native_step(f,10.)\n            self.assertFalse(f.control.pressed,d);self.assertNotIn((0x90000,3),f.native_writes)\n            self.assertEqual(f.control.trigger.fire_guard[\'reason\'],\'native_rmb_binding_changed\')\n\n        def test_empty_old_weapon_immediately_releases_held_attack(self):\n            f=weapon_fixture()\n            with patch(\'weapon_input_guard.time.monotonic\',side_effect=lambda:f.now[0]):\n                native_step(f,10.);self.assertTrue(f.control.pressed)\n                f.active_weapon[\'ammo\']=0\n                f.control.trigger.poll_weapon()\n                f.control.trigger.service_pending_release()\n            self.assertFalse(f.control.trigger.active)\n            self.assertEqual(f.native_writes[-1],(0x90000,4))\n\n        def test_manual_switch_releases_without_switchback_or_reload(self):\n            f=weapon_fixture()\n            with patch(\'weapon_input_guard.time.monotonic\',side_effect=lambda:f.now[0]):\n                native_step(f,10.);self.assertTrue(f.control.pressed)\n                f.select_weapon(124,12);f.control.trigger.poll_weapon();f.control.trigger.service_pending_release()\n            self.assertFalse(f.control.trigger.active);self.assertEqual(f.active_weapon[\'handle\'],124)\n            self.assertEqual(f.native_writes[-1],(0x90000,4))\n            self.assertEqual(f.control.trigger.fire_guard[\'reason\'],\'active_weapon_changed\')\n\n        def test_switch_inside_aim_callback_rejects_old_primary_down(self):\n            from weapon_input_guard import read_weapon_state\n            f=weapon_fixture();e=f.control.trigger\n            with patch(\'weapon_input_guard.time.monotonic\',side_effect=lambda:f.now[0]):\n                f.frame.weapon_state=read_weapon_state(f.reader,f.frame.local.address);e.prepare_frame(f.frame)\n                self.assertFalse(e.set_guarded(lambda:(f.select_weapon(124,12),True)[1]))\n            self.assertNotIn((0x90000,3),f.native_writes);self.assertEqual(f.active_weapon[\'handle\'],124)\n\n        def test_input_release_is_reconciled_with_controller(self):\n            from weapon_input_guard import read_weapon_state\n            f=weapon_fixture()\n            with patch(\'weapon_input_guard.time.monotonic\',side_effect=lambda:f.now[0]):\n                native_step(f,10.);f.select_weapon(124,12);f.control.trigger.poll_weapon();f.control.trigger.service_pending_release()\n                f.control.service_fire_release(f.reader,f.frame)\n                self.assertFalse(f.control.pressed)\n                s=read_weapon_state(f.reader,f.frame.local.address)\n                f.frame.weapon=s[\'classname\'];f.frame.ammo=s[\'ammo\'];f.frame.weapon_state=s\n                d=native_step(f,10.008);self.assertTrue(f.control.pressed,d)\n            self.assertEqual([value for address,value in f.native_writes],[3,4,3])\n\n        def test_10ms_sampler_publishes_latest_weapon_and_generation(self):\n            f=weapon_fixture();e=f.control.trigger\n            with patch(\'weapon_input_guard.time.monotonic\',side_effect=lambda:f.now[0]):\n                e.poll_weapon();first=e.weapon_snapshot();f.select_weapon(124,12);e.poll_weapon()\n                second=e.weapon_snapshot();updated=e.current_weapon(f.frame)\n            self.assertEqual(second[\'handle\'],124);self.assertGreater(second[\'generation\'],first[\'generation\'])\n            self.assertEqual(updated.weapon,\'CWeaponUSP\');self.assertEqual(updated.ammo,12)\n\n        def test_reservation_commands_have_no_weapon_or_secondary_alias(self):\n            e=binding_fixture(\'+quickknife\');self.assertTrue(e.ready())\n            e.held=False;e.b.close();e.execute();e.b.close()\n            self.assertEqual(e.sent,[\'bind "MOUSE2" ""\',\'bind "MOUSE2" "+quickknife"\'])\n            self.assertEqual(e.switches,0)\n\n        def test_short_read_failure_releases_then_current_weapon_recovers(self):\n            from reader import MemoryError\n            f=weapon_fixture();e=f.control.trigger;old=f.reader.mem.u32\n            with patch(\'weapon_input_guard.time.monotonic\',side_effect=lambda:f.now[0]):\n                native_step(f,10.)\n                f.reader.mem.u32=lambda address:(_ for _ in ()).throw(MemoryError(\'transient read\'))\n                e.poll_weapon();e.service_pending_release();self.assertFalse(e.active)\n                f.reader.mem.u32=old;e.poll_weapon();self.assertTrue(e.weapon_snapshot()[\'valid\'])\n                f.control.service_fire_release(f.reader,f.frame)\n                d=native_step(f,10.008);self.assertTrue(f.control.pressed,d)\n\n        def test_monitor_thread_samples_stops_and_never_sends_primary_down(self):\n            f=weapon_fixture();e=f.control.trigger;seen=threading.Event();poll=e.poll_weapon\n            def observe():\n                poll()\n                if e.monitor_metrics[\'samples\']>=3:seen.set()\n            e.poll_weapon=observe\n            try:\n                e.start_monitor();self.assertTrue(seen.wait(.5));thread=e._monitor\n            finally:e.stop_monitor()\n            self.assertFalse(thread.is_alive());self.assertIsNone(e._monitor)\n            self.assertNotIn((0x90000,3),f.native_writes)\n            self.assertGreaterEqual(e.monitor_metrics[\'samples\'],3)\n\n        def test_old_monitor_read_cannot_release_new_pistol_commit(self):\n            from weapon_input_guard import read_weapon_state\n            f=weapon_fixture();e=f.control.trigger;sampled=threading.Event();resume=threading.Event()\n            original=f.reader.mem.i32;worker=[None]\n            def delayed_health(address):\n                result=original(address)\n                if threading.current_thread() is worker[0] and address==f.frame.local.address+0x98:\n                    sampled.set()\n                    if not resume.wait(.5):raise AssertionError(\'test sample release timed out\')\n                return result\n            f.reader.mem.i32=delayed_health\n            with patch(\'weapon_input_guard.time.monotonic\',side_effect=lambda:f.now[0]):\n                native_step(f,10.)\n                worker[0]=threading.Thread(target=e.poll_weapon)\n                worker[0].start()\n                try:\n                    self.assertTrue(sampled.wait(.5));f.now[0]=10.02;f.select_weapon(124,12)\n                    state=read_weapon_state(f.reader,f.frame.local.address)\n                    f.frame.weapon=state[\'classname\'];f.frame.ammo=state[\'ammo\'];f.frame.weapon_state=state\n                    d=native_step(f,10.02);self.assertTrue(f.control.pressed,d)\n                    before=len(f.native_writes)\n                finally:resume.set();worker[0].join(.5)\n            self.assertFalse(worker[0].is_alive());self.assertTrue(e.active)\n            self.assertEqual(e.weapon_snapshot()[\'handle\'],124)\n            self.assertEqual(len(f.native_writes),before)\n\n        def test_sampler_field_view_survives_main_reader_dictionary_rebuild(self):\n            f=weapon_fixture();e=f.control.trigger\n            # The production Reader methods access self.field_ok/resolved.\n            # Exercise those semantics on the detached read view.\n            e._weapon_reader.field_ok={\'m_hActiveWeapon\':True,\'m_iClip1\':True}\n            e._weapon_reader.fields_available=lambda *keys:all(e._weapon_reader.field_ok.get(key,False) for key in keys)\n            f.reader.field_ok={};f.reader.resolved={}\n            with patch(\'weapon_input_guard.time.monotonic\',side_effect=lambda:f.now[0]):e.poll_weapon()\n            self.assertTrue(e.weapon_snapshot()[\'valid\'])\n\n        def test_held_primary_released_on_native_binding_edit_or_menu(self):\n            for change in (\'binding\',\'menu\',\'right_up\',\'focus\'):\n                f=weapon_fixture();e=f.control.trigger\n                with patch(\'weapon_input_guard.time.monotonic\',side_effect=lambda:f.now[0]):\n                    native_step(f,10.);self.assertTrue(e.active)\n                    if change==\'binding\':f.native_binding[\'binding\']=\'lastinv\'\n                    elif change==\'menu\':f.reader.game_ui_visible=lambda:True\n                    elif change==\'right_up\':f.inputs.down=lambda key:False\n                    else:f.inputs.foreground=lambda pid:False\n                    e.poll_weapon();e.service_pending_release()\n                self.assertFalse(e.active,change);self.assertEqual(f.native_writes[-1],(0x90000,4))\n\n        def test_sampler_is_read_only_even_with_active_attack_and_weapon_change(self):\n            f=weapon_fixture();e=f.control.trigger\n            with patch(\'weapon_input_guard.time.monotonic\',side_effect=lambda:f.now[0]):\n                native_step(f,10.);self.assertTrue(e.active);f.select_weapon(124,12)\n                before=list(f.native_writes)\n                with patch.object(f.reader.mem,\'allow_write\',side_effect=AssertionError(\'sample opened write handle\')):\n                    e.poll_weapon()\n                self.assertEqual(f.native_writes,before);self.assertTrue(e.active)\n                self.assertEqual(e.weapon_snapshot()[\'handle\'],124)\n                e.service_pending_release();self.assertFalse(e.active)\n            self.assertEqual(f.native_writes[-1],(0x90000,4))\n\n        def test_background_input_owner_releases_after_read_only_sample(self):\n            f=weapon_fixture();e=f.control.trigger;released=threading.Event();old=f.reader.mem.write\n            def write(address,data):\n                old(address,data)\n                if address==0x90000 and struct.unpack(\'<I\',data)[0]==4:\n                    self.assertEqual(threading.current_thread().name,\'primary-input-owner\');released.set()\n            with patch(\'weapon_input_guard.time.monotonic\',side_effect=lambda:f.now[0]):\n                native_step(f,10.);f.reader.mem.write=write;f.select_weapon(124,12)\n                try:\n                    e.start_monitor();self.assertTrue(released.wait(.5));self.assertFalse(e.active)\n                finally:e.stop_monitor()\n            self.assertEqual(f.active_weapon[\'handle\'],124)\n\n        def test_read_only_monitor_stays_resident_when_aim_is_disabled(self):\n            f=weapon_fixture();e=f.control.trigger\n            with patch.object(e.aim_binding,\'step\',return_value=True),patch.object(e,\'start_monitor\') as start:\n                self.assertTrue(e.configure_aim(f.reader,False));start.assert_called_once()\n            self.assertTrue(e.verified);self.assertFalse(e.active);self.assertEqual(f.native_writes,[])\n\n    stream=io.StringIO()\n    result=unittest.TextTestRunner(stream=stream,verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(Tests))\n    print(stream.getvalue())\n    if not result.wasSuccessful():raise AssertionError(\'weapon/input owner regression failed\')\n    return dict(passed=True,tests=result.testsRun,real_controller_commit_engineattack=True,\n                simulated_memory=True,game_attached=False,game_input=False,live_behavior_verified=False)\n')
_EMBEDDED['aim_client_control'] = ('2026.10.07-aim-private-reader-evidence', '"""Fixed CLIENT target/camera/input control. ESP remains a separate SERVER reader."""\nimport math,struct,time\nfrom aim_reader import NotReady,MemoryError,Entity\nfrom aim_reader import AimReader\nfrom geometry import finite,add,length,sub\nfrom scale_geometry import client_scale_info,radius as scaled_radius\nfrom target_rules import entity_kind,is_enemy\nfrom model_support import UnsupportedModel\n\n\nclass AimClientControlReader(AimReader):\n    def __init__(self,game):\n        super().__init__(game)\n        self.source=\'client\';self.target_source=\'client\';self.source_epoch=0\n        self.control_scope=None;self.pipeline_metrics={}\n        from aim_pose_evidence import PoseEvidence\n        self.pose_evidence=PoseEvidence()\n\n    def target_entry(self,index):\n        if not isinstance(index,int) or not 0<index<32768:\n            raise NotReady(\'客户端目标索引无效\')\n        return self.global_addr(\'entity_entries\')+index*16\n\n    def read_entity(self,index,address,*args,**kwargs):\n        # The CLIENT serial/address pair surrounds the full read, including\n        # model/scale transforms; no SERVER target pointer enters this reader.\n        began=time.monotonic();entry=self.target_entry(index)\n        identity=self.mem.read(entry,8);current,serial=struct.unpack(\'<II\',identity)\n        if not address or current!=address:return None\n        result=self._read_body_entity(index,address,*args,**kwargs)\n        if result is not None and kwargs.get(\'with_bones\') is False and not result.dormant:\n            # Model identity is still checked; the independent control reader\n            # requests its own bones in ControlLoop and never consumes ESP.\n            from model_support import studio_header\n            wrapper=self.mem.u32(address+0x918)\n            if wrapper:\n                studio=self.mem.u32(wrapper)\n                if studio:result.model=studio_header(self.mem.read(studio,180))\n        if result is None or self.mem.read(entry,8)!=identity:return None\n        result.serial=serial;result.target_source=\'client\'\n        result.aim_geometry=\'client_model_hitboxes\';result.pose_sample_stamp=began\n        if result.pose_cache_evidence:\n            result.pose_cache_evidence=self.pose_evidence.observe(result,\n                (self.mem.pid,self.source_epoch))\n        return result\n\n    def _read_body_entity(self,index,p,with_bones=True,with_aimpoints=True,observe_inactive=False,with_inventory=True,bone_limit=None,_pose_retry=True,aim_key=None,control_context=None):\n        # Aim owns this body-only sampler. Shared Reader/ESP retain their original interface.\n        name=self.classname(p);kind=entity_kind(name);player=kind==\'player\'\n        if not kind or (kind==\'npc\' and not self.verify_npc(p)):return None\n        data=self.mem.read(p,0x1a10 if player else 0x1000)\n        health=struct.unpack_from(\'<i\',data,0x98)[0];team=struct.unpack_from(\'<i\',data,0xa0)[0]\n        reported_alive=data[0x97]==0 and 0<health<100000000\n        if not reported_alive and not (player and data[0x97] in (0,1,2) and\n                (health==1 or (observe_inactive and -100000000<health<100000000))):return None\n        if not 0<=team<256:return None\n        origin=struct.unpack_from(\'<3f\',data,0x300)\n        network_origin=struct.unpack_from(\'<3f\',data,0x3d0)\n        if not finite(origin) or length(sub(origin,network_origin))>4096:origin=network_origin\n        if not finite(origin):return None\n        e=Entity(index,p,name,team,health,origin,bool(data[0x21e]))\n        scale_info=client_scale_info(self,p,data)\n        e.reported_alive=reported_alive\n        e.geometry_scale=scale_info[\'maximum\']\n        e.geometry_body_scale=scale_info[\'body\']\n        e.geometry_head_scale=scale_info[\'head\']\n        e.geometry_scale_detected=scale_info[\'detected\']\n        if player:\n            if (health==1 or not reported_alive) and self.fields_available(\'m_hRagdoll\'):\n                handle=struct.unpack_from(\'<I\',data,0x1688)[0]\n                try:\n                    ragdoll=self.handle_entity(handle)\n                    e.ragdoll_present=bool(ragdoll and \'ragdoll\' in self.classname(ragdoll).lower())\n                except MemoryError:e.ragdoll_present=None\n            bounds=struct.unpack_from(\'<6f\',data,0x25c)\n            if finite(bounds) and all(0<bounds[i+3]-bounds[i]<scaled_radius(e.geometry_scale,1024.) for i in range(3)):\n                radius=math.hypot(max(abs(bounds[0]),abs(bounds[3])),max(abs(bounds[1]),abs(bounds[4])))+24.\n                envelope=max(1.,e.geometry_scale)\n                e.pose_bounds=(add(origin,(-radius*envelope,-radius*envelope,(bounds[2]-8.)*envelope)),add(origin,(radius*envelope,radius*envelope,(bounds[5]+32.)*envelope)))\n            e.zombie_class=struct.unpack_from(\'<i\',data,0x1794)[0]\n            velocity=struct.unpack_from(\'<3f\',data,0x198)\n            if finite(velocity) and length(velocity)<10000:e.velocity=velocity\n            e.flags=struct.unpack_from(\'<I\',data,0x3e8)[0]\n        else:\n            try:\n                owner=self.handle_entity(struct.unpack_from(\'<I\',data,0xf48)[0])\n                if owner and entity_kind(self.classname(owner))==\'player\':e.owner_team=self.mem.i32(owner+0xa0)\n            except MemoryError:pass\n        if player and e.health==1 and e.ragdoll_present is True:return e\n        if e.dormant:return e\n        if control_context is not None:\n            local_team,mode,enemy_team,free_for_all=control_context\n            enemy=is_enemy(e.classname,e.team,local_team,mode,enemy_team)\n            if not enemy_team and e.owner_team==local_team:enemy=False\n            if free_for_all and player and e.team>=2:enemy=True\n            if not enemy:return e\n        if with_bones and self.fields_available(\'bones\') and (bone_limit is None or length(sub(origin,bone_limit[0]))<=bone_limit[1] or health==1):\n            try:\n                meta=dict(_scale_info=scale_info,_geometry_scale=e.geometry_scale)\n                if aim_key is None:e.head,e.skeleton=self.bones(p,origin,data,meta,with_aimpoints)\n                else:e.head,e.skeleton=self.bones(p,origin,data,meta,with_aimpoints,aim_key=aim_key)\n                for key,value in meta.items():\n                    if not key.startswith(\'_\'):setattr(e,key,value)\n                if e.pose_bounds:\n                    from aim_geometry import point_in_actor\n                    points={point for segment in e.skeleton for point in segment}\n                    points.update(point.position for point in e.aim_points)\n                    if e.head:points.add(e.head)\n                    inside={point:point_in_actor(point,e) for point in points}\n                    e.skeleton=[(a,b) for a,b in e.skeleton if inside[a] and inside[b]]\n                    e.aim_points=[point for point in e.aim_points if inside[point.position]]\n                    e.aim_points_validated=bool(with_aimpoints)\n                    if e.head and not inside[e.head]:\n                        e.pose_diagnostic=dict(raw_head=e.head,origin=origin,network_origin=network_origin,\n                                               bounds=e.pose_bounds,reason=\'outside_actor_bounds\',retry=False)\n                        e.head=None;e.head_source=\'outside_actor_bounds\'\n                        now=time.monotonic()\n                        if _pose_retry and now>=self.pose_retry_after.get((index,p),0.):\n                            if len(self.pose_retry_after)>256:self.pose_retry_after.clear()\n                            self.pose_retry_after[(index,p)]=now+.1\n                            entry=self.global_addr(\'entity_entries\')+index*16\n                            expected=self.mem.read(entry,8)\n                            if struct.unpack(\'<II\',expected)[0]==p:\n                                current=self.read_entity(index,p,with_bones,with_aimpoints,observe_inactive,with_inventory,bone_limit,False,aim_key,control_context)\n                                if self.mem.read(entry,8)!=expected:return None\n                                if current is not None:\n                                    diagnostic=dict(e.pose_diagnostic,retry=True,recovered=current.head is not None)\n                                    if current.pose_diagnostic:diagnostic[\'after\']=current.pose_diagnostic\n                                    current.pose_diagnostic=diagnostic\n                                return current\n            except (MemoryError,ValueError,struct.error) as ex:\n                e.head=None;e.skeleton=[];e.aim_points=[];e.aim_hitboxes=()\n                e.head_source=\'model_unavailable\'\n                e.model=meta.get(\'model\',e.model)\n                e.pose_diagnostic=dict(model_support=\'unsupported\' if isinstance(ex,UnsupportedModel) else \'pending\',reason=str(ex))\n        return e\n\n    def frame(self,*args,**kwargs):\n        began=time.monotonic();self.pipeline_metrics={}\n        kwargs.setdefault(\'control_only\',True)\n        kwargs.setdefault(\'with_bones\',False)\n        kwargs.setdefault(\'observe_inactive\',True)\n        frame=super().frame(*args,**kwargs)\n        scope=(self.mem.pid,frame.map_name,frame.local.index,frame.local.address,frame.local.serial)\n        if scope!=self.control_scope:\n            self.control_scope=scope;self.source_epoch+=1\n        frame.source=frame.target_source=frame.local_source=\'client\'\n        frame.source_epoch=self.source_epoch\n        # Reader\'s population cache may predate a slot reuse. Never publish\n        # geometry under that cached serial, even if its address was reused.\n        retained=[]\n        for entity in frame.entities:\n            try:\n                if self.mem.read(self.target_entry(entity.index),8)==struct.pack(\'<II\',entity.address,entity.serial):\n                    retained.append(entity)\n            except MemoryError:pass\n        frame.entities=retained\n        self.control_identity(frame)\n        self.pipeline_metrics.update(client_frame_ms=(time.monotonic()-began)*1000)\n        self.entity_stats.update(source=\'client\',client_targets=True,server_targets=False,\n                                 esp_source=\'server\',source_epoch=self.source_epoch)\n        return frame\n\n    def read_aim_entity(self,index,address,point_key):\n        # The final ray uses one selected point plus ALL current hitboxes for\n        # hitgroup ordering. Do not rebuild the other 47 aim samples here.\n        return self.read_entity(index,address,with_inventory=False,aim_key=point_key)\n\n    def control_identity(self,frame):\n        if frame.source!=\'client\' or frame.source_epoch!=self.source_epoch:\n            raise NotReady(\'等待当前客户端目标帧\')\n        if self.mem.string(self.global_addr(\'level_name\'),160).replace(\'\\\\\',\'/\')!=frame.map_name:\n            raise NotReady(\'客户端地图已变化\')\n        super().control_identity(frame)\n\n    def close(self):\n        try:super().close()\n        finally:\n            self.control_scope=None\n            self.source_epoch=getattr(self,\'source_epoch\',0)+1\n            if hasattr(self,\'pose_evidence\'):self.pose_evidence.rows.clear()\n')
_EMBEDDED['aim_decision'] = ('2026.10.07-rmb-current-ray-preparation', '"""Aim-owned point selection and obstacle-signal consumption."""\nimport math\nimport struct\nfrom collections import Counter\nfrom geometry import finite, aim_angles, angle_error, dot, length, sub, view_direction, project\n\nMAX_TARGET_AGE = .12\nSERVER_ENTITY_TABLE = 0xa5fa44\nPARTS = (\'head\', \'torso\', \'pelvis\', \'body\', \'arm\', \'leg\', \'eye\')\n\n\ndef state(value):\n    return value if value in (\'visible\', \'penetrable\') else \'blocked\'\n\n\ndef public_path(visibility, detail=None, *, allow_blocked=False):\n    verdict = state(visibility)\n    return dict(kind=\'visible\' if verdict == \'visible\' else \'penetration\' if verdict == \'penetrable\' else \'blocked\',\n                allowed=verdict != \'blocked\' or allow_blocked,\n                basis=\'obstacle_positive_signal\' if verdict == \'penetrable\' else \'aim_native_ray\',\n                forced_blocked=verdict == \'blocked\' and allow_blocked)\n\n\ndef point_reachable(point, allow_penetration=True, *, allow_blocked=False):\n    return state(point.visibility) != \'blocked\' or allow_blocked\n\n\ndef selection_tier(visibility, *args, **kwargs):\n    return 0 if visibility == \'visible\' else 2 if visibility == \'penetrable\' else 3\n\n\ndef signal_for(reader, frame, actor, packet, now):\n    """Check message identity only. Obstacle geometry is owned by the producer."""\n    if not isinstance(packet, dict):\n        return None, \'format\'\n    context = packet.get(\'context\') or {}\n    signals = packet.get(\'signals\') or {}\n    if not isinstance(context, dict) or not isinstance(signals, dict):\n        return None, \'format\'\n    raw = signals.get(str(actor.index), signals.get(actor.index))\n    if raw is None:\n        return None, \'absent\'\n\n    def identity(current, expected):\n        if (not isinstance(expected, (list, tuple)) or len(expected) != 3 or\n                any(type(v) is not int for v in expected) or expected[0] != current.index):\n            return False\n        index, address, serial = expected\n        if (address, serial) == (current.address, current.serial):\n            return True\n        # The obstacle worker may publish SERVER identity; verify both tables.\n        try:\n            sender = reader.mods[\'server.dll\'][0] + SERVER_ENTITY_TABLE + index * 16\n            receiver = reader.global_addr(\'entity_entries\') + index * 16\n            return (struct.unpack(\'<II\', reader.mem.read(sender, 8)) == (address, serial) and\n                    struct.unpack(\'<II\', reader.mem.read(receiver, 8)) == (current.address, current.serial))\n        except (OSError, ValueError, KeyError, AttributeError, struct.error):\n            return False\n\n    if (context.get(\'pid\') != reader.mem.pid or context.get(\'map\') != frame.map_name or\n            context.get(\'weapon\', frame.weapon) != frame.weapon or\n            not identity(frame.local, context.get(\'local_identity\'))):\n        return None, \'session\'\n    if not isinstance(raw, dict) or raw.get(\'penetrable\') is not True:\n        return None, \'not_positive\'\n    if not identity(actor, [actor.index, raw.get(\'address\'), raw.get(\'serial\')]):\n        return None, \'identity\'\n    model_key = lambda value: str(value or \'\').replace(\'\\\\\', \'/\').lower()\n    if model_key(raw.get(\'model\', actor.model)) != model_key(actor.model):\n        return None, \'model\'\n    stamp = raw.get(\'display_evidence_stamp\', raw.get(\'stamp\'))\n    if stamp is not None and (type(stamp) not in (int, float) or not math.isfinite(stamp) or stamp > now):\n        return None, \'stamp\'\n    # The producer keeps or revokes its bit. Its point names/XYZ do not gate\n    # this actor\'s independently measured bones and never supply aim XYZ.\n    return dict(raw, age_ms=(now-stamp)*1000 if stamp is not None else raw.get(\'age_ms\', 0.)), \'\'\n\n\ndef signal_point(actor, signal, eye):\n    from aim_geometry import candidate_points\n    points = candidate_points(actor)\n    if not points:\n        return None, \'missing_current_bones\'\n    key = signal.get(\'display_point_key\')\n    exact = next((p for p in points if p.key == key), None)\n    if exact is not None:\n        return exact, \'exact_key\'\n    part = signal.get(\'display_point_part\')\n    if part not in PARTS and isinstance(key, str):\n        part = next((p for p in PARTS if key == p or key.endswith(\':\' + p)), None)\n    same = [p for p in points if p.part == part or part == \'eye\' and p.part == \'head\']\n    pool = same or points\n    point = min(pool, key=lambda p: (p.part != \'head\', \':eye:\' in p.key,\n                                    not p.key.endswith(\':c\'), -float(p.radius), p.priority, p.key))\n    return point, \'same_part\' if same else \'current_bone\'\n\n\ndef apply_positive_signals(reader, frame, packet, now):\n    packet=packet if isinstance(packet,dict) else {}\n    rejected = Counter(); matches = []; applied = 0\n    for actor in frame.entities:\n        signal, reason = signal_for(reader, frame, actor, packet, now)\n        if signal is None:\n            if reason != \'absent\': rejected[reason] += 1\n            continue\n        point, method = signal_point(actor, signal, frame.eye)\n        if point is None:\n            rejected[method] += 1\n            continue\n        # A transport hint can guide which current point to use, but it is\n        # never another penetration test and cannot reject a valid actor bit.\n        actor.display_penetration = dict(signal, display_point_key=point.key,\n            display_point_part=point.part, display_ray_head=tuple(point.position),\n            display_ray_eye=tuple(frame.eye), control_signal_owner=\'obstacle_module\')\n        actor.visibility = \'penetrable\'; actor.wall_penetrable = True\n        point.visibility = \'penetrable\'; point.penetrable = True\n        point.penetration = public_path(\'penetrable\')\n        applied += 1\n        matches.append(dict(index=actor.index, method=method, source_key=signal.get(\'display_point_key\'),\n                            current_key=point.key, part=point.part))\n    context = packet.get(\'context\') or {}\n    context=context if isinstance(context,dict) else {}\n    def age(key):\n        value = context.get(key)\n        return (now-value)*1000 if type(value) in (int, float) and math.isfinite(value) and value <= now else None\n    return dict(applied=applied, positive_bits=applied, rejected=dict(rejected), match_methods=matches[:16],\n                penetration_activated=bool(applied), interface=\'one_bit\', policy=\'direct_actor_signal\',\n                secondary_penetration_checks=0, worker_to_render_ms=age(\'result_finished_at\'),\n                receiver_to_render_ms=age(\'result_received_at\'))\n\n\ndef ray_rank_context(frame, target):\n    """Current actor geometry, shared only within one point-ranking pass."""\n    from aim_geometry import candidate_points\n    eye = tuple(frame.eye)\n    direction = view_direction(frame.angles)\n    distance = length(sub(target.origin, frame.local.origin))\n    if not finite((*eye, *direction)) or not math.isfinite(distance):\n        raise ValueError(\'invalid_current_ray_geometry\')\n    boxes = getattr(target, \'aim_hitboxes\', ())\n    if boxes:\n        ray = tuple(v*1e8 for v in direction)\n        hit = any(b.intersection(eye, ray) is not None for b in boxes)\n    else:\n        hit = False\n        for sample in candidate_points(target):\n            offset = sub(sample.position, eye); along = dot(offset, direction)\n            radius = float(sample.radius)\n            if along <= 0 or not math.isfinite(radius) or radius <= 0: continue\n            if length(tuple(offset[i]-along*direction[i] for i in range(3))) <= radius:\n                hit = True; break\n    return eye, direction, distance, hit\n\n\ndef ray_nearest_key(frame, target, *, index=None, point=None, ray_context=None, angular_error=None):\n    """Order this control process\'s current bones along the user\'s sight ray."""\n    identity = target.index if index is None else index\n    invalid = (2, math.inf, math.inf, identity)\n    try:\n        point = tuple(target.head if point is None else point)\n        eye, direction = ray_context[:2] if ray_context is not None else (tuple(frame.eye), view_direction(frame.angles))\n        delta = sub(point, eye)\n        if len(point) != 3 or len(eye) != 3 or not finite((*delta, *direction)):\n            return invalid\n        forward = dot(delta, direction)\n        if forward <= 0: return invalid\n        _, _, distance, hit = ray_context if ray_context is not None else ray_rank_context(frame, target)\n        error = angular_error if angular_error is not None else angle_error(frame.angles, aim_angles(eye, point))\n        return (0, distance, forward, identity) if hit else (1, error, distance, identity)\n    except (AttributeError, TypeError, ValueError, OverflowError, IndexError):\n        return invalid\n\n\ndef acquisition_key(frame, target, cfg, weapon, *, point=None, ray_context=None):\n    from weapon_profiles import is_firearm\n    position = target.head if point is None else point\n    distance = length(sub(position, frame.eye))\n    error = angle_error(frame.angles, aim_angles(frame.eye, position))\n    reason = \'\'\n    if cfg.fire and is_firearm(weapon) and not 0 < distance <= float((weapon or {}).get(\'Range\', 8192.)):\n        reason = \'outside_weapon_range\'\n    elif cfg.screen_acquire:\n        screen = project(position, frame.matrix, 2, 2)\n        if screen is None or not (0 <= screen[0] <= 2 and 0 <= screen[1] <= 2):\n            reason = \'outside_screen\'\n    elif error > cfg.fov:\n        reason = \'outside_fov\'\n    key = ray_nearest_key(frame, target, index=target.index, point=position,\n        ray_context=ray_context, angular_error=error)\n    if not reason and key[0] == 2:\n        reason = \'outside_