i in range(3)):return ()\n            factor=head_factor if group==1 and head_factor is not None else body_factor\n            matrix,scales,_=pose_transform(blob,bone,origin,factor,cache)\n            axes=[tuple(matrix[j*4+i] for j in range(3)) for i in range(3)]\n            position=(matrix[3],matrix[7],matrix[11])\n            if not finite(matrix) or min(scales)<=0 or not point_valid(position,origin,scale):return ()\n            if any(abs(sum(a*b for a,b in zip(axes[i],axes[j])))>1e-3*scales[i]*scales[j]\n                   for i in range(3) for j in range(i)):return ()\n            inverse=tuple(tuple(v/(scales[i]**2) for v in axis) for i,axis in enumerate(axes))\n            result.append(PoseHitbox((tuple(bounds[:3]),tuple(bounds[3:])),position,inverse,scales,group))\n        return tuple(result)\n    rng=random.Random(71007);valid=invalid=0\n    for iteration in range(400):\n        matrices=[];boxes=[];origin=(10000.,-10000.,100.)\n        for bone in range(6):\n            angle=rng.uniform(-math.pi,math.pi);c=math.cos(angle);s=math.sin(angle)\n            sx,sy,sz=[rng.uniform(.1,4.) for _ in range(3)]\n            matrix=[c*sx,-s*sy,0.,origin[0],s*sx,c*sy,0.,origin[1],0.,0.,sz,origin[2]+bone*5.]\n            if iteration%5==0:matrix[8]=.01\n            if iteration%11==0:matrix[0]=float(\'nan\')\n            if iteration%13==0:matrix[0]=matrix[4]=matrix[8]=0.\n            matrices.extend(matrix);boxes.append((bone,1 if bone==5 else 2,(-3.,-2.,-1.,3.,2.,1.)))\n        blob=struct.pack(\'<\'+str(len(matrices))+\'f\',*matrices)\n        expected=reference(boxes,blob,origin,4.,1.2,2.)\n        actual=world_hitboxes(boxes,blob,origin,4.,1.2,2.)\n        assert actual==expected,(\'current hitboxes changed\',iteration)\n        valid+=bool(actual);invalid+=not actual\n    return dict(current_poses=400,valid=valid,invalid=invalid,rotated_scaled_sheared=True)\n\n\ndef sampled_body_fire():\n    from aim_scope_fixture import Fixture\n    cases=[]\n    for force 