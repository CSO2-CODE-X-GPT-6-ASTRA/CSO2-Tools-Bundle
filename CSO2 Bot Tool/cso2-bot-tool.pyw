el\n    from esp_pipeline import FrameVisibility\n    from overlay_service import decode_config\n    from presentation import TimerResolution\n    k=kernel();parent=None;requests=replies=None;timer=TimerResolution()\n    visibility=provider if provider is not None else FrameVisibility(game)\n    try:\n        requests=LatestMailbox(tag+\'_request\');replies=LatestMailbox(tag+\'_reply\')\n        parent=k.OpenProcess(0x100000,False,int(parent_pid))\n        if not parent:return\n        timer.set_active(True);pending=None\n        while k.WaitForSingleObject(parent,0)==0x102:\n            if pending is not None and replies.write(pending):pending=None\n            payload=requests.read_latest()\n            if payload is None:\n                k.WaitForSingleObject(requests.event,10 if pending is not None else 100)\n                continue\n            request=_decode_visibility(payload)\n            if request.get(\'close\'):break\n            frame=request[\'frame\'];sequence=request[\'sequence\']\n            # A queued request is never stamped as new. Skip only the ray job,\n            # not the renderer\'s current actor or any of its drawn elements.\n            if not 0<=time.monotonic()-frame.stamp<=.09:continue\n            try:reply=_visibility_reply(frame,decode_config(request[\'cfg\']),sequence,visibility)\n            except Exception as ex:\n                reply=dict(sequence=sequence,scope=_visibility_scope(frame),stamp=frame.stamp,\n                    completed_at=time.monotonic(),actors=[],targets={},\n                    metrics=dict(state=\'unavailable\',error=type(ex).__name__+\': \'+str(ex)))\n            pending=pickle.dumps(reply,protocol=5)\n            if replies.write(pending):pending=None\n    finally:\n        visibility.close();timer.close()\n        for box in (requests,replies):\n            if box is not None:box.close()\n        if parent:k.CloseHandle(parent)\n\n\nclass ProcessVisibility:\n    """Render current geometry immediately; accept the newest bounded ray state.\n\n    The sole retained value is the latest completed status packet. It never\n    supplies render coordinates. Target consumers receive the original tested\n    points/eye/timestamps once per completed batch, after the surface is drawn.\n    """\n    def __init__(self,game):\n        self.game=game;self.closed=False;self.proc=None;self.requests=self.replies=None\n        self.next_start=0.;self.started=0.;self.last_reply=0.;self.sequence=0\n        self.accepted_sequence=0;self.published_sequence=0;self.latest=None;self.scope=None\n        self.metrics={};self.error=\'\';self.restarts=0\n\n    def _start(self):\n        import os,subprocess,uuid\n        from esp_transport import LatestMailbox\n        from cso2_bot_tool import BUNDLE_ENTRY\n        self.tag=\'Local\\\\CSO2_NATIVE_VIS_\'+str(os.getpid())+\'_\'+uuid.uuid4().hex\n        self.requests=LatestMailbox(self.tag+\'_request\',create=True)\n        try:\n            self.replies=LatestMailbox(self.tag+\'_reply\',create=True)\n            self.proc=subprocess.Popen([sys.executable,\'-X\',\'utf8\',\'-u\',str(BUNDLE_ENTRY),\n                \'--native-ray-worker\',str(self.game),self.tag,str(os.getpid())],\n                stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,\n                creationflags=subprocess.CREATE_NO_WINDOW)\n        except Exception:\n            self._close_boxes();raise\n        self.started=time.monotonic();self.last_reply=0.;self.restarts+=1\n\n    def _close_boxes(self):\n        for name in (\'requests\',\'replies\'):\n            box=getattr(self,name)\n            if box is not None:box.close();setattr(self,name,None)\n\n    def _exchange(self,frame,cfg):\n        import pickle\n        now=time.monotonic()\n        if self.proc is not None and self.proc.poll() is not None:\n            self.proc=None;self.latest=None;self._close_boxes();self.next_start=now+.25\n        if self.proc is None:\n            if now<self.next_start:return\n            self.next_start=now+1.\n            self._start()\n        payload=self.replies.read_latest()\n        if payload is not None:\n            self.last_reply=now;reply=_decode_visibility(payload)\n            if (reply.get(\'scope\')==self.scope and type(reply.get(\'sequence\')) is int\n                    and self.accepted_sequence<reply[\'sequence\']<=self.sequence\n                    and 0<=now-reply.get(\'stamp\',-1)<=.09):\n                self.latest=reply;self.accepted_sequence=reply[\'sequence\'];self.error=\'\'\n        if now-(self.last_reply or self.started)>(2. if self.last_reply else 30.):\n            self.latest=None;self.error=\'native ray worker reply timeout\'\n            self.proc.terminate();return  # Poll/recreate later; never wait in draw.\n        self.sequence+=1\n        self.requests.write(pickle.dumps(dict(sequence=self.sequence,frame=frame,cfg=vars(cfg)),protocol=5))\n\n    def update(self,frame,cfg):\n        from esp_feedback import normalize_obstacle_signal\n        from esp_pipeline import identity,display_alive,combat_display_actor\n        scope=_visibility_scope(frame)\n        if scope!=self.scope:self.scope=scope;self.latest=None\n        if self.closed:return\n        try:self._exchange(frame,cfg)\n        except Exception as ex:self.error=type(ex).__name__+\': \'+str(ex)\n        now=time.monotonic();reply=self.latest\n        if reply is not None and not 0<=now-reply[\'stamp\']<=.09:self.latest=None;reply=None\n        statuses={tuple(row[\'identity\']):row for row in reply[\'actors\']} if reply and cfg.walls else {}\n        accepted=positive=0\n        for entity in frame.entities:\n            signal=normalize_obstacle_signal(getattr(entity,\'display_penetration\',None),now=now)\n            entity.visibility=\'blocked\';entity.wall_age_ms=None;entity.display_visibility_stamp=0.\n            entity.esp_visible_points=();entity.esp_reverse_sight=False;entity.esp_reverse_sight_stamp=0.\n            entity.display_penetration={};entity.wall_penetrable=False;entity.penetration={}\n            for point in entity.aim_points:point.visibility=\'blocked\';point.penetrable=False\n            if not combat_display_actor(entity) or not display_alive(entity) or entity.dormant:continue\n            row=statuses.get(identity(entity))\n            if row and row[\'source\']==(getattr(entity,\'display_source\',\'\') or frame.source):\n                stamp=row[\'stamp\']\n                if row[\'visibility\'] in (\'visible\',\'blocked\') and 0<=now-stamp<=.09:\n                    entity.visibility=row[\'visibility\'];entity.display_visibility_stamp=stamp\n                    entity.wall_age_ms=(now-stamp)*1000\n                    entity.esp_visible_points=row[\'points\'] if row[\'visibility\']==\'visible\' else ()\n                    reverse_stamp=row.get(\'reverse_stamp\',0.)\n                    if 0<=now-reverse_stamp<=.09:\n                        entity.esp_reverse_sight=row.get(\'reverse_sight\') is True\n                        entity.esp_reverse_sight_stamp=reverse_stamp\n                    accepted+=1\n            if signal is not None:\n                entity.display_penetration=signal;positive+=1\n                if entity.visibility==\'blocked\':entity.visibility=\'penetrable\'\n        provider_metrics=reply[\'metrics\'] if reply else {}\n        provider_state=provider_metrics.get(\'state\',\'awaiting_ray_result\')\n        self.metrics=dict(provider_metrics,transport=\'native_ray_process_latest\',\n            state=provider_state,accepted=accepted,\n            worker_pid=getattr(self.proc,\'pid\',None),worker_alive=self.proc is not None and self.proc.poll() is None,\n            worker_starts=self.restarts,result_sequence=self.accepted_sequence,\n            result_age_ms=(now-reply[\'stamp\'])*1000 if reply else None,\n            render_waits_for_rays=False,render_geometry=\'current_sample\',request_backlog_limit=1,\n            display_status_max_age_ms=90.,ray_result_matches_render_geometry=False,\n            obstacle_signal=dict(interface=\'one_bit\',positive=positive),\n            error=self.error or provider_metrics.get(\'error\',\'\'))\n\n    def publication(self,frame,pid,now):\n        import copy\n        from esp_pipeline import identity,display_alive\n        from esp_feedback import normalize_obstacle_signal,native_points\n        reply=self.latest\n        if (reply is None\n                or reply[\'scope\']!=_visibility_scope(frame) or not 0<=now-reply[\'stamp\']<=.09):return None\n        packet=copy.deepcopy(reply[\'targets\'])\n        if not packet:\n            if reply[\'sequence\']<=self.published_sequence:return None\n            self.published_sequence=reply[\'sequence\'];return {}\n        # Preserve the measured points and camera. Only remove actors that no\n        # longer exist/alive in the current render sample; never move old points.\n        alive={identity(e):e\n               for e in frame.entities if display_alive(e) and not e.dormant}\n        packet[\'actors\']=[e for e in packet[\'actors\'] if tuple(e[\'identity\']) in alive\n                          and (getattr(alive[tuple(e[\'identity\'])],\'display_source\',\'\') or frame.source)==e[\'source\']]\n        positives=[]\n        for actor in packet[\'actors\']:\n            # Only the current bridge owns penetration. The ray worker may\n            # echo a previous request\'s bit; revalidate it before publishing.\n            for point in actor[\'points\']:\n                if point[\'visibility\']==\'penetrable\':point[\'visibility\']=\'blocked\'\n            if actor[\'visibility\']==\'penetrable\':\n                actor[\'visibility\']=\'visible\' if any(p[\'visibility\']==\'visible\' for p in actor[\'points\']) else \'blocked\'\n            entity=alive[tuple(actor[\'identity\'])]\n            signal=normalize_obstacle_signal(getattr(entity,\'display_penetration\',None),now=now)\n            if signal is None:continue\n            stamp=signal.get(\'display_evidence_stamp\')\n            if stamp is None:continue\n            endpoint=tuple(signal.get(\'display_ray_head\',()))\n            joint=signal.get(\'display_point_key\')\n            if joint:\n                if joint not in (point.key for point in native_points(entity)):continue\n            elif (tuple(signal.get(\'display_ray_eye\',()))!=tuple(packet[\'eye\']) or\n                  endpoint not in (tuple(point.position) for point in native_points(entity))):continue\n            for point in actor[\'points\']:\n                if point[\'visibility\']==\'blocked\' and (point[\'key\']==joint if joint else tuple(point[\'position\'])==endpoint):\n                    point[\'visibility\']=\'penetrable\'\n                    if actor[\'visibility\']==\'blocked\':actor[\'visibility\']=\'penetrable\'\n                    positives.append((tuple(actor[\'identity\']),point[\'key\'],stamp))\n        publication_key=(reply[\'sequence\'],tuple(positives))\n        if (reply[\'sequence\']<=self.published_sequence\n                and publication_key==getattr(self,\'last_publication_key\',None)):return None\n        self.published_sequence=reply[\'sequence\'];self.last_publication_key=publication_key\n        packet[\'published_at\']=now\n        return packet\n\n    def close(self):\n        import pickle\n        if self.closed:return\n        self.closed=True\n        if self.proc is not None:\n            try:\n                if self.requests:self.requests.write(pickle.dumps(dict(close=True),protocol=5))\n                self.proc.wait(timeout=1.)\n            except Exception:\n                self.proc.terminate()\n                try:self.proc.wait(timeout=.5)\n                except Exception:self.proc.kill();self.proc.wait(timeout=.5)\n        self._close_boxes();self.latest=None\n')
_EMBEDDED['native_ray_contract'] = (1, '"""Native ESP boundary regressions. Fixtures never attach to a game."""\nimport copy, io, unittest\nfrom types import SimpleNamespace as NS\nfrom unittest.mock import patch\n\n\nclass ReplyFixture:\n    def __init__(self,select):self.select=select;self.calls=0;self.fail=False\n    def trace(self,frame,rows):\n        self.calls+=1\n        if self.fail:raise RuntimeError(\'fixture native ray failure\')\n        replies=[]\n        for key,origin,points in rows:\n            clear=list(self.select(frame,key,points))\n            replies.append([key,origin,frame.eye,frame.stamp,\'visible\' if clear else \'blocked\',clear])\n        return replies,dict(rays=sum(len(row[2]) for row in rows),targets=len(rows),native_connected=True)\n    def close(self):pass\n\n\nclass GeometryFixture:\n    """Historical geometric scenarios injected explicitly by offline tests."""\n    def __init__(self,frame,bsp):self.map_name=frame.map_name;self.bsp=bsp;self.fail=False\n    def trace(self,frame,rows):\n        from esp_geometry_fixture import trace_frame\n        if self.fail or self.bsp is None or frame.map_name!=self.map_name:raise RuntimeError(\'fixture ray unavailable\')\n        results,metrics=trace_frame(self.bsp,dict(stamp=frame.stamp,eye=frame.eye,entities=rows))\n        for row in results:\n            if row[4]==\'blocked\':row[5]=[]\n        return results,metrics\n    def close(self):pass\n\n\ndef run():\n    import ast, inspect, threading\n    import esp_pipeline as ep\n    from native_ray_service import NativeRayService,NativeRayUnavailable,decode_batch\n    from esp_skeleton_rules import fixture\n    from cso2_bot_tool import Config\n    class Tests(unittest.TestCase):\n        def test_legacy_geometry_is_not_executable_or_path_selected(self):\n            names=(\'load_display_map\',\'trace_frame\',\'blocking_brush\',\'_FixtureRayProvider\')\n            self.assertFalse(any(hasattr(ep,name) for name in names))\n            for g