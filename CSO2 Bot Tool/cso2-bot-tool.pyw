ot force and now<self.next_capabilities:\n            pending=self.compatibility.get(\'module_refresh\',{})\n            if pending.get(\'status\')==\'retrying\':raise NotReady(\'模块读取暂不可用，将自动重试：\'+pending[\'error\'])\n            return self.capabilities\n        self.next_capabilities=now+.5\n        # Runtime failures are observations, not permanent switches. Reprobe\n        # only the failed feature after its cooldown, preserving user settings.\n        for key,deadline in list(self.feature_retry_after.items()):\n            if now>=deadline:\n                self.capability_failures.pop(key,None);self.feature_retry_after.pop(key,None)\n        try:current=self.module_provider(self.mem.pid)\n        except (MemoryError,OSError) as ex:\n            self.compatibility[\'module_refresh\']={\'status\':\'retrying\',\'error\':str(ex)}\n            # Retain the read-only connection and retry next cycle; never\n            # continue control on unobserved modules or discard user settings.\n            raise NotReady(\'模块读取暂不可用，将自动重试：\'+str(ex)) from ex\n        if any(current.get(name)!=self.mods.get(name) for name in (\'client.dll\',\'engine.dll\')):\n            raise NotReady(\'客户端模块已变化，请重新连接\')\n        self.compatibility[\'module_refresh\']={\'status\':\'ready\'}\n        self.mods=current;self.resolved={};self.resolve_addresses();self.verify_structures()\n        from feature_caps import capabilities\n        self.capabilities=capabilities(self)\n        self.compatibility[\'features\']=self.capabilities\n        return self.capabilities\n    def require_feature(self,key):\n        from feature_caps import probe\n        try:probe(self,key)\n        except Exception as ex:\n            self.capabilities[key]={\'available\':False,\'reason\':str(ex)}\n            raise NotReady(str(ex)) from ex\n    def close(self):\n        self.__dict__.pop(\'_c4_layouts\',None)\n        self.pose_retry_after.clear()\n        self.feature_retry_after.clear();self.capability_failures.clear()\n        if self.mem:self.mem.close();self.mem=None\n        self.class_cache.clear();self.model_cache.clear();self.table_cache.clear();self.entity_scan=[];self.last_scan=0;self.slot_cache.clear()\n        self.inventory_cache.clear()\n        self.throwable_classes.clear()\n        self.throw_states.clear()\n        self.pose_activity.tracks.clear()\n        self.menu=MenuState(self)\n        self.hazard_reader=None;self.hazard_retry=0.\n        self.resolved={};self.native_mode=NativeMode(self);self.capabilities={};self.field_ok={};self.next_capabilities=0.\n    def game_ui_visible(self):\n        return self.menu.visible()\n    def global_addr(self,name):\n        try:return self.resolved[name]\n        except KeyError:raise NotReady(\'地址尚未动态验证：\'+name)\n    def camera_matrix(self):\n        # External sampling must use the primary world view. The getter\'s\n        # nested branch can momentarily refer to a shadow/secondary render pass.\n        matrix=struct.unpack(\'<16f\',self.mem.read(self.global_addr(\'render\')+0x9c,64))\n        if not finite(matrix) or sum(abs(x) for x in matrix)<.1:raise NotReady(\'屏幕投影矩阵尚未就绪\')\n        return matrix\n    def entity_address(self,index):\n        if not 0<=index<65536:return 0\n        return self.mem.u32(self.global_addr(\'entity_entries\')+index*16)\n    def handle_entity(self,handle):\n        if handle==0xffffffff:return 0\n        index=handle&0xffff\n        if index>=32768:return 0\n        addr=self.global_addr(\'entity_entries\')+index*16\n        p,serial=struct.unpack(\'<II\',self.mem.read(addr,8))\n        return p if serial==handle>>16 else 0\n    def classname(self,p):\n        vt=self.mem.u32(p+8)\n        if vt in self.class_cache:return self.class_cache[vt]\n        fn=self.mem.u32(vt+8);code=self.mem.read(fn,6)\n        if code[0]!=0xb8 or code[5]!=0xc3:raise MemoryError(\'无法识别网络类 getter\')\n        cc=struct.unpack_from(\'<I\',code,1)[0]\n        name=self.mem.string(self.mem.u32(cc+8),100)\n        if not name or any(ord(c)<32 for c in name):raise MemoryError(\'网络类名称无效\')\n        self.class_cache[vt]=name\n        return name\n    def is_throwable_weapon(self,p):\n        """Use the inherited grenade table, including renamed/custom weapons."""\n        m=self.mem;vt=m.u32(p+8)\n        if vt in self.throwable_classes:return self.throwable_classes[vt]\n        name=self.classname(p).lower()\n        if \'projectile\' in name:return False\n        fn=m.u32(vt+8);code=m.read(fn,6)\n        if code[0]!=0xb8 or code[5]!=0xc3:return False\n        table=m.u32(struct.unpack_from(\'<I\',code,1)[0]+12);seen=set();result=False\n        while table and table not in seen and len(seen)<20:\n            seen.add(table)\n            if m.string(m.u32(table+12),96)==\'DT_BaseCSGrenade\':result=True;break\n            ptr,count=struct.unpack(\'<Ii\',m.read(table,8))\n            if not 0<count<=1024:raise MemoryError(\'投掷物继承表无效\')\n            blob=m.read(ptr,count*60);table=0\n            for i in range(count):\n                at=i*60\n                if struct.unpack_from(\'<i\',blob,at+4)[0]!=6:continue\n                if m.string(struct.unpack_from(\'<I\',blob,at)[0],96)==\'baseclass\':\n                    table=struct.unpack_from(\'<I\',blob,at+40)[0];break\n        self.throwable_classes[vt]=result\n        return result\n    def verify_npc(self,p,hostage=False):\n        """Check each combat class\'s actual inherited RecvTable before reading."""\n        vt=self.mem.u32(p+8)\n        cache_key=(vt,hostage)\n        if cache_key in self.table_cache:return self.table_cache[cache_key]\n        m=self.mem;fn=m.u32(vt+8);code=m.read(fn,6)\n        if code[0]!=0xb8 or code[5]!=0xc3:return False\n        cc=struct.unpack_from(\'<I\',code,1)[0];props={}\n        def walk(table,base=0,chain=()):\n            if not table or table in chain or len(chain)>16:return\n            ptr,n=struct.unpack(\'<Ii\',m.read(table,8))\n            if not 0<n<=1024:return\n            blob=m.read(ptr,n*60)\n            for i in range(n):\n                a=i*60;name=m.string(struct.unpack_from(\'<I\',blob,a)[0],96)\n                offset=base+struct.unpack_from(\'<i\',blob,a+44)[0]\n                if not 0<=offset<0x10000:continue\n                props[name]=offset\n                if struct.unpack_from(\'<i\',blob,a+4)[0]==6:\n                    walk(struct.unpack_from(\'<I\',blob,a+40)[0],offset,chain+(table,))\n        walk(m.u32(cc+12))\n        expected={\'m_iHealth\':0x98,\'m_lifeState\':0x97,\'m_iTeamNum\':0xa0,\'m_vecOrigin\':0x3d0,\'m_nHitboxSet\':0x5e0}\n        if hostage:expected.update(m_vecMins=0x25c,m_vecMaxs=0x268,m_isRescued=0xf34)\n        valid=all(props.get(k)==v for k,v in expected.items())\n        self.table_cache[cache_key]=valid\n        return valid\n    def bones(self,p,origin,entity_data=None,metadata=None,with_aimpoints=True,with_hitboxes=False,aim_key=None):\n        m=self.mem\n        bone_snapshot=metadata.pop(\'_bone_snapshot\',None) if metadata is not None else None\n        scale_info=metadata.pop(\'_scale_info\',None) if metadata else None\n        geometry_scale=metadata.pop(\'_geometry_scale\',None) if metadata else None\n        supplied_scale=scale_info is not None\n        if scale_info is None:\n            scale_info=client_scale_info(self,p,entity_data)\n        if geometry_scale is None:\n            geometry_scale=scale_info[\'maximum\']\n        # Older fixtures expose only one scalar probe. Preserve that fallback,\n        # but avoid a second RecvTable walk for normal live entities.\n        if not supplied_scale and abs(scale_info[\'maximum\']-1.)<=1e-4:\n            scalar=client_scale(self,p,entity_data)\n            if abs(scalar-1.)>1e-4:\n                scale_info=dict(scale_info,body=scalar,head=scalar,maximum=scalar,detected=True)\n                geometry_scale=scalar\n        studio_wrapper=struct.unpack_from(\'<I\',entity_data,0x918)[0] if entity_data else m.u32(p+0x918)\n        if not studio_wrapper:\n            if metadata is not None:metadata[\'pose_diagnostic\']=dict(model_support=\'pending\',reason=\'model_not_loaded\')\n            return None,[]\n        studio=m.u32(studio_wrapper)\n        header=m.read(studio,180)\n        model=studio_header(header)\n        if metadata is not None:metadata[\'model\']=model\n        count,offset=struct.unpack_from(\'<ii\',header,156)\n        cache_ptr=struct.unpack_from(\'<I\',entity_data,0x8d0)[0] if entity_data else m.u32(p+0x8d0)\n        cache_count=struct.unpack_from(\'<i\',entity_data,0x8dc)[0] if entity_data else m.i32(p+0x8dc)\n        if not 1<=count<=256 or not 180<=offset<=16*1024*1024:raise UnsupportedModel(\'bone layout not supported\')\n        if not count<=cache_count<=256 or not cache_ptr:\n            if metadata is not None:metadata[\'pose_diagnostic\']=dict(model_support=\'pending\',reason=\'bone_cache_not_ready\')\n            return None,[]\n        active=struct.unpack_from(\'<i\',entity_data,0x5e0)[0] if entity_data else m.i32(p+0x5e0)\n        set_count,set_offset=struct.unpack_from(\'<ii\',header,172)\n        set_header=b\'\'\n        if set_count:\n            if not 0<=active<set_count<=64 or not 180<=set_offset<16*1024*1024:raise ValueError(\'hitbox header incomplete\')\n            set_header=m.read(studio+set_offset+active*12,12)\n        key=(studio,header,active,set_header)\n        if key not in self.model_cache:\n            blob=m.read(studio+offset,count*216);defs=[];names=[]\n            for i in range(count):\n                nameoff,parent=struct.unpack_from(\'<ii\',blob,i*216)\n                flags=struct.unpack_from(\'<I\',blob,i*216+160)[0]\n                if not -1<=parent<count:raise MemoryError(\'骨骼父索引无效\')\n                name=m.string(studio+offset+i*216+nameoff,96).lower();names.append(name)\n                defs.append((parent,flags))\n            validate_rig([d[0] for d in defs],[])\n            set_count,set_offset=struct.unpack_from(\'<ii\',header,172)\n            head_box=None;hit_bones=set();head_source=\'no_hitboxes\';head_radius=None;parsed=[];discarded=0\n            if 0<=active<set_count<=64 and 180<=set_offset<16*1024*1024:\n                set_base=studio+set_offset+active*12\n                _,box_count,box_offset=struct.unpack(\'<iii\',m.read(set_base,12))\n                if 0<box_count<=256 and 12<=box_offset<16*1024*1024:\n                    boxes=m.read(set_base+box_offset,box_count*68);parsed=[]\n                    for i in range(box_count):\n                        bone,group=struct.unpack_from(\'<ii\',boxes,i*68)\n                        bounds=struct.unpack_from(\'<6f\',boxes,i*68+8)\n                        parsed.append((bone,group,bounds))\n                    original_hit_bones={b for b,g,bounds in parsed}\n                    parsed,discarded=adapt_hitboxes([d[0] for d in defs],parsed)\n                    head_box,head_source,hit_bones=choose_head(names,[d[0] for d in defs],parsed)\n                    if discarded:hit_bones.update(original_hit_bones)\n                    if head_box:\n                        bone,center=head_box\n                        for b,g,bounds in parsed:\n                            if b==bone and tuple((bounds[k]+bounds[k+3])*.5 for k in range(3))==center:\n                                head_radius=min(bounds[k+3]-bounds[k] for k in range(3))*.5\n                                break\n            # Draw the hitbox rig and its ancestors, excluding cosmetic bones\n            # such as "headflower" which may sit at the entity\'s feet.\n            wanted=set(hit_bones)\n            for i in tuple(wanted):\n                seen=set()\n                while i>=0 and i not in seen:\n                    wanted.add(i);seen.add(i);i=defs[i][0]\n            if not wanted:wanted={i for i,(_,flags) in enumerate(defs) if flags&0x100}\n            links=[(parent,i) for i,(parent,_) in enumerate(defs) if i in wanted and parent in wanted and parent>=0]\n            model=header[12:76].split(b\'\\0\')[0].decode(\'utf-8\',errors=\'replace\')\n            if len(self.model_cache)>=2048:self.model_cache.clear()\n            from eye_region import anchor as eye_anchor\n            try:eye_local=eye_anchor(m,studio,header,blob,parsed,head_box)\n            except MemoryError:eye_local=None\n            cached=(links,head_box,wanted,model,head_source,names[head_box[0]] if head_box else \'\',head_radius,sample_definitions(parsed,names,head_box,eye_local),parsed,discarded)\n            if m.read(studio,180)!=header or (set_header and m.read(studio+set_offset+active*12,12)!=set_header):\n                raise ValueError(\'model changed during read\')\n            if head_box is not None and parsed:self.model_cache[key]=cached\n        else:cached=self.model_cache[key]\n        links,head_box,wanted,model,head_source,head_name,head_radius=cached[:7]\n        blob=bone_snapshot if bone_snapshot is not None and len(bone_snapshot)==count*48 else m.read(cache_ptr,count*48)\n        if metadata is not None:metadata.update(model=model,head_source=head_source,head_bone=head_name,\n            pose_diagnostic=dict(model_support=\'supported\',reason=\'native_model_structure\',\n                                 discarded_hitboxes=cached[9] if len(cached)>9 else 0))\n        raw={i:struct.unpack_from(\'<12f\',blob,i*48) for i in wanted}\n        applied_scale=visual_scale_factor(tuple(raw.values()),scale_info)\n        head_applied_scale=applied_scale\n        if head_box:\n            # Head and body may be controlled independently.  Estimate the\n            # missing head factor from the selected head bone only, then apply\n            # the ratio exactly once to the head geometry and aim samples.\n            head_applied_scale=visual_scale_factor((raw[head_box[0]],),\n                                                   dict(scale_info,body=scale_info[\'head\']))\n        if metadata is not None:\n            metadata.update(geometry_body_scale=scale_info[\'body\'],\n                           geometry_head_scale=scale_info[\'head\'],\n                           geometry_scale_detected=scale_info[\'detected\'],\n                           geometry_scale_applied=applied_scale,\n                           geometry_head_scale_applied=head_applied_scale)\n        pts={};good={};ox,oy,oz=origin\n        for i in wanted:\n            factor=head_applied_scale if head_box and i==head_box[0] else applied_scale\n            transform=visual_matrix(raw[i],origin,factor)\n            x,y,z=transform[3],transform[7],transform[11]\n            pts[i]=(x,y,z)\n            # Uninitialized all-zero transforms otherwise look like feet at (0,0,0).\n            good[i]=matrix_valid(transform,origin,geometry_scale)\n        lines=[]\n        for parent,i in links:\n            if good.get(i) and good.get(parent):\n                a,b=pts[parent],pts[i];dx,dy,dz=a[0]-b[0],a[1]-b[1],a[2]-b[2]\n                if 0<dx*dx+dy*dy+dz*dz<scaled_radius(geometry_scale,400.)**2:lines.append((a,b))\n        head=None\n        if head_box and good.get(head_box[0]):\n            bone,center=head_box;matrix=visual_matrix(raw[bone],origin,head_applied_scale)\n            point=tuple(sum(matrix[j*4+k]*center[k] for k in range(3))+matrix[j*4+3] for j in range(3))\n            if point_valid(point,origin,geometry_scale):head=point\n            # Use a conservative inscribed radius only for an orthogonal bone\n            # transform. Sheared/unavailable transforms retain the old cap.\n            axes=[tuple(matrix[j*4+k] for j in range(3)) for k in range(3)]\n            scales=[length(a) for a in axes]\n            if metadata is not None and head_radius and min(scales)>0 and all(abs(sum(axes[i][k]*axes[j][k] for k in range(3)))<1e-3*scales[i]*scales[j] for i in range(3) for j in range(i)):\n                metadata[\'head_radius\']=head_radius*min(scales)\n        # Identity matrices can have valid axes but every joint at world zero.\n        # A rig with links must contain at least one noncollapsed valid segment.\n        if links and not lines:head=None\n        if metadata is not None and head_box and head is None:metadata[\'head_source\']=\'bone_transform_unavailable\'\n        pose_cache={}\n        if metadata is not None and with_aimpoints and len(cached)>7 and (lines or not links):\n            definitions=cached[7]\n            if aim_key is not None:\n                definitions=[item for item in definitions if f\'{active}:{item[0]}\'==aim_key]\n            metadata[\'aim_points\']=world_samples(definitions,blob,good,origin,geometry_scale,\n                                                  applied_scale,head_applied_scale,pose_cache=pose_cache)\n            for point in metadata[\'aim_points\']:point.key=f\'{active}:{point.key}\'\n        if metadata is not None and with_aimpoints and len(cached)>8 and (lines or not links):\n            metadata[\'aim_hitboxes\']=world_hitboxes(cached[8],blob,origin,geometry_scale,\n                                                    applied_scale,head_applied_scale,pose_cache=pose_cache)\n        if metadata is not None and with_hitboxes and len(cached)>8 and (lines or not links):\n            metadata[\'protected_hitboxes\']=world_hitboxes(cached[8],blob,origin)\n        return head,lines\n    def read_hostage(self,index,p):\n        stage=\'begin\'\n        try:\n            sampled=time.monotonic();stage=\'class_layout\'\n            if self.classname(p).lower()!=\'chostage\' or not self.verify_npc(p,hostage=True):\n                raise MemoryError(\'人质碰撞布局未验证\')\n            stage=\'entity_snapshot\';data=self.mem.read(p,0x1000)\n            health=struct.unpack_from(\'<i\',data,0x98)[0]\n            if data[0x97]!=0 or health<=0 or data[0xf34]:return None\n            stage=\'collision_bounds\'\n            origin=struct.unpack_from(\'<3f\',data,0x300);network=struct.unpack_from(\'<3f\',data,0x3d0)\n            if not finite(origin) or length(sub(origin,network))>4096:origin=network\n            bounds=struct.unpack_from(\'<6f\',data,0x25c)\n            if not finite(origin+bounds) or not all(.01<bounds[k+3]-bounds[k]<1024 for k in range(3)):\n                raise MemoryError(\'人质碰撞范围无效\')\n            # Enclose the collision box for any yaw, including a turning hostage.\n            radius=(max(abs(bounds[0]),abs(bounds[3]))**2+max(abs(bounds[1]),abs(bounds[4]))**2)**.5\n            world=(add(origin,(-radius,-radius,bounds[2])),add(origin,(radius,radius,bounds[5])))\n            fallback_bounds=bounded_hostage_envelope((),world)\n            dormant=bool(data[0x21e]);meta={}\n            # Keep the civilian as a display-only Entity.  It is never added\n            # to ``Frame.entities`` and therefore cannot enter combat target\n            # selection.  Its real model pose is still available to the\n            # adjacent aim/fire consumers through ``Frame.hostages``.\n            hostage=Entity(index,p,\'CHostage\',-1,health,origin,dormant=dormant)\n            hostage.reported_alive=True\n            hostage.pose_bounds=fallback_bounds\n            hostage.pose_sample_stamp=sampled\n            if not dormant:\n                try:\n                    hostage.head,hostage.skeleton=self.bones(\n                        p,origin,data,meta,with_aimpoints=False,with_hitboxes=True)\n                    hostage.__dict__.update(meta)\n                except (MemoryError,ValueError,struct.error) as ex:\n                    # Identity and position remain valid even while the\n                    # client model cache is rebuilding.  Do not emit an\n                    # ambiguous "unknown hostage" state or reuse an old rig.\n                    hostage.pose_diagnostic=dict(source=\'client_hostage\',\n                        reason=str(ex),model_support=\'pending\')\n                    hostage.head=None;hostage.skeleton=[]\n            else:\n                hostage.pose_diagnostic=dict(source=\'client_hostage\',reason=\'dormant\')\n            # The guard volume is derived from the same native hitboxes that\n            # produced the current rig.  A temporary model-cache gap falls\n            # back to this hostage\'s own collision envelope; it never reuses\n            # another frame or another source\'s bounds.\n            boxes=getattr(hostage,\'protected_hitboxes\',())\n            if boxes:\n                envelope=bounded_hostage_envelope(boxes,fallback_bounds)\n                if envelope is not None:hostage.pose_bounds=envelope\n            hostage.serial=self.slot_cache.get(index,(0,0,False))[1]\n            protected=ProtectedEntity(index,p,hostage.pose_bounds,dormant,\n                                      boxes,sampled)\n            if boxes:protected.bounds=hostage.pose_bounds\n            # CLIENT/non-host display intentionally exports the protected\n            # body volume, not a second client skeleton.  The hitboxes above\n            # remain attached to the guard for its exact narrow phase.\n            hostage.head=None;hostage.skeleton=[]\n            hostage.hostage_geometry=\'client_protected_volume\'\n            return hostage,protected\n        except MemoryError as ex:\n            raise MemoryError(f\'人质 #{index} {stage}: {ex}\') from ex\n    def read_entity(self,index,p,with_bones=True,with_aimpoints=True,observe_inactive=False,with_inventory=True,bone_limit=None,_pose_retry=True,aim_key=None,control_context=None):\n        name=self.classname(p);kind=entity_kind(name);player=kind==\'player\'\n        if not kind or (kind==\'npc\' and not self.verify_npc(p)):return None\n        data=self.mem.read(p,0x1a10 if player else 0x1000)\n        health=struct.unpack_from(\'<i\',data,0x98)[0];team=struct.unpack_from(\'<i\',data,0xa0)[0]\n        reported_alive=data[0x97]==0 and 0<health<100000000\n        if not reported_alive and not (player and data[0x97] in (0,1,2) and\n                (health==1 or (observe_inactive and -100000000<health<100000000))):return None\n        if not 0<=team<256:return None\n        # Absolute origin is interpolated by the client; network origin is also checked.\n        origin=struct.unpack_from(\'<3f\',data,0x300)\n        network_origin=struct.unpack_from(\'<3f\',data,0x3d0)\n        if not finite(origin) or length(sub(origin,network_origin))>4096:origin=network_origin\n        if not finite(origin):return None\n        e=Entity(index,p,name,team,health,origin,bool(data[0x21e]))\n        scale_info=client_scale_info(self,p,data)\n        scalar_scale=client_scale(self,p,data)\n        # Keep compatibility with older scalar probes while exposing the\n        # verified named factors to every consumer, including dormant actors.\n        if abs(scale_info[\'maximum\']-1.)<=1e-4 and abs(scalar_scale-1.)>1e-4:\n            scale_info=dict(scale_info,body=scalar_scale,head=scalar_scale,\n                            maximum=scalar_scale,detected=True)\n        e.reported_alive=reported_alive\n        e.geometry_scale=scale_info[\'maximum\']\n        e.geometry_body_scale=scale_info[\'body\']\n        e.geometry_head_scale=scale_info[\'head\']\n        e.geometry_scale_detected=scale_info[\'detected\']\n        if player:\n            if (health==1 or not reported_alive) and self.fields_available(\'m_hRagdoll\'):\n                handle=struct.unpack_from(\'<I\',data,0x1688)[0]\n                try:\n                    ragdoll=self.handle_entity(handle)\n                    e.ragdoll_present=bool(ragdoll and \'ragdoll\' in self.classname(ragdoll).lower())\n                except MemoryError:e.ragdoll_present=None\n            bounds=struct.unpack_from(\'<6f\',data,0x25c)\n            if finite(bounds) and all(0<bounds[i+3]-bounds[i]<scaled_radius(e.geometry_scale,1024.) for i in range(3)):\n                radius=math.hypot(max(abs(bounds[0]),abs(bounds[3])),max(abs(bounds[1]),abs(bounds[4])))+24.\n                envelope=max(1.,e.geometry_scale)\n                e.pose_bounds=(add(origin,(-radius*envelope,-radius*envelope,(bounds[2]-8.)*envelope)),add(origin,(radius*envelope,radius*envelope,(bounds[5]+32.)*envelope)))\n            e.zombie_class=struct.unpack_from(\'<i\',data,0x1794)[0]\n            # Verified against this fingerprinted build\'s live player RecvTable.\n            velocity=struct.unpack_from(\'<3f\',data,0x198)\n            if finite(velocity) and length(velocity)<10000:e.velocity=velocity\n            e.flags=struct.unpack_from(\'<I\',data,0x3e8)[0]\n        else:\n            try:\n                owner=self.handle_entity(struct.unpack_from(\'<I\',data,0xf48)[0])\n                if owner and entity_kind(self.classname(owner))==\'player\':e.owner_team=self.mem.i32(owner+0xa0)\n            except MemoryError:pass\n        # Confirmed ragdolls cannot yield a live pose. Avoid re-reading their\n        # inventory and hundreds of bone transforms every render/control tick.\n        if player and e.health==1 and e.ragdoll_present is True:return e\n        if e.dormant:return e\n        if control_context is not None:\n            local_team,mode,enemy_team,free_for_all=control_context\n            enemy=is_enemy(e.classname,e.team,local_team,mode,enemy_team)\n            if not enemy_team and e.owner_team==local_team:enemy=False\n            if free_for_all and player and e.team>=2:enemy=True\n            # Display uses its separate sampler. Keep current identity/team/HP\n            # for every actor, but do not build ally rigs/inventory on the\n            # latency-sensitive control thread. Re-evaluate each fresh frame.\n            if not enemy:return e\n        throw_ammo=None;redraw=False\n        try:\n            h=struct.unpack_from(\'<I\',data,0xf0c)[0] if player and self.fields_available(\'m_hActiveWeapon\') else 0xffffffff;weapon=self.handle_entity(h)\n            if weapon:\n                e.weapon=self.classname(weapon)\n                e.grenade=self.is_throwable_weapon(weapon) if self.fields_available(\'m_bRedraw\',\'m_fThrowTime\',\'m_iPrimaryAmmoType\',\'m_iAmmo\') else False\n                if e.grenade:\n                    e.throwable_source=\'active:\'+e.weapon\n                    ammo_type=self.mem.i32(weapon+0xa20)\n                    if 0<=ammo_type<40:throw_ammo=ammo_type\n                    redraw=bool(self.mem.read(weapon+0xba8,1)[0])\n                    if redraw:e.grenade=False\n        except MemoryError:pass\n        if player:\n            now=time.monotonic();serial=self.slot_cache.get(index,(0,0))[1];identity=(p,serial)\n            previous=self.throw_states.get(identity);red_until=previous[\'red_until\'] if previous else 0.\n            if previous and now-previous[\'seen\']<=.3:\n                ammo_type=previous[\'ammo_type\']\n                count=struct.unpack_from(\'<H\',data,0xdfc+2*ammo_type)[0] if ammo_type is not None else None\n                if previous[\'holding\'] and ((count is not None and count<previous[\'ammo_count\']) or redraw):red_until=now+1.\n            self.throw_states[identity]=dict(seen=now,holding=e.grenade,ammo_type=throw_ammo,\n                ammo_count=struct.unpack_from(\'<H\',data,0xdfc+2*throw_ammo)[0] if throw_ammo is not None else 0,red_until=red_until)\n            if len(self.throw_states)>256:self.throw_states={key:value for key,value in self.throw_states.items() if now-value[\'seen\']<2.}\n            e.throw_red_until=red_until\n        e.can_throw=e.grenade\n        if player and with_inventory and self.fields_available(\'m_hMyWeapons\',\'m_iAmmo\',\'m_iPrimaryAmmoType\',\'m_bRedraw\',\'m_fThrowTime\'):\n            handles=struct.unpack_from(\'<48I\',data,0xe4c)\n            cached=self.inventory_cache.get(p)\n            now=time.monotonic()\n            if not cached or cached[0]!=handles or now>=cached[2]:\n                inventory=[]\n                for handle in handles:\n                    if handle in (0,0xffffffff):continue\n                    try:\n                        item=self.handle_entity(handle)\n                        if not item:continue\n                        if self.is_throwable_weapon(item):\n                            ammo_type=self.mem.i32(item+0xa20)\n                            if 0<=ammo_type<40:inventory.append((handle,item,ammo_type,self.classname(item)))\n                    except MemoryError:continue\n                if len(self.inventory_cache)>256:self.inventory_cache.clear()\n                cached=(handles,inventory,now+.20);self.inventory_cache[p]=cached\n            for handle,item,ammo_type,item_name in cached[1]:\n                if not 0<struct.unpack_from(\'<H\',data,0xdfc+2*ammo_type)[0]<10000:continue\n                try:\n                    if self.handle_entity(handle)!=item:continue\n                except MemoryError:continue\n                e.can_throw=True\n                if not e.throwable_source:e.throwable_source=\'inventory:\'+item_name\n                break\n        # Dormant bones are last-known display data; all control paths still\n        # reject dormant entities before selecting or firing at a target.\n        if with_bones and self.fields_available(\'bones\') and (bone_limit is None or length(sub(origin,bone_limit[0]))<=bone_limit[1] or health==1):\n            try:\n                meta=dict(_scale_info=scale_info,_geometry_scale=e.geometry_scale)\n                if aim_key is None:e.head,e.skeleton=self.bones(p,origin,data,meta,with_aimpoints)\n                else:e.head,e.skeleton=self.bones(p,origin,data,meta,with_aimpoints,aim_key=aim_key)\n                for key,value in meta.items():\n                    if not key.startswith(\'_\'):setattr(e,key,value)\n                if e.pose_bounds:\n                    from aim_points import point_in_actor\n                    # Adjacent segments share joints, and head centers also\n                    # appear among aim samples. Validate each current point\n                    # once; nothing is retained across entities or frames.\n                    points={p for segment in e.skeleton for p in segment}\n                    points.update(point.position for point in e.aim_points)\n                    if e.head:points.add(e.head)\n                    inside={point:point_in_actor(point,e) for point in points}\n                    e.skeleton=[(a,b) for a,b in e.skeleton if inside[a] and inside[b]]\n                    e.aim_points=[point for point in e.aim_points if inside[point.position]]\n                    # ``with_aimpoints=False`` is the ESP fast path: the\n                    # current rig is valid, but the legacy aim-point cache\n                    # was deliberately not sampled.  Marking that empty\n                    # cache as validated makes the publisher discard an\n                    # otherwise usable head/skeleton and leaves RMB/T with\n                    # no target.  Only a requested aim cache may claim this\n                    # flag; the publisher then falls back to this frame\'s\n                    # measured rig joints.\n                    e.aim_points_validated=bool(with_aimpoints)\n                    if e.head and not inside[e.head]:\n                        e.pose_diagnostic=dict(raw_head=e.head,origin=origin,network_origin=network_origin,\n                                               bounds=e.pose_bounds,reason=\'outside_actor_bounds\',retry=False)\n                        e.head=None;e.head_source=\'outside_actor_bounds\'\n                        now=time.monotonic()\n                        if _pose_retry and now>=self.pose_retry_after.get((index,p),0.):\n                            if len(self.pose_retry_after)>256:self.pose_retry_after.clear()\n                            self.pose_retry_after[(index,p)]=now+.1\n                            entry=self.global_addr(\'entity_entries\')+index*16\n                            expected=self.mem.read(entry,8)\n                            if struct.unpack(\'<II\',expected)[0]==p:\n                                current=self.read_entity(index,p,with_bones,with_aimpoints,observe_inactive,with_inventory,bone_limit,False,aim_key,control_context)\n                                if self.mem.read(entry,8)!=expected:return None\n                                if current is not None:\n                                    diagnostic=dict(e.pose_diagnostic,retry=True,recovered=current.head is not None)\n                                    if current.pose_diagnostic:diagnostic[\'after\']=current.pose_diagnostic\n                                    current.pose_diagnostic=diagnostic\n                                return current\n            except (MemoryError,ValueError,struct.error) as ex:\n                e.head=None;e.skeleton=[];e.aim_points=[];e.aim_hitboxes=()\n                e.head_source=\'model_unavailable\'\n                e.model=meta.get(\'model\',e.model)\n                e.pose_diagnostic=dict(model_support=\'unsupported\' if isinstance(ex,UnsupportedModel) else \'pending\',reason=str(ex))\n        return e\n    def local_health_observation(self):\n        """Read health even on death, without requiring a live render frame."""\n        m=self.mem\n        if not m or not m.alive() or m.i32(self.global_addr(\'signon\'))!=6:return None\n        stamp=time.monotonic();index=m.i32(self.global_addr(\'local_index\'))+1\n        if not 1<=index<=128:return None\n        address=m.u32(self.global_addr(\'local_player\'))\n        if not address or address!=self.entity_address(index):return None\n        name=self.classname(address)\n        if entity_kind(name)!=\'player\':return None\n        data=m.read(address,0x1798);life=data[0x97]\n        health=struct.unpack_from(\'<i\',data,0x98)[0];team=struct.unpack_from(\'<i\',data,0xa0)[0]\n        if life not in (0,1,2) or not -100000000<health<100000000 or not 0<=team<256:return None\n        if health<0 and life==0:return None\n        if (m.i32(self.global_addr(\'signon\'))!=6 or m.i32(self.global_addr(\'local_index\'))+1!=index\n                or m.u32(self.global_addr(\'local_player\'))!=address or self.entity_address(index)!=address):return None\n        local=Entity(index,address,name,team,max(0,health),(0,0,0),\n                     zombie_class=struct.unpack_from(\'<i\',data,0x1794)[0])\n        map_name=m.string(self.global_addr(\'level_name\'),160).replace(\'\\\\\',\'/\')\n        return local,map_name,stamp,life!=0\n\n    def frame(self,mode=\'普通竞技\',enemy_team=0,with_hazards=False,with_aimpoints=True,observe_inactive=False,include_allies=False,detail_distance=None,local_only=False,control_only=False,with_bones=True,defer_hostage_filter=False):\n        started=time.monotonic()\n        m=self.mem\n        if not m or not m.alive():raise NotReady(\'游戏进程未运行\')\n        signon=m.i32(self.global_addr(\'signon\'))\n        self.session_state={\'signon\':signon,\'observed_at\':started,\'stage\':\'sampling\' if signon==6 else \'waiting\'}\n        if signon!=6:\n            self.entity_scan=[];self.slot_cache.clear();self.last_scan=0;self.entity_stats={}\n            self.pose_activity.tracks.clear()\n            self.throw_states.clear()\n            if signon==0:raise NotReady(\'已检测到游戏进程，尚未连接服务器（状态 0）\')\n            raise NotReady(\'地图正在载入，等待角色生成（状态 5）\' if signon==5 else f\'游戏连接状态 {signon}，等待地图数据\')\n        index=m.i32(self.global_addr(\'local_index\'))+1\n        if not 1<=index<=128:raise NotReady(\'本地角色索引尚未就绪\')\n        lp=m.u32(self.global_addr(\'local_player\'))\n        if not lp or lp!=self.entity_address(index):raise NotReady(\'本地角色与实体列表尚未同步\')\n        local=self.read_entity(index,lp,False,with_inventory=with_aimpoints)\n        if local is None:raise NotReady(\'本地角色未存活或正在观察\')\n        angles=m.vec(self.global_addr(\'view_angles\'));punch=m.vec(lp+0xfd8) if self.fields_available(\'m_Local\',\'m_vecPunchAngle\') else (0.,0.,0.);offset=m.vec(lp+0x18c)\n        if not finite(angles+punch+offset) or not -90<=angles[0]<=90 or not eye_offset_valid(offset,local.geometry_scale):raise NotReady(\'视角/眼睛位置未通过校验\')\n        eye=add(local.origin,offset)\n        render=self.global_addr(\'render\')\n        depth=m.i32(render+0xe8)\n        if not 0<=depth<=32:raise NotReady(\'投影矩阵状态无效\')\n        matrix=self.camera_matrix()\n        now=time.monotonic()\n        if not local_only and now-self.last_scan>(.05 if with_hazards else .2):\n            highest=m.i32(self.global_addr(\'highest_entity\'))\n            if not 1<=highest<32768:raise NotReady(\'实体数量无效\')\n            entries=m.read(self.global_addr(\'entity_entries\'),(highest+1)*16)\n            candidates=[];slots={};self.scan_complete=True;self.scan_errors=[]\n            for i in range(1,highest+1):\n                p,serial=struct.unpack_from(\'<II\',entries,i*16)\n                if not p or i==index:continue\n                tag=(p,serial)\n                cached=self.slot_cache.get(i)\n                if cached and cached[:2]==tag:\n                    relevant=cached[2]\n                else:\n                    try:\n                        name=self.classname(p).lower()\n                        relevant=(\'c4\' if name in (\'cc4\',\'cplantedc4\') else \'hostage\' if name==\'chostage\'\n                                  else \'grenade\' if \'grenadeprojectile\' in name else bool(entity_kind(name)))\n                    except MemoryError as ex:\n                        # A freed projectile/prop slot is absent, not an unreadable\n                        # civilian. A stable unknown slot still blocks firing.\n                        try:removed=struct.unpack(\'<II\',m.read(self.global_addr(\'entity_entries\')+i*16,8))[0]==0\n                        except MemoryError:removed=False\n                        if not removed:\n                            self.scan_complete=False\n                            self.scan_errors.append(dict(index=i,stage=\'classification\',error=str(ex)))\n                        continue\n                slots[i]=(p,serial,relevant)\n                if relevant:candidates.append((i,p))\n            self.slot_cache=slots;self.entity_scan=candidates\n            self.last_scan=now\n        from mode_ally_policy import FFA_IDS,mode_rule\n        native_mode=self.native_mode.read();free_for_all=native_mode in FFA_IDS\n        mode=mode_rule(native_mode)\n        entities=[];protected=[];hostages=[];protect=protect_hostages(mode)\n        grenades=[];hazard_status=\'\'\n        if with_hazards and now>=self.hazard_retry:\n            try:\n                from grenade_dodge import grenade_reader\n                self.hazard_reader=grenade_reader(self,self.hazard_reader)\n            except Exception as ex:\n                self.hazard_reader=None;hazard_status=str(ex);self.hazard_retry=now+5.\n        if with_hazards and self.hazard_reader:\n            try:\n                grenades=self.hazard_reader.scan();hazard_status=getattr(self.hazard_reader,\'status\',\'\')\n            except Exception as ex:hazard_status=str(ex)\n        protected_complete=getattr(self,\'scan_complete\',True)\n        protected_errors=list(getattr(self,\'scan_errors\',())) if not protected_complete else []\n        stats={\'scanned\':len(self.entity_scan),\'rejected\':0,\'read_errors\':0}\n        for i,p in (() if local_only else self.entity_scan):\n            try:\n                if self.slot_cache.get(i,(0,0,False))[2] in (\'grenade\',\'c4\'):\n                    continue\n                if self.slot_cache.get(i,(0,0,False))[2]==\'hostage\':\n                    if protect:\n                        hostage=self.read_hostage(i,p)\n                        if hostage:\n                            display,guard=hostage\n                            hostages.append(display)\n                            protected.append(guard)\n                    continue\n                detail_args=dict(control_context=(local.team,mode,enemy_team,free_for_all)) if control_only else {}\n                e=self.read_entity(i,p,with_bones=with_bones,with_aimpoints=with_aimpoints,observe_inactive=observe_inactive,\n                                   with_inventory=with_aimpoints,bone_limit=(local.origin,detail_distance) if detail_distance else None,**detail_args)\n                if not e:stats[\'rejected\']+=1;continue\n                e.serial=self.slot_cache.get(i,(0,0,False))[1]\n                e.enemy=is_enemy(e.classname,e.team,local.team,mode,enemy_team)\n                if not enemy_team and e.owner_team==local.team:e.enemy=False\n                if free_for_all and entity_kind(e.classname)==\'player\' and e.team>=2:e.enemy=True\n                entities.append(e)\n            except MemoryError as ex:\n                stats[\'read_errors\']+=1\n                if self.slot_cache.get(i,(0,0,False))[2]==\'hostage\':\n                    protected_complete=False;protected_errors.append(dict(index=i,address=p,serial=self.slot_cache.get(i,(0,0,False))[1],stage=\'hostage\',error=str(ex)))\n                continue\n        stats.update(alive=len(entities),enemies=sum(e.enemy for e in entities),\n                     dormant=sum(e.dormant for e in entities),missing_bones=sum(not e.skeleton for e in entities),\n                     protected=len(protected),protected_complete=protected_complete,\n                     hostages=len(hostages),hostage_bones=sum(bool(e.skeleton) for e in hostages),\n                     hostage_mode=bool(protect))\n        self.entity_stats=stats\n        # Name and clip must belong to the SAME handle. A population scan can\n        # straddle a switch; the old name with the new gun\'s clip could admit\n        # an empty weapon under another weapon\'s profile.\n        from weapon_input_guard import read_weapon_state\n        weapon_state=read_weapon_state(self,lp,include_reserve=True)\n        weapon=weapon_state[\'classname\'];ammo=weapon_state[\'ammo\']\n        local.weapon=weapon\n        name=m.string(self.global_addr(\'level_name\'),160).replace(\'\\\\\',\'/\')\n        # Re-read th