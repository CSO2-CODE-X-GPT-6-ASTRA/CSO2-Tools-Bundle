_EMBEDDED['magic_bullet_service'] = (1, '"""Optional native adapters with one independent read-only background owner.\n\nNo attack/button/binding/weapon selection writes exist in this module. The host\nadapter changes only an already-fired native shot. The remote adapter changes\nonly private outgoing-command angles and preserves the game\'s native cadence.\n"""\nimport copy\nimport hashlib\nimport importlib\nimport json\nimport math\nimport struct\nimport sys\nimport threading\nimport time\nimport uuid\nfrom pathlib import Path\nfrom client_control import ClientControlReader\nfrom aim_points import candidate_points,hostage_ray_clear,protect_hostages\nfrom geometry import finite,length,sub\nfrom target_rules import target_is_active,entity_kind,is_enemy\n\nCLIENT_CONTROL_LEASE=1.2\nCLIENT_POSE_BUDGET=.035\nCLIENT_POSE_LIMIT=4\nCLIENT_UPDATE_INTERVAL=.025\nCLIENT_POPULATION_INTERVAL=.100\nCLOCK_SKEW_MS=5\n\n\nclass ClientShotFeed:\n    """Resolve this generation\'s points once; commands select from that pool.\n\n    There is no second proof cache, pending-target list or Python selection.\n    A failed actor is isolated, and a new pose always replaces its old point.\n    """\n    def __init__(self):\n        self.metrics={};self._scope=None;self._ready={};self._cycle=0\n\n    def prepare(self,payload,query,clock=time.monotonic,publish=None):\n        began=clock()\n        self._cycle+=1\n        context={k:payload[k] for k in (\'pid\',\'map_name\',\'channel\',\'local_identity\',\'updated_wall_ms\',\'eye\',\'angles\')}\n        context[\'free_for_all\']=payload.get(\'free_for_all\',False)\n        scope=(payload[\'pid\'],payload[\'map_name\'],payload[\'channel\'],\n               tuple(sorted(payload[\'local_identity\'].items())),context[\'free_for_all\'],tuple(payload[\'eye\']))\n        def identity(row):\n            return tuple(row.get(k) for k in (\'target\',\'target_entity_address\',\'serial\',\'team\',\n                                              \'wrapper\',\'studio\',\'hitbox_set\',\'model_bones\'))\n        active={identity(row):row for row in payload[\'entities\']}\n        # Keep still-fresh, unprocessed actors during a partial round. Their\n        # original native sample times stay intact; failures remove that actor.\n        ready={key:value for key,value in self._ready.items() if self._scope==scope and key in active\n               and value.get(\'protected_volumes\',[])==active[key].get(\'protected_volumes\',[])}\n        removed_before_probe=len(ready)!=len(self._ready)\n        self._scope=scope;self._ready=ready\n        metrics=dict(cycle=self._cycle,started_wall_ms=int(time.time()*1000),\n                     actors=len(payload[\'entities\']),probes=0,points=0,clip_calls=0,world_calls=0,\n                     errors=0,native_ms=0.,rejections={},point_rejections={},actor_results=[],publications=0)\n        def ask(row=None,points=()):\n            answer=query(dict(context,target=row,points=points))\n            metrics[\'probes\']+=1\n            for name in (\'clip_calls\',\'world_calls\'):metrics[name]+=answer.get(name,0)\n            metrics[\'native_ms\']+=answer.get(\'elapsed_ms\',0.)\n            for reason,count in answer.get(\'point_rejections\',{}).items():\n                metrics[\'point_rejections\'][reason]=metrics[\'point_rejections\'].get(reason,0)+count\n            if row is not None and len(metrics[\'actor_results\'])<8:\n                metrics[\'actor_results\'].append({k:answer[k] for k in (\'target\',\'serial\',\'source_age_ms\',\n                    \'sample_wall_ms\',\'verified_wall_ms\',\'probe_eye\',\'target_origin\',\'result\',\'rejections\',\'examples\',\'error\') if k in answer})\n            if answer.get(\'error\'):\n                reason=answer[\'error\'];metrics[\'errors\']+=1\n                metrics[\'rejections\'][reason]=metrics[\'rejections\'].get(reason,0)+1\n            return answer\n        sight_answer=ask();sight=sight_answer.get(\'sight\')\n        def snapsh