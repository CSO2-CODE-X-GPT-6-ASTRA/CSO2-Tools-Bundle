_EMBEDDED['cursor_lock'] = (1, '"""Foreground-only client-center confinement, independent of game sampling."""\nimport atexit\nimport ctypes as C\nfrom ctypes import wintypes as W\nimport threading\nimport time\n\n\ndef raw_mouse_input_enabled(reader):\n    """Verify the native ConVar before using exact-center confinement."""\n    mem = reader.mem\n    address = reader.client + 0xe9a100\n    if mem.string(mem.u32(address + 12), 48) != \'m_rawinput\':\n        raise RuntimeError(\'原始鼠标输入设置未识别\')\n    parent = mem.u32(address + 28)\n    if not parent or mem.string(mem.u32(parent + 12), 48) != \'m_rawinput\':\n        raise RuntimeError(\'原始鼠标输入设置未就绪\')\n    return bool(mem.i32(parent + 52))\n\n\nclass CursorCenterLock:\n    def __init__(self, windows, target_pid, on_disabled=None, game_state=None):\n        self.win = windows\n        self.target_pid = target_pid\n        self.on_disabled = on_disabled\n        self.game_state = game_state or (lambda pid: \'playing\')\n        self.api = windows.u\n        self.api.ClipCursor.argtypes = [C.POINTER(W.RECT)]\n        self.api.ClipCursor.restype = W.BOOL\n        self.api.GetClipCursor.argtypes = [C.POINTER(W.RECT)]\n        self.api.GetClipCursor.restype = W.BOOL\n        self.api.SetCursorPos.argtypes = [C.c_int, C.c_int]\n        self.api.SetCursorPos.restype = W.BOOL\n        self.enabled = False\n        self.suspended = False\n        self.status = \'鼠标锁定：关闭\'\n        self._clip = None\n        self._guard = threading.RLock()\n        self._shutdown = threading.Event()\n        self._thread = None\n        self._escape_until = 0.\n\n    def start(self):\n        if self._thread is None:\n            self._thread = threading.Thread(target=self._run, name=\'CSO2-cursor-lock\', daemon=True)\n            atexit.register(self.close)\n            self._thread.start()\n\n    def set_enabled(self, enabled):\n        with self._guard:\n            self.enabled = bool(enabled) and not self._shutdown.is_set()\n            if not self.enabled:\n                self._release()\n            self.status = \'鼠标锁定：等待进入地图\' if self.enabled else \'鼠标锁定：关闭\'\n\n    def suspend(self, active):\n        with self._guard:\n            self.suspended = bool(active)\n            if self.suspended:\n                self._release()\n                self.status = \'鼠标锁定：悬浮窗操作时已释放\'\n            else:\n                self.status = \'鼠标锁定：等待进入地图\' if self.enabled else \'鼠标锁定：关闭\'\n\n    def _release(self):\n        if self._clip is None:\n            return\n        current = W.RECT()\n        if self.api.GetClipCursor(C.byref(current)):\n            actual = (current.left, current.top, current.right, current.bottom)\n            if actual != self._clip:\n                # Another application has already replaced our confinement.\n                self._clip = None\n                return\n        if not self.api.ClipCursor(None):\n            raise C.WinError(C.get_last_error())\n        self._clip = None\n\n    def step(self):\n        with self._guard:\n            if self.suspended:\n                self._release()\n                self.status = \'鼠标锁定：悬浮窗操作时已释放\'\n                return\n            if not self.enabled or self._shutdown.is_set():\n                self._release()\n                return\n            # Release as soon as switching begins, before focus changes.\n            if any(self.win.down(key) for key in (0x12, 0x5B, 0x5C)):\n                self._release()\n                self.status = \'鼠标锁定：切换窗口时已释放\'\n                return\n            pid = self.target_pid()\n            if not pid:\n                self._release()\n                self.status = \'鼠标锁定：等待连接游戏\'\n                return\n            state = self.win.viewport_state(pid)\n            rect = state.get(\'rect\')\n            hwnd = state.get(\'game_window\')\n            if (not rect or not hwnd or not self.api.IsWindowVisible(hwnd)\n                    or self.api.GetForegroundWindow() != state.get(\'foreground_window\')):\n                self._release()\n                self.status = \'鼠标锁定：等待游戏窗口前台\'\n                return\n            # Release on ESC immediately; the native menu flag takes over once\n            # the game handles the key. Never toggle a guessed menu state.\n            if self.win.down(0x1B):\n                self._escape_until = time.monotonic() + .35\n            if time.monotonic() < self._escape_until:\n                self._release()\n                self.status = \'鼠标锁定：游戏菜单中已释放\'\n                return\n            mode = self.game_state(pid)\n            if mode != \'playing\':\n                self._release()\n                self.status = (\'鼠标锁定：游戏菜单中已释放\' if mode == \'menu\' else\n                               \'鼠标锁定：正在准备鼠标输入\' if mode == \'input\' else\n                               \'鼠标锁定：等待进入地图\')\n                return\n            x, y, width, height = rect\n            # Keep the pointer inside the game client instead of forcing a\n            # one-pixel center box. Source mouse-look uses relative movement;\n            # a one-pixel clip turns normal input into endless view spin.\n            bounds = (x, y, x + width, y + height)\n            clip = W.RECT(*bounds)\n            # The pointer starts at the center, then remains inside the client\n            # while raw input continues to provide normal mouse-look deltas.\n            if not self.api.ClipCursor(C.byref(clip)):\n                raise C.WinError(C.get_last_error())\n            self._clip = bounds\n            if self.api.GetForegroundWindow() != state.get(\'foreground_window\'):\n                self._release()\n                self.status = \'鼠标锁定：等待游戏窗口前台\'\n                return\n            self.status = \'鼠标锁定：已限制在游戏窗口内\'\n\n    def _run(self):\n        try:\n            while not self._shutdown.is_set():\n                try:\n                    self.step()\n                except Exception as ex:\n                    with self._guard:\n                        self.enabled = False\n                        try:\n                            self._release()\n                        except OSError:\n                            pass  # Retry release on the next tick.\n                        self.status = \'鼠标锁定失败：\' + str(ex)\n                    if self.on_disabled:\n                        self.on_disabled(self.status)\n                self._shutdown.wait(.008 if self.enabled or self._clip else .05)\n        finally:\n            with self._guard:\n                self._release()\n\n    def close(self):\n        self._shutdown.set()\n        with self._guard:\n            self.enabled = False\n            self._release()\n        if self._thread is not None and self._thread is not threading.current_thread():\n            self._thread.join(.3)\n')

_EMBEDDED['local_health_away'] = ('2026.10.08-away-health-roundtime', '"""Away-health checkbox control; server health writes stay in LocalHealthLock."""\nimport ctypes as C\nfrom ctypes import wintypes as W\nimport json\nimport time\nimport tkinter as tk\nfrom tkinter import ttk\n\nLABEL = \'鼠标离开游戏自动激活，鼠标回到游戏自动取消\'\n\n\nclass CursorPosition:\n    def __init__(self):\n        self.u = C.WinDLL(\'user32\', use_last_error=True)\n        self.u.GetCursorPos.argtypes = [C.POINTER(W.POINT)]\n        self.u.GetCursorPos.restype = W.BOOL\n\n    def __call__(self):\n        point = W.POINT()\n        if not self.u.GetCursorPos(C.byref(point)):\n            raise C.WinError(C.get_last_error())\n        return point.x, point.y\n\n\ndef observe(worker, windows, cursor, now):\n    reader = worker.reader; mem = getattr(reader, \'mem\', None)\n    caps = getattr(worker, \'last_capabilities\', {}) or {}\n    frame = worker.frame\n    if (not worker.enabled or not mem or not mem.alive()\n            or worker.return_lobby.pending or worker.connection_cycle.active):\n        return None, None, \'waiting_session\'\n    if not caps.get(\'lock_hp\', {}).get(\'available\', False):\n        return None, None, \'host_health_unavailable\'\n    if (mem.i32(reader.global_addr(\'signon\')) != 6 or not frame\n            or not frame.map_name or not 0 <= now-frame.stamp <= 1.):\n        return None, None, \'waiting_match\'\n    session = (id(reader), mem.pid, frame.map_name)\n    view = windows.viewport_state(mem.pid)\n    if not view.get(\'game_window\'):\n        return session, None, \'window_unavailable\'\n    if view.get(\'reason\') in (\'minimized\', \'hidden\', \'cloaked\'):\n        return session, True, view[\'reason\']\n    rect = view.get(\'rect\')\n    if not rect:\n        return session, None, \'rect_unavailable\'\n    if not view.get(\'foreground\'):\n        return session, True, \'other_foreground\'\n    x, y = cursor(); left, top, width, height = rect\n    away = not (left <= x < left+width and top <= y < top+height)\n    return session, away, \'cursor_outside\' if away else \'in_game\'\n\n\nclass AwayHealthSwitch:\n    def __init__(self):\n        self.active = False; self.session = None; self.saved_once = False\n        self.state = dict(active=False, reason=\'waiting_session\')\n\n    @staticmethod\n    def assign(variables, key, value):\n        if bool(variables[key].get()) != bool(value):variables[key].set(bool(value))\n\n    def release(self, variables):\n        if self.active:\n            self.assign(variables, \'lock_hp\', False)\n            # The two health modes are mutually exclusive in the existing UI.\n            self.assign(variables, \'lock_hp_once\', self.saved_once)\n        self.active = False; self.saved_once = False; self.session = None\n\n    def update(self, variables, enabled, session, away, reason):\n        before = (self.active, bool(variables[\'lock_hp\'].get()),\n                  bool(variables[\'lock_hp_once\'].get()))\n        if not enabled or session is None:\n            self.release(variables)\n        else:\n            if self.active and session != self.session:self.release(variables)\n            if away is True:\n                if not self.active:\n                    self.saved_once = bool(variables[\'lock_hp_once\'].get())\n                    self.active = True; self.session = session\n                self.assign(variables, \'lock_hp_once\', False)\n                self.assign(variables, \'lock_hp\', True)\n            elif away is False:\n                self.release(variables)\n        self.state = dict(enabled=bool(enabled), active=self.active, reason=reason,\n            fixed_checked=bool(variables[\'lock_hp\'].get()),\n            once_checked=bool(variables[\'lock_hp_once\'].get()))\n        after = (self.active, self.state[\'fixed_checked\'], self.state[\'once_checked\'])\n        return before != after\n\n    def saved_settings(self):\n        # An automatic away state must not become a permanent startup setting.\n        return dict(lock_hp=False, lock_hp_once=self.saved_once) if self.active else {}\n\n\ndef record_transition(path, state, build):\n    from datetime import datetime\n    record = dict(time=datetime.now().astimezone().isoformat(timespec=\'milliseconds\'),\n                  mono=time.monotonic(), build=build, **state)\n    try:\n        if path.exists() and path.stat().st_size > 262144:\n            path.replace(path.with_name(\'health_away_events.previous.jsonl\'))\n        with path.open(\'a\', encoding=\'utf8\') as stream:\n            stream.write(json.dumps(record, ensure_ascii=False)+\'\\n\')\n    except OSError:pass\n\n\nclass AwayHealthMenu(ttk.Frame):\n    def __init__(self, parent, variable, i18n):\n        super().__init__(parent)\n        self.variable = variable; self.i18n = i18n; self.popup = None; self.checkbox = None\n        self.button = ttk.Button(self, text=\'▾\', width=2, command=self.toggle)\n        self.button.pack()\n        self.i18n.refreshers.append(self.refresh)\n\n    def toggle(self):\n        if self.popup is not None:self.close();return\n        popup = self.popup = tk.Toplevel(self)\n        popup.withdraw(); popup.overrideredirect(True)\n        popup.transient(self.winfo_toplevel()); popup.attributes(\'-topmost\', True)\n        body = ttk.Frame(popup, padding=10, relief=\'solid\', borderwidth=1)\n        body.pack(fill=\'both\', expand=True)\n        self.checkbox = ttk.Checkbutton(body, text=self.i18n.t(LABEL), variable=self.variable)\n        self.checkbox.pack(anchor=\'w\')\n        popup.update_idletasks()\n        width, height = popup.winfo_reqwidth(), popup.winfo_reqheight()\n        x = max(0, min(self.button.winfo_rootx(), popup.winfo_screenwidth()-width))\n        y = self.button.winfo_rooty()+self.button.winfo_height()\n        if y+height > popup.winfo_screenheight():y = self.button.winfo_rooty()-height\n        popup.geometry(f\'{width}x{height}+{x}+{max(0,y)}\')\n        popup.bind(\'<Escape>\', lambda event:self.close())\n        popup.bind(\'<FocusOut>\', lambda event:popup.after_idle(self.close_if_unfocused))\n        popup.deiconify(); popup.focus_force()\n\n    def close_if_unfocused(self):\n        if self.popup is None:return\n        focus = self.popup.focus_displayof()\n        if focus is None or focus.winfo_toplevel() is not self.popup:self.close()\n\n    def refresh(self):\n        if self.checkbox is not None:self.checkbox.configure(text=self.i18n.t(LABEL))\n\n    def close(self):\n        popup = self.popup; self.popup = None; self.checkbox = None\n        if popup is not None:popup.destroy()\n')
_EMBEDDED['local_round_away'] = ('2026.10.08-round-away-process-theme', '"""Host round-time policy while the pointer is away from the game."""\nimport json\nimport math\nimport struct\nimport time\nimport tkinter as tk\nfrom tkinter import ttk\n\nfrom camera_commands import CameraCommands\nfrom feature_caps import local_server\nfrom runtime_compat import field_check, native_loopback\nfrom ui_components import BG, PANEL, TEXT, LABEL, dark_titlebar, prepare_hidden_window, reveal_ready_window\n\n\nWAIT_PROMPT = \'等待提醒弹窗\'\nAUTO_RESET = \'鼠标移开游戏，自动重置对局+无限时间\'\nPOLICIES = (WAIT_PROMPT, AUTO_RESET)\nPOLICY_LABEL = \'游戏倒计时策略\'\nPROMPT_TEXT = \'游戏倒计时仍在继续，是否应用无限时间：\\n控制台：mp_roundtime 35791394 并刷新游戏\'\nONCE = \'仅处理本次\'\nALWAYS = \'永远激活：鼠标移开游戏，自动重置对局+无限时间\'\nSKIP = \'本次不处理\'\n\n# The game converts mp_roundtime minutes to signed 32-bit seconds. 35791394\n# minutes is the largest stable value (2,147,483,640 seconds, about 68 years).\nROUND_MINUTES = 35791394\nROUND_SECONDS = ROUND_MINUTES*60\nROUND_FIELDS = (\n    (0x9aa048, \'m_iRoundTime\', 0x300, 4),\n    (0x9aa07c, \'m_iLastRoundRemainTime\', 0x2f8, 4),\n    (0x9aa0b0, \'m_iTotalRoundsPlayed\', 0x2f4, 4),\n    (0x9aa0e4, \'m_fRoundStartTime\', 0x304, 4),\n    (0x9aa284, \'m_bFreezePeriod\', 0x2fc, 4),\n)\nCONVARS = ((0xa07100, \'mp_roundtime\'), (0xa0bc08, \'mp_restartgame\'))\nPOLL_SECONDS = .5\n\n\ndef record_transition(path, state, build):\n    from datetime import datetime\n    record = dict(time=datetime.now().astimezone().isoformat(timespec=\'milliseconds\'),\n                  mono=time.monotonic(), build=build, **state)\n    try:\n        if path.exists() and path.stat().st_size > 262144:\n            path.replace(path.with_name(\'round_away_events.previous.jsonl\'))\n        with path.open(\'a\', encoding=\'utf8\') as stream:\n            stream.write(json.dumps(record, ensure_ascii=False)+\'\\n\')\n    except OSError:\n        pass\n\n\nclass RoundAwayService:\n    def __init__(self, camera_factory=CameraCommands, clock=time.monotonic):\n        self.camera_factory = camera_factory\n        self.clock = clock\n        self.camera = None\n        self.validated = None\n        self.server = None\n        self.session = None\n        self.away = False\n        self.departure = 0\n        self.previous = None\n        self.handled = False\n        self.request = None\n        self.pending = None\n        self.state = dict(policy=WAIT_PROMPT, phase=\'waiting_session\', reason=\'waiting_session\')\n        self.next_sample = 0.\n        self.running_until = 0.\n\n    def _clear_departure(self, phase, reason, keep_sample=False):\n        dismissed = self.request is not None\n        self.away = False\n        self.handled = False\n        self.request = None\n        if not keep_sample:\n            self.previous = None\n            self.session = None\n            self.running_until = 0.\n            self.validated = None\n            self.state.update(host_verified=False, countdown_running=False)\n        self.state.update(phase=phase, reason=reason, away=False, request=None)\n        return dict(kind=\'dismiss\') if dismissed else None\n\n    @staticmethod\n    def _session(worker, now):\n        reader = getattr(worker, \'reader\', None)\n        mem = getattr(reader, \'mem\', None)\n        frame = getattr(worker, \'frame\', None)\n        if (not getattr(worker, \'enabled\', False) or not mem or not mem.alive()\n                or getattr(worker.return_lobby, \'pending\', False)\n                or getattr(worker.connection_cycle, \'active\', False)):\n            return None, None, \'waiting_session\'\n        if (mem.i32(reader.global_addr(\'signon\')) != 6 or not frame or not frame.map_name\n                or not 0 <= now-frame.stamp <= 1.):\n            return None, None, \'waiting_match\'\n        server_base = getattr(reader, \'mods\', {}).get(\'server.dll\', (0,))[0]\n        return (id(reader), mem.pid, frame.map_name, server_base), reader, \'\'\n\n    @staticmethod\n    def _away(reader, windows, cursor):\n        view = windows.viewport_state(reader.mem.pid)\n        if not view.get(\'game_window\'):\n            return None, \'window_unavailable\'\n        if view.get(\'reason\') in (\'minimized\', \'hidden\', \'cloaked\'):\n            return True, view[\'reason\']\n        rect = view.get(\'rect\')\n        if not rect:\n            return None, \'rect_unavailable\'\n        if not view.get(\'foreground\'):\n            return True, \'other_foreground\'\n        x, y = cursor()\n        left, top, width, height = rect\n        return not (left <= x < left+width and top <= y < top+height), \'cursor_outside\'\n\n    def _validate(self, session, reader):\n        if not native_loopback(reader):\n            raise RuntimeError(\'当前连接不是本地主机\')\n        if self.validated == session:\n            return self.server\n        server = local_server(reader)\n        field_check(reader.mem, server, ROUND_FIELDS)\n        for rva, name in CONVARS:\n            variable = server+rva\n            parent = reader.mem.u32(variable+28)\n            if (reader.mem.string(reader.mem.u32(variable+12), 64) != name or not parent\n                    or reader.mem.string(reader.mem.u32(parent+12), 64) != name):\n                raise RuntimeError(\'回合命令字段未验证：\'+name)\n        self.validated = session\n        self.server = server\n        return server\n\n    @staticmethod\n    def _convar(reader, server, rva, name):\n        variable = server+rva\n        parent = reader.mem.u32(variable+28)\n        if (reader.mem.string(reader.mem.u32(variable+12), 64) != name or not parent\n                or reader.mem.string(reader.mem.u32(parent+12), 64) != name):\n            raise RuntimeError(\'回合命令字段已变化：\'+name)\n        return reader.mem.i32(parent+52)\n\n    def _snapshot(self, session, reader):\n        server = self._validate(session, reader)\n        rules = reader.mem.u32(server+0xc5907c)\n        data = reader.mem.read(rules+0x2f4, 20)\n        count, remaining = struct.unpack_from(\'<ii\', data, 0)\n        freeze = data[8]\n        duration = struct.unpack_from(\'<i\', data, 12)[0]\n        started = struct.unpack_from(\'<f\', data, 16)[0]\n        if (not rules or not 0 <= count <= 10000000 or not -2147483648 <= remaining <= 2147483647\n                or freeze not in (0, 1) or not -2147483648 <= duration <= 2147483647\n                or not math.isfinite(started) or not 0 <= started < 1e9):\n            raise RuntimeError(\'等待有效的回合倒计时\')\n        if reader.mem.u32(server+0xc5907c) != rules:\n            raise RuntimeError(\'回合状态正在切换\')\n        return dict(session=session, reader=reader, server=server, rules=rules, count=count,\n                    remaining=remaining, freeze=freeze, duration=duration, started=data[16:20],\n                    roundtime=self._convar(reader, server, 0xa07100, \'mp_roundtime\'))\n\n    def _begin_apply(self, sample):\n        if self.pending is not None:\n            raise RuntimeError(\'上一条回合命令仍在等待确认\')\n        reader = sample[\'reader\']\n        if self.camera is None:\n            self.camera = self.camera_factory(getattr(self, \'windows\', None), clock=self.clock)\n        self.camera.bind(reader, validate_camera=False, unrestricted=True)\n        if not self.camera.poll(0):\n            raise RuntimeError(\'上一条游戏命令仍未完成\')\n        if not self.camera.enqueue(\'mp_roundtime 35791394; mp_restartgame 1\', require_foreground=False):\n            raise RuntimeError(\'游戏命令队列不可用\')\n        self.pending = dict(sample=sample, sent_at=self.clock())\n        self.state.update(phase=\'command_submitted\', reason=\'awaiting_readback\')\n        return True\n\n    def _poll_apply(self, worker, now):\n        pending = self.pending\n        if pending is None:\n            return None\n        try:\n            session, reader, _ = self._session(worker, now)\n            if session != pending[\'sample\'][\'session\']:\n                raise RuntimeError(\'对局已变化，无法确认原命令\')\n            if self.camera is not None:\n                self.camera.poll(0)\n            sample = self._snapshot(session, reader)\n            before = pending[\'sample\']\n            restarted = (sample[\'rules\'] != before[\'rules\'] or sample[\'count\'] != before[\'count\']\n                         or (sample[\'started\'] != before[\'started\']\n                             and (sample[\'freeze\'] or not before[\'freeze\'])))\n            if restarted:pending[\'restarted\'] = True\n            # Native minutes*60 conversion can overflow. A submitted ConVar\n            # alone cannot establish that the live round really has time left.\n            usable_time = sample[\'duration\'] >= 86400 and sample[\'remaining\'] > 3600\n            if sample[\'roundtime\'] == ROUND_MINUTES and pending.get(\'restarted\') and usable_time:\n                self.pending = None\n                self.state.update(phase=\'applied_verified\', reason=\'roundtime_and_restart_readback\',\n                                  roundtime=sample[\'roundtime\'])\n                return dict(kind=\'applied\', verified=True)\n            if self.clock()-pending[\'sent_at\'] >= 10.:\n                self.pending = None\n                self.state.update(phase=\'apply_unconfirmed\', reason=\'readback_timeout\',\n                                  roundtime=sample[\'roundtime\'])\n                return dict(kind=\'apply_unconfirmed\', verified=False)\n        except Exception as ex:\n            self.pending = None\n            self.state.update(phase=\'apply_unconfirmed\', reason=\'readback_error: \'+str(ex))\n            return dict(kind=\'apply_unconfirmed\', verified=False)\n        return None\n\n    def tick(self, worker, windows, cursor, policy, now=None):\n        now = self.clock() if now is None else now\n        if now < self.next_sample:\n            return None\n        self.next_sample = now+POLL_SECONDS\n        self.windows = windows\n        self.worker = worker; self.cursor = cursor\n        event = self._poll_apply(worker, now)\n        self.state[\'policy\'] = policy\n        try:\n            session, reader, reason = self._session(worker, now)\n            if session is None:\n                dismissed = self._clear_departure(\'waiting_session\', reason)\n                return event or dismissed\n            away, reason = self._away(reader, windows, cursor)\n            if away is None:\n                self.state.update(reason=reason)\n                return event\n            # Sample the native countdown in BOTH foreground and background.\n            # There is no actor/bone sampling and no dependency on an aim frame.\n            sample = self._snapshot(session, reader)\n        except Exception as ex:\n            self.validated = None\n            # A transient read must not repeatedly discard the comparison\n            # baseline. Every action still revalidates the live host/session.\n            self.state.update(reason=\'observation_error: \'+str(ex), host_verified=False,\n                              countdown_running=False, request=None)\n            dismissed = self.request is not None\n            if dismissed:\n                self.request = None\n                self.handled = False\n            return event or (dict(kind=\'dismiss\') if dismissed else None)\n\n        if self.session != session:\n            dismissed = self._clear_departure(\'watching_countdown\', reason)\n            self.session = session\n            event = event or dismissed\n        previous = self.previous\n        self.previous = sample\n        same_round = (previous is not None and all(sample[k] == previous[k]\n                       for k in (\'rules\', \'count\', \'started\')))\n        if not same_round:\n            self.running_until = 0.\n            if self.request is not None:\n                self.request = None\n                self.handled = False\n                event = event or dict(kind=\'dismiss\')\n        elif 0 < sample[\'remaining\'] < previous[\'remaining\']:\n            self.running_until = now+1.5\n        self.state.update(remaining=sample[\'remaining\'], away=away,\n                          countdown_running=0 < sample[\'remaining\'] and now < self.running_until,\n                          host_verified=True, sample_interval_ms=POLL_SECONDS*1000)\n        if not away:\n            dismissed = self._clear_departure(\'in_game\', \'in_game\', keep_sample=True)\n            return event or dismissed\n        if not self.away:\n            self.away = True\n            self.departure += 1\n            self.handled = False\n            self.request = None\n            self.state.update(phase=\'watching_countdown\', reason=reason, away=True,\n                              remaining=sample[\'remaining\'], request=None)\n        self.state.update(away=True, remaining=sample[\'remaining\'], reason=reason)\n        if self.handled or not self.state[\'countdown_running\']:\n            return event\n        self.handled = True\n        if policy == AUTO_RESET:\n            try:\n                self._begin_apply(sample)\n            except Exception as ex:\n                self.state.update(phase=\'apply_unconfirmed\', reason=\'submit_error: \'+str(ex))\n                return dict(kind=\'apply_unconfirmed\', verified=False)\n            return event\n        self.request = (self.departure, session)\n        self.state.update(phase=\'prompt_pending\', reason=\'countdown_continues\', request=self.request)\n        return dict(kind=\'prompt\', request=self.request)\n\n    def decide(self, request, choice):\n        if request != self.request or not self.away or self.session != request[1]:\n            return dict(kind=\'stale\')\n        if choice not in (ONCE, ALWAYS, SKIP):\n            return dict(kind=\'stale\')\n        self.request = None\n        self.state[\'request\'] = None\n        if choice == SKIP:\n            self.state.update(phase=\'skipped\', reason=\'user_skipped\')\n            return dict(kind=\'skipped\')\n        try:\n            session, reader, _ = self._session(self.worker, self.clock())\n            if session != self.session or self._away(reader, self.windows, self.cursor)[0] is not True:\n                return dict(kind=\'stale\')\n            sample = self._snapshot(session, reader)\n            if any(sample[key] != self.previous[key] for key in (\'rules\', \'count\', \'started\')):\n                return dict(kind=\'stale\')\n            self._begin_apply(sample)\n        except Exception as ex:\n            self.state.update(phase=\'apply_unconfirmed\', reason=\'submit_error: \'+str(ex))\n            return dict(kind=\'apply_unconfirmed\', verified=False)\n        return dict(kind=\'submitted\')\n\n    def close(self):\n        if self.camera is not None:\n            try:\n                self.camera.close()\n            finally:\n                self.camera = None\n\n\nclass RoundAwayDialog:\n    def __init__(self, parent, i18n, on_choose):\n        self.parent = parent\n        self.i18n = i18n\n        self.on_choose = on_choose\n        self.popup = None\n        self.request = None\n        self.next_reveal = 0.\n        self.i18n.refreshers.append(self.refresh)\n\n    def show(self, request):\n        if self.popup is not None:\n            self.ensure_visible()\n            return\n        self.request = request\n        popup = self.popup = tk.Toplevel(self.parent)\n        prepare_hidden_window(popup)\n        popup.configure(bg=PANEL)\n        # An automatic reminder must remain visible when the tool is hidden\n        # or minimized. A transient owner hides it together with that owner.\n        popup.attributes(\'-topmost\', True)\n        popup.resizable(False, False)\n        body = ttk.Frame(popup, padding=14)\n        body.pack(fill=\'both\', expand=True)\n        self.message = ttk.Label(body, justify=\'left\', wraplength=400)\n        self.message.pack(fill=\'x\', pady=(0, 12))\n        buttons = ttk.Frame(body)\n        buttons.pack(fill=\'x\')\n        self.once_button = ttk.Button(buttons, command=lambda:self.choose(ONCE))\n        self.always_button = ttk.Button(buttons, command=lambda:self.choose(ALWAYS))\n        self.skip_button = ttk.Button(buttons, command=lambda:self.choose(SKIP))\n        self.once_button.pack(fill=\'x\', pady=2)\n        self.always_button.pack(fill=\'x\', pady=2)\n        self.skip_button.pack(fill=\'x\', pady=2)\n        popup.protocol(\'WM_DELETE_WINDOW\', lambda:self.choose(SKIP))\n        popup.bind(\'<Escape>\', lambda event:self.choose(SKIP))\n        self.refresh()\n        popup.update_idletasks()\n        if self.parent.winfo_viewable():\n            x = self.parent.winfo_rootx()+max(0, (self.parent.winfo_width()-popup.winfo_reqwidth())//2)\n            y = self.parent.winfo_rooty()+max(0, (self.parent.winfo_height()-popup.winfo_reqheight())//2)\n        else:\n            x = (popup.winfo_screenwidth()-popup.winfo_reqwidth())//2\n            y = (popup.winfo_screenheight()-popup.winfo_reqheight())//2\n        x=max(0,min(x,popup.winfo_screenwidth()-popup.winfo_reqwidth()))\n        y=max(0,min(y,popup.winfo_screenheight()-popup.winfo_reqheight()))\n        popup.geometry(f\'+{x}+{y}\')\n        reveal_ready_window(popup)\n        popup.lift()\n\n    def ensure_visible(self):\n        if self.popup is None or time.monotonic() < self.next_reveal:\n            return\n        self.next_reveal = time.monotonic()+POLL_SECONDS\n        if not self.popup.winfo_viewable():\n            reveal_ready_window(self.popup)\n        dark_titlebar(self.popup)\n\n    def choose(self, choice):\n        request = self.request\n        self.close()\n        if request is not None:\n            self.on_choose(request, choice)\n\n    def refresh(self):\n        if self.popup is None:\n            return\n        self.popup.title(self.i18n.t(POLICY_LABEL))\n        self.message.configure(text=self.i18n.t(PROMPT_TEXT))\n        self.once_button.configure(text=self.i18n.t(ONCE))\n        self.always_button.configure(text=self.i18n.t(ALWAYS))\n        self.skip_button.configure(text=self.i18n.t(SKIP))\n\n    def close(self):\n        popup = self.popup\n        self.popup = None\n        self.request = None\n        if popup is not None:\n            popup.destroy()\n\n\nclass RoundPolicyMenu:\n    """Blue floating policy choices; no system-white native menu."""\n    def __init__(self, parent, anchor, i18n, variable, on_choose):\n        self.parent=parent;self.anchor=anchor;self.i18n=i18n\n        self.variable=variable;self.on_choose=on_choose\n        self.popup=None;self.buttons=[]\n        self.i18n.refreshers.append(self.refresh)\n\n    def toggle(self):\n        if self.popup is not None:\n            self.close();return\n        popup=self.popup=tk.Toplevel(self.parent)\n        popup.withdraw();popup.overrideredirect(True)\n        popup.configure(bg=BG);popup.attributes(\'-topmost\',True)\n        body=tk.Frame(popup,bg=PANEL,highlightbackground=\'#29517a\',highlightthickness=1)\n        body.pack(fill=\'both\',expand=True)\n        style=ttk.Style(popup)\n        style.configure(\'RoundPolicy.TRadiobutton\',background=PANEL,foreground=TEXT,padding=(12,10))\n        style.map(\'RoundPolicy.TRadiobutton\',background=[(\'active\',\'#173d63\')],\n                  foreground=[(\'selected\',LABEL),(\'active\',LABEL)])\n        self.buttons=[]\n        for policy in POLICIES:\n            button=ttk.Radiobutton(body,text=self.i18n.t(policy),value=policy,\n                variable=self.variable,style=\'RoundPolicy.TRadiobutton\',\n                command=lambda p=policy:self.choose(p))\n            button.pack(fill=\'x\');self.buttons.append(button)\n        popup.update_idletasks()\n        width,height=popup.winfo_reqwidth(),popup.winfo_reqheight()\n        x=max(0,min(self.anchor.winfo_rootx(),popup.winfo_screenwidth()-width))\n        y=self.anchor.winfo_rooty()+self.anchor.winfo_height()\n        if y+height>popup.winfo_screenheight():y=self.anchor.winfo_rooty()-height\n        popup.geometry(f\'{width}x{height}+{x}+{max(0,y)}\')\n        popup.bind(\'<Escape>\',lambda e:self.close())\n        popup.bind(\'<FocusOut>\',lambda e:popup.after_idle(self.close_if_unfocused))\n        popup.deiconify();popup.focus_force()\n\n    def choose(self, policy):\n        self.close();self.on_choose(policy)\n\n    def close_if_unfocused(self):\n        if self.popup is None:return\n        focus=self.popup.focus_displayof()\n        if focus is None or focus.winfo_toplevel() is not self.popup:self.close()\n\n    def refresh(self):\n        for button,policy in zip(self.buttons,POLICIES):\n            button.configure(text=self.i18n.t(policy))\n\n    def close(self):\n        popup=self.popup;self.popup=None;self.buttons=[]\n        if popup is not None:popup.destroy()\n')
_EMBEDDED['round_away_process'] = ('2026.10.08-round-away-process-theme', '"""Independent, low-frequency host countdown worker and nonblocking UI mailbox."""\nimport json\nimport os\nfrom pathlib import Path\nimport queue\nimport subprocess\nimport sys\nimport threading\nimport time\nimport uuid\nfrom types import SimpleNamespace\n\nfrom local_round_away import RoundAwayService as RoundAwayEngine, WAIT_PROMPT, POLICIES, POLL_SECONDS\n\n\ndef request_key(value):\n    return json.dumps(value,ensure_ascii=True,separators=(\',\',\':\'))\n\n\ndef freeze(value):\n    return tuple(freeze(x) for x in value) if isinstance(value,list) else value\n\n\ndef console_python():\n    executable=Path(sys.executable)\n    if executable.name.lower()==\'pythonw.exe\':\n        console=executable.with_name(\'python.exe\')\n        if console.exists():return str(console)\n    return str(executable)\n\n\ndef worker_command(game,pid,token):\n    return [console_python(),\'-X\',\'utf8\',\'-u\',str(BUNDLE_ENTRY),\'--round-away-worker\',\n            str(game),str(pid),str(os.getpid()),token]\n\n\nclass RoundAwayService:\n    """UI ticks exchange identifiers/settings only; no native reads or commands."""\n    def __init__(self,command_factory=worker_command):\n        self.command_factory=command_factory\n        self.lock=threading.Lock();self.stopped=threading.Event()\n        self.desired=None;self.policy=WAIT_PROMPT;self.proc=None;self.token=None\n        self.request=None;self.state=dict(policy=WAIT_PROMPT,phase=\'waiting_session\',\n                                        reason=\'waiting_session\',owner=\'round_away_process\')\n        self.events=queue.Queue(maxsize=32);self.choices=queue.Queue(maxsize=16)\n        self.announced=None;self.last_reply=0.;self.starts=0\n        self.choice_pending=None\n        self.thread=threading.Thread(target=self._watch,name=\'round-away-lifecycle\',daemon=True)\n        self.thread.start()\n\n    def tick(self,worker,windows=None,cursor=None,policy=WAIT_PROMPT,now=None):\n        reader=getattr(worker,\'reader\',None);mem=getattr(reader,\'mem\',None)\n        enabled=(getattr(worker,\'enabled\',False) and mem is not None\n                 and not getattr(getattr(worker,\'return_lobby\',None),\'pending\',False)\n                 and not getattr(getattr(worker,\'connection_cycle\',None),\'active\',False))\n        desired=(str(getattr(worker,\'game\',getattr(reader,\'game\',\'\'))),int(mem.pid),id(reader)) if enabled else None\n        with self.lock:\n            if self.desired!=desired:\n                self.request=None;self.choice_pending=None\n            self.desired=desired;self.policy=policy if policy in POLICIES else WAIT_PROMPT\n            self.state[\'policy\']=self.policy\n            if desired is None:self.request=None\n            request=self.request if desired is not None else None\n            token=self.token\n        for _ in range(32):\n            try:event=self.events.get_nowait()\n            except queue.Empty:break\n            event_token=event.pop(\'_token\',None);event_binding=event.pop(\'_binding\',None)\n            if event_token==token and event_binding==desired:return event\n        key=request_key(request) if request is not None else None\n        if key!=self.announced:\n            previous=self.announced;self.announced=key\n            if request is not None:return dict(kind=\'prompt\',request=request)\n            if previous is not None:return dict(kind=\'dismiss\')\n        return None\n\n    def decide(self,request,choice):\n        with self.lock:\n            if self.desired is None or self.request is None or request_key(request)!=request_key(self.request):\n                return dict(kind=\'stale\')\n            token=self.token\n        try:self.choices.put_nowait(dict(kind=\'choice\',request=request,choice=choice,token=token))\n        except queue.Full:return dict(kind=\'apply_unconfirmed\',verified=False)\n        with self.lock:\n            self.choice_pending=request_key(request);self.request=None\n        return dict(kind=\'queued\')\n\n    def _receive(self,proc,token,binding):\n        try:\n            for line in proc.stdout:\n                if len(line)>32768:continue\n                row=json.loads(line)\n                if row.get(\'token\')!=token:continue\n                with self.lock:\n                    if self.token!=token:return\n                    if self.desired!=binding:continue\n                    self.last_reply=time.monotonic()\n                    self.state=dict(row.get(\'state\') or {},worker_pid=proc.pid,\n                                    owner=\'round_away_process\',worker_starts=self.starts)\n                    request=freeze(row.get(\'request\'))\n                    if request is None:self.choice_pending=None\n                    self.request=request if request_key(request)!=self.choice_pending and self.desired is not None else None\n                for event in row.get(\'events\',[]):\n                    event=dict(event)\n                    if event.get(\'kind\') in (\'prompt\',\'dismiss\'):continue\n                    event[\'_token\']=token\n                    event[\'_binding\']=binding\n                    if \'request\' in event:event[\'request\']=freeze(event[\'request\'])\n                    try:self.events.put_nowait(event)\n                    except queue.Full:pass\n        except (OSError,ValueError):\n            return\n\n    @staticmethod\n    def _send(proc,row):\n        proc.stdin.write(json.dumps(row,ensure_ascii=True,separators=(\',\',\':\'))+\'\\n\')\n        proc.stdin.flush()\n\n    def _finish(self,proc):\n        if proc is None:return\n        try:\n            if proc.poll() is None:\n                try:self._send(proc,dict(kind=\'stop\'))\n                except (OSError,ValueError):pass\n                try:proc.wait(timeout=2.)\n                except subprocess.TimeoutExpired:\n                    proc.terminate();proc.wait(timeout=1.)\n        finally:\n            for stream in (proc.stdin,proc.stdout):\n                if stream:stream.close()\n\n    def _watch(self):\n        proc=None;log=None;binding=None;last_policy=None;next_start=0.\n        try:\n            log_path=BUNDLE_ENTRY.parent/\'CSO2_BOT_Tool\'/\'round_away_worker.log\'\n            log_path.parent.mkdir(parents=True,exist_ok=True)\n            log=log_path.open(\'ab\',buffering=0)\n            while not self.stopped.is_set():\n                with self.lock:desired=self.desired;policy=self.policy\n                if proc is not None and (binding!=desired or proc.poll() is not None):\n                    self._finish(proc);proc=None\n                    with self.lock:\n                        self.proc=None;self.token=None;self.request=None;self.choice_pending=None\n                        self.state.update(phase=\'waiting_session\',reason=\'worker_rebinding\')\n                    next_start=time.monotonic()+.5\n                if desired is None:\n                    self.stopped.wait(.1);continue\n                if proc is None and time.monotonic()>=next_start:\n                    token=uuid.uuid4().hex\n                    try:\n                        proc=subprocess.Popen(self.command_factory(desired[0],desired[1],token),\n                            stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=log,\n                            text=True,encoding=\'utf8\',bufsize=1,\n                            creationflags=getattr(subprocess,\'CREATE_NO_WINDOW\',0))\n                        binding=desired;last_policy=None;self.starts+=1\n                        with self.lock:\n                            self.proc=proc;self.token=token;self.last_reply=time.monotonic()\n                        threading.Thread(target=self._receive,args=(proc,token,binding),\n                            name=\'round-away-replies\',daemon=True).start()\n                    except OSError as ex:\n                        proc=None;next_start=time.monotonic()+1.\n                        with self.lock:self.state.update(phase=\'waiting_worker\',reason=str(ex))\n                if proc is not None:\n                    try:\n                        if last_policy!=policy:\n                            self._send(proc,dict(kind=\'settings\',policy=policy));last_policy=policy\n                        for _ in range(16):\n                            try:choice=self.choices.get_nowait()\n                            except queue.Empty:break\n                            if choice[\'token\']==self.token:self._send(proc,choice)\n                    except (OSError,ValueError) as ex:\n                        self._finish(proc);proc=None;next_start=time.monotonic()+1.\n                        with self.lock:\n                            self.proc=None;self.token=None;self.request=None;self.choice_pending=None\n                            self.state.update(phase=\'waiting_worker\',reason=str(ex))\n                self.stopped.wait(.1)\n        finally:\n            self._finish(proc)\n            if log:log.close()\n            with self.lock:self.proc=None;self.token=None;self.request=None\n\n    def close(self):\n        self.stopped.set();self.thread.join(timeout=3.5)\n\n\nclass RoundSampler:\n    """Own Reader; samples only map, signon and validated server round fields."""\n    def __init__(self,game,pid):\n        from reader import Reader\n        from cso2_bot_tool import Windows\n        from local_health_away import CursorPosition\n        self.reader=Reader(game);self.pid=pid;self.windows=Windows();self.cursor=CursorPosition()\n        self.worker=SimpleNamespace(reader=self.reader,frame=None,enabled=True,\n            return_lobby=SimpleNamespace(pending=False),connection_cycle=SimpleNamespace(active=False))\n        self.next_attach=0.;self.next_modules=0.\n\n    def sample(self,now):\n        if self.reader.mem is None:\n            if now<self.next_attach:return False\n            self.next_attach=now+2.;self.reader.attach(self.pid);self.next_modules=now+5.\n        if not self.reader.mem.alive():return False\n        if now>=self.next_modules:\n            self.next_modules=now+5.\n            modules=self.reader.module_provider(self.pid)\n            if any(modules.get(k)!=self.reader.mods.get(k) for k in (\'client.dll\',\'engine.dll\')):\n                self.reader.close();return False\n            self.reader.mods=modules\n        level=self.reader.mem.string(self.reader.global_addr(\'level_name\'),160).replace(\'\\\\\',\'/\')\n        self.worker.frame=SimpleNamespace(map_name=level,stamp=time.monotonic())\n        return True\n\n    def close(self):self.reader.close()\n\n\ndef serve(game,pid,parent_pid,token,sampler_factory=RoundSampler,lifetime_factory=None):\n    if lifetime_factory is None:\n        from bhop_service import Lifetime\n        lifetime_factory=Lifetime\n    for stream in (sys.stdin,sys.stdout,sys.stderr):\n        if stream is not None and callable(getattr(stream,\'reconfigure\',None)):\n            stream.reconfigure(encoding=\'utf8\',errors=\'strict\')\n    lifetime=lifetime_factory(parent_pid,pid);sampler=None;engine=RoundAwayEngine()\n    stopped=threading.Event();inbox=queue.Queue(maxsize=32);policy=[WAIT_PROMPT]\n\n    def receive():\n        try:\n            for line in sys.stdin:\n                row=json.loads(line)\n                if row.get(\'kind\')==\'stop\':break\n                if row.get(\'kind\')==\'settings\':\n                    if row.get(\'policy\') in POLICIES:policy[0]=row[\'policy\']\n                elif row.get(\'kind\')==\'choice\' and row.get(\'token\')==token:\n                    try:inbox.put_nowait(row)\n                    except queue.Full:pass\n        finally:stopped.set()\n\n    threading.Thread(target=receive,name=\'round-away-settings\',daemon=True).start()\n    cycles=0\n    try:\n        sampler=sampler_factory(game,pid)\n        while lifetime.alive() and not stopped.is_set():\n            began=time.monotonic();events=[]\n            try:\n                if sampler.sample(began):\n                    event=engine.tick(sampler.worker,sampler.windows,sampler.cursor,policy[0])\n                    if event:events.append(event)\n                    for _ in range(16):\n                        try:row=inbox.get_nowait()\n                        except queue.Empty:break\n                        result=engine.decide(freeze(row[\'request\']),row[\'choice\'])\n                        events.append(dict(result,choice=row[\'choice\']))\n                else:\n                    event=engine._clear_departure(\'waiting_session\',\'waiting_match\')\n                    if event:events.append(event)\n            except Exception as ex:\n                if engine.request is not None:\n                    engine.request=None;engine.handled=False\n                engine.validated=None\n                engine.state.update(reason=type(ex).__name__+\': \'+str(ex),request=None,\n                                    host_verified=False,countdown_running=False)\n            cycles+=1\n            state=dict(engine.state,process_id=os.getpid(),cycle=cycles,\n                sample_interval_ms=POLL_SECONDS*1000,cycle_ms=(time.monotonic()-began)*1000)\n            print(json.dumps(dict(token=token,state=state,request=engine.request,events=events),\n                             ensure_ascii=True,separators=(\',\',\':\')),flush=True)\n            stopped.wait(max(0.,POLL_SECONDS-(time.monotonic()-began)))\n    finally:\n        try:engine.close()\n        finally:\n            if sampler:sampler.close()\n            lifetime.close()\n')
